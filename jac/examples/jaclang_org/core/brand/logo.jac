def:pub logo_xml -> str {
    return "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64' width='64' height='64' role='img' aria-label='JacYac logo'>  <defs>    <linearGradient id='jyg' x1='0' y1='0' x2='1' y2='1'>      <stop offset='0' stop-color='#fb923c'/>      <stop offset='0.55' stop-color='#ea580c'/>      <stop offset='1' stop-color='#7c2d12'/>    </linearGradient>  </defs>    <g fill='none' stroke='url(#jyg)' stroke-width='10' stroke-linecap='round' stroke-linejoin='round'>    <path d='M24 14 H48'/>    <path d='M38 14 V40 A12 12 0 0 1 14 40'/>  </g>    <g fill='none' stroke='#fcd34d' stroke-width='2' stroke-linecap='round' opacity='0.9'>    <path d='M48 14 57 7'/>    <path d='M48 14 58 22'/>    <path d='M24 14 13 9'/>    <path d='M13 9 8 20'/>    <path d='M14 40 6 50'/>  </g>    <g fill='#fcd34d'>    <circle cx='48' cy='14' r='3.8'/>    <circle cx='24' cy='14' r='3.8'/>    <circle cx='14' cy='40' r='3.4'/>    <circle cx='57' cy='7' r='3'/>    <circle cx='58' cy='22' r='3'/>    <circle cx='13' cy='9' r='2.6'/>    <circle cx='8' cy='20' r='2.6'/>    <circle cx='6' cy='50' r='3'/>  </g>    <g fill='#fb923c'>    <circle cx='52' cy='34' r='1.7'/>    <circle cx='30' cy='56' r='1.7'/>    <circle cx='58' cy='44' r='1.4'/>  </g></svg>";
}
