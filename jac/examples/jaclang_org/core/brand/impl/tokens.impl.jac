impl dark_palette -> Colors {
    return Colors();
}

impl light_palette -> Colors {
    return Colors(
        bg="#ffffff",
        surface="#ffffff",
        elevated="#f5f5f5",
        border="#e5e5e5",
        text="#171717",
        muted="#737373",
        accent="#ea580c",
        field="#fafafa",
        accentSoft="rgba(234,88,12,0.12)"
    );
}

impl spacing -> Spacing {
    return Spacing();
}

impl radii -> Radii {
    return Radii();
}

impl fonts -> Fonts {
    return Fonts();
}

impl font_family -> str {
    return "Geist";
}
