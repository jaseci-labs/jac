             b"\0005\3i\1)\4a\25\5\0\0Directory tree generator.\12\12        This behav"
             b"es exactly like walk(), except that it yields a 4-tuple\12\12           "
             b" dirpath, dirnames, filenames, dirfd\12\12        `dirpath`, `dirnames` "
             b"and `filenames` are identical to walk() output,\12        and `dirfd` is"
             b" a file descriptor referring to the directory `dirpath`.\12\12        Th"
             b"e advantage of fwalk() over walk() is that it's safe against symlink\12 "
             b"       races (when follow_symlinks is False).\12\12        If dir_fd is "
             b"not None, it should be a file descriptor open to\12        a directory, "
             b"and top should be relative; top will then be relative to\12        that "
             b"directory.  (dir_fd is always supported for fwalk.)\12\12        Caution"
             b":\12        Since fwalk() yields file descriptors, those are only valid "
             b"until the\12        next iteration step, so you should dup() them if you"
             b" want to keep them\12        for a longer period.\12\12        Example:"
             b"\12\12        import os\12        for root, dirs, files, rootfd in os.fw"
             b"alk('python/Lib/xml'):\12            print(root, \"consumes\", end=\"\")"
             b"\12            print(sum(os.stat(name, dir_fd=rootfd).st_size for name i"
             b"n files),\12                  end=\"\")\12            print(\"bytes in\""
             b", len(files), \"non-directory files\")\12            if '__pycache__' in"
             b" dirs:\12                dirs.remove('__pycache__')  # don't visit __pyc"
             b"ache__ directories\12        z\10os.fwalkTN)\12r{\0\0\0r|\0\0\0r}\0\0\0"
