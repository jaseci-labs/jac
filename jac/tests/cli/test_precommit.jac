"""Tests for `jac precommit` -- the repo's pre-commit path (clean break from
the python pre-commit framework).

Two properties are pinned here:

1. `--staged --verify` gates the STAGED BLOBS, not the working tree. A hook
   that verifies worktree files lets unformatted staged content into the
   commit whenever the worktree copy has since been fixed (and conversely
   rejects clean staged content over a dirty worktree).

2. `--install` migrates cleanly: a hook generated by the python pre-commit
   framework is replaced automatically (backed up alongside), any other
   foreign hook requires `--force`, and force always backs up.
"""

import os;
import shutil;
import subprocess;
import tempfile;
import from pathlib { Path }

import from jaclang.cli.commands.analysis { precommit }

glob UNFORMATTED = "def f(x:int)->int{return x+1;}\n",
     FORMATTED = "def f(x: int) -> int {\n    return x + 1;\n}\n";

"""Create a temp git repo with a jac.toml; return its path."""
def make_repo -> str {
    repo = tempfile.mkdtemp(prefix="jac-precommit-test-");
    subprocess.run(["git", "init", "-q", repo], check=True);
    (Path(repo) / "jac.toml").write_text('[project]\nname = "pctest"\n');
    return repo;
}

test "staged verify gates the staged blob not the worktree" {
    repo = make_repo();
    old = os.getcwd();
    os.chdir(repo);
    try {
        f = Path(repo) / "a.jac";
        # Stage UNFORMATTED content, then fix only the worktree copy: the
        # bytes about to be committed are still unformatted, so the gate
        # must fail even though the worktree file is clean.
        f.write_text(UNFORMATTED);
        subprocess.run(["git", "add", "a.jac"], check=True, cwd=repo);
        f.write_text(FORMATTED);
        ret = precommit(staged=True, verify=True);
    } finally {
        os.chdir(old);
        shutil.rmtree(repo, ignore_errors=True);
    }
    assert ret != 0 , "staged blob is unformatted -- verify must fail even though the "
    "worktree copy is formatted (the commit would contain the bad bytes)";
}

test "staged verify passes clean staged blob over dirty worktree" {
    repo = make_repo();
    old = os.getcwd();
    os.chdir(repo);
    try {
        f = Path(repo) / "a.jac";
        # Stage FORMATTED content, then dirty only the worktree copy: the
        # bytes about to be committed are clean, so the gate must pass.
        f.write_text(FORMATTED);
        subprocess.run(["git", "add", "a.jac"], check=True, cwd=repo);
        f.write_text(UNFORMATTED);
        ret = precommit(staged=True, verify=True);
    } finally {
        os.chdir(old);
        shutil.rmtree(repo, ignore_errors=True);
    }
    assert ret == 0 , "staged blob is formatted -- verify must pass regardless of "
    "unstaged worktree edits (partial-staging workflow)";
}

test "install replaces a pre-commit framework hook with backup" {
    repo = make_repo();
    old = os.getcwd();
    os.chdir(repo);
    try {
        hook = Path(repo) / ".git" / "hooks" / "pre-commit";
        hook.parent.mkdir(parents=True, exist_ok=True);
        hook.write_text(
            "#!/usr/bin/env bash\n"
            "# File generated by pre-commit: https://pre-commit.com\n"
            "exec pre-commit hook-impl\n"
        );
        ret = precommit(install=True);
        hook_text = hook.read_text();
        backed_up = (hook.parent / "pre-commit.bak").exists();
    } finally {
        os.chdir(old);
        shutil.rmtree(repo, ignore_errors=True);
    }
    assert ret == 0 , "installing over a python pre-commit framework hook must succeed "
    "(that is the migration path)";
    assert "jac precommit --staged --verify" in hook_text , f"hook must now run jac precommit, got:\n{hook_text}";
    assert backed_up , "the framework hook must be preserved as pre-commit.bak";
}

test "install refuses a foreign hook unless forced" {
    repo = make_repo();
    old = os.getcwd();
    os.chdir(repo);
    try {
        hook = Path(repo) / ".git" / "hooks" / "pre-commit";
        hook.parent.mkdir(parents=True, exist_ok=True);
        hook.write_text("#!/bin/sh\n./my_custom_checks.sh\n");
        refused = precommit(install=True);
        forced = precommit(install=True, force=True);
        hook_text = hook.read_text();
        backed_up = (hook.parent / "pre-commit.bak").exists();
    } finally {
        os.chdir(old);
        shutil.rmtree(repo, ignore_errors=True);
    }
    assert refused != 0 , "a hand-written foreign hook must not be silently replaced";
    assert forced == 0 , "--force must replace it";
    assert "jac precommit --staged --verify" in hook_text , f"hook must now run jac precommit, got:\n{hook_text}";
    assert backed_up , "--force must back the foreign hook up as pre-commit.bak";
}

test "install writes both hooks and reinstall is idempotent" {
    repo = make_repo();
    old = os.getcwd();
    os.chdir(repo);
    try {
        first = precommit(install=True);
        second = precommit(install=True);
        hooks = Path(repo) / ".git" / "hooks";
        pc = hooks / "pre-commit";
        cm = hooks / "commit-msg";
        both_exist = pc.exists() and cm.exists();
        both_exec = os.access(str(pc), os.X_OK) and os.access(str(cm), os.X_OK);
    } finally {
        os.chdir(old);
        shutil.rmtree(repo, ignore_errors=True);
    }
    assert first == 0 , "fresh install must succeed";
    assert second == 0 , "re-running install over our own hooks must succeed "
    "without --force (fresh_env.sh re-runs it)";
    assert both_exist , "install must write pre-commit AND commit-msg hooks";
    assert both_exec , "both hooks must be executable";
}

test "commit-msg hook blocks AI co-author attribution" {
    repo = make_repo();
    old = os.getcwd();
    os.chdir(repo);
    try {
        ret = precommit(install=True);
        cm = str(Path(repo) / ".git" / "hooks" / "commit-msg");
        msg = Path(repo) / "msg.txt";

        msg.write_text(
            "fix: a change\n\nCo-Authored-By: Claude <noreply@anthropic.com>\n"
        );
        ai_rc = subprocess.run(["sh", cm, str(msg)]).returncode;

        msg.write_text("fix: a change\n\nCo-authored-by: Aidan Smith <a@b.co>\n");
        human_rc = subprocess.run(["sh", cm, str(msg)]).returncode;

        msg.write_text("fix: a plain change\n");
        plain_rc = subprocess.run(["sh", cm, str(msg)]).returncode;
    } finally {
        os.chdir(old);
        shutil.rmtree(repo, ignore_errors=True);
    }
    assert ret == 0 , "install must succeed";
    assert ai_rc != 0 , "an AI co-author trailer must be rejected";
    assert human_rc == 0 , "a human co-author must pass (word-boundary match: "
    "'Aidan' must not trip the 'ai' pattern)";
    assert plain_rc == 0 , "a message with no co-author trailer must pass";
}

test "precommit gates the commit on type errors" {
    # Type checking is on the critical path, so a staged file with a TYPE
    # error fails the gate. There is no knob that turns the check off.
    bad = "def f(x: int) -> str {\n    return x;\n}\n";
    repo = make_repo();
    old = os.getcwd();
    os.chdir(repo);
    try {
        import from jaclang.project { config as config_mod }
        f = Path(repo) / "a.jac";
        f.write_text(bad);
        subprocess.run(["git", "add", "a.jac"], check=True, cwd=repo);
        # The config singleton may hold whatever repo the suite ran from;
        # reset so precommit discovers THIS repo's toml.
        config_mod._config = None;
        rc = precommit(staged=True, verify=True);
        config_mod._config = None;
    } finally {
        os.chdir(old);
        shutil.rmtree(repo, ignore_errors=True);
    }
    assert rc != 0 , "a staged type error must fail the precommit gate";
}

test "staged fmt applies fixes and still gates the commit when fmt succeeds" {
    # Regression pin for issue #8536: `jac fmt` is changing to exit 0 after
    # successfully reformatting files (previously it exited 1 whenever
    # anything changed). The precommit gate must NOT silently disappear with
    # that change: a non-verify staged run that applies formatting fixes
    # must still block the commit (nonzero exit + re-stage guidance) and
    # rewrite the worktree copy. The gate must be driven by "did fmt apply
    # changes", not by fmt's exit code.
    import from jaclang.project { config as config_mod }
    repo = tempfile.mkdtemp(prefix="jac-precommit-fmtfix-");
    subprocess.run(["git", "init", "-q", repo], check=True);
    (Path(repo) / "jac.toml").write_text(
        '[project]\nname = "pcf"\nversion = "0.0.1"\n\n'
        '[precommit]\ntypecheck = false\n'
    );
    old = os.getcwd();
    os.chdir(repo);
    try {
        f = Path(repo) / "a.jac";
        f.write_text(UNFORMATTED);
        subprocess.run(["git", "add", "a.jac"], check=True, cwd=repo);
        config_mod._config = None;
        config_mod._config_explicit = False;
        config_mod._config_by_root = {};
        ret = precommit(staged=True);
        rewritten = f.read_text();
        config_mod._config = None;
        config_mod._config_explicit = False;
        config_mod._config_by_root = {};
    } finally {
        os.chdir(old);
        shutil.rmtree(repo, ignore_errors=True);
    }
    assert rewritten == FORMATTED , f"the non-verify run must fix the worktree copy, got:\n{rewritten!r}";
    assert ret != 0 , "a precommit run that applied formatting fixes must block "
    "the commit so the fixes get re-staged -- even once fmt exits 0 on success";
}

test "non-staged fmt applies fixes and still gates the commit when fmt succeeds" {
    # Companion to the staged regression pin above: with staged=False there
    # is no _staged_dirty_files backstop, so the gate MUST come from the
    # stats channel (format() reporting changed > 0). This pins the wiring
    # where precommit owns the stats dict it hands to format().
    import from jaclang.project { config as config_mod }
    repo = tempfile.mkdtemp(prefix="jac-precommit-fmtfix-nostage-");
    subprocess.run(["git", "init", "-q", repo], check=True);
    (Path(repo) / "jac.toml").write_text(
        '[project]\nname = "pcfn"\nversion = "0.0.1"\n\n'
        '[precommit]\ntypecheck = false\n'
    );
    old = os.getcwd();
    os.chdir(repo);
    try {
        f = Path(repo) / "a.jac";
        f.write_text(UNFORMATTED);
        config_mod._config = None;
        config_mod._config_explicit = False;
        config_mod._config_by_root = {};
        ret = precommit(staged=False, paths=[str(f)]);
        rewritten = f.read_text();
        config_mod._config = None;
        config_mod._config_explicit = False;
        config_mod._config_by_root = {};
    } finally {
        os.chdir(old);
        shutil.rmtree(repo, ignore_errors=True);
    }
    assert rewritten == FORMATTED , f"the non-verify run must fix the worktree copy, got:\n{rewritten!r}";
    assert ret != 0 , "a non-staged run that applied formatting fixes must still block "
    "via the stats channel -- fmt exits 0 on success and there is no staged backstop";
}
