"""Automatic activation on torch-importing modules, behind the boolean off switch."""
import os;
import tempfile;
import from tests.support {
    GRAPHMEND_FIXTURES as FIXTURES,
    graphmend_compile_opts as _compile_opts
}
import from jaclang.jac0core.compile_options { CompileOptions }

"""Compile a file under the given graphmend setting and return the unparsed
Python source, the generated bytecode, and the post-compile resolved value of
CompileOptions.graphmend (the open gate resolves to a bool during
compilation)."""
def _compile(path: str, gm: bool) -> tuple[str, any, any] {
    opts = CompileOptions(graphmend=gm, type_check=False);
    (src, bc) = _compile_opts(path, opts);
    return (src, bc, opts.graphmend);
}

def _fixture(name: str, gm: bool) -> tuple[str, any, any] {
    return _compile(os.path.join(FIXTURES, name), gm);
}

test "an open gate transforms a torch-importing module" {
    (src_on, _bc, resolved) = _fixture("val_guard_all.jac", True);
    (src_off, _bc2, _r2) = _fixture("val_guard_all.jac", False);
    assert resolved is True;
    assert src_on != src_off;
    assert "torch._assert_async(" in src_on;
    assert "raise ValueError" not in src_on;
}

test "the gate also opens through an import-from of the torch module" {
    (src_on, _bc, resolved) = _fixture("val_guard_tensor_import.jac", True);
    assert resolved is True;
    assert "torch._assert_async(" in src_on;
}

test "an open gate leaves a torch-free module byte-identical to off" {
    (src_on, bc_on, resolved) = _fixture("no_torch_plain.jac", True);
    (src_off, bc_off, _r) = _fixture("no_torch_plain.jac", False);
    assert resolved is False;
    assert src_on == src_off;
    assert bc_on == bc_off;
}

test "the off switch leaves a torch-importing module untransformed" {
    (src_off, _bc, resolved) = _fixture("val_guard_all.jac", False);
    assert resolved is False;
    assert "torch._assert_async(" not in src_off;
    assert "raise ValueError" in src_off;
}

test "a relative .torch jac import does not open the gate" {
    with tempfile.TemporaryDirectory() as tmp {
        with open(os.path.join(tmp, "torch.jac"), "w") as fh {
            fh.write("def relu(x: any) -> any {\n    return x;\n}\n");
        }
        target = os.path.join(tmp, "rel_torch.jac");
        with open(target, "w") as fh {
            fh.write(
                "import from .torch { relu }\n\n"
                    + "def f(x: any) -> any {\n"
                    + "    if x > 0 {\n        return relu(x);\n    }\n"
                    + "    return x;\n}\n"
            );
        }
        (src_on, bc_on, resolved) = _compile(target, True);
        (src_off, bc_off, _r) = _compile(target, False);
        assert resolved is False;
        assert src_on == src_off;
        assert bc_on == bc_off;
    }
}

glob U16_TORCH_SRC = 'import torch;\n\n'
         + 'def f(x: any) -> any {\n    return torch.relu(x);\n}\n',
     U16_PLAIN_SRC = 'def f(x: any) -> any {\n    return x;\n}\n';

"""A utf-16 source holds no `torch` byte run, so a raw-byte guard would miss it."""
test "detection reads decoded text so a utf-16 source is not skipped" {
    import from jaclang.compiler.passes.main.graphmend.auto_detect {
        file_imports_torch
    }
    with tempfile.TemporaryDirectory() as tmp {
        hit = os.path.join(tmp, "u16_torch.jac");
        with open(hit, "w", encoding="utf-16") as fh {
            fh.write(U16_TORCH_SRC);
        }
        with open(hit, "rb") as rb {
            assert b"torch" not in rb.read();
        }
        assert file_imports_torch(hit) is True;
        miss = os.path.join(tmp, "u16_plain.jac");
        with open(miss, "w", encoding="utf-16") as fh {
            fh.write(U16_PLAIN_SRC);
        }
        assert file_imports_torch(miss) is False;
    }
}

glob GAIN_PLAIN_SRC = 'def f(x: any) -> any {\n'
         + '    if x > 0 {\n        return x;\n    }\n    return 0 - x;\n}\n',
     GAIN_TORCH_SRC = 'import torch;\n\n@torch.compile()\n'
         + 'def f(x: any, mask: torch.Tensor) -> any {\n'
         + '    x = torch.relu(x);\n'
         + '    if not mask.all() {\n'
         + '        raise ValueError("mask must be all true");\n    }\n'
         + '    return torch.sin(x) * 2.0;\n}\n';

"""Compile through the on-disk bytecode cache under the default open gate."""
def _cached(path: str) -> any {
    import from jaclang.jac0core.program { JacProgram }
    prog = JacProgram();
    code = prog.get_bytecode(path);
    assert code is not None;
    return code;
}

"""Whether the emitted code carries the graph-native validation guard."""
def _has_assert_async(code: any) -> bool {
    import types;
    if "_assert_async" in code.co_names {
        return True;
    }
    for c in code.co_consts {
        if isinstance(c, types.CodeType) and _has_assert_async(c) {
            return True;
        }
    }
    return False;
}

"""The cached artifact must not outlive an import edit that changes the verdict."""
test "a source that gains or loses a torch import reruns detection" {
    import from jaclang.jac0core.jir { get_module_cache_path, is_module_cache_valid }
    with tempfile.TemporaryDirectory() as tmp {
        target = os.path.join(tmp, "gains_torch.jac");
        with open(target, "w") as fh {
            fh.write(GAIN_PLAIN_SRC);
        }
        cache_path = get_module_cache_path(target);
        assert not _has_assert_async(_cached(target));
        assert is_module_cache_valid(target, cache_path);
        assert not _has_assert_async(_cached(target));
        with open(target, "w") as fh {
            fh.write(GAIN_TORCH_SRC);
        }
        assert not is_module_cache_valid(target, cache_path);
        assert _has_assert_async(_cached(target));
        with open(target, "w") as fh {
            fh.write(GAIN_PLAIN_SRC);
        }
        assert not _has_assert_async(_cached(target));
    }
}

glob PY_TORCH_SRC = '''
import torch


class MyModel(torch.nn.Module):
    def forward(self, x):
        x = torch.relu(x)
        if x.sum() > 0:
            return x * 2.0
        else:
            return x * 3.0


model = MyModel()
compiled = torch.compile(model)
''',
     PY_RELATIVE_SRC = '''
from .torch import relu


def f(x):
    if x > 0:
        return relu(x)
    return x
''';

"""Write generated .py source to a temp file and compile it under the gate."""
def _py_compile(py_src: str, name: str, gm: bool) -> tuple[str, any, any] {
    with tempfile.TemporaryDirectory() as tmp {
        path = os.path.join(tmp, name);
        with open(path, "w") as fh {
            fh.write(py_src);
        }
        return _compile(path, gm);
    }
}

test "py: the gate opens on an import torch module" {
    (src_on, _bc, resolved) = _py_compile(PY_TORCH_SRC, "auto_model.py", True);
    assert resolved is True;
    assert "torch.where(" in src_on;
    assert "if x.sum() > 0" not in src_on;
}

test "py: a relative .torch import leaves the gate shut" {
    with tempfile.TemporaryDirectory() as tmp {
        path = os.path.join(tmp, "rel_plain.py");
        with open(path, "w") as fh {
            fh.write(PY_RELATIVE_SRC);
        }
        (src_on, bc_on, resolved) = _compile(path, True);
        (src_off, bc_off, _r) = _compile(path, False);
        assert resolved is False;
        assert src_on == src_off;
        assert bc_on == bc_off;
    }
}

test "compile options carry a plain boolean that defaults to on" {
    assert CompileOptions().graphmend is True;
    assert CompileOptions(graphmend=True).graphmend is True;
    assert CompileOptions(graphmend=False).graphmend is False;
}

test "the configured gate reads false as off and anything else as on" {
    import jaclang.cli.commands.execution as execution;
    import from jaclang.project.config { JacConfig }
    import jaclang.project.config as config_mod;
    old_config = config_mod._config;
    try {
        config_mod._config = JacConfig.from_toml_str("[run]\nmain = true\n");
        assert execution._configured_graphmend() is True;
        config_mod._config = JacConfig.from_toml_str("[run]\ngraphmend = false\n");
        assert execution._configured_graphmend() is False;
        config_mod._config = JacConfig.from_toml_str("[run]\ngraphmend = \"off\"\n");
        assert execution._configured_graphmend() is False;
        config_mod._config = JacConfig.from_toml_str("[run]\ngraphmend = \"auto\"\n");
        assert execution._configured_graphmend() is True;
    } finally {
        config_mod._config = old_config;
    }
}

test "the configured gate binds compile options without the cli mapper" {
    import jaclang.cli.commands.execution as execution;
    import from jaclang.project.config { JacConfig }
    import jaclang.project.config as config_mod;
    import from jaclang.jac0core.runtime { JacRuntime as Jac }
    old_config = config_mod._config;
    try {
        config_mod._config = JacConfig.from_toml_str("[run]\nmain = true\n");
        assert execution._apply_graphmend("") is True;
        assert CompileOptions().graphmend is True;
        config_mod._config = JacConfig.from_toml_str("[run]\ngraphmend = false\n");
        assert execution._apply_graphmend("") is False;
        assert CompileOptions().graphmend is False;
        config_mod._config = JacConfig.from_toml_str("[run]\ngraphmend = \"on\"\n");
        assert execution._apply_graphmend("") is True;
        assert CompileOptions().graphmend is True;
    } finally {
        config_mod._config = old_config;
    }
}
