"""Regression fixture for jaseci-labs/jac#8017.

Constructing an imported JS/TS class must emit `new`. A `.d.ts`-declared
class binds as a plain `variable` symbol, so `classify_call` cannot tag
the call as an instantiation; the ES pass must consult the resolved type.
`plain` guards the other direction: a declared function must stay a plain
call.

The sibling `ts_class_new_lib` .d.ts/.js sources are generated by the
test at runtime; the repo keeps no .js/.ts fixture files, so this file is
compiled from a temp copy placed next to them.
"""

import from .ts_class_new_lib { Greeter, plain }

obj Local {
    has x: str = "a";
}

def:pub go -> str {
    j = Local();
    g = Greeter("world");
    p = plain("x");
    return g.hello() + p + j.x;
}
