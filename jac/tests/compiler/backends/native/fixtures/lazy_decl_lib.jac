"""Many functions; an importer names only a few of them."""

def wide_0(n: int) -> int {
    return n * 2 + 0;
}

def wide_1(n: int) -> int {
    return n * 3 + 1;
}

def wide_2(n: int) -> int {
    return n * 4 + 2;
}

def wide_3(n: int) -> int {
    return n * 5 + 3;
}

def wide_4(n: int) -> int {
    return n * 6 + 4;
}

