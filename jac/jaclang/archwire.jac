        application._tree_source { import_edge_rows },
        application._unit_source { interop_manifest_of, manifest_from_record },
        compiler {
            UnitProducts,
            client_artifact_from_json,
            client_artifact_json,
            client_artifact_of,
            definition_deps,
            interop_manifest_of,
            interop_record,
            placement_record,
            unit_products
        },
        jir._definition_texts { definition_span_rows },
        jir._texts_of_spans { DEF_DEP_SEP },
        jir.seed_definition_texts { DEF_DEP_SEP },
    ]
    unit_products --> [
        ifacecache.IfaceRegistry._persist_in_context { interop_record },
        ifacecache.IfaceRegistry.client_boundary_facts { interop_manifest_of },
    ]
    wiring ++> [
        compiler.JacCompiler.jac_str_formatter {
            canonical_wiring_source,
            is_arch_file
        },
        jir.stored_wiring_digest {
            arch_file_for,
            import_prefix_for,
            is_arch_file,
            wiring_digest_for
        },
    ]
    wiring --> jir.unit_source_digest { wiring_digest_for }
}

