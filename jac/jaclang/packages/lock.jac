import hashlib;
import json;
import tomllib;
import from pathlib { Path }

glob LOCK_NAME: str = "jac.lock",
     LOCK_VERSION: int = 1,
     LOCK_HEADER: str = "# Generated by `jac install`; commit it, do not edit it.";

obj LockError(Exception) {}

obj LockedPackage {
    has name: str,
        version: str,
        source: str,
        sha256: str = "",
        deps: list[str] = [],
        pypi: dict[str, str] = {},
        npm: dict[str, str] = {},
        dev: bool = False;

    def source_kind -> str;
    def source_ref -> str;
    def to_toml -> str;
    static def from_toml(row: dict[str, any]) -> LockedPackage;
}

obj Lockfile {
    has version: int = LOCK_VERSION,
        jac: str = "",
        inputs: str = "",
        packages: list[LockedPackage] = [],
        pypi_resolved: list[str] = [],
        pypi_inputs: str = "",
        npm_bun_lock: str = "";

    static def path_for(project_root: Path) -> Path;
    static def read(path: Path) -> Lockfile | None;
    def render -> str;
    def write(path: Path);
    def get(name: str) -> LockedPackage | None;
    def by_name -> dict[str, LockedPackage];
}

def digest_of(payload: any) -> str;
