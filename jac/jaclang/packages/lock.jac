import hashlib;
import json;
import tomllib;
import from pathlib { Path }
import from jaclang.project.config { toml_value }

glob LOCK_NAME: str = "jac.lock",
     LOCK_VERSION: int = 1,
     LOCK_HEADER: str = "# Generated by `jac install`; commit it, do not edit it.";

obj LockError(Exception) {}

obj LockedPackage {
    has name: str,
        version: str,
        source: str,
        sha256: str = "",
        deps: list[str] = [],
        pypi: dict[str, str] = {},
        npm: dict[str, str] = {},
        dev: bool = False;

    def source_kind -> str {
        return self.source.split("+", 1)[0];
    }

    def source_ref -> str {
        return self.source.split("+", 1)[1] if "+" in self.source else "";
    }

    def to_toml -> str {
        rows: list[str] = [
            "[[package]]",
            f"name = {toml_value(self.name)}",
            f"version = {toml_value(self.version)}",
            f"source = {toml_value(self.source)}"
        ];
        if self.sha256 {
            rows.append(f"sha256 = {toml_value(self.sha256)}");
        }
        if self.deps {
            rows.append(f"deps = {toml_value(sorted(self.deps))}");
        }
        if self.pypi {
            rows.append(f"pypi = {toml_value(dict(sorted(self.pypi.items())))}");
        }
        if self.npm {
            rows.append(f"npm = {toml_value(dict(sorted(self.npm.items())))}");
        }
        if self.dev {
            rows.append("dev = true");
        }
        return "\n".join(rows);
    }

    static def from_toml(row: dict[str, any]) -> LockedPackage {
        for key in ("name", "version", "source") {
            if not isinstance(row.get(key), str) or not row.get(key) {
                raise LockError(f"jac.lock: a [[package]] entry is missing '{key}'");
            }
        }
        return LockedPackage(
            name=row["name"],
            version=row["version"],
            source=row["source"],
            sha256=str(row.get("sha256", "")),
            deps=[str(d) for d in row.get("deps", [])],
            pypi={str(k): str(v) for (k, v) in dict(row.get("pypi", {})).items()},
            npm={str(k): str(v) for (k, v) in dict(row.get("npm", {})).items()},
            dev=bool(row.get("dev", False))
        );
    }
}

obj Lockfile {
    has version: int = LOCK_VERSION,
        jac: str = "",
        inputs: str = "",
        packages: list[LockedPackage] = [],
        pypi_resolved: list[str] = [],
        pypi_inputs: str = "",
        npm_bun_lock: str = "";

    static def path_for(project_root: Path) -> Path {
        return Path(project_root) / LOCK_NAME;
    }

    static def read(path: Path) -> Lockfile | None {
        if not path.is_file() {
            return None;
        }
        try {
            data = tomllib.loads(path.read_text(encoding="utf-8"));
        } except tomllib.TOMLDecodeError as e {
            raise LockError(f"{path}: not valid TOML ({e})");
        }
        found = data.get("version", 0);
        if found != LOCK_VERSION {
            raise LockError(
                f"{path}: lock format {found} is not supported (expected {LOCK_VERSION}); "
                "delete it and run 'jac install' to regenerate"
            );
        }
        pypi = data.get("pypi", {}) if isinstance(data.get("pypi"), dict) else {};
        npm = data.get("npm", {}) if isinstance(data.get("npm"), dict) else {};
        return Lockfile(
            version=found,
            jac=str(data.get("jac", "")),
            inputs=str(data.get("inputs", "")),
            packages=[LockedPackage.from_toml(r) for r in data.get("package", [])],
            pypi_resolved=[str(s) for s in pypi.get("resolved", [])],
            pypi_inputs=str(pypi.get("inputs", "")),
            npm_bun_lock=str(npm.get("bun_lock", ""))
        );
    }

    def render -> str {
        blocks: list[str] = [
            "\n".join(
                [
                    LOCK_HEADER,
                    f"version = {self.version}",
                    f"jac = {toml_value(self.jac)}",
                    f"inputs = {toml_value(self.inputs)}"
                ]
            )
        ];
        for pkg in sorted(self.packages, key=lambda (p: LockedPackage) { p.name; }) {
            blocks.append(pkg.to_toml());
        }
        if self.pypi_resolved or self.pypi_inputs {
            blocks.append(
                "\n".join(
                    [
                        "[pypi]",
                        f"resolved = {toml_value(sorted(self.pypi_resolved))}",
                        f"inputs = {toml_value(self.pypi_inputs)}"
                    ]
                )
            );
        }
        if self.npm_bun_lock {
            blocks.append(
                "\n".join(["[npm]", f"bun_lock = {toml_value(self.npm_bun_lock)}"])
            );
        }
        return "\n\n".join(blocks) + "\n";
    }

    def write(path: Path) {
        text = self.render();
        if path.is_file() and path.read_text(encoding="utf-8") == text {
            return;
        }
        tmp = path.with_name(path.name + ".tmp");
        tmp.write_text(text, encoding="utf-8");
        tmp.replace(path);
    }

    def get(name: str) -> LockedPackage | None {
        for pkg in self.packages {
            if pkg.name == name {
                return pkg;
            }
        }
        return None;
    }

    def by_name -> dict[str, LockedPackage] {
        return {p.name: p for p in self.packages};
    }
}

def digest_of(payload: any) -> str {
    return "sha256:"
        + hashlib.sha256(
            json.dumps(payload, sort_keys=True, separators=(",", ":")).encode()
        ).hexdigest();
}
