+static unsigned atomicOrder(AtomicOrdering order) {
+  switch (order) {
+  case AtomicOrdering::NotAtomic:
+  case AtomicOrdering::Unordered:
+  case AtomicOrdering::Monotonic: return 0;
+  case AtomicOrdering::Acquire: return 2;
+  case AtomicOrdering::Release: return 3;
+  case AtomicOrdering::AcquireRelease: return 4;
+  case AtomicOrdering::SequentiallyConsistent: return 5;
+  }
+  llvm_unreachable("unknown atomic ordering");
+}
+
+void CWriter::visitAtomicRMWInst(AtomicRMWInst &I) {
+  CurInstr = &I;
+  Type *T = I.getType();
+  Out << "({ ";
+  printTypeName(Out, T); Out << " *p = (";
+  printTypeName(Out, T); Out << "*)"; writeOperand(I.getPointerOperand());
+  Out << "; "; printTypeName(Out, T); Out << " old, desired, value = ";
+  writeOperand(I.getValOperand());
+  Out << "; __atomic_load(p, &old, 0); do { desired = ";
+  switch (I.getOperation()) {
+  case AtomicRMWInst::Xchg: Out << "value"; break;
+  case AtomicRMWInst::Add:
+  case AtomicRMWInst::FAdd: Out << "old + value"; break;
+  case AtomicRMWInst::Sub:
+  case AtomicRMWInst::FSub: Out << "old - value"; break;
+  case AtomicRMWInst::And: Out << "old & value"; break;
+  case AtomicRMWInst::Nand: Out << "~(old & value)"; break;
+  case AtomicRMWInst::Or: Out << "old | value"; break;
+  case AtomicRMWInst::Xor: Out << "old ^ value"; break;
+  case AtomicRMWInst::Max:
+  case AtomicRMWInst::Min:
+    Out << "("; printTypeName(Out, T, true); Out << ")old "
+        << (I.getOperation() == AtomicRMWInst::Max ? ">" : "<") << " (";
+    printTypeName(Out, T, true); Out << ")value ? old : value";
+    break;
+  case AtomicRMWInst::UMax: Out << "old > value ? old : value"; break;
+  case AtomicRMWInst::UMin: Out << "old < value ? old : value"; break;
+  default: errorWithMessage("unsupported atomic read-modify-write operation");
+  }
+  Out << "; } while (!__atomic_compare_exchange(p, &old, &desired, 0, "
+      << atomicOrder(I.getOrdering()) << ", 0)); old; })";
+}
+
+void CWriter::visitAtomicCmpXchgInst(AtomicCmpXchgInst &I) {
+  CurInstr = &I;
+  Type *T = I.getCompareOperand()->getType();
+  Out << "({ "; printTypeName(Out, I.getType()); Out << " result; ";
+  printTypeName(Out, T); Out << " old = "; writeOperand(I.getCompareOperand());
+  Out << ", desired = "; writeOperand(I.getNewValOperand());
+  Out << "; result.field1 = __atomic_compare_exchange((";
+  printTypeName(Out, T); Out << "*)"; writeOperand(I.getPointerOperand());
+  Out << ", &old, &desired, " << (I.isWeak() ? "1" : "0") << ", "
+      << atomicOrder(I.getSuccessOrdering()) << ", "
+      << atomicOrder(I.getFailureOrdering())
+      << "); result.field0 = old; result; })";
+}
