# ruff: noqa: N801, N802, N803
"""Native ambient type stubs.

These model the native runtime surface that NaIRGenPass lowers directly to
LLVM (see compiler/backends/native/na_ir_gen_pass.impl/file_io.impl.jac). Unlike
jac_builtins.pyi / dom_types.pyi, this stub is NOT merged into the global
builtins: the TypeEvaluator resolves these names only in native context
(as selected by placement or an explicit native build), so `File` and the native `open` never leak into regular Jac.

Signatures mirror the emitted File struct and methods so that File-typed code
type-checks accurately instead of degrading to UnknownType.
"""

from __future__ import annotations

from collections.abc import Iterable as Iterable, Iterator as Iterator
from typing import Generic, Literal, SupportsIndex, TypeVar, overload

__all__ = [
    "array",
    "overlay",
    "packed",
    "aligned",
    "ptr",
    "addr_of",
    "size_of",
    "align_of",
    "offset_of",
    "File",
    "BinaryFile",
    "open",
    "Iterable",
    "Iterator",
    "iter",
    "next",
    "managed",
    "take",
    "swap",
    "Region",
    "region_of",
]

_T = TypeVar("_T")
_N = TypeVar("_N", bound=int)
_U = TypeVar("_U")

class overlay(Generic[_T, _U]):
    """Untagged native value storage shared by two complete unmanaged types."""
    def __init__(self) -> None: ...


class packed(Generic[_T, _U]):
    """Two consecutive unmanaged values, without padding; alignment is one byte."""
    def __init__(self) -> None: ...


class aligned(Generic[_T, _N]):
    """Value storage with at least N-byte alignment and trailing padding."""
    def __init__(self, value: _T) -> None: ...
    def data(self) -> ptr[_T]: ...


class array(Generic[_T, _N]):
    def __init__(self, values: Iterable[_T] = ()) -> None: ...
    def __getitem__(self, index: SupportsIndex) -> _T: ...
    def __setitem__(self, index: SupportsIndex, value: _T) -> None: ...
    def __len__(self) -> int: ...
    def data(self) -> ptr[_T]: ...


class ptr(Generic[_T]):
    @classmethod
    def null(cls) -> ptr[_T]: ...
    @classmethod
    def from_address(cls, address: SupportsIndex) -> ptr[_T]: ...
    def address(self) -> int: ...
    # The checker specializes call() to the pointee Callable signature.
    def call(self, *args: object) -> object: ...
    def load(self) -> _T: ...
    def store(self, value: _T) -> None: ...
    def load_unaligned(self) -> _T: ...
    def store_unaligned(self, value: _T) -> None: ...
    def load_volatile(self) -> _T: ...
    def store_volatile(self, value: _T) -> None: ...
    def atomic_load(self, order: str, volatile: bool = False) -> _T: ...
    def atomic_store(self, value: _T, order: str, volatile: bool = False) -> None: ...
    def atomic_exchange(self, value: _T, order: str, volatile: bool = False) -> _T: ...
    def atomic_fetch_add(self, value: _T, order: str, volatile: bool = False) -> _T: ...
    def atomic_fetch_sub(self, value: _T, order: str, volatile: bool = False) -> _T: ...
    def atomic_fetch_and(self, value: _T, order: str, volatile: bool = False) -> _T: ...
    def atomic_fetch_or(self, value: _T, order: str, volatile: bool = False) -> _T: ...
    def atomic_fetch_xor(self, value: _T, order: str, volatile: bool = False) -> _T: ...
    def atomic_fetch_nand(self, value: _T, order: str, volatile: bool = False) -> _T: ...
    def atomic_compare_exchange(self, expected: ptr[_T], desired: _T, success: str,
                                failure: str, weak: bool, volatile: bool = False) -> bool: ...
    def offset(self, count: SupportsIndex) -> ptr[_T]: ...
    def __getitem__(self, index: SupportsIndex) -> _T: ...
    def __setitem__(self, index: SupportsIndex, value: _T) -> None: ...
    def __bool__(self) -> bool: ...

def addr_of(__place: _T) -> ptr[_T]: ...

def size_of(__storage: type[_T]) -> int: ...

def align_of(__storage: type[_T]) -> int: ...

def offset_of(__storage: type[_T], __field: str) -> int: ...

def managed(__x: _T) -> _T: ...

def take(__place: _T) -> _T: ...

def swap(__a: _T, __b: _T) -> None: ...

# First-class region handle: an ownable, sendable, escape-checked allocation
# extent opened by `in <handle> { ... }`. Native codegen lowers it to an arena.
class Region:
    @overload
    def partition(self) -> Region: ...
    @overload
    def partition(self, n: int) -> tuple[Region, ...]: ...

# The region a value was allocated in (the growth anchor of a traversal),
# or None for a managed value.
def region_of(__x: object) -> Region | None: ...

def iter(__o: Iterable[_T]) -> Iterator[_T]: ...
def next(__i: Iterator[_T]) -> _T: ...

class File:
    # Fields backing the emitted struct (handle is opaque and intentionally
    # not exposed): path, mode and the closed flag.
    path: str
    mode: str
    closed: bool

    def read(self) -> str: ...
    def readline(self) -> str: ...
    def write(self, data: str) -> int: ...
    def close(self) -> None: ...
    def flush(self) -> None: ...
    def __enter__(self) -> File: ...
    def __exit__(
        self, exc_type: object, exc_val: object, traceback: object
    ) -> bool: ...

class BinaryFile:
    # open(path, "rb"/"wb"/...) -> binary file: read()/readline() yield a
    # length-aware bytes value, write() takes bytes (mirrors CPython's
    # BufferedReader/Writer split from TextIOWrapper).
    path: str
    mode: str
    closed: bool

    def read(self) -> bytes: ...
    def readline(self) -> bytes: ...
    def write(self, data: bytes) -> int: ...
    def close(self) -> None: ...
    def flush(self) -> None: ...
    def __enter__(self) -> BinaryFile: ...
    def __exit__(
        self, exc_type: object, exc_val: object, traceback: object
    ) -> bool: ...

# A binary mode literal (containing "b") selects BinaryFile; any other mode is
# a text File. The codegen reads the same literal to pick the struct, so the
# static type and emitted object always agree (#6404).
#
# `encoding` is declared on the text overload because CPython accepts it there
# and the emitter has to answer for it. It does not lower: `_emit_open` refuses
# any keyword argument, which demotes the calling function to a Python-only
# seam. Leaving the parameter off made the same call a type error instead, and
# a type error in a native module refuses the whole module rather than the one
# function that wrote it.
@overload
def open(
    path: str,
    mode: Literal[
        "rb",
        "br",
        "rb+",
        "r+b",
        "wb",
        "bw",
        "wb+",
        "w+b",
        "ab",
        "ba",
        "ab+",
        "a+b",
        "xb",
        "bx",
        "xb+",
        "x+b",
    ],
) -> BinaryFile: ...
@overload
def open(path: str, mode: str = "r", encoding: str | None = None) -> File: ...
