import jaclang.compiler.frontend.unitree as uni;
import from jaclang.compiler.passes { UniPass }
import from jaclang.compiler.frontend.constant { CodeContext, EdgeDir }
import from jaclang.compiler.frontend.unitree { Tok, EmptyToken, Token }
import from jaclang.compiler.frontend.roles { BodyRole, ItemsRole }

walker NormalizePass(UniPass) {
    can enter_sub_tag with uni.SubTag entry;
    can enter_module with uni.Module entry;
    can enter_type_param with uni.TypeParam entry;
    can enter_type_alias with uni.TypeAlias entry;
    can enter_global_vars with uni.GlobalVars entry;
    can enter_test with uni.Test entry;
    can enter_module_code with uni.ModuleCode entry;
    can enter_py_inline_code with uni.PyInlineCode entry;
    can enter_import with uni.Import entry;
    can enter_module_path with uni.ModulePath entry;
    can enter_module_item with uni.ModuleItem entry;
    can enter_archetype with uni.Archetype entry;
    can enter_impl_def with uni.ImplDef entry;
    can enter_sem_def with uni.SemDef entry;
    can enter_enum with uni.Enum entry;
    can enter_ability with uni.Ability entry;
    can enter_func_signature with uni.FuncSignature entry;
    can enter_event_signature with uni.EventSignature entry;
    can enter_param_var with uni.ParamVar entry;
    can enter_arch_has with uni.ArchHas entry;
    can enter_has_var with uni.HasVar entry;
    can enter_typed_ctx_block with uni.TypedCtxBlock entry;
    def _normalize_cond_block(nd: (uni.IfStmt | uni.WhileStmt), kw: Tok) -> None;
    def _normalize_name_list_stmt(nd: (uni.SemDef | uni.ImplDef), op: Tok) -> None;
    can enter_open_stmt with uni.OpenStmt entry;
    can enter_if_stmt with uni.IfStmt entry;
    can enter_else_if with uni.ElseIf entry;
    can enter_else_stmt with uni.ElseStmt entry;
    can enter_expr_stmt with uni.ExprStmt entry;
    can enter_try_stmt with uni.TryStmt entry;
    can enter_awaiting_clause with uni.AwaitingClause entry;
    can enter_except with uni.Except entry;
    can enter_finally_stmt with uni.FinallyStmt entry;
    can enter_iter_for_stmt with uni.IterForStmt entry;
    can enter_in_for_stmt with uni.InForStmt entry;
    can enter_while_stmt with uni.WhileStmt entry;
    can enter_forever_stmt with uni.ForeverStmt entry;
    can enter_with_stmt with uni.WithStmt entry;
    can enter_expr_as_item with uni.ExprAsItem entry;
    can enter_raise_stmt with uni.RaiseStmt entry;
    can enter_assert_stmt with uni.AssertStmt entry;
    can enter_ctrl_stmt with uni.CtrlStmt entry;
    can enter_delete_stmt with uni.DeleteStmt entry;
    can enter_report_stmt with uni.ReportStmt entry;
    can enter_return_stmt with uni.ReturnStmt entry;
    can enter_visit_stmt with uni.VisitStmt entry;
    can enter_disengage_stmt with uni.DisengageStmt entry;
    can enter_await_expr with uni.AwaitExpr entry;
    can enter_cast_expr with uni.CastExpr entry;
    can enter_assignment with uni.Assignment entry;
    can enter_concurrent_expr with uni.ConcurrentExpr entry;
    can enter_binary_expr with uni.BinaryExpr entry;
    can enter_compare_expr with uni.CompareExpr entry;
    can enter_cfg_expr with uni.CfgExpr entry;
    can enter_bool_expr with uni.BoolExpr entry;
    can enter_lambda_expr with uni.LambdaExpr entry;
    can enter_unary_expr with uni.UnaryExpr entry;
    can enter_if_else_expr with uni.IfElseExpr entry;
    can enter_multi_string with uni.MultiString entry;
    can enter_f_string with uni.FString entry;
    can enter_formatted_value with uni.FormattedValue entry;
    can enter_list_val with uni.ListVal entry;
    can enter_set_val with uni.SetVal entry;
    can enter_tuple_val with uni.TupleVal entry;
    can enter_dict_val with uni.DictVal entry;
    can enter_k_v_pair with uni.KVPair entry;
    can enter_k_w_pair with uni.KWPair entry;
    can enter_inner_compr with uni.InnerCompr entry;
    can enter_list_compr with uni.ListCompr entry;
    can enter_gen_compr with uni.GenCompr entry;
    can enter_set_compr with uni.SetCompr entry;
    can enter_dict_compr with uni.DictCompr entry;
    can enter_atom_trailer with uni.AtomTrailer entry;
    can enter_atom_unit with uni.AtomUnit entry;
    can enter_graph_expr with uni.GraphExpr entry;
    can enter_yield_expr with uni.YieldExpr entry;
    can enter_func_call with uni.FuncCall entry;
    can enter_index_slice with uni.IndexSlice entry;
    can enter_slice with uni.Slice entry;
    can enter_edge_ref_trailer with uni.EdgeRefTrailer entry;
    can enter_edge_op_ref with uni.EdgeOpRef entry;
    can enter_disconnect_op with uni.DisconnectOp entry;
    can enter_connect_op with uni.ConnectOp entry;
    can enter_filter_compr with uni.FilterCompr entry;
    can enter_assign_compr with uni.AssignCompr entry;
    can enter_jsx_attribute with uni.JsxAttribute entry;
    can enter_jsx_child with uni.JsxChild entry;
    can enter_jsx_element with uni.JsxElement entry;
    can enter_jsx_element_name with uni.JsxElementName entry;
    can enter_jsx_spread_attribute with uni.JsxSpreadAttribute entry;
    can enter_jsx_normal_attribute with uni.JsxNormalAttribute entry;
    can enter_jsx_text with uni.JsxText entry;
    can enter_jsx_expression with uni.JsxExpression entry;
    can enter_jsx_slot with uni.JsxSlot entry;
    can enter_jsx_comment with uni.JsxComment entry;
    can enter_match_stmt with uni.MatchStmt entry;
    can enter_match_case with uni.MatchCase entry;
    can enter_switch_stmt with uni.SwitchStmt entry;
    can enter_switch_case with uni.SwitchCase entry;
    can enter_match_or with uni.MatchOr entry;
    can enter_match_as with uni.MatchAs entry;
    can enter_match_wild with uni.MatchWild entry;
    can enter_match_value with uni.MatchValue entry;
    can enter_match_singleton with uni.MatchSingleton entry;
    can enter_match_sequence with uni.MatchSequence entry;
    can enter_match_mapping with uni.MatchMapping entry;
    can enter_match_k_v_pair with uni.MatchKVPair entry;
    can enter_match_star with uni.MatchStar entry;
    can enter_match_arch with uni.MatchArch entry;
    can enter_token with uni.Token entry;
    can enter_string with uni.String entry;
}
