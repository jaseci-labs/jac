obj RelationSpec {
    has relation: type,
        source_types: tuple[type, ...],
        target_types: tuple[type, ...],
        family: RelationFamily,
        multiplicity: Multiplicity,
        lifetime: RelationLifetime,
        ordered: bool;

    has schema_id: str { getter; }
}

impl RelationSpec.schema_id.getter -> str {
    return "jac.ir." + self.relation.__name__;
}

def _endpoint_classes(bound: object) -> tuple[type, ...] {
    import from types { UnionType as PythonUnionType }
    import from typing { get_args }
    if isinstance(bound, type) {
        return (bound, );
    }
    if isinstance(bound, PythonUnionType) {
        classes: list[type] = [];
        for member in get_args(bound) {
            if not isinstance(member, type) {
                raise TypeError("IR endpoint unions must contain node classes");
            }
            classes.append(member);
        }
        return tuple(classes);
    }
    raise TypeError("IR endpoints must name node classes");
}

glob _RELATIONS: dict[type, RelationSpec] = {};

def relation_catalog -> dict[type, RelationSpec] {
    if _RELATIONS {
        return _RELATIONS;
    }

    rules: list[tuple[type, RelationFamily, Multiplicity, bool]] = [
        (BindingTarget, RelationFamily.BINDING, Multiplicity.OPTIONAL, False),
        (SymOf, RelationFamily.BINDING, Multiplicity.OPTIONAL, False),
        (Defines, RelationFamily.BINDING, Multiplicity.MANY, True),
        (Uses, RelationFamily.BINDING, Multiplicity.MANY, True),
        (InScope, RelationFamily.BINDING, Multiplicity.MANY, True),
        (ScopePrimary, RelationFamily.BINDING, Multiplicity.MANY, True),
        (ScopeOverload, RelationFamily.BINDING, Multiplicity.MANY, True),
        (ScopeChild, RelationFamily.BINDING, Multiplicity.MANY, True),
        (ScopeParent, RelationFamily.BINDING, Multiplicity.OPTIONAL, False),
        (CalleeDecl, RelationFamily.BINDING, Multiplicity.OPTIONAL, False),
        (Absorbs, RelationFamily.BINDING, Multiplicity.OPTIONAL, False),
        (ImplOf, RelationFamily.BINDING, Multiplicity.OPTIONAL, False),
        (CfgSucc, RelationFamily.FLOW, Multiplicity.MANY, True),
        (CfgTrue, RelationFamily.FLOW, Multiplicity.OPTIONAL, False),
        (CfgFalse, RelationFamily.FLOW, Multiplicity.OPTIONAL, False),
        (TypeOf, RelationFamily.TYPES, Multiplicity.OPTIONAL, False),
        (NarrowedTypeOf, RelationFamily.TYPES, Multiplicity.OPTIONAL, False),
        (EventTriggerOf, RelationFamily.TYPES, Multiplicity.MANY, True),
        (SharedOf, RelationFamily.TYPES, Multiplicity.OPTIONAL, False),
        (PrivOf, RelationFamily.TYPES, Multiplicity.OPTIONAL, False),
        (BaseOf, RelationFamily.TYPES, Multiplicity.MANY, True),
        (MroOf, RelationFamily.TYPES, Multiplicity.MANY, True),
        (TypeParamOf, RelationFamily.TYPES, Multiplicity.MANY, True),
        (TypeArgOf, RelationFamily.TYPES, Multiplicity.MANY, True),
        (ParamOf, RelationFamily.TYPES, Multiplicity.MANY, True),
        (ReturnsOf, RelationFamily.TYPES, Multiplicity.OPTIONAL, False),
        (GuardOf, RelationFamily.TYPES, Multiplicity.OPTIONAL, False),
        (ParamTypeOf, RelationFamily.TYPES, Multiplicity.OPTIONAL, False),
        (ParamDefaultOf, RelationFamily.TYPES, Multiplicity.OPTIONAL, False),
        (UnionMemberOf, RelationFamily.TYPES, Multiplicity.MANY, True),
        (BoundOf, RelationFamily.TYPES, Multiplicity.OPTIONAL, False),
        (ConstraintOf, RelationFamily.TYPES, Multiplicity.MANY, True),
        (OverloadOf, RelationFamily.TYPES, Multiplicity.MANY, True),
        (EnumClassOf, RelationFamily.TYPES, Multiplicity.OPTIONAL, False),
        (ValueTypeOf, RelationFamily.TYPES, Multiplicity.OPTIONAL, False),
        (MemberInfoOf, RelationFamily.TYPES, Multiplicity.OPTIONAL, False),
        (TypeMemberOf, RelationFamily.TYPES, Multiplicity.MANY, True),
        (EnumMemberOf, RelationFamily.TYPES, Multiplicity.MANY, True),
        (DeclScopeOf, RelationFamily.TYPES, Multiplicity.OPTIONAL, False),
        (PlacedIn, RelationFamily.PLACEMENT, Multiplicity.OPTIONAL, False),
        (DecidedCodespace, RelationFamily.PLACEMENT, Multiplicity.OPTIONAL, False),
        (Role, RelationFamily.STRUCTURE, Multiplicity.MANY, True),
        (Kid, RelationFamily.STRUCTURE, Multiplicity.MANY, True),
        (AccessRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (AccessorsRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (AliasRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (ArchTagInfoRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (ArchTypeRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (ArgPatternsRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (AssignmentsRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (AssignsRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (AttributesRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (AugOpRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (AwaitingBodyRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (BaseClassesRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (BodyRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (BoundRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (CasesRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (CastTypeRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (CauseRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (ChainRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (ChildrenRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (ClibDeclsRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (CodeRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (CollectionRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (ComparesRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (ComprRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (ConditionRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (ConditionalRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (ConnAssignRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (ConnTypeRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (CountByRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (CtrlRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (DecoratorsRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (DefaultValRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (DescriptionRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (DocRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (DynamicTagRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (EdgeSpecRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (ElseBodyRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (ElseValueRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (EndRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (ErrorMsgRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (EventRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (ExTypeRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (ExceptsRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (ExprRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (ExprsRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (FTypeRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (FilterCondRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (FinallyBodyRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (FormatPartRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (FormatSpecRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (FromLocRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (FromTargetRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (GuardRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (HintRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (InsertLocRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (ItemsRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (IterRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (KeyRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (KeywordsRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (KvPairRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (KvPairsRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (KwPatternsRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (KwargsRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (KwonlyargsRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (LeftRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (MainRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (NameRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (NameRefRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (OpRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (OperandRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (OpsRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (OutExprRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (ParamsRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (PartsRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (PathRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (PatternRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (PatternsRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (PosonlyParamsRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (ReturnTypeRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (RightRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (RightsRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (SignatureRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (SlicesRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (SpecRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (SrcEndpointRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (StartRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (StepRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (StopRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (StringsRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (TargetRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (TgtEndpointRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (TokRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (TypeCtxRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (TypeParamsRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (TypeTagRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (UnpackRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (ValueRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (ValueTypeRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (ValuesRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (VarargsRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),
        (VarsRole, RelationFamily.STRUCTURE, Multiplicity.SLOT, True),

    ];
    identifiers: set[str] = set();
    for (relation, family, cardinality, ordered) in rules {
        descriptor = relation?.__jac_edge_endpoints__;
        if not callable(descriptor) {
            raise TypeError(f"Missing endpoint descriptor for {relation.__name__}");
        }
        endpoints = descriptor();
        if not isinstance(endpoints, tuple) or len(endpoints) != 2 {
            raise TypeError(f"Invalid endpoint descriptor for {relation.__name__}");
        }
        spec = RelationSpec(
            relation=relation,
            source_types=_endpoint_classes(endpoints[0]),
            target_types=_endpoint_classes(endpoints[1]),
            family=family,
            multiplicity=cardinality,
            lifetime=RelationLifetime.SYNTAX
                if family == RelationFamily.STRUCTURE
                else RelationLifetime.ANALYSIS,
            ordered=ordered
        );
        if spec.schema_id in identifiers {
            raise ValueError(f"Duplicate IR relation identifier: {spec.schema_id}");
        }
        identifiers.add(spec.schema_id);
        _RELATIONS[relation] = spec;
    }
    return _RELATIONS;
}

def relation_spec(relation: type) -> RelationSpec {
    spec = relation_catalog().get(relation);
    if spec is None {
        raise ValueError(f"Unregistered compiler relation: {relation.__name__}");
    }
    return spec;
}
