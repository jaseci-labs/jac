@foreign_call(requires=["gil"], errors="python", reentrant=True)
def jacpy_vm_op_COMPARE_OP(storage: &JacPyVMStorage, tstate: &JacPyThreadState, vm: lin PyVMRef from (storage, tstate)) -> own PyObjectRef {
    # opcode = COMPARE_OP;
    jacpy_abi_op_COMPARE_OP_1(&vm);
    # frame -> instr_ptr = next_instr ;
    jacpy_abi_op_COMPARE_OP_2(&vm);
    # next_instr += 2 ;
    jacpy_abi_op_COMPARE_OP_3(&vm);
    # INSTRUCTION_STATS ( COMPARE_OP ) ;
    jacpy_abi_op_COMPARE_OP_4(&vm);
    # this_instr = next_instr - 2;
    jacpy_abi_op_COMPARE_OP_5(&vm);
    # right = stack_pointer [ - 1 ] ;
    jacpy_abi_op_COMPARE_OP_6(&vm);
    # left = stack_pointer [ - 2 ] ;
    jacpy_abi_op_COMPARE_OP_7(&vm);
    # counter = read_u16 ( & this_instr [ 1 ] . cache );
    jacpy_abi_op_COMPARE_OP_8(&vm);
    if jacpy_config_op_COMPARE_OP_9() != 0 {
        # ADAPTIVE_COUNTER_TRIGGERS ( counter )
        if jacpy_abi_op_COMPARE_OP_10(&vm) != 0 {
            # next_instr = this_instr ;
            jacpy_abi_op_COMPARE_OP_11(&vm);
            # _PyFrame_SetStackPointer ( frame , stack_pointer ) ;
            jacpy_abi_op_COMPARE_OP_12(&vm);
            # _Py_Specialize_CompareOp ( left , right , next_instr , oparg ) ;
            jacpy_abi_op_COMPARE_OP_13(&vm);
            # stack_pointer = _PyFrame_GetStackPointer ( frame ) ;
            jacpy_abi_op_COMPARE_OP_14(&vm);
            # opcode = next_instr->op.code;
            jacpy_abi_op_COMPARE_OP_15(&vm);
            return __musttail(jacpy_vm_dispatch(storage, tstate, vm));
        }
        # OPCODE_DEFERRED_INC ( COMPARE_OP ) ;
        jacpy_abi_op_COMPARE_OP_16(&vm);
        # ADVANCE_ADAPTIVE_COUNTER ( this_instr [ 1 ] . counter ) ;
        jacpy_abi_op_COMPARE_OP_17(&vm);
    }
    # left_o = PyStackRef_AsPyObjectBorrow ( left );
    jacpy_abi_op_COMPARE_OP_18(&vm);
    # right_o = PyStackRef_AsPyObjectBorrow ( right );
    jacpy_abi_op_COMPARE_OP_19(&vm);
    # assert ( ( oparg >> 5 ) <= Py_GE ) ;
