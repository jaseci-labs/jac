    if jacpy_abi_op_FOR_ITER_GEN_6(&vm) != 0 {
        # UPDATE_MISS_STATS ( FOR_ITER ) ;
        jacpy_abi_op_FOR_ITER_GEN_7(&vm);
        # assert ( _PyOpcode_Deopt [ opcode ] == ( FOR_ITER ) ) ;
        jacpy_abi_op_FOR_ITER_GEN_8(&vm);
        # next_instr = this_instr;
        jacpy_abi_op_FOR_ITER_GEN_9(&vm);
        return __musttail(jacpy_vm_op_FOR_ITER(storage, tstate, vm));
    }
    # iter = stack_pointer [ - 1 ] ;
    jacpy_abi_op_FOR_ITER_GEN_10(&vm);
    # gen = ( PyGenObject * ) PyStackRef_AsPyObjectBorrow ( iter );
    jacpy_abi_op_FOR_ITER_GEN_11(&vm);
    # Py_TYPE ( gen ) != & PyGen_Type
    if jacpy_abi_op_FOR_ITER_GEN_12(&vm) != 0 {
        # UPDATE_MISS_STATS ( FOR_ITER ) ;
        jacpy_abi_op_FOR_ITER_GEN_13(&vm);
        # assert ( _PyOpcode_Deopt [ opcode ] == ( FOR_ITER ) ) ;
        jacpy_abi_op_FOR_ITER_GEN_14(&vm);
        # next_instr = this_instr;
        jacpy_abi_op_FOR_ITER_GEN_15(&vm);
        return __musttail(jacpy_vm_op_FOR_ITER(storage, tstate, vm));
    }
    # gen -> gi_frame_state >= FRAME_EXECUTING
    if jacpy_abi_op_FOR_ITER_GEN_16(&vm) != 0 {
        # UPDATE_MISS_STATS ( FOR_ITER ) ;
        jacpy_abi_op_FOR_ITER_GEN_17(&vm);
        # assert ( _PyOpcode_Deopt [ opcode ] == ( FOR_ITER ) ) ;
        jacpy_abi_op_FOR_ITER_GEN_18(&vm);
        # next_instr = this_instr;
        jacpy_abi_op_FOR_ITER_GEN_19(&vm);
        return __musttail(jacpy_vm_op_FOR_ITER(storage, tstate, vm));
    }
    # STAT_INC ( FOR_ITER , hit ) ;
    jacpy_abi_op_FOR_ITER_GEN_20(&vm);
    # gen_frame = & gen -> gi_iframe ;
    jacpy_abi_op_FOR_ITER_GEN_21(&vm);
    # _PyFrame_StackPush ( gen_frame , PyStackRef_None ) ;
    jacpy_abi_op_FOR_ITER_GEN_22(&vm);
    # gen -> gi_frame_state = FRAME_EXECUTING ;
    jacpy_abi_op_FOR_ITER_GEN_23(&vm);
    # gen -> gi_exc_state . previous_item = tstate -> exc_info ;
    jacpy_abi_op_FOR_ITER_GEN_24(&vm);
    # tstate -> exc_info = & gen -> gi_exc_state ;
    jacpy_abi_op_FOR_ITER_GEN_25(&vm);
    # gen_frame -> previous = frame ;
    jacpy_abi_op_FOR_ITER_GEN_26(&vm);
    # frame -> return_offset = ( uint16_t ) ( 2u + oparg ) ;
    jacpy_abi_op_FOR_ITER_GEN_27(&vm);
    # new_frame = gen_frame ;
    jacpy_abi_op_FOR_ITER_GEN_28(&vm);
    # assert ( tstate -> interp -> eval_frame == NULL ) ;
    jacpy_abi_op_FOR_ITER_GEN_29(&vm);
    # temp = new_frame;
    jacpy_abi_op_FOR_ITER_GEN_30(&vm);
    # _PyFrame_SetStackPointer ( frame , stack_pointer ) ;
    jacpy_abi_op_FOR_ITER_GEN_31(&vm);
    # assert ( new_frame -> previous == frame || new_frame -> previous -> previous == frame ) ;
    jacpy_abi_op_FOR_ITER_GEN_32(&vm);
    # CALL_STAT_INC ( inlined_py_calls ) ;
    jacpy_abi_op_FOR_ITER_GEN_33(&vm);
    # frame = tstate -> current_frame = temp ;
    jacpy_abi_op_FOR_ITER_GEN_34(&vm);
    # tstate -> py_recursion_remaining -- ;
    jacpy_abi_op_FOR_ITER_GEN_35(&vm);
    # LOAD_SP ( ) ;
    jacpy_abi_op_FOR_ITER_GEN_36(&vm);
    # next_instr = frame->instr_ptr + (0);
    jacpy_abi_op_FOR_ITER_GEN_37(&vm);
    # assert(frame->stackpointer == NULL); NEXTOPARG();
    jacpy_abi_op_FOR_ITER_GEN_38(&vm);
    return __musttail(jacpy_vm_dispatch(storage, tstate, vm));
}

