    # _PyFrame_SetStackPointer ( frame , stack_pointer ) ;
    jacpy_abi_op_CALL_BUILTIN_O_43(&vm);
    # PyStackRef_CLOSE ( callable ) ;
    jacpy_abi_op_CALL_BUILTIN_O_44(&vm);
    # stack_pointer = _PyFrame_GetStackPointer ( frame ) ;
    jacpy_abi_op_CALL_BUILTIN_O_45(&vm);
    # res_o == NULL
    if jacpy_abi_op_CALL_BUILTIN_O_46(&vm) != 0 {
        return __musttail(jacpy_vm_error(storage, tstate, vm));
