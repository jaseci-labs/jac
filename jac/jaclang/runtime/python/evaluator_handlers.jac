    jacpy_abi_op_COMPARE_OP_43(&vm);
    # stack_pointer += 1 ;
    jacpy_abi_op_COMPARE_OP_44(&vm);
    # assert ( WITHIN_STACK_BOUNDS ( ) ) ;
    jacpy_abi_op_COMPARE_OP_45(&vm);
    # assert(frame->stackpointer == NULL); NEXTOPARG();
    jacpy_abi_op_COMPARE_OP_46(&vm);
    return __musttail(jacpy_vm_dispatch(storage, tstate, vm));
}

