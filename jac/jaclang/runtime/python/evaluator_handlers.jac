        jacpy_abi_op_COMPARE_OP_39(&vm);
        # res_bool < 0
        if jacpy_abi_op_COMPARE_OP_40(&vm) != 0 {
            return __musttail(jacpy_vm_error(storage, tstate, vm));
        }
        # res = res_bool ? PyStackRef_True : PyStackRef_False ;
        jacpy_abi_op_COMPARE_OP_41(&vm);
