    jacpy_abi_op_CALL_KW_PY_26(&vm);
    # args = & stack_pointer [ - 1 - oparg ] ;
    jacpy_abi_op_CALL_KW_PY_27(&vm);
    # self_or_null = stack_pointer [ - 2 - oparg ] ;
    jacpy_abi_op_CALL_KW_PY_28(&vm);
