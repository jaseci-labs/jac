@foreign_call(requires=["gil"], errors="python", reentrant=True)
def jacpy_vm_op_JUMP_BACKWARD(storage: &JacPyVMStorage, tstate: &JacPyThreadState, vm: lin PyVMRef from (storage, tstate)) -> own PyObjectRef {
    # opcode = JUMP_BACKWARD;
    jacpy_abi_op_JUMP_BACKWARD_1(&vm);
    # frame -> instr_ptr = next_instr ;
    jacpy_abi_op_JUMP_BACKWARD_2(&vm);
    # next_instr += 2 ;
    jacpy_abi_op_JUMP_BACKWARD_3(&vm);
    # INSTRUCTION_STATS ( JUMP_BACKWARD ) ;
    jacpy_abi_op_JUMP_BACKWARD_4(&vm);
    # this_instr = next_instr - 2;
    jacpy_abi_op_JUMP_BACKWARD_5(&vm);
    if jacpy_config_op_JUMP_BACKWARD_6() != 0 {
        # this_instr -> op . code == JUMP_BACKWARD
        if jacpy_abi_op_JUMP_BACKWARD_7(&vm) != 0 {
            # this_instr -> op . code = tstate -> interp -> jit ? JUMP_BACKWARD_JIT : JUMP_BACKWARD_NO_JIT ;
            jacpy_abi_op_JUMP_BACKWARD_8(&vm);
            # next_instr = this_instr ;
            jacpy_abi_op_JUMP_BACKWARD_9(&vm);
            # opcode = next_instr->op.code;
            jacpy_abi_op_JUMP_BACKWARD_10(&vm);
            return __musttail(jacpy_vm_dispatch(storage, tstate, vm));
        }
    }
    # _Py_CHECK_EMSCRIPTEN_SIGNALS_PERIODICALLY ( ) ;
    jacpy_abi_op_JUMP_BACKWARD_11(&vm);
    # QSBR_QUIESCENT_STATE ( tstate ) ;
    jacpy_abi_op_JUMP_BACKWARD_12(&vm);
    # _Py_atomic_load_uintptr_relaxed ( & tstate -> eval_breaker ) & _PY_EVAL_EVENTS_MASK
    if jacpy_abi_op_JUMP_BACKWARD_13(&vm) != 0 {
        # _PyFrame_SetStackPointer ( frame , stack_pointer ) ;
        jacpy_abi_op_JUMP_BACKWARD_14(&vm);
        # err = _Py_HandlePending ( tstate );
        jacpy_abi_op_JUMP_BACKWARD_15(&vm);
        # stack_pointer = _PyFrame_GetStackPointer ( frame ) ;
        jacpy_abi_op_JUMP_BACKWARD_16(&vm);
        # err != 0
        if jacpy_abi_op_JUMP_BACKWARD_17(&vm) != 0 {
            return __musttail(jacpy_vm_error(storage, tstate, vm));
        }
    }
    # assert ( oparg <= INSTR_OFFSET ( ) ) ;
    jacpy_abi_op_JUMP_BACKWARD_18(&vm);
    # JUMPBY ( - oparg ) ;
    jacpy_abi_op_JUMP_BACKWARD_19(&vm);
    # assert(frame->stackpointer == NULL); NEXTOPARG();
    jacpy_abi_op_JUMP_BACKWARD_20(&vm);
    return __musttail(jacpy_vm_dispatch(storage, tstate, vm));
}

@foreign_call(requires=["gil"], errors="python", reentrant=True)
def jacpy_vm_op_JUMP_BACKWARD_JIT(storage: &JacPyVMStorage, tstate: &JacPyThreadState, vm: lin PyVMRef from (storage, tstate)) -> own PyObjectRef {
    # opcode = JUMP_BACKWARD_JIT;
    jacpy_abi_op_JUMP_BACKWARD_JIT_1(&vm);
    # this_instr = next_instr;
    jacpy_abi_op_JUMP_BACKWARD_JIT_2(&vm);
    # frame -> instr_ptr = next_instr ;
    jacpy_abi_op_JUMP_BACKWARD_JIT_3(&vm);
    # next_instr += 2 ;
    jacpy_abi_op_JUMP_BACKWARD_JIT_4(&vm);
    # INSTRUCTION_STATS ( JUMP_BACKWARD_JIT ) ;
    jacpy_abi_op_JUMP_BACKWARD_JIT_5(&vm);
    # _Py_CHECK_EMSCRIPTEN_SIGNALS_PERIODICALLY ( ) ;
    jacpy_abi_op_JUMP_BACKWARD_JIT_6(&vm);
    # QSBR_QUIESCENT_STATE ( tstate ) ;
    jacpy_abi_op_JUMP_BACKWARD_JIT_7(&vm);
    # _Py_atomic_load_uintptr_relaxed ( & tstate -> eval_breaker ) & _PY_EVAL_EVENTS_MASK
    if jacpy_abi_op_JUMP_BACKWARD_JIT_8(&vm) != 0 {
        # _PyFrame_SetStackPointer ( frame , stack_pointer ) ;
        jacpy_abi_op_JUMP_BACKWARD_JIT_9(&vm);
        # err = _Py_HandlePending ( tstate );
        jacpy_abi_op_JUMP_BACKWARD_JIT_10(&vm);
        # stack_pointer = _PyFrame_GetStackPointer ( frame ) ;
        jacpy_abi_op_JUMP_BACKWARD_JIT_11(&vm);
        # err != 0
        if jacpy_abi_op_JUMP_BACKWARD_JIT_12(&vm) != 0 {
            return __musttail(jacpy_vm_error(storage, tstate, vm));
        }
    }
    # assert ( oparg <= INSTR_OFFSET ( ) ) ;
    jacpy_abi_op_JUMP_BACKWARD_JIT_13(&vm);
    # JUMPBY ( - oparg ) ;
    jacpy_abi_op_JUMP_BACKWARD_JIT_14(&vm);
    if jacpy_config_op_JUMP_BACKWARD_JIT_15() != 0 {
        # counter = this_instr [ 1 ] . counter;
        jacpy_abi_op_JUMP_BACKWARD_JIT_16(&vm);
        # backoff_counter_triggers ( counter ) && this_instr -> op . code == JUMP_BACKWARD_JIT
        if jacpy_abi_op_JUMP_BACKWARD_JIT_17(&vm) != 0 {
            # start = this_instr;
            jacpy_abi_op_JUMP_BACKWARD_JIT_18(&vm);
            # oparg > 255
            while jacpy_abi_op_JUMP_BACKWARD_JIT_19(&vm) != 0 {
                # oparg >>= 8 ;
                jacpy_abi_op_JUMP_BACKWARD_JIT_20(&vm);
                # start -- ;
                jacpy_abi_op_JUMP_BACKWARD_JIT_21(&vm);
            }
            # _PyFrame_SetStackPointer ( frame , stack_pointer ) ;
            jacpy_abi_op_JUMP_BACKWARD_JIT_22(&vm);
            # optimized = _PyOptimizer_Optimize ( frame , start , & executor , 0 );
            jacpy_abi_op_JUMP_BACKWARD_JIT_23(&vm);
            # stack_pointer = _PyFrame_GetStackPointer ( frame ) ;
            jacpy_abi_op_JUMP_BACKWARD_JIT_24(&vm);
            # optimized <= 0
            if jacpy_abi_op_JUMP_BACKWARD_JIT_25(&vm) != 0 {
                # this_instr [ 1 ] . counter = restart_backoff_counter ( counter ) ;
                jacpy_abi_op_JUMP_BACKWARD_JIT_26(&vm);
                # optimized < 0
                if jacpy_abi_op_JUMP_BACKWARD_JIT_27(&vm) != 0 {
                    return __musttail(jacpy_vm_error(storage, tstate, vm));
                }
            } else {
                # _PyFrame_SetStackPointer ( frame , stack_pointer ) ;
                jacpy_abi_op_JUMP_BACKWARD_JIT_28(&vm);
                # this_instr [ 1 ] . counter = initial_jump_backoff_counter ( ) ;
                jacpy_abi_op_JUMP_BACKWARD_JIT_29(&vm);
                # stack_pointer = _PyFrame_GetStackPointer ( frame ) ;
                jacpy_abi_op_JUMP_BACKWARD_JIT_30(&vm);
                # assert ( tstate -> current_executor == NULL ) ;
                jacpy_abi_op_JUMP_BACKWARD_JIT_31(&vm);
                # OPT_STAT_INC(traces_executed); tstate->current_executor = (PyObject *)(executor);
                jacpy_abi_op_JUMP_BACKWARD_JIT_32(&vm);
                if jacpy_config_op_JUMP_BACKWARD_JIT_33() != 0 {
                    # _PyExecutorObject *executor = (_PyExecutorObject *)tstate->current_executor; jit_func jitted = executor->jit_code; Py_INCREF(executor); next_instr = jitted(frame, stack_pointer, tstate); Py_DECREF(executor); frame = tstate->current_frame; stack_pointer = _PyFrame_GetStackPointer(frame);
                    jacpy_abi_op_JUMP_BACKWARD_JIT_34(&vm);
                    # next_instr == NULL
                    if jacpy_abi_op_JUMP_BACKWARD_JIT_35(&vm) != 0 {
                        # next_instr = frame->instr_ptr + 1;
                        jacpy_abi_op_JUMP_BACKWARD_JIT_36(&vm);
                        return __musttail(jacpy_vm_error(storage, tstate, vm));
                    }
                    # assert(frame->stackpointer == NULL); NEXTOPARG();
                    jacpy_abi_op_JUMP_BACKWARD_JIT_37(&vm);
                    return __musttail(jacpy_vm_dispatch(storage, tstate, vm));
                } else {
                    # next_uop = ((_PyExecutorObject *)tstate->current_executor)->trace; assert(next_uop->opcode == _START_EXECUTOR); lastuop = 0; trace_uop_execution_counter = 0;
                    jacpy_abi_op_JUMP_BACKWARD_JIT_38(&vm);
                    return __musttail(jacpy_vm_tier2_dispatch(storage, tstate, vm));
                }
            }
        } else {
            # ADVANCE_ADAPTIVE_COUNTER ( this_instr [ 1 ] . counter ) ;
            jacpy_abi_op_JUMP_BACKWARD_JIT_39(&vm);
        }
    }
    # assert(frame->stackpointer == NULL); NEXTOPARG();
    jacpy_abi_op_JUMP_BACKWARD_JIT_40(&vm);
    return __musttail(jacpy_vm_dispatch(storage, tstate, vm));
}

