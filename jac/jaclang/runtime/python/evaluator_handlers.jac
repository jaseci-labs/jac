@foreign_call(requires=["gil"], errors="python", reentrant=True)
def jacpy_vm_op_FOR_ITER(storage: &JacPyVMStorage, tstate: &JacPyThreadState, vm: lin PyVMRef from (storage, tstate)) -> own PyObjectRef {
    # opcode = FOR_ITER;
    jacpy_abi_op_FOR_ITER_1(&vm);
    # frame -> instr_ptr = next_instr ;
    jacpy_abi_op_FOR_ITER_2(&vm);
    # next_instr += 2 ;
    jacpy_abi_op_FOR_ITER_3(&vm);
    # INSTRUCTION_STATS ( FOR_ITER ) ;
    jacpy_abi_op_FOR_ITER_4(&vm);
    # this_instr = next_instr - 2;
    jacpy_abi_op_FOR_ITER_5(&vm);
    # iter = stack_pointer [ - 1 ] ;
    jacpy_abi_op_FOR_ITER_6(&vm);
    # counter = read_u16 ( & this_instr [ 1 ] . cache );
    jacpy_abi_op_FOR_ITER_7(&vm);
    if jacpy_config_op_FOR_ITER_8() != 0 {
        # ADAPTIVE_COUNTER_TRIGGERS ( counter )
        if jacpy_abi_op_FOR_ITER_9(&vm) != 0 {
            # next_instr = this_instr ;
            jacpy_abi_op_FOR_ITER_10(&vm);
            # _PyFrame_SetStackPointer ( frame , stack_pointer ) ;
            jacpy_abi_op_FOR_ITER_11(&vm);
            # _Py_Specialize_ForIter ( iter , next_instr , oparg ) ;
            jacpy_abi_op_FOR_ITER_12(&vm);
            # stack_pointer = _PyFrame_GetStackPointer ( frame ) ;
            jacpy_abi_op_FOR_ITER_13(&vm);
            # opcode = next_instr->op.code;
            jacpy_abi_op_FOR_ITER_14(&vm);
            return __musttail(jacpy_vm_dispatch(storage, tstate, vm));
        }
        # OPCODE_DEFERRED_INC ( FOR_ITER ) ;
        jacpy_abi_op_FOR_ITER_15(&vm);
        # ADVANCE_ADAPTIVE_COUNTER ( this_instr [ 1 ] . counter ) ;
        jacpy_abi_op_FOR_ITER_16(&vm);
    }
    # iter_o = PyStackRef_AsPyObjectBorrow ( iter );
    jacpy_abi_op_FOR_ITER_17(&vm);
    # iternextfunc func = Py_TYPE ( iter_o ) -> tp_iternext ;
    jacpy_abi_op_FOR_ITER_18(&vm);
    # func == NULL
    if jacpy_abi_op_FOR_ITER_19(&vm) != 0 {
        # _PyFrame_SetStackPointer ( frame , stack_pointer ) ;
        jacpy_abi_op_FOR_ITER_20(&vm);
        # _PyErr_Format ( tstate , PyExc_TypeError , "'%.100s' object is not an iterator" , Py_TYPE ( iter_o ) -> tp_name ) ;
        jacpy_abi_op_FOR_ITER_21(&vm);
        # stack_pointer = _PyFrame_GetStackPointer ( frame ) ;
        jacpy_abi_op_FOR_ITER_22(&vm);
        return __musttail(jacpy_vm_error(storage, tstate, vm));
    }
    # _PyFrame_SetStackPointer ( frame , stack_pointer ) ;
    jacpy_abi_op_FOR_ITER_23(&vm);
    # next_o = func ( iter_o );
    jacpy_abi_op_FOR_ITER_24(&vm);
    # stack_pointer = _PyFrame_GetStackPointer ( frame ) ;
    jacpy_abi_op_FOR_ITER_25(&vm);
    # next_o == NULL
    if jacpy_abi_op_FOR_ITER_26(&vm) != 0 {
        # _PyErr_Occurred ( tstate )
        if jacpy_abi_op_FOR_ITER_27(&vm) != 0 {
            # _PyFrame_SetStackPointer ( frame , stack_pointer ) ;
            jacpy_abi_op_FOR_ITER_28(&vm);
            # matches = _PyErr_ExceptionMatches ( tstate , PyExc_StopIteration );
            jacpy_abi_op_FOR_ITER_29(&vm);
            # stack_pointer = _PyFrame_GetStackPointer ( frame ) ;
            jacpy_abi_op_FOR_ITER_30(&vm);
            # ! matches
            if jacpy_abi_op_FOR_ITER_31(&vm) != 0 {
                return __musttail(jacpy_vm_error(storage, tstate, vm));
            }
            # _PyFrame_SetStackPointer ( frame , stack_pointer ) ;
            jacpy_abi_op_FOR_ITER_32(&vm);
            # _PyEval_MonitorRaise ( tstate , frame , this_instr ) ;
            jacpy_abi_op_FOR_ITER_33(&vm);
            # _PyErr_Clear ( tstate ) ;
            jacpy_abi_op_FOR_ITER_34(&vm);
            # stack_pointer = _PyFrame_GetStackPointer ( frame ) ;
            jacpy_abi_op_FOR_ITER_35(&vm);
        }
        # assert ( next_instr [ oparg ] . op . code == END_FOR || next_instr [ oparg ] . op . code == INSTRUMENTED_END_FOR ) ;
        jacpy_abi_op_FOR_ITER_36(&vm);
        # JUMPBY ( oparg + 1 ) ;
        jacpy_abi_op_FOR_ITER_37(&vm);
        # assert(frame->stackpointer == NULL); NEXTOPARG();
        jacpy_abi_op_FOR_ITER_38(&vm);
        return __musttail(jacpy_vm_dispatch(storage, tstate, vm));
    }
    # next = PyStackRef_FromPyObjectSteal ( next_o ) ;
    jacpy_abi_op_FOR_ITER_39(&vm);
    # stack_pointer [ 0 ] = next ;
    jacpy_abi_op_FOR_ITER_40(&vm);
    # stack_pointer += 1 ;
    jacpy_abi_op_FOR_ITER_41(&vm);
    # assert ( WITHIN_STACK_BOUNDS ( ) ) ;
    jacpy_abi_op_FOR_ITER_42(&vm);
    # assert(frame->stackpointer == NULL); NEXTOPARG();
    jacpy_abi_op_FOR_ITER_43(&vm);
    return __musttail(jacpy_vm_dispatch(storage, tstate, vm));
}

@foreign_call(requires=["gil"], errors="python", reentrant=True)
def jacpy_vm_op_FOR_ITER_GEN(storage: &JacPyVMStorage, tstate: &JacPyThreadState, vm: lin PyVMRef from (storage, tstate)) -> own PyObjectRef {
    # opcode = FOR_ITER_GEN;
