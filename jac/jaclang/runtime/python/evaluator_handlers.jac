@foreign_call(requires=["gil"], errors="python", reentrant=True)
def jacpy_vm_op_RESUME(storage: &JacPyVMStorage, tstate: &JacPyThreadState, vm: lin PyVMRef from (storage, tstate)) -> own PyObjectRef {
    # opcode = RESUME;
    jacpy_abi_op_RESUME_1(&vm);
    # frame -> instr_ptr = next_instr ;
    jacpy_abi_op_RESUME_2(&vm);
    # next_instr += 1 ;
    jacpy_abi_op_RESUME_3(&vm);
    # INSTRUCTION_STATS ( RESUME ) ;
    jacpy_abi_op_RESUME_4(&vm);
    # this_instr = next_instr - 1;
    jacpy_abi_op_RESUME_5(&vm);
    # check_instrumentation = ( tstate -> tracing == 0 );
    jacpy_abi_op_RESUME_6(&vm);
    # check_instrumentation
    if jacpy_abi_op_RESUME_7(&vm) != 0 {
        # global_version = _Py_atomic_load_uintptr_relaxed ( & tstate -> eval_breaker ) & ~ _PY_EVAL_EVENTS_MASK;
        jacpy_abi_op_RESUME_8(&vm);
        # code_version = FT_ATOMIC_LOAD_UINTPTR_ACQUIRE ( _PyFrame_GetCode ( frame ) -> _co_instrumentation_version );
        jacpy_abi_op_RESUME_9(&vm);
        # code_version != global_version
        if jacpy_abi_op_RESUME_10(&vm) != 0 {
            # _PyFrame_SetStackPointer ( frame , stack_pointer ) ;
            jacpy_abi_op_RESUME_11(&vm);
            # err = _Py_Instrument ( _PyFrame_GetCode ( frame ) , tstate -> interp );
            jacpy_abi_op_RESUME_12(&vm);
            # stack_pointer = _PyFrame_GetStackPointer ( frame ) ;
            jacpy_abi_op_RESUME_13(&vm);
            # err
            if jacpy_abi_op_RESUME_14(&vm) != 0 {
                return __musttail(jacpy_vm_error(storage, tstate, vm));
            }
            # next_instr = this_instr ;
            jacpy_abi_op_RESUME_15(&vm);
            # assert(frame->stackpointer == NULL); NEXTOPARG();
            jacpy_abi_op_RESUME_16(&vm);
            return __musttail(jacpy_vm_dispatch(storage, tstate, vm));
        }
    }
    if jacpy_config_op_RESUME_17() != 0 {
        # tstate -> tracing == 0 && this_instr -> op . code == RESUME
        if jacpy_abi_op_RESUME_18(&vm) != 0 {
            # FT_ATOMIC_STORE_UINT8_RELAXED ( this_instr -> op . code , RESUME_CHECK ) ;
            jacpy_abi_op_RESUME_19(&vm);
        }
    }
    # ( oparg & RESUME_OPARG_LOCATION_MASK ) < RESUME_AFTER_YIELD_FROM
    if jacpy_abi_op_RESUME_20(&vm) != 0 {
        # _Py_CHECK_EMSCRIPTEN_SIGNALS_PERIODICALLY ( ) ;
        jacpy_abi_op_RESUME_21(&vm);
        # QSBR_QUIESCENT_STATE ( tstate ) ;
        jacpy_abi_op_RESUME_22(&vm);
        # _Py_atomic_load_uintptr_relaxed ( & tstate -> eval_breaker ) & _PY_EVAL_EVENTS_MASK
        if jacpy_abi_op_RESUME_23(&vm) != 0 {
            # _PyFrame_SetStackPointer ( frame , stack_pointer ) ;
            jacpy_abi_op_RESUME_24(&vm);
            # err = _Py_HandlePending ( tstate );
            jacpy_abi_op_RESUME_25(&vm);
            # stack_pointer = _PyFrame_GetStackPointer ( frame ) ;
            jacpy_abi_op_RESUME_26(&vm);
            # err != 0
            if jacpy_abi_op_RESUME_27(&vm) != 0 {
                return __musttail(jacpy_vm_error(storage, tstate, vm));
            }
        }
    }
    # assert(frame->stackpointer == NULL); NEXTOPARG();
    jacpy_abi_op_RESUME_28(&vm);
    return __musttail(jacpy_vm_dispatch(storage, tstate, vm));
}

