    jacpy_abi_op_CALL_KW_PY_38(&vm);
    # locals = code_flags & CO_OPTIMIZED ? NULL : Py_NewRef ( PyFunction_GET_GLOBALS ( callable_o ) );
    jacpy_abi_op_CALL_KW_PY_39(&vm);
    # _PyFrame_SetStackPointer ( frame , stack_pointer ) ;
    jacpy_abi_op_CALL_KW_PY_40(&vm);
