    jacpy_abi_op_CALL_KW_PY_41(&vm);
    # stack_pointer = _PyFrame_GetStackPointer ( frame ) ;
    jacpy_abi_op_CALL_KW_PY_42(&vm);
    # stack_pointer += - 1 ;
    jacpy_abi_op_CALL_KW_PY_43(&vm);
    # assert ( WITHIN_STACK_BOUNDS ( ) ) ;
    jacpy_abi_op_CALL_KW_PY_44(&vm);
    # _PyFrame_SetStackPointer ( frame , stack_pointer ) ;
    jacpy_abi_op_CALL_KW_PY_45(&vm);
    # PyStackRef_CLOSE ( kwnames ) ;
