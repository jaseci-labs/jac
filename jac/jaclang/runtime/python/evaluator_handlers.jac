        # UPDATE_MISS_STATS ( CALL_KW ) ;
        jacpy_abi_op_CALL_KW_PY_14(&vm);
        # assert ( _PyOpcode_Deopt [ opcode ] == ( CALL_KW ) ) ;
        jacpy_abi_op_CALL_KW_PY_15(&vm);
        # next_instr = this_instr;
        jacpy_abi_op_CALL_KW_PY_16(&vm);
        return __musttail(jacpy_vm_op_CALL_KW(storage, tstate, vm));
    }
    # func = ( PyFunctionObject * ) callable_o;
    jacpy_abi_op_CALL_KW_PY_17(&vm);
    # func -> func_version != func_version
    if jacpy_abi_op_CALL_KW_PY_18(&vm) != 0 {
        # UPDATE_MISS_STATS ( CALL_KW ) ;
        jacpy_abi_op_CALL_KW_PY_19(&vm);
        # assert ( _PyOpcode_Deopt [ opcode ] == ( CALL_KW ) ) ;
