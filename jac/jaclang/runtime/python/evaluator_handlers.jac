        jacpy_abi_op_CALL_KW_PY_33(&vm);
        # total_args ++ ;
        jacpy_abi_op_CALL_KW_PY_34(&vm);
    }
    # kwnames_o = PyStackRef_AsPyObjectBorrow ( kwnames );
    jacpy_abi_op_CALL_KW_PY_35(&vm);
    # positional_args = total_args - ( int ) PyTuple_GET_SIZE ( kwnames_o );
    jacpy_abi_op_CALL_KW_PY_36(&vm);
