def jacpy_vm_op_LOAD_ATTR_WITH_HINT(storage: &JacPyVMStorage, tstate: &JacPyThreadState, vm: lin PyVMRef from (storage, tstate)) -> own PyObjectRef {
    # opcode = LOAD_ATTR_WITH_HINT;
    jacpy_abi_op_LOAD_ATTR_WITH_HINT_1(&vm);
    # this_instr = next_instr;
    jacpy_abi_op_LOAD_ATTR_WITH_HINT_2(&vm);
    # frame -> instr_ptr = next_instr ;
    jacpy_abi_op_LOAD_ATTR_WITH_HINT_3(&vm);
    # next_instr += 10 ;
    jacpy_abi_op_LOAD_ATTR_WITH_HINT_4(&vm);
    # INSTRUCTION_STATS ( LOAD_ATTR_WITH_HINT ) ;
    jacpy_abi_op_LOAD_ATTR_WITH_HINT_5(&vm);
    # owner = stack_pointer [ - 1 ] ;
    jacpy_abi_op_LOAD_ATTR_WITH_HINT_6(&vm);
    # type_version = read_u32 ( & this_instr [ 2 ] . cache );
    jacpy_abi_op_LOAD_ATTR_WITH_HINT_7(&vm);
    # tp = Py_TYPE ( PyStackRef_AsPyObjectBorrow ( owner ) );
    jacpy_abi_op_LOAD_ATTR_WITH_HINT_8(&vm);
    # assert ( type_version != 0 ) ;
    jacpy_abi_op_LOAD_ATTR_WITH_HINT_9(&vm);
    # FT_ATOMIC_LOAD_UINT_RELAXED ( tp -> tp_version_tag ) != type_version
    if jacpy_abi_op_LOAD_ATTR_WITH_HINT_10(&vm) != 0 {
        # UPDATE_MISS_STATS ( LOAD_ATTR ) ;
        jacpy_abi_op_LOAD_ATTR_WITH_HINT_11(&vm);
        # assert ( _PyOpcode_Deopt [ opcode ] == ( LOAD_ATTR ) ) ;
        jacpy_abi_op_LOAD_ATTR_WITH_HINT_12(&vm);
        # next_instr = this_instr;
        jacpy_abi_op_LOAD_ATTR_WITH_HINT_13(&vm);
        return __musttail(jacpy_vm_op_LOAD_ATTR(storage, tstate, vm));
    }
    # hint = read_u16 ( & this_instr [ 4 ] . cache );
    jacpy_abi_op_LOAD_ATTR_WITH_HINT_14(&vm);
    # owner_o = PyStackRef_AsPyObjectBorrow ( owner );
    jacpy_abi_op_LOAD_ATTR_WITH_HINT_15(&vm);
    # assert ( Py_TYPE ( owner_o ) -> tp_flags & Py_TPFLAGS_MANAGED_DICT ) ;
    jacpy_abi_op_LOAD_ATTR_WITH_HINT_16(&vm);
    # dict = _PyObject_GetManagedDict ( owner_o );
    jacpy_abi_op_LOAD_ATTR_WITH_HINT_17(&vm);
    # dict == NULL
    if jacpy_abi_op_LOAD_ATTR_WITH_HINT_18(&vm) != 0 {
        # UPDATE_MISS_STATS ( LOAD_ATTR ) ;
        jacpy_abi_op_LOAD_ATTR_WITH_HINT_19(&vm);
        # assert ( _PyOpcode_Deopt [ opcode ] == ( LOAD_ATTR ) ) ;
        jacpy_abi_op_LOAD_ATTR_WITH_HINT_20(&vm);
        # next_instr = this_instr;
        jacpy_abi_op_LOAD_ATTR_WITH_HINT_21(&vm);
        return __musttail(jacpy_vm_op_LOAD_ATTR(storage, tstate, vm));
    }
    # dk = FT_ATOMIC_LOAD_PTR ( dict -> ma_keys );
    jacpy_abi_op_LOAD_ATTR_WITH_HINT_22(&vm);
    # assert ( PyDict_CheckExact ( ( PyObject * ) dict ) ) ;
    jacpy_abi_op_LOAD_ATTR_WITH_HINT_23(&vm);
    # hint >= ( size_t ) FT_ATOMIC_LOAD_SSIZE_RELAXED ( dk -> dk_nentries )
    if jacpy_abi_op_LOAD_ATTR_WITH_HINT_24(&vm) != 0 {
        # true
        if jacpy_abi_op_LOAD_ATTR_WITH_HINT_25(&vm) != 0 {
            # UPDATE_MISS_STATS ( LOAD_ATTR ) ;
            jacpy_abi_op_LOAD_ATTR_WITH_HINT_26(&vm);
            # assert ( _PyOpcode_Deopt [ opcode ] == ( LOAD_ATTR ) ) ;
            jacpy_abi_op_LOAD_ATTR_WITH_HINT_27(&vm);
            # next_instr = this_instr;
            jacpy_abi_op_LOAD_ATTR_WITH_HINT_28(&vm);
            return __musttail(jacpy_vm_op_LOAD_ATTR(storage, tstate, vm));
        }
    }
    # name = GETITEM ( FRAME_CO_NAMES , oparg >> 1 );
    jacpy_abi_op_LOAD_ATTR_WITH_HINT_29(&vm);
    # dk -> dk_kind != DICT_KEYS_UNICODE
    if jacpy_abi_op_LOAD_ATTR_WITH_HINT_30(&vm) != 0 {
        # true
        if jacpy_abi_op_LOAD_ATTR_WITH_HINT_31(&vm) != 0 {
            # UPDATE_MISS_STATS ( LOAD_ATTR ) ;
            jacpy_abi_op_LOAD_ATTR_WITH_HINT_32(&vm);
            # assert ( _PyOpcode_Deopt [ opcode ] == ( LOAD_ATTR ) ) ;
            jacpy_abi_op_LOAD_ATTR_WITH_HINT_33(&vm);
            # next_instr = this_instr;
            jacpy_abi_op_LOAD_ATTR_WITH_HINT_34(&vm);
            return __musttail(jacpy_vm_op_LOAD_ATTR(storage, tstate, vm));
        }
    }
    # ep = DK_UNICODE_ENTRIES ( dk ) + hint;
    jacpy_abi_op_LOAD_ATTR_WITH_HINT_35(&vm);
    # FT_ATOMIC_LOAD_PTR_RELAXED ( ep -> me_key ) != name
    if jacpy_abi_op_LOAD_ATTR_WITH_HINT_36(&vm) != 0 {
        # true
        if jacpy_abi_op_LOAD_ATTR_WITH_HINT_37(&vm) != 0 {
            # UPDATE_MISS_STATS ( LOAD_ATTR ) ;
            jacpy_abi_op_LOAD_ATTR_WITH_HINT_38(&vm);
            # assert ( _PyOpcode_Deopt [ opcode ] == ( LOAD_ATTR ) ) ;
            jacpy_abi_op_LOAD_ATTR_WITH_HINT_39(&vm);
            # next_instr = this_instr;
            jacpy_abi_op_LOAD_ATTR_WITH_HINT_40(&vm);
            return __musttail(jacpy_vm_op_LOAD_ATTR(storage, tstate, vm));
        }
    }
    # attr_o = FT_ATOMIC_LOAD_PTR ( ep -> me_value ) ;
    jacpy_abi_op_LOAD_ATTR_WITH_HINT_41(&vm);
    # attr_o == NULL
    if jacpy_abi_op_LOAD_ATTR_WITH_HINT_42(&vm) != 0 {
        # true
        if jacpy_abi_op_LOAD_ATTR_WITH_HINT_43(&vm) != 0 {
            # UPDATE_MISS_STATS ( LOAD_ATTR ) ;
            jacpy_abi_op_LOAD_ATTR_WITH_HINT_44(&vm);
            # assert ( _PyOpcode_Deopt [ opcode ] == ( LOAD_ATTR ) ) ;
            jacpy_abi_op_LOAD_ATTR_WITH_HINT_45(&vm);
            # next_instr = this_instr;
            jacpy_abi_op_LOAD_ATTR_WITH_HINT_46(&vm);
            return __musttail(jacpy_vm_op_LOAD_ATTR(storage, tstate, vm));
        }
    }
    # STAT_INC ( LOAD_ATTR , hit ) ;
    jacpy_abi_op_LOAD_ATTR_WITH_HINT_47(&vm);
    # attr = PyStackRef_FromPyObjectNew ( attr_o ) ;
    jacpy_abi_op_LOAD_ATTR_WITH_HINT_48(&vm);
    # stack_pointer [ - 1 ] = attr ;
    jacpy_abi_op_LOAD_ATTR_WITH_HINT_49(&vm);
    # _PyFrame_SetStackPointer ( frame , stack_pointer ) ;
    jacpy_abi_op_LOAD_ATTR_WITH_HINT_50(&vm);
    # PyStackRef_CLOSE ( owner ) ;
    jacpy_abi_op_LOAD_ATTR_WITH_HINT_51(&vm);
    # stack_pointer = _PyFrame_GetStackPointer ( frame ) ;
    jacpy_abi_op_LOAD_ATTR_WITH_HINT_52(&vm);
    # null = & stack_pointer [ 0 ] ;
    jacpy_abi_op_LOAD_ATTR_WITH_HINT_53(&vm);
    # oparg & 1
    if jacpy_abi_op_LOAD_ATTR_WITH_HINT_54(&vm) != 0 {
        # null [ 0 ] = PyStackRef_NULL ;
        jacpy_abi_op_LOAD_ATTR_WITH_HINT_55(&vm);
    }
    # stack_pointer += ( oparg & 1 ) ;
    jacpy_abi_op_LOAD_ATTR_WITH_HINT_56(&vm);
    # assert ( WITHIN_STACK_BOUNDS ( ) ) ;
    jacpy_abi_op_LOAD_ATTR_WITH_HINT_57(&vm);
    # assert(frame->stackpointer == NULL); NEXTOPARG();
    jacpy_abi_op_LOAD_ATTR_WITH_HINT_58(&vm);
    return __musttail(jacpy_vm_dispatch(storage, tstate, vm));
}

@foreign_call(requires=["gil"], errors="python", reentrant=True)
def jacpy_vm_op_LOAD_BUILD_CLASS(storage: &JacPyVMStorage, tstate: &JacPyThreadState, vm: lin PyVMRef from (storage, tstate)) -> own PyObjectRef {
    # opcode = LOAD_BUILD_CLASS;
    jacpy_abi_op_LOAD_BUILD_CLASS_1(&vm);
    # frame -> instr_ptr = next_instr ;
    jacpy_abi_op_LOAD_BUILD_CLASS_2(&vm);
    # next_instr += 1 ;
    jacpy_abi_op_LOAD_BUILD_CLASS_3(&vm);
    # INSTRUCTION_STATS ( LOAD_BUILD_CLASS ) ;
    jacpy_abi_op_LOAD_BUILD_CLASS_4(&vm);
    # _PyFrame_SetStackPointer ( frame , stack_pointer ) ;
    jacpy_abi_op_LOAD_BUILD_CLASS_5(&vm);
    # err = PyMapping_GetOptionalItem ( BUILTINS ( ) , & _Py_ID ( __build_class__ ) , & bc_o );
    jacpy_abi_op_LOAD_BUILD_CLASS_6(&vm);
    # stack_pointer = _PyFrame_GetStackPointer ( frame ) ;
    jacpy_abi_op_LOAD_BUILD_CLASS_7(&vm);
    # err < 0
    if jacpy_abi_op_LOAD_BUILD_CLASS_8(&vm) != 0 {
        return __musttail(jacpy_vm_error(storage, tstate, vm));
    }
    # bc_o == NULL
    if jacpy_abi_op_LOAD_BUILD_CLASS_9(&vm) != 0 {
        # _PyFrame_SetStackPointer ( frame , stack_pointer ) ;
        jacpy_abi_op_LOAD_BUILD_CLASS_10(&vm);
        # _PyErr_SetString ( tstate , PyExc_NameError , "__build_class__ not found" ) ;
        jacpy_abi_op_LOAD_BUILD_CLASS_11(&vm);
        # stack_pointer = _PyFrame_GetStackPointer ( frame ) ;
        jacpy_abi_op_LOAD_BUILD_CLASS_12(&vm);
        return __musttail(jacpy_vm_error(storage, tstate, vm));
    }
    # bc = PyStackRef_FromPyObjectSteal ( bc_o ) ;
    jacpy_abi_op_LOAD_BUILD_CLASS_13(&vm);
    # stack_pointer [ 0 ] = bc ;
    jacpy_abi_op_LOAD_BUILD_CLASS_14(&vm);
    # stack_pointer += 1 ;
    jacpy_abi_op_LOAD_BUILD_CLASS_15(&vm);
    # assert ( WITHIN_STACK_BOUNDS ( ) ) ;
    jacpy_abi_op_LOAD_BUILD_CLASS_16(&vm);
    # assert(frame->stackpointer == NULL); NEXTOPARG();
    jacpy_abi_op_LOAD_BUILD_CLASS_17(&vm);
    return __musttail(jacpy_vm_dispatch(storage, tstate, vm));
}

