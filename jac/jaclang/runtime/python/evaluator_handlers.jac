        # stack_pointer += - 1 ;
        jacpy_abi_op_CALL_121(&vm);
    }
    # stack_pointer [ 0 ] = res ;
    jacpy_abi_op_CALL_122(&vm);
    # stack_pointer += 1 ;
    jacpy_abi_op_CALL_123(&vm);
    # assert ( WITHIN_STACK_BOUNDS ( ) ) ;
    jacpy_abi_op_CALL_124(&vm);
    # assert(frame->stackpointer == NULL); NEXTOPARG();
    jacpy_abi_op_CALL_125(&vm);
    return __musttail(jacpy_vm_dispatch(storage, tstate, vm));
}

