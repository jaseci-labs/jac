@foreign_call(requires=["gil"], errors="python", reentrant=True)
def jacpy_vm_op_CONTAINS_OP(storage: &JacPyVMStorage, tstate: &JacPyThreadState, vm: lin PyVMRef from (storage, tstate)) -> own PyObjectRef {
    # opcode = CONTAINS_OP;
    jacpy_abi_op_CONTAINS_OP_1(&vm);
    # frame -> instr_ptr = next_instr ;
    jacpy_abi_op_CONTAINS_OP_2(&vm);
    # next_instr += 2 ;
    jacpy_abi_op_CONTAINS_OP_3(&vm);
    # INSTRUCTION_STATS ( CONTAINS_OP ) ;
    jacpy_abi_op_CONTAINS_OP_4(&vm);
    # this_instr = next_instr - 2;
    jacpy_abi_op_CONTAINS_OP_5(&vm);
    # right = stack_pointer [ - 1 ] ;
    jacpy_abi_op_CONTAINS_OP_6(&vm);
    # counter = read_u16 ( & this_instr [ 1 ] . cache );
    jacpy_abi_op_CONTAINS_OP_7(&vm);
    if jacpy_config_op_CONTAINS_OP_8() != 0 {
        # ADAPTIVE_COUNTER_TRIGGERS ( counter )
        if jacpy_abi_op_CONTAINS_OP_9(&vm) != 0 {
            # next_instr = this_instr ;
            jacpy_abi_op_CONTAINS_OP_10(&vm);
            # _PyFrame_SetStackPointer ( frame , stack_pointer ) ;
            jacpy_abi_op_CONTAINS_OP_11(&vm);
            # _Py_Specialize_ContainsOp ( right , next_instr ) ;
            jacpy_abi_op_CONTAINS_OP_12(&vm);
            # stack_pointer = _PyFrame_GetStackPointer ( frame ) ;
            jacpy_abi_op_CONTAINS_OP_13(&vm);
            # opcode = next_instr->op.code;
            jacpy_abi_op_CONTAINS_OP_14(&vm);
            return __musttail(jacpy_vm_dispatch(storage, tstate, vm));
        }
        # OPCODE_DEFERRED_INC ( CONTAINS_OP ) ;
        jacpy_abi_op_CONTAINS_OP_15(&vm);
        # ADVANCE_ADAPTIVE_COUNTER ( this_instr [ 1 ] . counter ) ;
        jacpy_abi_op_CONTAINS_OP_16(&vm);
    }
    # left = stack_pointer [ - 2 ] ;
    jacpy_abi_op_CONTAINS_OP_17(&vm);
    # left_o = PyStackRef_AsPyObjectBorrow ( left );
    jacpy_abi_op_CONTAINS_OP_18(&vm);
    # right_o = PyStackRef_AsPyObjectBorrow ( right );
    jacpy_abi_op_CONTAINS_OP_19(&vm);
    # _PyFrame_SetStackPointer ( frame , stack_pointer ) ;
    jacpy_abi_op_CONTAINS_OP_20(&vm);
    # res = PySequence_Contains ( right_o , left_o );
    jacpy_abi_op_CONTAINS_OP_21(&vm);
    # tmp = right;
    jacpy_abi_op_CONTAINS_OP_22(&vm);
    # right = PyStackRef_NULL ;
    jacpy_abi_op_CONTAINS_OP_23(&vm);
    # stack_pointer [ - 1 ] = right ;
    jacpy_abi_op_CONTAINS_OP_24(&vm);
    # PyStackRef_CLOSE ( tmp ) ;
    jacpy_abi_op_CONTAINS_OP_25(&vm);
    # tmp = left ;
    jacpy_abi_op_CONTAINS_OP_26(&vm);
    # left = PyStackRef_NULL ;
    jacpy_abi_op_CONTAINS_OP_27(&vm);
    # stack_pointer [ - 2 ] = left ;
    jacpy_abi_op_CONTAINS_OP_28(&vm);
    # PyStackRef_CLOSE ( tmp ) ;
    jacpy_abi_op_CONTAINS_OP_29(&vm);
    # stack_pointer = _PyFrame_GetStackPointer ( frame ) ;
    jacpy_abi_op_CONTAINS_OP_30(&vm);
    # stack_pointer += - 2 ;
    jacpy_abi_op_CONTAINS_OP_31(&vm);
    # assert ( WITHIN_STACK_BOUNDS ( ) ) ;
    jacpy_abi_op_CONTAINS_OP_32(&vm);
    # res < 0
    if jacpy_abi_op_CONTAINS_OP_33(&vm) != 0 {
        return __musttail(jacpy_vm_error(storage, tstate, vm));
    }
    # b = ( res ^ oparg ) ? PyStackRef_True : PyStackRef_False ;
    jacpy_abi_op_CONTAINS_OP_34(&vm);
    # stack_pointer [ 0 ] = b ;
    jacpy_abi_op_CONTAINS_OP_35(&vm);
    # stack_pointer += 1 ;
    jacpy_abi_op_CONTAINS_OP_36(&vm);
    # assert ( WITHIN_STACK_BOUNDS ( ) ) ;
    jacpy_abi_op_CONTAINS_OP_37(&vm);
    # assert(frame->stackpointer == NULL); NEXTOPARG();
    jacpy_abi_op_CONTAINS_OP_38(&vm);
    return __musttail(jacpy_vm_dispatch(storage, tstate, vm));
}

