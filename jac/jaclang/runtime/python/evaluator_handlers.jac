    jacpy_abi_op_LIST_EXTEND_11(&vm);
    # none_val == NULL
    if jacpy_abi_op_LIST_EXTEND_12(&vm) != 0 {
        # _PyFrame_SetStackPointer ( frame , stack_pointer ) ;
        jacpy_abi_op_LIST_EXTEND_13(&vm);
        # matches = _PyErr_ExceptionMatches ( tstate , PyExc_TypeError );
        jacpy_abi_op_LIST_EXTEND_14(&vm);
        # stack_pointer = _PyFrame_GetStackPointer ( frame ) ;
        jacpy_abi_op_LIST_EXTEND_15(&vm);
        # matches && ( Py_TYPE ( iterable ) -> tp_iter == NULL && ! PySequence_Check ( iterable ) )
        if jacpy_abi_op_LIST_EXTEND_16(&vm) != 0 {
            # _PyFrame_SetStackPointer ( frame , stack_pointer ) ;
            jacpy_abi_op_LIST_EXTEND_17(&vm);
            # _PyErr_Clear ( tstate ) ;
            jacpy_abi_op_LIST_EXTEND_18(&vm);
            # _PyErr_Format ( tstate , PyExc_TypeError , "Value after * must be an iterable, not %.200s" , Py_TYPE ( iterable ) -> tp_name ) ;
            jacpy_abi_op_LIST_EXTEND_19(&vm);
            # stack_pointer = _PyFrame_GetStackPointer ( frame ) ;
            jacpy_abi_op_LIST_EXTEND_20(&vm);
        }
        # stack_pointer += - 1 ;
        jacpy_abi_op_LIST_EXTEND_21(&vm);
        # assert ( WITHIN_STACK_BOUNDS ( ) ) ;
        jacpy_abi_op_LIST_EXTEND_22(&vm);
        # _PyFrame_SetStackPointer ( frame , stack_pointer ) ;
        jacpy_abi_op_LIST_EXTEND_23(&vm);
        # PyStackRef_CLOSE ( iterable_st ) ;
        jacpy_abi_op_LIST_EXTEND_24(&vm);
        # stack_pointer = _PyFrame_GetStackPointer ( frame ) ;
        jacpy_abi_op_LIST_EXTEND_25(&vm);
        return __musttail(jacpy_vm_error(storage, tstate, vm));
    }
    # assert ( Py_IsNone ( none_val ) ) ;
    jacpy_abi_op_LIST_EXTEND_26(&vm);
    # stack_pointer += - 1 ;
    jacpy_abi_op_LIST_EXTEND_27(&vm);
    # assert ( WITHIN_STACK_BOUNDS ( ) ) ;
    jacpy_abi_op_LIST_EXTEND_28(&vm);
    # _PyFrame_SetStackPointer ( frame , stack_pointer ) ;
    jacpy_abi_op_LIST_EXTEND_29(&vm);
    # PyStackRef_CLOSE ( iterable_st ) ;
    jacpy_abi_op_LIST_EXTEND_30(&vm);
    # stack_pointer = _PyFrame_GetStackPointer ( frame ) ;
    jacpy_abi_op_LIST_EXTEND_31(&vm);
    # assert(frame->stackpointer == NULL); NEXTOPARG();
    jacpy_abi_op_LIST_EXTEND_32(&vm);
    return __musttail(jacpy_vm_dispatch(storage, tstate, vm));
}

@foreign_call(requires=["gil"], errors="python", reentrant=True)
def jacpy_vm_op_LOAD_ATTR(storage: &JacPyVMStorage, tstate: &JacPyThreadState, vm: lin PyVMRef from (storage, tstate)) -> own PyObjectRef {
    # opcode = LOAD_ATTR;
    jacpy_abi_op_LOAD_ATTR_1(&vm);
    # frame -> instr_ptr = next_instr ;
    jacpy_abi_op_LOAD_ATTR_2(&vm);
    # next_instr += 10 ;
    jacpy_abi_op_LOAD_ATTR_3(&vm);
    # INSTRUCTION_STATS ( LOAD_ATTR ) ;
    jacpy_abi_op_LOAD_ATTR_4(&vm);
    # this_instr = next_instr - 10;
    jacpy_abi_op_LOAD_ATTR_5(&vm);
    # owner = stack_pointer [ - 1 ] ;
    jacpy_abi_op_LOAD_ATTR_6(&vm);
    # counter = read_u16 ( & this_instr [ 1 ] . cache );
    jacpy_abi_op_LOAD_ATTR_7(&vm);
    if jacpy_config_op_LOAD_ATTR_8() != 0 {
        # ADAPTIVE_COUNTER_TRIGGERS ( counter )
        if jacpy_abi_op_LOAD_ATTR_9(&vm) != 0 {
            # name = GETITEM ( FRAME_CO_NAMES , oparg >> 1 );
            jacpy_abi_op_LOAD_ATTR_10(&vm);
            # next_instr = this_instr ;
            jacpy_abi_op_LOAD_ATTR_11(&vm);
            # _PyFrame_SetStackPointer ( frame , stack_pointer ) ;
            jacpy_abi_op_LOAD_ATTR_12(&vm);
            # _Py_Specialize_LoadAttr ( owner , next_instr , name ) ;
            jacpy_abi_op_LOAD_ATTR_13(&vm);
            # stack_pointer = _PyFrame_GetStackPointer ( frame ) ;
            jacpy_abi_op_LOAD_ATTR_14(&vm);
            # opcode = next_instr->op.code;
            jacpy_abi_op_LOAD_ATTR_15(&vm);
            return __musttail(jacpy_vm_dispatch(storage, tstate, vm));
        }
        # OPCODE_DEFERRED_INC ( LOAD_ATTR ) ;
        jacpy_abi_op_LOAD_ATTR_16(&vm);
        # ADVANCE_ADAPTIVE_COUNTER ( this_instr [ 1 ] . counter ) ;
        jacpy_abi_op_LOAD_ATTR_17(&vm);
    }
    # self_or_null = & stack_pointer [ 0 ] ;
    jacpy_abi_op_LOAD_ATTR_18(&vm);
    # name = GETITEM ( FRAME_CO_NAMES , oparg >> 1 );
    jacpy_abi_op_LOAD_ATTR_19(&vm);
    # oparg & 1
    if jacpy_abi_op_LOAD_ATTR_20(&vm) != 0 {
        # _PyFrame_SetStackPointer ( frame , stack_pointer ) ;
        jacpy_abi_op_LOAD_ATTR_21(&vm);
        # attr = _Py_LoadAttr_StackRefSteal ( tstate , owner , name , self_or_null ) ;
        jacpy_abi_op_LOAD_ATTR_22(&vm);
        # stack_pointer = _PyFrame_GetStackPointer ( frame ) ;
        jacpy_abi_op_LOAD_ATTR_23(&vm);
        # PyStackRef_IsNull ( attr )
        if jacpy_abi_op_LOAD_ATTR_24(&vm) != 0 {
            return __musttail(jacpy_vm_pop_1_error(storage, tstate, vm));
        }
    } else {
        # _PyFrame_SetStackPointer ( frame , stack_pointer ) ;
        jacpy_abi_op_LOAD_ATTR_25(&vm);
        # attr_o = PyObject_GetAttr ( PyStackRef_AsPyObjectBorrow ( owner ) , name );
        jacpy_abi_op_LOAD_ATTR_26(&vm);
        # stack_pointer = _PyFrame_GetStackPointer ( frame ) ;
        jacpy_abi_op_LOAD_ATTR_27(&vm);
        # stack_pointer += - 1 ;
        jacpy_abi_op_LOAD_ATTR_28(&vm);
        # assert ( WITHIN_STACK_BOUNDS ( ) ) ;
        jacpy_abi_op_LOAD_ATTR_29(&vm);
        # _PyFrame_SetStackPointer ( frame , stack_pointer ) ;
        jacpy_abi_op_LOAD_ATTR_30(&vm);
        # PyStackRef_CLOSE ( owner ) ;
        jacpy_abi_op_LOAD_ATTR_31(&vm);
        # stack_pointer = _PyFrame_GetStackPointer ( frame ) ;
        jacpy_abi_op_LOAD_ATTR_32(&vm);
        # attr_o == NULL
        if jacpy_abi_op_LOAD_ATTR_33(&vm) != 0 {
            return __musttail(jacpy_vm_error(storage, tstate, vm));
        }
        # attr = PyStackRef_FromPyObjectSteal ( attr_o ) ;
        jacpy_abi_op_LOAD_ATTR_34(&vm);
        # stack_pointer += 1 ;
        jacpy_abi_op_LOAD_ATTR_35(&vm);
    }
    # stack_pointer [ - 1 ] = attr ;
    jacpy_abi_op_LOAD_ATTR_36(&vm);
    # stack_pointer += ( oparg & 1 ) ;
    jacpy_abi_op_LOAD_ATTR_37(&vm);
    # assert ( WITHIN_STACK_BOUNDS ( ) ) ;
    jacpy_abi_op_LOAD_ATTR_38(&vm);
    # assert(frame->stackpointer == NULL); NEXTOPARG();
    jacpy_abi_op_LOAD_ATTR_39(&vm);
    return __musttail(jacpy_vm_dispatch(storage, tstate, vm));
}

