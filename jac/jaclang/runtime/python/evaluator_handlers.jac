            jacpy_abi_uop__EXIT_TRACE_29(&vm);
            # _PyFrame_SetStackPointer ( frame , stack_pointer ) ;
            jacpy_abi_uop__EXIT_TRACE_30(&vm);
            # optimized = _PyOptimizer_Optimize ( frame , target , & executor , chain_depth );
            jacpy_abi_uop__EXIT_TRACE_31(&vm);
            # stack_pointer = _PyFrame_GetStackPointer ( frame ) ;
            jacpy_abi_uop__EXIT_TRACE_32(&vm);
            # optimized <= 0
            if jacpy_abi_uop__EXIT_TRACE_33(&vm) != 0 {
                # exit -> temperature = restart_backoff_counter ( temperature ) ;
                jacpy_abi_uop__EXIT_TRACE_34(&vm);
                # tstate->current_executor = NULL; next_instr = (optimized < 0 ? NULL : target); OPT_HIST(trace_uop_execution_counter, trace_run_length_hist); _PyFrame_SetStackPointer(frame, stack_pointer); stack_pointer = _PyFrame_GetStackPointer(frame);
                jacpy_abi_uop__EXIT_TRACE_35(&vm);
                # next_instr == NULL
                if jacpy_abi_uop__EXIT_TRACE_36(&vm) != 0 {
                    # next_instr = frame->instr_ptr + 1;
                    jacpy_abi_uop__EXIT_TRACE_37(&vm);
                    return __musttail(jacpy_vm_error(storage, tstate, vm));
                }
                # assert(frame->stackpointer == NULL); NEXTOPARG();
                jacpy_abi_uop__EXIT_TRACE_38(&vm);
                return __musttail(jacpy_vm_dispatch(storage, tstate, vm));
            }
            # exit -> temperature = initial_temperature_backoff_counter ( ) ;
            jacpy_abi_uop__EXIT_TRACE_39(&vm);
        }
        # exit -> executor = executor ;
        jacpy_abi_uop__EXIT_TRACE_40(&vm);
    }
    # OPT_STAT_INC(traces_executed); tstate->current_executor = (PyObject *)(exit -> executor);
    jacpy_abi_uop__EXIT_TRACE_41(&vm);
    if jacpy_config_uop__EXIT_TRACE_42() != 0 {
