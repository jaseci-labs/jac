        jacpy_abi_op_CALL_BUILTIN_O_56(&vm);
        # err != 0
        if jacpy_abi_op_CALL_BUILTIN_O_57(&vm) != 0 {
            return __musttail(jacpy_vm_error(storage, tstate, vm));
        }
        # stack_pointer += - 1 ;
        jacpy_abi_op_CALL_BUILTIN_O_58(&vm);
    }
    # stack_pointer [ 0 ] = res ;
    jacpy_abi_op_CALL_BUILTIN_O_59(&vm);
    # stack_pointer += 1 ;
    jacpy_abi_op_CALL_BUILTIN_O_60(&vm);
    # assert ( WITHIN_STACK_BOUNDS ( ) ) ;
    jacpy_abi_op_CALL_BUILTIN_O_61(&vm);
    # assert(frame->stackpointer == NULL); NEXTOPARG();
    jacpy_abi_op_CALL_BUILTIN_O_62(&vm);
    return __musttail(jacpy_vm_dispatch(storage, tstate, vm));
}

