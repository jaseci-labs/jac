@foreign_call(requires=["gil"], errors="python", reentrant=True)
def jacpy_vm_op_CALL_KW_PY(storage: &JacPyVMStorage, tstate: &JacPyThreadState, vm: lin PyVMRef from (storage, tstate)) -> own PyObjectRef {
    # opcode = CALL_KW_PY;
    jacpy_abi_op_CALL_KW_PY_1(&vm);
    # this_instr = next_instr;
    jacpy_abi_op_CALL_KW_PY_2(&vm);
    # frame -> instr_ptr = next_instr ;
    jacpy_abi_op_CALL_KW_PY_3(&vm);
    # next_instr += 4 ;
