    # new_frame = temp ;
    jacpy_abi_op_CALL_KW_PY_51(&vm);
    # frame -> return_offset = ( uint16_t ) ( next_instr - this_instr ) ;
    jacpy_abi_op_CALL_KW_PY_52(&vm);
