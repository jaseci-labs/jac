@foreign_call(requires=["gil"], errors="python", reentrant=True)
def jacpy_vm_op_BINARY_OP(storage: &JacPyVMStorage, tstate: &JacPyThreadState, vm: lin PyVMRef from (storage, tstate)) -> own PyObjectRef {
    # opcode = BINARY_OP;
    jacpy_abi_op_BINARY_OP_1(&vm);
    # frame -> instr_ptr = next_instr ;
    jacpy_abi_op_BINARY_OP_2(&vm);
    # next_instr += 6 ;
    jacpy_abi_op_BINARY_OP_3(&vm);
    # INSTRUCTION_STATS ( BINARY_OP ) ;
    jacpy_abi_op_BINARY_OP_4(&vm);
    # this_instr = next_instr - 6;
    jacpy_abi_op_BINARY_OP_5(&vm);
    # rhs = stack_pointer [ - 1 ] ;
    jacpy_abi_op_BINARY_OP_6(&vm);
    # lhs = stack_pointer [ - 2 ] ;
    jacpy_abi_op_BINARY_OP_7(&vm);
    # counter = read_u16 ( & this_instr [ 1 ] . cache );
    jacpy_abi_op_BINARY_OP_8(&vm);
    if jacpy_config_op_BINARY_OP_9() != 0 {
        # ADAPTIVE_COUNTER_TRIGGERS ( counter )
        if jacpy_abi_op_BINARY_OP_10(&vm) != 0 {
            # next_instr = this_instr ;
            jacpy_abi_op_BINARY_OP_11(&vm);
            # _PyFrame_SetStackPointer ( frame , stack_pointer ) ;
            jacpy_abi_op_BINARY_OP_12(&vm);
            # _Py_Specialize_BinaryOp ( lhs , rhs , next_instr , oparg , LOCALS_ARRAY ) ;
            jacpy_abi_op_BINARY_OP_13(&vm);
            # stack_pointer = _PyFrame_GetStackPointer ( frame ) ;
            jacpy_abi_op_BINARY_OP_14(&vm);
            # opcode = next_instr->op.code;
            jacpy_abi_op_BINARY_OP_15(&vm);
            return __musttail(jacpy_vm_dispatch(storage, tstate, vm));
        }
        # OPCODE_DEFERRED_INC ( BINARY_OP ) ;
        jacpy_abi_op_BINARY_OP_16(&vm);
        # ADVANCE_ADAPTIVE_COUNTER ( this_instr [ 1 ] . counter ) ;
        jacpy_abi_op_BINARY_OP_17(&vm);
    }
    # assert ( NB_ADD <= oparg ) ;
    jacpy_abi_op_BINARY_OP_18(&vm);
    # assert ( oparg <= NB_OPARG_LAST ) ;
    jacpy_abi_op_BINARY_OP_19(&vm);
    # lhs_o = PyStackRef_AsPyObjectBorrow ( lhs );
    jacpy_abi_op_BINARY_OP_20(&vm);
    # rhs_o = PyStackRef_AsPyObjectBorrow ( rhs );
    jacpy_abi_op_BINARY_OP_21(&vm);
    # assert ( _PyEval_BinaryOps [ oparg ] ) ;
    jacpy_abi_op_BINARY_OP_22(&vm);
    # _PyFrame_SetStackPointer ( frame , stack_pointer ) ;
    jacpy_abi_op_BINARY_OP_23(&vm);
    # res_o = _PyEval_BinaryOps [ oparg ] ( lhs_o , rhs_o );
    jacpy_abi_op_BINARY_OP_24(&vm);
    # stack_pointer = _PyFrame_GetStackPointer ( frame ) ;
    jacpy_abi_op_BINARY_OP_25(&vm);
    # res_o == NULL
    if jacpy_abi_op_BINARY_OP_26(&vm) != 0 {
        return __musttail(jacpy_vm_error(storage, tstate, vm));
    }
    # res = PyStackRef_FromPyObjectSteal ( res_o ) ;
    jacpy_abi_op_BINARY_OP_27(&vm);
    # _PyFrame_SetStackPointer ( frame , stack_pointer ) ;
    jacpy_abi_op_BINARY_OP_28(&vm);
    # tmp = lhs;
    jacpy_abi_op_BINARY_OP_29(&vm);
    # lhs = res ;
    jacpy_abi_op_BINARY_OP_30(&vm);
    # stack_pointer [ - 2 ] = lhs ;
    jacpy_abi_op_BINARY_OP_31(&vm);
    # PyStackRef_CLOSE ( tmp ) ;
    jacpy_abi_op_BINARY_OP_32(&vm);
    # tmp = rhs ;
    jacpy_abi_op_BINARY_OP_33(&vm);
    # rhs = PyStackRef_NULL ;
    jacpy_abi_op_BINARY_OP_34(&vm);
    # stack_pointer [ - 1 ] = rhs ;
    jacpy_abi_op_BINARY_OP_35(&vm);
    # PyStackRef_CLOSE ( tmp ) ;
    jacpy_abi_op_BINARY_OP_36(&vm);
    # stack_pointer = _PyFrame_GetStackPointer ( frame ) ;
    jacpy_abi_op_BINARY_OP_37(&vm);
    # stack_pointer += - 1 ;
    jacpy_abi_op_BINARY_OP_38(&vm);
    # assert ( WITHIN_STACK_BOUNDS ( ) ) ;
    jacpy_abi_op_BINARY_OP_39(&vm);
    # assert(frame->stackpointer == NULL); NEXTOPARG();
    jacpy_abi_op_BINARY_OP_40(&vm);
    return __musttail(jacpy_vm_dispatch(storage, tstate, vm));
}

@foreign_call(requires=["gil"], errors="python", reentrant=True)
def jacpy_vm_op_BINARY_OP_ADD_FLOAT(storage: &JacPyVMStorage, tstate: &JacPyThreadState, vm: lin PyVMRef from (storage, tstate)) -> own PyObjectRef {
    # opcode = BINARY_OP_ADD_FLOAT;
    jacpy_abi_op_BINARY_OP_ADD_FLOAT_1(&vm);
    # this_instr = next_instr;
    jacpy_abi_op_BINARY_OP_ADD_FLOAT_2(&vm);
    # frame -> instr_ptr = next_instr ;
    jacpy_abi_op_BINARY_OP_ADD_FLOAT_3(&vm);
    # next_instr += 6 ;
    jacpy_abi_op_BINARY_OP_ADD_FLOAT_4(&vm);
    # INSTRUCTION_STATS ( BINARY_OP_ADD_FLOAT ) ;
    jacpy_abi_op_BINARY_OP_ADD_FLOAT_5(&vm);
    # value = stack_pointer [ - 1 ] ;
    jacpy_abi_op_BINARY_OP_ADD_FLOAT_6(&vm);
    # value_o = PyStackRef_AsPyObjectBorrow ( value );
    jacpy_abi_op_BINARY_OP_ADD_FLOAT_7(&vm);
    # ! PyFloat_CheckExact ( value_o )
    if jacpy_abi_op_BINARY_OP_ADD_FLOAT_8(&vm) != 0 {
        # UPDATE_MISS_STATS ( BINARY_OP ) ;
        jacpy_abi_op_BINARY_OP_ADD_FLOAT_9(&vm);
        # assert ( _PyOpcode_Deopt [ opcode ] == ( BINARY_OP ) ) ;
        jacpy_abi_op_BINARY_OP_ADD_FLOAT_10(&vm);
        # next_instr = this_instr;
        jacpy_abi_op_BINARY_OP_ADD_FLOAT_11(&vm);
        return __musttail(jacpy_vm_op_BINARY_OP(storage, tstate, vm));
    }
    # left = stack_pointer [ - 2 ] ;
    jacpy_abi_op_BINARY_OP_ADD_FLOAT_12(&vm);
    # left_o = PyStackRef_AsPyObjectBorrow ( left );
    jacpy_abi_op_BINARY_OP_ADD_FLOAT_13(&vm);
    # ! PyFloat_CheckExact ( left_o )
    if jacpy_abi_op_BINARY_OP_ADD_FLOAT_14(&vm) != 0 {
        # UPDATE_MISS_STATS ( BINARY_OP ) ;
        jacpy_abi_op_BINARY_OP_ADD_FLOAT_15(&vm);
        # assert ( _PyOpcode_Deopt [ opcode ] == ( BINARY_OP ) ) ;
        jacpy_abi_op_BINARY_OP_ADD_FLOAT_16(&vm);
        # next_instr = this_instr;
        jacpy_abi_op_BINARY_OP_ADD_FLOAT_17(&vm);
        return __musttail(jacpy_vm_op_BINARY_OP(storage, tstate, vm));
    }
    # right = value ;
    jacpy_abi_op_BINARY_OP_ADD_FLOAT_18(&vm);
    # left_o = PyStackRef_AsPyObjectBorrow ( left );
    jacpy_abi_op_BINARY_OP_ADD_FLOAT_19(&vm);
    # right_o = PyStackRef_AsPyObjectBorrow ( right );
    jacpy_abi_op_BINARY_OP_ADD_FLOAT_20(&vm);
    # assert ( PyFloat_CheckExact ( left_o ) ) ;
    jacpy_abi_op_BINARY_OP_ADD_FLOAT_21(&vm);
    # assert ( PyFloat_CheckExact ( right_o ) ) ;
    jacpy_abi_op_BINARY_OP_ADD_FLOAT_22(&vm);
    # STAT_INC ( BINARY_OP , hit ) ;
    jacpy_abi_op_BINARY_OP_ADD_FLOAT_23(&vm);
    # dres = ( ( PyFloatObject * ) left_o ) -> ob_fval + ( ( PyFloatObject * ) right_o ) -> ob_fval;
    jacpy_abi_op_BINARY_OP_ADD_FLOAT_24(&vm);
    # res = _PyFloat_FromDouble_ConsumeInputs ( left , right , dres ) ;
    jacpy_abi_op_BINARY_OP_ADD_FLOAT_25(&vm);
    # PyStackRef_IsNull ( res )
    if jacpy_abi_op_BINARY_OP_ADD_FLOAT_26(&vm) != 0 {
        return __musttail(jacpy_vm_pop_2_error(storage, tstate, vm));
    }
    # stack_pointer [ - 2 ] = res ;
    jacpy_abi_op_BINARY_OP_ADD_FLOAT_27(&vm);
    # stack_pointer += - 1 ;
    jacpy_abi_op_BINARY_OP_ADD_FLOAT_28(&vm);
    # assert ( WITHIN_STACK_BOUNDS ( ) ) ;
    jacpy_abi_op_BINARY_OP_ADD_FLOAT_29(&vm);
    # assert(frame->stackpointer == NULL); NEXTOPARG();
    jacpy_abi_op_BINARY_OP_ADD_FLOAT_30(&vm);
    return __musttail(jacpy_vm_dispatch(storage, tstate, vm));
}

