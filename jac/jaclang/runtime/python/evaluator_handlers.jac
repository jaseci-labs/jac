    jacpy_abi_op_CALL_KW_PY_56(&vm);
    # CALL_STAT_INC ( inlined_py_calls ) ;
    jacpy_abi_op_CALL_KW_PY_57(&vm);
    # frame = tstate -> current_frame = temp ;
    jacpy_abi_op_CALL_KW_PY_58(&vm);
    # tstate -> py_recursion_remaining -- ;
    jacpy_abi_op_CALL_KW_PY_59(&vm);
