import from c {
    @foreign_call(requires=["gil"], errors="none", reentrant=False)
    def jacpy_abi_dispatch_1(vm: &PyVMRef) -> i32;
    @foreign_call(requires=["gil"], errors="python", reentrant=True)
    def jacpy_abi_dispatch_2(vm: &PyVMRef);
}

@foreign_call(requires=["gil"], errors="python", reentrant=True)
def jacpy_vm_dispatch(storage: &JacPyVMStorage, tstate: &JacPyThreadState, vm: lin PyVMRef from (storage, tstate)) -> own PyObjectRef {
    # opcode
    instruction = jacpy_abi_dispatch_1(&vm);
    match instruction {
        case 44:
            return __musttail(jacpy_vm_op_BINARY_OP(storage, tstate, vm));
        case 129:
            return __musttail(jacpy_vm_op_BINARY_OP_ADD_FLOAT(storage, tstate, vm));
        case 130:
            return __musttail(jacpy_vm_op_BINARY_OP_ADD_INT(storage, tstate, vm));
        case 131:
            return __musttail(jacpy_vm_op_BINARY_OP_ADD_UNICODE(storage, tstate, vm));
        case 132:
            return __musttail(jacpy_vm_op_BINARY_OP_EXTEND(storage, tstate, vm));
        case 3:
            return __musttail(jacpy_vm_op_BINARY_OP_INPLACE_ADD_UNICODE(storage, tstate, vm));
        case 133:
            return __musttail(jacpy_vm_op_BINARY_OP_MULTIPLY_FLOAT(storage, tstate, vm));
        case 134:
            return __musttail(jacpy_vm_op_BINARY_OP_MULTIPLY_INT(storage, tstate, vm));
        case 135:
            return __musttail(jacpy_vm_op_BINARY_OP_SUBSCR_DICT(storage, tstate, vm));
        case 136:
            return __musttail(jacpy_vm_op_BINARY_OP_SUBSCR_GETITEM(storage, tstate, vm));
        case 137:
            return __musttail(jacpy_vm_op_BINARY_OP_SUBSCR_LIST_INT(storage, tstate, vm));
        case 138:
            return __musttail(jacpy_vm_op_BINARY_OP_SUBSCR_LIST_SLICE(storage, tstate, vm));
        case 139:
            return __musttail(jacpy_vm_op_BINARY_OP_SUBSCR_STR_INT(storage, tstate, vm));
        case 140:
            return __musttail(jacpy_vm_op_BINARY_OP_SUBSCR_TUPLE_INT(storage, tstate, vm));
        case 141:
            return __musttail(jacpy_vm_op_BINARY_OP_SUBTRACT_FLOAT(storage, tstate, vm));
        case 142:
            return __musttail(jacpy_vm_op_BINARY_OP_SUBTRACT_INT(storage, tstate, vm));
        case 1:
            return __musttail(jacpy_vm_op_BINARY_SLICE(storage, tstate, vm));
        case 45:
            return __musttail(jacpy_vm_op_BUILD_INTERPOLATION(storage, tstate, vm));
        case 46:
            return __musttail(jacpy_vm_op_BUILD_LIST(storage, tstate, vm));
        case 47:
            return __musttail(jacpy_vm_op_BUILD_MAP(storage, tstate, vm));
        case 48:
            return __musttail(jacpy_vm_op_BUILD_SET(storage, tstate, vm));
        case 49:
            return __musttail(jacpy_vm_op_BUILD_SLICE(storage, tstate, vm));
        case 50:
            return __musttail(jacpy_vm_op_BUILD_STRING(storage, tstate, vm));
        case 2:
            return __musttail(jacpy_vm_op_BUILD_TEMPLATE(storage, tstate, vm));
        case 51:
            return __musttail(jacpy_vm_op_BUILD_TUPLE(storage, tstate, vm));
        case 0:
            return __musttail(jacpy_vm_op_CACHE(storage, tstate, vm));
        case 52:
            return __musttail(jacpy_vm_op_CALL(storage, tstate, vm));
        case 143:
            return __musttail(jacpy_vm_op_CALL_ALLOC_AND_ENTER_INIT(storage, tstate, vm));
        case 144:
            return __musttail(jacpy_vm_op_CALL_BOUND_METHOD_EXACT_ARGS(storage, tstate, vm));
        case 145:
            return __musttail(jacpy_vm_op_CALL_BOUND_METHOD_GENERAL(storage, tstate, vm));
        case 146:
            return __musttail(jacpy_vm_op_CALL_BUILTIN_CLASS(storage, tstate, vm));
        case 147:
            return __musttail(jacpy_vm_op_CALL_BUILTIN_FAST(storage, tstate, vm));
        case 148:
            return __musttail(jacpy_vm_op_CALL_BUILTIN_FAST_WITH_KEYWORDS(storage, tstate, vm));
        case 149:
            return __musttail(jacpy_vm_op_CALL_BUILTIN_O(storage, tstate, vm));
        case 4:
            return __musttail(jacpy_vm_op_CALL_FUNCTION_EX(storage, tstate, vm));
        case 53:
            return __musttail(jacpy_vm_op_CALL_INTRINSIC_1(storage, tstate, vm));
        case 54:
            return __musttail(jacpy_vm_op_CALL_INTRINSIC_2(storage, tstate, vm));
        case 150:
            return __musttail(jacpy_vm_op_CALL_ISINSTANCE(storage, tstate, vm));
        case 55:
            return __musttail(jacpy_vm_op_CALL_KW(storage, tstate, vm));
        case 151:
            return __musttail(jacpy_vm_op_CALL_KW_BOUND_METHOD(storage, tstate, vm));
        case 152:
            return __musttail(jacpy_vm_op_CALL_KW_NON_PY(storage, tstate, vm));
        case 153:
            return __musttail(jacpy_vm_op_CALL_KW_PY(storage, tstate, vm));
        case 154:
            return __musttail(jacpy_vm_op_CALL_LEN(storage, tstate, vm));
        case 155:
            return __musttail(jacpy_vm_op_CALL_LIST_APPEND(storage, tstate, vm));
        case 156:
            return __musttail(jacpy_vm_op_CALL_METHOD_DESCRIPTOR_FAST(storage, tstate, vm));
        case 157:
            return __musttail(jacpy_vm_op_CALL_METHOD_DESCRIPTOR_FAST_WITH_KEYWORDS(storage, tstate, vm));
        case 158:
            return __musttail(jacpy_vm_op_CALL_METHOD_DESCRIPTOR_NOARGS(storage, tstate, vm));
        case 159:
            return __musttail(jacpy_vm_op_CALL_METHOD_DESCRIPTOR_O(storage, tstate, vm));
        case 160:
            return __musttail(jacpy_vm_op_CALL_NON_PY_GENERAL(storage, tstate, vm));
        case 161:
