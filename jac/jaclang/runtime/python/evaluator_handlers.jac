            # _PyFrame_SetStackPointer ( frame , stack_pointer ) ;
            jacpy_abi_uop__EXIT_TRACE_8(&vm);
            # printf ( "SIDE EXIT: [UOp " ) ;
            jacpy_abi_uop__EXIT_TRACE_9(&vm);
            # _PyUOpPrint ( & next_uop [ - 1 ] ) ;
            jacpy_abi_uop__EXIT_TRACE_10(&vm);
            # printf ( ", exit %lu, temp %d, target %d -> %s]\n" , exit - current_executor -> exits , exit -> temperature . value_and_backoff , ( int ) ( target - _PyFrame_GetBytecode ( frame ) ) , _PyOpcode_OpName [ target -> op . code ] ) ;
            jacpy_abi_uop__EXIT_TRACE_11(&vm);
            # stack_pointer = _PyFrame_GetStackPointer ( frame ) ;
            jacpy_abi_uop__EXIT_TRACE_12(&vm);
        }
    }
    # exit -> executor && ! exit -> executor -> vm_data . valid
    if jacpy_abi_uop__EXIT_TRACE_13(&vm) != 0 {
        # exit -> temperature = initial_temperature_backoff_counter ( ) ;
        jacpy_abi_uop__EXIT_TRACE_14(&vm);
        # _PyFrame_SetStackPointer ( frame , stack_pointer ) ;
        jacpy_abi_uop__EXIT_TRACE_15(&vm);
        # Py_CLEAR ( exit -> executor ) ;
        jacpy_abi_uop__EXIT_TRACE_16(&vm);
        # stack_pointer = _PyFrame_GetStackPointer ( frame ) ;
        jacpy_abi_uop__EXIT_TRACE_17(&vm);
    }
    # exit -> executor == NULL
    if jacpy_abi_uop__EXIT_TRACE_18(&vm) != 0 {
        # temperature = exit -> temperature;
        jacpy_abi_uop__EXIT_TRACE_19(&vm);
        # ! backoff_counter_triggers ( temperature )
        if jacpy_abi_uop__EXIT_TRACE_20(&vm) != 0 {
            # exit -> temperature = advance_backoff_counter ( temperature ) ;
            jacpy_abi_uop__EXIT_TRACE_21(&vm);
            # tstate->current_executor = NULL; next_instr = (target); OPT_HIST(trace_uop_execution_counter, trace_run_length_hist); _PyFrame_SetStackPointer(frame, stack_pointer); stack_pointer = _PyFrame_GetStackPointer(frame);
            jacpy_abi_uop__EXIT_TRACE_22(&vm);
            # next_instr == NULL
            if jacpy_abi_uop__EXIT_TRACE_23(&vm) != 0 {
                # next_instr = frame->instr_ptr + 1;
                jacpy_abi_uop__EXIT_TRACE_24(&vm);
                return __musttail(jacpy_vm_error(storage, tstate, vm));
            }
            # assert(frame->stackpointer == NULL); NEXTOPARG();
            jacpy_abi_uop__EXIT_TRACE_25(&vm);
            return __musttail(jacpy_vm_dispatch(storage, tstate, vm));
        }
        # target -> op . code == ENTER_EXECUTOR
        if jacpy_abi_uop__EXIT_TRACE_26(&vm) != 0 {
            # executor = code -> co_executors -> executors [ target -> op . arg ] ;
            jacpy_abi_uop__EXIT_TRACE_27(&vm);
            # Py_INCREF ( executor ) ;
            jacpy_abi_uop__EXIT_TRACE_28(&vm);
        } else {
