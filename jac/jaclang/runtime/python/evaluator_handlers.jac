    jacpy_abi_op_CALL_KW_PY_53(&vm);
    # temp = new_frame;
    jacpy_abi_op_CALL_KW_PY_54(&vm);
    # _PyFrame_SetStackPointer ( frame , stack_pointer ) ;
    jacpy_abi_op_CALL_KW_PY_55(&vm);
