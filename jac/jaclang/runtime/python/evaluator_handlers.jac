    # INSTRUCTION_STATS ( CALL_KW_PY ) ;
    jacpy_abi_op_CALL_KW_PY_5(&vm);
    # tstate -> interp -> eval_frame
    if jacpy_abi_op_CALL_KW_PY_6(&vm) != 0 {
        # UPDATE_MISS_STATS ( CALL_KW ) ;
        jacpy_abi_op_CALL_KW_PY_7(&vm);
        # assert ( _PyOpcode_Deopt [ opcode ] == ( CALL_KW ) ) ;
        jacpy_abi_op_CALL_KW_PY_8(&vm);
        # next_instr = this_instr;
        jacpy_abi_op_CALL_KW_PY_9(&vm);
        return __musttail(jacpy_vm_op_CALL_KW(storage, tstate, vm));
