@foreign_call(requires=["gil"], errors="python", reentrant=True)
def jacpy_vm_jit__EXIT_TRACE(storage: &JacPyVMStorage, tstate: &JacPyThreadState, vm: lin PyJITStepRef from (storage, tstate)) -> i32 {
    # exit_p = ( PyObject * ) CURRENT_OPERAND0 ( );
    jacpy_abi_jit__EXIT_TRACE_1(&vm);
    # exit = ( _PyExitData * ) exit_p;
    jacpy_abi_jit__EXIT_TRACE_2(&vm);
    # code = _PyFrame_GetCode ( frame );
    jacpy_abi_jit__EXIT_TRACE_3(&vm);
    # target = _PyFrame_GetBytecode ( frame ) + exit -> target;
    jacpy_abi_jit__EXIT_TRACE_4(&vm);
    if jacpy_config_jit__EXIT_TRACE_5() != 0 {
        # OPT_HIST ( trace_uop_execution_counter , trace_run_length_hist ) ;
        jacpy_abi_jit__EXIT_TRACE_6(&vm);
        # frame -> lltrace >= 2
        if jacpy_abi_jit__EXIT_TRACE_7(&vm) != 0 {
            # _PyFrame_SetStackPointer ( frame , stack_pointer ) ;
            jacpy_abi_jit__EXIT_TRACE_8(&vm);
            # printf ( "SIDE EXIT: [UOp " ) ;
            jacpy_abi_jit__EXIT_TRACE_9(&vm);
            # _PyUOpPrint ( & next_uop [ - 1 ] ) ;
            jacpy_abi_jit__EXIT_TRACE_10(&vm);
            # printf ( ", exit %lu, temp %d, target %d -> %s]\n" , exit - current_executor -> exits , exit -> temperature . value_and_backoff , ( int ) ( target - _PyFrame_GetBytecode ( frame ) ) , _PyOpcode_OpName [ target -> op . code ] ) ;
            jacpy_abi_jit__EXIT_TRACE_11(&vm);
            # stack_pointer = _PyFrame_GetStackPointer ( frame ) ;
            jacpy_abi_jit__EXIT_TRACE_12(&vm);
        }
    }
    # exit -> executor && ! exit -> executor -> vm_data . valid
    if jacpy_abi_jit__EXIT_TRACE_13(&vm) != 0 {
        # exit -> temperature = initial_temperature_backoff_counter ( ) ;
        jacpy_abi_jit__EXIT_TRACE_14(&vm);
        # _PyFrame_SetStackPointer ( frame , stack_pointer ) ;
        jacpy_abi_jit__EXIT_TRACE_15(&vm);
        # Py_CLEAR ( exit -> executor ) ;
        jacpy_abi_jit__EXIT_TRACE_16(&vm);
        # stack_pointer = _PyFrame_GetStackPointer ( frame ) ;
        jacpy_abi_jit__EXIT_TRACE_17(&vm);
    }
    # exit -> executor == NULL
    if jacpy_abi_jit__EXIT_TRACE_18(&vm) != 0 {
        # temperature = exit -> temperature;
        jacpy_abi_jit__EXIT_TRACE_19(&vm);
        # ! backoff_counter_triggers ( temperature )
        if jacpy_abi_jit__EXIT_TRACE_20(&vm) != 0 {
            # exit -> temperature = advance_backoff_counter ( temperature ) ;
            jacpy_abi_jit__EXIT_TRACE_21(&vm);
            # tstate->current_executor = NULL; _PyFrame_SetStackPointer(frame, stack_pointer); next_instr = (target);
            jacpy_abi_jit__EXIT_TRACE_22(&vm);
            # Publish tier-one return and release the one-step permission.
            return jacpy_abi_jit__EXIT_TRACE_23(storage, tstate, vm);
        }
        # target -> op . code == ENTER_EXECUTOR
        if jacpy_abi_jit__EXIT_TRACE_24(&vm) != 0 {
            # executor = code -> co_executors -> executors [ target -> op . arg ] ;
            jacpy_abi_jit__EXIT_TRACE_25(&vm);
            # Py_INCREF ( executor ) ;
            jacpy_abi_jit__EXIT_TRACE_26(&vm);
        } else {
            # chain_depth = current_executor -> vm_data . chain_depth + 1;
            jacpy_abi_jit__EXIT_TRACE_27(&vm);
            # _PyFrame_SetStackPointer ( frame , stack_pointer ) ;
            jacpy_abi_jit__EXIT_TRACE_28(&vm);
            # optimized = _PyOptimizer_Optimize ( frame , target , & executor , chain_depth );
            jacpy_abi_jit__EXIT_TRACE_29(&vm);
            # stack_pointer = _PyFrame_GetStackPointer ( frame ) ;
            jacpy_abi_jit__EXIT_TRACE_30(&vm);
            # optimized <= 0
            if jacpy_abi_jit__EXIT_TRACE_31(&vm) != 0 {
                # exit -> temperature = restart_backoff_counter ( temperature ) ;
                jacpy_abi_jit__EXIT_TRACE_32(&vm);
                # tstate->current_executor = NULL; _PyFrame_SetStackPointer(frame, stack_pointer); next_instr = (optimized < 0 ? NULL : target);
                jacpy_abi_jit__EXIT_TRACE_33(&vm);
                # Publish tier-one return and release the one-step permission.
                return jacpy_abi_jit__EXIT_TRACE_34(storage, tstate, vm);
            }
            # exit -> temperature = initial_temperature_backoff_counter ( ) ;
            jacpy_abi_jit__EXIT_TRACE_35(&vm);
        }
        # exit -> executor = executor ;
        jacpy_abi_jit__EXIT_TRACE_36(&vm);
    }
    # OPT_STAT_INC(traces_executed); current_executor = (exit -> executor); tstate->current_executor = (PyObject *)current_executor;
    jacpy_abi_jit__EXIT_TRACE_37(&vm);
    # Publish executor chain and release the one-step permission.
    return jacpy_abi_jit__EXIT_TRACE_38(storage, tstate, vm);
}

