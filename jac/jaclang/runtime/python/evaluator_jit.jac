def jacpy_vm_jit__NOP(storage: &JacPyVMStorage, tstate: &JacPyThreadState, vm: lin PyJITStepRef from (storage, tstate)) -> i32 {
    # Publish continue and release the one-step permission.
    return jacpy_abi_jit__NOP_1(storage, tstate, vm);
}

@foreign_call(requires=["gil"], errors="python", reentrant=True)
def jacpy_vm_jit__CHECK_PERIODIC(storage: &JacPyVMStorage, tstate: &JacPyThreadState, vm: lin PyJITStepRef from (storage, tstate)) -> i32 {
    # _Py_CHECK_EMSCRIPTEN_SIGNALS_PERIODICALLY ( ) ;
    jacpy_abi_jit__CHECK_PERIODIC_1(&vm);
    # QSBR_QUIESCENT_STATE ( tstate ) ;
    jacpy_abi_jit__CHECK_PERIODIC_2(&vm);
    # _Py_atomic_load_uintptr_relaxed ( & tstate -> eval_breaker ) & _PY_EVAL_EVENTS_MASK
    if jacpy_abi_jit__CHECK_PERIODIC_3(&vm) != 0 {
        # _PyFrame_SetStackPointer ( frame , stack_pointer ) ;
        jacpy_abi_jit__CHECK_PERIODIC_4(&vm);
        # err = _Py_HandlePending ( tstate );
        jacpy_abi_jit__CHECK_PERIODIC_5(&vm);
        # stack_pointer = _PyFrame_GetStackPointer ( frame ) ;
        jacpy_abi_jit__CHECK_PERIODIC_6(&vm);
        # err != 0
        if jacpy_abi_jit__CHECK_PERIODIC_7(&vm) != 0 {
            # Publish error and release the one-step permission.
            return jacpy_abi_jit__CHECK_PERIODIC_8(storage, tstate, vm);
        }
    }
    # Publish continue and release the one-step permission.
    return jacpy_abi_jit__CHECK_PERIODIC_9(storage, tstate, vm);
}

