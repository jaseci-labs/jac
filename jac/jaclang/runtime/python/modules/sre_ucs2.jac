"""The _sre matcher for 2-byte characters (u16).

Generated by scripts/jacpython/gen_sre.jac from scripts/jacpython/sre_lib.jac.in;
do not edit. Modules/_sre/sre_lib.h in native Jac, which sre.c includes once
per character width: SRE(at), SRE(count), SRE(match) and SRE(search).

SRE(match) keeps its backtracking stack of match contexts on the state's data
stack, as the C does, and is one loop over the C's labels, like the C's
computed goto: DO_JUMP pushes a context and enters it for the sub-pattern,
and the exit of a context pops it and resumes its parent at the label its
jump value names. The template writes the C's control macros (DISPATCH,
RETURN_FAILURE, RETURN_SUCCESS, RETURN_ERROR, DO_JUMP, DO_JUMP0,
EXIT_CONTEXT) and GOTO,
and names the loop's steps S_*; gen_sre.jac expands them. See
../LICENSE.cpython.
"""

import from jaclang.runtime.python.cpython_api { PyErr_CheckSignals, PyMem_Malloc }
import from jaclang.runtime.python.modules.sre_engine {
    JUMP_ASSERT,
    JUMP_ASSERT_NOT,
    JUMP_ATOMIC_GROUP,
    JUMP_BRANCH,
    JUMP_MAX_UNTIL_1,
    JUMP_MAX_UNTIL_2,
    JUMP_MAX_UNTIL_3,
    JUMP_MIN_REPEAT_ONE,
    JUMP_MIN_UNTIL_1,
    JUMP_MIN_UNTIL_2,
    JUMP_MIN_UNTIL_3,
    JUMP_NONE,
    JUMP_POSS_REPEAT_1,
    JUMP_POSS_REPEAT_2,
    JUMP_REPEAT,
    JUMP_REPEAT_ONE_1,
    JUMP_REPEAT_ONE_2,
    SRE_CONTEXT_SIZE,
    SRE_ERROR_ILLEGAL,
    SRE_ERROR_INTERRUPTED,
    SRE_ERROR_MEMORY,
    SRE_ERROR_STATE,
    SRE_MAXREPEAT,
    SRE_REPEAT_LAST_PTR,
    SRE_REPEAT_SIZE,
    SreContext,
    SreRepeat,
    SreState,
    char_loc_ignore,
    data_stack_grow,
    sre_is_digit,
    sre_is_linebreak,
    sre_is_space,
    sre_is_word,
    sre_loc_is_word,
    sre_lower_ascii,
    sre_lower_locale,
    sre_lower_unicode,
    sre_uni_is_digit,
    sre_uni_is_linebreak,
    sre_uni_is_space,
    sre_uni_is_word,
    sre_upper_locale,
    sre_upper_unicode
}
import from jaclang.runtime.python.modules.sre_constants {
    SRE_AT_BEGINNING,
    SRE_AT_BEGINNING_STRING,
    SRE_INFO_CHARSET,
    SRE_INFO_LITERAL,
    SRE_INFO_PREFIX,
    SRE_OP_AT,
    SRE_OP_IN,
    SRE_OP_INFO,
    SRE_OP_LITERAL,
    SRE_OP_SUCCESS
}

import from c {
    def memcpy(target: ptr, source: ptr, size: u64) -> ptr;  def memchr(
        source: ptr, value: i32, size: u64
    ) -> ptr;
}

# The largest code a character of this width holds, and its size in bytes.
glob SRE_CHAR_LIMIT: Final[u32] = 0xFFFF,
     SRE_CHAR_SIZE: Final[int] = 2;

# pattern[k]
def:priv arg(pattern: ptr[u32], k: int) -> u32 {
    return (pattern + k).view(1)[0];
}

# *ptr as a code
def:priv char_at(position: ptr[u16]) -> u32 {
    return u32(position.view(1)[0]);
}

def:priv state_end(state: ptr[SreState]) -> ptr[u16] {
    return ptr[u16](state.view(1)[0].end);
}

# Engine helpers sre.c defines once and sre_lib.h's functions call; each
# width's matcher has its own copy, which its handlers inline.

# sre_category(): whether `ch` belongs to SRE_CATEGORY_* `category`.
def:priv sre_category(category: u32, ch: u32) -> bool {
    match category {
        case 0:
            return sre_is_digit(ch);

        case 1:
            return not sre_is_digit(ch);

        case 2:
            return sre_is_space(ch);

        case 3:
            return not sre_is_space(ch);

        case 4:
            return sre_is_word(ch);

        case 5:
            return not sre_is_word(ch);

        case 6:
            return sre_is_linebreak(ch);

        case 7:
            return not sre_is_linebreak(ch);

        case 8:
            return sre_loc_is_word(ch);

        case 9:
            return not sre_loc_is_word(ch);

        case 10:
            return sre_uni_is_digit(ch);

        case 11:
            return not sre_uni_is_digit(ch);

        case 12:
            return sre_uni_is_space(ch);

        case 13:
            return not sre_uni_is_space(ch);

        case 14:
            return sre_uni_is_word(ch);

        case 15:
            return not sre_uni_is_word(ch);

        case 16:
            return sre_uni_is_linebreak(ch);

        case 17:
            return not sre_uni_is_linebreak(ch);

    }
    return False;
}

# SRE(charset): whether `ch` is a member of the set at `set`. The set is a
# sequence of operators ending with FAILURE; NEGATE flips the result.
def:priv sre_charset(set: ptr[u32], ch: u32) -> bool {
    ok = True;
    while True {
        op = set.view(1)[0];
        set += 1;
        match op {
            case 0:
                # FAILURE
                return not ok;

            case 16:
                # LITERAL <code>
                if ch == set.view(1)[0] {
                    return ok;
                }
                set += 1;

            case 8:
                # CATEGORY <code>
                if sre_category(set.view(1)[0], ch) {
                    return ok;
                }
                set += 1;

            case 9:
                # CHARSET <256-bit bitmap>
                if ch < 256
                    and ((set + int(ch >> 5)).view(1)[0] & (u32(1) << (ch & u32(31))))
                        != 0 {
                    return ok;
                }
                set += 8;

            case 22:
                # RANGE <lower> <upper>
                if set.view(1)[0] <= ch and ch <= (set + 1).view(1)[0] {
                    return ok;
                }
                set += 2;

            case 42:
                # RANGE_UNI_IGNORE <lower> <upper>; ch is already lower cased
                if set.view(1)[0] <= ch and ch <= (set + 1).view(1)[0] {
                    return ok;
                }
                uch = sre_upper_unicode(ch);
                if set.view(1)[0] <= uch and uch <= (set + 1).view(1)[0] {
                    return ok;
                }
                set += 2;

            case 21:
                # NEGATE
                ok = not ok;

            case 10:
                # BIGCHARSET <blockcount> <256 block indices> <blocks>
                count = int(set.view(1)[0]);
                set += 1;
                block = -1;
                if ch < 0x10000 {
                    block = int((ptr[u8](set) + int(ch >> 8)).view(1)[0]);
                }
                set += 64;
                if block >= 0
                    and (
                        (set + ((block * 256 + int(ch & u32(255))) >> 5)).view(1)[0]
                        & (u32(1) << (ch & u32(31)))
                    )
                        != 0 {
                    return ok;
                }
                set += count * 8;

            case _:
                # internal error -- there's not much we can do about it
                # here, so let's just pretend it didn't match...
                return False;

        }
    }
    return False;
}

# SRE(charset_loc_ignore)
def:priv sre_charset_loc_ignore(set: ptr[u32], ch: u32) -> bool {
    lo = sre_lower_locale(ch);
    if sre_charset(set, lo) {
        return True;
    }
    up = sre_upper_locale(ch);
    return up != lo and sre_charset(set, up);
}

# DATA_ALLOC of a match context: its offset in the data stack, or -1 when
# the stack cannot grow (SRE_ERROR_MEMORY).
def:priv context_alloc(state: ptr[SreState]) -> i64 {
    st = state.view(1);
    alloc_pos = st[0].data_stack_base;
    if i64(SRE_CONTEXT_SIZE) > wrapping_sub(st[0].data_stack_size, alloc_pos)
        and data_stack_grow(state, SRE_CONTEXT_SIZE) < 0 {
        return -1;
    }
    st[0].data_stack_base = wrapping_add(alloc_pos, i64(SRE_CONTEXT_SIZE));
    return alloc_pos;
}

# DATA_LOOKUP_AT: the context at offset `pos`.
def:priv context_at(state: ptr[SreState], pos: i64) -> ptr[SreContext] {
    return ptr[SreContext](state.view(1)[0].data_stack + pos);
}

# The offset of `ctx` in the data stack.
def:priv context_offset(state: ptr[SreState], ctx: ptr[SreContext]) -> i64 {
    return ptr[u8](ctx) - state.view(1)[0].data_stack;
}

# DATA_STACK_PUSH: 0, or SRE_ERROR_MEMORY.
def:priv data_push(state: ptr[SreState], data: ptr, size: i64) -> i64 {
    st = state.view(1);
    if size > wrapping_sub(st[0].data_stack_size, st[0].data_stack_base)
        and data_stack_grow(state, size) < 0 {
        return SRE_ERROR_MEMORY;
    }
    memcpy(st[0].data_stack + st[0].data_stack_base, data, u64(size));
    st[0].data_stack_base = wrapping_add(st[0].data_stack_base, size);
    return 0;
}

# DATA_STACK_POP, and DATA_STACK_POP_DISCARD when `discard`.
def:priv data_pop(state: ptr[SreState], data: ptr, size: i64, discard: bool) {
    st = state.view(1);
    memcpy(
        data, st[0].data_stack + wrapping_sub(st[0].data_stack_base, size), u64(size)
    );
    if discard {
        st[0].data_stack_base = wrapping_sub(st[0].data_stack_base, size);
    }
}

def:priv data_pop_discard(state: ptr[SreState], size: i64) {
    state.view(1)[0].data_stack_base = wrapping_sub(
        state.view(1)[0].data_stack_base, size
    );
}

# MARK_PUSH(lastmark): save marks 0..lastmark. The context moves when the
# stack grows, so this returns `ctx` where it now is, or NULL on
# SRE_ERROR_MEMORY.
def:priv mark_push(
    state: ptr[SreState], ctx: ptr[SreContext], lastmark: i32
) -> ptr[SreContext] {
    if lastmark < 0 {
        return ctx;
    }
    pos = context_offset(state, ctx);
    if data_push(state, ptr(state.view(1)[0].mark), (i64(lastmark) + 1) * 8) < 0 {
        return ptr[SreContext]();
    }
    return context_at(state, pos);
}

# MARK_POP(lastmark), MARK_POP_KEEP (keep) and MARK_POP_DISCARD.
def:priv mark_pop(state: ptr[SreState], lastmark: i32, keep: bool) {
    if lastmark >= 0 {
        data_pop(state, ptr(state.view(1)[0].mark), (i64(lastmark) + 1) * 8, not keep);
    }
}

def:priv mark_pop_discard(state: ptr[SreState], lastmark: i32) {
    if lastmark >= 0 {
        data_pop_discard(state, (i64(lastmark) + 1) * 8);
    }
}

# LAST_PTR_PUSH: save the context's repeat's last_ptr; `ctx` where it now
# is, or NULL on SRE_ERROR_MEMORY.
def:priv last_ptr_push(state: ptr[SreState], ctx: ptr[SreContext]) -> ptr[SreContext] {
    pos = context_offset(state, ctx);
    rep = ctx.view(1)[0].rep;
    if data_push(state, ptr(ptr[u8](rep) + SRE_REPEAT_LAST_PTR), 8) < 0 {
        return ptr[SreContext]();
    }
    return context_at(state, pos);
}

# LAST_PTR_POP
def:priv last_ptr_pop(state: ptr[SreState], ctx: ptr[SreContext]) {
    rep = ctx.view(1)[0].rep;
    data_pop(state, ptr(ptr[u8](rep) + SRE_REPEAT_LAST_PTR), 8, True);
}

def:priv repeat_pool_malloc(state: ptr[SreState]) -> ptr[SreRepeat] {
    st = state.view(1);
    repeat = st[0].repeat_pool_unused;
    if repeat {
        # remove from unused pool (singly-linked list)
        st[0].repeat_pool_unused = repeat.view(1)[0].pool_next;
    } else {
        repeat = ptr[SreRepeat](PyMem_Malloc(u64(SRE_REPEAT_SIZE)));
        if not repeat {
            return repeat;
        }
    }
    # add to used pool (doubly-linked list)
    temp = st[0].repeat_pool_used;
    if temp {
        temp.view(1)[0].pool_prev = repeat;
    }
    repeat.view(1)[0].pool_prev = ptr[SreRepeat]();
    repeat.view(1)[0].pool_next = temp;
    st[0].repeat_pool_used = repeat;
    return repeat;
}

def:priv repeat_pool_free(state: ptr[SreState], repeat: ptr[SreRepeat]) {
    st = state.view(1);
    prev = repeat.view(1)[0].pool_prev;
    next = repeat.view(1)[0].pool_next;
    # remove from used pool (doubly-linked list)
    if prev {
        prev.view(1)[0].pool_next = next;
    } else {
        st[0].repeat_pool_used = next;
    }
    if next {
        next.view(1)[0].pool_prev = prev;
    }
    # add to unused pool (singly-linked list)
    repeat.view(1)[0].pool_next = st[0].repeat_pool_unused;
    st[0].repeat_pool_unused = repeat;
}


# SRE(at): whether the position is at the given SRE_AT_* position.
def sre_at(state: ptr[SreState], position: ptr[u16], at: u32) -> bool {
    beginning = ptr[u16](state.view(1)[0].beginning);
    end = state_end(state);
    match at {
        case 0:
            # BEGINNING
            return position == beginning;

        case 2:
            # BEGINNING_STRING
            return position == beginning;

        case 1:
            # BEGINNING_LINE
            return position == beginning or sre_is_linebreak(char_at(position - 1));

        case 5:
            # END
            return (end - position == 1 and sre_is_linebreak(char_at(position)))
                or position == end;

        case 6:
            # END_LINE
            return position == end or sre_is_linebreak(char_at(position));

        case 7:
            # END_STRING
            return position == end;

        case 3:
            # BOUNDARY
            return word_at(state, position, 0) != word_at(state, position, 1);

        case 4:
            # NON_BOUNDARY
            return word_at(state, position, 0) == word_at(state, position, 1);

        case 8:
            # LOC_BOUNDARY
            return word_at(state, position, 2) != word_at(state, position, 3);

        case 9:
            # LOC_NON_BOUNDARY
            return word_at(state, position, 2) == word_at(state, position, 3);

        case 10:
            # UNI_BOUNDARY
            return word_at(state, position, 4) != word_at(state, position, 5);

        case 11:
            # UNI_NON_BOUNDARY
            return word_at(state, position, 4) == word_at(state, position, 5);

    }
    return False;
}

# The `thatp` (even `which`: the character before) or `thisp` (odd: the
# character at the position) of a boundary test; `which` // 2 picks ASCII,
# locale or Unicode words.
def:priv word_at(state: ptr[SreState], position: ptr[u16], which: int) -> bool {
    if which % 2 == 0 {
        if position <= ptr[u16](state.view(1)[0].beginning) {
            return False;
        }
        ch = char_at(position - 1);
    } else {
        if position >= state_end(state) {
            return False;
        }
        ch = char_at(position);
    }
    kind = which // 2;
    if kind == 0 {
        return sre_is_word(ch);
    }
    if kind == 1 {
        return sre_loc_is_word(ch);
    }
    return sre_uni_is_word(ch);
}

# SRE(count): how many times the single-character item at `pattern` repeats
# from the state's position, at most `maxcount` times; <0 on error.
def sre_count(state: ptr[SreState], pattern: ptr[u32], maxcount: i64) -> i64 {
    start = ptr[u16](state.view(1)[0].position);
    position = start;
    end = state_end(state);
    # adjust end
    if maxcount < end - position and maxcount != i64(SRE_MAXREPEAT) {
        end = position + maxcount;
    }
    chr = arg(pattern, 1);
    match arg(pattern, 0) {
        case 13:
            # IN: repeated set
            while position < end and sre_charset(pattern + 2, char_at(position)) {
                position += 1;
            }

        case 2:
            # ANY: repeated dot wildcard, up to the next newline.
            position = find_char_or_end(position, end, u32(0x0A));

        case 3:
            # ANY_ALL: repeated dot wildcard.  skip to the end of the target
            # string, and backtrack from there
            position = end;

        case 16:
            # LITERAL: repeated literal; one wider than the characters
            # cannot match
            if chr <= SRE_CHAR_LIMIT {
                while position < end and char_at(position) == chr {
                    position += 1;
                }
            }

        case 32:
            # LITERAL_IGNORE
            while position < end and sre_lower_ascii(char_at(position)) == chr {
                position += 1;
            }

        case 40:
            # LITERAL_UNI_IGNORE
            while position < end and sre_lower_unicode(char_at(position)) == chr {
                position += 1;
            }

        case 36:
            # LITERAL_LOC_IGNORE
            while position < end and char_loc_ignore(chr, char_at(position)) {
                position += 1;
            }

        case 20:
            # NOT_LITERAL: repeated non-literal, up to the literal; one wider
            # than the characters cannot match
            if chr > SRE_CHAR_LIMIT {
                position = end;
            } else {
                position = find_char_or_end(position, end, chr);
            }

        case 33:
            # NOT_LITERAL_IGNORE
            while position < end and sre_lower_ascii(char_at(position)) != chr {
                position += 1;
            }

        case 41:
            # NOT_LITERAL_UNI_IGNORE
            while position < end and sre_lower_unicode(char_at(position)) != chr {
                position += 1;
            }

        case 37:
            # NOT_LITERAL_LOC_IGNORE
            while position < end and not char_loc_ignore(chr, char_at(position)) {
                position += 1;
            }

        case _:
            # repeated single character pattern
            while ptr[u16](state.view(1)[0].position) < end {
                i = sre_match(state, pattern, i32(0));
                if i < 0 {
                    return i;
                }
                if i == 0 {
                    break;
                }
            }
            return ptr[u16](state.view(1)[0].position) - start;

    }
    return position - start;
}

# SRE(match): 1 when the pattern matches at the state's position (leaving
# the end of the match there), 0 when it does not, <0 on error.
#
# One loop over the C's labels, `step` naming the one control is at: the
# entrance of a context, the dispatch of the next opcode, the exit of a
# context, the head of a loop a DO_JUMP interrupts (whose state the context
# keeps, as the C keeps it there), or the label a popped context resumes at,
# numbered after the loop heads by its jump value.
def sre_match(state: ptr[SreState], pattern: ptr[u32], toplevel: i32) -> i64 {
    alloc_pos = context_alloc(state);
    if alloc_pos < 0 {
        return SRE_ERROR_MEMORY;
    }
    ctx = context_at(state, alloc_pos);
    ctx.view(1)[0].last_ctx_pos = -1;
    ctx.view(1)[0].jump = JUMP_NONE;
    ctx.view(1)[0].toplevel = toplevel;
    end = state_end(state);
    sigcount = state.view(1)[0].sigcount;
    ret: i64 = 0;
    step = 0;
    # entrance of the first context
    position = ptr[u16](state.view(1)[0].position);
    if arg(pattern, 0) == SRE_OP_INFO {
        # optimization info block
        # <INFO> <1=skip> <2=flags> <3=min> ...
        info_min = arg(pattern, 3);
        if info_min != 0 and end - position >= 0 and end - position < i64(info_min) {
            step = 1;
        } else {
            pattern += int(arg(pattern, 1)) + 1;
        }
    }
    while True {
        match step {
            case 0:
                while True {
                    # MAYBE_CHECK_SIGNALS
                    sigcount = wrapping_add(sigcount, u64(1));
                    if (sigcount & u64(0xFFF)) == 0 and PyErr_CheckSignals() != 0 {
                        return SRE_ERROR_INTERRUPTED;
                    }
                    op = arg(pattern, 0);
                    pattern += 1;
                    match op {
                        case 17:
                            # set mark
                            # <MARK> <gid>
                            st = state.view(1);
                            i = i32(arg(pattern, 0));
                            if (i & 1) != 0 {
                                st[0].lastindex = i // 2 + 1;
                            }
                            if i > st[0].lastmark {
                                # state->lastmark is the highest valid index in the
                                # state->mark array.  If it is increased by more
                                # than 1, the intervening marks must be set to NULL
                                # to signal that these marks have not been
                                # encountered.
                                j = st[0].lastmark + 1;
                                while j < i {
                                    (st[0].mark + int(j)).view(1)[0] = ptr();
                                    j += 1;
                                }
                                st[0].lastmark = i;
                            }
                            (st[0].mark + int(i)).view(1)[0] = ptr(position);
                            pattern += 1;
                            continue;

                        case 16:
                            # match literal string
                            # <LITERAL> <code>
                            if position >= end
                                or char_at(position) != arg(pattern, 0) {
                                ret = 0;
                                step = 1;
                                break;
                            }
                            pattern += 1;
                            position += 1;
                            continue;

                        case 20:
                            # match anything that is not literal character
                            # <NOT_LITERAL> <code>
                            if position >= end
                                or char_at(position) == arg(pattern, 0) {
                                ret = 0;
                                step = 1;
                                break;
                            }
                            pattern += 1;
                            position += 1;
                            continue;

                        case 1:
                            # end of pattern
                            st = state.view(1);
                            if ctx.view(1)[0].toplevel != 0
                                and (
                                    (
                                        st[0].match_all != 0
                                        and ptr(position) != st[0].end
                                    )
                                    or (
                                        st[0].must_advance != 0
                                        and ptr(position) == st[0].start
                                    )
                                ) {
                                ret = 0;
                                step = 1;
                                break;
                            }
                            st[0].position = ptr(position);
                            ret = 1;
                            step = 1;
                            break;

                        case 6:
                            # match at given position
                            # <AT> <code>
                            if not sre_at(state, position, arg(pattern, 0)) {
                                ret = 0;
                                step = 1;
                                break;
                            }
                            pattern += 1;
                            continue;

                        case 8:
                            # match at given category
                            # <CATEGORY> <code>
                            if position >= end
                                or not sre_category(
                                    arg(pattern, 0), char_at(position)
                                ) {
                                ret = 0;
                                step = 1;
                                break;
                            }
                            pattern += 1;
                            position += 1;
                            continue;

                        case 2:
                            # match anything (except a newline)
                            # <ANY>
                            if position >= end or sre_is_linebreak(char_at(position)) {
                                ret = 0;
                                step = 1;
                                break;
                            }
                            position += 1;
                            continue;

                        case 3:
                            # match anything
                            # <ANY_ALL>
                            if position >= end {
                                ret = 0;
                                step = 1;
                                break;
                            }
                            position += 1;
                            continue;

                        case 13:
                            # match set member (or non_member)
                            # <IN> <skip> <set>
                            if position >= end
                                or not sre_charset(pattern + 1, char_at(position)) {
                                ret = 0;
                                step = 1;
                                break;
                            }
                            pattern += int(arg(pattern, 0));
                            position += 1;
                            continue;

                        case 32:
                            if position >= end
                                or sre_lower_ascii(char_at(position))
                                    != arg(pattern, 0) {
                                ret = 0;
                                step = 1;
                                break;
                            }
                            pattern += 1;
                            position += 1;
                            continue;

                        case 40:
                            if position >= end
                                or sre_lower_unicode(char_at(position))
                                    != arg(pattern, 0) {
                                ret = 0;
                                step = 1;
                                break;
                            }
                            pattern += 1;
                            position += 1;
                            continue;

                        case 36:
                            if position >= end
                                or not char_loc_ignore(
                                    arg(pattern, 0), char_at(position)
                                ) {
                                ret = 0;
                                step = 1;
                                break;
                            }
                            pattern += 1;
                            position += 1;
                            continue;

                        case 33:
                            if position >= end
                                or sre_lower_ascii(char_at(position))
                                    == arg(pattern, 0) {
                                ret = 0;
                                step = 1;
                                break;
                            }
                            pattern += 1;
                            position += 1;
                            continue;

                        case 41:
                            if position >= end
                                or sre_lower_unicode(char_at(position))
                                    == arg(pattern, 0) {
                                ret = 0;
                                step = 1;
                                break;
                            }
                            pattern += 1;
                            position += 1;
                            continue;

                        case 37:
                            if position >= end
                                or char_loc_ignore(
                                    arg(pattern, 0), char_at(position)
                                ) {
                                ret = 0;
                                step = 1;
                                break;
                            }
                            pattern += 1;
                            position += 1;
                            continue;

                        case 31:
                            if position >= end
                                or not sre_charset(
                                    pattern + 1, sre_lower_ascii(char_at(position))
                                ) {
                                ret = 0;
                                step = 1;
                                break;
                            }
                            pattern += int(arg(pattern, 0));
                            position += 1;
                            continue;

                        case 39:
                            if position >= end
                                or not sre_charset(
                                    pattern + 1, sre_lower_unicode(char_at(position))
                                ) {
                                ret = 0;
                                step = 1;
                                break;
                            }
                            pattern += int(arg(pattern, 0));
                            position += 1;
                            continue;

                        case 35:
                            if position >= end
                                or not sre_charset_loc_ignore(
                                    pattern + 1, char_at(position)
                                ) {
                                ret = 0;
                                step = 1;
                                break;
                            }
                            pattern += int(arg(pattern, 0));
                            position += 1;
                            continue;

                        case 15:
                            # jump forward
                            # <JUMP> <offset>
                            pattern += int(arg(pattern, 0));
                            continue;

                        case 14:
                            # jump forward
                            # <JUMP> <offset>
                            pattern += int(arg(pattern, 0));
                            continue;

                        case 7:
                            # alternation
                            # <BRANCH> <0=skip> code <JUMP> ... <NULL>
                            lastmark_save(state, ctx);
                            if has_repeat(state) {
                                ctx = mark_push(state, ctx, ctx.view(1)[0].lastmark);
                                if not ctx {
                                    return SRE_ERROR_MEMORY;
                                }
                            }
                            step = 2;
                            break;

                        case 24:
                            # match repeated sequence (maximizing regexp)
                            # this operator only works if the repeated item is
                            # exactly one character wide, and we're not already
                            # collecting backtracking points.  for other cases,
                            # use the MAX_REPEAT operator
                            # <REPEAT_ONE> <skip> <1=min> <2=max> item <SUCCESS> tail
                            if i64(arg(pattern, 1)) > end - position {
                                # cannot match
                                ret = 0;
                                step = 1;
                                break;
                            }
                            set_position(state, position);
                            pos = context_offset(state, ctx);
                            ret = sre_count(state, pattern + 3, i64(arg(pattern, 2)));
                            if ret < 0 {
                                return ret;
                            }
                            ctx = context_at(state, pos);
                            ctx.view(1)[0].count = ret;
                            position += ret;
                            # when we arrive here, count contains the number of
                            # matches, and ptr points to the tail of the target
                            # string.  check if the rest of the pattern matches,
                            # and backtrack if not.
                            if ret < i64(arg(pattern, 1)) {
                                ret = 0;
                                step = 1;
                                break;
                            }
                            st = state.view(1);
                            next_op = arg(pattern, int(arg(pattern, 0)));
                            if next_op == SRE_OP_SUCCESS
                                and ptr(position) == st[0].end
                                and not (
                                    ctx.view(1)[0].toplevel != 0
                                    and st[0].must_advance != 0
                                    and ptr(position) == st[0].start
                                ) {
                                # tail is empty.  we're finished
                                st[0].position = ptr(position);
                                ret = 1;
                                step = 1;
                                break;
                            }
                            lastmark_save(state, ctx);
                            if has_repeat(state) {
                                ctx = mark_push(state, ctx, ctx.view(1)[0].lastmark);
                                if not ctx {
                                    return SRE_ERROR_MEMORY;
                                }
                            }
                            if next_op == SRE_OP_LITERAL {
                                # tail starts with a literal. skip positions where
                                # the rest of the pattern cannot possibly match
                                ctx.view(1)[0].chr = arg(
                                    pattern, int(arg(pattern, 0)) + 1
                                );
                                step = 3;
                                break;
                            }
                            # general case
                            step = 4;
                            break;

                        case 26:
                            # match repeated sequence (minimizing regexp)
                            # <MIN_REPEAT_ONE> <skip> <1=min> <2=max> item <SUCCESS> tail
                            if i64(arg(pattern, 1)) > end - position {
                                # cannot match
                                ret = 0;
                                step = 1;
                                break;
                            }
                            set_position(state, position);
                            if arg(pattern, 1) == 0 {
                                ctx.view(1)[0].count = 0;
                            } else {
                                # count using pattern min as the maximum
                                pos = context_offset(state, ctx);
                                ret = sre_count(
                                    state, pattern + 3, i64(arg(pattern, 1))
                                );
                                if ret < 0 {
                                    return ret;
                                }
                                ctx = context_at(state, pos);
                                if ret < i64(arg(pattern, 1)) {
                                    # didn't match minimum number of times
                                    ret = 0;
                                    step = 1;
                                    break;
                                }
                                # advance past minimum matches of repeat
                                ctx.view(1)[0].count = ret;
                                position += ret;
                            }
                            st = state.view(1);
                            if arg(pattern, int(arg(pattern, 0))) == SRE_OP_SUCCESS
                                and not (
                                    ctx.view(1)[0].toplevel != 0
                                    and (
                                        (
                                            st[0].match_all != 0
                                            and ptr(position) != st[0].end
                                        )
                                        or (
                                            st[0].must_advance != 0
                                            and ptr(position) == st[0].start
                                        )
                                    )
                                ) {
                                # tail is empty.  we're finished
                                st[0].position = ptr(position);
                                ret = 1;
                                step = 1;
                                break;
                            }
                            # general case
                            lastmark_save(state, ctx);
                            if has_repeat(state) {
                                ctx = mark_push(state, ctx, ctx.view(1)[0].lastmark);
                                if not ctx {
                                    return SRE_ERROR_MEMORY;
                                }
                            }
                            step = 5;
                            break;

                        case 29:
                            # match repeated sequence (maximizing regexp) without
                            # backtracking
                            # <POSSESSIVE_REPEAT_ONE> <skip> <1=min> <2=max> item <SUCCESS>
                            # tail
                            if position + int(arg(pattern, 1)) > end {
                                # cannot match
                                ret = 0;
                                step = 1;
                                break;
                            }
                            set_position(state, position);
                            pos = context_offset(state, ctx);
                            ret = sre_count(state, pattern + 3, i64(arg(pattern, 2)));
                            if ret < 0 {
                                return ret;
                            }
                            ctx = context_at(state, pos);
                            ctx.view(1)[0].count = ret;
                            position += ret;
                            # Test for not enough repetitions in match
                            if ret < i64(arg(pattern, 1)) {
                                ret = 0;
                                step = 1;
                                break;
                            }
                            # Update the pattern to point to the next op code
                            pattern += int(arg(pattern, 0));
                            # Let the tail be evaluated separately and consider
                            # this match successful.
                            st = state.view(1);
                            if arg(pattern, 0) == SRE_OP_SUCCESS
                                and ptr(position) == st[0].end
                                and not (
                                    ctx.view(1)[0].toplevel != 0
                                    and st[0].must_advance != 0
                                    and ptr(position) == st[0].start
                                ) {
                                # tail is empty.  we're finished
                                st[0].position = ptr(position);
                                ret = 1;
                                step = 1;
                                break;
                            }
                            # Attempt to match the rest of the string
                            continue;

                        case 23:
                            # create repeat context.  all the hard work is done by
                            # the UNTIL operator (MAX_UNTIL, MIN_UNTIL)
                            # <REPEAT> <skip> <1=min> <2=max>
                            # <3=repeat_index> item <UNTIL> tail
                            # install new repeat context
                            rep = repeat_pool_malloc(state);
                            if not rep {
                                return SRE_ERROR_MEMORY;
                            }
                            st = state.view(1);
                            rep.view(1)[0].count = -1;
                            rep.view(1)[0].pattern = pattern;
                            rep.view(1)[0].prev = st[0].repeat;
                            rep.view(1)[0].last_ptr = ptr();
                            st[0].repeat = rep;
                            ctx.view(1)[0].rep = rep;
                            st[0].position = ptr(position);
                            jump_target = pattern + int(arg(pattern, 0));
                            jump_toplevel = ctx.view(1)[0].toplevel;
                            ctx.view(1)[0].pattern = pattern;
                            ctx.view(1)[0].position = ptr(position);
                            ctx_pos = context_offset(state, ctx);
                            alloc_pos = context_alloc(state);
                            if alloc_pos < 0 {
                                return SRE_ERROR_MEMORY;
                            }
                            ctx = context_at(state, alloc_pos);
                            ctx.view(1)[0].toplevel = jump_toplevel;
                            ctx.view(1)[0].jump = JUMP_REPEAT;
                            ctx.view(1)[0].last_ctx_pos = ctx_pos;
                            pattern = jump_target;
                            position = ptr[u16](state.view(1)[0].position);
                            if arg(pattern, 0) == SRE_OP_INFO {
                                jump_min = arg(pattern, 3);
                                if jump_min != 0
                                    and end - position >= 0
                                    and end - position < i64(jump_min) {
                                    ret = 0;
                                    step = 1;
                                    break;
                                }
                                pattern += int(arg(pattern, 1)) + 1;
                            }
                            continue;

                        case 18:
                            # maximizing repeat
                            # <REPEAT> <skip> <1=min> <2=max> item <MAX_UNTIL> tail
                            st = state.view(1);
                            rep = st[0].repeat;
                            ctx.view(1)[0].rep = rep;
                            if not rep {
                                return SRE_ERROR_STATE;
                            }
                            st[0].position = ptr(position);
                            count = rep.view(1)[0].count + 1;
                            ctx.view(1)[0].count = count;
                            rep_pattern = rep.view(1)[0].pattern;
                            if count < i64(arg(rep_pattern, 1)) {
                                # not enough matches
                                rep.view(1)[0].count = count;
                                jump_target = rep_pattern + 3;
                                jump_toplevel = ctx.view(1)[0].toplevel;
                                ctx.view(1)[0].pattern = pattern;
                                ctx.view(1)[0].position = ptr(position);
                                ctx_pos = context_offset(state, ctx);
                                alloc_pos = context_alloc(state);
                                if alloc_pos < 0 {
                                    return SRE_ERROR_MEMORY;
                                }
                                ctx = context_at(state, alloc_pos);
                                ctx.view(1)[0].toplevel = jump_toplevel;
                                ctx.view(1)[0].jump = JUMP_MAX_UNTIL_1;
                                ctx.view(1)[0].last_ctx_pos = ctx_pos;
                                pattern = jump_target;
                                position = ptr[u16](state.view(1)[0].position);
                                if arg(pattern, 0) == SRE_OP_INFO {
                                    jump_min = arg(pattern, 3);
                                    if jump_min != 0
                                        and end - position >= 0
                                        and end - position < i64(jump_min) {
                                        ret = 0;
                                        step = 1;
                                        break;
                                    }
                                    pattern += int(arg(pattern, 1)) + 1;
                                }
                                continue;
                            }
                            maximum = arg(rep_pattern, 2);
                            if (count < i64(maximum) or maximum == SRE_MAXREPEAT)
                                and st[0].position != rep.view(1)[0].last_ptr {
                                # we may have enough matches, but if we can match
                                # another item, do so
                                rep.view(1)[0].count = count;
                                lastmark_save(state, ctx);
                                ctx = mark_push(state, ctx, ctx.view(1)[0].lastmark);
                                if not ctx {
                                    return SRE_ERROR_MEMORY;
                                }
                                # zero-width match protection
                                ctx = last_ptr_push(state, ctx);
                                if not ctx {
                                    return SRE_ERROR_MEMORY;
                                }
                                rep.view(1)[0].last_ptr = st[0].position;
                                jump_target = rep_pattern + 3;
                                jump_toplevel = ctx.view(1)[0].toplevel;
                                ctx.view(1)[0].pattern = pattern;
                                ctx.view(1)[0].position = ptr(position);
                                ctx_pos = context_offset(state, ctx);
                                alloc_pos = context_alloc(state);
                                if alloc_pos < 0 {
                                    return SRE_ERROR_MEMORY;
                                }
                                ctx = context_at(state, alloc_pos);
                                ctx.view(1)[0].toplevel = jump_toplevel;
                                ctx.view(1)[0].jump = JUMP_MAX_UNTIL_2;
                                ctx.view(1)[0].last_ctx_pos = ctx_pos;
                                pattern = jump_target;
                                position = ptr[u16](state.view(1)[0].position);
                                if arg(pattern, 0) == SRE_OP_INFO {
                                    jump_min = arg(pattern, 3);
                                    if jump_min != 0
                                        and end - position >= 0
                                        and end - position < i64(jump_min) {
                                        ret = 0;
                                        step = 1;
                                        break;
                                    }
                                    pattern += int(arg(pattern, 1)) + 1;
                                }
                                continue;
                            }
                            step = 6;
                            break;

                        case 19:
                            # minimizing repeat
                            # <REPEAT> <skip> <1=min> <2=max> item <MIN_UNTIL> tail
                            st = state.view(1);
                            rep = st[0].repeat;
                            ctx.view(1)[0].rep = rep;
                            if not rep {
                                return SRE_ERROR_STATE;
                            }
                            st[0].position = ptr(position);
                            count = rep.view(1)[0].count + 1;
                            ctx.view(1)[0].count = count;
                            rep_pattern = rep.view(1)[0].pattern;
                            if count < i64(arg(rep_pattern, 1)) {
                                # not enough matches
                                rep.view(1)[0].count = count;
                                jump_target = rep_pattern + 3;
                                jump_toplevel = ctx.view(1)[0].toplevel;
                                ctx.view(1)[0].pattern = pattern;
                                ctx.view(1)[0].position = ptr(position);
                                ctx_pos = context_offset(state, ctx);
                                alloc_pos = context_alloc(state);
                                if alloc_pos < 0 {
                                    return SRE_ERROR_MEMORY;
                                }
                                ctx = context_at(state, alloc_pos);
                                ctx.view(1)[0].toplevel = jump_toplevel;
                                ctx.view(1)[0].jump = JUMP_MIN_UNTIL_1;
                                ctx.view(1)[0].last_ctx_pos = ctx_pos;
                                pattern = jump_target;
                                position = ptr[u16](state.view(1)[0].position);
                                if arg(pattern, 0) == SRE_OP_INFO {
                                    jump_min = arg(pattern, 3);
                                    if jump_min != 0
                                        and end - position >= 0
                                        and end - position < i64(jump_min) {
                                        ret = 0;
                                        step = 1;
                                        break;
                                    }
                                    pattern += int(arg(pattern, 1)) + 1;
                                }
                                continue;
                            }
                            # see if the tail matches
                            st[0].repeat = rep.view(1)[0].prev;
                            lastmark_save(state, ctx);
                            if has_repeat(state) {
                                ctx = mark_push(state, ctx, ctx.view(1)[0].lastmark);
                                if not ctx {
                                    return SRE_ERROR_MEMORY;
                                }
                            }
                            jump_target = pattern;
                            jump_toplevel = ctx.view(1)[0].toplevel;
                            ctx.view(1)[0].pattern = pattern;
                            ctx.view(1)[0].position = ptr(position);
                            ctx_pos = context_offset(state, ctx);
                            alloc_pos = context_alloc(state);
                            if alloc_pos < 0 {
                                return SRE_ERROR_MEMORY;
                            }
                            ctx = context_at(state, alloc_pos);
                            ctx.view(1)[0].toplevel = jump_toplevel;
                            ctx.view(1)[0].jump = JUMP_MIN_UNTIL_2;
                            ctx.view(1)[0].last_ctx_pos = ctx_pos;
                            pattern = jump_target;
                            position = ptr[u16](state.view(1)[0].position);
                            if arg(pattern, 0) == SRE_OP_INFO {
                                jump_min = arg(pattern, 3);
                                if jump_min != 0
                                    and end - position >= 0
                                    and end - position < i64(jump_min) {
                                    ret = 0;
                                    step = 1;
                                    break;
                                }
                                pattern += int(arg(pattern, 1)) + 1;
                            }
                            continue;

                        case 28:
                            # create possessive repeat contexts.
                            # <POSSESSIVE_REPEAT> <skip> <1=min> <2=max> pattern
                            # <SUCCESS> tail
                            # Set the global Input pointer to this context's Input
                            # pointer
                            st = state.view(1);
                            st[0].position = ptr(position);
                            # Set state->repeat to non-NULL
                            rep = repeat_pool_malloc(state);
                            if not rep {
                                return SRE_ERROR_MEMORY;
                            }
                            rep.view(1)[0].count = -1;
                            rep.view(1)[0].pattern = ptr[u32]();
                            rep.view(1)[0].prev = st[0].repeat;
                            rep.view(1)[0].last_ptr = ptr();
                            st[0].repeat = rep;
                            ctx.view(1)[0].rep = rep;
                            # Initialize Count to 0
                            ctx.view(1)[0].count = 0;
                            step = 7;
                            break;

                        case 27:
                            # Atomic Group Sub Pattern
                            # <ATOMIC_GROUP> <skip> pattern <SUCCESS> tail
                            # Set the global Input pointer to this context's Input
                            # pointer
                            set_position(state, position);
                            # Evaluate the Atomic Group in a new context,
                            # terminating when the end of the group, represented
                            # by a SUCCESS op code, is reached. Group Pattern
                            # begins at an offset of 1 code.
                            jump_target = pattern + 1;
                            jump_toplevel = i32(0);
                            ctx.view(1)[0].pattern = pattern;
                            ctx.view(1)[0].position = ptr(position);
                            ctx_pos = context_offset(state, ctx);
                            alloc_pos = context_alloc(state);
                            if alloc_pos < 0 {
                                return SRE_ERROR_MEMORY;
                            }
                            ctx = context_at(state, alloc_pos);
                            ctx.view(1)[0].toplevel = jump_toplevel;
                            ctx.view(1)[0].jump = JUMP_ATOMIC_GROUP;
                            ctx.view(1)[0].last_ctx_pos = ctx_pos;
                            pattern = jump_target;
                            position = ptr[u16](state.view(1)[0].position);
                            if arg(pattern, 0) == SRE_OP_INFO {
                                jump_min = arg(pattern, 3);
                                if jump_min != 0
                                    and end - position >= 0
                                    and end - position < i64(jump_min) {
                                    ret = 0;
                                    step = 1;
                                    break;
                                }
                                pattern += int(arg(pattern, 1)) + 1;
                            }
                            continue;

                        case 11:
                            # match backreference
                            after = groupref_matches(state, pattern, position, 0);
                            if not after {
                                ret = 0;
                                step = 1;
                                break;
                            }
                            position = after;
                            pattern += 1;
                            continue;

                        case 30:
                            # match backreference
                            after = groupref_matches(state, pattern, position, 1);
                            if not after {
                                ret = 0;
                                step = 1;
                                break;
                            }
                            position = after;
                            pattern += 1;
                            continue;

                        case 38:
                            # match backreference
                            after = groupref_matches(state, pattern, position, 2);
                            if not after {
                                ret = 0;
                                step = 1;
                                break;
                            }
                            position = after;
                            pattern += 1;
                            continue;

                        case 34:
                            # match backreference
                            after = groupref_matches(state, pattern, position, 3);
                            if not after {
                                ret = 0;
                                step = 1;
                                break;
                            }
                            position = after;
                            pattern += 1;
                            continue;

                        case 12:
                            # <GROUPREF_EXISTS> <group> <skip> codeyes <JUMP> codeno ...
                            st = state.view(1);
                            groupref = i32(arg(pattern, 0)) * 2;
                            if groupref >= st[0].lastmark {
                                pattern += int(arg(pattern, 1));
                                continue;
                            }
                            p = (st[0].mark + int(groupref)).view(1)[0];
                            e = (st[0].mark + int(groupref + 1)).view(1)[0];
                            if not p or not e or e < p {
                                pattern += int(arg(pattern, 1));
                                continue;
                            }
                            pattern += 2;
                            continue;

                        case 4:
                            # assert subpattern
                            # <ASSERT> <skip> <back> <pattern>
                            back = i64(arg(pattern, 1));
                            if position - ptr[u16](state.view(1)[0].beginning) < back {
                                ret = 0;
                                step = 1;
                                break;
                            }
                            set_position(state, position - back);
                            jump_target = pattern + 2;
                            jump_toplevel = i32(0);
                            ctx.view(1)[0].pattern = pattern;
                            ctx.view(1)[0].position = ptr(position);
                            ctx_pos = context_offset(state, ctx);
                            alloc_pos = context_alloc(state);
                            if alloc_pos < 0 {
                                return SRE_ERROR_MEMORY;
                            }
                            ctx = context_at(state, alloc_pos);
                            ctx.view(1)[0].toplevel = jump_toplevel;
                            ctx.view(1)[0].jump = JUMP_ASSERT;
                            ctx.view(1)[0].last_ctx_pos = ctx_pos;
                            pattern = jump_target;
                            position = ptr[u16](state.view(1)[0].position);
                            if arg(pattern, 0) == SRE_OP_INFO {
                                jump_min = arg(pattern, 3);
                                if jump_min != 0
                                    and end - position >= 0
                                    and end - position < i64(jump_min) {
                                    ret = 0;
                                    step = 1;
                                    break;
                                }
                                pattern += int(arg(pattern, 1)) + 1;
                            }
                            continue;

                        case 5:
                            # assert not subpattern
                            # <ASSERT_NOT> <skip> <back> <pattern>
                            back = i64(arg(pattern, 1));
                            if position - ptr[u16](state.view(1)[0].beginning)
                                >= back {
                                set_position(state, position - back);
                                lastmark_save(state, ctx);
                                if has_repeat(state) {
                                    ctx = mark_push(
                                        state, ctx, ctx.view(1)[0].lastmark
                                    );
                                    if not ctx {
                                        return SRE_ERROR_MEMORY;
                                    }
                                }
                                jump_target = pattern + 2;
                                jump_toplevel = i32(0);
                                ctx.view(1)[0].pattern = pattern;
                                ctx.view(1)[0].position = ptr(position);
                                ctx_pos = context_offset(state, ctx);
                                alloc_pos = context_alloc(state);
                                if alloc_pos < 0 {
                                    return SRE_ERROR_MEMORY;
                                }
                                ctx = context_at(state, alloc_pos);
                                ctx.view(1)[0].toplevel = jump_toplevel;
                                ctx.view(1)[0].jump = JUMP_ASSERT_NOT;
                                ctx.view(1)[0].last_ctx_pos = ctx_pos;
                                pattern = jump_target;
                                position = ptr[u16](state.view(1)[0].position);
                                if arg(pattern, 0) == SRE_OP_INFO {
                                    jump_min = arg(pattern, 3);
                                    if jump_min != 0
                                        and end - position >= 0
                                        and end - position < i64(jump_min) {
                                        ret = 0;
                                        step = 1;
                                        break;
                                    }
                                    pattern += int(arg(pattern, 1)) + 1;
                                }
                                continue;
                            }
                            pattern += int(arg(pattern, 0));
                            continue;

                        case 0:
                            # immediate failure
                            ret = 0;
                            step = 1;
                            break;

                    }
                    # RANGE_UNI_IGNORE, SUBPATTERN, RANGE, NEGATE, BIGCHARSET,
                    # CHARSET and any other code
                    return SRE_ERROR_ILLEGAL;
                }
                if step == 1 {
                    ctx_pos = ctx.view(1)[0].last_ctx_pos;
                    jump = ctx.view(1)[0].jump;
                    state.view(1)[0].data_stack_base = wrapping_sub(
                        state.view(1)[0].data_stack_base, i64(SRE_CONTEXT_SIZE)
                    );
                    if ctx_pos == -1 {
                        state.view(1)[0].sigcount = sigcount;
                        return ret;
                    }
                    ctx = context_at(state, ctx_pos);
                    pattern = ctx.view(1)[0].pattern;
                    position = ptr[u16](ctx.view(1)[0].position);
                    step = 9 + int(jump);
                    continue;
                }
                continue;

            case 1:
                ctx_pos = ctx.view(1)[0].last_ctx_pos;
                jump = ctx.view(1)[0].jump;
                state.view(1)[0].data_stack_base = wrapping_sub(
                    state.view(1)[0].data_stack_base, i64(SRE_CONTEXT_SIZE)
                );
                if ctx_pos == -1 {
                    state.view(1)[0].sigcount = sigcount;
                    return ret;
                }
                ctx = context_at(state, ctx_pos);
                pattern = ctx.view(1)[0].pattern;
                position = ptr[u16](ctx.view(1)[0].position);
                step = 9 + int(jump);
                continue;

            case 20:
                if ret != 0 {
                    if has_repeat(state) {
                        mark_pop_discard(state, ctx.view(1)[0].lastmark);
                    }
                    if ret < 0 {
                        return ret;
                    }
                    ret = 1;
                    step = 1;
                    continue;
                }
                if has_repeat(state) {
                    mark_pop(state, ctx.view(1)[0].lastmark, True);
                }
                lastmark_restore(state, ctx);
                pattern += int(arg(pattern, 0));
                step = 2;
                continue;

            case 2:
                # the BRANCH loop over the alternatives from `pattern`
                while arg(pattern, 0) != 0 {
                    branch_op = arg(pattern, 1);
                    if branch_op == SRE_OP_LITERAL
                        and (position >= end or char_at(position) != arg(pattern, 2)) {
                        pattern += int(arg(pattern, 0));
                        continue;
                    }
                    if branch_op == SRE_OP_IN
                        and (
                            position >= end
                            or not sre_charset(pattern + 3, char_at(position))
                        ) {
                        pattern += int(arg(pattern, 0));
                        continue;
                    }
                    break;
                }
                if arg(pattern, 0) != 0 {
                    set_position(state, position);
                    jump_target = pattern + 1;
                    jump_toplevel = ctx.view(1)[0].toplevel;
                    ctx.view(1)[0].pattern = pattern;
                    ctx.view(1)[0].position = ptr(position);
                    ctx_pos = context_offset(state, ctx);
                    alloc_pos = context_alloc(state);
                    if alloc_pos < 0 {
                        return SRE_ERROR_MEMORY;
                    }
                    ctx = context_at(state, alloc_pos);
                    ctx.view(1)[0].toplevel = jump_toplevel;
                    ctx.view(1)[0].jump = JUMP_BRANCH;
                    ctx.view(1)[0].last_ctx_pos = ctx_pos;
                    pattern = jump_target;
                    position = ptr[u16](state.view(1)[0].position);
                    if arg(pattern, 0) == SRE_OP_INFO {
                        jump_min = arg(pattern, 3);
                        if jump_min != 0
                            and end - position >= 0
                            and end - position < i64(jump_min) {
                            ret = 0;
                            step = 1;
                            continue;
                        }
                        pattern += int(arg(pattern, 1)) + 1;
                    }
                    step = 0;
                    continue;
                }
                if has_repeat(state) {
                    mark_pop_discard(state, ctx.view(1)[0].lastmark);
                }
                ret = 0;
                step = 1;
                continue;

            case 3:
                minimum = i64(arg(pattern, 1));
                chr = ctx.view(1)[0].chr;
                count = ctx.view(1)[0].count;
                while count >= minimum
                    and (position >= end or char_at(position) != chr) {
                    position -= 1;
                    count -= 1;
                }
                ctx.view(1)[0].count = count;
                if count < minimum {
                    if has_repeat(state) {
                        mark_pop_discard(state, ctx.view(1)[0].lastmark);
                    }
                    ret = 0;
                    step = 1;
                    continue;
                }
                set_position(state, position);
                jump_target = pattern + int(arg(pattern, 0));
                jump_toplevel = ctx.view(1)[0].toplevel;
                ctx.view(1)[0].pattern = pattern;
                ctx.view(1)[0].position = ptr(position);
                ctx_pos = context_offset(state, ctx);
                alloc_pos = context_alloc(state);
                if alloc_pos < 0 {
                    return SRE_ERROR_MEMORY;
                }
                ctx = context_at(state, alloc_pos);
                ctx.view(1)[0].toplevel = jump_toplevel;
                ctx.view(1)[0].jump = JUMP_REPEAT_ONE_1;
                ctx.view(1)[0].last_ctx_pos = ctx_pos;
                pattern = jump_target;
                position = ptr[u16](state.view(1)[0].position);
                if arg(pattern, 0) == SRE_OP_INFO {
                    jump_min = arg(pattern, 3);
                    if jump_min != 0
                        and end - position >= 0
                        and end - position < i64(jump_min) {
                        ret = 0;
                        step = 1;
                        continue;
                    }
                    pattern += int(arg(pattern, 1)) + 1;
                }
                step = 0;
                continue;

            case 17:
                if ret != 0 {
                    if has_repeat(state) {
                        mark_pop_discard(state, ctx.view(1)[0].lastmark);
                    }
                    if ret < 0 {
                        return ret;
                    }
                    ret = 1;
                    step = 1;
                    continue;
                }
                if has_repeat(state) {
                    mark_pop(state, ctx.view(1)[0].lastmark, True);
                }
                lastmark_restore(state, ctx);
                position -= 1;
                ctx.view(1)[0].count -= 1;
                step = 3;
                continue;

            case 4:
                if ctx.view(1)[0].count < i64(arg(pattern, 1)) {
                    if has_repeat(state) {
                        mark_pop_discard(state, ctx.view(1)[0].lastmark);
                    }
                    ret = 0;
                    step = 1;
                    continue;
                }
                set_position(state, position);
                jump_target = pattern + int(arg(pattern, 0));
                jump_toplevel = ctx.view(1)[0].toplevel;
                ctx.view(1)[0].pattern = pattern;
                ctx.view(1)[0].position = ptr(position);
                ctx_pos = context_offset(state, ctx);
                alloc_pos = context_alloc(state);
                if alloc_pos < 0 {
                    return SRE_ERROR_MEMORY;
                }
                ctx = context_at(state, alloc_pos);
                ctx.view(1)[0].toplevel = jump_toplevel;
                ctx.view(1)[0].jump = JUMP_REPEAT_ONE_2;
                ctx.view(1)[0].last_ctx_pos = ctx_pos;
                pattern = jump_target;
                position = ptr[u16](state.view(1)[0].position);
                if arg(pattern, 0) == SRE_OP_INFO {
                    jump_min = arg(pattern, 3);
                    if jump_min != 0
                        and end - position >= 0
                        and end - position < i64(jump_min) {
                        ret = 0;
                        step = 1;
                        continue;
                    }
                    pattern += int(arg(pattern, 1)) + 1;
                }
                step = 0;
                continue;

            case 18:
                if ret != 0 {
                    if has_repeat(state) {
                        mark_pop_discard(state, ctx.view(1)[0].lastmark);
                    }
                    if ret < 0 {
                        return ret;
                    }
                    ret = 1;
                    step = 1;
                    continue;
                }
                if has_repeat(state) {
                    mark_pop(state, ctx.view(1)[0].lastmark, True);
                }
                lastmark_restore(state, ctx);
                position -= 1;
                ctx.view(1)[0].count -= 1;
                step = 4;
                continue;

            case 5:
                maximum = arg(pattern, 2);
                if maximum == SRE_MAXREPEAT or ctx.view(1)[0].count <= i64(maximum) {
                    set_position(state, position);
                    jump_target = pattern + int(arg(pattern, 0));
                    jump_toplevel = ctx.view(1)[0].toplevel;
                    ctx.view(1)[0].pattern = pattern;
                    ctx.view(1)[0].position = ptr(position);
                    ctx_pos = context_offset(state, ctx);
                    alloc_pos = context_alloc(state);
                    if alloc_pos < 0 {
                        return SRE_ERROR_MEMORY;
                    }
                    ctx = context_at(state, alloc_pos);
                    ctx.view(1)[0].toplevel = jump_toplevel;
                    ctx.view(1)[0].jump = JUMP_MIN_REPEAT_ONE;
                    ctx.view(1)[0].last_ctx_pos = ctx_pos;
                    pattern = jump_target;
                    position = ptr[u16](state.view(1)[0].position);
                    if arg(pattern, 0) == SRE_OP_INFO {
                        jump_min = arg(pattern, 3);
                        if jump_min != 0
                            and end - position >= 0
                            and end - position < i64(jump_min) {
                            ret = 0;
                            step = 1;
                            continue;
                        }
                        pattern += int(arg(pattern, 1)) + 1;
                    }
                    step = 0;
                    continue;
                }
                if has_repeat(state) {
                    mark_pop_discard(state, ctx.view(1)[0].lastmark);
                }
                ret = 0;
                step = 1;
                continue;

            case 19:
                if ret != 0 {
                    if has_repeat(state) {
                        mark_pop_discard(state, ctx.view(1)[0].lastmark);
                    }
                    if ret < 0 {
                        return ret;
                    }
                    ret = 1;
                    step = 1;
                    continue;
                }
                if has_repeat(state) {
                    mark_pop(state, ctx.view(1)[0].lastmark, True);
                }
                lastmark_restore(state, ctx);
                set_position(state, position);
                pos = context_offset(state, ctx);
                ret = sre_count(state, pattern + 3, 1);
                if ret < 0 {
                    return ret;
                }
                ctx = context_at(state, pos);
                if ret == 0 {
                    if has_repeat(state) {
                        mark_pop_discard(state, ctx.view(1)[0].lastmark);
                    }
                    ret = 0;
                    step = 1;
                    continue;
                }
                position += 1;
                ctx.view(1)[0].count += 1;
                step = 5;
                continue;

            case 16:
                rep = ctx.view(1)[0].rep;
                state.view(1)[0].repeat = rep.view(1)[0].prev;
                repeat_pool_free(state, rep);
                if ret != 0 {
                    if ret < 0 {
                        return ret;
                    }
                    ret = 1;
                    step = 1;
                    continue;
                }
                ret = 0;
                step = 1;
                continue;

            case 10:
                if ret != 0 {
                    if ret < 0 {
                        return ret;
                    }
                    ret = 1;
                    step = 1;
                    continue;
                }
                ctx.view(1)[0].rep.view(1)[0].count = ctx.view(1)[0].count - 1;
                set_position(state, position);
                ret = 0;
                step = 1;
                continue;

            case 11:
                last_ptr_pop(state, ctx);
                if ret != 0 {
                    mark_pop_discard(state, ctx.view(1)[0].lastmark);
                    if ret < 0 {
                        return ret;
                    }
                    ret = 1;
                    step = 1;
                    continue;
                }
                mark_pop(state, ctx.view(1)[0].lastmark, False);
                lastmark_restore(state, ctx);
                ctx.view(1)[0].rep.view(1)[0].count = ctx.view(1)[0].count - 1;
                set_position(state, position);
                step = 6;
                continue;

            case 6:
                # cannot match more repeated items here.  make sure the tail
                # matches
                state.view(1)[0].repeat = ctx.view(1)[0].rep.view(1)[0].prev;
                jump_target = pattern;
                jump_toplevel = ctx.view(1)[0].toplevel;
                ctx.view(1)[0].pattern = pattern;
                ctx.view(1)[0].position = ptr(position);
                ctx_pos = context_offset(state, ctx);
                alloc_pos = context_alloc(state);
                if alloc_pos < 0 {
                    return SRE_ERROR_MEMORY;
                }
                ctx = context_at(state, alloc_pos);
                ctx.view(1)[0].toplevel = jump_toplevel;
                ctx.view(1)[0].jump = JUMP_MAX_UNTIL_3;
                ctx.view(1)[0].last_ctx_pos = ctx_pos;
                pattern = jump_target;
                position = ptr[u16](state.view(1)[0].position);
                if arg(pattern, 0) == SRE_OP_INFO {
                    jump_min = arg(pattern, 3);
                    if jump_min != 0
                        and end - position >= 0
                        and end - position < i64(jump_min) {
                        ret = 0;
                        step = 1;
                        continue;
                    }
                    pattern += int(arg(pattern, 1)) + 1;
                }
                step = 0;
                continue;

            case 12:
                # restore repeat before return
                state.view(1)[0].repeat = ctx.view(1)[0].rep;
                if ret < 0 {
                    return ret;
                }
                if ret > 0 {
                    ret = 1;
                    step = 1;
                    continue;
                }
                set_position(state, position);
                ret = 0;
                step = 1;
                continue;

            case 13:
                if ret != 0 {
                    if ret < 0 {
                        return ret;
                    }
                    ret = 1;
                    step = 1;
                    continue;
                }
                ctx.view(1)[0].rep.view(1)[0].count = ctx.view(1)[0].count - 1;
                set_position(state, position);
                ret = 0;
                step = 1;
                continue;

            case 14:
                st = state.view(1);
                repeat_of_tail = st[0].repeat;
                # restore repeat before return
                rep = ctx.view(1)[0].rep;
                st[0].repeat = rep;
                if ret != 0 {
                    if repeat_of_tail {
                        mark_pop_discard(state, ctx.view(1)[0].lastmark);
                    }
                    if ret < 0 {
                        return ret;
                    }
                    ret = 1;
                    step = 1;
                    continue;
                }
                if repeat_of_tail {
                    mark_pop(state, ctx.view(1)[0].lastmark, False);
                }
                lastmark_restore(state, ctx);
                st[0].position = ptr(position);
                count = ctx.view(1)[0].count;
                maximum = arg(rep.view(1)[0].pattern, 2);
                if (count >= i64(maximum) and maximum != SRE_MAXREPEAT)
                    or st[0].position == rep.view(1)[0].last_ptr {
                    ret = 0;
                    step = 1;
                    continue;
                }
                rep.view(1)[0].count = count;
                # zero-width match protection
                ctx = last_ptr_push(state, ctx);
                if not ctx {
                    return SRE_ERROR_MEMORY;
                }
                rep.view(1)[0].last_ptr = st[0].position;
                jump_target = rep.view(1)[0].pattern + 3;
                jump_toplevel = ctx.view(1)[0].toplevel;
                ctx.view(1)[0].pattern = pattern;
                ctx.view(1)[0].position = ptr(position);
                ctx_pos = context_offset(state, ctx);
                alloc_pos = context_alloc(state);
                if alloc_pos < 0 {
                    return SRE_ERROR_MEMORY;
                }
                ctx = context_at(state, alloc_pos);
                ctx.view(1)[0].toplevel = jump_toplevel;
                ctx.view(1)[0].jump = JUMP_MIN_UNTIL_3;
                ctx.view(1)[0].last_ctx_pos = ctx_pos;
                pattern = jump_target;
                position = ptr[u16](state.view(1)[0].position);
                if arg(pattern, 0) == SRE_OP_INFO {
                    jump_min = arg(pattern, 3);
                    if jump_min != 0
                        and end - position >= 0
                        and end - position < i64(jump_min) {
                        ret = 0;
                        step = 1;
                        continue;
                    }
                    pattern += int(arg(pattern, 1)) + 1;
                }
                step = 0;
                continue;

            case 15:
                last_ptr_pop(state, ctx);
                if ret != 0 {
                    if ret < 0 {
                        return ret;
                    }
                    ret = 1;
                    step = 1;
                    continue;
                }
                ctx.view(1)[0].rep.view(1)[0].count = ctx.view(1)[0].count - 1;
                set_position(state, position);
                ret = 0;
                step = 1;
                continue;

            case 7:
                # Check for minimum required matches.
                if ctx.view(1)[0].count < i64(arg(pattern, 1)) {
                    # not enough matches
                    jump_target = pattern + 3;
                    jump_toplevel = i32(0);
                    ctx.view(1)[0].pattern = pattern;
                    ctx.view(1)[0].position = ptr(position);
                    ctx_pos = context_offset(state, ctx);
                    alloc_pos = context_alloc(state);
                    if alloc_pos < 0 {
                        return SRE_ERROR_MEMORY;
                    }
                    ctx = context_at(state, alloc_pos);
                    ctx.view(1)[0].toplevel = jump_toplevel;
                    ctx.view(1)[0].jump = JUMP_POSS_REPEAT_1;
                    ctx.view(1)[0].last_ctx_pos = ctx_pos;
                    pattern = jump_target;
                    position = ptr[u16](state.view(1)[0].position);
                    if arg(pattern, 0) == SRE_OP_INFO {
                        jump_min = arg(pattern, 3);
                        if jump_min != 0
                            and end - position >= 0
                            and end - position < i64(jump_min) {
                            ret = 0;
                            step = 1;
                            continue;
                        }
                        pattern += int(arg(pattern, 1)) + 1;
                    }
                    step = 0;
                    continue;
                }
                # Clear the context's Input stream pointer so that it doesn't
                # match the global state so that the while loop can be
                # entered.
                position = ptr[u16]();
                step = 8;
                continue;

            case 23:
                if ret != 0 {
                    if ret < 0 {
                        return ret;
                    }
                    ctx.view(1)[0].count += 1;
                    step = 7;
                    continue;
                }
                st = state.view(1);
                st[0].position = ptr(position);
                # Restore state->repeat
                rep = ctx.view(1)[0].rep;
                st[0].repeat = rep.view(1)[0].prev;
                repeat_pool_free(state, rep);
                ret = 0;
                step = 1;
                continue;

            case 8:
                # Keep trying to parse the <pattern> sub-pattern until the end
                # is reached, creating a new context each time.
                maximum = arg(pattern, 2);
                st = state.view(1);
                if (ctx.view(1)[0].count < i64(maximum) or maximum == SRE_MAXREPEAT)
                    and st[0].position != ptr(position) {
                    # Save the Capture Group Marker state into the current
                    # Context and back up the current highest number Capture
                    # Group marker.
                    lastmark_save(state, ctx);
                    ctx = mark_push(state, ctx, ctx.view(1)[0].lastmark);
                    if not ctx {
                        return SRE_ERROR_MEMORY;
                    }
                    # zero-width match protection: the context keeps the last
                    # known good position while the state's moves with the
                    # most recent match; when they are the same, the item
                    # matched the empty string and every further match would
                    # too.
                    position = ptr[u16](st[0].position);
                    # We have not reached the maximin matches, so try to match
                    # once more.
                    jump_target = pattern + 3;
                    jump_toplevel = i32(0);
                    ctx.view(1)[0].pattern = pattern;
                    ctx.view(1)[0].position = ptr(position);
                    ctx_pos = context_offset(state, ctx);
                    alloc_pos = context_alloc(state);
                    if alloc_pos < 0 {
                        return SRE_ERROR_MEMORY;
                    }
                    ctx = context_at(state, alloc_pos);
                    ctx.view(1)[0].toplevel = jump_toplevel;
                    ctx.view(1)[0].jump = JUMP_POSS_REPEAT_2;
                    ctx.view(1)[0].last_ctx_pos = ctx_pos;
                    pattern = jump_target;
                    position = ptr[u16](state.view(1)[0].position);
                    if arg(pattern, 0) == SRE_OP_INFO {
                        jump_min = arg(pattern, 3);
                        if jump_min != 0
                            and end - position >= 0
                            and end - position < i64(jump_min) {
                            ret = 0;
                            step = 1;
                            continue;
                        }
                        pattern += int(arg(pattern, 1)) + 1;
                    }
                    step = 0;
                    continue;
                }
                step = 9;
                continue;

            case 24:
                # Check to see if the last attempted match succeeded.
                if ret != 0 {
                    # Drop the saved highest number Capture Group marker saved
                    # above and use the newly updated value.
                    mark_pop_discard(state, ctx.view(1)[0].lastmark);
                    if ret < 0 {
                        return ret;
                    }
                    # Success, increment the count.
                    ctx.view(1)[0].count += 1;
                    step = 8;
                    continue;
                }
                # Last attempted match failed: restore the saved highest
                # number Capture Group marker and the global Input Stream
                # pointer, which can change after jumps; there are sufficient
                # matches, so the loop ends.
                mark_pop(state, ctx.view(1)[0].lastmark, False);
                lastmark_restore(state, ctx);
                set_position(state, position);
                step = 9;
                continue;

            case 9:
                # Restore state->repeat
                st = state.view(1);
                rep = ctx.view(1)[0].rep;
                st[0].repeat = rep.view(1)[0].prev;
                repeat_pool_free(state, rep);
                # Evaluate Tail: jump to end of pattern indicated by skip, and
                # then skip the SUCCESS op code that follows it.
                pattern += int(arg(pattern, 0)) + 1;
                position = ptr[u16](st[0].position);
                step = 0;
                continue;

            case 25:
                # Test Exit Condition
                if ret < 0 {
                    return ret;
                }
                if ret == 0 {
                    # Atomic Group failed to Match.
                    set_position(state, position);
                    ret = 0;
                    step = 1;
                    continue;
                }
                # Evaluate Tail: jump to end of pattern indicated by skip, and
                # then skip the SUCCESS op code that follows it.
                pattern += int(arg(pattern, 0));
                position = ptr[u16](state.view(1)[0].position);
                step = 0;
                continue;

            case 21:
                if ret < 0 {
                    return ret;
                }
                if ret == 0 {
                    ret = 0;
                    step = 1;
                    continue;
                }
                pattern += int(arg(pattern, 0));
                step = 0;
                continue;

            case 22:
                if ret != 0 {
                    if has_repeat(state) {
                        mark_pop_discard(state, ctx.view(1)[0].lastmark);
                    }
                    if ret < 0 {
                        return ret;
                    }
                    ret = 0;
                    step = 1;
                    continue;
                }
                if has_repeat(state) {
                    mark_pop(state, ctx.view(1)[0].lastmark, False);
                }
                lastmark_restore(state, ctx);
                pattern += int(arg(pattern, 0));
                step = 0;
                continue;

        }
        # an unknown step
        return SRE_ERROR_STATE;
    }
    return SRE_ERROR_STATE;
}

# LASTMARK_SAVE
def:priv lastmark_save(state: ptr[SreState], ctx: ptr[SreContext]) {
    ctx.view(1)[0].lastmark = state.view(1)[0].lastmark;
    ctx.view(1)[0].lastindex = state.view(1)[0].lastindex;
}

# LASTMARK_RESTORE
def:priv lastmark_restore(state: ptr[SreState], ctx: ptr[SreContext]) {
    state.view(1)[0].lastmark = ctx.view(1)[0].lastmark;
    state.view(1)[0].lastindex = ctx.view(1)[0].lastindex;
}

def:priv has_repeat(state: ptr[SreState]) -> bool {
    return not state.view(1)[0].repeat.is_null();
}

def:priv set_position(state: ptr[SreState], position: ptr[u16]) {
    state.view(1)[0].position = ptr(position);
}

# GROUPREF*: match backreference; the position after the group's text, or
# NULL when it does not match. `fold` is 0 (exact), 1 (ASCII), 2 (Unicode)
# or 3 (locale).
def:priv groupref_matches(
    state: ptr[SreState], pattern: ptr[u32], position: ptr[u16], fold: int
) -> ptr[u16] {
    st = state.view(1);
    groupref = i32(arg(pattern, 0)) * 2;
    if groupref >= st[0].lastmark {
        return ptr[u16]();
    }
    p = ptr[u16]((st[0].mark + int(groupref)).view(1)[0]);
    e = ptr[u16]((st[0].mark + int(groupref + 1)).view(1)[0]);
    if not p or not e or e < p {
        return ptr[u16]();
    }
    end = state_end(state);
    while p < e {
        if position >= end {
            return ptr[u16]();
        }
        a = char_at(position);
        b = char_at(p);
        if fold == 1 {
            a = sre_lower_ascii(a);
            b = sre_lower_ascii(b);
        } elif fold == 2 {
            a = sre_lower_unicode(a);
            b = sre_lower_unicode(b);
        } elif fold == 3 {
            a = sre_lower_locale(a);
            b = sre_lower_locale(b);
        }
        if a != b {
            return ptr[u16]();
        }
        p += 1;
        position += 1;
    }
    return position;
}

# The first `c` in [position, end), or NULL; memchr() for bytes.
def:priv find_char(position: ptr[u16], end: ptr[u16], c: u32) -> ptr[u16] {
    if position >= end {
        return ptr[u16]();
    }
    if SRE_CHAR_SIZE == 1 {
        return ptr[u16](memchr(ptr(position), i32(c), u64(end - position)));
    }
    while position < end {
        if char_at(position) == c {
            return position;
        }
        position += 1;
    }
    return ptr[u16]();
}

# The first `c` in [position, end), or `end`.
def:priv find_char_or_end(position: ptr[u16], end: ptr[u16], c: u32) -> ptr[u16] {
    found = find_char(position, end, c);
    return found or end;
}

# RESET_CAPTURE_GROUP: reset capturing groups between two SRE(match)
# callings in loops
def:priv reset_capture_group(state: ptr[SreState]) {
    st = state.view(1);
    st[0].lastmark = -1;
    st[0].lastindex = -1;
}

# SRE(search): find the first position from the state's start where the
# pattern matches; 1, 0 or <0 as SRE(match).
def sre_search(state: ptr[SreState], pattern: ptr[u32]) -> i64 {
    st = state.view(1);
    position = ptr[u16](st[0].start);
    end = state_end(state);
    status: i64 = 0;
    prefix_len: i64 = 0;
    prefix_skip: i64 = 0;
    prefix = ptr[u32]();
    charset = ptr[u32]();
    overlap = ptr[u32]();
    flags: u32 = 0;
    if position > end {
        return 0;
    }
    if arg(pattern, 0) == SRE_OP_INFO {
        # optimization info block
        # <INFO> <1=skip> <2=flags> <3=min> <4=max> <5=prefix info>
        flags = arg(pattern, 2);
        minimum = arg(pattern, 3);
        if minimum != 0 and end - position < i64(minimum) {
            return 0;
        }
        if minimum > 1 {
            # adjust end point (but make sure we leave at least one
            # character in there, so literal search will work)
            end -= int(minimum) - 1;
            if end <= position {
                end = position;
            }
        }
        if (flags & SRE_INFO_PREFIX) != 0 {
            # pattern starts with a known prefix
            # <length> <skip> <prefix data> <overlap data>
            prefix_len = i64(arg(pattern, 5));
            prefix_skip = i64(arg(pattern, 6));
            prefix = pattern + 7;
            overlap = prefix + (prefix_len - 1);
        } elif (flags & SRE_INFO_CHARSET) != 0 {
            # pattern starts with a character from a known set
            # <charset>
            charset = pattern + 5;
        }
        pattern += 1 + int(arg(pattern, 1));
    }
    if prefix_len == 1 {
        # pattern starts with a literal character
        c = arg(prefix, 0);
        if c > SRE_CHAR_LIMIT {
            # literal can't match: doesn't fit in char width
            return 0;
        }
        end = state_end(state);
        st[0].must_advance = 0;
        while position < end {
            position = find_char(position, end, c);
            if not position {
                return 0;
            }
            st[0].start = ptr(position);
            st[0].position = ptr(position + prefix_skip);
            if (flags & SRE_INFO_LITERAL) != 0 {
                # we got all of it
                return 1;
            }
            status = sre_match(state, pattern + 2 * prefix_skip, i32(0));
            if status != 0 {
                return status;
            }
            position += 1;
            reset_capture_group(state);
        }
        return 0;
    }
    if prefix_len > 1 {
        # pattern starts with a known prefix.  use the overlap table to skip
        # forward as fast as we possibly can
        end = state_end(state);
        if prefix_len > end - position {
            return 0;
        }
        for k in range(prefix_len) {
            if arg(prefix, k) > SRE_CHAR_LIMIT {
                # literal can't match: doesn't fit in char width
                return 0;
            }
        }
        while position < end {
            found_at = find_char(position, end, arg(prefix, 0));
            if not found_at {
                return 0;
            }
            position = found_at + 1;
            if position >= end {
                return 0;
            }
            i: i64 = 1;
            st[0].must_advance = 0;
            while True {
                if char_at(position) == arg(prefix, i) {
                    i += 1;
                    if i != prefix_len {
                        position += 1;
                        if position >= end {
                            return 0;
                        }
                        continue;
                    }
                    # found a potential match
                    st[0].start = ptr(position - (prefix_len - 1));
                    st[0].position = ptr(position - (prefix_len - prefix_skip - 1));
                    if (flags & SRE_INFO_LITERAL) != 0 {
                        # we got all of it
                        return 1;
                    }
                    status = sre_match(state, pattern + 2 * prefix_skip, i32(0));
                    if status != 0 {
                        return status;
                    }
                    # close but no cigar -- try again
                    position += 1;
                    if position >= end {
                        return 0;
                    }
                    reset_capture_group(state);
                }
                i = i64(arg(overlap, i));
                if i == 0 {
                    break;
                }
            }
        }
        return 0;
    }
    if charset {
        # pattern starts with a character from a known set
        end = state_end(state);
        st[0].must_advance = 0;
        while True {
            while position < end and not sre_charset(charset, char_at(position)) {
                position += 1;
            }
            if position >= end {
                return 0;
            }
            st[0].start = ptr(position);
            st[0].position = ptr(position);
            status = sre_match(state, pattern, i32(0));
            if status != 0 {
                break;
            }
            position += 1;
            reset_capture_group(state);
        }
    } else {
        # general case
        st[0].start = ptr(position);
        st[0].position = ptr(position);
        status = sre_match(state, pattern, i32(1));
        st[0].must_advance = 0;
        if status == 0
            and arg(pattern, 0) == SRE_OP_AT
            and (
                arg(pattern, 1) == SRE_AT_BEGINNING
                or arg(pattern, 1) == SRE_AT_BEGINNING_STRING
            ) {
            st[0].start = ptr(end);
            st[0].position = ptr(end);
            return 0;
        }
        while status == 0 and position < end {
            position += 1;
            reset_capture_group(state);
            st[0].start = ptr(position);
            st[0].position = ptr(position);
            status = sre_match(state, pattern, i32(0));
        }
    }
    return status;
}
