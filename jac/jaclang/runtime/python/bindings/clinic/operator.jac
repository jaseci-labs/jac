glob operator_doc: str = "Operator interface.\n\nThis module exports a set of functions implemented in C corresponding\nto the intrinsic operators of Python.  For example, operator.add(x, y)\nis equivalent to the expression x+y.  The function names are those\nused for special methods; variants without leading and trailing\n'__' are also provided for convenience.",
     _operator_call__doc__: str = "call($module, obj, /, *args, **kwargs)\n--\n\nSame as obj(*args, **kwargs).",
     reduce_doc: str = "Return state information for pickling",
     itemgetter_doc: str = "itemgetter(item, /, *items)\n--\n\nReturn a callable object that fetches the given item(s) from its operand.\nAfter f = itemgetter(2), the call f(r) returns r[2].\nAfter g = itemgetter(2, 5, 3), the call g(r) returns (r[2], r[5], r[3])",
     attrgetter_doc: str = "attrgetter(attr, /, *attrs)\n--\n\nReturn a callable object that fetches the given attribute(s) from its operand.\nAfter f = attrgetter('name'), the call f(r) returns r.name.\nAfter g = attrgetter('name', 'date'), the call g(r) returns (r.name, r.date).\nAfter h = attrgetter('name.first', 'name.last'), the call h(r) returns\n(r.name.first, r.name.last).",
     methodcaller_doc: str = "methodcaller(name, /, *args, **kwargs)\n--\n\nReturn a callable object that calls the given method on its operand.\nAfter f = methodcaller('name'), the call f(r) returns r.name().\nAfter g = methodcaller('name', 'date', foo=1), the call g(r) returns\nr.name('date', foo=1).",
     module_methods: list[MethodDefinition] = [
         MethodDefinition(
             "truth",
             MethodCallbacks(positional=_operator_truth_call),
             "truth($module, a, /)\n--\n\nReturn True if a is true, False otherwise.",
             8
         ),
         MethodDefinition(
             "add",
             MethodCallbacks(fast=_operator_add_call),
             "add($module, a, b, /)\n--\n\nSame as a + b.",
             128
         ),
         MethodDefinition(
             "sub",
             MethodCallbacks(fast=_operator_sub_call),
             "sub($module, a, b, /)\n--\n\nSame as a - b.",
             128
         ),
         MethodDefinition(
             "mul",
             MethodCallbacks(fast=_operator_mul_call),
             "mul($module, a, b, /)\n--\n\nSame as a * b.",
             128
         ),
         MethodDefinition(
             "matmul",
             MethodCallbacks(fast=_operator_matmul_call),
             "matmul($module, a, b, /)\n--\n\nSame as a @ b.",
             128
         ),
         MethodDefinition(
             "floordiv",
             MethodCallbacks(fast=_operator_floordiv_call),
             "floordiv($module, a, b, /)\n--\n\nSame as a // b.",
             128
         ),
         MethodDefinition(
             "truediv",
             MethodCallbacks(fast=_operator_truediv_call),
             "truediv($module, a, b, /)\n--\n\nSame as a / b.",
             128
         ),
         MethodDefinition(
             "mod",
             MethodCallbacks(fast=_operator_mod_call),
             "mod($module, a, b, /)\n--\n\nSame as a % b.",
             128
         ),
         MethodDefinition(
             "neg",
             MethodCallbacks(positional=_operator_neg_call),
             "neg($module, a, /)\n--\n\nSame as -a.",
             8
         ),
         MethodDefinition(
             "pos",
             MethodCallbacks(positional=_operator_pos_call),
             "pos($module, a, /)\n--\n\nSame as +a.",
             8
         ),
         MethodDefinition(
             "abs",
             MethodCallbacks(positional=_operator_abs_call),
             "abs($module, a, /)\n--\n\nSame as abs(a).",
             8
         ),
         MethodDefinition(
             "inv",
             MethodCallbacks(positional=_operator_inv_call),
             "inv($module, a, /)\n--\n\nSame as ~a.",
             8
         ),
         MethodDefinition(
             "invert",
             MethodCallbacks(positional=_operator_invert_call),
             "invert($module, a, /)\n--\n\nSame as ~a.",
