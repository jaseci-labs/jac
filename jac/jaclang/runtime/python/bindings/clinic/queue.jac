glob SimpleQueue_doc: str = "SimpleQueue()\n--\n\nSimple, unbounded, reentrant FIFO queue.",
     queue_module_doc: str = "C implementation of the Python queue module.\nThis module is an implementation detail, please do not use it directly.",
     simplequeue_methods___class_getitem___doc: str = "SimpleQueues are generic over the type of their contents",
     SimpleQueue_methods: list[MethodDefinition] = [
         MethodDefinition(
             "put",
             MethodCallbacks(fast_keywords=_queue_SimpleQueue_put_call),
             "put($self, /, item, block=True, timeout=None)\n--\n\nPut the item on the queue.\n\nThe optional 'block' and 'timeout' arguments are ignored, as this\nmethod never blocks.  They are provided for compatibility with the\nQueue class.",
             130
         ),
         MethodDefinition(
             "put_nowait",
             MethodCallbacks(fast_keywords=_queue_SimpleQueue_put_nowait_call),
             "put_nowait($self, /, item)\n--\n\nPut an item into the queue without blocking.\n\nThis is exactly equivalent to `put(item)` and is only provided\nfor compatibility with the Queue class.",
             130
         ),
         MethodDefinition(
             "get",
             MethodCallbacks(fast_keywords=_queue_SimpleQueue_get_call),
             "get($self, /, block=True, timeout=None)\n--\n\nRemove and return an item from the queue.\n\nIf optional args 'block' is true and 'timeout' is None (the\ndefault), block if necessary until an item is available.  If\n'timeout' is a non-negative number, it blocks at most 'timeout'\nseconds and raises the Empty exception if no item was available\nwithin that time.\nOtherwise ('block' is false), return an item if one is immediately\navailable, else raise the Empty exception ('timeout' is ignored\nin that case).",
             130
         ),
         MethodDefinition(
             "get_nowait",
             MethodCallbacks(fast_keywords=_queue_SimpleQueue_get_nowait_call),
             "get_nowait($self, /)\n--\n\nRemove and return an item from the queue without blocking.\n\nOnly get an item if one is immediately available. Otherwise\nraise the Empty exception.",
             130
         ),
         MethodDefinition(
             "empty",
             MethodCallbacks(positional=_queue_SimpleQueue_empty_call),
             "empty($self, /)\n--\n\nReturn True if the queue is empty, False otherwise (not reliable!).",
             4
         ),
         MethodDefinition(
             "qsize",
             MethodCallbacks(positional=_queue_SimpleQueue_qsize_call),
             "qsize($self, /)\n--\n\nReturn the approximate size of the queue (not reliable!).",
             4
         ),

     ];
