glob math_log_doc: str = "log(x, [base=math.e])\nReturn the logarithm of x to the given base.\n\nIf the base is not specified, returns the natural logarithm (base e) of x.",
     module_doc: str = "This module provides access to the mathematical functions\ndefined by the C standard.",
     math_asinh_doc: str = "asinh($module, x, /)\n--\n\nReturn the inverse hyperbolic sine of x.",
     math_atan_doc: str = "atan($module, x, /)\n--\n\nReturn the arc tangent (measured in radians) of x.\n\nThe result is between -pi/2 and pi/2.",
     math_cbrt_doc: str = "cbrt($module, x, /)\n--\n\nReturn the cube root of x.",
     math_cosh_doc: str = "cosh($module, x, /)\n--\n\nReturn the hyperbolic cosine of x.",
     math_exp_doc: str = "exp($module, x, /)\n--\n\nReturn e raised to the power of x.",
     math_exp2_doc: str = "exp2($module, x, /)\n--\n\nReturn 2 raised to the power of x.",
     math_expm1_doc: str = "expm1($module, x, /)\n--\n\nReturn exp(x)-1.\n\nThis function avoids the loss of precision involved in the direct evaluation of exp(x)-1 for small x.",
     math_fabs_doc: str = "fabs($module, x, /)\n--\n\nReturn the absolute value of the float x.",
     math_sinh_doc: str = "sinh($module, x, /)\n--\n\nReturn the hyperbolic sine of x.",
     math_tanh_doc: str = "tanh($module, x, /)\n--\n\nReturn the hyperbolic tangent of x.",
     math_acos_doc: str = "acos($module, x, /)\n--\n\nReturn the arc cosine (measured in radians) of x.\n\nThe result is between 0 and pi.",
     math_acosh_doc: str = "acosh($module, x, /)\n--\n\nReturn the inverse hyperbolic cosine of x.",
     math_asin_doc: str = "asin($module, x, /)\n--\n\nReturn the arc sine (measured in radians) of x.\n\nThe result is between -pi/2 and pi/2.",
     math_atanh_doc: str = "atanh($module, x, /)\n--\n\nReturn the inverse hyperbolic tangent of x.",
     math_cos_doc: str = "cos($module, x, /)\n--\n\nReturn the cosine of x (measured in radians).",
     math_log1p_doc: str = "log1p($module, x, /)\n--\n\nReturn the natural logarithm of 1+x (base e).\n\nThe result is computed in a way which is accurate for x near zero.",
     math_sin_doc: str = "sin($module, x, /)\n--\n\nReturn the sine of x (measured in radians).",
     math_sqrt_doc: str = "sqrt($module, x, /)\n--\n\nReturn the square root of x.",
     math_tan_doc: str = "tan($module, x, /)\n--\n\nReturn the tangent of x (measured in radians).",
     math_erf_doc: str = "erf($module, x, /)\n--\n\nError function at x.",
     math_erfc_doc: str = "erfc($module, x, /)\n--\n\nComplementary error function at x.",
     math_gamma_doc: str = "gamma($module, x, /)\n--\n\nGamma function at x.",
     math_lgamma_doc: str = "lgamma($module, x, /)\n--\n\nNatural logarithm of absolute value of Gamma function at x.",
     math_atan2_doc: str = "atan2($module, y, x, /)\n--\n\nReturn the arc tangent (measured in radians) of y/x.\n\nUnlike atan(y/x), the signs of both x and y are considered.",
     math_copysign_doc: str = "copysign($module, x, y, /)\n--\n\nReturn a float with the magnitude (absolute value) of x but the sign of y.\n\nOn platforms that support signed zeros, copysign(1.0, -0.0)\nreturns -1.0.\n",
     math_remainder_doc: str = "remainder($module, x, y, /)\n--\n\nDifference between x and the closest integer multiple of y.\n\nReturn x - n*y where n*y is the closest integer multiple of y.\nIn the case where x is exactly halfway between two multiples of\ny, the nearest even value of n is used. The result is always exact.",
     module_methods: list[MethodDefinition] = [
         MethodDefinition(
             "gcd",
             MethodCallbacks(fast=math_gcd_call),
             "gcd($module, /, *integers)\n--\n\nGreatest Common Divisor.",
             128
         ),
         MethodDefinition(
             "lcm",
             MethodCallbacks(fast=math_lcm_call),
             "lcm($module, /, *integers)\n--\n\nLeast Common Multiple.",
             128
         ),
         MethodDefinition(
             "ceil",
             MethodCallbacks(positional=math_ceil_call),
             "ceil($module, x, /)\n--\n\nReturn the ceiling of x as an Integral.\n\nThis is the smallest integer >= x.",
             8
         ),
         MethodDefinition(
             "floor",
             MethodCallbacks(positional=math_floor_call),
             "floor($module, x, /)\n--\n\nReturn the floor of x as an Integral.\n\nThis is the largest integer <= x.",
             8
         ),
         MethodDefinition(
             "fsum",
             MethodCallbacks(positional=math_fsum_call),
             "fsum($module, seq, /)\n--\n\nReturn an accurate floating-point sum of values in the iterable seq.\n\nAssumes IEEE-754 floating-point arithmetic.",
             8
         ),
         MethodDefinition(
             "isqrt",
             MethodCallbacks(positional=math_isqrt_call),
             "isqrt($module, n, /)\n--\n\nReturn the integer part of the square root of the input.",
             8
         ),
         MethodDefinition(
             "factorial",
             MethodCallbacks(positional=math_factorial_call),
             "factorial($module, n, /)\n--\n\nFind n!.",
             8
         ),
         MethodDefinition(
             "trunc",
             MethodCallbacks(positional=math_trunc_call),
             "trunc($module, x, /)\n--\n\nTruncates the Real x to the nearest Integral toward 0.\n\nUses the __trunc__ magic method.",
             8
         ),
         MethodDefinition(
             "frexp",
             MethodCallbacks(positional=math_frexp_call),
             "frexp($module, x, /)\n--\n\nReturn the mantissa and exponent of x, as pair (m, e).\n\nIf x is a finite nonzero number, then m is a float with\n0.5 <= abs(m) < 1.0 and an integer e is such that\nx == m * 2**e exactly.  Else, return (x, 0).",
             8
         ),
         MethodDefinition(
             "ldexp",
             MethodCallbacks(fast=math_ldexp_call),
             "ldexp($module, x, i, /)\n--\n\nReturn x * (2**i).\n\nThis is essentially the inverse of frexp().",
             128
         ),
         MethodDefinition(
             "modf",
             MethodCallbacks(positional=math_modf_call),
             "modf($module, x, /)\n--\n\nReturn the fractional and integer parts of x.\n\nBoth results carry the sign of x and are floats.",
             8
         ),
         MethodDefinition(
             "log2",
             MethodCallbacks(positional=math_log2_call),
             "log2($module, x, /)\n--\n\nReturn the base 2 logarithm of x.",
             8
         ),
         MethodDefinition(
