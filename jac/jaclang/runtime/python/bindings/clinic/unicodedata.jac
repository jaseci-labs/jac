glob unicodedata_docstring: str = "This module provides access to the Unicode Character Database which\ndefines character properties for all Unicode characters. The data in\nthis database is based on the UnicodeData.txt file version\n which is publicly available from ftp://ftp.unicode.org/.\n\nThe module uses the same names and symbols as defined by the\nUnicodeData File Format .",
     UCD_methods: list[MethodDefinition] = [
         MethodDefinition(
             "decimal",
             MethodCallbacks(fast=unicodedata_UCD_decimal_call),
             "decimal($self, chr, default=<unrepresentable>, /)\n--\n\nConverts a Unicode character into its equivalent decimal value.\n\nReturns the decimal value assigned to the character chr as integer.\nIf no such value is defined, default is returned, or, if not given,\nValueError is raised.",
             128
         ),
         MethodDefinition(
             "digit",
             MethodCallbacks(fast=unicodedata_UCD_digit_call),
             "digit($self, chr, default=<unrepresentable>, /)\n--\n\nConverts a Unicode character into its equivalent digit value.\n\nReturns the digit value assigned to the character chr as integer.\nIf no such value is defined, default is returned, or, if not given,\nValueError is raised.",
             128
         ),
         MethodDefinition(
             "numeric",
             MethodCallbacks(fast=unicodedata_UCD_numeric_call),
             "numeric($self, chr, default=<unrepresentable>, /)\n--\n\nConverts a Unicode character into its equivalent numeric value.\n\nReturns the numeric value assigned to the character chr as float.\nIf no such value is defined, default is returned, or, if not given,\nValueError is raised.",
             128
         ),
         MethodDefinition(
             "category",
             MethodCallbacks(positional=unicodedata_UCD_category_call),
             "category($self, chr, /)\n--\n\nReturns the general category assigned to the character chr as string.",
             8
         ),
         MethodDefinition(
             "bidirectional",
             MethodCallbacks(positional=unicodedata_UCD_bidirectional_call),
             "bidirectional($self, chr, /)\n--\n\nReturns the bidirectional class assigned to the character chr as string.\n\nIf no such value is defined, an empty string is returned.",
             8
         ),
         MethodDefinition(
             "combining",
             MethodCallbacks(positional=unicodedata_UCD_combining_call),
             "combining($self, chr, /)\n--\n\nReturns the canonical combining class assigned to the character chr as integer.\n\nReturns 0 if no combining class is defined.",
             8
         ),
         MethodDefinition(
             "mirrored",
             MethodCallbacks(positional=unicodedata_UCD_mirrored_call),
             "mirrored($self, chr, /)\n--\n\nReturns the mirrored property assigned to the character chr as integer.\n\nReturns 1 if the character has been identified as a \"mirrored\"\ncharacter in bidirectional text, 0 otherwise.",
             8
         ),
         MethodDefinition(
             "east_asian_width",
             MethodCallbacks(positional=unicodedata_UCD_east_asian_width_call),
             "east_asian_width($self, chr, /)\n--\n\nReturns the east asian width assigned to the character chr as string.",
             8
         ),
         MethodDefinition(
             "decomposition",
             MethodCallbacks(positional=unicodedata_UCD_decomposition_call),
             "decomposition($self, chr, /)\n--\n\nReturns the character decomposition mapping assigned to the character chr as string.\n\nAn empty string is returned in case no such mapping is defined.",
             8
         ),
         MethodDefinition(
             "is_normalized",
             MethodCallbacks(fast=unicodedata_UCD_is_normalized_call),
             "is_normalized($self, form, unistr, /)\n--\n\nReturn whether the Unicode string unistr is in the normal form 'form'.\n\nValid values for form are 'NFC', 'NFKC', 'NFD', and 'NFKD'.",
             128
         ),
         MethodDefinition(
             "normalize",
             MethodCallbacks(fast=unicodedata_UCD_normalize_call),
             "normalize($self, form, unistr, /)\n--\n\nReturn the normal form 'form' for the Unicode string unistr.\n\nValid values for form are 'NFC', 'NFKC', 'NFD', and 'NFKD'.",
             128
         ),
         MethodDefinition(
             "name",
             MethodCallbacks(fast=unicodedata_UCD_name_call),
             "name($self, chr, default=<unrepresentable>, /)\n--\n\nReturns the name assigned to the character chr as a string.\n\nIf no name is defined, default is returned, or, if not given,\nValueError is raised.",
             128
         ),
         MethodDefinition(
             "lookup",
             MethodCallbacks(positional=unicodedata_UCD_lookup_call),
             "lookup($self, name, /)\n--\n\nLook up character by name.\n\nIf a character with the given name is found, return the\ncorresponding character.  If not found, KeyError is raised.",
             8
         ),

     ];
