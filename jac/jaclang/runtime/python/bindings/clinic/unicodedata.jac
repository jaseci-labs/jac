             "decimal",
             MethodCallbacks(keywords=unicodedata_UCD_decimal_call),
             "decimal($self, chr, default=<unrepresentable>, /)\n--\n\nConverts a Unicode character into its equivalent decimal value.\n\nReturns the decimal value assigned to the character chr as integer.\nIf no such value is defined, default is returned, or, if not given,\nValueError is raised.",
             3
         ),
         MethodDefinition(
             "digit",
             MethodCallbacks(keywords=unicodedata_UCD_digit_call),
             "digit($self, chr, default=<unrepresentable>, /)\n--\n\nConverts a Unicode character into its equivalent digit value.\n\nReturns the digit value assigned to the character chr as integer.\nIf no such value is defined, default is returned, or, if not given,\nValueError is raised.",
             3
         ),
         MethodDefinition(
             "numeric",
             MethodCallbacks(keywords=unicodedata_UCD_numeric_call),
             "numeric($self, chr, default=<unrepresentable>, /)\n--\n\nConverts a Unicode character into its equivalent numeric value.\n\nReturns the numeric value assigned to the character chr as float.\nIf no such value is defined, default is returned, or, if not given,\nValueError is raised.",
             3
         ),
         MethodDefinition(
             "category",
             MethodCallbacks(keywords=unicodedata_UCD_category_call),
             "category($self, chr, /)\n--\n\nReturns the general category assigned to the character chr as string.",
             3
         ),
         MethodDefinition(
             "bidirectional",
             MethodCallbacks(keywords=unicodedata_UCD_bidirectional_call),
             "bidirectional($self, chr, /)\n--\n\nReturns the bidirectional class assigned to the character chr as string.\n\nIf no such value is defined, an empty string is returned.",
             3
         ),
         MethodDefinition(
             "combining",
             MethodCallbacks(keywords=unicodedata_UCD_combining_call),
             "combining($self, chr, /)\n--\n\nReturns the canonical combining class assigned to the character chr as integer.\n\nReturns 0 if no combining class is defined.",
             3
         ),
         MethodDefinition(
             "mirrored",
             MethodCallbacks(keywords=unicodedata_UCD_mirrored_call),
             "mirrored($self, chr, /)\n--\n\nReturns the mirrored property assigned to the character chr as integer.\n\nReturns 1 if the character has been identified as a \"mirrored\"\ncharacter in bidirectional text, 0 otherwise.",
             3
         ),
         MethodDefinition(
             "east_asian_width",
             MethodCallbacks(keywords=unicodedata_UCD_east_asian_width_call),
             "east_asian_width($self, chr, /)\n--\n\nReturns the east asian width assigned to the character chr as string.",
             3
         ),
         MethodDefinition(
             "decomposition",
             MethodCallbacks(keywords=unicodedata_UCD_decomposition_call),
             "decomposition($self, chr, /)\n--\n\nReturns the character decomposition mapping assigned to the character chr as string.\n\nAn empty string is returned in case no such mapping is defined.",
             3
         ),
