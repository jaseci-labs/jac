def:pub _default_common_ext -> list[str] {
    e: list[str] = [];
    e.append(".rtf");
    e.append(".apk");
    e.append(".midi");
    e.append(".mid");
    e.append(".jpg");
    e.append(".pict");
    e.append(".pct");
    e.append(".pic");
    e.append(".xul");
    return e;
}


