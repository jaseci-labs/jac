def:pub _default_knownfiles -> list[str] {
    f: list[str] = [];
    f.append("/etc/mime.types");
    f.append("/etc/httpd/mime.types");
    f.append("/etc/httpd/conf/mime.types");
    f.append("/etc/apache/mime.types");
    f.append("/etc/apache2/mime.types");
    f.append("/usr/local/etc/httpd/conf/mime.types");
    f.append("/usr/local/lib/netscape/mime.types");
    f.append("/usr/local/etc/httpd/conf/mime.types");
    f.append("/usr/local/etc/mime.types");
    return f;
}


def:pub _default_suffix_map -> dict[str, str] {
    d: dict[str, str] = {};
    d[".svgz"] = ".svg.gz";
    d[".tgz"] = ".tar.gz";
    d[".taz"] = ".tar.gz";
    d[".tz"] = ".tar.gz";
    d[".tbz2"] = ".tar.bz2";
    d[".txz"] = ".tar.xz";
    return d;
}


def:pub _default_encodings_map -> dict[str, str] {
    d: dict[str, str] = {};
    d[".gz"] = "gzip";
    d[".Z"] = "compress";
    d[".bz2"] = "bzip2";
    d[".xz"] = "xz";
    d[".br"] = "br";
    return d;
}


