impl m_acos(x: float) -> float {
    return acos(f64(x));
}

impl m_acosh(x: float) -> float {
    return acosh(f64(x));
}

impl m_asin(x: float) -> float {
    return asin(f64(x));
}

impl m_asinh(x: float) -> float {
    return asinh(f64(x));
}

impl m_atan(x: float) -> float {
    return atan(f64(x));
}

impl m_atanh(x: float) -> float {
    return atanh(f64(x));
}

impl m_atan2(y: float, x: float) -> float {
    return atan2(f64(y), f64(x));
}

impl m_cbrt(x: float) -> float {
    return cbrt(f64(x));
}

impl m_ceil(x: float) -> float {
    return ceil(f64(x));
}

impl m_copysign(x: float, y: float) -> float {
    return copysign(f64(x), f64(y));
}

impl m_cos(x: float) -> float {
    return cos(f64(x));
}

impl m_cosh(x: float) -> float {
    return cosh(f64(x));
}

impl m_erf(x: float) -> float {
    return erf(f64(x));
}

impl m_erfc(x: float) -> float {
    return erfc(f64(x));
}

impl m_exp(x: float) -> float {
    return exp(f64(x));
}

impl m_exp2(x: float) -> float {
    return exp2(f64(x));
}

impl m_expm1(x: float) -> float {
    return expm1(f64(x));
}

impl m_fabs(x: float) -> float {
    return fabs(f64(x));
}

impl m_floor(x: float) -> float {
    return floor(f64(x));
}

impl m_fma(x: float, y: float, z: float) -> float {
    return fma(f64(x), f64(y), f64(z));
}

impl m_fmod(x: float, y: float) -> float {
    return fmod(f64(x), f64(y));
}

impl m_hypot(x: float, y: float) -> float {
    return hypot(f64(x), f64(y));
}

impl m_lgamma(x: float) -> float {
    return lgamma(f64(x));
}

impl m_log(x: float) -> float {
    return log(f64(x));
}

impl m_log2(x: float) -> float {
    return log2(f64(x));
}

impl m_log10(x: float) -> float {
    return log10(f64(x));
}

impl m_log1p(x: float) -> float {
    return log1p(f64(x));
}

impl m_pow(x: float, y: float) -> float {
    return pow(f64(x), f64(y));
}

impl m_remainder(x: float, y: float) -> float {
    return remainder(f64(x), f64(y));
}

impl m_sin(x: float) -> float {
    return sin(f64(x));
}

impl m_sinh(x: float) -> float {
    return sinh(f64(x));
}

impl m_sqrt(x: float) -> float {
    return sqrt(f64(x));
}

impl m_tan(x: float) -> float {
    return tan(f64(x));
}

impl m_tanh(x: float) -> float {
    return tanh(f64(x));
}

impl m_tgamma(x: float) -> float {
    return tgamma(f64(x));
}

impl m_trunc(x: float) -> float {
    return trunc(f64(x));
}
