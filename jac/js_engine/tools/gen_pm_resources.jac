"""Generate engine/src/pm/resources_gen.jac from the package manager's text
resources, so the engine binary carries them and reads no files at run time:

    engine/src/pm/help/<name>.txt        help output (bun's, verbatim)
    engine/src/pm/data/default-trusted.txt  bun's default trusted dependencies

The .txt files stay the source of truth; rerun this after editing one and
commit the regenerated module. Run from js_engine/:

    jac tools/gen_pm_resources.jac [OUT]   (default engine/src/pm/resources_gen.jac)

Each text becomes "".join([...]) of one literal per line, so the module
round-trips byte for byte and a changed line is a one-line diff.
"""
import sys;
import from pathlib { Path }

glob PM_DIR = Path("engine/src/pm"),
     DEFAULT_OUT = "engine/src/pm/resources_gen.jac";

"""`chunk` (no newline inside) as a Jac string literal. Only backslash, quote
and tab need escaping; any other control character (CR included: Jac native
literals mishandle \\r) is rejected rather than guessed at."""
def jac_literal(chunk: str, origin: str) -> str {
    out: list[str] = [];
    for ch in chunk {
        if ch == "\\" {
            out.append("\\\\");
        } elif ch == "\"" {
            out.append("\\\"");
        } elif ch == "\t" {
            out.append("\\t");
        } elif ord(ch) < 32 or ord(ch) == 127 {
            raise SystemExit(f"{origin}: unsupported control character {ord(ch)!r}");
        } else {
            out.append(ch);
        }
    }
    return "\"" + "".join(out) + "\"";
}

"""`text` as a Jac expression, one literal per line (newline kept with it)."""
def jac_text_expr(text: str, origin: str, indent: str) -> str {
    if text == "" {
        return "\"\"";
    }
    parts: list[str] = [];
    lines = text.split("\n");
    for (i, line) in enumerate(lines) {
        last = i == len(lines) - 1;
        if last and line == "" {
            break;
        }
        lit = jac_literal(line, origin);
        if not last {
            lit = lit[:-1] + "\\n\"";
        }
        parts.append(indent + "    " + lit);
    }
    return "\"\".join([\n" + ",\n".join(parts) + "\n" + indent + "])";
}

def read_text(path: Path) -> str {
    return path.read_bytes().decode("utf-8");
}

def render -> str {
    help_files = sorted((PM_DIR / "help").glob("*.txt"));
    if not help_files {
        raise SystemExit(f"no help texts under {PM_DIR / 'help'}");
    }
    trusted = PM_DIR / "data" / "default-trusted.txt";
    out: list[str] = [
        "\"\"\"GENERATED by tools/gen_pm_resources.jac — do not edit. The package",
        "manager's help texts and default trusted list, compiled into the binary so",
        "it needs no resource files next to it. Source of truth: engine/src/pm/help/",
        "*.txt and engine/src/pm/data/default-trusted.txt; edit those and run `make`",
        "(or `jac tools/gen_pm_resources.jac`).\"\"\"",
        "",
        "\"\"\"Help text help/<name>.txt, or the empty string when there is none.\"\"\"",
        "def:pub pm_help_resource(name: str) -> str {"
    ];
    for f in help_files {
        name = f.stem;
        out.append(f"    if name == {jac_literal(name, str(f))} {{");
        out.append(
            "        return "
            + jac_text_expr(read_text(f), str(f), "        ")
            + ";"
        );
        out.append("    }");
    }
    out.append("    return \"\";");
    out.append("}");
    out.append("");
    out.append("\"\"\"data/default-trusted.txt: one package name per line, # comments.\"\"\"");
    out.append("def:pub pm_default_trusted_resource -> str {");
    out.append("    return " + jac_text_expr(read_text(trusted), str(trusted), "    ") + ";");
    out.append("}");
    return "\n".join(out) + "\n";
}

with entry:__main__ {
    target = Path(sys.argv[1] if len(sys.argv) > 1 else DEFAULT_OUT);
    text = render();
    if not target.exists() or target.read_text(encoding="utf-8") != text {
        target.write_text(text, encoding="utf-8");
        print(f"gen_pm_resources: wrote {target}");
    } else {
        print(f"gen_pm_resources: {target} up to date");
    }
}
