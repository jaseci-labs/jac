+/* Development dispatch to Jac's Python compiler; no fallback once enabled. */
+#ifndef Py_JAC_COMPILE_H
+#define Py_JAC_COMPILE_H
+
+static int
+jac_compiler_enabled(void)
+{
+    PyObject *compiler = PySys_GetObject("_jacpython_compile");
+    return compiler != NULL && compiler != Py_None;
+}
+
+static PyObject *
+jac_compile_object(PyObject *source, PyObject *filename, int start,
+                   PyCompilerFlags *flags, int optimize)
+{
+    PyObject *compiler = PySys_GetObject("_jacpython_compile");
+    if (compiler == NULL || compiler == Py_None) {
+        PyErr_SetString(PyExc_RuntimeError, "JacPython compiler is not installed");
+        return NULL;
+    }
+    Py_INCREF(compiler);
+    const char *mode;
+    switch (start) {
+        case Py_file_input: mode = "exec"; break;
+        case Py_eval_input: mode = "eval"; break;
+        case Py_single_input: mode = "single"; break;
+        case Py_func_type_input: mode = "func_type"; break;
+        default:
+            Py_DECREF(compiler);
+            PyErr_SetString(PyExc_ValueError, "invalid compilation mode");
+            return NULL;
+    }
+    if (PySys_Audit("compile", "OO", source, filename) < 0) {
+        Py_DECREF(compiler);
+        return NULL;
+    }
+    int options = flags ? flags->cf_flags : 0;
+    options &= ~(PyCF_SOURCE_IS_UTF8 | PyCF_IGNORE_COOKIE);
+    PyObject *call_args = Py_BuildValue("(OOsiii)", source, filename,
+                                        mode, options, 1, optimize);
+    PyObject *kwargs = call_args == NULL ? NULL : Py_BuildValue(
+        "{s:i}", "_feature_version", flags ? flags->cf_feature_version : -1);
+    PyObject *result = NULL;
+    if (kwargs != NULL) {
+        result = PyObject_Call(compiler, call_args, kwargs);
+    }
+    Py_XDECREF(call_args);
+    Py_XDECREF(kwargs);
+    Py_DECREF(compiler);
+    if (result == NULL) {
+        return NULL;
+    }
+    if (!(options & PyCF_ONLY_AST) && !PyCode_Check(result)) {
+        Py_DECREF(result);
+        PyErr_SetString(PyExc_TypeError, "JacPython compiler must return a code object");
+        return NULL;
+    }
+    if (flags && PyCode_Check(result)) {
+        flags->cf_flags |= ((PyCodeObject *)result)->co_flags & PyCF_MASK;
+    }
+    return result;
+}
+
+static PyObject *
+jac_compile_string(const char *str, PyObject *filename, int start,
+                   PyCompilerFlags *flags, int optimize)
+{
+    PyObject *source;
+    if (flags && (flags->cf_flags & PyCF_IGNORE_COOKIE)) {
+        source = PyUnicode_FromString(str);
+    }
+    else {
+        source = PyBytes_FromString(str);
+    }
+    if (source == NULL) {
+        return NULL;
+    }
+    PyObject *result = jac_compile_object(source, filename, start, flags, optimize);
+    Py_DECREF(source);
+    return result;
+}
+
+static PyObject *
+jac_compile_file(FILE *fp, PyObject *filename, int start,
+                 PyCompilerFlags *flags)
+{
+    PyObject *source = PyByteArray_FromStringAndSize(NULL, 0);
+    if (source == NULL) {
+        return NULL;
+    }
+    char buffer[8192];
+    size_t count;
+    while ((count = fread(buffer, 1, sizeof(buffer), fp)) != 0) {
+        Py_ssize_t previous = PyByteArray_GET_SIZE(source);
+        if (previous > PY_SSIZE_T_MAX - (Py_ssize_t)count ||
+            PyByteArray_Resize(source, previous + (Py_ssize_t)count) < 0) {
+            Py_DECREF(source);
+            if (!PyErr_Occurred()) PyErr_NoMemory();
+            return NULL;
+        }
+        memcpy(PyByteArray_AS_STRING(source) + previous, buffer, count);
+    }
+    if (ferror(fp)) {
+        Py_DECREF(source);
+        return PyErr_SetFromErrno(PyExc_OSError);
+    }
+    PyObject *result = jac_compile_object(source, filename, start, flags, -1);
+    Py_DECREF(source);
+    return result;
+}
+#endif
