+/* Preserve locals-plus layout when restoring inlined comprehension names.
+   PyCode_New's public tuple interface merges cells and locals by name; it
+   cannot represent hidden locals or duplicate names in distinct slots. */
+static PyObject *
+sys_jacpython_code(PyObject *self, PyObject *args)
+{
+    PyCodeObject *prototype;
+    PyObject *metadata;
+    if (!PyArg_ParseTuple(args, "O!O!:_jacpython_code",
+                          &PyCode_Type, &prototype, &PyDict_Type, &metadata)) {
+        return NULL;
+    }
+    Py_ssize_t count = prototype->co_nlocalsplus;
+    PyObject *names = PyTuple_New(count);
+    PyObject *kinds = PyBytes_FromStringAndSize(
+        PyBytes_AS_STRING(prototype->co_localspluskinds), count);
+    PyObject *code = PyCode_GetCode(prototype);
+    if (names == NULL || kinds == NULL || code == NULL) goto error;
+    for (Py_ssize_t i = 0; i < count; i++) {
+        PyObject *name = PyTuple_GET_ITEM(prototype->co_localsplusnames, i);
+        PyObject *entry = PyDict_GetItemWithError(metadata, name);
+        if (entry == NULL && PyErr_Occurred()) goto error;
+        if (entry != NULL) {
+            if (!PyTuple_Check(entry) || PyTuple_GET_SIZE(entry) != 2 ||
+                !PyUnicode_Check(PyTuple_GET_ITEM(entry, 0))) {
+                PyErr_SetString(PyExc_TypeError, "invalid JacPython local metadata");
+                goto error;
+            }
+            name = PyTuple_GET_ITEM(entry, 0);
+            int hidden = PyObject_IsTrue(PyTuple_GET_ITEM(entry, 1));
+            if (hidden < 0) goto error;
+            if (hidden) {
+                _PyLocals_Kind kind = _PyLocals_GetKind(kinds, i);
+                if (!(kind & CO_FAST_LOCAL)) {
+                    PyErr_SetString(PyExc_ValueError, "only local slots can be hidden");
+                    goto error;
+                }
+                _PyLocals_SetKind(kinds, i, kind | CO_FAST_HIDDEN);
+            }
+        }
+        PyTuple_SET_ITEM(names, i, Py_NewRef(name));
+    }
+    struct _PyCodeConstructor con = {
+        .filename = prototype->co_filename,
+        .name = prototype->co_name,
+        .qualname = prototype->co_qualname,
+        .flags = prototype->co_flags,
+        .code = code,
+        .firstlineno = prototype->co_firstlineno,
+        .linetable = prototype->co_linetable,
+        .consts = prototype->co_consts,
+        .names = prototype->co_names,
+        .localsplusnames = names,
+        .localspluskinds = kinds,
+        .argcount = prototype->co_argcount,
+        .posonlyargcount = prototype->co_posonlyargcount,
+        .kwonlyargcount = prototype->co_kwonlyargcount,
+        .stacksize = prototype->co_stacksize,
+        .exceptiontable = prototype->co_exceptiontable,
+    };
+    if (_PyCode_Validate(&con) < 0) goto error;
+    PyObject *result = (PyObject *)_PyCode_New(&con);
+    Py_DECREF(names);
+    Py_DECREF(kinds);
+    Py_DECREF(code);
+    return result;
+error:
+    Py_XDECREF(names);
+    Py_XDECREF(kinds);
+    Py_XDECREF(code);
+    return NULL;
+}
+
 static PyMethodDef sys_methods[] = {
+    {"_jacpython_code", sys_jacpython_code, METH_VARARGS,
+     "Construct code with JacPython local-variable metadata."},
