+# Compiler/parser objects are supplied by native Jac and retained-runtime ABI adapters.
+Python/jac_compile.o: $(srcdir)/Python/jac_compile.c $(srcdir)/Python/jac_compile.h
+Python/jac_runtime.o: $(srcdir)/Python/jac_runtime.c
+# jac_objects.c holds the C side of Modules/getpath.c: the frozen getpath.py and
+# the configured install locations.
+Python/jac_objects.o: $(srcdir)/Python/jac_objects.c Python/frozen_modules/getpath.h Makefile $(PYTHON_HEADERS)
+	$(CC) -c $(PY_CORE_CFLAGS) -DPYTHONPATH='"$(PYTHONPATH)"' \
