Detach upstream's build graph from sources no Jac build retains.

cpython-sources.txt is the single authority on which CPython files exist in
the extracted tree. Upstream's makefile still names a few of them as ordinary
prerequisites, which turns "stop shipping this file" into a build failure
rather than a smaller tree. Each hunk here removes one such reference so the
manifest alone decides.

Marked exclusions ("# path  # removed:") are a separate mechanism: those files
are restored for the build-only host, and compiler-bridge.patch detaches them
from the graph for the reduced runtime only. Pruned entries ("# pruned:") are
absent from both builds, so this patch applies unconditionally, and second:
compiler-bridge.patch carries zero-context hunks that match on line number
alone, so it has to see pristine ones. The hunks below keep three lines of
context and survive the offsets that leaves.

build_all: gdbhooks copies Tools/gdb/libpython.py next to the interpreter for
test_gdb, and Programs/_testembed is an embedding test program. Neither is
installed, and no test suite is copied into the runtime.

altmaninstall/maninstall: the manual page lands under $(MANDIR), inside the
share tree that build.sh discards after install. It was written and deleted.

libinstall: Modules/xxmodule.c is a sample extension, named as a prerequisite
and never read by the recipe.

MODULE__SSL_DEPS: _ssl.c includes exactly one generated error table, chosen by
OpenSSL version. sources.json pins OpenSSL 3.5.8, so _ssl_data_35.h is the
only one compiled; the 1.1.1 and 3.0 tables survive as prerequisites alone.

--- a/Makefile.pre.in
+++ b/Makefile.pre.in
@@ -799,7 +799,7 @@
 
 .PHONY: build_all
 build_all:	check-clean-src check-app-store-compliance $(BUILDPYTHON) platform sharedmods \
-		gdbhooks Programs/_testembed scripts checksharedmods rundsymutil build-details.json
+		scripts checksharedmods rundsymutil build-details.json
 
 .PHONY: build_wasm
 build_wasm: check-clean-src $(BUILDPYTHON) platform sharedmods \
@@ -2536,14 +2536,10 @@
 		else	true; \
 		fi; \
 	done
-	$(INSTALL_DATA) $(srcdir)/Misc/python.man \
-		$(DESTDIR)$(MANDIR)/man1/python$(VERSION).1
 
 # Install the unversioned manual page
 .PHONY: maninstall
 maninstall:	altmaninstall
-	-rm -f $(DESTDIR)$(MANDIR)/man1/python3.1
-	(cd $(DESTDIR)$(MANDIR)/man1; $(LN) -s python$(VERSION).1 python3.1)
 
 # Install the library
 XMLLIBSUBDIRS=  xml xml/dom xml/etree xml/parsers xml/sax
@@ -2736,7 +2732,7 @@
 TEST_MODULES=@TEST_MODULES@
 
 .PHONY: libinstall
-libinstall:	all $(srcdir)/Modules/xxmodule.c
+libinstall:	all
 	@for i in $(SCRIPTDIR) $(LIBDEST); \
 	do \
 		if test ! -d $(DESTDIR)$$i; then \
@@ -3400,7 +3396,7 @@
 MODULE__HMAC_LDEPS=$(LIBHACL_HMAC_LIB_@LIBHACL_LDEPS_LIBTYPE@)
 
 MODULE__SOCKET_DEPS=$(srcdir)/Modules/socketmodule.h $(srcdir)/Modules/addrinfo.h $(srcdir)/Modules/getaddrinfo.c $(srcdir)/Modules/getnameinfo.c
-MODULE__SSL_DEPS=$(srcdir)/Modules/_ssl.h $(srcdir)/Modules/_ssl/cert.c $(srcdir)/Modules/_ssl/debughelpers.c $(srcdir)/Modules/_ssl/misc.c $(srcdir)/Modules/_ssl_data_111.h $(srcdir)/Modules/_ssl_data_300.h $(srcdir)/Modules/socketmodule.h
+MODULE__SSL_DEPS=$(srcdir)/Modules/_ssl.h $(srcdir)/Modules/_ssl/cert.c $(srcdir)/Modules/_ssl/debughelpers.c $(srcdir)/Modules/_ssl/misc.c $(srcdir)/Modules/socketmodule.h
 MODULE__TESTCAPI_DEPS=$(srcdir)/Modules/_testcapi/parts.h $(srcdir)/Modules/_testcapi/util.h
 MODULE__TESTLIMITEDCAPI_DEPS=$(srcdir)/Modules/_testlimitedcapi/testcapi_long.h $(srcdir)/Modules/_testlimitedcapi/parts.h $(srcdir)/Modules/_testlimitedcapi/util.h
 MODULE__TESTINTERNALCAPI_DEPS=$(srcdir)/Modules/_testinternalcapi/parts.h
