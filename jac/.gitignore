# Zig build
.zig-cache/
zig-out/
/dist/
.pbs-build/
# Pinned bun fetched per target by the payload tool's fetch-bun subcommand
# (jaclang/dist/payload/) and bundled into the payload (never committed). See
# build.zig's fetch-bun step.
.bun-build/
jaclang/client/_bun/

# Vendored typeshed stdlib stubs are fetched at the pinned commit by the
# payload tool's fetch-typeshed subcommand (zig build fetch-typeshed), not
# committed -- only the PIN / TARBALL_SHA256 / LICENSE / PROVENANCE.md beside
# the stubs are tracked.
jaclang/vendor/typeshed/stdlib
.llvm-build/
# CI staging dir for a cache-restored prebuilt shim (setup-jac -Dshim-bin).
.shim-build/
# Persistent JIR precompile cache: mkpayload seeds site/_precompiled from it
# and writes the refreshed tree back (see build.zig --precompiled-cache).
.precompiled-build/
# Persistent deps-layer frame cache: mkpayload reuses the payload's compressed
# dependency layer across builds (see build.zig --layer-cache).
.payload-layers/
# Zig-built LLVMPY_* shim, placed in-tree per host platform (see build.zig).
libjacllvm.so
libjacllvm.dylib
jacllvm.dll
# Kit-built native compiler kernel (#8824), staged in-tree by mkpayload.
libjac_compiler.so
libjac_compiler.dylib
libjac_compiler.so.layout.json
libjac_compiler.dylib.layout.json
# Any other `nacompile --shared` unit that lands in-tree with its layout
# sidecar (a stray libjac_npy.so was committed once).
libjac_*.so
libjac_*.dylib
libjac_*.so.layout.json
libjac_*.dylib.layout.json
# Zig-built libjacpyembed desktop shim, placed in-tree per host platform.
libjacpyembed.so
libjacpyembed.dylib
jacpyembed.dll
