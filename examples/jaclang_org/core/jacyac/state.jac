import from "@jac/runtime" {
    __getLocalStorage,
    __setLocalStorage,
    RemoteError,
    RemoteUnavailable,
    RemoteTimeout,
    RemoteRejected,
}

obj JacYacState {
    has session: Session,
        activeTab: str,
        myProfile: ProfileBundle | None,
        tweets: list[Tweet],
        feedLoading: bool,
        composerText: str,
        searchQuery: str,
        allProfiles: list[Profile],
        avatars: dict[str, str],
        avatarSeen: dict[str, str],
        editingProfile: bool,
        profileSaving: bool,
        profileError: str,
        avatarBusy: bool,
        viewedProfile: ProfileBundle | None,
        viewedLoading: bool,
        trendingTags: list[TrendingTag],
        notifCount: int,
        showWelcome: bool,
        channels: list[ChannelBundle],
        channelsLoading: bool,
        selectedChannel: ChannelBundle | None,
        channelPosts: list[Tweet],
        posting: bool,
        refreshing: bool,
        bridgeMessage: str,
        loadData: Callable[[], Coroutine[any, any, None]],
        refreshAvatars: Callable[[], Coroutine[any, any, None]],
        postTweet: Callable[[], Coroutine[any, any, None]],
        handleLike: Callable[[str], Coroutine[any, any, None]],
        handleComment: Callable[[str, str], Coroutine[any, any, bool]],
        handleDelete: Callable[[str], Coroutine[any, any, None]],
        handleFollow: Callable[[str], Coroutine[any, any, None]],
        handleUnfollow: Callable[[str], Coroutine[any, any, None]],
        handleSaveProfile: Callable[[dict[str, str]], Coroutine[any, any, None]],
        handleClearAvatar: Callable[[], Coroutine[any, any, None]],
        handleViewProfile: Callable[[str], Coroutine[any, any, None]],
        handleSearch: Callable[[str], Coroutine[any, any, None]],
        handleRepost: Callable[[str, str, str], None],
        handleDismissWelcome: Callable[[], None],
        handleTrendClick: Callable[[str], Coroutine[any, any, None]],
        navigate: Callable[[str], Coroutine[any, any, None]],
        loadChannels: Callable[[], Coroutine[any, any, None]],
        handleCreateChannel: Callable[[str, str], Coroutine[any, any, None]],
        handleJoinChannel: Callable[[str], Coroutine[any, any, None]],
        handleLeaveChannel: Callable[[str], Coroutine[any, any, None]],
        handleSelectChannel: Callable[[str], Coroutine[any, any, None]],
        handleChannelPost: Callable[[str], Coroutine[any, any, bool]],
        handleBackToChannels: Callable[[], None],
        refreshSocial: Callable[[], Coroutine[any, any, None]],
        handleRefresh: Callable[[], Coroutine[any, any, None]],
        handleSaveBio: Callable[[str], Coroutine[any, any, None]],
        handleAvatarData: Callable[[str], Coroutine[any, any, None]],
        setActiveTab: Callable[[str], None],
        setComposerText: Callable[[str], None],
        setSearchQuery: Callable[[str], None],
        setEditingProfile: Callable[[bool], None],
        setProfileError: Callable[[str], None],
        logout: Callable[[], Coroutine[any, any, None]],
        dismissError: Callable[[], None],
        reportError: Callable[[str], None];
}

def useJacYac -> JacYacState;

def bridge_error(error: RemoteError) -> str;
