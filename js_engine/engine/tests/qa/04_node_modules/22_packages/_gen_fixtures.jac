"""One-off generator for package resolution fixtures. Re-run if fixtures need reset."""

import json;
import os;
import from pathlib { Path }

glob ROOT = Path(__file__).resolve().parent / "_fixtures_node_modules";


def write_json(path: Path, data: object) {
    path.parent.mkdir(parents=True, exist_ok=True);
    path.write_text(json.dumps(data, indent=2) + "\n", encoding="utf-8");
}

def write_js(path: Path, body: str) {
    path.parent.mkdir(parents=True, exist_ok=True);
    path.write_text(body.rstrip() + "\n", encoding="utf-8");
}

def main {
    nm = ROOT;
    nm.mkdir(parents=True, exist_ok=True);

    # --- G1 main / type / dual ---
    write_json(
        nm / "npkg-main001" / "package.json",
        {"name": "npkg-main001", "main": "./lib.js"}
    );
    write_js(
        nm / "npkg-main001" / "lib.js",
        "module.exports = { id: 'NPKG-MAIN-001', via: 'main' };"
    );

    write_json(
        nm / "npkg-main002" / "package.json",
        {"name": "npkg-main002", "main": "./old.js", "exports": {".": "./new.js"}}
    );
    write_js(nm / "npkg-main002" / "old.js", "module.exports = { who: 'old' };");
    write_js(nm / "npkg-main002" / "new.js", "module.exports = { who: 'new' };");

    write_json(
        nm / "npkg-main003" / "package.json",
        {"name": "npkg-main003", "exports": "./index.js"}
    );
    write_js(
        nm / "npkg-main003" / "index.js",
        "module.exports = { id: 'NPKG-MAIN-003', sugar: true };"
    );

    write_json(
        nm / "npkg-main004" / "package.json",
        {"name": "npkg-main004", "exports": {".": "./index.js"}}
    );
    write_js(nm / "npkg-main004" / "index.js", "module.exports = { ok: true };");
    write_js(nm / "npkg-main004" / "legacy.js", "module.exports = { legacy: true };");

    write_json(
        nm / "npkg-main005" / "package.json",
        {"name": "npkg-main005", "main": "./index.js"}
    );
    write_js(nm / "npkg-main005" / "index.js", "module.exports = { v: 1 };");

    write_json(
        nm / "npkg-main005b" / "package.json",
        {"name": "npkg-main005b", "exports": {".": "./index.js"}}
    );
    write_js(nm / "npkg-main005b" / "index.js", "module.exports = { v: 1 };");

    write_json(
        nm / "npkg-type001" / "package.json",
        {"name": "npkg-type001", "type": "module", "exports": {".": "./index.js"}}
    );
    write_js(nm / "npkg-type001" / "index.js", "export const tag = 'esm';");

    write_json(
        nm / "npkg-type002" / "package.json",
        {"name": "npkg-type002", "type": "commonjs", "main": "./index.js"}
    );
    write_js(nm / "npkg-type002" / "index.js", "module.exports = { tag: 'cjs' };");

    write_json(
        nm / "npkg-type003" / "package.json",
        {"name": "npkg-type003", "type": "commonjs", "main": "./index.mjs"}
    );
    write_js(nm / "npkg-type003" / "index.mjs", "export const tag = 'mjs-esm';");

    write_json(
        nm / "npkg-type004" / "package.json",
        {"name": "npkg-type004", "type": "module", "main": "./index.cjs"}
    );
    write_js(
        nm / "npkg-type004" / "index.cjs",
        "module.exports = { tag: 'cjs-in-module-pkg' };"
    );

    write_json(
        nm / "npkg-type005" / "package.json",
        {
            "name": "npkg-type005",
            "type": "module",
            "exports": {".": "./root.mjs", "./inner": "./innermod/index.js"}
        }
    );
    write_js(nm / "npkg-type005" / "root.mjs", "export const root = 'outer-esm';");
    write_json(nm / "npkg-type005" / "innermod" / "package.json", {"type": "commonjs"});
    write_js(
        nm / "npkg-type005" / "innermod" / "index.js",
        "module.exports = { kind: 'nested-cjs-boundary' };"
    );

    write_json(
        nm / "npkg-type006" / "package.json",
        {"name": "npkg-type006", "type": "bogus-type-xyz", "main": "./index.js"}
    );
    write_js(
        nm / "npkg-type006" / "index.js",
        "module.exports = { tag: 'invalid-type-fallback' };"
    );

    write_json(
        nm / "npkg-dual001" / "package.json",
        {
            "name": "npkg-dual001",
            "exports": {".": {"import": "./esm.mjs", "require": "./cjs.cjs"}}
        }
    );
    write_js(nm / "npkg-dual001" / "esm.mjs", "export const side = 'import';");
    write_js(nm / "npkg-dual001" / "cjs.cjs", "module.exports = { side: 'require' };");

    write_json(
        nm / "npkg-dual002" / "package.json",
        {
            "name": "npkg-dual002",
            "exports": {
                ".": {
                    "require": "./req.cjs",
                    "import": "./imp.mjs",
                    "default": "./def.cjs"
                }
            }
        }
    );
    write_js(
        nm / "npkg-dual002" / "req.cjs", "module.exports = { pick: 'require-first' };"
    );
    write_js(nm / "npkg-dual002" / "imp.mjs", "export const pick = 'import-second';");
    write_js(nm / "npkg-dual002" / "def.cjs", "module.exports = { pick: 'default' };");

    write_json(
        nm / "npkg-dual003" / "package.json",
        {
            "name": "npkg-dual003",
            "exports": {".": {"unknown-env-zzz": "./bad.js", "default": "./ok.js"}}
        }
    );
    write_js(nm / "npkg-dual003" / "bad.js", "throw new Error('should not load');");
    write_js(
        nm / "npkg-dual003" / "ok.js", "module.exports = { via: 'default-branch' };"
    );

    # --- G2 exports ---
    write_json(
        nm / "npkg-exp001" / "package.json",
        {"name": "npkg-exp001", "exports": {".": "./a.js"}}
    );
    write_js(nm / "npkg-exp001" / "a.js", "module.exports = { id: 'NPKG-EXP-001' };");

    write_json(
        nm / "npkg-exp002" / "package.json",
        {"name": "npkg-exp002", "exports": {".": "./main.js", "./feature": "./feat.js"}}
    );
    write_js(nm / "npkg-exp002" / "main.js", "module.exports = { root: true };");
    write_js(nm / "npkg-exp002" / "feat.js", "module.exports = { sub: true };");

    write_json(
        nm / "npkg-exp003" / "package.json",
        {"name": "npkg-exp003", "exports": {".": "./index.js"}}
    );
    write_js(nm / "npkg-exp003" / "index.js", "module.exports = { ok: 1 };");
    write_js(nm / "npkg-exp003" / "secret.js", "module.exports = { secret: true };");

    write_json(
        nm / "npkg-exp004" / "package.json",
        {
            "name": "npkg-exp004",
            "exports": {".": "./index.js", "./package.json": "./package.json"}
        }
    );
    write_js(nm / "npkg-exp004" / "index.js", "module.exports = { ok: 1 };");

    write_json(
        nm / "npkg-exp005" / "package.json",
        {
            "name": "npkg-exp005",
            "exports": {"./noext": "./target.js", "./ext.js": "./target.js"}
        }
    );
    write_js(nm / "npkg-exp005" / "target.js", "module.exports = { same: true };");

    write_json(
        nm / "npkg-exp101" / "package.json",
        {
            "name": "npkg-exp101",
            "exports": {".": "./index.js", "./features/*.js": "./src/features/*.js"}
        }
    );
    write_js(nm / "npkg-exp101" / "index.js", "module.exports = { ok: 1 };");
    write_js(
        nm / "npkg-exp101" / "src" / "features" / "x.js",
        "module.exports = { pattern: 'x' };"
    );

    write_json(
        nm / "npkg-exp102" / "package.json",
        {
            "name": "npkg-exp102",
            "exports": {
                ".": "./index.js",
                "./blocked/*.js": None,
                "./blocked/extra.js": "./blocked/extra.js"
            }
        }
    );
    write_js(nm / "npkg-exp102" / "index.js", "module.exports = { ok: 1 };");
    write_js(
        nm / "npkg-exp102" / "blocked" / "x.js", "module.exports = { blocked: true };"
    );
    write_js(
        nm / "npkg-exp102" / "blocked" / "extra.js", "module.exports = { extra: true };"
    );

    write_json(
        nm / "npkg-exp103" / "package.json",
        {
            "name": "npkg-exp103",
            "exports": {".": "./index.js", "./escape/*": "../escape_target.js"}
        }
    );
    write_js(nm / "npkg-exp103" / "index.js", "module.exports = { ok: 1 };");
    write_js(
        nm / "npkg-exp103" / "escape_target.js", "module.exports = { bad: true };"
    );

    write_json(
        nm / "npkg-exp104" / "package.json",
        {
            "name": "npkg-exp104",
            "exports": {
                ".": "./index.js",
                "./foo.js": "./exact.js",
                "./fo*.js": "./pattern.js"
            }
        }
    );
    write_js(nm / "npkg-exp104" / "index.js", "module.exports = { ok: 1 };");
    write_js(nm / "npkg-exp104" / "exact.js", "module.exports = { which: 'exact' };");
    write_js(
        nm / "npkg-exp104" / "pattern.js", "module.exports = { which: 'pattern' };"
    );

    write_json(
        nm / "npkg-err-exp001" / "package.json",
        {"name": "npkg-err-exp001", "exports": {".": "index.js"}}
    );
    write_js(nm / "npkg-err-exp001" / "index.js", "module.exports = {};");

    write_json(
        nm / "npkg-err-exp002" / "package.json",
        {"name": "npkg-err-exp002", "exports": {".": "./../outside.js"}}
    );
    write_js(nm / "npkg-err-exp002" / "index.js", "module.exports = {};");

    write_json(
        nm / "npkg-err-exp003" / "package.json",
        {"name": "npkg-err-exp003", "exports": {".": {"import": {}}}}
    );

    # --- G3 imports ---
    write_json(
        nm / "npkg-imp001" / "package.json",
        {
            "name": "npkg-imp001",
            "type": "module",
            "imports": {"#utils": "./util.js"},
            "exports": {".": "./entry.mjs"}
        }
    );
    write_js(nm / "npkg-imp001" / "util.js", "export const util = 42;");
    write_js(
        nm / "npkg-imp001" / "entry.mjs",
        "import { util } from '#utils';\nexport const out = util;\n"
    );

    write_json(
        nm / "npkg-imp002" / "package.json",
        {
            "name": "npkg-imp002",
            "type": "module",
            "imports": {"#bad": 1},
            "exports": {".": "./entry.mjs"}
        }
    );
    write_js(
        nm / "npkg-imp002" / "entry.mjs", "import x from '#bad';\nexport const y = x;\n"
    );

    write_json(
        nm / "npkg-imp004" / "package.json",
        {
            "name": "npkg-imp004",
            "type": "module",
            "imports": {"#p": "path"},
            "exports": {".": "./entry.mjs"}
        }
    );
    write_js(
        nm / "npkg-imp004" / "entry.mjs",
        "import path from '#p';\nexport const sep = path.sep;\n"
    );

    write_json(
        nm / "npkg-imp005" / "package.json",
        {
            "name": "npkg-imp005",
            "type": "module",
            "imports": {"#lib/*": "./lib/*"},
            "exports": {".": "./entry.mjs"}
        }
    );
    write_js(nm / "npkg-imp005" / "lib" / "a.js", "export const n = 'a';");
    write_js(
        nm / "npkg-imp005" / "entry.mjs",
        "import { n } from '#lib/a.js';\nexport const out = n;\n"
    );

    write_json(
        nm / "npkg-imp-err001" / "package.json",
        {"name": "npkg-imp-err001", "type": "module", "exports": {".": "./entry.mjs"}}
    );
    write_js(
        nm / "npkg-imp-err001" / "entry.mjs",
        "import { x } from '#missing-alias';\nexport const y = x;\n"
    );

    # npkg-imp-err002 / ERR-IMP-003: invalid imports target (outside package)
    write_json(
        nm / "npkg-imp-err002" / "package.json",
        {
            "name": "npkg-imp-err002",
            "type": "module",
            "imports": {"#bad": "../npkg-exp001/a.js"},
            "exports": {".": "./entry.mjs"}
        }
    );
    write_js(
        nm / "npkg-imp-err002" / "entry.mjs",
        "import v from '#bad';\nexport const x = v;\n"
    );

    # --- G4 conditions (package npkg-cond001 used by CLI shell) ---
    write_json(
        nm / "npkg-cond001" / "package.json",
        {
            "name": "npkg-cond001",
            "exports": {
                ".": {
                    "development": "./dev.js",
                    "production": "./prod.js",
                    "default": "./prod.js"
                }
            }
        }
    );
    write_js(
        nm / "npkg-cond001" / "dev.js", "module.exports = { env: 'development' };"
    );
    write_js(
        nm / "npkg-cond001" / "prod.js", "module.exports = { env: 'production' };"
    );

    write_json(
        nm / "npkg-cli002" / "package.json",
        {
            "name": "npkg-cli002",
            "exports": {".": {"alpha": "./a.js", "beta": "./b.js", "default": "./d.js"}}
        }
    );
    write_js(nm / "npkg-cli002" / "a.js", "module.exports = { which: 'alpha' };");
    write_js(nm / "npkg-cli002" / "b.js", "module.exports = { which: 'beta' };");
    write_js(nm / "npkg-cli002" / "d.js", "module.exports = { which: 'default' };");

    write_json(
        nm / "npkg-cond002" / "package.json",
        {
            "name": "npkg-cond002",
            "exports": {".": {"node": "./node.js", "default": "./default.js"}}
        }
    );
    write_js(nm / "npkg-cond002" / "node.js", "module.exports = { which: 'node' };");
    write_js(
        nm / "npkg-cond002" / "default.js", "module.exports = { which: 'default' };"
    );

    write_json(
        nm / "npkg-cond003" / "package.json",
        {
            "name": "npkg-cond003",
            "exports": {
                ".": {"import": {"node": "./node.mjs", "default": "./fallback.mjs"}}
            }
        }
    );
    write_js(nm / "npkg-cond003" / "node.mjs", "export const nest = 'node-import';");
    write_js(
        nm / "npkg-cond003" / "fallback.mjs", "export const nest = 'fallback-import';"
    );

    write_json(
        nm / "npkg-cond004" / "package.json",
        {
            "name": "npkg-cond004",
            "exports": {".": {"weird-custom-unset": "./bad.js", "default": "./ok.js"}}
        }
    );
    write_js(nm / "npkg-cond004" / "bad.js", "throw new Error('bad');");
    write_js(nm / "npkg-cond004" / "ok.js", "module.exports = { ok: true };");

    write_json(
        nm / "npkg-browser001" / "package.json",
        {
            "name": "npkg-browser001",
            "browser": {"./server.js": "./client.js", "fs": False},
            "main": "./main.js"
        }
    );
    write_js(
        nm / "npkg-browser001" / "main.js",
        "module.exports = { via: 'main-ignore-browser-field' };"
    );

    write_json(
        nm / "npkg-browser002" / "package.json",
        {
            "name": "npkg-browser002",
            "exports": {
                ".": {
                    "browser": "./browser.js",
                    "import": "./esm.mjs",
                    "require": "./req.cjs",
                    "default": "./req.cjs"
                }
            }
        }
    );
    write_js(
        nm / "npkg-browser002" / "browser.js", "module.exports = { side: 'browser' };"
    );
    write_js(nm / "npkg-browser002" / "esm.mjs", "export const side = 'import';");
    write_js(
        nm / "npkg-browser002" / "req.cjs", "module.exports = { side: 'require' };"
    );

    write_json(
        nm / "npkg-browser004" / "package.json",
        {
            "name": "npkg-browser004",
            "exports": {
                ".": {"browser": "./b.js", "node": "./n.js", "default": "./d.js"}
            }
        }
    );
    write_js(nm / "npkg-browser004" / "b.js", "module.exports = { pick: 'browser' };");
    write_js(nm / "npkg-browser004" / "n.js", "module.exports = { pick: 'node' };");
    write_js(nm / "npkg-browser004" / "d.js", "module.exports = { pick: 'default' };");

    # --- G5 self + boundaries ---
    write_json(
        nm / "npkg-self001" / "package.json",
        {
            "name": "npkg-self001",
            "exports": {".": "./main.cjs", "./sub.cjs": "./sub.cjs"}
        }
    );
    write_js(nm / "npkg-self001" / "sub.cjs", "module.exports = { tag: 'sub-self' };");
    write_js(
        nm / "npkg-self001" / "main.cjs",
        "module.exports = { fromSelf: require('npkg-self001/sub.cjs').tag };"
    );

    write_json(
        nm / "npkg-self002" / "package.json",
        {"name": "npkg-self002", "exports": {".": "./index.js"}}
    );
    write_js(nm / "npkg-self002" / "index.js", "module.exports = { ok: 1 };");
    write_js(nm / "npkg-self002" / "hidden.js", "module.exports = { hidden: true };");

    write_json(
        nm / "@npkg" / "self-scope" / "package.json",
        {
            "name": "@npkg/self-scope",
            "exports": {".": "./index.cjs", "./sub.cjs": "./sub.cjs"}
        }
    );
    write_js(
        nm / "@npkg" / "self-scope" / "index.cjs", "module.exports = { root: true };"
    );
    write_js(
        nm / "@npkg" / "self-scope" / "sub.cjs",
        "module.exports = { viaSelf: require('@npkg/self-scope').root };"
    );

    # NPKG-BOUND-002: nested node_modules inside a package
    write_json(
        nm / "npkg-bound002" / "package.json",
        {"name": "npkg-bound002", "main": "./main.js"}
    );
    write_js(
        nm / "npkg-bound002" / "main.js",
        "module.exports = { inner: require('inner-dep').v };"
    );
    write_json(
        nm / "npkg-bound002" / "node_modules" / "inner-dep" / "package.json",
        {"name": "inner-dep", "main": "./i.js"}
    );
    write_js(
        nm / "npkg-bound002" / "node_modules" / "inner-dep" / "i.js",
        "module.exports = { v: 99 };"
    );

    print("Wrote fixtures under", nm);
}

with entry:__main__ {
    main();
}
