    if name == "root" {
        return "".join([
            "js_engine is a JavaScript engine and package manager written in Jac. (v@VERSION@, bun-compat @BUN_COMPAT@)\n",
            "\n",
            "Usage: bun <command> [...flags] [...args]\n",
            "       bun [...flags] <file.js> [...args]\n",
            "\n",
            "Commands:\n",
            "  run       ./my-script.js        Execute a file with bun\n",
            "            lint                 Run a package.json script\n",
            "  x         prettier             Execute a package binary (CLI) from node_modules/.bin\n",
