            "  install                        Install dependencies for a package.json (bun i)\n",
            "  add       zod                  Add a dependency to package.json (bun a)\n",
            "\n",
            "  <command> --help               Print help text for command.\n",
            "\n",
            "Flags:\n",
            "      --smol                          Use less memory: enable the garbage collector and collect more often\n",
            "      --nogc                          Disable the garbage collector (it is on by default)\n",
            "      --expose-gc                     Expose gc() on the global object (collects when the garbage collector is enabled)\n",
            "  -r, --preload=<val>                 Import a module before other modules are loaded\n",
            "      --require=<val>                 Alias of --preload, for Node.js compatibility\n",
            "      --import=<val>                  Alias of --preload, for Node.js compatibility\n",
            "      --if-present                    Exit without an error if the entrypoint does not exist\n",
