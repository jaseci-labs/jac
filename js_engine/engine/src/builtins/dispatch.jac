    if len(args) >= 1 {
        key_gopd: JSValue = js_undefined();
        if len(args) >= 2 {
            key_gopd = args[1];
        }
        return js_Object_getOwnPropertyDescriptor(args[0], key_gopd);
    }
    return js_undefined();
}

