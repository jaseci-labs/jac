def _dn_native_kind_wasm_module_imports(
    realm: Realm, this_val: JSValue, args: list[JSValue]
) -> JSValue {
    # __wasm.moduleImports(modH) -> [{module, name, kind}]  (kind: int 0..3)
    mod_h: int = _dn_ptr_arg(args, 0);
    n: int = wasm_module_scan_imports(mod_h);
    records: list[JSValue] = [];
    if n > 0 {
        i: int = 0;
        while i < n {
            rec: JSValue = js_object_create_null();
            js_object_set(
                rec,
                str_intern("module"),
                jsv_from_string_id(str_intern(wasm_module_import_module(i)))
            );
            js_object_set(
                rec,
                str_intern("name"),
                jsv_from_string_id(str_intern(wasm_module_import_name(i)))
            );
            js_object_set(rec, str_intern("kind"), js_int(wasm_module_import_kind(i)));
            records.append(rec);
            i = i + 1;
        }
    }
    return js_array_create(records);
}

def _dn_native_kind_wasm_module_exports(
    realm: Realm, this_val: JSValue, args: list[JSValue]
) -> JSValue {
    # __wasm.moduleExports(modH) -> [{name, kind}]  (kind: int 0..3)
    mod_h: int = _dn_ptr_arg(args, 0);
    n: int = wasm_module_scan_exports(mod_h);
    records: list[JSValue] = [];
    if n > 0 {
        i: int = 0;
        while i < n {
            rec: JSValue = js_object_create_null();
            js_object_set(
                rec,
                str_intern("name"),
                jsv_from_string_id(str_intern(wasm_module_export_name(i)))
            );
            js_object_set(rec, str_intern("kind"), js_int(wasm_module_export_kind(i)));
            records.append(rec);
            i = i + 1;
        }
    }
    return js_array_create(records);
}

def _dn_native_kind_wasm_export_global(
    realm: Realm, this_val: JSValue, args: list[JSValue]
) -> JSValue {
    # __wasm.exportGlobal(inst, name) -> globalHandle (0 on error)
    inst_h: int = _dn_ptr_arg(args, 0);
    name: str = "";
    if len(args) >= 2 and jsv_is_string_cell(args[1]) {
        name = str_from_id(jsv_to_table_id(args[1]));
    }
    return js_int(wasm_export_global(inst_h, name));
}

def _dn_native_kind_wasm_global_get(
    realm: Realm, this_val: JSValue, args: list[JSValue]
) -> JSValue {
    # __wasm.globalGet(globalHandle) -> number | BigInt (global .value)
    g_h: int = _dn_ptr_arg(args, 0);
    kind: int = wasm_global_kind(g_h);
    if kind == WASMTIME_F32 or kind == WASMTIME_F64 {
        return jsv_from_double(wasm_global_get_dbl(g_h));
    }
    if kind == WASMTIME_I32 {
        return jsv_from_int32(wasm_global_get_int(g_h));
    }
    # i64 → BigInt (Phase 3), matching Node/V8.
    return js_bigint_from_decimal_str(wasm_i64_to_decimal(wasm_global_get_int(g_h)));
}

# ── Phase 3 dispatch handlers ─────────────────────────────────────────────────

def _dn_native_kind_wasm_last_errclass(
    realm: Realm, this_val: JSValue, args: list[JSValue]
) -> JSValue {
    return js_int(wasm_last_error_class());
}

def _dn_native_kind_wasm_global_create(
    realm: Realm, this_val: JSValue, args: list[JSValue]
) -> JSValue {
    # __wasm.globalCreate(kind, mutable, ival, dval) -> globalHandle (0 on error)
    kind: int = _dn_ptr_arg(args, 0);
    mutable: bool = False;
    if len(args) >= 2 {
        mutable = jsv_to_bool(args[1]);
    }
    ival: int = 0;
    dval: float = 0.0;
    if kind == WASMTIME_I64 {
        # initial value may arrive as BigInt.
        if len(args) >= 3 and jsv_is_bigint_cell(args[2]) {
            ival = wasm_i64_from_decimal(str_from_id(jsv_to_table_id(args[2])));
        } elif len(args) >= 3 {
            ival = _dn_ptr_arg(args, 2);
        }
    } elif kind == WASMTIME_F32 or kind == WASMTIME_F64 {
        if len(args) >= 4 and jsv_is_double(args[3]) {
            dval = jsv_to_double(args[3]);
        } elif len(args) >= 4 and jsv_is_int32(args[3]) {
            dval = float(jsv_to_int32(args[3]));
        }
    } else {
        ival = _dn_ptr_arg(args, 2);
    }
    return js_int(wasm_global_create(kind, mutable, ival, dval));
}

def _dn_native_kind_wasm_global_set(
    realm: Realm, this_val: JSValue, args: list[JSValue]
) -> JSValue {
    # __wasm.globalSet(gh, ival, dval) -> bool  (kind inferred from the global)
    g_h: int = _dn_ptr_arg(args, 0);
    kind: int = wasm_global_kind(g_h);
    ival: int = 0;
    dval: float = 0.0;
    if kind == WASMTIME_I64 {
        if len(args) >= 2 and jsv_is_bigint_cell(args[1]) {
            ival = wasm_i64_from_decimal(str_from_id(jsv_to_table_id(args[1])));
        } elif len(args) >= 2 {
            ival = _dn_ptr_arg(args, 1);
        }
    } elif kind == WASMTIME_F32 or kind == WASMTIME_F64 {
        if len(args) >= 3 and jsv_is_double(args[2]) {
            dval = jsv_to_double(args[2]);
        } elif len(args) >= 3 and jsv_is_int32(args[2]) {
            dval = float(jsv_to_int32(args[2]));
        }
    } else {
        ival = _dn_ptr_arg(args, 1);
    }
    return js_boolean(wasm_global_set_val(g_h, ival, dval));
}

def _dn_native_kind_wasm_global_is_mut(
