# ══════════════════════════════════════════════════════════════════════════════
# 4.  Dispatch table  (populated at startup)
# ══════════════════════════════════════════════════════════════════════════════

glob _DISPATCH_TABLE:
         dict[int, Callable[[Realm, JSValue, list[JSValue]], JSValue]] = {};

"""Populate _DISPATCH_TABLE. Call once from global_context_create() before any JS runs."""
def:pub init_dispatch_table {
    _DISPATCH_TABLE = {};
    _DISPATCH_TABLE[NATIVE_KIND_CONSOLE_LOG] = _dn_native_kind_console_log;
    _DISPATCH_TABLE[NATIVE_KIND_CONSOLE_INFO] = _dn_native_kind_console_info;
    _DISPATCH_TABLE[NATIVE_KIND_CONSOLE_DEBUG] = _dn_native_kind_console_debug;
    _DISPATCH_TABLE[NATIVE_KIND_CONSOLE_ERROR] = _dn_native_kind_console_error;
    _DISPATCH_TABLE[NATIVE_KIND_CONSOLE_WARN] = _dn_native_kind_console_warn;
    _DISPATCH_TABLE[NATIVE_KIND_CONSOLE_DIR] = _dn_native_kind_console_dir;
    _DISPATCH_TABLE[NATIVE_KIND_CONSOLE_ASSERT] = _dn_native_kind_console_assert;
    _DISPATCH_TABLE[NATIVE_KIND_CONSOLE_COUNT] = _dn_native_kind_console_count;
    _DISPATCH_TABLE[NATIVE_KIND_CONSOLE_COUNT_RESET] = _dn_native_kind_console_count_reset;
    _DISPATCH_TABLE[NATIVE_KIND_CONSOLE_TIME] = _dn_native_kind_console_time;
    _DISPATCH_TABLE[NATIVE_KIND_CONSOLE_TIME_END] = _dn_native_kind_console_time_end;
    _DISPATCH_TABLE[NATIVE_KIND_CONSOLE_TIME_LOG] = _dn_native_kind_console_time_log;
    _DISPATCH_TABLE[NATIVE_KIND_CONSOLE_GROUP] = _dn_native_kind_console_group;
    _DISPATCH_TABLE[NATIVE_KIND_CONSOLE_GROUP_COLLAPSED] = _dn_native_kind_console_group_collapsed;
    _DISPATCH_TABLE[NATIVE_KIND_CONSOLE_GROUP_END] = _dn_native_kind_console_group_end;
    _DISPATCH_TABLE[NATIVE_KIND_CONSOLE_TABLE] = _dn_native_kind_console_table;
    _DISPATCH_TABLE[NATIVE_KIND_PARSE_INT] = _dn_native_kind_parse_int;
