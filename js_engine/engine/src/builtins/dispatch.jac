def _dn_native_kind_gc_get_threshold(
    realm: Realm, this_val: JSValue, args: list[JSValue]
) -> JSValue {
    return js_int(realm.gc_threshold);
}

def _dn_native_kind_gc_set_threshold(
    realm: Realm, this_val: JSValue, args: list[JSValue]
) -> JSValue {
    if len(args) > 0 and jsv_is_int32(args[0]) {
        realm.gc_threshold = jsv_to_int32(args[0]);
    } elif len(args) > 0 and jsv_is_double(args[0]) {
        realm.gc_threshold = int(jsv_to_double(args[0]));
    }
    return js_undefined();
}

def _dn_native_kind_gc_collect(
    realm: Realm, this_val: JSValue, args: list[JSValue]
) -> JSValue {
    realm_request_gc(realm);
    return js_int(0);
}

def _dn_native_kind_gc_stats(
    realm: Realm, this_val: JSValue, args: list[JSValue]
) -> JSValue {
    # Build a JS object: { cycles, freed, monitorActive, monitorCycles, monitorFreed }
    sobj: JSValue = js_object_create_null();
    k_cyc: int = str_intern("cycles");
    k_frd: int = str_intern("freed");
    k_mon: int = str_intern("monitoring");
    k_mcyc: int = str_intern("monitorCycles");
    k_mfrd: int = str_intern("monitorFreed");
    k_thr: int = str_intern("threshold");
    js_object_set(sobj, k_cyc, js_int(gc_total_cycles));
    js_object_set(sobj, k_frd, js_int(gc_total_freed));
    js_object_set(sobj, k_thr, js_int(realm.gc_threshold));
    if gc_monitor_active {
        live: list[int] = gc_live_monitor_stats();
        js_object_set(sobj, k_mon, js_boolean(True));
        js_object_set(sobj, k_mcyc, js_int(live[0]));
        js_object_set(sobj, k_mfrd, js_int(live[1]));
    } else {
        js_object_set(sobj, k_mon, js_boolean(False));
        js_object_set(sobj, k_mcyc, js_int(gc_monitor_cycles));
        js_object_set(sobj, k_mfrd, js_int(gc_monitor_freed));
    }
    return sobj;
}

def _dn_native_kind_gc_start_monitor(
    realm: Realm, this_val: JSValue, args: list[JSValue]
) -> JSValue {
    gc_start_monitor();
    return js_undefined();
}

def _dn_native_kind_gc_stop_monitor(
    realm: Realm, this_val: JSValue, args: list[JSValue]
) -> JSValue {
    gc_stop_monitor();
    return js_undefined();
}

def _dn_native_kind_gc_debug(
    realm: Realm, this_val: JSValue, args: list[JSValue]
) -> JSValue {
    live_mon: list[int] = gc_live_monitor_stats();
    print(
        "[GC] cycles="
            + str(gc_total_cycles)
            + " freed="
            + str(gc_total_freed)
            + " threshold="
            + str(realm.gc_threshold)
            + " monitoring="
            + str(gc_monitor_active)
            + " monCycles="
            + str(live_mon[0])
            + " monFreed="
            + str(live_mon[1])
    );
    return js_undefined();
}

