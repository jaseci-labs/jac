def _dn_native_kind_str_tostring(
    realm: Realm, this_val: JSValue, args: list[JSValue]
) -> JSValue {
    # thisStringValue(this) — §22.1.3.28/.35: only a String primitive or String
    # object is valid; any other receiver throws (String.prototype.toString and
    # .valueOf are non-generic).
    if not jsv_is_string_cell(this_val) and not is_string_object(this_val) {
        vm_throw_native(
            make_type_error(
                "String.prototype.toString requires that 'this' be a String"
            )
        );
        return js_undefined();
    }
    return js_str_toString(this_val);
    # ── Number prototype methods ───────────────────────────────────────────────
}

