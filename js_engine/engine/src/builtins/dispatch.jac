"""
IsRegExp(v) — ECMAScript §7.2.8. Objects only: reads @@match observably (a
throwing getter propagates), ToBoolean of a non-undefined result decides;
undefined falls back to the [[RegExpMatcher]] internal slot. Primitives are false.
"""
def _str_arg_is_regexp(v: JSValue) -> bool {
    if not jsv_is_object_cell(v) {
        return False;
    }
    match_key: int = SYMBOL_KEY_BASE + SYMBOL_MATCH;
    matcher: JSValue = js_object_get_observable(v, match_key, v);
    if vm_has_native_exc() {
        return False;
    }
    if not jsv_is_undefined(matcher) {
        return jsv_coerce_to_bool(matcher);
    }
    return js_is_regexp(v);
}

"""
Throw a TypeError if `search` IsRegExp — the shared guard for
String.prototype.{includes,startsWith,endsWith} (spec step 3). Returns True if a
native exception is now pending (either the throw or a throwing @@match getter),
so the caller can bail out before doing any further work.
"""
def _str_search_regexp_guard(search: JSValue, method: str) -> bool {
    is_re: bool = _str_arg_is_regexp(search);
    if vm_has_native_exc() {
        return True;
    }
    if is_re {
        vm_throw_native(
            make_type_error(
                "First argument to String.prototype."
                    + method
                    + " must not be a regular expression"
            )
        );
        return True;
    }
    return False;
}

"""
Try the ECMAScript §22.1.3 symbol-method protocol for String.prototype.{match,
matchAll,replace,search,split}: if `search_val` is an object with a callable
`@@sym` method, Call(method, search_val, [S, ...extra]) and return its result.

Returns (handled, result). `handled` is False when there is no custom method (the
caller falls back to the native RegExp path) OR when the bridge is unavailable.
A throwing @@sym getter / thrown call propagates via vm_has_native_exc — in that
case handled=True and the pending exception is left for the VM.
"""
def _str_symbol_method(
    search_val: JSValue, sym_id: int, s_str: JSValue, extra: list[JSValue]
) -> tuple[bool, JSValue] {
    if jsv_is_undefined(search_val) or jsv_is_null(search_val) {
        return (False, js_undefined());
    }
    if not jsv_is_object_cell(search_val) {
        return (False, js_undefined());
    }
    if not js_call_bridge_ready() {
        return (False, js_undefined());
    }
    method: JSValue = js_object_get_observable(
        search_val, SYMBOL_KEY_BASE + sym_id, search_val
    );
    if vm_has_native_exc() {
        return (True, js_undefined());
    }
    if jsv_is_undefined(method) or jsv_is_null(method) {
        return (False, js_undefined());
    }
    if not spec_is_callable(method) {
        return (False, js_undefined());
    }
    call_args: list[JSValue] = [s_str];
    j: int = 0;
    while j < len(extra) {
        call_args.append(extra[j]);
        j = j + 1;
    }
    res: JSValue = js_call_observable(method, search_val, call_args);
    return (True, res);
}

"""
Shared IsRegExp-must-be-global guard for replaceAll/matchAll — §22.1.3.15 /
§22.1.3.13: if `search_val` IsRegExp (observable @@match) and its `flags`
(Get → RequireObjectCoercible → ToString) lacks "g", throw TypeError. Returns True
if a native exception is now pending (guard threw, or an observable step threw).
"""
def _str_regexp_requires_global(search_val: JSValue, method: str) -> bool {
    if jsv_is_undefined(search_val) or jsv_is_null(search_val) {
        return False;
    }
    isre: bool = _str_arg_is_regexp(search_val);
    if vm_has_native_exc() {
        return True;
    }
    if not isre {
        return False;
    }
    flags_v: JSValue = js_object_get_observable(
        search_val, str_intern("flags"), search_val
    );
    if vm_has_native_exc() {
        return True;
    }
    if jsv_is_undefined(flags_v) or jsv_is_null(flags_v) {
        vm_throw_native(make_type_error("Cannot convert undefined or null to object"));
        return True;
    }
    flags_s: str = js_to_string_observable(flags_v);
    if vm_has_native_exc() {
        return True;
    }
    gi: int = 0;
    while gi < len(flags_s) {
        if flags_s[gi] == "g" {
            return False;
        }
        gi = gi + 1;
    }
    vm_throw_native(
        make_type_error(
            "String.prototype." + method + " called with a non-global RegExp argument"
        )
    );
    return True;
}

def _dn_native_kind_str_includes(
    realm: Realm, this_val: JSValue, args: list[JSValue]
) -> JSValue {
    if _str_this_not_coercible(this_val, "includes") {
        return js_undefined();
    }
    s0_in: JSValue = js_undefined();
    s1_in: JSValue = js_undefined();
    if len(args) > 0 {
        s0_in = args[0];
    }
    if len(args) > 1 {
        s1_in = args[1];
    }
    if _str_search_regexp_guard(s0_in, "includes") {
        return js_undefined();
    }
    return js_str_includes(this_val, s0_in, s1_in);
}

