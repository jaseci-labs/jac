    getter_dg: JSValue = args[1] if len(args) > 1 else js_undefined();
    return js_Object_prototype_defineGetter(this_val, key_dg, getter_dg);
}

def _dn_native_kind_obj_proto_define_setter(
    realm: Realm, this_val: JSValue, args: list[JSValue]
) -> JSValue {
    key_ds: JSValue = args[0] if len(args) > 0 else js_undefined();
    setter_ds: JSValue = args[1] if len(args) > 1 else js_undefined();
    return js_Object_prototype_defineSetter(this_val, key_ds, setter_ds);
}

"""
__jacMarkNonConstructor(fn) — mark a JS closure so IsConstructor returns false.
Used by JS-layer builtins that are authored as plain function expressions but
must not implement [[Construct]] (test262 not-a-constructor.js).
"""
def _dn_native_kind_mark_non_constructor(
    realm: Realm, this_val: JSValue, args: list[JSValue]
) -> JSValue {
    if len(args) == 0 {
        vm_throw_native(make_type_error("__jacMarkNonConstructor requires a function"));
        return js_undefined();
    }
    fn_mnc: JSValue = args[0];
    if not jsv_is_cell(fn_mnc) or jsv_cell_kind(fn_mnc) != JS_CELL_KIND_NATIVE {
        vm_throw_native(make_type_error("__jacMarkNonConstructor requires a function"));
        return js_undefined();
    }
    cid_mnc: int = jsv_to_table_id(fn_mnc);
    if cid_mnc < 0 or cid_mnc >= 1000000 or cid_mnc >= len(realm.closures) {
        vm_throw_native(
            make_type_error("__jacMarkNonConstructor requires a JS function")
        );
        return js_undefined();
    }
    cl_mnc: JSClosure = realm.closures[cid_mnc];
    cl_mnc.is_non_constructor = True;
    # Non-constructible functions have no .prototype own property (ES §10.2.4).
    cl_mnc.prototype_obj = js_undefined();
    return fn_mnc;
}

def _dn_native_kind_obj_proto_tostring(
    realm: Realm, this_val: JSValue, args: list[JSValue]
) -> JSValue {
    # ECMAScript §20.1.3.6 — Object.prototype.toString
    if jsv_is_undefined(this_val) {
        return jsv_from_string_id(str_intern("[object Undefined]"));
    }
    if jsv_is_null(this_val) {
        return jsv_from_string_id(str_intern("[object Null]"));
    }
    o_ts: JSValue = this_val;
    if js_is_proxy(this_val) {
        if js_proxy_is_revoked(this_val) {
            vm_throw_native(
                make_type_error("Cannot perform 'get' on a proxy that has been revoked")
            );
            return js_undefined();
        }
    }
    brand_ts: JSValue = this_val;
    while js_is_proxy(brand_ts) {
        if js_proxy_is_revoked(brand_ts) {
            vm_throw_native(
                make_type_error("Cannot perform 'get' on a proxy that has been revoked")
            );
            return js_undefined();
        }
        brand_ts = js_proxy_target(brand_ts);
    }
    if not jsv_is_object_cell(this_val) and not js_is_proxy(this_val) {
        o_ts = js_Object([this_val]);
    }
    tag_key: int = SYMBOL_KEY_BASE + SYMBOL_TO_STRING_TAG;
    tag_jsv: JSValue = js_object_get_observable(o_ts, tag_key, o_ts);
    if vm_has_native_exc() {
        return js_undefined();
    }
    if jsv_is_string_cell(tag_jsv) {
        return jsv_from_string_id(
            str_intern("[object " + str_from_id(jsv_to_table_id(tag_jsv)) + "]")
        );
    }
    ts_tag: str = "[object Object]";
    if js_is_proxy(this_val) and js_proxy_is_callable(this_val) {
        if fn_meta_is_closure(brand_ts) {
            ts_cl_id_p: int = jsv_to_table_id(brand_ts);
            if ts_cl_id_p >= 0 and ts_cl_id_p < len(realm.closures) {
                ts_cl_p: JSClosure = realm.closures[ts_cl_id_p];
                if ts_cl_p.func.is_generator and ts_cl_p.func.is_async {
                    ts_tag = "[object AsyncGeneratorFunction]";
                } elif ts_cl_p.func.is_generator {
                    ts_tag = "[object GeneratorFunction]";
                } elif ts_cl_p.func.is_async {
                    ts_tag = "[object AsyncFunction]";
                } else {
                    ts_tag = "[object Function]";
                }
            } else {
                ts_tag = "[object Function]";
            }
        } elif is_native_val(brand_ts) {
            ts_tag = "[object Function]";
        }
    } elif jsv_is_bool(this_val) {
        ts_tag = "[object Boolean]";
    } elif jsv_is_int32(this_val) or jsv_is_double(this_val) {
        ts_tag = "[object Number]";
    } elif jsv_is_string_cell(this_val) {
        ts_tag = "[object String]";
    } elif jsv_is_bigint_cell(this_val) {
        ts_tag = "[object BigInt]";
    } elif jsv_is_symbol(this_val) {
        ts_tag = "[object Symbol]";
    } elif jsv_is_cell(this_val)
        and jsv_cell_kind(this_val) == JS_CELL_KIND_NATIVE
        and jsv_to_table_id(this_val) < NATIVE_BASE {
        # User closure — distinguish async / generator per ECMAScript §20.1.3.6
        ts_cl_id: int = jsv_to_table_id(this_val);
        if ts_cl_id >= 0 and ts_cl_id < len(realm.closures) {
            ts_cl: JSClosure = realm.closures[ts_cl_id];
            if ts_cl.func.is_generator and ts_cl.func.is_async {
                ts_tag = "[object AsyncGeneratorFunction]";
            } elif ts_cl.func.is_generator {
                ts_tag = "[object GeneratorFunction]";
            } elif ts_cl.func.is_async {
                ts_tag = "[object AsyncFunction]";
            } else {
                ts_tag = "[object Function]";
            }
        } else {
            ts_tag = "[object Function]";
        }
    } elif is_native_val(this_val) {
        ts_tag = "[object Function]";
    } elif jsv_is_object_cell(this_val) and jsv_to_table_id(this_val) < 0 {
        ts_tag = "[object Function]";
    } elif jsv_is_object_cell(this_val)
        and jsv_to_table_id(this_val) > 0
        and js_object_has_own(this_val, KEY_CTOR_KIND) {
        ts_tag = "[object Function]";
    } elif is_boolean_object(this_val) {
        ts_tag = "[object Boolean]";
    } elif is_number_object(this_val) {
        ts_tag = "[object Number]";
    } elif is_string_object(this_val) {
        ts_tag = "[object String]";
    } elif jsv_is_object_cell(this_val) {
        pv_ts: JSValue = js_object_get(this_val, str_intern("[[PrimitiveValue]]"));
        # §20.1.3.6: only the built-in brands Array/Function/Error/Boolean/Number/String/
        # Date/RegExp/Arguments produce a builtinTag. Map/Set/WeakMap/WeakSet/Generator/
        # BigInt/Symbol-wrapper etc. get their tag ONLY from @@toStringTag (read above); if
        # that property is deleted they fall through to "[object Object]" — do NOT brand them.
        if jsv_is_bigint_cell(pv_ts) {
            ts_tag = "[object BigInt]";
        } elif jsv_is_symbol(pv_ts) {
            ts_tag = "[object Symbol]";
        } elif js_object_is_arguments(this_val) {
            ts_tag = "[object Arguments]";
        } elif js_is_regexp(this_val) {
            ts_tag = "[object RegExp]";
        } elif jsv_coerce_to_bool(js_Array_isArray(this_val)) {
            ts_tag = "[object Array]";
        } elif js_is_date(this_val) {
            ts_tag = "[object Date]";
        } else {
            # §20.1.3.6 / §20.5.6.3: `[object Error]` requires [[ErrorData]] — an actual
            # Error *instance*. In this engine an error instance carries the internal
            # own `__errorStackData__` slot (Error.prototype and NativeError.prototype
            # objects are ordinary and have none, so they tag `[object Object]`).
            if js_object_has_own(this_val, key_stack_internal()) {
                ts_tag = "[object Error]";
            }
        }
    }
    return jsv_from_string_id(str_intern(ts_tag));
}

def _dn_native_kind_obj_proto_valueof(
    realm: Realm, this_val: JSValue, args: list[JSValue]
) -> JSValue {
    if jsv_is_null(this_val) or jsv_is_undefined(this_val) {
        vm_throw_native(make_type_error("Cannot convert undefined or null to object"));
        return js_undefined();
    }
    return this_val;
}

