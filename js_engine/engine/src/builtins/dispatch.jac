    return js_str_startsWith(this_val, ss0, ss1);
}

def _dn_native_kind_str_endswith(
    realm: Realm, this_val: JSValue, args: list[JSValue]
) -> JSValue {
    if _str_this_not_coercible(this_val, "endsWith") {
