def _dn_native_kind_process_exit(
    realm: Realm, this_val: JSValue, args: list[JSValue]
) -> JSValue {
    pe_code: int = 0;
    if len(args) > 0 {
        if jsv_is_int32(args[0]) {
            pe_code = jsv_to_int32(args[0]);
        } elif jsv_is_double(args[0]) {
            pe_code = int(jsv_to_double(args[0]));
        }
    }
    # Signal the event loop to stop gracefully so exit listeners can fire
    realm_request_exit(realm);
    realm.pending_exit_code = pe_code;
    uv_stop(realm.timer_loop_ptr);
    return js_undefined();
}

