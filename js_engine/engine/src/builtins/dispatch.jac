}

def _dn_native_kind_promise_static_resolve(
    realm: Realm, this_val: JSValue, args: list[JSValue]
) -> JSValue {
    val_r: JSValue = js_undefined();
    if len(args) > 0 {
        val_r = args[0];
    }
    # If already a Promise, return it directly
    if js_is_promise(val_r) {
        return val_r;
    }
    p_r: JSValue = js_promise_create();
    js_promise_settle(p_r, PROMISE_FULFILLED, val_r);
    return p_r;
}

def _dn_native_kind_promise_static_reject(
    realm: Realm, this_val: JSValue, args: list[JSValue]
) -> JSValue {
    reason_rej: JSValue = js_undefined();
    if len(args) > 0 {
        reason_rej = args[0];
    }
    p_rej: JSValue = js_promise_create();
    js_promise_settle(p_rej, PROMISE_REJECTED, reason_rej);
    # Queue for unhandledRejection dispatch; Promise.all/any unmark absorbed inputs.
    promise_track_unhandled(reason_rej, p_rej);
    return p_rej;
}

def _dn_native_kind_promise_withresolvers(
    realm: Realm, this_val: JSValue, args: list[JSValue]
) -> JSValue {
    # ES2024 §27.2.4.9 Promise.withResolvers(): create a new pending promise and
    # return { promise, resolve, reject } where resolve/reject are its capability
    # functions (the same ones the executor of `new Promise` receives).
    wr_p: JSValue = js_promise_create();
    wr_out: JSValue = js_object_create_null();
    js_object_set(wr_out, str_intern("promise"), wr_p);
    js_object_set(wr_out, str_intern("resolve"), js_make_resolve_fn(wr_p));
    js_object_set(wr_out, str_intern("reject"), js_make_reject_fn(wr_p));
    return wr_out;
}

def _dn_native_kind_promise_all(
    realm: Realm, this_val: JSValue, args: list[JSValue]
) -> JSValue {
    # ECMAScript §27.2.4.1 — Promise.all(iterable)
    # Handles pending promises by adding reactions; result settles once
    # all inputs have settled.
    iter_all: JSValue = js_undefined();
    if len(args) > 0 {
        iter_all = args[0];
    }
    result_all: JSValue = js_promise_create();
    if not js_is_array(iter_all) {
        js_promise_settle(result_all, PROMISE_FULFILLED, js_array_create([]));
        return result_all;
    }
    n_all: int = js_array_len(iter_all);
    if n_all == 0 {
        js_promise_settle(result_all, PROMISE_FULFILLED, js_array_create([]));
        return result_all;
    }
    # Pre-fill result slots with undefined so indices are stable
    vals_all: list[JSValue] = [];
    vi_all: int = 0;
    while vi_all < n_all {
        vals_all.append(js_undefined());
        vi_all = vi_all + 1;
    }

    # Store shared mutable state on the result promise object as hidden props
    # Key: integer sentinel IDs (won't clash with user properties)
    _all_counter_key: int = 1001001;  # remaining pending count
    _all_vals_key: int = 1001002;  # shared result array (JSValue list as array obj)
    results_arr: JSValue = js_array_create(vals_all);
    js_object_set(result_all, _all_counter_key, js_int(n_all));
    js_object_set(result_all, _all_vals_key, results_arr);

    i_all: int = 0;
    rejected_all: bool = False;
    while i_all < n_all and not rejected_all {
        p_i: JSValue = js_array_get(iter_all, i_all);
        if js_is_promise(p_i) {
            s_i: int = js_promise_get_state(p_i);
            if s_i == PROMISE_REJECTED {
                promise_unmark_unhandled(p_i);
                js_promise_settle(
                    result_all, PROMISE_REJECTED, js_promise_get_value(p_i)
                );
                rejected_all = True;
            } elif s_i == PROMISE_FULFILLED {
                # Already fulfilled — write into slot and decrement counter
                js_array_set(results_arr, i_all, js_promise_get_value(p_i));
                cur_cnt: JSValue = js_object_get(result_all, _all_counter_key);
                new_cnt: int = jsv_to_int32(cur_cnt) - 1;
                js_object_set(result_all, _all_counter_key, js_int(new_cnt));
                if new_cnt == 0 {
                    updated_arr: JSValue = js_object_get(result_all, _all_vals_key);
                    arr_len: int = js_array_len(updated_arr);
                    final_vals: list[JSValue] = [];
                    fvi: int = 0;
                    while fvi < arr_len {
                        final_vals.append(js_array_get(updated_arr, fvi));
                        fvi = fvi + 1;
                    }
                    js_promise_settle(
                        result_all, PROMISE_FULFILLED, js_array_create(final_vals)
                    );
                }
            } else {
                # Pending — create an on-fulfill reaction closure that writes
                # the slot and settles result_all when remaining count hits 0.
                # We encode the per-element context directly in a reaction object
                # using our reserved sentinel keys:
                #   _KEY_IS_PROMISE_ALL_ELEM (1001003) — marks the reaction type
                #   1001004 — the element index
                #   1001005 — reference to result_all
                _all_elem_key: int = 1001003;
                _all_idx_key: int = 1001004;
                _all_res_key: int = 1001005;
                on_f_all: JSValue = js_object_create_null();
                js_object_set(on_f_all, _all_elem_key, js_true());
                js_object_set(on_f_all, _all_idx_key, js_int(i_all));
                js_object_set(on_f_all, _all_res_key, result_all);
                # Reject handler: settle result_all immediately
                on_r_all: JSValue = js_object_create_null();
                js_object_set(on_r_all, 1001006, js_true());  # is-reject-all
                js_object_set(on_r_all, _all_res_key, result_all);
                js_promise_add_reaction(p_i, on_f_all, on_r_all, js_undefined());
            }
        } else {
            # Non-promise: treat as already-fulfilled with value p_i
            js_array_set(results_arr, i_all, p_i);
            cur_cnt2: JSValue = js_object_get(result_all, _all_counter_key);
            new_cnt2: int = jsv_to_int32(cur_cnt2) - 1;
            js_object_set(result_all, _all_counter_key, js_int(new_cnt2));
            if new_cnt2 == 0 {
                updated_arr2: JSValue = js_object_get(result_all, _all_vals_key);
                arr_len2: int = js_array_len(updated_arr2);
                final_vals2: list[JSValue] = [];
                fv2i: int = 0;
                while fv2i < arr_len2 {
                    final_vals2.append(js_array_get(updated_arr2, fv2i));
                    fv2i = fv2i + 1;
                }
                js_promise_settle(
                    result_all, PROMISE_FULFILLED, js_array_create(final_vals2)
                );
            }
        }
        i_all = i_all + 1;
    }
    return result_all;
}

def _dn_native_kind_promise_allsettled(
    realm: Realm, this_val: JSValue, args: list[JSValue]
) -> JSValue {
    iter_as: JSValue = js_undefined();
    if len(args) > 0 {
        iter_as = args[0];
    }
    result_as: JSValue = js_promise_create();
    if not js_is_array(iter_as) {
        js_promise_settle(result_as, PROMISE_FULFILLED, js_array_create([]));
        return result_as;
    }
    n_as: int = js_array_len(iter_as);
    settle_as: list[JSValue] = [];
    k_status: int = str_intern("status");
    k_value_as: int = str_intern("value");
    k_reason: int = str_intern("reason");
    sv_fulfilled: JSValue = jsv_from_string_id(str_intern("fulfilled"));
    sv_rejected: JSValue = jsv_from_string_id(str_intern("rejected"));
    sv_pending: JSValue = jsv_from_string_id(str_intern("pending"));
    i_as: int = 0;
    while i_as < n_as {
        p_as: JSValue = js_array_get(iter_as, i_as);
        settled_obj: JSValue = js_object_create_null();
        if js_is_promise(p_as) {
            s_as: int = js_promise_get_state(p_as);
            if s_as == PROMISE_FULFILLED {
                js_object_set(settled_obj, k_status, sv_fulfilled);
                js_object_set(settled_obj, k_value_as, js_promise_get_value(p_as));
            } elif s_as == PROMISE_REJECTED {
                js_object_set(settled_obj, k_status, sv_rejected);
                js_object_set(settled_obj, k_reason, js_promise_get_value(p_as));
            } else {
                js_object_set(settled_obj, k_status, sv_pending);
                js_object_set(settled_obj, k_value_as, js_undefined());
            }
        } else {
            js_object_set(settled_obj, k_status, sv_fulfilled);
            js_object_set(settled_obj, k_value_as, p_as);
        }
        settle_as.append(settled_obj);
        i_as = i_as + 1;
    }
    js_promise_settle(result_as, PROMISE_FULFILLED, js_array_create(settle_as));
    return result_as;
}

def _dn_native_kind_promise_race(
    realm: Realm, this_val: JSValue, args: list[JSValue]
) -> JSValue {
    iter_race: JSValue = js_undefined();
    if len(args) > 0 {
        iter_race = args[0];
    }
    result_race: JSValue = js_promise_create();
    if not js_is_array(iter_race) {
        return result_race;
    }
    n_race: int = js_array_len(iter_race);
    _race_res_key: int = 1001012;
    _race_f_key: int = 1001010;
    _race_r_key: int = 1001011;
    i_race: int = 0;
    while i_race < n_race {
        p_race: JSValue = js_array_get(iter_race, i_race);
        if js_is_promise(p_race) {
            s_race: int = js_promise_get_state(p_race);
            if s_race == PROMISE_FULFILLED {
                js_promise_settle(
                    result_race, PROMISE_FULFILLED, js_promise_get_value(p_race)
                );
                return result_race;
            } elif s_race == PROMISE_REJECTED {
                promise_unmark_unhandled(p_race);
                js_promise_settle(
                    result_race, PROMISE_REJECTED, js_promise_get_value(p_race)
                );
                return result_race;
            } else {
                on_f_race: JSValue = js_object_create_null();
                js_object_set(on_f_race, _race_f_key, js_true());
                js_object_set(on_f_race, _race_res_key, result_race);
                on_r_race: JSValue = js_object_create_null();
                js_object_set(on_r_race, _race_r_key, js_true());
                js_object_set(on_r_race, _race_res_key, result_race);
                js_promise_add_reaction(p_race, on_f_race, on_r_race, js_undefined());
            }
        } else {
            js_promise_settle(result_race, PROMISE_FULFILLED, p_race);
            return result_race;
        }
        i_race = i_race + 1;
    }
    return result_race;
}

def _dn_native_kind_promise_any(
    realm: Realm, this_val: JSValue, args: list[JSValue]
) -> JSValue {
    iter_any: JSValue = js_undefined();
    if len(args) > 0 {
        iter_any = args[0];
    }
    result_any: JSValue = js_promise_create();
    if not js_is_array(iter_any) {
        js_promise_settle(result_any, PROMISE_REJECTED, js_undefined());
        return result_any;
    }
    n_any: int = js_array_len(iter_any);
    errors_any: list[JSValue] = [];
    i_any: int = 0;
    while i_any < n_any {
        p_any: JSValue = js_array_get(iter_any, i_any);
        if js_is_promise(p_any) {
            s_any: int = js_promise_get_state(p_any);
            if s_any == PROMISE_FULFILLED {
                # Input promises passed to any() are subsumed; clear false unhandled flags.
                promise_unmark_unhandled(p_any);
                js_promise_settle(
                    result_any, PROMISE_FULFILLED, js_promise_get_value(p_any)
                );
                return result_any;
            } else {
                promise_unmark_unhandled(p_any);
                errors_any.append(js_promise_get_value(p_any));
            }
        } else {
            js_promise_settle(result_any, PROMISE_FULFILLED, p_any);
            return result_any;
        }
        i_any = i_any + 1;
    }
    k_errors_any: int = str_intern("errors");
    agg_err: JSValue = js_object_create_null();
    js_object_set(agg_err, k_errors_any, js_array_create(errors_any));
    js_promise_settle(result_any, PROMISE_REJECTED, agg_err);
    # All inputs were rejected and absorbed into the aggregate result.
    i_any_clr: int = 0;
    while i_any_clr < n_any {
        p_any_clr: JSValue = js_array_get(iter_any, i_any_clr);
        if js_is_promise(p_any_clr) {
            promise_unmark_unhandled(p_any_clr);
        }
        i_any_clr = i_any_clr + 1;
    }
    return result_any;
}

# PROMISE / PROMISE_THEN / PROMISE_CATCH / PROMISE_FINALLY are handled by the VM;
# the dispatch table entry is a no-op fallback (VM intercepts before reaching call_native).
def _dn_native_kind_promise_noop(
    realm: Realm, this_val: JSValue, args: list[JSValue]
) -> JSValue {
    return js_undefined();
}

"""Promise(...) called as a function — §27.2.3.1 step 1: NewTarget is undefined,
so this is a TypeError. `new Promise(...)` never reaches the dispatch table (the
VM's NEW handler builds the promise), so this entry only ever sees the
no-new form, which previously returned undefined silently."""
def _dn_native_kind_promise_call_no_new(
    realm: Realm, this_val: JSValue, args: list[JSValue]
) -> JSValue {
    vm_throw_native(
        make_type_error("Promise constructor cannot be invoked without 'new'")
    );
    return js_undefined();
}

"""promise.then(onFulfilled?, onRejected?) — §27.2.5.4 PerformPromiseThen.

The VM's CALL_METHOD handler implements `p.then(...)` inline, but that path is
only reached for a direct method call. Reaching `then` any other way —
`Promise.prototype.then.call(p, f)`, `.bind(p)`, `Reflect.apply` — dispatches
through this table, which previously held a no-op: the call silently did
nothing and the returned promise never settled. Implemented here so every call
form behaves identically; the two must stay in sync."""
def _dn_native_kind_promise_then(
    realm: Realm, this_val: JSValue, args: list[JSValue]
) -> JSValue {
    # §27.2.5.4 step 2: PerformPromiseThen requires an actual promise receiver.
    # Returning undefined here let `Promise.prototype.then.call({}, f)` succeed
    # silently instead of throwing.
    if not js_is_promise(this_val) {
        vm_throw_native(
            make_type_error(
                "Method Promise.prototype.then called on incompatible receiver"
            )
        );
        return js_undefined();
    }
    on_f: JSValue = js_undefined();
    on_r: JSValue = js_undefined();
    if len(args) > 0 {
        on_f = args[0];
    }
    if len(args) > 1 {
        on_r = args[1];
    }
    next_p: JSValue = js_promise_create();
    st: int = js_promise_get_state(this_val);
    val: JSValue = js_promise_get_value(this_val);
    if st == PROMISE_FULFILLED {
        scheduler_push_reaction(realm, on_f, on_r, PROMISE_FULFILLED, val, next_p);
    } elif st == PROMISE_REJECTED {
        promise_unmark_unhandled(this_val);
        process_queue_rejection_handled(this_val);
        scheduler_push_reaction(realm, on_f, on_r, PROMISE_REJECTED, val, next_p);
    } else {
        js_promise_add_reaction(this_val, on_f, on_r, next_p);
    }
    return next_p;
}

"""promise.catch(onRejected) — §27.2.5.1, i.e. then(undefined, onRejected).
Same rationale as _dn_native_kind_promise_then."""
def _dn_native_kind_promise_catch(
    realm: Realm, this_val: JSValue, args: list[JSValue]
) -> JSValue {
    on_r: JSValue = js_undefined();
    if len(args) > 0 {
        on_r = args[0];
    }
    return _dn_native_kind_promise_then(realm, this_val, [js_undefined(), on_r]);
}

def _dn_native_kind_set_timeout(
    realm: Realm, this_val: JSValue, args: list[JSValue]
) -> JSValue {
    st_fn: JSValue = js_undefined();
    st_delay: int = 0;
    st_extra: list[JSValue] = [];
    if len(args) > 0 {
        st_fn = args[0];
    }
    if len(args) > 1 {
        if jsv_is_int32(args[1]) {
            st_delay = jsv_to_int32(args[1]);
        } elif jsv_is_double(args[1]) {
            st_delay = int(jsv_to_double(args[1]));
        }
    }
    st_i: int = 2;
    while st_i < len(args) {
        st_extra.append(args[st_i]);
        st_i = st_i + 1;
    }
    tid_st: int = timer_set_timeout(st_fn, st_delay, st_extra);
    return _timer_create_handle(tid_st);
}

