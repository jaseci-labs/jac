def _dn_native_kind_zlib_stream_open(
    realm: Realm, this_val: JSValue, args: list[JSValue]
) -> JSValue {
    if len(args) < 1 {
        return js_int(0);
    }
    wbits: int = 31;
    if jsv_is_int32(args[0]) {
        wbits = jsv_to_int32(args[0]);
    } elif jsv_is_double(args[0]) {
        wbits = jsv_to_int32(args[0]);
    }
    return js_int(zlib_stream_open(wbits));
}

def _dn_native_kind_zlib_stream_feed(
    realm: Realm, this_val: JSValue, args: list[JSValue]
) -> JSValue {
    if len(args) < 3 {
        return jsv_from_string_id(str_intern(""));
    }
    zlib_handle: int = 0;
    if jsv_is_int32(args[0]) {
        zlib_handle = jsv_to_int32(args[0]);
    } elif jsv_is_double(args[0]) {
        zlib_handle = jsv_to_int32(args[0]);
    }
    inp_ptr: int = 0;
    if jsv_is_int32(args[1]) {
        inp_ptr = jsv_to_int32(args[1]);
    } elif jsv_is_double(args[1]) {
        inp_ptr = jsv_to_int32(args[1]);
    }
    inp_len: int = 0;
    if jsv_is_int32(args[2]) {
        inp_len = jsv_to_int32(args[2]);
    } elif jsv_is_double(args[2]) {
        inp_len = jsv_to_int32(args[2]);
    }
    result_str: str = zlib_stream_feed(zlib_handle, inp_ptr, inp_len);
    return jsv_from_string_id(str_intern(result_str));
}

def _dn_native_kind_zlib_stream_close(
    realm: Realm, this_val: JSValue, args: list[JSValue]
) -> JSValue {
    if len(args) < 1 {
        return js_undefined();
    }
    cl_h: int = 0;
    if jsv_is_int32(args[0]) {
        cl_h = jsv_to_int32(args[0]);
    } elif jsv_is_double(args[0]) {
        cl_h = jsv_to_int32(args[0]);
    }
    zlib_stream_close(cl_h);
    return js_undefined();
}

def _dn_native_kind_zlib_inflate_oneshot(
    realm: Realm, this_val: JSValue, args: list[JSValue]
) -> JSValue {
    # __zlib.inflate(ptr, len, wbits) -> str (raw decompressed bytes)
    if len(args) < 3 {
        return jsv_from_string_id(str_intern(""));
    }
    inf_ptr: int = 0;
    if jsv_is_int32(args[0]) {
        inf_ptr = jsv_to_int32(args[0]);
    } elif jsv_is_double(args[0]) {
        inf_ptr = int(jsv_to_double(args[0]));
    }  # 64-bit ptr
    inf_len: int = 0;
    if jsv_is_int32(args[1]) {
        inf_len = jsv_to_int32(args[1]);
    } elif jsv_is_double(args[1]) {
        inf_len = jsv_to_int32(args[1]);
    }
    inf_wbits: int = 31;
    if jsv_is_int32(args[2]) {
        inf_wbits = jsv_to_int32(args[2]);
    } elif jsv_is_double(args[2]) {
        inf_wbits = jsv_to_int32(args[2]);
    }
    inf_out: str = zlib_inflate_oneshot(inf_ptr, inf_len, inf_wbits);
    return jsv_from_string_id(str_intern(inf_out));
}

def _dn_native_kind_zlib_deflate_stream_open(
    realm: Realm, this_val: JSValue, args: list[JSValue]
) -> JSValue {
    # __zlib.dopen(wbits, level) -> handle
    if len(args) < 2 {
        return js_int(0);
    }
    do_wbits: int = 31;
    if jsv_is_int32(args[0]) {
        do_wbits = jsv_to_int32(args[0]);
    } elif jsv_is_double(args[0]) {
        do_wbits = jsv_to_int32(args[0]);
    }
    do_level: int = -1;
    if jsv_is_int32(args[1]) {
        do_level = jsv_to_int32(args[1]);
    } elif jsv_is_double(args[1]) {
        do_level = jsv_to_int32(args[1]);
    }
    return js_int(zlib_deflate_stream_open(do_wbits, do_level));
}

def _dn_native_kind_zlib_deflate_stream_feed(
    realm: Realm, this_val: JSValue, args: list[JSValue]
) -> JSValue {
    # __zlib.dfeed(handle, ptr, len, flush) -> int (bytes produced; output in __zlib.cptr()/clen())
    if len(args) < 4 {
        return jsv_from_int32(0);
    }
    df_h: int = 0;
    if jsv_is_int32(args[0]) {
        df_h = jsv_to_int32(args[0]);
    } elif jsv_is_double(args[0]) {
        df_h = jsv_to_int32(args[0]);
    }
    df_ptr: int = 0;
    if jsv_is_int32(args[1]) {
        df_ptr = jsv_to_int32(args[1]);
    } elif jsv_is_double(args[1]) {
        df_ptr = int(jsv_to_double(args[1]));
    }  # 64-bit ptr
    df_len: int = 0;
    if jsv_is_int32(args[2]) {
        df_len = jsv_to_int32(args[2]);
    } elif jsv_is_double(args[2]) {
        df_len = jsv_to_int32(args[2]);
    }
    df_flush: int = 0;
    if jsv_is_int32(args[3]) {
        df_flush = jsv_to_int32(args[3]);
    } elif jsv_is_double(args[3]) {
        df_flush = jsv_to_int32(args[3]);
    }
    df_produced: int = zlib_deflate_stream_feed(df_h, df_ptr, df_len, df_flush);
    return jsv_from_int32(df_produced);
}

def _dn_native_kind_zlib_deflate_stream_close(
    realm: Realm, this_val: JSValue, args: list[JSValue]
) -> JSValue {
    # __zlib.dclose(handle)
    if len(args) < 1 {
        return js_undefined();
    }
    dc_h: int = 0;
    if jsv_is_int32(args[0]) {
        dc_h = jsv_to_int32(args[0]);
    } elif jsv_is_double(args[0]) {
        dc_h = jsv_to_int32(args[0]);
    }
    zlib_deflate_stream_close(dc_h);
    return js_undefined();
}

def _dn_native_kind_zlib_compress_raw(
    realm: Realm, this_val: JSValue, args: list[JSValue]
) -> JSValue {
    # __zlib.compress(in_ptr, in_len, wbits) -> int (Z_OK=0 on success)
    if len(args) < 3 {
        return jsv_from_int32(0 - 1);
    }
    cr_ptr: int = 0;
    # The input buffer pointer (from __buf.alloc) can exceed the i32 range on
    # 64-bit — JS stores it as a double. jsv_to_int32 TRUNCATED it to 32 bits →
    # deflate read a bogus pointer → empty 20-byte gzip output for ALL inputs
    # (broke gzipSync/deflateSync entirely, e.g. vite's compressed-size report).
    if jsv_is_int32(args[0]) {
        cr_ptr = jsv_to_int32(args[0]);
    } elif jsv_is_double(args[0]) {
        cr_ptr = int(jsv_to_double(args[0]));
    }
    cr_len: int = 0;
    if jsv_is_int32(args[1]) {
        cr_len = jsv_to_int32(args[1]);
    } elif jsv_is_double(args[1]) {
        cr_len = jsv_to_int32(args[1]);
    }
    cr_wbits: int = 15;
    if jsv_is_int32(args[2]) {
        cr_wbits = jsv_to_int32(args[2]);
    } elif jsv_is_double(args[2]) {
        cr_wbits = jsv_to_int32(args[2]);
    }
    cr_rc: int = zlib_compress_raw(cr_ptr, cr_len, cr_wbits);
    return jsv_from_int32(cr_rc);
}

def _dn_native_kind_zlib_deflate_ptr(
    realm: Realm, this_val: JSValue, args: list[JSValue]
) -> JSValue {
    # __zlib.cptr() -> float (pointer — may exceed i32 range)
    return jsv_from_double(float(zlib_deflate_ptr()));
}

def _dn_native_kind_zlib_deflate_len(
    realm: Realm, this_val: JSValue, args: list[JSValue]
) -> JSValue {
    # __zlib.clen() -> int (byte count)
    return jsv_from_int32(zlib_deflate_len());
}

def:priv _dn_ptr_arg(args: list[JSValue], idx: int) -> int {
    # Extract a native pointer/int from JS args. Prefer number coercion so
    # Float64-tagged pointers (from __buf.alloc / cptr) are not bit-truncated.
    if len(args) <= idx {
        return 0;
    }
    if jsv_is_int32(args[idx]) {
        return jsv_to_int32(args[idx]);
    }
    if jsv_is_double(args[idx]) {
        return int(jsv_to_double(args[idx]));
    }
    # A native pointer is always Int32- or Float64-tagged (handled above); any
    # other arg type cannot be a valid pointer → 0. (Avoid int(jsv_to_number(…)):
    # jsv_to_number runs full ToNumber coercion and is not native-lowerable, which
    # would push this whole module into the non-native codespace — E5092.)
    return 0;
}

def _dn_native_kind_zlib_crc32(
    realm: Realm, this_val: JSValue, args: list[JSValue]
) -> JSValue {
    # __zlib.crc32(ptr, len, init) -> int
    ptr: int = _dn_ptr_arg(args, 0);
    length: int = _dn_ptr_arg(args, 1);
    seed: int = _dn_ptr_arg(args, 2);
    return jsv_from_int32(zlib_crc32(seed, ptr, length));
}

