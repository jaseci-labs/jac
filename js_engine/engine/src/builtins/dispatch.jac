    maximum: int = 0 - 1;
    if len(args) >= 3 and not jsv_is_undefined(args[2]) {
        maximum = _dn_ptr_arg(args, 2);
    }
    return js_int(wasm_table_create(elem_kind, initial, maximum));
}

