def _dn_native_kind_date_totemporalinstant(
    realm: Realm, this_val: JSValue, args: list[JSValue]
) -> JSValue {
    time_value: JSValue = js_Date_getTime(this_val);
    if not js_is_date(this_val) {
        return time_value;
    }
    if jsv_is_double(time_value) {
        ms: float = jsv_to_double(time_value);
        if ms != ms {
            vm_throw_native(make_range_error("Invalid time value"));
            return js_undefined();
        }
    }
    return js_Temporal_Instant_fromEpochMilliseconds([time_value]);
}

