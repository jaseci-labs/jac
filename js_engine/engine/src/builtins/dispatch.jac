) -> JSValue {
    if _str_this_not_coercible(this_val, "charAt") {
        return js_undefined();
    }
    if len(args) > 0 {
        return js_str_charAt(this_val, args[0]);
    }
    return js_str_charAt(this_val, js_undefined());
}

