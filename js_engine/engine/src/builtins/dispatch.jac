"""
Native Built-in Dispatch Registry

Provides the encoding, registry, and dispatch switch for all native Jac
functions exposed as callable JS values through the VM.

Encoding scheme (must not collide with vm.vm and builtins.function):
  NATIVE_BASE = 2_000_000
  js_native_val(idx)  → JSValue{tag=Object, as_ptr=-(NATIVE_BASE + idx + 1)}
  is_native_val(v)    → v.tag == Object and jsv_to_table_id(v) < 0
                        and -(jsv_to_table_id(v)+1) >= NATIVE_BASE
  get_native_idx(v)   → -(jsv_to_table_id(v)+1) - NATIVE_BASE
  get_native_kind(v)  → _NATIVE_TABLE[get_native_idx(v)].kind

Kind constants (stable dispatch IDs):
  1-16 : console.*
  17-22: global numeric/string utility functions
  23-24: String / Boolean constructors
  25-26: Object / Array constructors
  27-31: eval / queueMicrotask / URI functions
  32-36: Error family constructors

Bun Zig mapping:
  VirtualMachine.callBuiltin  — bun/src/bun.js/VirtualMachine.zig
  ConsoleObject.call          — bun/src/bun.js/ConsoleObject.zig
"""

import from engine.src.runtime.jsvalue {
    JSValue,
