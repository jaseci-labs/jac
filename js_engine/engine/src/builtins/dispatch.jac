"""ToObject(this) for array methods — box primitives, leave null/undefined for TypeError."""
def _dn_array_this(this_val: JSValue) -> JSValue {
    if jsv_is_null(this_val) or jsv_is_undefined(this_val) {
        return this_val;
    }
    # Keep in sync with _vm_array_to_object in vm.na.jac (cannot import vm — cycle).
    if jsv_is_any_object(this_val) {
        return this_val;
    }
    if jsv_is_bool(this_val) {
        return js_Boolean_new([this_val]);
    }
