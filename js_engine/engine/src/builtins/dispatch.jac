def _dn_native_kind_regexp_test(
    realm: Realm, this_val: JSValue, args: list[JSValue]
) -> JSValue {
    # ES §22.2.6.16: RequireInternalSlot(R, [[RegExpMatcher]]) — a non-RegExp
    # receiver throws rather than silently reporting "no match".
    if not js_is_regexp(this_val) {
        vm_throw_native(
            make_type_error("RegExp.prototype.test called on incompatible receiver")
        );
        return js_undefined();
    }
    sa0_rt: JSValue = js_undefined();
    if len(args) > 0 {
        sa0_rt = args[0];
    }
    return js_regexp_test(this_val, sa0_rt);
}

def _dn_native_kind_regexp_exec(
    realm: Realm, this_val: JSValue, args: list[JSValue]
) -> JSValue {
    # ES §22.2.6.8: RequireInternalSlot(R, [[RegExpMatcher]]).
    if not js_is_regexp(this_val) {
        vm_throw_native(
            make_type_error("RegExp.prototype.exec called on incompatible receiver")
        );
        return js_undefined();
    }
    sa0_re2: JSValue = js_undefined();
    if len(args) > 0 {
        sa0_re2 = args[0];
    }
    return js_regexp_exec(this_val, sa0_re2);
}

