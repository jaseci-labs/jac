def _dn_native_kind_symbol(
    realm: Realm, this_val: JSValue, args: list[JSValue]
) -> JSValue {
    # Symbol(description?) — each call produces a unique symbol.
    # §20.4.1.1 step 2: descString is ToString(description) when description is
    # not undefined, so a Symbol argument throws (ToString on a Symbol is a
    # TypeError) and an object argument runs its toString.
    # No argument / undefined → a description-less symbol (sentinel so `.description`
    # returns undefined, distinct from `Symbol("")` whose description is "").
    sym_desc: str = _SYMBOL_NO_DESC;
    if len(args) > 0 {
        sym_arg: JSValue = args[0];
        if jsv_is_symbol(sym_arg) {
            vm_throw_native(
                make_type_error("Cannot convert a Symbol value to a string")
            );
            return js_undefined();
        }
        if not jsv_is_undefined(sym_arg) {
            if jsv_is_object_cell(sym_arg) {
                sym_desc = js_to_string_observable(sym_arg);
            } else {
                sym_desc = js_coerce_to_string(sym_arg);
            }
            if vm_has_native_exc() {
                return js_undefined();
            }
        }
    }
    return js_symbol(realm, sym_desc);
}

def _dn_native_kind_symbol_for(
    realm: Realm, this_val: JSValue, args: list[JSValue]
) -> JSValue {
    sym_key: str = "";
    if len(args) > 0 {
        sym_fa: JSValue = args[0];
        if jsv_is_string_cell(sym_fa) {
            sym_key = str_from_id(jsv_to_table_id(sym_fa));
        } elif jsv_is_int32(sym_fa) {
            sym_key = str(jsv_to_int32(sym_fa));
        }
    }
    return js_symbol_for(realm, sym_key);
}

def _dn_native_kind_symbol_keyfor(
    realm: Realm, this_val: JSValue, args: list[JSValue]
) -> JSValue {
    # §20.4.2.6 step 1: a non-Symbol argument is a TypeError (including when the
    # argument is absent — undefined is not a Symbol).
    sym_kfv: JSValue = js_undefined();
    if len(args) > 0 {
        sym_kfv = args[0];
    }
    if not jsv_is_symbol(sym_kfv) {
        vm_throw_native(make_type_error("Symbol.keyFor requires a symbol argument"));
        return js_undefined();
    }
    sym_kf_res: str = js_symbol_key_for(realm, sym_kfv);
    if sym_kf_res != "" {
        return jsv_from_string_id(str_intern(sym_kf_res));
    }
    return js_undefined();
}

"""thisSymbolValue (ES §20.4.3): unwrap a Symbol primitive or Symbol wrapper
object; any other receiver is a TypeError."""
def _this_symbol_value(realm: Realm, this_val: JSValue, method: str) -> JSValue {
    if jsv_is_symbol(this_val) {
        return this_val;
    }
    # A Symbol wrapper object (Object(sym)) unwraps to its [[SymbolData]], stored under
    # [[PrimitiveValue]] — thisSymbolValue accepts it (§20.4.3).
    if jsv_is_object_cell(this_val) {
        prim_key: int = str_intern("[[PrimitiveValue]]");
        if js_object_has_own(this_val, prim_key) {
            wrapped: JSValue = js_object_get(this_val, prim_key);
            if jsv_is_symbol(wrapped) {
                return wrapped;
            }
        }
    }
    vm_throw_native(
        make_type_error(
            "Symbol.prototype." + method + " requires that 'this' be a Symbol"
        )
    );
    return js_undefined();
}

def _dn_native_kind_symbol_tostring(
    realm: Realm, this_val: JSValue, args: list[JSValue]
) -> JSValue {
    sym_ts: JSValue = _this_symbol_value(realm, this_val, "toString");
    if vm_has_native_exc() {
        return js_undefined();
    }
    return jsv_from_string_id(str_intern(symbol_to_str(realm, sym_ts)));
}

def _dn_native_kind_symbol_valueof(
    realm: Realm, this_val: JSValue, args: list[JSValue]
) -> JSValue {
    return _this_symbol_value(realm, this_val, "valueOf");
}

"""get Symbol.prototype.description (§20.4.3.2) — undefined when the symbol was
created with no description argument."""
def _dn_native_kind_symbol_description(
    realm: Realm, this_val: JSValue, args: list[JSValue]
) -> JSValue {
    sym_d: JSValue = _this_symbol_value(realm, this_val, "description");
    if vm_has_native_exc() {
        return js_undefined();
    }
    d: str = symbol_description(realm, sym_d);
    # The no-description sentinel → undefined; a genuine "" description → "".
    if d == _SYMBOL_NO_DESC {
        return js_undefined();
    }
    return jsv_from_string_id(str_intern(d));
}


def _dn_native_kind_array_iter(
    realm: Realm, this_val: JSValue, args: list[JSValue]
) -> JSValue {
    # arr[Symbol.iterator]() / str[Symbol.iterator]() — return a fresh iterator
    return js_make_iterator(this_val);
}

def _dn_native_kind_str_iter(
    realm: Realm, this_val: JSValue, args: list[JSValue]
) -> JSValue {
    # String.prototype[@@iterator] — §22.1.3.34: RequireObjectCoercible(this) then
    # ToString(this). A null/undefined receiver throws; a coercible one iterates
    # the code points of its string value (a throwing toString propagates).
    if _str_this_not_coercible(this_val, "[Symbol.iterator]") {
        return js_undefined();
    }
    s_it: JSValue = string_value_of(this_val);
    if vm_has_native_exc() {
        return js_undefined();
    }
    return js_make_iterator(s_it);
}

