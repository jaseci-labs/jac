def _dn_native_kind_err_proto_tostring(
    realm: Realm, this_val: JSValue, args: list[JSValue]
) -> JSValue {
    # ECMAScript §20.5.3.4  Error.prototype.toString()
    # Returns "ErrorName" or "ErrorName: message"
    k_name_e: int = str_intern("name");
    k_msg_e: int = str_intern("message");
    n_val: JSValue = js_object_get(this_val, k_name_e);
    m_val: JSValue = js_object_get(this_val, k_msg_e);
    n_str: str = "Error";
    if jsv_is_string_cell(n_val) {
        n_str = str_from_id(jsv_to_table_id(n_val));
    }
    m_str: str = "";
    if jsv_is_string_cell(m_val) {
        m_str = str_from_id(jsv_to_table_id(m_val));
    }
    ts_err: str = n_str;
    if m_str != "" {
        ts_err = n_str + ": " + m_str;
    }
    return jsv_from_string_id(str_intern(ts_err));
    # ── Array prototype methods ─────────────────────────────────────────────
}

