"""Create a Node-style timer handle object with .unref() / .ref() (Vite V-04)."""
def _timer_create_handle(tid: int) -> JSValue {
    handle: JSValue = js_object_create_null();
    js_object_set(handle, WK_TIMER_ID, js_int(tid));
    js_object_set(
        handle, WK_UNREF, js_native_create("unref", 0, NATIVE_KIND_TIMER_UNREF)
    );
    js_object_set(handle, WK_REF, js_native_create("ref", 0, NATIVE_KIND_TIMER_REF));
    return handle;
}

"""Resolve timer id from numeric handle or timer object."""
def _timer_resolve_id(arg: JSValue) -> int {
    if jsv_is_int32(arg) {
        return jsv_to_int32(arg);
    }
    if jsv_is_double(arg) {
        return int(jsv_to_double(arg));
    }
    if jsv_is_object_cell(arg) {
        id_val: JSValue = js_object_get(arg, WK_TIMER_ID);
        if jsv_is_int32(id_val) {
            return jsv_to_int32(id_val);
        }
        if jsv_is_double(id_val) {
            return int(jsv_to_double(id_val));
        }
    }
    return 0;
}

"""Coerce the first argument to a message string for error constructors."""
def _args_to_message(args: list[JSValue]) -> str {
    # ES §20.5.1.1 step 3: an absent OR undefined message installs nothing, so
    # the inherited Error.prototype.message ("") stays visible. Any other value
    # goes through observable ToString, which runs a user toString/valueOf and
    # throws TypeError for a Symbol.
    if len(args) == 0 {
        return "";
    }
    if jsv_is_undefined(args[0]) {
        return "";
    }
    if jsv_is_symbol(args[0]) {
        vm_throw_native(make_type_error("Cannot convert a Symbol value to a string"));
        return "";
    }
    if jsv_is_object_cell(args[0]) {
        return js_to_string_observable(args[0]);
    }
    return js_coerce_to_string(args[0]);
}

"""ES §20.5.8.1 InstallErrorCause for the native Error constructors.

`new Error(msg, { cause })` installs an own { w:T, e:F, c:T } `cause`. The
property is installed only when the options argument is an object that HAS a
"cause" key — `new Error(m, {})` must not create one."""
def _install_error_cause(err: JSValue, args: list[JSValue]) -> None {
    if len(args) < 2 {
        return;
    }
    opts: JSValue = args[1];
    if not jsv_is_object_cell(opts) {
        return;
    }
    k_cause: int = str_intern("cause");
    if not js_object_has(opts, k_cause) {
        return;
    }
    js_object_define_property(
        err,
        k_cause,
        JSProperty(
            key=k_cause,
            value=js_object_get(opts, k_cause),
            writable=True,
            enumerable=False,
            configurable=True,
            deleted=False
        )
    );
}
