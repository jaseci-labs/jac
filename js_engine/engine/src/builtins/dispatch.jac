def _dn_native_kind_str_match(
    realm: Realm, this_val: JSValue, args: list[JSValue]
) -> JSValue {
    if _str_this_not_coercible(this_val, "match") {
        return js_undefined();
    }
    sa0_sm: JSValue = js_undefined();
    if len(args) > 0 {
        sa0_sm = args[0];
    }
    sm_f: JSValue = js_regexp_fast_str_match(this_val, sa0_sm);
    if not jsv_is_hole(sm_f) {
        return sm_f;
    }
    # §22.1.3.11 step 2: GetMethod(regexp, @@match) — a custom matcher wins.
    sm_h: tuple[bool, JSValue] = _str_symbol_method(sa0_sm, SYMBOL_MATCH, this_val, []);
    if sm_h[0] {
        return sm_h[1];
    }
    # §22.1.3.11 steps 3-4: wrap a non-RegExp (or a RegExp lacking own @@match) in
    # `rx = RegExpCreate(regexp)` then `return Invoke(rx, @@match, «S»)`. Invoke —
    # NOT the native matcher — so a user-overridden RegExp.prototype[@@match] runs
    # (invoke-builtin-match). Fall back to the native matcher only if the created rx
    # somehow has no callable @@match.
    sm_rx: JSValue = js_coerce_regexp(sa0_sm);
    if vm_has_native_exc() {
        return js_undefined();
    }
    # Invoke(rx, @@match, «S») where S = ToString(O) — a String-object receiver must
    # pass its PRIMITIVE string (invoke-builtin-match-searcher-undef analog).
    sm_S: JSValue = string_value_of(this_val);
    sm_rxh: tuple[bool, JSValue] = _str_symbol_method(sm_rx, SYMBOL_MATCH, sm_S, []);
    if sm_rxh[0] {
        return sm_rxh[1];
    }
    return js_str_match_re(this_val, sm_rx);
}

def _dn_native_kind_str_matchall(
    realm: Realm, this_val: JSValue, args: list[JSValue]
) -> JSValue {
    if _str_this_not_coercible(this_val, "matchAll") {
        return js_undefined();
    }
    sa0_sma: JSValue = js_undefined();
    if len(args) > 0 {
        sa0_sma = args[0];
    }
    # §22.1.3.13 step 2: IsRegExp(regexp) && flags lacks "g" → TypeError, before
    # the @@matchAll lookup.
    if _str_regexp_requires_global(sa0_sma, "matchAll") {
        return js_undefined();
    }
    # step 3: GetMethod(regexp, @@matchAll).
    sma_h: tuple[bool, JSValue] = _str_symbol_method(
        sa0_sma, SYMBOL_MATCH_ALL, this_val, []
    );
    if sma_h[0] {
        return sma_h[1];
    }
    # Fallback: a non-RegExp is wrapped in `new RegExp(regexp, "g")`.
    if js_is_regexp(sa0_sma) {
        return js_str_matchAll_re(this_val, sa0_sma);
    }
    ma_pat: str = "";
    if jsv_is_undefined(sa0_sma) {
        ma_pat = "";
    } else {
        ma_pat = js_coerce_to_string(sa0_sma);
    }
    return js_str_matchAll_re(this_val, js_regexp_create(ma_pat, "g"));
}

def _dn_native_kind_str_search(
    realm: Realm, this_val: JSValue, args: list[JSValue]
) -> JSValue {
    if _str_this_not_coercible(this_val, "search") {
        return js_undefined();
    }
    sa0_ss: JSValue = js_undefined();
    if len(args) > 0 {
        sa0_ss = args[0];
    }
    ss_f: JSValue = js_regexp_fast_str_search(this_val, sa0_ss);
    if not jsv_is_hole(ss_f) {
        return ss_f;
    }
    # §22.1.3.17 step 2: GetMethod(regexp, @@search).
    ss_h: tuple[bool, JSValue] = _str_symbol_method(
        sa0_ss, SYMBOL_SEARCH, this_val, []
    );
    if ss_h[0] {
        return ss_h[1];
    }
    # steps 3-4: rx = RegExpCreate(regexp); return Invoke(rx, @@search, «S») — so a
    # user-overridden RegExp.prototype[@@search] runs (invoke-builtin-search).
    ss_rx: JSValue = js_coerce_regexp(sa0_ss);
    if vm_has_native_exc() {
        return js_undefined();
    }
    # Invoke(rx, @@search, «S») where S = ToString(O) — pass the primitive string for
    # a String-object receiver (invoke-builtin-search-searcher-undef).
    ss_S: JSValue = string_value_of(this_val);
    ss_rxh: tuple[bool, JSValue] = _str_symbol_method(ss_rx, SYMBOL_SEARCH, ss_S, []);
    if ss_rxh[0] {
        return ss_rxh[1];
    }
    return js_str_search_re(this_val, ss_rx);
}

