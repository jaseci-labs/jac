def _dn_native_kind_process_emit(
    realm: Realm, this_val: JSValue, args: list[JSValue]
) -> JSValue {
    # process.emit(event, ...args) — schedule all listeners via nextTick
    if len(args) >= 1 {
        ev_str: str = str_from_id(jsv_to_table_id(args[0]));
        em_warn_args: list[JSValue] = [];
        em_idx: int = 1;
        while em_idx < len(args) {
            em_warn_args.append(args[em_idx]);
            em_idx = em_idx + 1;
        }
        if ev_str == "warning" {
            wl: list[int] = process_get_warning_listeners();
            wo: list[int] = process_get_warning_once();
            em_li: int = 0;
            while em_li < len(wl) {
                em_fn: JSValue = wl[em_li];
                scheduler_push_next_tick(realm, em_fn, em_warn_args);
                em_li = em_li + 1;
            }
        } else {
            # Generic user-defined event listeners
            gl: list[int] = process_get_generic_listeners(ev_str);
            em_li: int = 0;
            while em_li < len(gl) {
                gm_fn: JSValue = gl[em_li];
                scheduler_push_next_tick(realm, gm_fn, em_warn_args);
                em_li = em_li + 1;
            }
        }
    }
    return js_undefined();
}

def _dn_native_kind_process_emit_warning(
    realm: Realm, this_val: JSValue, args: list[JSValue]
) -> JSValue {
    # process.emitWarning(message[, type[, code[, ctor]]]) or process.emitWarning(warningObj)
    ew_msg: str = "Warning";
    ew_type: str = "Warning";
    ew_code: str = "";
    ew_obj: JSValue = js_undefined();
    if len(args) >= 1 {
        if jsv_is_object_cell(args[0]) {
            ew_src: JSValue = args[0];
            ew_mprop: JSValue = js_object_get(ew_src, str_intern("message"));
            if not jsv_is_undefined(ew_mprop) {
                ew_msg = str_from_id(jsv_to_table_id(ew_mprop));
            }
            ew_nprop: JSValue = js_object_get(ew_src, str_intern("name"));
            if not jsv_is_undefined(ew_nprop) {
                ew_type = str_from_id(jsv_to_table_id(ew_nprop));
            }
            ew_obj = js_object_create_null();
            js_object_set(
                ew_obj, str_intern("message"), jsv_from_string_id(str_intern(ew_msg))
            );
            js_object_set(
                ew_obj, str_intern("name"), jsv_from_string_id(str_intern(ew_type))
            );
            js_object_set(ew_obj, str_intern("stack"), js_undefined());
            ew_emprop: JSValue = js_object_get(ew_src, str_intern("emitter"));
            if not jsv_is_undefined(ew_emprop) {
                js_object_set(ew_obj, str_intern("emitter"), ew_emprop);
            }
            ew_tprop: JSValue = js_object_get(ew_src, str_intern("type"));
            if not jsv_is_undefined(ew_tprop) {
                js_object_set(ew_obj, str_intern("type"), ew_tprop);
            }
            ew_cprop: JSValue = js_object_get(ew_src, str_intern("count"));
            if not jsv_is_undefined(ew_cprop) {
                js_object_set(ew_obj, str_intern("count"), ew_cprop);
            }
            ew_codeprop: JSValue = js_object_get(ew_src, str_intern("code"));
            if not jsv_is_undefined(ew_codeprop) {
                js_object_set(ew_obj, str_intern("code"), ew_codeprop);
                if jsv_is_string_cell(ew_codeprop) {
                    ew_code = str_from_id(jsv_to_table_id(ew_codeprop));
                }
            }
        } else {
            ew_msg = str_from_id(jsv_to_table_id(args[0]));
        }
    }
    if ew_obj == js_undefined() {
        if len(args) >= 2 {
            if not jsv_is_undefined(args[1]) {
                ew_type = str_from_id(jsv_to_table_id(args[1]));
            }
        }
        if len(args) >= 3 {
            if not jsv_is_undefined(args[2]) {
                ew_code = str_from_id(jsv_to_table_id(args[2]));
            }
        }
        ew_obj = process_build_warning_obj(ew_msg, ew_type);
        # warning.code — tests (common.expectWarning) match DEP*/ExperimentalWarning codes.
        if len(ew_code) > 0 {
            js_object_set(
                ew_obj, str_intern("code"), jsv_from_string_id(str_intern(ew_code))
            );
        }
    }
    # --no-deprecation silences deprecations; --throw-deprecation raises them (Node).
    if ew_type == "DeprecationWarning" {
        if process_get_no_deprecation() {
            return js_undefined();
        }
        if process_get_throw_deprecation() {
            ew_err: JSValue = make_error(ew_msg);
            js_object_set(
                ew_err,
                str_intern("name"),
                jsv_from_string_id(str_intern("DeprecationWarning"))
            );
            if len(ew_code) > 0 {
                js_object_set(
                    ew_err, str_intern("code"), jsv_from_string_id(str_intern(ew_code))
                );
            }
            vm_throw_native(ew_err);
            return js_undefined();
        }
    }
    # --no-warnings silences the stderr report; 'warning' listeners still fire (Node).
    if not process_get_no_warnings() {
        ew_stderr: str = "(node:"
            + str(process_get_pid())
            + ") ["
            + ew_code
            + "] "
            + ew_type
            + ": "
            + ew_msg
            + "\n";
        process_stderr_write([jsv_from_string_id(str_intern(ew_stderr))]);
    }
    ew_wl: list[int] = process_get_warning_listeners();
    ew_li: int = 0;
    ew_emit_args: list[JSValue] = [];
    ew_emit_args.append(ew_obj);
    while ew_li < len(ew_wl) {
        ew_fn: JSValue = ew_wl[ew_li];
        scheduler_push_next_tick(realm, ew_fn, ew_emit_args);
        ew_li = ew_li + 1;
    }
    return js_undefined();
}

