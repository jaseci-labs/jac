# ══════════════════════════════════════════════════════════════════════════════
# Debug tracing
# ══════════════════════════════════════════════════════════════════════════════

"""Set to True to enable native-dispatch trace output."""
glob DISPATCH_DEBUG_MODE: bool = False;

"""Print msg when DISPATCH_DEBUG_MODE is True."""
def dispatch_debug(msg: str) {
    if DISPATCH_DEBUG_MODE {
        print("[DISPATCH]", msg);
    }
}

def _dispatch_value_is_callable(v: JSValue) -> bool {
    return spec_is_callable(v);
}

# ══════════════════════════════════════════════════════════════════════════════
# 2.  Dispatch
# ══════════════════════════════════════════════════════════════════════════════

"""
Central dispatch — O(1) dict lookup into _DISPATCH_TABLE.
The table is populated once by init_dispatch_table(), called from global_context_create().
"""
def:pub call_native(
    realm: Realm,
    kind: int,
    this_val: JSValue,
    args: list[JSValue],
    native_fn: JSValue = js_undefined()
) -> JSValue {
    # Debug string is built only in debug mode (it was concatenated on EVERY
    # native call). The Temporal callee pin (gc_unpin = linear scan of the pin
    # list) is only needed by Temporal natives (kinds 700..856).
    if DISPATCH_DEBUG_MODE {
        dispatch_debug("call_native kind=" + str(kind) + "  nargs=" + str(len(args)));
    }
    if kind >= 700 and kind <= 856 and is_native_val(native_fn) {
        temporal_set_callee(native_fn);
    }
    if kind not in _DISPATCH_TABLE {
        return js_undefined();
    }
    h: Callable[[Realm, JSValue, list[JSValue]], JSValue] = _DISPATCH_TABLE[kind];
    return h(realm, this_val, args);
}

# ══════════════════════════════════════════════════════════════════════════════
# 3.  Per-kind handler functions  (_dn_<kind_name>)
#     Uniform signature: (realm: Realm, this_val: JSValue, args: list[JSValue]) -> JSValue
#     Bodies are identical to the original elif branches — zero logic change.
# ══════════════════════════════════════════════════════════════════════════════

def _dn_native_kind_console_log(
    realm: Realm, this_val: JSValue, args: list[JSValue]
) -> JSValue {
    return js_console_log(args);
}

