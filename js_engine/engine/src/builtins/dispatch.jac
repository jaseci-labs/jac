def _dn_native_kind_wasm_instantiate_imports(
    realm: Realm, this_val: JSValue, args: list[JSValue]
) -> JSValue {
    # __wasm.instantiateImports(modH) -> instHandle (0 on error). Uses the store +
    # imports array built by importsBegin/importsAdd*.
    mod_h: int = _dn_ptr_arg(args, 0);
    return js_int(wasm_instantiate_with_imports(mod_h));
}

def _dn_native_kind_wasm_bind_func_kinds(
    realm: Realm, this_val: JSValue, args: list[JSValue]
) -> JSValue {
    # __wasm.bindFuncKinds(fh) -> [nparams, nresults, pk..., rk...] as Numbers.
    # Lets the JS shim know whether a func result is i64 (→ BigInt) etc.
    f_h: int = _dn_ptr_arg(args, 0);
    np: int = wasm_func_param_count(f_h);
    if np < 0 {
        return js_array_create([]);
    }
    out: list[JSValue] = [];
    out.append(js_int(np));
    # result kinds are not directly exposed; reconstruct via a probe call would be
    # heavy — instead the shim only needs param kinds for arg marshalling, which
    # the dispatch invoke path already handles. Return [np] + param kinds.
    i: int = 0;
    while i < np {
        out.append(js_int(wasm_func_param_kind(f_h, i)));
        i = i + 1;
    }
    return js_array_create(out);
}

