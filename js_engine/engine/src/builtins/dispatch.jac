def _dn_native_kind_dns_lookup(
    realm: Realm, this_val: JSValue, args: list[JSValue]
) -> JSValue {
    hv: JSValue = js_undefined();
    fam: int = 0;
    hints: int = 0;
    ord_s: str = dns_get_default_result_order();
    if len(args) > 0 {
        hv = args[0];
    }
    if len(args) > 1 and jsv_is_int32(args[1]) {
        fam = jsv_to_int32(args[1]);
    }
    if len(args) > 2 and jsv_is_int32(args[2]) {
        hints = jsv_to_int32(args[2]);
    }
    if len(args) > 3 and jsv_is_string_cell(args[3]) {
        ord_s = str_from_id(jsv_to_table_id(args[3]));
    }
    return dns_lookup(hv, fam, hints, ord_s);
}

