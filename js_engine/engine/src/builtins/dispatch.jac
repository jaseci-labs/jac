}

def _dn_native_kind_bigint(
    realm: Realm, this_val: JSValue, args: list[JSValue]
) -> JSValue {
    # BigInt(n) — primitive-only fallback.  Object arguments (@@toPrimitive /
    # valueOf / toString) are handled by the VM obs_to_bigint path in
    # _vm_call_native_proxy_aware (NATIVE_KIND_BIGINT special-case).
    if len(args) == 0 {
        return js_bigint_from_decimal_str("0");
    }
    return js_bigint_from_primitive(args[0], True);
}

"""Unwrap primitive BigInt or Object-boxed BigInt ([[PrimitiveValue]])."""
def _bigint_this_primitive(this_val: JSValue) -> JSValue {
    if jsv_is_bigint_cell(this_val) {
        return this_val;
    }
    if jsv_is_object_cell(this_val) {
        pv: JSValue = js_object_get(this_val, str_intern("[[PrimitiveValue]]"));
        if jsv_is_bigint_cell(pv) {
            return pv;
        }
    }
    return js_undefined();
}

def _dn_native_kind_bigint_tostring(
    realm: Realm, this_val: JSValue, args: list[JSValue]
) -> JSValue {
    bi_this: JSValue = _bigint_this_primitive(this_val);
    if not jsv_is_bigint_cell(bi_this) {
        vm_throw_native(
            make_type_error(
                "BigInt.prototype.toString requires that 'this' be a BigInt"
            )
        );
        return js_undefined();
    }
    this_val = bi_this;
    radix: int = 10;
    # Spec: If radix is undefined, let radixNumber be 10; else ToIntegerOrInfinity(radix).
    if len(args) > 0 and not jsv_is_undefined(args[0]) {
        rv: JSValue = args[0];
        if jsv_is_symbol(rv) {
            vm_throw_native(
                make_type_error("Cannot convert a Symbol value to a number")
            );
            return js_undefined();
        }
        if jsv_is_bigint_cell(rv) {
            vm_throw_native(
                make_type_error("Cannot convert a BigInt value to a number")
            );
            return js_undefined();
        }
        # null → 0, false → 0, true → 1 (ToNumber); out-of-range → RangeError below.
        if jsv_is_null(rv) {
            radix = 0;
        } elif jsv_is_bool(rv) {
            if jsv_to_bool(rv) {
                radix = 1;
            } else {
                radix = 0;
            }
        } elif jsv_is_int32(rv) {
            radix = jsv_to_int32(rv);
        } elif jsv_is_double(rv) {
            d: float = jsv_to_double(rv);
            if d != d {
                radix = 0;
            } elif d == MATH_INF or d == MATH_NEG_INF {
                radix = 0;
            } elif d < 0.0 {
                radix = int(d) - 1 if d != float(int(d)) else int(d);
            } else {
                radix = int(d);
            }
        } else {
            # Strings / objects: ToNumber via Number(argument).
            num_v: JSValue = js_Number_call([rv]);
            if vm_has_native_exc() {
                return js_undefined();
            }
            if jsv_is_int32(num_v) {
                radix = jsv_to_int32(num_v);
            } elif jsv_is_double(num_v) {
                dn: float = jsv_to_double(num_v);
                if dn != dn or dn == MATH_INF or dn == MATH_NEG_INF {
                    radix = 0;
                } elif dn < 0.0 {
                    radix = int(dn) - 1 if dn != float(int(dn)) else int(dn);
                } else {
                    radix = int(dn);
                }
            } else {
                radix = 0;
            }
        }
    }
    return js_bigint_to_string(this_val, radix);
}

def _dn_native_kind_bigint_valueof(
    realm: Realm, this_val: JSValue, args: list[JSValue]
) -> JSValue {
    bi_vo: JSValue = _bigint_this_primitive(this_val);
    if jsv_is_bigint_cell(bi_vo) {
        return bi_vo;
    }
    vm_throw_native(
        make_type_error("BigInt.prototype.valueOf requires that 'this' be a BigInt")
    );
    return js_undefined();
}

def _dn_native_kind_bigint_tolocalestring(
    realm: Realm, this_val: JSValue, args: list[JSValue]
) -> JSValue {
    return _dn_native_kind_bigint_tostring(realm, this_val, args);
}

def _dn_native_kind_string(
    realm: Realm, this_val: JSValue, args: list[JSValue]
) -> JSValue {
    if len(args) > 0 and jsv_is_symbol(args[0]) {
        return jsv_from_string_id(str_intern(symbol_to_str(realm, args[0])));
    }
    # String(fn) → Function.prototype.toString source form (ES §22.1.1.1 → ToString
    # → §20.2.3.5).  js_coerce_to_string can't see function names, so build it here
    # (dispatch has realm access) — matching the VM's _fn_to_string_value so a
    # computed key `{ [fn]: 1 }` and `o[String(fn)]` resolve to the same property.
    if len(args) > 0 {
        str_fn_arg: JSValue = args[0];
        str_fn_name: str = "";
        str_is_fn: bool = False;
        if jsv_is_cell(str_fn_arg)
            and jsv_cell_kind(str_fn_arg) == JS_CELL_KIND_NATIVE {
            str_fn_cid: int = jsv_to_table_id(str_fn_arg);
            if str_fn_cid >= 0 and str_fn_cid < NATIVE_BASE {
                str_is_fn = True;
                if str_fn_cid < len(realm.closures) {
                    # Prefer the preserved source text (ES §20.2.3.5) so String(fn)
                    # matches fn.toString() and computed-key ToString — a user
                    # function must stringify to its SOURCE, not "[native code]".
                    str_fn_src: str = realm.closures[str_fn_cid].func.source;
                    if len(str_fn_src) > 0 {
                        return jsv_from_string_id(str_intern(str_fn_src));
                    }
                    str_fn_name = realm.closures[str_fn_cid].func.name;
                }
            } elif is_native_val(str_fn_arg) {
                str_is_fn = True;
                str_fn_name = get_native_name(str_fn_arg);
            }
        }
        if str_is_fn {
            if str_fn_name == "" or str_fn_name.find(" ") >= 0 {
                return jsv_from_string_id(str_intern("function () { [native code] }"));
            }
            return jsv_from_string_id(
                str_intern("function " + str_fn_name + "() { [native code] }")
            );
        }
    }
    return js_String_call(args);
}

