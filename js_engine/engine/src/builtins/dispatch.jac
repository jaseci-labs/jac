    jsv_from_string_id,
    jsv_from_int32,
    jsv_from_double,
    jsv_from_bool,
    jsv_is_int32,
    jsv_to_int32,
    jsv_is_double,
    jsv_to_double,
    jsv_is_bool,
    jsv_is_null,
    jsv_is_object_cell,
    jsv_is_string_cell,
    jsv_is_undefined,
    jsv_is_any_object,
    jsv_to_bool,
    jsv_to_table_id,
    jsv_is_cell,
    jsv_cell_kind,
    JS_CELL_KIND_NATIVE,
    jsv_is_bigint_cell,
    JS_CELL_KIND_BIGINT,
    jsv_from_cell_kind,
    jsv_is_symbol,
    jsv_coerce_to_str,
    jsv_coerce_to_bool,
    MATH_INF,
    MATH_NEG_INF,
