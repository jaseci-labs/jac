    realm: Realm, this_val: JSValue, args: list[JSValue]
) -> JSValue {
    tr_id: int = _timer_resolve_id(this_val);
    if tr_id != 0 {
        timer_ref(tr_id);
    }
    return this_val;
}

def _dn_native_kind_module_is_builtin(
    realm: Realm, this_val: JSValue, args: list[JSValue]
) -> JSValue {
    if len(args) > 0 and jsv_is_string_cell(args[0]) {
        mod_nm: str = str_from_id(jsv_to_table_id(args[0]));
        return js_boolean(is_builtin_module(mod_nm));
    }
    return js_false();
}

def _dn_native_kind_module_noop(
    realm: Realm, this_val: JSValue, args: list[JSValue]
) -> JSValue {
    return js_undefined();
}

"""nextResolve trampoline handed to module.registerHooks resolve hooks: marks
the chain's next-called flag (contract satisfied) and returns a default
resolution record. The require path performs the actual resolution."""
def _dn_native_kind_module_hook_next(
    realm: Realm, this_val: JSValue, args: list[JSValue]
) -> JSValue {
    module_hook_next_mark();
    hn_res: JSValue = js_object_create_null();
    hn_url: str = "";
    if len(args) > 0 and jsv_is_string_cell(args[0]) {
        hn_url = str_from_id(jsv_to_table_id(args[0]));
    }
    js_object_set(hn_res, str_intern("url"), jsv_from_string_id(str_intern(hn_url)));
    js_object_set(hn_res, str_intern("shortCircuit"), js_true());
    return hn_res;
}

"""registerHooks handle.deregister() — clears this registration's resolve slot."""
def _dn_native_kind_module_hooks_deregister(
    realm: Realm, this_val: JSValue, args: list[JSValue]
) -> JSValue {
    hd_slot_v: JSValue = js_object_get(this_val, str_intern("__hook_slot"));
    if jsv_is_int32(hd_slot_v) {
        module_hooks_clear_slot(jsv_to_int32(hd_slot_v));
    }
    return js_undefined();
}

