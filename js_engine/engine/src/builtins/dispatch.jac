def _dn_native_kind_obj_define_property(
    realm: Realm, this_val: JSValue, args: list[JSValue]
) -> JSValue {
    if len(args) >= 3 {
        dp_target: JSValue = args[0];
        dp_orig: JSValue = dp_target;
        # ECMAScript: functions are objects — redirect onto the closure's
        # fn_props backing object when Object.defineProperty is called on a fn.
        # A JS closure is JS_CELL_KIND_NATIVE with table-id < 1_000_000.
        if jsv_is_cell(dp_target) and jsv_cell_kind(dp_target) == JS_CELL_KIND_NATIVE {
            dp_idx: int = jsv_to_table_id(dp_target);
            if dp_idx >= 0 and dp_idx < 1000000 and dp_idx < len(realm.closures) {
                dp_cl: JSClosure = realm.closures[dp_idx];
                dp_key_id: int = 0;
                if jsv_is_string_cell(args[1]) {
                    dp_key_id = jsv_to_table_id(args[1]);
                }
                # Intrinsic function keys live on the closure, not fn_props.
                # `prototype` is a data property { writable:<prototype_writable>,
                # enumerable:false, configurable:false } synthesized from the closure
                # (ES §10.2.4). ValidateAndApplyPropertyDescriptor for a non-configurable
                # data property: reject configurable:true, any enumerable change, and —
                # once non-writable — writable:true or a value change; writable may only
                # downgrade true→false. A no-op define (matching attributes) succeeds.
                if dp_key_id == WK_PROTOTYPE and jsv_is_object_cell(args[2]) {
                    dp_desc: JSValue = args[2];
                    dp_cur_w: bool = dp_cl.prototype_writable;
                    dp_has_c: bool = js_object_has_own(
                        dp_desc, str_intern("configurable")
                    );
                    dp_has_e: bool = js_object_has_own(
                        dp_desc, str_intern("enumerable")
                    );
                    dp_has_w: bool = js_object_has_own(dp_desc, str_intern("writable"));
                    dp_has_v: bool = js_object_has_own(dp_desc, str_intern("value"));
                    dp_want_c: bool = dp_has_c
                        and jsv_coerce_to_bool(
                            js_object_get(dp_desc, str_intern("configurable"))
                        );
                    dp_want_e: bool = dp_has_e
                        and jsv_coerce_to_bool(
                            js_object_get(dp_desc, str_intern("enumerable"))
                        );
                    dp_want_w: bool = dp_has_w
                        and jsv_coerce_to_bool(
                            js_object_get(dp_desc, str_intern("writable"))
                        );
                    dp_new_v: JSValue = dp_cl.prototype_obj;
                    if dp_has_v {
                        dp_new_v = js_object_get(dp_desc, str_intern("value"));
                    }
                    # An accessor descriptor on a non-configurable data property is illegal.
                    dp_is_acc: bool = js_object_has_own(dp_desc, str_intern("get"))
                        or js_object_has_own(dp_desc, str_intern("set"));
                    dp_reject: bool = False;
                    if dp_is_acc {
                        dp_reject = True;
                    }
                    if dp_has_c and dp_want_c {
                        dp_reject = True;
                    }  # can't become configurable
                    if dp_has_e and dp_want_e {
                        dp_reject = True;
                    }  # enumerable is fixed false
                    if not dp_cur_w {
                        if dp_has_w and dp_want_w {
                            dp_reject = True;
                        }  # can't re-enable writable
                        if dp_has_v
                            and not spec_same_value(dp_new_v, dp_cl.prototype_obj) {
                            dp_reject = True;
                        }
                    }
                    if dp_reject {
                        vm_throw_native(
                            make_type_error("Cannot redefine property: prototype")
                        );
                        return dp_orig;
                    }
                    if dp_has_v {
                        dp_cl.prototype_obj = dp_new_v;
                    }
                    if dp_has_w {
                        dp_cl.prototype_writable = dp_want_w;
                    }
                    return dp_orig;
                }
                # Re-defining the synthesized `name`/`length` intrinsic re-materializes
                # it as an own fn_props property, so a prior `delete fn.name` no longer
                # suppresses it (ES §10.2.4 makes them configurable; verifyProperty
                # round-trips delete→defineProperty→re-read).
                if dp_key_id == str_intern("name") {
                    dp_cl.name_removed = False;
                }
                if dp_key_id == str_intern("length") {
                    dp_cl.length_removed = False;
                }
                dp_target = dp_cl.fn_props;
            } elif is_native_val(dp_target) {
                # R3: native builtins — lazy props store + clear name/length tombstones.
                dp_kid: int = 0;
                if jsv_is_string_cell(args[1]) {
                    dp_kid = jsv_to_table_id(args[1]);
                }
                if dp_kid == WK_NAME or dp_kid == WK_LENGTH {
                    native_clear_key_removed(dp_target, dp_kid);
                }
                dp_target = native_props_ensure(dp_target);
                js_Object_defineProperty(dp_target, args[1], args[2]);
                return dp_orig;
            }
        }
        return js_Object_defineProperty(dp_target, args[1], args[2]);
    }
    return js_undefined();
}

def _dn_native_kind_obj_define_properties(
    realm: Realm, this_val: JSValue, args: list[JSValue]
) -> JSValue {
    if len(args) < 2 {
        return js_undefined();
    }
    dps_target: JSValue = args[0];
    dps_orig: JSValue = dps_target;
    # Mirror Object.defineProperty: functions are objects — apply property
    # definitions to the closure's fn_props bag (common.mustCall depends on this).
    if jsv_is_cell(dps_target) and jsv_cell_kind(dps_target) == JS_CELL_KIND_NATIVE {
        dps_idx: int = jsv_to_table_id(dps_target);
        if dps_idx >= 0 and dps_idx < 1000000 and dps_idx < len(realm.closures) {
            dps_cl: JSClosure = realm.closures[dps_idx];
            dps_target = dps_cl.fn_props;
        } elif is_native_val(dps_target) {
            dps_target = native_props_ensure(dps_target);
        }
    }
    js_Object_defineProperties(dps_target, args[1]);
    return dps_orig;
}

def _dn_native_kind_obj_is(
    realm: Realm, this_val: JSValue, args: list[JSValue]
) -> JSValue {
    # ES §20.1.2.14: missing args are undefined (SameValue(undefined, undefined) → true).
    a: JSValue = js_undefined();
    b: JSValue = js_undefined();
    if len(args) >= 1 {
        a = args[0];
    }
    if len(args) >= 2 {
        b = args[1];
    }
    return js_boolean(js_Object_is(a, b));
}

