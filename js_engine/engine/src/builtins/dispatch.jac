def _dn_native_kind_fn_tostring(
    realm: Realm, this_val: JSValue, args: list[JSValue]
) -> JSValue {
    # Function.prototype.toString — `this` must be callable (§20.2.3.5).
    # Closures go through CALL_METHOD's VM path for `.toString()`, but
    # Function.prototype.toString.call(fn) uses this dispatch handler.
    #
    # Promise resolving functions are marker objects (KEY_IS_RESOLVE/REJECT, not
    # closures nor KEY_CTOR_KIND), so _dispatch_value_is_callable does not accept
    # them. They ARE callable (typeof reports "function"), so handle them ahead
    # of the guard — an anonymous native source string, not a TypeError.
    if jsv_is_object_cell(this_val)
        and jsv_to_table_id(this_val) > 0
        and (js_is_resolve_fn(this_val) or js_is_reject_fn(this_val)) {
        return jsv_from_string_id(str_intern("function () { [native code] }"));
    }
    if not _dispatch_value_is_callable(this_val) {
        vm_throw_native(
            make_type_error(
                "Function.prototype.toString requires that 'this' be a function"
            )
        );
        return js_undefined();
    }
    nm: str = "";
    if is_native_val(this_val) {
        nm = get_native_name(this_val);
        if nm == "" or nm.find(" ") >= 0 {
            return jsv_from_string_id(str_intern("function () { [native code] }"));
        }
        return jsv_from_string_id(
            str_intern("function " + nm + "() { [native code] }")
        );
    }
    if jsv_is_cell(this_val) {
        cl_id: int = jsv_to_table_id(this_val);
        if cl_id >= 0 and cl_id < len(realm.closures) {
            src_ts: str = realm.closures[cl_id].func.source;
            if len(src_ts) > 0 {
                return jsv_from_string_id(str_intern(src_ts));
            }
            nm = realm.closures[cl_id].func.name;
            if realm.closures[cl_id].func.is_bound or nm == "" or nm.find(" ") >= 0 {
                return jsv_from_string_id(str_intern("function () { [native code] }"));
            }
            return jsv_from_string_id(
                str_intern("function " + nm + "() { [native code] }")
            );
        }
    }
    if jsv_is_object_cell(this_val)
        and jsv_to_table_id(this_val) > 0
        and js_object_has_own(this_val, KEY_CTOR_KIND) {
        nm_v: JSValue = js_object_get(this_val, str_intern("name"));
        if jsv_is_string_cell(nm_v) {
            nm = str_from_id(jsv_to_table_id(nm_v));
        }
    }
    if nm == "" {
        nm = "anonymous";
    }
    if nm.find(" ") >= 0 {
        return jsv_from_string_id(str_intern("function () { [native code] }"));
    }
    return jsv_from_string_id(str_intern("function " + nm + "() { [native code] }"));
}

