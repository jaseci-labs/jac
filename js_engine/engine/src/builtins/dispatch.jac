def _dn_native_kind_next_tick(
    realm: Realm, this_val: JSValue, args: list[JSValue]
) -> JSValue {
    if len(args) > 0 {
        nt_fn: JSValue = args[0];
        nt_extra: list[JSValue] = [];
        nt_i: int = 1;
        while nt_i < len(args) {
            nt_extra.append(args[nt_i]);
            nt_i = nt_i + 1;
        }
        scheduler_push_next_tick(realm, nt_fn, nt_extra);
    }
    return js_undefined();

    # ── URI encoding / decoding ───────────────────────────────────────────────
}

