def _dn_native_kind_wasm_bind_func(
    realm: Realm, this_val: JSValue, args: list[JSValue]
) -> JSValue {
    # __wasm.bindFunc(inst, name) -> funcHandle (0 on error)
    inst_h: int = _dn_ptr_arg(args, 0);
    name: str = "";
    if len(args) >= 2 and jsv_is_string_cell(args[1]) {
        name = str_from_id(jsv_to_table_id(args[1]));
    }
    return js_int(wasm_bind_export_func(inst_h, name));
}

def _dn_native_kind_wasm_func_invoke(
    realm: Realm, this_val: JSValue, args: list[JSValue]
) -> JSValue {
    # __wasm.invoke(funcHandle, ...jsArgs) -> result | [results] | undefined
    if len(args) < 1 {
        return js_undefined();
    }
    func_h: int = _dn_ptr_arg(args, 0);
    nparams: int = wasm_func_param_count(func_h);
    if nparams < 0 {
        return js_undefined();
    }

    arg_ints: list[int] = [];
    arg_dbls: list[float] = [];
    i: int = 0;
    while i < nparams {
        kind: int = wasm_func_param_kind(func_h, i);
        # JS call args start at index 1 (index 0 is the func handle).
        av: JSValue = js_undefined();
        if 1 + i < len(args) {
            av = args[1 + i];
        }
        iv: int = 0;
        dv: float = 0.0;
        if kind == WASMTIME_F32 or kind == WASMTIME_F64 {
            if jsv_is_double(av) {
                dv = jsv_to_double(av);
            } elif jsv_is_int32(av) {
                dv = float(jsv_to_int32(av));
            }
        } elif kind == WASMTIME_I64 {
            # i64 params take BigInt (spec); accept Number as a convenience.
            if jsv_is_bigint_cell(av) {
                iv = wasm_i64_from_decimal(str_from_id(jsv_to_table_id(av)));
            } elif jsv_is_int32(av) {
                iv = jsv_to_int32(av);
            } elif jsv_is_double(av) {
                iv = int(jsv_to_double(av));
            }
        } else {
            # i32 — accept int32 or double-encoded numbers
            if jsv_is_int32(av) {
                iv = jsv_to_int32(av);
            } elif jsv_is_double(av) {
                iv = int(jsv_to_double(av));
            }
        }
        arg_ints.append(iv);
        arg_dbls.append(dv);
        i = i + 1;
    }

    ok: bool = wasm_func_invoke(func_h, arg_ints, arg_dbls);
    if not ok {
        return js_undefined();
    }

    nres: int = wasm_call_result_count();
    if nres == 0 {
        return js_undefined();
    }
    if nres == 1 {
        return _dn_wasm_result_value(0);
    }
    results: list[JSValue] = [];
    j: int = 0;
    while j < nres {
        results.append(_dn_wasm_result_value(j));
        j = j + 1;
    }
    return js_array_create(results);
}

def:priv _dn_wasm_result_value(i: int) -> JSValue {
    # Convert the i-th cached call result into a JSValue by its kind.
    kind: int = wasm_call_result_kind(i);
    if kind == WASMTIME_I32 {
        return jsv_from_int32(wasm_call_result_int(i));
    }
    if kind == WASMTIME_I64 {
        # i64 → BigInt (Phase 3), matching Node/V8 (WASM i64 results are BigInt).
        return js_bigint_from_decimal_str(wasm_i64_to_decimal(wasm_call_result_int(i)));
    }
    # F32 / F64 → double
    return jsv_from_double(wasm_call_result_dbl(i));
}

def _dn_native_kind_wasm_export_memory(
    realm: Realm, this_val: JSValue, args: list[JSValue]
) -> JSValue {
    # __wasm.exportMemory(inst, name) -> memHandle (0 on error)
    inst_h: int = _dn_ptr_arg(args, 0);
    name: str = "";
    if len(args) >= 2 and jsv_is_string_cell(args[1]) {
        name = str_from_id(jsv_to_table_id(args[1]));
    }
    return js_int(wasm_inst_export_memory(inst_h, name));
}

def _dn_native_kind_wasm_mem_create(
    realm: Realm, this_val: JSValue, args: list[JSValue]
) -> JSValue {
    # __wasm.memCreate(minPages, maxPages) -> memHandle (maxPages<0 means none).
    # A fresh store is opened per standalone memory.
    min_pages: int = _dn_ptr_arg(args, 0);
    max_pages: int = 0 - 1;
    if len(args) >= 2 and not jsv_is_undefined(args[1]) {
        max_pages = _dn_ptr_arg(args, 1);
    }
    return js_int(_dn_wasm_standalone_mem(min_pages, max_pages));
}

def:priv _dn_wasm_standalone_mem(min_pages: int, max_pages: int) -> int {
    store_h: int = wasm_store_open();
    if store_h == 0 {
        return 0;
    }
    return wasm_memory_create(store_h, min_pages, max_pages);
}

