# ── Wave 21 — ICU / Intl bridge (__icu) ───────────────────────────────────────
# __icu.canonicalLocale(locale)
# __icu.getDefaultLocale()
# __icu.formatNumber(locale, style, value)
# __icu.formatDateTime(locale, ds, ts, ms)
# __icu.pluralSelect(locale, type, value)
# __icu.compare(locale, sens, a, b)
# __icu.displayName(locale, type, code, style)
# __icu.listFormat(locale, type, style, items)
# __icu.relativeTime(locale, numeric, unit, value)
# __icu.segmenterBreak(locale, gran, text)
# Note: 1012 is NATIVE_KIND_262_EVAL_SCRIPT — do not reuse.
# __icu.maximizeLocale(locale)
# __icu.minimizeLocale(locale)
# __icu.localeInfo(locale, kind)
# __icu.formatNumberParts(locale, style, value)
# __icu.formatDateTimeParts(locale, ds, ts, ms)
# __icu.formatNumberRange(locale, style, a, b)
# __icu.formatDateTimeRange(locale, ds, ts, a, b)
# %Function.prototype% is itself a built-in callable (ES §20.2.3): typeof is "function",
# calling it returns undefined, and it is NOT a constructor. Object-backed (js_callable_create)
# so it still holds call/apply/bind/toString/@@hasInstance own properties.

# module.registerHooks: nextResolve trampoline passed to a resolve hook, and
# the returned handle's deregister() (removes that registration's hooks).

# __icu.setDefaultTimeZone(tz)
# __cp.spawnWriteStdinB64(hid, b64) — binary-safe stdin
# __cp.unref(hid) — drop child from loop keep-alive
# __cp.ref(hid) — re-add child to loop keep-alive

# ── WebAssembly / Wasmtime bridge (docs/wasm.md Phase 2) ─────────────────────
# __wasm.* native methods backing engine/src/builtins/js/webassembly.js. Bytes
# cross the boundary as (ptr,len) via __buf.alloc; module/instance/func/memory
# are opaque small-int handles held by the JS shim. Imports/tables/globals/traps
# → RuntimeError are Phase 3.
# __wasm.validate(ptr,len) -> bool
# __wasm.compile(ptr,len) -> moduleHandle (0=err)
# __wasm.instantiate(moduleHandle) -> instHandle
# __wasm.exportCount(inst) -> int
# __wasm.exportName(inst, idx) -> str
# __wasm.exportKind(inst, idx) -> int (0=func/1=global/2=table/3=memory)
# __wasm.bindFunc(inst, name) -> funcHandle
# __wasm.invoke(funcHandle, ...args) -> result | [results] | undefined
# __wasm.exportMemory(inst, name) -> memHandle
# __wasm.memCreate(minPages, maxPages) -> memHandle
# __wasm.memPtr(memH) -> float (base ptr, live)
# __wasm.memSize(memH) -> int (byte length)
# __wasm.memGrow(memH, deltaPages) -> prevPages | -1
# __wasm.memFree(memH)
# __wasm.lastError() -> str
# __wasm.freeModule(moduleHandle)
# __wasm.memPages(memH) -> int (page count)
# __wasm.moduleImports(modH) -> [{module,name,kind}]
# __wasm.moduleExports(modH) -> [{name,kind}]
# __wasm.exportGlobal(inst, name) -> globalHandle
# __wasm.globalGet(globalHandle) -> number|BigInt (read global .value)

# ── Phase 3: imports (JS→WASM callbacks), tables, globals (create/set), traps ──
# __wasm.lastErrorClass() -> int (0none/1compile/2link/3runtime)
# __wasm.globalCreate(kind,mutable,ival,dval) -> globalHandle
# __wasm.globalSet(gh, ival, dval) -> bool
# __wasm.globalIsMutable(gh) -> bool
# __wasm.globalKind(gh) -> int (I32=0..F64=3)
# __wasm.tableCreate(elemKind,initial,maximum) -> tableHandle
# __wasm.tableSize(th) -> int
# __wasm.tableGetKind(th, idx) -> int (-1oob/0null/1func/2extern)
# __wasm.tableSetNull(th, idx) -> bool
# __wasm.tableSetFunc(th, idx, fh) -> bool
# __wasm.tableGrow(th, delta) -> prevSize | -1
# __wasm.exportTable(inst, name) -> tableHandle
# __wasm.importsBegin(modH, nimports) -> storeHandle
# __wasm.importsAddFunc(idx, pkinds[], rkinds[], jsFn) -> bool
# __wasm.importsAddMemory(idx, memH) -> bool
# __wasm.importsAddGlobal(idx, gh) -> bool
# __wasm.importsAddTable(idx, th) -> bool
# __wasm.instantiateImports(modH) -> instHandle
# __wasm.bindFuncKinds(fh) -> [np,nr,pk...,rk...]

# ── ArrayBuffer bridge bulk decode (Buffer.toString / TextDecoder hot path) ──

# __buf.toString(view, enc, start, end)
# __buf.tdDecode(input, fatal)

# ── TypedArray exotic fast paths (buffer_native.jac) ─────────────────────────
# The four %TypedArray%.prototype getters are natives so the VM's GET_PROP can
# recognise the pristine getter by kind and answer from the binary side-table.
# get %TypedArray%.prototype.length
# get %TypedArray%.prototype.byteLength
# get %TypedArray%.prototype.byteOffset
# get %TypedArray%.prototype.buffer
# get %TypedArray%[Symbol.species] (returns this)
# __buf.taSubarray(view, begin, end, endProvided)
# __buf.makeView(src, proto, startElem, newLen, isBuf)
# __buf.initArrayBuffer(ab, byteLength)
# __buf.initTypedArray(view, buffer, off, len, fixed, bpe, kind, name, getter, setter, ctor)
# __buf.utf8ByteLength(str)
# __buf.writeString(view, str, off, maxLen, enc)
# __buf.copyBytes(src, target, ts, ss, se)
# __buf.equalsBytes(a, b)
# Fully native prototype methods + their JS slow-path registration
# TextDecoder.prototype.decode
# __buf.setTdDecodeSlow(fn)
# Buffer.prototype.toString
# Buffer.prototype.subarray / slice
# __buf.setBufSlow(toStringFn, subarrayFn, Buffer.prototype)
# %TypedArray%.prototype.subarray
# __buf.setTaSubarraySlow(fn)
# __buf.taSet(target, source, offset)
# __buf.taSlice(view, begin, end)
# __buf.stringByteLength(str, enc)
# __buf.setArrayBufferProto(proto)
# __buf.intArrayProbe(arr)
# __buf.taFillFromProbe(view)
"""
IsConstructor kind table — single source of truth for which native kinds are
constructible via `new`. Used by `_vm_is_constructor` so adding a constructor
is a one-line update here instead of editing the VM allowlist.
"""
def:pub native_kind_is_constructible(kind: int) -> bool {
    if kind == NATIVE_KIND_ARRAY {
        return True;
    }
    if kind == NATIVE_KIND_OBJECT {
        return True;
    }
    if kind == NATIVE_KIND_MAP {
        return True;
    }
    if kind == NATIVE_KIND_SET {
        return True;
    }
    if kind == NATIVE_KIND_DATE {
        return True;
    }
    if kind == NATIVE_KIND_PROMISE {
        return True;
    }
    if kind == NATIVE_KIND_FUNCTION {
        return True;
    }
    if kind == NATIVE_KIND_BOOLEAN {
        return True;
    }
    if kind == NATIVE_KIND_NUMBER {
        return True;
    }
    if kind == NATIVE_KIND_STRING {
        return True;
    }
    if kind == NATIVE_KIND_ERROR {
        return True;
    }
    if kind == NATIVE_KIND_TYPE_ERROR {
        return True;
    }
    if kind == NATIVE_KIND_REFERENCE_ERROR {
        return True;
    }
    if kind == NATIVE_KIND_SYNTAX_ERROR {
        return True;
    }
    if kind == NATIVE_KIND_RANGE_ERROR {
        return True;
    }
    if kind == NATIVE_KIND_URI_ERROR {
        return True;
    }
    if kind == NATIVE_KIND_EVAL_ERROR {
        return True;
    }
    if kind == NATIVE_KIND_WEAKMAP {
        return True;
    }
    if kind == NATIVE_KIND_WEAKSET {
        return True;
    }
    if kind == NATIVE_KIND_REGEXP {
        return True;
    }
    if kind == NATIVE_KIND_PROXY {
        return True;
    }
    if kind == NATIVE_KIND_GENERATOR_FUNCTION {
        return True;
    }
    # Temporal constructors (§8-13) are constructable via `new`. Merge note:
    # 24879b8 routed _vm_is_constructor through this allowlist, which omitted
    # Temporal — HEAD previously accepted any KEY_CTOR_KIND object except Symbol.
    # Their omission made every `new Temporal.*` throw "is not a constructor"
    # (~1516 test262 regressions).
    if kind == NATIVE_KIND_TEMPORAL_DURATION {
        return True;
    }
    if kind == NATIVE_KIND_TEMPORAL_INSTANT {
        return True;
    }
    if kind == NATIVE_KIND_TEMPORAL_PLAIN_DATE {
        return True;
    }
    if kind == NATIVE_KIND_TEMPORAL_PLAIN_TIME {
        return True;
    }
    if kind == NATIVE_KIND_TEMPORAL_PLAIN_DATETIME {
        return True;
    }
    if kind == NATIVE_KIND_TEMPORAL_PLAIN_YEAR_MONTH {
        return True;
    }
    if kind == NATIVE_KIND_TEMPORAL_PLAIN_MONTH_DAY {
        return True;
    }
    if kind == NATIVE_KIND_TEMPORAL_ZONED_DATETIME {
        return True;
    }
    # module.SourceMap is constructable via `new module.SourceMap(payload)`
    # (from adel_fixes).
    if kind == NATIVE_KIND_MODULE_SOURCEMAP {
        return True;
    }
    # `new module.Module()` / `new require('module')()` — Node Module constructor.
    if kind == NATIVE_KIND_MODULE_CTOR {
        return True;
    }
    # Symbol / BigInt ARE constructors for IsConstructor (§20.4.1 / §21.2.1): they
    # have a [[Construct]] internal method, so IsConstructor is TRUE and `extends
    # Symbol` / `extends BigInt` is legal. Their [[Construct]] however THROWS a
    # TypeError whenever NewTarget is not undefined (§20.4.1.1 step 1 /
    # §21.2.1.1 step 1), so every construct site must reject them — see the Symbol/
    # BigInt guards in _op_new, the implicit-ctor super path, and _op_super_call.
    if kind == NATIVE_KIND_SYMBOL {
        return True;
    }
    if kind == NATIVE_KIND_BIGINT {
        return True;
    }
    return False;
}
