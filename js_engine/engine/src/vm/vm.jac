    _NATIVE_SPECIAL_KINDS[NATIVE_KIND_OBJ_PROTO_PROP_IS_ENUM] = True;
    _NATIVE_SPECIAL_KINDS[NATIVE_KIND_OBJ_PROTO_TOLOCALESTRING] = True;
    _NATIVE_SPECIAL_KINDS[NATIVE_KIND_OBJ_SET_PROTOTYPE_OF] = True;
    _NATIVE_SPECIAL_KINDS[NATIVE_KIND_OBJ_STATIC_ASSIGN] = True;
    _NATIVE_SPECIAL_KINDS[NATIVE_KIND_OBJ_STATIC_ENTRIES] = True;
    _NATIVE_SPECIAL_KINDS[NATIVE_KIND_OBJ_STATIC_FREEZE] = True;
