                                                                    }
                                                                    self.had_exception = False;
                                                                    self.pending_exc = js_undefined();
                                                                    if vm_has_native_exc() {
                                                                        _ = vm_take_native_exc();
                                                                    }
                                                                    nwm_iok = False;
                                                                    if not self._unwind_in_frame(
                                                                        frame, exc_wes
                                                                    ) {
                                                                        self.had_exception = True;
                                                                        self.pending_exc = exc_wes;
                                                                        st.running = False;
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                        if nwm_iok {
                                            self._push(nwm_map);
                                        } elif nwm_need_unwind {
                                            if self.had_exception {
                                                if not self._unwind_in_frame(
                                                    frame, self.pending_exc
                                                ) {
                                                    st.running = False;
                                                }
                                            } elif vm_has_native_exc() {
                                                exc_wmnx: JSValue = vm_take_native_exc();
                                                if not self._unwind_in_frame(
                                                    frame, exc_wmnx
                                                ) {
                                                    self.had_exception = True;
                                                    self.pending_exc = exc_wmnx;
                                                    st.running = False;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        } else {
                            exc_wm2: JSValue = make_type_error(
                                "object is not iterable (cannot read property Symbol(Symbol.iterator))"
                            );
                            if not self._unwind_in_frame(frame, exc_wm2) {
                                self.had_exception = True;
                                self.pending_exc = exc_wm2;
                                st.running = False;
                            }
                        }
                    }  # end WeakMap adder-callable branch
                } elif ck_nw_kind == NATIVE_KIND_WEAKSET {
                    # new WeakSet(iterable?) — Get(set,"add") + Call + IteratorClose
                    nws_init: JSValue = js_undefined();
                    if len(args_nw) > 0 {
                        nws_init = args_nw[0];
                    }
                    nws_set: JSValue = js_weakset_create();
                    if jsv_is_null(nws_init) or jsv_is_undefined(nws_init) {
                        self._push(nws_set);
                    } else {
                        nws_adder: JSValue = self.obs_get(
                            nws_set, str_intern("add"), nws_set
                        );
                        if self.had_exception or vm_has_native_exc() {
                            if vm_has_native_exc() {
                                exc_wsad: JSValue = vm_take_native_exc();
                                if not self._unwind_in_frame(frame, exc_wsad) {
                                    self.had_exception = True;
                                    self.pending_exc = exc_wsad;
                                    st.running = False;
                                }
                            } elif not self._unwind_in_frame(frame, self.pending_exc) {
                                st.running = False;
                            }
                        } elif not self._value_is_callable(nws_adder) {
                            exc_wsadc: JSValue = make_type_error(
                                "WeakSet.prototype.add is not callable"
                            );
                            if not self._unwind_in_frame(frame, exc_wsadc) {
                                self.had_exception = True;
                                self.pending_exc = exc_wsadc;
                                st.running = False;
                            }
                        } elif jsv_is_object_cell(nws_init) {
                            nws_sym: JSValue = self.obs_get(
                                nws_init, SYMBOL_KEY_BASE + SYMBOL_ITERATOR, nws_init
                            );
                            if self.had_exception or vm_has_native_exc() {
                                if self.had_exception {
                                    if not self._unwind_in_frame(
                                        frame, self.pending_exc
                                    ) {
                                        st.running = False;
                                    }
                                } else {
                                    exc_wss: JSValue = vm_take_native_exc();
                                    if not self._unwind_in_frame(frame, exc_wss) {
                                        self.had_exception = True;
                                        self.pending_exc = exc_wss;
                                        st.running = False;
                                    }
                                }
                            } elif not self._value_is_callable(nws_sym) {
                                exc_wsi: JSValue = make_type_error(
                                    "object is not iterable (cannot read property Symbol(Symbol.iterator))"
                                );
                                if not self._unwind_in_frame(frame, exc_wsi) {
                                    self.had_exception = True;
                                    self.pending_exc = exc_wsi;
                                    st.running = False;
                                }
                            } else {
                                nws_iter: JSValue = _vm_invoke_callback(
                                    self, nws_sym, nws_init, []
                                );
                                if self.had_exception or vm_has_native_exc() {
                                    if self.had_exception {
                                        if not self._unwind_in_frame(
                                            frame, self.pending_exc
                                        ) {
                                            st.running = False;
                                        }
                                    } else {
                                        exc_wsit: JSValue = vm_take_native_exc();
                                        if not self._unwind_in_frame(frame, exc_wsit) {
                                            self.had_exception = True;
                                            self.pending_exc = exc_wsit;
                                            st.running = False;
                                        }
                                    }
                                } else {
                                    nws_use_gen: bool = False;
                                    nws_next: JSValue = js_undefined();
                                    if js_is_generator(nws_iter) {
                                        nws_gwrap: JSValue = js_object_create_null();
                                        js_object_set(
                                            nws_gwrap, WK_I, js_array_create([])
                                        );
                                        js_object_set(nws_gwrap, WK_J, js_int(0));
                                        js_object_set(nws_gwrap, WK_GEN, nws_iter);
                                        nws_iter = nws_gwrap;
                                        nws_use_gen = True;
                                    } else {
                                        nws_next = self.obs_get(
                                            nws_iter, WK_NEXT, nws_iter
                                        );
                                    }
                                    if (not nws_use_gen)
                                        and not self._value_is_callable(nws_next) {
                                        exc_wsn: JSValue = make_type_error(
                                            "iterator.next is not a function"
                                        );
                                        if not self._unwind_in_frame(frame, exc_wsn) {
                                            self.had_exception = True;
                                            self.pending_exc = exc_wsn;
                                            st.running = False;
                                        }
                                    } else {
                                        nws_iok: bool = True;
                                        nws_done: bool = False;
                                        nws_need_unwind: bool = False;
                                        while nws_iok and not nws_done {
                                            nws_step: JSValue = js_undefined();
                                            if nws_use_gen {
                                                nws_step = _vm_iter_next_delegate(
                                                    self, nws_iter
                                                );
                                            } else {
                                                nws_step = _vm_invoke_callback(
                                                    self, nws_next, nws_iter, []
                                                );
                                            }
                                            if self.had_exception
                                                or vm_has_native_exc() {
                                                nws_iok = False;
                                                nws_need_unwind = True;
                                            } else {
                                                nws_dv: JSValue = self.obs_get(
                                                    nws_step, WK_DONE, nws_step
                                                );
                                                if self.had_exception
                                                    or vm_has_native_exc() {
                                                    nws_iok = False;
                                                    nws_need_unwind = True;
                                                } elif jsv_coerce_to_bool(nws_dv) {
                                                    nws_done = True;
                                                } else {
                                                    nws_el: JSValue = self.obs_get(
                                                        nws_step, WK_VALUE, nws_step
                                                    );
                                                    if self.had_exception
                                                        or vm_has_native_exc() {
                                                        nws_iok = False;
                                                        nws_need_unwind = True;
                                                    } else {
                                                        if is_fn_val(nws_adder) {
                                                            _ = self.run_cl(
                                                                self.realm.closures[
                                                                    get_fn_idx(
                                                                        nws_adder
                                                                    )
                                                                ],
                                                                nws_adder,
                                                                nws_set,
                                                                [nws_el]
                                                            );
                                                        } elif is_native_val(
                                                            nws_adder
                                                        ) {
                                                            _ = _vm_call_native_proxy_aware(
                                                                self,
                                                                self.realm,
                                                                get_native_kind(
                                                                    nws_adder
                                                                ),
                                                                nws_set,
                                                                [nws_el]
                                                            );
                                                        } else {
                                                            js_weakset_add(
                                                                nws_set, nws_el
                                                            );
                                                        }
                                                        if self.had_exception
                                                            or vm_has_native_exc() {
                                                            _vm_iterator_close(
                                                                self, nws_iter
                                                            );
                                                            exc_wse: JSValue = self.pending_exc;
                                                            if vm_has_native_exc() {
                                                                exc_wse = vm_take_native_exc();
                                                            }
                                                            self.had_exception = False;
                                                            self.pending_exc = js_undefined();
                                                            if vm_has_native_exc() {
                                                                _ = vm_take_native_exc();
                                                            }
                                                            nws_iok = False;
                                                            if not self._unwind_in_frame(
                                                                frame, exc_wse
                                                            ) {
                                                                self.had_exception = True;
                                                                self.pending_exc = exc_wse;
                                                                st.running = False;
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                        if nws_iok {
                                            self._push(nws_set);
                                        } elif nws_need_unwind {
                                            if self.had_exception {
                                                if not self._unwind_in_frame(
                                                    frame, self.pending_exc
                                                ) {
                                                    st.running = False;
                                                }
                                            } elif vm_has_native_exc() {
                                                exc_wsnx: JSValue = vm_take_native_exc();
                                                if not self._unwind_in_frame(
                                                    frame, exc_wsnx
                                                ) {
                                                    self.had_exception = True;
                                                    self.pending_exc = exc_wsnx;
                                                    st.running = False;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        } else {
                            exc_ws2: JSValue = make_type_error(
                                "object is not iterable (cannot read property Symbol(Symbol.iterator))"
                            );
                            if not self._unwind_in_frame(frame, exc_ws2) {
                                self.had_exception = True;
                                self.pending_exc = exc_ws2;
                                st.running = False;
                            }
                        }
                    }  # end WeakSet adder-callable branch
                } elif ck_nw_kind == NATIVE_KIND_DATE {
                    # new Date(...) — §21.4.2.1 with NewTarget = the Date constructor (ctor).
                    # Build the time value, then set [[Prototype]] from
                    # GetPrototypeFromConstructor(NewTarget) so the instance is a proper
                    # Date whose methods resolve through Date.prototype. `Date()` (a plain
                    # call) is handled separately in _dn_native_kind_date (returns a String).
                    date_ck: JSValue = _vm_date_construct_obs(self, args_nw);
                    if vm_has_native_exc() {
                        exc_dck: JSValue = vm_take_native_exc();
                        if not self._unwind_in_frame(frame, exc_dck) {
                            self.had_exception = True;
                            self.pending_exc = exc_dck;
                            st.running = False;
                        }
                    } else {
                        proto_ck: JSValue = _vm_get_collection_proto_from_constructor(
                            self, ctor, "Date"
                        );
                        if vm_has_native_exc() {
                            exc_dck2: JSValue = vm_take_native_exc();
                            if not self._unwind_in_frame(frame, exc_dck2) {
                                self.had_exception = True;
                                self.pending_exc = exc_dck2;
                                st.running = False;
                            }
                        } else {
                            if jsv_is_object_cell(proto_ck)
                                and jsv_is_object_cell(date_ck) {
                                js_object_set_prototype(date_ck, proto_ck);
                            }
                            self._push(date_ck);
                        }
                    }
                } else {
                    res_ck_nw: JSValue = _vm_call_native_proxy_aware(
                        self, self.realm, ck_nw_kind, js_undefined(), args_nw
                    );
                    if not self._check_native_exc(frame, res_ck_nw) {
                        st.running = False;
                    }
                }
            }  # end IsConstructor-true branch for KEY_CTOR_KIND
        } elif is_fn_val(ctor) {
            cl_nw: JSClosure = self.realm.closures[get_fn_idx(ctor)];
            # N4: NAPI native constructor
            if cl_nw.napi_cb_ptr != 0 {
                new_this_napi: JSValue = js_object_create_null();
                if not jsv_is_undefined(cl_nw.prototype_obj)
                    and not jsv_is_null(cl_nw.prototype_obj) {
                    new_this_napi = js_object_create(cl_nw.prototype_obj);
                }
                args_napi_nw: list[int] = [];
                for a_napi_nw in args_nw {
                    args_napi_nw.append(a_napi_nw);
                }
                # new.target = ctor (the constructor JSValue) per ECMAScript §10.2.5
                napi_ctor_ret: int = _vm_invoke_napi_cb(
                    self,
                    cl_nw.napi_cb_ptr,
                    cl_nw.napi_cb_data,
                    new_this_napi,
                    args_napi_nw,
                    ctor
                );
                # N6: propagate any NAPI-thrown exception into the VM
                if _napi_get_had_exception() {
                    exc_napi_nw: JSValue = _napi_consume_exception();
                    # Properly unwind: look for a catch handler in this frame,
                    # otherwise stop the dispatch loop and propagate upward. Without
                    # this the loop fell through to the following opcodes (LOAD_THIS/
                    # SWAP) with the constructor result missing from the operand
                    # stack, eventually raising a misleading "list index out of range".
                    if not self._unwind_in_frame(frame, exc_napi_nw) {
                        self.had_exception = True;
                        self.pending_exc = exc_napi_nw;
                        st.running = False;
                    }
                } elif jsv_is_any_object(napi_ctor_ret) {
                    self._push(napi_ctor_ret);
                } else {
                    self._push(new_this_napi);
                }
                # Arrow, generator, async, and concise methods have no [[Construct]]
                # (ES §15.3.4 / §27.3 / §27.7 / §10.2.2): `new method` throws TypeError.
                # WK_NOT_CTOR (fn_props marker) and is_non_constructor (closure flag) are
                # two markers for the same "explicitly non-constructable" concept — the
                # former from the Promise combinators, the latter set via
                # NATIVE_KIND_MARK_NON_CONSTRUCTOR; both are honoured. The WK_NOT_CTOR check
                # is required, else Reflect.construct(Promise.all) would slip through.
            } elif cl_nw.is_arrow
                or cl_nw.func.is_generator
                or cl_nw.func.is_async
                or cl_nw.func.is_method
                or cl_nw.is_non_constructor
                or js_object_has_own(cl_nw.fn_props, WK_NOT_CTOR) {
                nw_arrow_msg: str = cl_nw.func.name + " is not a constructor";
                if cl_nw.func.name == "" {
                    nw_arrow_msg = "(intermediate value) is not a constructor";
                }
                exc_arrow: JSValue = make_type_error(nw_arrow_msg);
                if not self._unwind_in_frame(frame, exc_arrow) {
                    self.had_exception = True;
                    self.pending_exc = exc_arrow;
                    st.running = False;
                }
                # Bound function [[Construct]] (§10.4.1.2): unwrap to targetFunction,
                # prepend partial args. Direct `new boundFn()` has newTarget === boundFn,
                # so newTarget becomes targetFunction.
            } elif cl_nw.func.is_bound {
                target_bd: JSValue = ctor;
                if len(cl_nw.free_vals) > 0 {
                    target_bd = cl_nw.free_vals[0];
                }
                full_args_bd: list[JSValue] = [];
                bfi_nw: int = 1;
                while bfi_nw < len(cl_nw.free_vals) {
                    full_args_bd.append(cl_nw.free_vals[bfi_nw]);
                    bfi_nw = bfi_nw + 1;
                }
                for a_bd in args_nw {
                    full_args_bd.append(a_bd);
                }
                # Unwrap further bound layers (SameValue(newTarget, F) each time).
                nt_bd: JSValue = target_bd;
                while is_fn_val(target_bd) {
                    cl_in_bd: JSClosure = self.realm.closures[get_fn_idx(target_bd)];
                    if not cl_in_bd.func.is_bound {
                        break;
                    }
                    if len(cl_in_bd.free_vals) == 0 {
                        break;
                    }
                    in_p_bd: list[JSValue] = [];
                    ip_i_bd: int = 1;
                    while ip_i_bd < len(cl_in_bd.free_vals) {
                        in_p_bd.append(cl_in_bd.free_vals[ip_i_bd]);
                        ip_i_bd = ip_i_bd + 1;
                    }
                    for a_in_bd in full_args_bd {
                        in_p_bd.append(a_in_bd);
                    }
                    full_args_bd = in_p_bd;
                    target_bd = cl_in_bd.free_vals[0];
                    nt_bd = target_bd;
                }
                res_bd: JSValue = _vm_construct(self, target_bd, full_args_bd, nt_bd);
                if vm_has_native_exc() {
                    exc_bd: JSValue = vm_take_native_exc();
                    if not self._unwind_in_frame(frame, exc_bd) {
                        self.had_exception = True;
                        self.pending_exc = exc_bd;
                        st.running = False;
                    }
                } elif self.had_exception {
                    exc_bd2: JSValue = self.pending_exc;
                    self.had_exception = False;
                    self.pending_exc = js_undefined();
                    if not self._unwind_in_frame(frame, exc_bd2) {
                        self.had_exception = True;
                        self.pending_exc = exc_bd2;
                        st.running = False;
                    }
                } else {
                    self._push(res_bd);
                }
            } else {
                # [[Construct]]: create new_obj with [[Prototype]] = ctor.prototype, falling
                # back to %Object.prototype% when ctor.prototype is not an Object (ES §10.2.2
                # OrdinaryCreateFromConstructor → GetPrototypeFromConstructor: e.g.
                # `F.prototype = 1; new F()` → instance inherits Object.prototype).
                nw_proto_obj: JSValue = cl_nw.prototype_obj;
                if not (
                    jsv_is_object_cell(nw_proto_obj)
                    and jsv_to_table_id(nw_proto_obj) > 0
                ) {
                    nw_proto_obj = js_object_get_ordinary_proto();
                }
                new_obj: JSValue = js_object_create(nw_proto_obj);
                # new.target = the constructor being invoked via `new` (ES §13.3.5.1).
                self._pending_new_target = ctor;
                self.pending_new_target = ctor;
                if _DBG_NEW_ON {
                    _dbg_fop: int = -1;
                    if len(cl_nw.func.code) > 0 {
                        _dbg_fop = opcode_to_int(cl_nw.func.code[0].opcode);
                    }
                    _dbg_new_msg: str = "[DBG_NEW] fn-val ctor name='"
                        + cl_nw.func.name
                        + "' bytecode_len="
                        + str(len(cl_nw.func.code))
                        + " nparams="
                        + str(len(cl_nw.func.params))
                        + " first_op="
                        + str(_dbg_fop)
                        + " nargs="
                        + str(len(args_nw))
                        + "\n";
                    write(2, _dbg_new_msg, len(_dbg_new_msg));
                }
                cr: JSValue = self.run_cl(cl_nw, ctor, new_obj, args_nw);
                if self.had_exception {
                    # Constructor threw — unwind into the enclosing frame's try/catch
                    # rather than swallowing the exception and pushing a value.
                    exc_ctor: JSValue = self.pending_exc;
                    self.had_exception = False;
                    self.pending_exc = js_undefined();
                    if not self._unwind_in_frame(frame, exc_ctor) {
                        self.had_exception = True;
                        self.pending_exc = exc_ctor;
                        st.running = False;
                    }
                } elif jsv_is_any_object(cr) {
                    self._push(cr);
                } else {
                    self._push(new_obj);
                }
            }
        } else {
            # `new X` where X is not a constructor throws a TypeError
            # (ES §13.3.5.1 EvaluateNew → Construct requires IsConstructor).
            nw_bad_msg: str = " is not a constructor";
            if jsv_is_undefined(ctor) {
                nw_bad_msg = "undefined is not a constructor";
            } elif jsv_is_null(ctor) {
                nw_bad_msg = "null is not a constructor";
            }
            exc_bad_nw: JSValue = make_type_error(nw_bad_msg);
            if not self._unwind_in_frame(frame, exc_bad_nw) {
                self.had_exception = True;
                self.pending_exc = exc_bad_nw;
                st.running = False;
            }
        }
    }

    def _op_load_self(frame: CallFrame, ins: Instruction, st: ExecState) {
        self._push(frame.self_fn);
    }

    def _op_load_this(frame: CallFrame, ins: Instruction, st: ExecState) -> None {
        # this-TDZ: in a derived constructor, `this` is uninitialized until super() runs
        # (ES §13.3.7.1) — reading it before then throws ReferenceError. When a shared
        # this-binding cell is present (derived ctor or an arrow lexically inside one), it is
        # authoritative: a TDZ sentinel means uninitialized, else it holds the bound `this`.
        if frame.this_binding_cell != 0 {
            ltc: JSValue = cell_get(frame.this_binding_cell);
            if js_is_tdz(ltc) {
                exc_tc: JSValue = make_reference_error(
                    "Must call super constructor in derived class before accessing 'this' or returning from derived constructor"
                );
                if not self._unwind_in_frame(frame, exc_tc) {
                    self.had_exception = True;
                    self.pending_exc = exc_tc;
                    st.running = False;
                }
                return;
            }
            self._push(ltc);
            return;
        }
        if frame.this_uninitialized {
            exc_tt: JSValue = make_reference_error(
                "Must call super constructor in derived class before accessing 'this' or returning from derived constructor"
            );
            if not self._unwind_in_frame(frame, exc_tt) {
                self.had_exception = True;
                self.pending_exc = exc_tt;
                st.running = False;
            }
            return;
        }
        self._push(frame.this_val);
    }

    def _op_load_new_target(frame: CallFrame, ins: Instruction, st: ExecState) {
        # frame.new_target defaults to 0 (== undefined); normalize to js_undefined().
        lnt: JSValue = frame.new_target;
        if not (jsv_is_object_cell(lnt) or is_fn_val(lnt) or is_native_val(lnt)) {
            self._push(js_undefined());
        } else {
            self._push(lnt);
        }
    }

    """INFER_NAME_FROM_KEY — computed-key function name inference (ES §12.2.6.9 /
    SetFunctionName).  Stack (unchanged): [..., key, fn] with fn on top.  If fn is an
    anonymous closure, set its `.name` from `key`'s property key: a String/Number key
    → its ToString; a Symbol key → "[description]" (or "" when the Symbol has no
    description).  arg2: 1 → prefix "get ", 2 → "set " (accessors)."""
    def _op_infer_name_from_key(
        frame: CallFrame, ins: Instruction, st: ExecState
    ) -> None {
        inf_sn: int = len(self.stack);
        if inf_sn < 2 {
            return;
        }
        inf_fn: JSValue = self.stack[inf_sn - 1];  # fn on top
        inf_key: JSValue = self.stack[inf_sn - 2];  # key below fn
        # Compute the inferred name from the key (String/Number → ToString; Symbol →
        # "[description]" / "").  arg2 prefixes "get "/"set " for accessors.
        inf_name0: str = "";
        if jsv_is_symbol(inf_key) {
            inf_desc0: str = symbol_description(self.realm, inf_key);
            # A description-less Symbol (`Symbol()`) yields name "" — symbol_description
            # returns the _SYMBOL_NO_DESC sentinel, not "", so guard both (test262
            # object/fn-name-* with an anonymous Symbol key expect name === '').
            if inf_desc0 != "" and inf_desc0 != _SYMBOL_NO_DESC {
                inf_name0 = "[" + inf_desc0 + "]";
            }
        } else {
            inf_name0 = jsval_to_str(inf_key);
        }
        if ins.arg2 == 1 {
            inf_name0 = "get " + inf_name0;
        } elif ins.arg2 == 2 {
            inf_name0 = "set " + inf_name0;
        }
        # An anonymous CLASS expression as a computed-key property value takes its name
        # from the key too (ES §15.7.4 / §12.2.6.9). A class is a WK_IS_CLASS object cell,
        # not is_fn_val, so handle it here: set WK_CLASS_NAME when it is still empty and
        # no explicit `static name` own property shadows it (test262 object/fn-name-class).
        if jsv_is_object_cell(inf_fn)
            and jsv_to_table_id(inf_fn) > 0
            and js_object_has_own(inf_fn, WK_IS_CLASS) {
            # A class stores its `name` as an own WK_NAME data property (seeded to the
            # empty-string placeholder by MAKE_CLASS). Overwrite only the placeholder —
            # a static `name` element (method/field) already wrote a real name and wins
            # (mirrors the SET_PROP __CLASS_NAME__ handler). Write to WK_NAME, not
            # WK_CLASS_NAME (test262 object/fn-name-class: `{ [sym]: class {} }`).
            inf_cls_apply: bool = True;
            if js_object_has_own(inf_fn, WK_NAME) {
                inf_cur_nm: JSValue = js_object_get(inf_fn, WK_NAME);
                inf_is_ph: bool = jsv_is_string_cell(inf_cur_nm)
                    and str_from_id(jsv_to_table_id(inf_cur_nm)) == "";
                if not inf_is_ph {
                    inf_cls_apply = False;
                }
            }
            if inf_cls_apply {
                inf_nm_desc: JSProperty = JSProperty(
                    key=WK_NAME,
                    value=js_str(inf_name0),
                    writable=False,
                    enumerable=False,
                    configurable=True,
                    deleted=False
                );
                js_object_define_property(inf_fn, WK_NAME, inf_nm_desc);
                js_object_set(inf_fn, WK_CLASS_NAME, js_str(inf_name0));
            }
            return;
        }
        if not is_fn_val(inf_fn) {
            return;
        }
        inf_idx: int = get_fn_idx(inf_fn);
        if inf_idx < 0 or inf_idx >= len(self.realm.closures) {
            return;
        }
        inf_cl: JSClosure = self.realm.closures[inf_idx];
        # Only anonymous functions get an inferred name, and only if a name was not
        # already assigned (compile-time inference / an explicit binding).
        if inf_cl.func.name != "" {
            return;
        }
        if jsv_is_object_cell(inf_cl.fn_props)
            and js_object_has_own(inf_cl.fn_props, WK_NAME) {
            return;
        }
        inf_cl.func.name = inf_name0;
    }

    def _op_return(frame: CallFrame, ins: Instruction, st: ExecState) -> None {
        st.ret = self._pop();
        # NOTE: the derived-constructor "this uninitialized" ReferenceError is enforced at
        # FRAME EXIT (see run()), not here — a `return` inside a for-of first runs the
        # loop's IteratorClose, whose `return()` handler may still call `super()` and
        # initialize `this` (ES §10.2.11 step ordering; test derived-class-return-override-*).
        # Dispose all still-open `using` resources in this frame on return (the saved
        # ret value is held separately, so user dispose() running on the stack is safe).
        if len(frame.dispose_stack) > 0 {
            self._dispose_to(frame, 0);
            frame.dispose_marks = [];
            # A dispose method that threw replaces the return completion
            # (§13.15.4: DisposeResources propagates its own abrupt completion).
            # The exception is left set rather than unwound into this frame: the
            # `using` scope is already being torn down, so a catch block inside it
            # must not see it — run()'s frame-exit path propagates it to the caller
            # (and, for an async function, into its promise).
        }
        if st.inline_depth > 0 and not self.had_exception {
            self._inline_return(st);
            return;
        }
        st.running = False;
    }

    """Pop the current inline frame for a proper tail call made from it: the
    callee and its `n` arguments (from `callee_idx` up) move down to the
    frame's stack base — where the caller expects the frame's result — and the
    frame is pooled, leaving the caller as _inline_return would but with the
    call operands instead of a result on top. The tail callee is then entered
    from the stack in the frame's place."""
    def _inline_tail_pop(callee_idx: int, n: int, st: ExecState) {
        tp_top: int = len(self.frames) - 1;
        tp_sb: int = self.frames[tp_top].stack_base;
        if callee_idx > tp_sb {
            tp_k: int = 0;
            while tp_k <= n {
                self.stack[tp_sb + tp_k] = self.stack[callee_idx + tp_k];
                tp_k = tp_k + 1;
            }
            while len(self.stack) > tp_sb + n + 1 {
                self.stack.pop();
            }
        }
        if self.module_fns is not self.frames[tp_top].caller_module_fns {
            self.module_fns = self.frames[tp_top].caller_module_fns;
        }
        self.frames[tp_top].ip = 0;
        if len(self.frame_pool) < _FRAME_POOL_MAX {
            self.frame_pool.append(self.frames[tp_top]);
        }
        del self.frames[tp_top];
        st.inline_depth = st.inline_depth - 1;
        self.call_depth = self.call_depth - 1;
    }

    # Inline-frame return (call_path Phase 3): pop the current inline
    # frame in the SAME _exec loop - trim its operand-stack residue, pool
    # it, and push st.ret onto the CALLER's operand stack.
    def _inline_return(st: ExecState) {
        # The frame is reached through self.frames[top] rather than a local
        # (one retain/release pair fewer per call), and module_fns is only
        # rewritten when the callee actually switched it.
        ir_top: int = len(self.frames) - 1;
        if self.module_fns is not self.frames[ir_top].caller_module_fns {
            self.module_fns = self.frames[ir_top].caller_module_fns;
        }
        ir_sb: int = self.frames[ir_top].stack_base;
        while len(self.stack) > ir_sb {
            self.stack.pop();
        }
        # _exec rebinds its cached frame right after the returning op (V0.4),
        # so its while-condition no longer runs on this popped frame. Zeroing
        # ip stays as a guard for any loop that would check the stale frame:
        # a callee ending on the implicit trailing RETURN_UNDEFINED leaves
        # ip == n_code, which would end that loop silently. Acquire re-zeroes
        # it anyway.
        self.frames[ir_top].ip = 0;
        ir_keep: bool = not self.frames[ir_top].discard_ret;
        if len(self.frame_pool) < _FRAME_POOL_MAX {
            self.frame_pool.append(self.frames[ir_top]);
        }
        del self.frames[ir_top];
        st.inline_depth = st.inline_depth - 1;
        self.call_depth = self.call_depth - 1;
        if ir_keep {
            self._push(st.ret);
        }
        st.ret = js_undefined();
        st.frame_switched = True;
    }

    def _op_return_undefined(
        frame: CallFrame, ins: Instruction, st: ExecState
    ) -> None {
        st.ret = js_undefined();
        if len(frame.dispose_stack) > 0 {
            self._dispose_to(frame, 0);
            frame.dispose_marks = [];
            # Same as RETURN above — leave the exception set for frame exit.
        }
        if st.inline_depth > 0 and not self.had_exception {
            self._inline_return(st);
            return;
        }
        st.running = False;
    }

    def _op_make_function(frame: CallFrame, ins: Instruction, st: ExecState) {
        self._push(self._make_function_value(frame, ins));
    }

    """MAKE_FUNCTION's closure value (the handler body; also the register
    loop's STK fast case, without the operand-stack round trip)."""
    def _make_function_value(frame: CallFrame, ins: Instruction) -> JSValue {
        mf_idx: int = ins.arg;
        inner_mf: CompiledFunction = self.module_fns[mf_idx];
        capt_mf: list[JSValue] = [];
        fv_i_mf: int = 0;
        while fv_i_mf < len(inner_mf.free_vars) {
            fv_nm: str = inner_mf.free_vars[fv_i_mf];
            fv_slot_mf: int = -1;
            if fv_i_mf < len(inner_mf.free_var_slots) {
                fv_slot_mf = inner_mf.free_var_slots[fv_i_mf];
            }
            if fv_slot_mf >= 0 {
                # Direct parent local: use slot index to avoid name-collision ambiguity.
                if fv_slot_mf < self._frame_nl(frame) {
                    capt_mf.append(frame.locals[frame.lb + (fv_slot_mf)]);
                } else {
                    capt_mf.append(js_undefined());
                }
            } else {
                # Transitive or legacy: name scan then free_vals fallback.
                found_mf: bool = False;
                fi_mf: int = 0;
                while fi_mf < len(frame.func.locals) {
                    if frame.func.locals[fi_mf] == fv_nm {
                        capt_mf.append(frame.locals[frame.lb + (fi_mf)]);
                        found_mf = True;
                        fi_mf = len(frame.func.locals);
                    }
                    fi_mf = fi_mf + 1;
                }
                if not found_mf {
                    fi2_mf: int = 0;
                    found2_mf: bool = False;
                    while fi2_mf < len(frame.func.free_vars) {
                        if frame.func.free_vars[fi2_mf] == fv_nm {
                            if fi2_mf < len(frame.free_vals) {
                                capt_mf.append(frame.free_vals[fi2_mf]);
                            } else {
                                capt_mf.append(js_undefined());
                            }
                            found2_mf = True;
                            fi2_mf = len(frame.func.free_vars);
                        }
                        fi2_mf = fi2_mf + 1;
                    }
                    if not found2_mf {
                        capt_mf.append(js_undefined());
                    }
                }
            }
            fv_i_mf = fv_i_mf + 1;
        }
        # Concise methods / accessors have no own `prototype` (ES §10.2.3) — create the
        # closure prototype-less so `.prototype` is undefined and not an own property.
        # Generator methods (`*m(){}`) DO have a prototype (the generator object proto),
        # so only non-generator methods are prototype-less.
        fn_proto_mf: JSValue = js_undefined();
        if not (inner_mf.is_method and not inner_mf.is_generator) {
            fn_proto_mf = js_object_new_ordinary();
        }
        # A generator/async-generator function's `.prototype` object inherits from
        # %GeneratorPrototype% / %AsyncGeneratorPrototype% (ES §27.3), not Object.prototype.
        if inner_mf.is_generator
            and jsv_is_object_cell(fn_proto_mf)
            and jsv_to_table_id(fn_proto_mf) > 0 {
            gp_intrinsic: JSValue = js_generator_get_proto();
            if inner_mf.is_async {
                gp_intrinsic = js_async_generator_get_proto();
            }
            if jsv_is_object_cell(gp_intrinsic) and jsv_to_table_id(gp_intrinsic) > 0 {
                js_object_set_prototype(fn_proto_mf, gp_intrinsic);
            }
        }
        new_cl_mf: JSClosure = make_closure(
            inner_mf, capt_mf, js_undefined(), fn_proto_mf
        );
        new_cl_mf.module_fns = self.module_fns;  # capture the current module's fn list
        # Private names are LEXICALLY scoped (ES §6.2.12 / §15.7): a function declared inside a
        # class member sees that class's private names, so it inherits the enclosing closure's
        # per-evaluation brand. Without this, `method(){ function inner(){ self.#m() } }` sees a
        # 0 brand and the private access is (wrongly) treated as a non-class caller.
        if is_fn_val(frame.self_fn) {
            mf_encl_cl: JSClosure = self.realm.closures[get_fn_idx(frame.self_fn)];
            new_cl_mf.class_brand = mf_encl_cl.class_brand;
            new_cl_mf.class_brand_sid = mf_encl_cl.class_brand_sid;
            # Home realm is lexical: a nested function belongs to the same realm as its encloser.
            new_cl_mf.home_realm_id = mf_encl_cl.home_realm_id;
            # A closure produced by `new realm.Function(...)` carries its realm via a
            # KEY_HOME_REALM_ID fn_props tag (from _vm_copy_home_realm), not the field — pick
            # it up so functions IT creates are stamped too.
            if new_cl_mf.home_realm_id == 0 {
                mf_encl_tag: JSValue = js_object_get(
                    mf_encl_cl.fn_props, KEY_HOME_REALM_ID
                );
                if jsv_is_int32(mf_encl_tag) {
                    new_cl_mf.home_realm_id = jsv_to_int32(mf_encl_tag);
                }
            }
        }
        # Top-level code compiled from a foreign realm's eval/Function: stamp the source realm.
        if new_cl_mf.home_realm_id == 0 and self._pending_source_realm_id != 0 {
            new_cl_mf.home_realm_id = self._pending_source_realm_id;
        }
        # A function defined inside a `with` body inherits that object env record on its
        # scope chain (ES §9.1): capture the active with-objects so name resolution in the
        # closure's frame consults them (see run()/_op_call frame seeding).
        if len(frame.with_objs) > 0 {
            cw_mf: list[JSValue] = [];
            for cw_o_mf in frame.with_objs {
                cw_mf.append(cw_o_mf);
            }
            new_cl_mf.captured_with_objs = cw_mf;
        }
        # Tag CJS-created closures with their defining module so LOAD_GLOBAL
        # for `module`/`exports` resolves the right module in async callbacks.
        # Guard: skip in ESM scope to prevent stale CJS module from leaking.
        if self.esm_entry == 0 {
            cur_mod_mf: JSValue = self._reg_cur_module();
            if jsv_is_object_cell(cur_mod_mf) {
                new_cl_mf.jac_module = cur_mod_mf;
            }
        }
        mf_fn_idx: int = vm_register_closure(self.realm, new_cl_mf);  # G0.5: reuse freed slot
        mf_fn_val: JSValue = js_fn_val(mf_fn_idx);
        # A generator function's `.prototype` is a plain object (proto %GeneratorPrototype%)
        # with NO own `constructor` property (ES §27.3 — unlike ordinary functions).
        if jsv_is_object_cell(fn_proto_mf)
            and jsv_to_table_id(fn_proto_mf) > 0
            and not inner_mf.is_generator {
            js_object_define_nonenum(fn_proto_mf, WK_CONSTRUCTOR, mf_fn_val);
        }
        return mf_fn_val;
    }

    def _op_make_arrow(frame: CallFrame, ins: Instruction, st: ExecState) {
        self._push(self._make_arrow_value(frame, ins));
    }

    """MAKE_ARROW's closure value (the handler body; also the register
    loop's STK fast case)."""
    def _make_arrow_value(frame: CallFrame, ins: Instruction) -> JSValue {
        ma_idx: int = ins.arg;
        inner_ma: CompiledFunction = self.module_fns[ma_idx];
        capt_ma: list[JSValue] = [];
        fv_i_ma: int = 0;
        while fv_i_ma < len(inner_ma.free_vars) {
            fva_nm: str = inner_ma.free_vars[fv_i_ma];
            fva_slot: int = -1;
            if fv_i_ma < len(inner_ma.free_var_slots) {
                fva_slot = inner_ma.free_var_slots[fv_i_ma];
            }
            if fva_slot >= 0 {
                # Direct parent local: use slot index to avoid name-collision ambiguity.
                if fva_slot < self._frame_nl(frame) {
                    capt_ma.append(frame.locals[frame.lb + (fva_slot)]);
                } else {
                    capt_ma.append(js_undefined());
                }
            } else {
                # Transitive or legacy: name scan then free_vals fallback.
                found_ma: bool = False;
                fi_ma: int = 0;
                while fi_ma < len(frame.func.locals) {
                    if frame.func.locals[fi_ma] == fva_nm {
                        capt_ma.append(frame.locals[frame.lb + (fi_ma)]);
                        found_ma = True;
                        fi_ma = len(frame.func.locals);
                    }
                    fi_ma = fi_ma + 1;
                }
                if not found_ma {
                    # Variable not a local — check free_vals passed from an
                    # outer closure (multi-level capture, e.g. grandparent scope).
                    fi2_ma: int = 0;
                    found2_ma: bool = False;
                    while fi2_ma < len(frame.func.free_vars) {
                        if frame.func.free_vars[fi2_ma] == fva_nm {
                            if fi2_ma < len(frame.free_vals) {
                                capt_ma.append(frame.free_vals[fi2_ma]);
                            } else {
                                capt_ma.append(js_undefined());
                            }
                            found2_ma = True;
                            fi2_ma = len(frame.func.free_vars);
                        }
                        fi2_ma = fi2_ma + 1;
                    }
                    if not found2_ma {
                        capt_ma.append(js_undefined());
                    }
                }
            }
            fv_i_ma = fv_i_ma + 1;
        }
        arrow_cl: JSClosure = make_closure(
            inner_ma, capt_ma, frame.this_val, js_undefined()
        );
        arrow_cl.is_arrow = True;
        arrow_cl.lexical_new_target = frame.new_target;
        # Inherit the enclosing frame's shared this-binding cell (if any): an arrow inside a
        # derived constructor shares its this-binding, so `super()` in the arrow initializes
        # the enclosing ctor's `this` (ES §9.1.1.3). Propagates through nested arrows too.
        arrow_cl.this_binding_cell = frame.this_binding_cell;
        arrow_cl.module_fns = self.module_fns;  # capture the current module's fn list
        # B13/§13.3.5: an arrow inherits its [[HomeObject]] and super class lexically
        # from the enclosing method/field/ctor, so `super.x` inside the arrow resolves
        # against the same super context.  Read them off the enclosing frame's own
        # closure (which may itself be an arrow that already inherited them, a method,
        # or a field initializer whose closure we wired in _op_define_field).
        ma_encl_self: JSValue = frame.self_fn;
        # When the enclosing method is a generator, its super_fn lives on the
        # generator state: unwrap it so `super.x` inside an arrow in a
        # generator method resolves against the right home object.
        if jsv_is_object_cell(ma_encl_self) and js_is_generator(ma_encl_self) {
            ma_gst: JSGeneratorState = js_get_generator_state(ma_encl_self);
            ma_encl_self = ma_gst.super_fn;
        }
        # Inside direct eval there is no own self_fn — inherit the eval-entry super fn.
        if not is_fn_val(ma_encl_self) and len(self.eval_super_fns) > 0 {
            ma_encl_self = self.eval_super_fns[len(self.eval_super_fns) - 1];
        }
        if is_fn_val(ma_encl_self) {
            ma_encl_cl: JSClosure = self.realm.closures[get_fn_idx(ma_encl_self)];
            arrow_cl.super_class = ma_encl_cl.super_class;
            arrow_cl.home_object = ma_encl_cl.home_object;
            # Private names are lexically scoped — an arrow inside a class member inherits that
            # class's per-evaluation brand (ES §6.2.12 / §15.7), like super/home above.
            arrow_cl.class_brand = ma_encl_cl.class_brand;
            arrow_cl.class_brand_sid = ma_encl_cl.class_brand_sid;
            arrow_cl.home_realm_id = ma_encl_cl.home_realm_id;
        }
        # Top-level arrow of foreign-realm eval source (no fn-val encloser): stamp source realm.
        if arrow_cl.home_realm_id == 0 and self._pending_source_realm_id != 0 {
            arrow_cl.home_realm_id = self._pending_source_realm_id;
        }
        # Arrows also inherit the enclosing `with` object env records (ES §9.1).
        if len(frame.with_objs) > 0 {
            cw_ma: list[JSValue] = [];
            for cw_o_ma in frame.with_objs {
                cw_ma.append(cw_o_ma);
            }
            arrow_cl.captured_with_objs = cw_ma;
        }
        # Tag CJS-created arrow functions with their defining module (same as MAKE_FUNCTION).
        # Guard: skip in ESM scope to prevent stale CJS module from leaking.
        if self.esm_entry == 0 {
            cur_mod_ma: JSValue = self._reg_cur_module();
            if jsv_is_object_cell(cur_mod_ma) {
                arrow_cl.jac_module = cur_mod_ma;
            }
        }
        return js_fn_val(vm_register_closure(self.realm, arrow_cl));  # G0.5: reuse freed slot
    }

    def _op_make_class(frame: CallFrame, ins: Instruction, st: ExecState) -> None {
        mc_has_super: int = ins.arg;  # 0 = no extends, 1 = extends
        mc_super: JSValue = js_undefined();
        if mc_has_super == 1 {
            mc_super = self._pop();
        }
        # ES §15.7.14 ClassDefinitionEvaluation: a present ClassHeritage must evaluate to
        # null or a constructor — anything else (an arrow / async / generator / concise
        # method, or an ordinary non-callable) is a TypeError (test262 class/heritage-arrow-
        # function, heritage-async-arrow-function: `class extends (() => {})`).
        if mc_has_super == 1
            and not jsv_is_null(mc_super)
            and not _vm_is_constructor(self, mc_super) {
            mc_nc_exc: JSValue = make_type_error(
                "Class extends value is not a constructor"
            );
            if not self._unwind_in_frame(frame, mc_nc_exc) {
                self.had_exception = True;
                self.pending_exc = mc_nc_exc;
                st.running = False;
            }
            return;
        }
        # Create the prototype object for instances; default [[Proto]] = Object.prototype
        mc_proto: JSValue = js_object_new_ordinary();
        if mc_has_super == 1 and not jsv_is_null(mc_super) {
            # ES §15.7.14 step 8: protoParent = ? Get(superclass, "prototype"). This is an
            # OBSERVABLE [[Get]] — a `prototype` accessor getter must run (test262 class/definition
            # /prototype-getter counts the calls). Use obs_get for object/fn supers so the getter
            # fires; native opaque supers have no user accessors, so the fast paths are exact.
            mc_super_proto: JSValue = js_undefined();
            if is_native_val(mc_super) {
                mc_super_proto = _native_prop(mc_super, WK_PROTOTYPE);
            } else {
                mc_super_proto = self.obs_get(mc_super, WK_PROTOTYPE, mc_super);
                if self.had_exception or vm_has_native_exc() {
                    mc_pg_exc: JSValue = self.pending_exc;
                    if vm_has_native_exc() {
                        mc_pg_exc = vm_take_native_exc();
                    }
                    self.had_exception = False;
                    self.pending_exc = js_undefined();
                    if not self._unwind_in_frame(frame, mc_pg_exc) {
                        self.had_exception = True;
                        self.pending_exc = mc_pg_exc;
                        st.running = False;
                    }
                    return;
                }
            }
            # §15.7.14 step 9: protoParent must be an Object or null; anything else (a getter
            # returning 42, or a setter-only accessor → undefined) is a TypeError (test262
            # class/definition/prototype-getter, prototype-setter).
            if jsv_is_object_cell(mc_super_proto) {
                js_object_set_prototype(mc_proto, mc_super_proto);
            } elif jsv_is_null(mc_super_proto) {
                _ = js_object_set_prototype(mc_proto, js_null());
            } else {
                mc_pp_exc: JSValue = make_type_error(
                    "Class extends value does not have valid prototype property"
                );
                if not self._unwind_in_frame(frame, mc_pp_exc) {
                    self.had_exception = True;
                    self.pending_exc = mc_pp_exc;
                    st.running = False;
                }
                return;
            }
        }
        # Create the class object
        mc_cls: JSValue = js_object_create_null();
        js_object_define_nonenum(mc_cls, WK_IS_CLASS, js_int(1));
        mc_clsraw: JSObject = js_object_table_get(jsv_to_table_id(mc_cls));
        mc_clsraw.cell_flags = mc_clsraw.cell_flags | FLAG_IS_CLASS;
        # Per-EVALUATION private brand (ES §15.7). Stashed under `__brand@cur` (the `__brand@`
        # prefix is already filtered from every user-visible own-key surface and it is non-enum,
        # so it never leaks). DEFINE_METHOD/FIELD/GETTER/SETTER copy it onto each element closure
        # (`class_brand`); the synthetic brand-install field stamps the class object / instances
        # with the real `__brand@<sid>` = this value. 0 reserved = "no brand".
        mc_brand: JSValue = js_int(self.class_brand_seq);
        self.class_brand_seq = self.class_brand_seq + 1;
        js_object_define_nonenum(mc_cls, str_intern("__brand@cur"), mc_brand);
        # This class's private-scope id (from the compiler, MAKE_CLASS arg2) — copied onto each
        # element closure so a private access can tell whether the private is the accessing
        # class's OWN (sid match → enforce brand) or an outer class's (nested access → lenient).
        js_object_define_nonenum(
            mc_cls, str_intern("__brandsid@cur"), js_int(ins.arg2)
        );
        # Own-property insertion order MUST be length, name, prototype (ES: ordinary
        # function creation installs `length` then `name`; MakeConstructor then adds
        # `prototype`). Defining prototype first put it ahead of length/name and failed
        # every getOwnPropertyNames/ownKeys order test (e.g. fn-length-static-precedence,
        # computed-name method-*-order). The WK_IS_CLASS/WK_CTOR markers are non-enum and
        # filtered from own-key enumeration, so their positions don't affect user order.
        mc_len_desc: JSProperty = JSProperty(
            key=WK_LENGTH,
            value=js_int(0),
            writable=False,
            enumerable=False,
            configurable=True,
            deleted=False
        );
        js_object_define_property(mc_cls, WK_LENGTH, mc_len_desc);
        mc_name_desc: JSProperty = JSProperty(
            key=WK_NAME,
            value=js_str(""),
            writable=False,
            enumerable=False,
            configurable=True,
            deleted=False
        );
        js_object_define_property(mc_cls, WK_NAME, mc_name_desc);
        mc_proto_desc: JSProperty = JSProperty(
            key=WK_PROTOTYPE,
            value=mc_proto,
            writable=False,
            enumerable=False,
            configurable=False,
            deleted=False
        );
        js_object_define_property(mc_cls, WK_PROTOTYPE, mc_proto_desc);
        js_object_define_nonenum(mc_cls, WK_CTOR, js_undefined());
        js_object_define_nonenum(mc_proto, WK_CONSTRUCTOR, mc_cls);
        if mc_has_super == 1 {
            js_object_set(mc_cls, WK_SUPER, mc_super);
            # Static inheritance (ECMAScript §15.7.14):
            # Child.__proto__ = Parent so Child.staticMethod walks up to Parent.
            if is_fn_val(mc_super) or jsv_is_object_cell(mc_super) {
                js_object_set_prototype(mc_cls, mc_super);
            }
        } else {
            # Base class: [[Prototype]] = Function.prototype (§15.7.14)
            js_object_set_prototype(mc_cls, js_function_get_proto());
        }
        self._push(mc_cls);
    }

    def _op_make_regexp(frame: CallFrame, ins: Instruction, st: ExecState) {
        mr_const: str = frame.func.constants.get(ins.arg);
        # format: "/pattern/flags" — find last "/" to split
        mr_last: int = len(mr_const) - 1;
        while mr_last > 0 and mr_const[mr_last] != "/" {
            mr_last = mr_last - 1;
        }
        mr_pat: str = str_substr(mr_const, 1, mr_last);
        mr_flg: str = str_substr(mr_const, mr_last + 1, len(mr_const));
        self._push(js_regexp_create(mr_pat, mr_flg));
    }

    def _op_define_method(frame: CallFrame, ins: Instruction, st: ExecState) -> None {
        dm_fn: JSValue = self._pop();  # function closure
        # Computed key: arg==-1 means key is on the stack below frame.func.
        dm_key: int = 0;
        if ins.arg == -1 {
            dm_key_val: JSValue = self._pop();
            # ES §13.3.3 ToPropertyKey: an object computed key coerces via ToPrimitive.
            dm_key = self._to_property_key(dm_key_val, frame, st);
            if self._coerce_diverted {
                return;
            }
        } else {
            dm_key = str_intern(frame.func.constants.get(ins.arg));
        }
        dm_cls: JSValue = self._peek();  # class stays on TOS
        dm_is_static: int = ins.arg2;  # 0 = instance, 1 = static
        # Attach super_class to the closure so super() / super.x works.
        # Workaround: load the closure into a LOCAL var first, then mutate
        # through it.  Direct `glob_list[i].field = val` is silently dropped
        # by codegen; going through a local pointer generates the correct
        # GEP+store on the heap object.
        if is_fn_val(dm_fn) {
            dm_super_cv: JSValue = js_object_get(dm_cls, WK_SUPER);
            dm_cl_ref: JSClosure = self.realm.closures[get_fn_idx(dm_fn)];
            dm_cl_ref.super_class = dm_super_cv;
            # ES §13.3.7 SuperProperty uses the method's [[HomeObject]]: `super.x` resolves to
            # GetPrototypeOf([[HomeObject]])[x]. For a genuine BASE class (no ClassHeritage at
            # all — not even `extends null`) there is no super_class, so set HomeObject so super.x
            # resolves via GetPrototypeOf(A.prototype) = %Object.prototype% (test262 class-body-
            # method-definition-super-property). DERIVED classes (incl. `extends null`) keep the
            # existing super_class-based resolution, which correctly handles the null-proto case
            # (super/prop-*-cls-null-proto: super.x on `extends null` throws TypeError).
            if not js_object_has_own(dm_cls, WK_SUPER) {
                if dm_is_static == 1 {
                    dm_cl_ref.home_object = dm_cls;
                } else {
                    dm_cl_ref.home_object = js_object_get(dm_cls, WK_PROTOTYPE);
                }
            }
            # Capture this class's per-evaluation private brand so the method's private
            # accesses match only objects branded by THIS evaluation (ES §15.7).
            dm_cl_ref.class_brand = js_object_get(dm_cls, str_intern("__brand@cur"));
            dm_cl_ref.class_brand_sid = jsv_to_int32(
                js_object_get(dm_cls, str_intern("__brandsid@cur"))
            );
        }
        dm_key_name: str = str_from_id(dm_key);
        # A static method named "prototype" (only reachable via a computed key —
        # `static ["prototype"](){}` — since the literal form is an early SyntaxError)
        # collides with the constructor's own `prototype`: TypeError (ES §15.7.14).
        if dm_is_static == 1 and ins.arg == -1 and dm_key_name == "prototype" {
            dm_pe: JSValue = make_type_error(
                "Classes may not have a static property named 'prototype'"
            );
            if not self._unwind_in_frame(frame, dm_pe) {
                self.had_exception = True;
                self.pending_exc = dm_pe;
                st.running = False;
            }
            return;
        }
        # ES §15.7.10 / §15.7.14: only a NON-computed method literally named
        # `constructor` becomes the class [[Construct]]. A COMPUTED key that happens to
        # evaluate to "constructor" (`['constructor'](){}`, ins.arg == -1) is an ordinary
        # prototype method and must NOT replace the constructor (test262
        # computed-property-names/class/method/constructor).
        if dm_key_name == "constructor" and ins.arg != -1 and dm_is_static != 1 {
            # Set as the callable constructor
            if _DBG_DM_ON and is_fn_val(dm_fn) {
                _dm_dbg_cl: JSClosure = self.realm.closures[get_fn_idx(dm_fn)];
                _dm_dbg_fop: int = -1;
                if len(_dm_dbg_cl.func.code) > 0 {
                    _dm_dbg_fop = opcode_to_int(_dm_dbg_cl.func.code[0].opcode);
                }
                _dm_dbg_cnm: JSValue = js_object_get(dm_cls, WK_NAME);
                _dm_dbg_cns: str = "?";
                if jsv_is_string_cell(_dm_dbg_cnm) {
                    _dm_dbg_cns = str_from_id(jsv_to_table_id(_dm_dbg_cnm));
                }
                _dm_dbg_ln: int = -1;
                if len(_dm_dbg_cl.func.code) > 0 {
                    _dm_dbg_ln = _dm_dbg_cl.func.code[0].line;
                }
                _dm_dbg: str = "[DBG_DM] attach ctor to class='"
                    + _dm_dbg_cns
                    + "' fn_idx="
                    + str(get_fn_idx(dm_fn))
                    + " ctor_first_op="
                    + str(_dm_dbg_fop)
                    + " ctor_bclen="
                    + str(len(_dm_dbg_cl.func.code))
                    + " ctor_line="
                    + str(_dm_dbg_ln)
                    + "\n";
                write(2, _dm_dbg, len(_dm_dbg));
            }
            js_object_set(dm_cls, WK_CTOR, dm_fn);
            dm_arity: int = 0;
            if is_fn_val(dm_fn) {
                dm_fn_idx: int = get_fn_idx(dm_fn);
                if dm_fn_idx >= 0 and dm_fn_idx < len(self.realm.closures) {
                    dm_arity = self.realm.closures[dm_fn_idx].func.expected_arg_count;
                }
            }
            dm_len_desc: JSProperty = JSProperty(
                key=WK_LENGTH,
                value=js_int(dm_arity),
                writable=False,
                enumerable=False,
                configurable=True,
                deleted=False
            );
            js_object_define_property(dm_cls, WK_LENGTH, dm_len_desc);
        } elif dm_is_static == 1 {
            # Static method: on the class object itself.
            # Class methods are non-enumerable (ES §15.7.10 / MethodDefinition
            # evaluation: PropertyDefinitionEvaluation with enumerable=false).
            js_object_define_nonenum(dm_cls, dm_key, dm_fn);
        } else {
            # Instance method: on class.prototype (non-enumerable, see above).
            dm_proto: JSValue = js_object_get(dm_cls, WK_PROTOTYPE);
            js_object_define_nonenum(dm_proto, dm_key, dm_fn);
        }
    }

    def _op_define_getter(frame: CallFrame, ins: Instruction, st: ExecState) -> None {
        # Pop getter function; target stays on TOS.
        dg_fn: JSValue = self._pop();
        dg_key: int = 0;
        if ins.arg == -1 {
            dg_key_val: JSValue = self._pop();
            dg_key = self._to_property_key(dg_key_val, frame, st);
            if self._coerce_diverted {
                return;
            }
        } else {
            dg_key = str_intern(frame.func.constants.get(ins.arg));
        }
        dg_obj: JSValue = self._peek();
        dg_mode: int = ins.arg2;  # 0=instance, 1=static, 2=object literal (direct)
        if dg_mode == 1 and ins.arg == -1 and str_from_id(dg_key) == "prototype" {
            dg_pe: JSValue = make_type_error(
                "Classes may not have a static property named 'prototype'"
            );
            if not self._unwind_in_frame(frame, dg_pe) {
                self.had_exception = True;
                self.pending_exc = dg_pe;
                st.running = False;
            }
            return;
        }
        # Attach super_class to the accessor closure so `super.x`/`super.m()` inside a
        # class getter resolves (mirrors _op_define_method). Class modes only (0/1);
        # object-literal accessors (mode 2) use [[HomeObject]], not a class super.
        if dg_mode != 2 and is_fn_val(dg_fn) {
            dg_super_cv: JSValue = js_object_get(dg_obj, WK_SUPER);
            dg_cl_ref: JSClosure = self.realm.closures[get_fn_idx(dg_fn)];
            dg_cl_ref.super_class = dg_super_cv;
            # Per-evaluation brand: a getter accessing `this.#x` must match only objects branded
            # by THIS evaluation (ES §15.7). Class accessors only (modes 0/1).
            dg_cl_ref.class_brand = js_object_get(dg_obj, str_intern("__brand@cur"));
            dg_cl_ref.class_brand_sid = jsv_to_int32(
                js_object_get(dg_obj, str_intern("__brandsid@cur"))
            );
        }
        if dg_mode == 2 {
            # Object literal: install directly on the object (enumerable by default).
            # B13: set [[HomeObject]] so `super.x` inside the getter resolves against
            # GetPrototypeOf(home) (test262 computed-property-names/object/accessor/
            # getter-super). Class accessors (modes 0/1) use super_class above instead.
            if is_fn_val(dg_fn) {
                dg_hm_cl: JSClosure = self.realm.closures[get_fn_idx(dg_fn)];
                if dg_hm_cl.func.is_method and jsv_is_undefined(dg_hm_cl.home_object) {
                    dg_hm_cl.home_object = dg_obj;
                }
            }
            js_object_set_accessor_getter(dg_obj, dg_key, dg_fn);
        } elif dg_mode == 1 {
            # Static getter: install on the class object itself (non-enumerable, ES §15.7.11).
            js_object_set_accessor_getter(dg_obj, dg_key, dg_fn);
            js_object_set_accessor_enumerable(dg_obj, dg_key, False);
        } else {
            # Instance getter: install on class.prototype (non-enumerable).
            dg_proto: JSValue = js_object_get(dg_obj, WK_PROTOTYPE);
            js_object_set_accessor_getter(dg_proto, dg_key, dg_fn);
            js_object_set_accessor_enumerable(dg_proto, dg_key, False);
        }
    }

    def _op_define_setter(frame: CallFrame, ins: Instruction, st: ExecState) -> None {
        # Pop setter function; target stays on TOS.
        ds_fn: JSValue = self._pop();
        ds_key: int = 0;
        if ins.arg == -1 {
            ds_key_val: JSValue = self._pop();
            ds_key = self._to_property_key(ds_key_val, frame, st);
            if self._coerce_diverted {
                return;
            }
        } else {
            ds_key = str_intern(frame.func.constants.get(ins.arg));
        }
        ds_obj: JSValue = self._peek();
        ds_mode: int = ins.arg2;  # 0=instance, 1=static, 2=object literal (direct)
        if ds_mode == 1 and ins.arg == -1 and str_from_id(ds_key) == "prototype" {
            ds_pe: JSValue = make_type_error(
                "Classes may not have a static property named 'prototype'"
            );
            if not self._unwind_in_frame(frame, ds_pe) {
                self.had_exception = True;
                self.pending_exc = ds_pe;
                st.running = False;
            }
            return;
        }
        # Attach super_class to the accessor closure (see _op_define_getter).
        if ds_mode != 2 and is_fn_val(ds_fn) {
            ds_super_cv: JSValue = js_object_get(ds_obj, WK_SUPER);
            ds_cl_ref: JSClosure = self.realm.closures[get_fn_idx(ds_fn)];
            ds_cl_ref.super_class = ds_super_cv;
            # Per-evaluation brand (ES §15.7) — see _op_define_getter. Class accessors only.
            ds_cl_ref.class_brand = js_object_get(ds_obj, str_intern("__brand@cur"));
            ds_cl_ref.class_brand_sid = jsv_to_int32(
                js_object_get(ds_obj, str_intern("__brandsid@cur"))
            );
        }
        if ds_mode == 2 {
            # Object literal: install directly on the object (enumerable by default).
            # B13 [[HomeObject]] for `super` in the setter (see _op_define_getter).
            if is_fn_val(ds_fn) {
                ds_hm_cl: JSClosure = self.realm.closures[get_fn_idx(ds_fn)];
                if ds_hm_cl.func.is_method and jsv_is_undefined(ds_hm_cl.home_object) {
                    ds_hm_cl.home_object = ds_obj;
                }
            }
            js_object_set_accessor_setter(ds_obj, ds_key, ds_fn);
        } elif ds_mode == 1 {
            # Static setter: install on the class object itself (non-enumerable).
            js_object_set_accessor_setter(ds_obj, ds_key, ds_fn);
            js_object_set_accessor_enumerable(ds_obj, ds_key, False);
        } else {
            # Instance setter: install on class.prototype (non-enumerable).
            ds_proto: JSValue = js_object_get(ds_obj, WK_PROTOTYPE);
            js_object_set_accessor_setter(ds_proto, ds_key, ds_fn);
            js_object_set_accessor_enumerable(ds_proto, ds_key, False);
        }
    }

    # Run a single instance field initializer against `this_obj`. The __FIELDS__
    # entry is either a bare init fn (static/identifier/string key) or a computed
    # wrapper `{__cf_fn, __cf_key}` whose fn takes the captured key as its 1st arg.
    # Returns False if the initializer ended with an abrupt (throw) completion —
    # ES §15.7.10 / InitializeInstanceElements runs each field with `?`, so on the
    # first abrupt completion the remaining fields MUST NOT execute and construction
    # must abort (the caller loop clears its ok-flag and propagates the exception).
    def _run_one_field_init(entry_obj: JSValue, this_obj: JSValue) -> bool {
        if is_fn_val(entry_obj) {
            rfi_cl: JSClosure = self.realm.closures[get_fn_idx(entry_obj)];
            self.run_cl(rfi_cl, entry_obj, this_obj, []);
            if self.had_exception {
                return False;
            }
        } elif jsv_is_string_cell(entry_obj) {
            # Bare no-initializer field: the entry is the key string; define an own
            # {value: undefined, w:T,e:T,c:T} slot (ES §15.7.10 DefineField).
            rfi_bk: int = str_intern(str_from_id(jsv_to_table_id(entry_obj)));
            _ = js_object_create_data_property_or_throw(
                this_obj, rfi_bk, js_undefined()
            );
            if self.had_exception or vm_has_native_exc() {
                return False;
            }
        } elif jsv_is_object_cell(entry_obj) {
            rfi_fn: JSValue = js_object_get(entry_obj, WK_CF_FN);
            if is_fn_val(rfi_fn) {
                rfi_key: JSValue = js_object_get(entry_obj, WK_CF_KEY);
                rfi_cl2: JSClosure = self.realm.closures[get_fn_idx(rfi_fn)];
                self.run_cl(rfi_cl2, rfi_fn, this_obj, [rfi_key]);
                if self.had_exception {
                    return False;
                }
            }
        }
        return True;
    }

    def _op_define_field(frame: CallFrame, ins: Instruction, st: ExecState) -> None {
        # Pop init function; class stays on TOS.
        df_init_fn: JSValue = self._pop();
        # arg3 == 2: BARE no-initializer field (`#x;` / `x;`).  The popped value is
        # the key STRING, not an init fn — no synthetic function was compiled.  The
        # slot is `undefined`; define it directly (static) or record the key so each
        # construction defines it (instance).  Avoids one CompiledFunction+closure
        # per field (§15.7.10; matters for classes with thousands of bare fields).
        df_bare: bool = ins.arg3 == 2;
        # Computed key (arg3 == 1): the evaluated key sits just below the init fn.
        df_computed: bool = ins.arg3 == 1;
        df_key: JSValue = js_undefined();
        if df_computed {
            df_key = self._pop();
            # ES §15.7.10 ClassFieldDefinitionEvaluation: ToPropertyKey runs at
            # class-definition time (same as DEFINE_METHOD for computed names).
            df_key_id: int = self._to_property_key(df_key, frame, st);
            if self._coerce_diverted {
                return;
            }
            df_key = _vm_key_id_to_jsvalue(df_key_id);
        }
        df_cls: JSValue = self._peek();
        df_is_static: int = ins.arg2;
        # W7: field initializers have a [[HomeObject]]/super binding — attach the
        # class's super so `super.x` (and direct eval of it) resolves at runtime.
        if is_fn_val(df_init_fn) {
            df_super_cv: JSValue = js_object_get(df_cls, WK_SUPER);
            df_cl_attach: JSClosure = self.realm.closures[get_fn_idx(df_init_fn)];
            df_cl_attach.super_class = df_super_cv;
            # Capture the class's per-evaluation brand so a field initializer (incl. the
            # synthetic private-brand-install field, which LOAD_CLASS_BRANDs it) can stamp
            # `this` with THIS brand.
            df_cl_attach.class_brand = js_object_get(df_cls, str_intern("__brand@cur"));
            df_cl_attach.class_brand_sid = jsv_to_int32(
                js_object_get(df_cls, str_intern("__brandsid@cur"))
            );
        }
        if df_bare {
            # ins.arg is a CONSTANT-POOL index (the mangled key string), not a
            # string-intern id — resolve it the same way _op_set_prop does.
            df_bare_key: int = str_intern(frame.func.constants.get(ins.arg));
            if df_is_static == 1 {
                _ = js_object_create_data_property_or_throw(
                    df_cls, df_bare_key, js_undefined()
                );
            } else {
                # Instance: store the key string in __FIELDS__; the constructor's
                # field-init loop defines `this[key] = undefined` per instance.
                # OWN lookup only — must not append to a superclass's inherited list.
                dbf_fields: JSValue = js_undefined();
                if js_object_has_own(df_cls, WK_FIELDS) {
                    dbf_fields = js_object_get(df_cls, WK_FIELDS);
                }
                if jsv_is_undefined(dbf_fields) or jsv_is_null(dbf_fields) {
                    dbf_fields = js_object_create_null();
                    js_object_set(dbf_fields, WK_LENGTH, js_int(0));
                    js_object_set(df_cls, WK_FIELDS, dbf_fields);
                }
                dbf_len_v: JSValue = js_object_get(dbf_fields, WK_LENGTH);
                dbf_len: int = 0;
                if jsv_is_int32(dbf_len_v) {
                    dbf_len = jsv_to_int32(dbf_len_v);
                }
                # df_init_fn holds the key as a string value ("s:<key>" const).
                js_object_set(dbf_fields, str_intern_index(dbf_len), df_init_fn);
                js_object_set(dbf_fields, WK_LENGTH, js_int(dbf_len + 1));
            }
            return;
        }
        # A static class field/method may not be named "prototype" (ES §15.7.14 step 6.b) —
        # it would collide with the constructor's own non-configurable `prototype`.
        # Throw a TypeError.  (Non-computed `static prototype` is a SyntaxError caught
        # at parse time; this covers the computed form `static ["prototype"]`.)
        if df_is_static == 1 and df_computed and jsv_is_string_cell(df_key) {
            if str_from_id(jsv_to_table_id(df_key)) == "prototype" {
                df_pe: JSValue = make_type_error(
                    "Classes may not have a static property named 'prototype'"
                );
                if not self._unwind_in_frame(frame, df_pe) {
                    self.had_exception = True;
                    self.pending_exc = df_pe;
                    st.running = False;
                }
                return;
            }
        }
        # B13/§15.7.10: a field initializer has a [[HomeObject]] and thus permits
        # `super.x` (resolved against the parent class).  Wire super_class + the
        # home object onto the init closure exactly like _op_define_method does for
        # concise methods — a STATIC field's home is the class object itself, an
        # INSTANCE field's home is `Cls.prototype`.  Without this, `super.p` inside a
        # field (directly or in a direct eval) resolves against a null super.
        if is_fn_val(df_init_fn) {
            df_super_cv: JSValue = js_object_get(df_cls, WK_SUPER);
            df_fi_cl: JSClosure = self.realm.closures[get_fn_idx(df_init_fn)];
            df_fi_cl.super_class = df_super_cv;
            if df_is_static == 1 {
                df_fi_cl.home_object = df_cls;
            } else {
                df_fi_cl.home_object = js_object_get(df_cls, WK_PROTOTYPE);
            }
        }
        if df_is_static == 1 {
            # ES §15.7.14: a static field/block does NOT run now — its property KEY has
            # already been evaluated above; the INITIALIZER is deferred to a single
            # source-ordered pass (RUN_STATIC_ELEMENTS) that runs AFTER every element's key
            # is evaluated. So record it into __STATIC_FIELDS__ (mirrors instance __FIELDS__,
            # but for statics, wrapping the (fn, key) pair for a computed key). Static blocks
            # arrive here too (empty key, is_fn_val) and defer identically.
            if is_fn_val(df_init_fn) {
                # OWN lookup only: js_object_get would find a superclass's
                # __STATIC_FIELDS__ through the static proto chain, appending
                # this class's statics to the parent's already-consumed list —
                # the subclass then never gets an own list and its static
                # initializers silently never run.
                dsf_list: JSValue = js_undefined();
                if js_object_has_own(df_cls, str_intern("__STATIC_FIELDS__")) {
                    dsf_list = js_object_get(df_cls, str_intern("__STATIC_FIELDS__"));
                }
                if jsv_is_undefined(dsf_list) or jsv_is_null(dsf_list) {
                    dsf_list = js_object_create_null();
                    js_object_set(dsf_list, WK_LENGTH, js_int(0));
                    js_object_set(df_cls, str_intern("__STATIC_FIELDS__"), dsf_list);
                }
                dsf_len_v: JSValue = js_object_get(dsf_list, WK_LENGTH);
                dsf_len: int = 0;
                if jsv_is_int32(dsf_len_v) {
                    dsf_len = jsv_to_int32(dsf_len_v);
                }
                dsf_entry: JSValue = df_init_fn;
                if df_computed {
                    dsf_wrap: JSValue = js_object_create_null();
                    js_object_set(dsf_wrap, WK_CF_FN, df_init_fn);
                    js_object_set(dsf_wrap, WK_CF_KEY, df_key);
                    dsf_entry = dsf_wrap;
                }
                js_object_set(dsf_list, str_intern_index(dsf_len), dsf_entry);
                js_object_set(dsf_list, WK_LENGTH, js_int(dsf_len + 1));
            }
        } else {
            # Instance field: append init fn to __FIELDS__ array on the class.
            # OWN lookup only — same proto-chain trap as __STATIC_FIELDS__:
            # `class C extends P { c = 2 }` must not append to P's inherited
            # list (that made every `new P()` also run C's initializers).
            df_fields: JSValue = js_undefined();
            if js_object_has_own(df_cls, WK_FIELDS) {
                df_fields = js_object_get(df_cls, WK_FIELDS);
            }
            if jsv_is_undefined(df_fields) or jsv_is_null(df_fields) {
                df_fields = js_object_create_null();
                js_object_set(df_fields, WK_LENGTH, js_int(0));
                js_object_set(df_cls, WK_FIELDS, df_fields);
            }
            df_len_v: JSValue = js_object_get(df_fields, WK_LENGTH);
            df_len: int = 0;
            if jsv_is_int32(df_len_v) {
                df_len = jsv_to_int32(df_len_v);
            }
            df_entry: JSValue = df_init_fn;
            if df_computed {
                # Wrap the (fn, key) pair so the constructor's field-init loop can pass
                # the captured key to the 1-param init fn. Bare fns stay bare (no key).
                df_wrap: JSValue = js_object_create_null();
                js_object_set(df_wrap, WK_CF_FN, df_init_fn);
                js_object_set(df_wrap, WK_CF_KEY, df_key);
                df_entry = df_wrap;
            }
            js_object_set(df_fields, str_intern_index(df_len), df_entry);
            js_object_set(df_fields, WK_LENGTH, js_int(df_len + 1));
        }
    }

    """ES §15.7.14 ClassDefinitionEvaluation step 33: run the class's static elements
    (static field initializers AND static blocks), in source order, with this=class. They
    were deferred here by DEFINE_FIELD(static) so that ALL element property keys are
    evaluated first. The class stays on TOS (this opcode neither pops nor pushes)."""
    def _op_run_static_elements(
        frame: CallFrame, ins: Instruction, st: ExecState
    ) -> None {
        rse_cls: JSValue = self._peek();
        # Read __STATIC_FIELDS__ as an OWN property only — a subclass `class D extends C {}`
        # inherits C's __STATIC_FIELDS__ via the static prototype chain, and running them with
        # this=D would (wrongly) stamp D with C's static private brand.
        rse_key: int = str_intern("__STATIC_FIELDS__");
        if not js_object_has_own(rse_cls, rse_key) {
            return;
        }
        rse_list: JSValue = js_object_get(rse_cls, rse_key);
        if not (jsv_is_object_cell(rse_list) and jsv_to_table_id(rse_list) >= 0) {
            return;
        }
        rse_len_v: JSValue = js_object_get(rse_list, WK_LENGTH);
        rse_len: int = 0;
        if jsv_is_int32(rse_len_v) {
            rse_len = jsv_to_int32(rse_len_v);
        }
        rse_i: int = 0;
        while rse_i < rse_len {
            rse_entry: JSValue = js_object_get(rse_list, str_intern_index(rse_i));
            if not self._run_one_field_init(rse_entry, rse_cls) {
                # ES §10.2.1.3 / §15.7.10: an abrupt completion in a static field
                # initializer / static block abandons the REMAINING static elements.
                rse_exc: JSValue = self.pending_exc;
                if vm_has_native_exc() {
                    rse_exc = vm_take_native_exc();
                }
                self.had_exception = False;
                self.pending_exc = js_undefined();
                if not self._unwind_in_frame(frame, rse_exc) {
                    self.had_exception = True;
                    self.pending_exc = rse_exc;
                    st.running = False;
                }
                return;
            }
            rse_i = rse_i + 1;
        }
    }

    def _op_super_call(frame: CallFrame, ins: Instruction, st: ExecState) -> None {
        # super(args) — call super-class constructor with current this
        sc_nc: int = ins.arg;
        sc_args: list[JSValue] = [];
        sc_ai: int = 0;
        while sc_ai < sc_nc {
            sc_args.append(self._pop());
            sc_ai = sc_ai + 1;
        }
        sc_ai = 0;
        sc_hi: int = sc_nc - 1;
        while sc_ai < sc_hi {
            sc_sw: JSValue = sc_args[sc_ai];
            sc_args[sc_ai] = sc_args[sc_hi];
            sc_args[sc_hi] = sc_sw;
            sc_ai = sc_ai + 1;
            sc_hi = sc_hi - 1;
        }
        if (ins.arg3 & 8) != 0 {
            sc_args = _expand_spreads(sc_args);
        }
        # Shared this-binding cell state, captured BEFORE running the super constructor
        # (ES §13.3.7.1: Construct runs first, THEN BindThisValue). sc_already means the
        # this-binding was already initialized → a second super() (directly or via an
        # arrow) is a ReferenceError, but only AFTER the super ctor's observable side
        # effects. sc_depth0 = operand-stack depth after args are popped; the super ctor
        # pushes exactly one result on success, so depth==sc_depth0+1 signals it completed
        # normally (distinguishes a caught throw, which unwinds the stack).
        sc_cell: JSValue = frame.this_binding_cell;
        sc_already: bool = False;
        if sc_cell != 0 {
            sc_already = not js_is_tdz(cell_get(sc_cell));
        }
        sc_depth0: int = len(self.stack);
        # super() initializes `this` (ES §13.3.7.1 BindThisValue): clear the this-TDZ
        # so `this` is accessible in the rest of the derived constructor body.
        frame.this_uninitialized = False;
        # Get super class from the current closure.
        # Workaround: load into local ref first; direct global_list[i].field read is dropped.
        sc_super: JSValue = js_undefined();
        if is_fn_val(frame.self_fn) {
            sc_cl_ref: JSClosure = self.realm.closures[get_fn_idx(frame.self_fn)];
            sc_super = sc_cl_ref.super_class;
        }
        # The super class's native-constructor marker, read once (the branches
        # below each looked it up again: six misses for a JS class).
        sc_has_ck: bool = jsv_is_object_cell(sc_super)
            and jsv_to_table_id(sc_super) > 0
            and js_object_has_own(sc_super, KEY_CTOR_KIND);
        sc_ck_v: int = -1;
        if sc_has_ck {
            sc_ck_v = jsv_to_int32(js_object_get(sc_super, KEY_CTOR_KIND));
        }
        sc_ck_kind: int = -1;
        if is_native_val(sc_super) {
            sc_ck_kind = get_native_kind(sc_super);
        } elif sc_has_ck and jsv_is_int32(js_object_get(sc_super, KEY_CTOR_KIND)) {
            sc_ck_kind = sc_ck_v;
        }
        if sc_ck_kind == NATIVE_KIND_PROMISE {
            # `class X extends Promise` — super(executor), §27.2.3.1. Handled before
            # the native/KEY_CTOR_KIND branches because %Promise% reaches here in
            # both shapes (opaque native value and callable JSObject) and neither
            # generic path is right: they call the native constructor and copy its
            # own *enumerable* properties onto `this`, but a promise keeps its state
            # in hidden slots, so `this` never became a promise and every capability
            # built from a subclass came back with undefined resolve/reject.
            # Initialize `this` in place instead, then run the executor against it.
            sc_pexec: JSValue = js_undefined();
            if len(sc_args) > 0 {
                sc_pexec = sc_args[0];
            }
            if not self._value_is_callable(sc_pexec) {
                exc_scp: JSValue = make_type_error(
                    "Promise resolver is not a function"
                );
                if not self._unwind_in_frame(frame, exc_scp) {
                    self.had_exception = True;
                    self.pending_exc = exc_scp;
                    st.running = False;
                }
            } else {
                js_promise_init_in_place(frame.this_val);
                sc_pres: JSValue = js_make_resolve_fn(frame.this_val);
                sc_prej: JSValue = js_make_reject_fn(frame.this_val);
                _gtr_scp: int = len(self.realm.gc_temp_roots);
                self.realm.gc_temp_roots.append(frame.this_val);
                self._invoke_callable_value(
                    sc_pexec, js_undefined(), [sc_pres, sc_prej]
                );
                _gtr_scp_n: int = len(self.realm.gc_temp_roots);
                while _gtr_scp_n > _gtr_scp {
                    _gtr_scp_n = _gtr_scp_n - 1;
                    del self.realm.gc_temp_roots[_gtr_scp_n];
                }
                # A throw from the executor rejects the promise (§27.2.3.1 step 10)
                # rather than propagating out of super().
                if self.had_exception {
                    exc_scpe: JSValue = self.pending_exc;
                    self.had_exception = False;
                    self.pending_exc = js_undefined();
                    self._promise_settle_and_drain(
                        frame.this_val, PROMISE_REJECTED, exc_scpe
                    );
                }
                self._push(js_undefined());
            }
        } elif is_native_val(sc_super) {
            # Native super constructor (Error, TypeError, etc.) represented as an
            # opaque native value.  Call it, then copy message/stack/name onto `this`.
            sc_nk: int = get_native_kind(sc_super);
            sc_err_obj: JSValue = _vm_call_native_proxy_aware(
                self, self.realm, sc_nk, frame.this_val, sc_args
            );
            if jsv_is_object_cell(sc_err_obj) and jsv_to_table_id(sc_err_obj) > 0 {
                # Copy every own key with its FULL descriptor so Error's
                # non-enumerable message/stack (§20.5.1.1) propagate to the subclass
                # instance with their real attributes, not forced to {w:T,e:F,c:T}.
                sc_ek: list[int] = js_object_all_keys(sc_err_obj);
                sc_ei: int = 0;
                while sc_ei < len(sc_ek) {
                    sc_epd: JSProperty = js_object_get_own_property_descriptor(
                        sc_err_obj, sc_ek[sc_ei]
                    );
                    if not sc_epd.deleted {
                        js_object_define_property(frame.this_val, sc_ek[sc_ei], sc_epd);
                    }
                    sc_ei = sc_ei + 1;
                }
            }
            self._push(js_undefined());
        } elif sc_has_ck and sc_ck_v == NATIVE_KIND_ARRAY {
            js_array_init_exotic_from_args(frame.this_val, sc_args);
            if vm_has_native_exc() {
                exc_arr_sc: JSValue = vm_take_native_exc();
                if not self._unwind_in_frame(frame, exc_arr_sc) {
                    self.had_exception = True;
                    self.pending_exc = exc_arr_sc;
                    st.running = False;
                }
            } else {
                self._push(js_undefined());
            }
        } elif sc_has_ck and sc_ck_v == NATIVE_KIND_DATE {
            # super() for `class X extends Date` — Date() as a plain call returns a
            # String (§21.4.2.1), so build the time value with js_Date_construct and
            # copy its internal slots (_KEY_IS_DATE / __ms) onto the subclass `this`
            # so it is a genuine Date instance.
            sc_date: JSValue = _vm_date_construct_obs(self, sc_args);
            if vm_has_native_exc() {
                exc_scd: JSValue = vm_take_native_exc();
                if not self._unwind_in_frame(frame, exc_scd) {
                    self.had_exception = True;
                    self.pending_exc = exc_scd;
                    st.running = False;
                }
            } else {
                if jsv_is_object_cell(sc_date) and jsv_to_table_id(sc_date) > 0 {
                    sc_dk: list[int] = js_object_all_keys(sc_date);
                    sc_di: int = 0;
                    while sc_di < len(sc_dk) {
                        sc_dpd: JSProperty = js_object_get_own_property_descriptor(
                            sc_date, sc_dk[sc_di]
                        );
                        if not sc_dpd.deleted {
                            js_object_define_property(
                                frame.this_val, sc_dk[sc_di], sc_dpd
                            );
                        }
                        sc_di = sc_di + 1;
                    }
                }
                self._push(js_undefined());
            }
        } elif sc_has_ck
            and (sc_ck_v == NATIVE_KIND_SYMBOL or sc_ck_v == NATIVE_KIND_BIGINT) {
            # `super()` for `class S extends Symbol/BigInt` — [[Construct]] throws
            # because NewTarget is not undefined (§20.4.1.1 / §21.2.1.1).
            sc_nk_sb: int = sc_ck_v;
            sc_sb_nm: str = "Symbol";
            if sc_nk_sb == NATIVE_KIND_BIGINT {
                sc_sb_nm = "BigInt";
            }
            exc_sc_sb: JSValue = make_type_error(sc_sb_nm + " is not a constructor");
            if not self._unwind_in_frame(frame, exc_sc_sb) {
                self.had_exception = True;
                self.pending_exc = exc_sc_sb;
                st.running = False;
            }
        } elif sc_has_ck {
            # Native constructor JSObject (Temporal, Error, …) — initialize `this`.
            sc_nk2: int = sc_ck_v;
            sc_ctor_res: JSValue = _vm_call_native_proxy_aware(
                self, self.realm, sc_nk2, frame.this_val, sc_args
            );
            if vm_has_native_exc() {
                exc_scn: JSValue = vm_take_native_exc();
                if not self._unwind_in_frame(frame, exc_scn) {
                    self.had_exception = True;
                    self.pending_exc = exc_scn;
                    st.running = False;
                }
            } else {
                if jsv_is_object_cell(sc_ctor_res)
                    and jsv_to_table_id(sc_ctor_res) > 0
                    and sc_ctor_res != frame.this_val {
                    sc_ek2: list[int] = js_object_all_keys(sc_ctor_res);
                    sc_ei2: int = 0;
                    while sc_ei2 < len(sc_ek2) {
                        sc_epd2: JSProperty = js_object_get_own_property_descriptor(
                            sc_ctor_res, sc_ek2[sc_ei2]
                        );
                        if not sc_epd2.deleted {
                            js_object_define_property(
                                frame.this_val, sc_ek2[sc_ei2], sc_epd2
                            );
                        }
                        sc_ei2 = sc_ei2 + 1;
                    }
                }
                # Boolean/Number/String [[…Data]] slots are unreachable via descriptors
                # (negative keys); the plain-call construct dispatch also returns a bare
                # primitive — install it explicitly onto the derived `this`.
                self._copy_primitive_wrapper_slot(sc_ctor_res, frame.this_val);
                self._push(js_undefined());
            }
        } elif sc_has_ck and _is_error_native_kind(sc_ck_v) {
            # Native Error super constructor represented as a callable JSObject
            # (Error/TypeError/… are js_callable_create objects carrying KEY_CTOR_KIND
            # rather than opaque native values). Same behaviour as the is_native_val()
            # branch: call the native ctor and copy its own properties (message/stack/
            # name) onto `this`. Scoped to error kinds — other native supers (Array,
            # Map, …) keep their existing exotic-object construction path below.
            sc_nk2: int = sc_ck_v;
            sc_err_obj2: JSValue = _vm_call_native_proxy_aware(
                self, self.realm, sc_nk2, frame.this_val, sc_args
            );
            if jsv_is_object_cell(sc_err_obj2) and jsv_to_table_id(sc_err_obj2) > 0 {
                sc_ek2: list[int] = js_object_all_keys(sc_err_obj2);
                sc_ei2: int = 0;
                while sc_ei2 < len(sc_ek2) {
                    sc_epd2: JSProperty = js_object_get_own_property_descriptor(
                        sc_err_obj2, sc_ek2[sc_ei2]
                    );
                    if not sc_epd2.deleted {
                        js_object_define_property(
                            frame.this_val, sc_ek2[sc_ei2], sc_epd2
                        );
                    }
                    sc_ei2 = sc_ei2 + 1;
                }
            }
            self._push(js_undefined());
        } elif jsv_is_object_cell(sc_super) and jsv_to_table_id(sc_super) >= 0 {
            sc_ctor_fn: JSValue = js_object_get(sc_super, WK_CTOR);
            if is_fn_val(sc_ctor_fn) {
                sc_cl2: JSClosure = self.realm.closures[get_fn_idx(sc_ctor_fn)];
                # If the super class is a BASE class, InitializeInstanceElements runs
                # its own instance fields BEFORE its constructor body (§10.2.2 /
                # §9.2.1.3) — a bare field decl (`options;`) defines `this.options =
                # undefined` first, and the ctor body's `this.options = []` then wins.
                # Running fields after the body (as before) clobbered ctor
                # assignments with undefined (vite/cac Command class).
                if not js_object_has_own(sc_super, WK_SUPER) {
                    if not self._run_class_own_fields(
                        sc_super, frame.this_val, frame, st
                    ) {
                        return;
                    }
                }
                # new.target propagates through super() to the super constructor —
                # it stays the original leaf `new` target (ES §13.3.7.1 SuperCall).
                self._pending_new_target = frame.new_target;
                sc_res: JSValue = self.run_cl(
                    sc_cl2, sc_ctor_fn, frame.this_val, sc_args
                );
                if self.had_exception {
                    exc_sc: JSValue = self.pending_exc;
                    self.had_exception = False;
                    self.pending_exc = js_undefined();
                    if not self._unwind_in_frame(frame, exc_sc) {
                        self.had_exception = True;
                        self.pending_exc = exc_sc;
                        st.running = False;
                    }
                } else {
                    # ES §10.2.2 / SuperCall: if the super constructor returns an
                    # Object, that replaces the derived `this` (BindThisValue).
                    if jsv_is_any_object(sc_res) and sc_res != frame.this_val {
                        frame.this_val = sc_res;
                    }
                    # (Base-class own fields already ran BEFORE the ctor body above.)
                    # THIS (derived) class's own fields are initialized AFTER this-binding,
                    # below (see the BindThisValue block) — a field initializer that reads
                    # `this` must observe the bound value, not the TDZ cell.
                    # Super call done; don't push — super() is used as a statement
                    self._push(js_undefined());
                }
            } else {
                # Super class object with no callable WK_CTOR (implicit constructor).
                # Walk its implicit chain: construct through the nearest ancestor
                # with a real ctor (or the base) and run each implicit ancestor's
                # own fields topmost-first — a lone _run_class_own_fields(sc_super)
                # skipped every ancestor above a mid-chain implicit class.
                if not self._construct_implicit_chain(
                    sc_super, frame.this_val, sc_args, frame.new_target, frame, st
                ) {
                    return;
                }
                self._push(js_undefined());
            }
        } elif is_fn_val(sc_super) {
            # super() where the base class is a PLAIN FUNCTION closure (e.g.
            # `class Buffer extends Uint8Array` where Uint8Array is a function created
            # via `new Function` in binary_types.js). Invoke the function as a
            # constructor with the derived `this`, so its body's `this.x = …` mutations
            # (e.g. TypedArray's `_length`/`_isTypedArrayInstance`) land on the instance.
            sc_fn_cl: JSClosure = self.realm.closures[get_fn_idx(sc_super)];
            self._pending_new_target = frame.new_target;
            self.pending_new_target = frame.new_target;
            sc_fn_res: JSValue = self.run_cl(
                sc_fn_cl, sc_super, frame.this_val, sc_args
            );
            if self.had_exception {
                exc_scf: JSValue = self.pending_exc;
                self.had_exception = False;
                self.pending_exc = js_undefined();
                if not self._unwind_in_frame(frame, exc_scf) {
                    self.had_exception = True;
                    self.pending_exc = exc_scf;
                    st.running = False;
                }
            } else {
                # A base constructor that RETURNS an object replaces `this` (ES §10.2.2).
                if jsv_is_any_object(sc_fn_res) and sc_fn_res != frame.this_val {
                    frame.this_val = sc_fn_res;
                }
                self._push(js_undefined());
            }
        } else {
            self._push(js_undefined());
        }
        # BindThisValue (ES §13.3.7.1 step 7), applied only when this frame carries a shared
        # this-binding cell (a derived ctor, or an arrow lexically inside one) and the super
        # constructor completed normally — exactly one result pushed (depth==sc_depth0+1) with
        # no pending exception. This is what lets `super()` invoked from an arrow initialize
        # the ENCLOSING ctor's `this` through the shared cell.
        if sc_cell != 0
            and not self.had_exception
            and len(self.stack) == sc_depth0 + 1 {
            if sc_already {
                # `this` was already initialized → a repeated super() is a ReferenceError.
                # The super ctor already ran above, so its side effects are observable first.
                _ = self._pop();  # discard the result the super-ctor branch pushed
                exc_sc_dup: JSValue = make_reference_error(
                    "Super constructor may only be called once per derived class instance"
                );
                if not self._unwind_in_frame(frame, exc_sc_dup) {
                    self.had_exception = True;
                    self.pending_exc = exc_sc_dup;
                    st.running = False;
                }
            } else {
                cell_set(sc_cell, frame.this_val);
                # ES §13.3.7.1 SuperCall step 11: after BindThisValue, run
                # InitializeInstanceFields(this, F) where F is the ACTIVE constructor's class —
                # the DERIVED class whose ctor is running (frame.ctor_class), NOT the super
                # class (the super initialized its own fields via its own construction). Run it
                # HERE, after `this` is bound, so a field initializer that reads `this` observes
                # the bound value. A repeated super() (sc_already) never reaches this branch, so
                # fields run exactly once.
                self._run_super_derived_fields(frame, st);
            }
        }
    }

    """Run the derived (active) class's own instance-field initializers on frame.this_val,
    from frame.ctor_class's __FIELDS__ (the private-brand install is field 0). Called by
    super() after BindThisValue."""
    def _run_super_derived_fields(frame: CallFrame, st: ExecState) {
        _ = self._run_class_own_fields(frame.ctor_class, frame.this_val, frame, st);
    }

    """Run `cls`'s OWN instance-field initializers (its __FIELDS__ own property) on
    `this_obj`. Returns False if a field abruptly completed (already unwound into `frame`)
    so the caller must `return`; True otherwise. OWN __FIELDS__ only — a class without own
    fields would inherit its super's via the static prototype chain and re-run them."""
    def _run_class_own_fields(
        cls: JSValue, this_obj: JSValue, frame: CallFrame, st: ExecState
    ) -> bool {
        if not (jsv_is_object_cell(cls) and jsv_to_table_id(cls) > 0) {
            return True;
        }
        if not js_object_has_own(cls, WK_FIELDS) {
            return True;
        }
        cof_fields: JSValue = js_object_get(cls, WK_FIELDS);
        if not (jsv_is_object_cell(cof_fields) and jsv_to_table_id(cof_fields) >= 0) {
            return True;
        }
        cof_len_v: JSValue = js_object_get(cof_fields, WK_LENGTH);
        cof_len: int = 0;
        if jsv_is_int32(cof_len_v) {
            cof_len = jsv_to_int32(cof_len_v);
        }
        cof_i: int = 0;
        while cof_i < cof_len {
            cof_fn: JSValue = js_object_get(cof_fields, str_intern_index(cof_i));
            if not self._run_one_field_init(cof_fn, this_obj) {
                cof_exc: JSValue = self.pending_exc;
                if vm_has_native_exc() {
                    cof_exc = vm_take_native_exc();
                }
                self.had_exception = False;
                self.pending_exc = js_undefined();
                if not self._unwind_in_frame(frame, cof_exc) {
                    self.had_exception = True;
                    self.pending_exc = cof_exc;
                    st.running = False;
                }
                return False;
            }
            cof_i = cof_i + 1;
        }
        return True;
    }

    """Construct through an IMPLICIT constructor chain starting at `cls`: walk up
    the class super chain collecting implicit-ctor classes until a class with a
    callable own WK_CTOR (invoke it — its own super()/field logic handles further
    ancestors) or the base is reached; then run each collected class's OWN
    instance fields onto `this_obj`, topmost-first (§10.2.2 construction order).
    With per-class own __FIELDS__ lists, a 3-level `class C extends B extends A`
    where B has an implicit ctor must run A's construction + fields explicitly —
    nothing else will. Returns False if anything unwound into `frame`."""
    def _construct_implicit_chain(
        cls: JSValue,
        this_obj: JSValue,
        args: list[JSValue],
        nt: JSValue,
        frame: CallFrame,
        st: ExecState
    ) -> bool {
        icc_chain: list[JSValue] = [];
        icc_walk: JSValue = cls;
        icc_deep_ctor: JSValue = js_undefined();
        icc_deep_cls: JSValue = js_undefined();
        while jsv_is_object_cell(icc_walk) and jsv_to_table_id(icc_walk) > 0 {
            icc_ctor: JSValue = js_object_get(icc_walk, WK_CTOR);
            if is_fn_val(icc_ctor) {
                icc_deep_ctor = icc_ctor;
                icc_deep_cls = icc_walk;
                break;
            }
            icc_chain.append(icc_walk);
            if not js_object_has_own(icc_walk, WK_SUPER) {
                break;
            }
            icc_next: JSValue = js_object_get(icc_walk, WK_SUPER);
            if not (jsv_is_object_cell(icc_next) and jsv_to_table_id(icc_next) > 0) {
                break;
            }
            icc_walk = icc_next;
        }
        if is_fn_val(icc_deep_ctor) {
            # Base-class own fields run BEFORE its ctor body (§10.2.2 / §9.2.1.3);
            # a derived ctor runs its own fields inside its super() instead.
            if jsv_is_object_cell(icc_deep_cls)
                and not js_object_has_own(icc_deep_cls, WK_SUPER) {
                if not self._run_class_own_fields(icc_deep_cls, this_obj, frame, st) {
                    return False;
                }
            }
            icc_cl: JSClosure = self.realm.closures[get_fn_idx(icc_deep_ctor)];
            self.pending_new_target = nt;
            self._pending_new_target = nt;
            _ = self.run_cl(icc_cl, icc_deep_ctor, this_obj, args);
            if self.had_exception {
                icc_exc: JSValue = self.pending_exc;
                self.had_exception = False;
                self.pending_exc = js_undefined();
                if not self._unwind_in_frame(frame, icc_exc) {
                    self.had_exception = True;
                    self.pending_exc = icc_exc;
                    st.running = False;
                }
                return False;
            }
        }
        icc_i: int = len(icc_chain) - 1;
        while icc_i >= 0 {
            if not self._run_class_own_fields(icc_chain[icc_i], this_obj, frame, st) {
                return False;
            }
            icc_i = icc_i - 1;
        }
        return True;
    }

    def _op_load_super_proto(
        frame: CallFrame, ins: Instruction, st: ExecState
    ) -> None {
        # Push super class .prototype (for super.method() lookup)
        # Workaround: load into local ref first; direct global_list[i].field read is dropped.
        lsp_super: JSValue = js_undefined();
        lsp_home: JSValue = js_undefined();
        lsp_self: JSValue = frame.self_fn;
        # B13: inside a generator method, the frame's self_fn is the generator object —
        # use the originating method closure captured in its state for super resolution.
        if jsv_is_object_cell(lsp_self) and js_is_generator(lsp_self) {
            lsp_gst: JSGeneratorState = js_get_generator_state(lsp_self);
            lsp_self = lsp_gst.super_fn;
        }
        # B13: inside direct-eval code there is no own self_fn super context — inherit
        # the caller method/ctor closure captured at eval entry.
        if not is_fn_val(lsp_self) and len(self.eval_super_fns) > 0 {
            lsp_self = self.eval_super_fns[len(self.eval_super_fns) - 1];
        }
        if is_fn_val(lsp_self) {
            lsp_cl_ref: JSClosure = self.realm.closures[get_fn_idx(lsp_self)];
            lsp_super = lsp_cl_ref.super_class;
            lsp_home = lsp_cl_ref.home_object;
        }
        # Static method/accessor (arg2 == 1): `super.x` resolves against the super
        # *class object itself* (B.x), not B.prototype.x. Push the super class directly.
        if ins.arg2 == 1 {
            if is_fn_val(lsp_super)
                or is_native_val(lsp_super)
                or (
                    jsv_is_object_cell(lsp_super) and jsv_to_table_id(lsp_super) >= 0
                ) {
                self._push(lsp_super);
            } else {
                self._push(js_undefined());
            }
            return;
        }
        # B13: object-literal method — super resolves to GetPrototypeOf([[HomeObject]]).
        if jsv_is_object_cell(lsp_home) and jsv_to_table_id(lsp_home) > 0 {
            self._push(js_object_get_prototype(lsp_home));
            return;
        }
        if is_native_val(lsp_super) {
            self._push(_native_prop(lsp_super, WK_PROTOTYPE));
        } elif is_fn_val(lsp_super) {
            self._push(_fn_prop(lsp_super, WK_PROTOTYPE));
        } elif jsv_is_object_cell(lsp_super) and jsv_to_table_id(lsp_super) >= 0 {
            lsp_proto: JSValue = js_object_get(lsp_super, WK_PROTOTYPE);
            self._push(lsp_proto);
        } else {
            self._push(js_undefined());
        }
    }

    """
    module.syncBuiltinESMExports() — refresh ESM namespace facades from the live
    CJS exports object. Accessor getters on the CJS side are invoked (Node uses
    Reflect.get) so named import live bindings observe getter values.
    """
    def _sync_builtin_esm_exports {
        ns_keys: list[str] = esm_builtin_ns_keys();
        nsi: int = 0;
        while nsi < len(ns_keys) {
            ns_k: str = ns_keys[nsi];
            ns: JSValue = esm_builtin_ns_get(ns_k);
            if not jsv_is_object_cell(ns) {
                nsi = nsi + 1;
                continue;
            }
            cjs: JSValue = js_object_get(ns, str_intern("default"));
            if not jsv_is_object_cell(cjs) {
                nsi = nsi + 1;
                continue;
            }
            prop_keys: list[int] = js_object_all_keys(ns);
            pki: int = 0;
            while pki < len(prop_keys) {
                pk: int = prop_keys[pki];
                if pk >= SYMBOL_KEY_BASE {
                    pki = pki + 1;
                    continue;
                }
                if pk == str_intern("default") {
                    js_object_set(ns, pk, cjs);
                } elif js_object_has_own(cjs, pk)
                    or js_object_has_own_accessor(cjs, pk) {
                    # Accessor-aware Get (invokes getters with `this` = cjs).
                    val: JSValue = self._get_prop_accessor_recv(cjs, pk, cjs);
                    if self.had_exception {
                        self.had_exception = False;
                        self.pending_exc = js_undefined();
                        val = js_undefined();
                    }
                    js_object_set(ns, pk, val);
                } else {
                    js_object_set(ns, pk, js_undefined());
                }
                pki = pki + 1;
            }
            nsi = nsi + 1;
        }
    }

    """Shape require(esm) return value like Node's populateCJSExportsFromESM."""
    def _shape_require_esm_exports(ns: JSValue) -> JSValue {
        me_key: int = str_intern("module.exports");
        if js_object_has_own(ns, me_key) {
            return js_object_get(ns, me_key);
        }
        # Ensure Module @@toStringTag for util.types.isModuleNamespaceObject.
        tag_key: int = SYMBOL_KEY_BASE + SYMBOL_TO_STRING_TAG;
        if not js_object_has_own(ns, tag_key) {
            js_object_define_nonenum(ns, tag_key, js_str("Module"));
        }
        esm_key: int = str_intern("__esModule");
        # Facade: modules with a real `default` export get __esModule = true.
        if js_object_has_own(ns, WK_DEFAULT) and not js_object_has_own(ns, esm_key) {
            js_object_set(ns, esm_key, js_true());
        }
        return ns;
    }

    """Suspend the running async function / async generator at AWAIT and schedule a resume
    reaction that delivers an ALREADY-SETTLED result on the NEXT microtask tick. ES2019
    await always yields exactly one tick even for a plain value or already-fulfilled/
    rejected promise (§27.2.5.4.1 / §6.2.3.1), so promise reactions scheduled around the
    await interleave correctly (test262 await/await-non-promise, async-generator-
    interleaved). `settle_state` is PROMISE_FULFILLED/PROMISE_REJECTED; on rejection the
    resume injects the value as a thrown exception. Works for both regular async functions
    and async generators (self_fn carries the generator; _resume_async_frame drives both)."""
    def _await_suspend_settled(
        frame: CallFrame, st: ExecState, settle_state: int, settle_val: JSValue
    ) {
        asd_ss: list[JSValue] = [];
        asd_si: int = frame.stack_base;
        while asd_si < len(self.stack) {
            asd_ss.append(self.stack[asd_si]);
            asd_si = asd_si + 1;
        }
        # Snapshot locals into a FRESH list: frame.locals may be a pool-backed list
        # (call_path Phase 2 frame pooling reuses/resizes locals in place). A later
        # synchronous `run()` before this frame resumes — e.g. the module load a
        # second `await import()` triggers — would reuse and shrink that same list,
        # corrupting our saved slots (STORE_LOCAL past the resized end → crash).
        asd_locals: list[JSValue] = [];
        asd_li: int = 0;
        asd_nl: int = self._frame_nl(frame);
        while asd_li < asd_nl {
            asd_locals.append(frame.locals[frame.lb + (asd_li)]);
            asd_li = asd_li + 1;
        }
        # Copy catch_stack too (not just locals): the suspended frame's CallFrame
        # object goes back to the frame pool and _frame_acquire empties its
        # catch_stack IN PLACE on reuse, so an aliased list lost the enclosing
        # try/catch — a promise rejected AFTER a top-level `await` suspended
        # then found no handler on resume and the module hung forever.
        asd_cs: list[int] = [];
        asd_ci: int = 0;
        while asd_ci < len(frame.catch_stack) {
            asd_cs.append(frame.catch_stack[asd_ci]);
            asd_ci = asd_ci + 1;
        }
        asd_state: JSGeneratorState = JSGeneratorState(
            func=frame.func,
            locals=asd_locals,
            free_vals=frame.free_vals,
            this_val=frame.this_val,
            catch_stack=asd_cs,
            send_val=js_undefined(),
            saved_stack=asd_ss,
            delegate_gen=frame.self_fn,
            saved_ip=frame.ip,
            saved_rpc=frame.rpc,
            done=False,
            throw_mode=False,
            ret_mode=False,
            stack_base=frame.stack_base,
            async_promise=self._cur_async_promise,
            module_fns=self.module_fns
        );
        self.realm.generators.append(asd_state);
        gc_note_alloc(self.realm);  # G0.4: account generator allocation
        asd_idx: int = len(self.realm.generators) - 1;
        asd_rsm: JSValue = js_object_create_null();
        js_object_set(asd_rsm, _KEY_IS_ASYNC_RESUME, js_true());
        js_object_set(asd_rsm, _KEY_ASYNC_RESUME_IDX, js_int(asd_idx));
        asd_rjt: JSValue = js_object_create_null();
        js_object_set(asd_rjt, _KEY_IS_ASYNC_REJECT, js_true());
        js_object_set(asd_rjt, _KEY_ASYNC_RESUME_IDX, js_int(asd_idx));
        if _VM_PD2 {
            _asd: str = "[PD2] await-SETTLED-suspend idx="
                + str(asd_idx)
                + " state="
                + str(settle_state)
                + "\n";
            write(2, _asd, len(_asd));
        }
        scheduler_push_reaction(
            self.realm, asd_rsm, asd_rjt, settle_state, settle_val, js_undefined()
        );
        self.vm_awaiting = True;
        st.running = False;
    }

    def _op_await(frame: CallFrame, ins: Instruction, st: ExecState) -> None {
        aw_val: JSValue = self._pop();
        # Await(value) → PromiseResolve (ES §27.5.3 / §27.2.1.3.2): a THENABLE — a
        # non-promise object whose `then` is callable — is assimilated rather than treated
        # as a plain value, so `await thenable` (and, via AsyncGeneratorYield, `yield
        # thenable`) observes the thenable's resolved value, not the object. Read `then`
        # exactly once (the spec's single Get), then call it with a fresh promise's
        # resolve/reject and await that promise. Non-thenable values fall through unchanged
        # (preserving this engine's synchronous `await <plain value>` behaviour).
        if not js_is_promise(aw_val)
            and jsv_is_object_cell(aw_val)
            and jsv_to_table_id(aw_val) > 0 {
            aw_then0: JSValue = self.obs_get(aw_val, WK_THEN, aw_val);
            if vm_has_native_exc() {
                aw_te: JSValue = vm_take_native_exc();
                if not self._unwind_in_frame(frame, aw_te) {
                    self.had_exception = True;
                    self.pending_exc = aw_te;
                    st.running = False;
                }
                return;
            }
            if self.had_exception {
                aw_te2: JSValue = self.pending_exc;
                self.had_exception = False;
                self.pending_exc = js_undefined();
                if not self._unwind_in_frame(frame, aw_te2) {
                    self.had_exception = True;
                    self.pending_exc = aw_te2;
                    st.running = False;
                }
                return;
            }
            if self._value_is_callable(aw_then0) {
                aw_wrap0: JSValue = js_promise_create();
                aw_rfn0: JSValue = js_make_resolve_fn(aw_wrap0);
                aw_jfn0: JSValue = js_make_reject_fn(aw_wrap0);
                _vm_invoke_callback(self, aw_then0, aw_val, [aw_rfn0, aw_jfn0]);
                if self.had_exception {
                    aw_ce: JSValue = self.pending_exc;
                    self.had_exception = False;
                    self.pending_exc = js_undefined();
                    if js_promise_get_state(aw_wrap0) == PROMISE_PENDING {
                        self._promise_settle_and_drain(
                            aw_wrap0, PROMISE_REJECTED, aw_ce
                        );
                    }
                } elif vm_has_native_exc() {
                    if js_promise_get_state(aw_wrap0) == PROMISE_PENDING {
                        self._promise_settle_and_drain(
                            aw_wrap0, PROMISE_REJECTED, vm_take_native_exc()
                        );
                    }
                }
                aw_val = aw_wrap0;
            }
        }
        # require(esm) sync evaluation (Node 22+): ANY top-level await in the
        # graph → ERR_REQUIRE_ASYNC_MODULE (Node checks hasAsyncGraph).
        if self.sync_require_esm > 0 {
            aw_sync_exc: JSValue = make_err_require_async_module_full(
                self.sync_require_esm_file, self.sync_require_esm_parent
            );
            if not self._unwind_in_frame(frame, aw_sync_exc) {
                self.had_exception = True;
                self.pending_exc = aw_sync_exc;
                st.running = False;
            }
            return;
        }
        if js_is_promise(aw_val) and js_promise_get_state(aw_val) == PROMISE_PENDING {
            # PENDING — save frame state and register an async resume reaction.
            # When the promise later settles, _resume_async_frame restores execution.

            # 1. Snapshot the operand stack above stack_base
            aw_ss: list[JSValue] = [];
            aw_si: int = frame.stack_base;
            while aw_si < len(self.stack) {
                aw_ss.append(self.stack[aw_si]);
                aw_si = aw_si + 1;
            }

            # 2. Save frame snapshot as a JSGeneratorState (reuses the generator table)
            # Copy locals into a fresh list — see _await_suspend_settled: frame.locals
            # may be pool-backed and resized by a later synchronous run() before resume.
            aw_locals: list[JSValue] = [];
            aw_li: int = 0;
            aw_nl: int = self._frame_nl(frame);
            while aw_li < aw_nl {
                aw_locals.append(frame.locals[frame.lb + (aw_li)]);
                aw_li = aw_li + 1;
            }
            # Copy catch_stack too (not just locals): the suspended frame's CallFrame
            # object goes back to the frame pool and _frame_acquire empties its
            # catch_stack IN PLACE on reuse, so an aliased list lost the enclosing
            # try/catch — a promise rejected AFTER a top-level `await` suspended
            # then found no handler on resume and the module hung forever.
            aw_cs: list[int] = [];
            aw_ci: int = 0;
            while aw_ci < len(frame.catch_stack) {
                aw_cs.append(frame.catch_stack[aw_ci]);
                aw_ci = aw_ci + 1;
            }
            aw_state: JSGeneratorState = JSGeneratorState(
                func=frame.func,
                locals=aw_locals,
                free_vals=frame.free_vals,
                this_val=frame.this_val,
                catch_stack=aw_cs,
                send_val=js_undefined(),
                saved_stack=aw_ss,
                delegate_gen=frame.self_fn,
                saved_ip=frame.ip,
                saved_rpc=frame.rpc,
                done=False,
                throw_mode=False,
                ret_mode=False,
                stack_base=frame.stack_base,
                async_promise=self._cur_async_promise,
                module_fns=self.module_fns
            );
            self.realm.generators.append(aw_state);
            gc_note_alloc(self.realm);  # G0.4: account generator allocation
            aw_idx: int = len(self.realm.generators) - 1;

            aw_rsm: JSValue = js_object_create_null();
            js_object_set(aw_rsm, _KEY_IS_ASYNC_RESUME, js_true());
            js_object_set(aw_rsm, _KEY_ASYNC_RESUME_IDX, js_int(aw_idx));
            aw_rjt: JSValue = js_object_create_null();
            js_object_set(aw_rjt, _KEY_IS_ASYNC_REJECT, js_true());
            js_object_set(aw_rjt, _KEY_ASYNC_RESUME_IDX, js_int(aw_idx));

            # `await` registers a rejection handler, so the promise must not be reported
            # as an unhandled rejection when it later rejects.
            promise_unmark_unhandled(aw_val);
            process_queue_rejection_handled(aw_val);
            js_promise_add_reaction(aw_val, aw_rsm, aw_rjt, js_undefined());

            # Root the awaited promise until this frame resumes. The resume
            # reaction above holds only aw_idx; nothing else GC-visibly
            # references aw_val, so a GC before it settles would sweep it (and
            # its reaction), stranding the frame. Dropped in _resume_async_frame.
            gc_await_root_add(aw_idx, aw_val);

            self.vm_awaiting = True;
            st.running = False;
        } elif js_is_async_generator(frame.self_fn) {
            # ASYNC GENERATOR body: awaits (both a real `await` and a `yield`-operand await,
            # `yield x` → `AWAIT x; YIELD`) drive INLINE. run_generator drives yields
            # synchronously within one .next() step and there is no §27.6 request queue yet,
            # so deferring an await here (which suspends the body) lets a second .next()
            # arriving mid-step re-drive the generator — regressing yield-* / spread /
            # reject-next / `yield await x`. The per-.next() Promise provides the microtask
            # boundary the consumer observes. (Full interleaving inside an async generator
            # body — test262 async-generator-interleaved — needs that request queue.)
            if js_is_promise(aw_val) {
                ag_st: int = js_promise_get_state(aw_val);
                if ag_st == PROMISE_REJECTED {
                    ag_rej: JSValue = js_promise_get_value(aw_val);
                    promise_unmark_unhandled(aw_val);
                    process_queue_rejection_handled(aw_val);
                    if not self._unwind_in_frame(frame, ag_rej) {
                        self.had_exception = True;
                        self.pending_exc = ag_rej;
                        st.running = False;
                    }
                } else {
                    self._push(js_promise_get_value(aw_val));
                }
            } else {
                self._push(aw_val);
            }
        } elif ins.arg == 1 and not js_is_promise(aw_val) {
            # MODULE top-level `await <plain value>` (compiler-marked arg==1): keep the
            # historical synchronous resolution. Top-level await drives module-graph
            # evaluation (§16.2.1.5.3) whose ordering depends on the plain-value await
            # completing inline; deferring it regressed module-code/top-level-await tests.
            # An awaited PROMISE at module top level still defers below (that was correct).
            self._push(aw_val);
        } else {
            # REGULAR async function (script), or an awaited already-settled promise: an
            # ALREADY-SETTLED promise or a plain (non-thenable) value still suspends `await`
            # for exactly ONE microtask tick (ES2019 §6.2.3.1 Await → the resolved promise's
            # reaction is a job), so promise `.then` callbacks scheduled around this await
            # interleave correctly (test262 await/await-non-promise). This replaced an
            # earlier synchronous fast path that broke that ordering.
            aw_settle_state: int = PROMISE_FULFILLED;
            aw_settle_val: JSValue = aw_val;
            if js_is_promise(aw_val) {
                aw_settle_state = js_promise_get_state(aw_val);
                aw_settle_val = js_promise_get_value(aw_val);
                if aw_settle_state == PROMISE_REJECTED {
                    promise_unmark_unhandled(aw_val);
                    process_queue_rejection_handled(aw_val);
                }
            }
            self._await_suspend_settled(frame, st, aw_settle_state, aw_settle_val);
        }
    }

    def _op_yield(frame: CallFrame, ins: Instruction, st: ExecState) {
        st.ret = self._pop();
        self.yielded = True;
        st.running = False;
    }

    def _op_yield_star(frame: CallFrame, ins: Instruction, st: ExecState) {
        # yield* iterable: pop inner iterator and suspend with delegate flag
        st.ret = self._pop();
        self.yielded = True;
        self.yielded_star = True;
        st.running = False;
    }

    def _op_get_async_iter(frame: CallFrame, ins: Instruction, st: ExecState) -> None {
        # Pop iterable, look up [Symbol.asyncIterator] or [Symbol.iterator],
        # call it, and push an async iterator wrapper { __ASYNC_ITER: iter }.
        # For arrays/strings, build an internal { __I, __J } iterator as fallback.
        gai_src: JSValue = self._pop();
        gai_iter: JSValue = js_undefined();
        gai_internal: bool = False;
        # True when the iterator came from @@iterator (a SYNC iterator) and must be
        # driven via CreateAsyncFromSyncIterator: read .next/.value/.done through
        # accessor getters and AWAIT each result's value (ES §27.1.4).
        gai_from_sync: bool = False;

        # 1. Check for [Symbol.asyncIterator] — GetMethod runs the accessor getter
        # (ES §7.3.10), so a `get [Symbol.asyncIterator]()` side effect fires and a
        # getter returning undefined correctly falls through to @@iterator below.
        gai_async_key: int = SYMBOL_KEY_BASE + SYMBOL_ASYNC_ITERATOR;
        gai_async_fn: JSValue = js_undefined();
        if jsv_is_object_cell(gai_src) and not js_is_array(gai_src) {
            gai_async_fn = self._get_prop_accessor(gai_src, gai_async_key);
            if self.had_exception or vm_has_native_exc() {
                gai_ax_exc: JSValue = vm_take_native_exc()
                    if vm_has_native_exc()
                    else self.pending_exc;
                self.had_exception = False;
                self.pending_exc = js_undefined();
                if not self._unwind_in_frame(frame, gai_ax_exc) {
                    self.had_exception = True;
                    self.pending_exc = gai_ax_exc;
                    st.running = False;
                }
                return;
            }
        }
        if is_fn_val(gai_async_fn) {
            gai_cl: JSClosure = self.realm.closures[get_fn_idx(gai_async_fn)];
            gai_iter = self.run_cl(gai_cl, gai_async_fn, gai_src, []);
        } elif jsv_is_object_cell(gai_src) and js_is_async_generator(gai_src) {
            # Async generators are their own async iterators
            gai_iter = gai_src;
        } elif jsv_is_object_cell(gai_src) and js_is_array(gai_src) {
            # Array fallback: build internal {__I, __J} iterator
            gai_internal = True;
            gai_iter = js_object_create_null();
            js_object_set(gai_iter, WK_I, gai_src);
            js_object_set(gai_iter, WK_J, js_int(0));
        } elif jsv_is_string_cell(gai_src) {
            # String fallback: convert to chars array
            gai_s: str = str_from_id(jsv_to_table_id(gai_src));
            gai_chars: list[JSValue] = [];
            gai_ci2: int = 0;
            gai_sn: int = len(gai_s);
            while gai_ci2 < gai_sn {
                gai_chars.append(
                    jsv_from_string_id(
                        str_intern(str_substr(gai_s, gai_ci2, gai_ci2 + 1))
                    )
                );
                gai_ci2 = gai_ci2 + 1;
            }
            gai_internal = True;
            gai_iter = js_object_create_null();
            js_object_set(gai_iter, WK_I, js_array_create(gai_chars));
            js_object_set(gai_iter, WK_J, js_int(0));
        } else {
            # 2. Fallback to [Symbol.iterator] → CreateAsyncFromSyncIterator (ES §27.1.4.1).
            # GetMethod again runs the accessor getter.
            gai_sync_key: int = SYMBOL_KEY_BASE + SYMBOL_ITERATOR;
            gai_sync_fn: JSValue = js_undefined();
            if jsv_is_object_cell(gai_src) {
                gai_sync_fn = self._get_prop_accessor(gai_src, gai_sync_key);
                if self.had_exception or vm_has_native_exc() {
                    gai_sx_exc: JSValue = vm_take_native_exc()
                        if vm_has_native_exc()
                        else self.pending_exc;
                    self.had_exception = False;
                    self.pending_exc = js_undefined();
                    if not self._unwind_in_frame(frame, gai_sx_exc) {
                        self.had_exception = True;
                        self.pending_exc = gai_sx_exc;
                        st.running = False;
                    }
                    return;
                }
            }
            if is_fn_val(gai_sync_fn) {
                gai_cl2: JSClosure = self.realm.closures[get_fn_idx(gai_sync_fn)];
                gai_iter = self.run_cl(gai_cl2, gai_sync_fn, gai_src, []);
                gai_from_sync = True;
            } elif is_native_val(gai_sync_fn) {
                gai_iter = _vm_call_native_proxy_aware(
                    self, self.realm, get_native_kind(gai_sync_fn), gai_src, []
                );
                gai_from_sync = True;
            } elif jsv_is_object_cell(gai_src) and js_is_generator(gai_src) {
                gai_iter = gai_src;
                gai_from_sync = True;
            } else {
                exc_gai: JSValue = make_type_error("object is not async iterable");
                if not self._unwind_in_frame(frame, exc_gai) {
                    self.had_exception = True;
                    self.pending_exc = exc_gai;
                    st.running = False;
                }
                gai_iter = js_undefined();
            }
        }
        if not jsv_is_undefined(gai_iter) {
            if gai_internal {
                # Internal iterator — wrap directly (it already has __I/__J)
                gai_wrap: JSValue = js_object_create_null();
                js_object_set(gai_wrap, WK_ASYNC_ITER, gai_iter);
                js_object_set(gai_wrap, WK_INTERNAL, js_true());
                self._push(gai_wrap);
            } else {
                # External iterator
                gai_wrap2: JSValue = js_object_create_null();
                js_object_set(gai_wrap2, WK_ASYNC_ITER, gai_iter);
                if gai_from_sync {
                    # Async-from-sync: .next/.value/.done read via getters + value awaited.
                    js_object_set(gai_wrap2, WK_FROM_SYNC, js_true());
                }
                self._push(gai_wrap2);
            }
        }
    }

    def _op_async_iter_next(frame: CallFrame, ins: Instruction, st: ExecState) -> None {
        # Peek the async iterator wrapper from TOS.
        # Call .next() on the inner iterator, await if needed, push value + done_flag.
        ain_wrap: JSValue = self._peek();
        ain_iter: JSValue = js_object_get(ain_wrap, WK_ASYNC_ITER);
        ain_internal_v: JSValue = js_object_get(ain_wrap, WK_INTERNAL);
        # from-sync (@@iterator fallback) wrappers read .next/.value/.done via accessor
        # getters so a spec-instrumented sync iterator observes each access (§27.1.4.4).
        ain_from_sync: bool = jsv_to_bool(js_object_get(ain_wrap, WK_FROM_SYNC))
            if jsv_is_bool(js_object_get(ain_wrap, WK_FROM_SYNC))
            else False;

        # Check if this is an internal __I/__J array/string iterator
        if jsv_is_bool(ain_internal_v) and jsv_to_bool(ain_internal_v) {
            # Internal array/string iterator — drive __I/__J directly
            ain_arr: JSValue = js_object_get(ain_iter, WK_I);
            ain_idx_v: JSValue = js_object_get(ain_iter, WK_J);
            ain_idx: int = jsv_to_int32(ain_idx_v);
            ain_arr_len: int = js_array_len(ain_arr);
            if ain_idx < ain_arr_len {
                ain_elem: JSValue = js_array_get(ain_arr, ain_idx);
                js_object_set(ain_iter, WK_J, js_int(ain_idx + 1));
                # ECMAScript §14.7.5.9: for-await-of wraps every value in
                # Await(Promise.resolve(value)) — unwrap already-settled promises.
                if js_is_promise(ain_elem) {
                    ain_el_st: int = js_promise_get_state(ain_elem);
                    if ain_el_st == PROMISE_FULFILLED {
                        ain_elem = js_promise_get_value(ain_elem);
                    } elif ain_el_st == PROMISE_REJECTED {
                        # The Await consumes the rejection (not an unhandled rejection) and
                        # throws it into the loop. Stop here: once unwound into a catch
                        # handler, pushing the value/flag pair would leave `true` where the
                        # handler expects the exception (catch (e) saw `true`).
                        exc_ain_el: JSValue = js_promise_get_value(ain_elem);
                        promise_unmark_unhandled(ain_elem);
                        if not self._unwind_in_frame(frame, exc_ain_el) {
                            self.had_exception = True;
                            self.pending_exc = exc_ain_el;
                            st.running = False;
                        }
                        return;
                    }
                    # PENDING: push as-is (async resolution handled elsewhere)
                }
                self._push(ain_elem);
                self._push(js_true());
            } else {
                # Done
                self._push(js_false());
            }
        } else {
            # External iterator — call .next() and potentially await
            ain_result: JSValue = js_undefined();
            ain_ok: bool = True;
            if jsv_is_object_cell(ain_iter) and js_is_generator(ain_iter) {
                # Sync or async generator — use run_generator
                ain_result = self.run_generator(ain_iter, js_undefined(), False, False);
                if self.had_exception {
                    exc_ain: JSValue = self.pending_exc;
                    self.had_exception = False;
                    self.pending_exc = js_undefined();
                    self._push(js_false());
                    ain_ok = False;
                }
            } else {
                # User object with .next() method — read `.next` via getter for a
                # from-sync iterator so a `get next` accessor fires (§27.1.4.4).
                ain_next_fn: JSValue = js_undefined();
                if ain_from_sync {
                    ain_next_fn = self._get_prop_accessor(ain_iter, WK_NEXT);
                    if self.had_exception or vm_has_native_exc() {
                        ain_nx_exc: JSValue = vm_take_native_exc()
                            if vm_has_native_exc()
                            else self.pending_exc;
                        self.had_exception = False;
                        self.pending_exc = js_undefined();
                        if not self._unwind_in_frame(frame, ain_nx_exc) {
                            self.had_exception = True;
                            self.pending_exc = ain_nx_exc;
                            st.running = False;
                        }
                        return;
                    }
                } else {
                    ain_next_fn = js_object_get(ain_iter, WK_NEXT);
                }
                if is_fn_val(ain_next_fn) {
                    ain_cl: JSClosure = self.realm.closures[get_fn_idx(ain_next_fn)];
                    ain_result = self.run_cl(ain_cl, ain_next_fn, ain_iter, []);
                    if self.had_exception {
                        exc_ain2: JSValue = self.pending_exc;
                        self.had_exception = False;
                        self.pending_exc = js_undefined();
                        self._push(js_false());
                        ain_ok = False;
                    }
                } elif is_native_val(ain_next_fn) {
                    ain_nk: int = get_native_kind(ain_next_fn);
                    ain_result = _vm_call_native_proxy_aware(
                        self, self.realm, ain_nk, ain_iter, []
                    );
                } else {
                    self._push(js_false());
                    ain_ok = False;
                }
            }
            if ain_ok {
                # If result is a Promise, await it (synchronous resolve in our model)
                if js_is_promise(ain_result) {
                    ain_st: int = js_promise_get_state(ain_result);
                    if ain_st == PROMISE_FULFILLED {
                        ain_result = js_promise_get_value(ain_result);
                    } elif ain_st == PROMISE_REJECTED {
                        # ES §14.7.5.9 (ForIn/OfBodyEvaluation): a rejected next() promise is
                        # Await'ed and its rejection THROWS into the for-await-of body — it is
                        # NOT a normal "iterator done". Unwind the rejection (so an enclosing
                        # try/catch can handle it, else the async generator rejects); do not
                        # push the done sentinel (test262 yield-promise-reject-next-for-await-
                        # of-async-iterator).
                        ain_rej_v: JSValue = js_promise_get_value(ain_result);
                        promise_unmark_unhandled(ain_result);
                        process_queue_rejection_handled(ain_result);
                        if not self._unwind_in_frame(frame, ain_rej_v) {
                            self.had_exception = True;
                            self.pending_exc = ain_rej_v;
                            st.running = False;
                        }
                        ain_ok = False;
                    } else {
                        # PENDING — suspend the calling (for-await-of) frame until the
                        # async iterator .next() Promise settles.
                        ain_ag_ss: list[JSValue] = [];
                        ain_ag_si: int = frame.stack_base;
                        while ain_ag_si < len(self.stack) {
                            ain_ag_ss.append(self.stack[ain_ag_si]);
                            ain_ag_si = ain_ag_si + 1;
                        }
                        # Copy locals — frame.locals may be pool-backed and resized by a
                        # synchronous run() before this for-await-of frame resumes (see
                        # _await_suspend_settled).
                        ain_ag_locals: list[JSValue] = [];
                        ain_ag_lj: int = 0;
                        ain_ag_nl: int = self._frame_nl(frame);
                        while ain_ag_lj < ain_ag_nl {
                            ain_ag_locals.append(frame.locals[frame.lb + (ain_ag_lj)]);
                            ain_ag_lj = ain_ag_lj + 1;
                        }
                        # Copy catch_stack too (not just locals): the suspended frame's CallFrame
                        # object goes back to the frame pool and _frame_acquire empties its
                        # catch_stack IN PLACE on reuse, so an aliased list lost the enclosing
                        # try/catch — a promise rejected AFTER a top-level `await` suspended
                        # then found no handler on resume and the module hung forever.
                        ain_ag_cs: list[int] = [];
                        ain_ag_ci: int = 0;
                        while ain_ag_ci < len(frame.catch_stack) {
                            ain_ag_cs.append(frame.catch_stack[ain_ag_ci]);
                            ain_ag_ci = ain_ag_ci + 1;
                        }
                        ain_ag_state: JSGeneratorState = JSGeneratorState(
                            func=frame.func,
                            locals=ain_ag_locals,
                            free_vals=frame.free_vals,
                            this_val=frame.this_val,
                            catch_stack=ain_ag_cs,
                            send_val=js_undefined(),
                            saved_stack=ain_ag_ss,
                            delegate_gen=js_undefined(),
                            saved_ip=frame.ip,
                            saved_rpc=frame.rpc,
                            done=False,
                            throw_mode=False,
                            ret_mode=False,
                            stack_base=frame.stack_base,
                            async_promise=self._cur_async_promise,
                            module_fns=self.module_fns
                        );
                        self.realm.generators.append(ain_ag_state);
                        gc_note_alloc(self.realm);  # G0.4: account generator allocation
                        ain_ag_idx: int = len(self.realm.generators) - 1;
                        ain_ag_rsm: JSValue = js_object_create_null();
                        js_object_set(ain_ag_rsm, _KEY_IS_ASYNC_ITER_RESUME, js_true());
                        js_object_set(
                            ain_ag_rsm, _KEY_ASYNC_RESUME_IDX, js_int(ain_ag_idx)
                        );
                        ain_ag_rjt: JSValue = js_object_create_null();
                        js_object_set(ain_ag_rjt, _KEY_IS_ASYNC_ITER_REJECT, js_true());
                        js_object_set(
                            ain_ag_rjt, _KEY_ASYNC_RESUME_IDX, js_int(ain_ag_idx)
                        );
                        js_promise_add_reaction(
                            ain_result, ain_ag_rsm, ain_ag_rjt, js_undefined()
                        );
                        self.vm_awaiting = True;
                        st.running = False;
                        ain_ok = False;
                    }
                }
            }
            if ain_ok {
                # ain_result should be {value, done}. IteratorComplete/IteratorValue read
                # .done/.value via getters for a from-sync iterator (spec-instrumented).
                ain_done_v: JSValue = js_undefined();
                if ain_from_sync {
                    ain_done_v = self._get_prop_accessor(ain_result, WK_DONE);
                } else {
                    ain_done_v = js_object_get(ain_result, WK_DONE);
                }
                if self.had_exception or vm_has_native_exc() {
                    ain_dn_exc: JSValue = vm_take_native_exc()
                        if vm_has_native_exc()
                        else self.pending_exc;
                    self.had_exception = False;
                    self.pending_exc = js_undefined();
                    if not self._unwind_in_frame(frame, ain_dn_exc) {
                        self.had_exception = True;
                        self.pending_exc = ain_dn_exc;
                        st.running = False;
                    }
                    return;
                }
                if jsv_coerce_to_bool(ain_done_v) {
                    self._push(js_false());
                } else {
                    ain_val: JSValue = js_undefined();
                    if ain_from_sync {
                        ain_val = self._get_prop_accessor(ain_result, WK_VALUE);
                    } else {
                        ain_val = js_object_get(ain_result, WK_VALUE);
                    }
                    if self.had_exception or vm_has_native_exc() {
                        ain_vl_exc: JSValue = vm_take_native_exc()
                            if vm_has_native_exc()
                            else self.pending_exc;
                        self.had_exception = False;
                        self.pending_exc = js_undefined();
                        if not self._unwind_in_frame(frame, ain_vl_exc) {
                            self.had_exception = True;
                            self.pending_exc = ain_vl_exc;
                            st.running = False;
                        }
                        return;
                    }
                    self._push(ain_val);
                    self._push(js_true());
                }
            }
        }
    }

    def _op_throw(frame: CallFrame, ins: Instruction, st: ExecState) {
        exc_th: JSValue = self._pop();
        if not self._unwind_in_frame(frame, exc_th) {
            self.had_exception = True;
            self.pending_exc = exc_th;
            st.running = False;
        }
    }

    def _op_push_catch(frame: CallFrame, ins: Instruction, st: ExecState) {
        frame.catch_stack.append(ins.arg);
        frame.rare = True;
        frame.catch_with_depths.append(len(frame.with_objs));  # A4: restore with-chain on unwind
        frame.rare = True;
        frame.catch_dispose_depths.append(len(frame.dispose_stack));  # dispose resources opened in the try
        frame.rare = True;
    }

    def _op_pop_catch(frame: CallFrame, ins: Instruction, st: ExecState) {
        nc_pc: int = len(frame.catch_stack);
        if nc_pc > 0 {
            del frame.catch_stack[nc_pc - 1];
        }
        ncw_pc: int = len(frame.catch_with_depths);
        if ncw_pc > 0 {
            del frame.catch_with_depths[ncw_pc - 1];
        }
        ncd_pc: int = len(frame.catch_dispose_depths);
        if ncd_pc > 0 {
            del frame.catch_dispose_depths[ncd_pc - 1];
        }
    }

    def _op_push_finally(frame: CallFrame, ins: Instruction, st: ExecState) {
        frame.catch_stack.append(ins.arg);  # stub: treat as catch
        frame.rare = True;
        frame.catch_with_depths.append(len(frame.with_objs));  # A4
        frame.rare = True;
        frame.catch_dispose_depths.append(len(frame.dispose_stack));
        frame.rare = True;
    }

    def _op_pop_finally(frame: CallFrame, ins: Instruction, st: ExecState) {
        nc_pf: int = len(frame.catch_stack);
        if nc_pf > 0 {
            del frame.catch_stack[nc_pf - 1];
        }
        ncw_pf: int = len(frame.catch_with_depths);
        if ncw_pf > 0 {
            del frame.catch_with_depths[ncw_pf - 1];
        }
        ncd_pf: int = len(frame.catch_dispose_depths);
        if ncd_pf > 0 {
            del frame.catch_dispose_depths[ncd_pf - 1];
        }
    }

    def _op_spread(frame: CallFrame, ins: Instruction, st: ExecState) {
        sp_src: JSValue = self._pop();
        sp_arr: JSValue = js_undefined();
        sp_push: bool = True;
        if js_is_generator(sp_src) {
            # Drain the generator into an array
            gen_sp_items: list[JSValue] = [];
            gen_sp_done: bool = False;
            while not gen_sp_done {
                gen_sp_res: JSValue = self.run_generator(
                    sp_src, js_undefined(), False, False
                );
                if self.had_exception {
                    gen_sp_done = True;
                } else {
                    gen_sp_done_v: JSValue = js_object_get(gen_sp_res, WK_DONE);
                    gen_sp_done = jsv_to_bool(gen_sp_done_v);
                    if not gen_sp_done {
                        gen_sp_items.append(js_object_get(gen_sp_res, WK_VALUE));
                    }
                }
            }
            if self.had_exception {
                sp_push = False;
                gen_sp_exc: JSValue = self.pending_exc;
                self.had_exception = False;
                self.pending_exc = js_undefined();
                if not self._unwind_in_frame(frame, gen_sp_exc) {
                    self.had_exception = True;
                    self.pending_exc = gen_sp_exc;
                    st.running = False;
                }
            } else {
                sp_arr = js_array_create(gen_sp_items);
            }
        } elif jsv_is_object_cell(sp_src) {
            # Check for custom Symbol.iterator before falling back to _collect_iterable.
            # GetMethod is accessor-aware: a throwing `Symbol.iterator` getter must
            # propagate (ES §7.4.1 GetIterator), not be swallowed into a plain read.
            sp_sym_key: int = SYMBOL_KEY_BASE + SYMBOL_ITERATOR;
            sp_sym_fn: JSValue = self._get_prop_accessor(sp_src, sp_sym_key);
            if vm_has_native_exc() {
                self.had_exception = True;
                self.pending_exc = vm_take_native_exc();
            }
            if self.had_exception {
                sp_push = False;
                sp_gm_exc: JSValue = self.pending_exc;
                self.had_exception = False;
                self.pending_exc = js_undefined();
                if not self._unwind_in_frame(frame, sp_gm_exc) {
                    self.had_exception = True;
                    self.pending_exc = sp_gm_exc;
                    st.running = False;
                }
            } elif is_fn_val(sp_sym_fn) {
                # Call obj[Symbol.iterator]() to get the iterator, then drain it.
                # Use _invoke_callable_value (same as GET_ITER, NOT run_cl): a
                # GENERATOR @@iterator must return a fresh generator OBJECT without
                # executing its body — run_cl runs the body directly and returns a
                # non-object, so `[...obj]` threw "Result of the Symbol.iterator
                # method is not an object" / yielded an empty spread.
                sp_user_iter: JSValue = self._invoke_callable_value(
                    sp_sym_fn, sp_src, []
                );
                sp_items: list[JSValue] = [];
                sp_done: bool = False;
                # If the [Symbol.iterator]() call itself threw, propagate immediately —
                # otherwise the drain loop below would spin forever on an undefined iter.
                if self.had_exception {
                    sp_done = True;
                } elif not (
                    jsv_is_object_cell(sp_user_iter)
                    and jsv_to_table_id(sp_user_iter) > 0
                ) {
                    # GetIterator (ES §7.4.1): the value returned by [Symbol.iterator]()
                    # must be an Object — a null/primitive iterator throws TypeError
                    # (without this, the drain loop reads next off a non-object and
                    # silently yields an empty spread, or spins).
                    self.had_exception = True;
                    self.pending_exc = make_type_error(
                        "Result of the Symbol.iterator method is not an object"
                    );
                    sp_done = True;
                } elif js_is_generator(sp_user_iter) {
                    # A generator iterator needs VM-reentry resumption — the plain
                    # `.next()` drain below observes zero iterations. Drain via
                    # run_generator (same as the direct-generator spread branch).
                    sp_gudone: bool = False;
                    while not sp_gudone {
                        sp_gures: JSValue = self.run_generator(
                            sp_user_iter, js_undefined(), False, False
                        );
                        if self.had_exception {
                            sp_gudone = True;
                        } else {
                            sp_gudone = jsv_to_bool(js_object_get(sp_gures, WK_DONE));
                            if not sp_gudone {
                                sp_items.append(js_object_get(sp_gures, WK_VALUE));
                            }
                        }
                    }
                    sp_done = True;
                }
                while not sp_done {
                    sp_next_fn: JSValue = js_object_get(sp_user_iter, WK_NEXT);
                    if is_fn_val(sp_next_fn) {
                        sp_next_cl: JSClosure = self.realm.closures[
                            get_fn_idx(sp_next_fn)
                        ];
                        sp_next_res: JSValue = self.run_cl(
                            sp_next_cl, sp_next_fn, sp_user_iter, []
                        );
                        # A throw from next() must abort the drain (ReturnIfAbrupt);
                        # without this guard sp_next_res is undefined, sp_done stays
                        # false, and the loop allocates undefined forever (OOM/hang).
                        if self.had_exception {
                            sp_done = True;
                        } else {
                            sp_done_v: JSValue = js_object_get(sp_next_res, WK_DONE);
                            sp_done = jsv_to_bool(sp_done_v);
                            if not sp_done {
                                # Read `value` accessor-aware (ES §7.4.6 IteratorValue):
                                # a throwing `value` getter must abort the drain, else
                                # js_object_get swallows it and the loop spins forever.
                                # _get_prop_accessor routes a throwing getter onto the
                                # NATIVE exception channel — fold it back into
                                # had_exception/pending_exc so the unwind below sees it.
                                sp_val_v: JSValue = self._get_prop_accessor(
                                    sp_next_res, WK_VALUE
                                );
                                if vm_has_native_exc() {
                                    self.had_exception = True;
                                    self.pending_exc = vm_take_native_exc();
                                }
                                if self.had_exception {
                                    sp_done = True;
                                } else {
                                    sp_items.append(sp_val_v);
                                }
                            }
                        }
                    } else {
                        sp_done = True;
                    }
                }
                if self.had_exception {
                    # Unwind the pending exception in the current frame instead of
                    # pushing a (partial) spread array.  Clear had_exception/pending_exc
                    # before unwinding (mirrors the call-native unwind pattern) so the
                    # outer dispatch loop sees the handler jump, not a stale exception.
                    sp_push = False;
                    sp_exc: JSValue = self.pending_exc;
                    self.had_exception = False;
                    self.pending_exc = js_undefined();
                    if not self._unwind_in_frame(frame, sp_exc) {
                        self.had_exception = True;
                        self.pending_exc = sp_exc;
                        st.running = False;
                    }
                } else {
                    sp_arr = js_array_create(sp_items);
                }
            } elif is_native_val(sp_sym_fn) {
                # Native @@iterator (Map/Set/Array Iterator return-this, etc.).
                sp_nat_iter: JSValue = _vm_call_native_proxy_aware(
                    self, self.realm, get_native_kind(sp_sym_fn), sp_src, []
                );
                if vm_has_native_exc() {
                    self.had_exception = True;
                    self.pending_exc = vm_take_native_exc();
                }
                if self.had_exception {
                    sp_push = False;
                    sp_ne_exc: JSValue = self.pending_exc;
                    self.had_exception = False;
                    self.pending_exc = js_undefined();
                    if not self._unwind_in_frame(frame, sp_ne_exc) {
                        self.had_exception = True;
                        self.pending_exc = sp_ne_exc;
                        st.running = False;
                    }
                } else {
                    # Prefer dedicated Map/Set iterator / collection drains.
                    sp_arr = _collect_iterable(sp_nat_iter);
                    # If _collect_iterable could not recognize the iterator, try draining
                    # via .next (native or JS) so TypedArray/custom natives still work.
                    if js_array_len(sp_arr) == 0 and jsv_is_object_cell(sp_nat_iter) {
                        sp_nitems: list[JSValue] = [];
                        sp_ndone: bool = False;
                        while not sp_ndone {
                            sp_nn: JSValue = js_object_get(sp_nat_iter, WK_NEXT);
                            sp_nres: JSValue = js_undefined();
                            if is_native_val(sp_nn) {
                                sp_nres = _vm_call_native_proxy_aware(
                                    self,
                                    self.realm,
                                    get_native_kind(sp_nn),
                                    sp_nat_iter,
                                    []
                                );
                                if vm_has_native_exc() {
                                    self.had_exception = True;
                                    self.pending_exc = vm_take_native_exc();
                                }
                            } elif is_fn_val(sp_nn) {
                                sp_ncl: JSClosure = self.realm.closures[
                                    get_fn_idx(sp_nn)
                                ];
                                sp_nres = self.run_cl(sp_ncl, sp_nn, sp_nat_iter, []);
                            } else {
                                sp_ndone = True;
                            }
                            if self.had_exception {
                                sp_ndone = True;
                            } elif not sp_ndone {
                                if jsv_to_bool(js_object_get(sp_nres, WK_DONE)) {
                                    sp_ndone = True;
                                } else {
                                    sp_nitems.append(js_object_get(sp_nres, WK_VALUE));
                                }
                            }
                        }
                        if self.had_exception {
                            sp_push = False;
                            sp_nx: JSValue = self.pending_exc;
                            self.had_exception = False;
                            self.pending_exc = js_undefined();
                            if not self._unwind_in_frame(frame, sp_nx) {
                                self.had_exception = True;
                                self.pending_exc = sp_nx;
                                st.running = False;
                            }
                        } else {
                            sp_arr = js_array_create(sp_nitems);
                        }
                    }
                }
            } else {
                # @@iterator is null / undefined / a non-callable value. Objects carrying a
                # built-in DEFAULT iterator (array/set/map + their iterators, `arguments`, and
                # internal {__I} iterators) legitimately reach here — arrays are created
                # null-proto for perf so their `@@iterator` isn't reachable via GetMethod —
                # so drain them via _collect_iterable. Anything ELSE is genuinely not iterable:
                # a null/undefined/non-callable @@iterator is a TypeError (ES §7.4.1
                # GetIterator → GetMethod), e.g. `[0, ...{[Symbol.iterator]:null}]`, `[...{}]`.
                sp_rec: bool = jsv_is_object_cell(js_object_get(sp_src, WK_I))
                    or js_is_array(sp_src)
                    or js_is_set(sp_src)
                    or js_is_map(sp_src)
                    or js_is_map_iterator(sp_src)
                    or js_is_set_iterator(sp_src)
                    or js_object_has_own(sp_src, _KEY_IS_ARGUMENTS);
                if sp_rec {
                    sp_arr = _collect_iterable(sp_src);
                } else {
                    sp_push = False;
                    sp_ni_exc: JSValue = make_type_error("object is not iterable");
                    if not self._unwind_in_frame(frame, sp_ni_exc) {
                        self.had_exception = True;
                        self.pending_exc = sp_ni_exc;
                        st.running = False;
                    }
                }
            }
        } elif jsv_is_string_cell(sp_src) {
            # Strings are iterable (by code point).
            sp_arr = _collect_iterable(sp_src);
        } elif jsv_is_null(sp_src) or jsv_is_undefined(sp_src) {
            sp_push = False;
            sp_tn: str = "null";
            if jsv_is_undefined(sp_src) {
                sp_tn = "undefined";
            }
            sp_ne_exc: JSValue = make_type_error(sp_tn + " is not iterable");
            if not self._unwind_in_frame(frame, sp_ne_exc) {
                self.had_exception = True;
                self.pending_exc = sp_ne_exc;
                st.running = False;
            }
        } else {
            # A non-object primitive that is not a string (number / boolean / symbol
            # / bigint) is not iterable — spreading it (`[...5]`, `f(...true)`) is a
            # TypeError (ES §7.4.1 GetIterator: no @@iterator on the boxed primitive).
            sp_push = False;
            sp_prim_exc: JSValue = make_type_error("value is not iterable");
            if not self._unwind_in_frame(frame, sp_prim_exc) {
                self.had_exception = True;
                self.pending_exc = sp_prim_exc;
                st.running = False;
            }
        }
        if sp_push {
            js_object_set(sp_arr, _KEY_IS_SPREAD, js_true());
            self._push(sp_arr);
        }
    }

    def _op_iter_next_val(frame: CallFrame, ins: Instruction, st: ExecState) -> None {
        inv_iter: JSValue = self._peek();
        # ── Standard array iterator, by shape (as in _op_iter_next) ──
        # The standard iterator's shape holds exactly {__I, __J}: no generator
        # or custom iterator to probe. An exhausted one takes the standard
        # path below (it records __ITERDONE).
        if _ITER_STD_SHAPE > 0 and js_object_ic_shape(inv_iter) == _ITER_STD_SHAPE {
            fv_id: int = jsv_to_table_id(inv_iter);
            fv_j: JSValue = js_object_slot_at_id(fv_id, _ITER_STD_J);
            if jsv_is_int32(fv_j)
                and jsv_to_int32(fv_j)
                    < js_array_len(js_object_slot_at_id(fv_id, _ITER_STD_I)) {
                fv_val: JSValue = js_array_get(
                    js_object_slot_at_id(fv_id, _ITER_STD_I), jsv_to_int32(fv_j)
                );
                js_object_slot_set_at_id(
                    fv_id, _ITER_STD_J, js_int(jsv_to_int32(fv_j) + 1)
                );
                self._push(fv_val);
                return;
            }
        }
        # ── Generator iterator ─────────────────────────────────────
        inv_gen: JSValue = js_object_get(inv_iter, WK_GEN);
        if jsv_is_object_cell(inv_gen) and js_is_generator(inv_gen) {
            inv_gen_res: JSValue = self.run_generator(
                inv_gen, js_undefined(), False, False
            );
            # B11: a throw from the generator's next() must propagate to the caller,
            # not be swallowed and substituted with `undefined`.
            if self.had_exception {
                # §7.4.8: a throwing next() leaves the iterator [[done]] — do not
                # IteratorClose it afterwards.
                js_object_set(inv_iter, WK_ITERDONE, js_true());
                inv_gexc: JSValue = self.pending_exc;
                self.had_exception = False;
                self.pending_exc = js_undefined();
                if not self._unwind_in_frame(frame, inv_gexc) {
                    self.had_exception = True;
                    self.pending_exc = inv_gexc;
                    st.running = False;
                }
            } else {
                inv_gen_done_v: JSValue = js_object_get(inv_gen_res, WK_DONE);
                if jsv_to_bool(inv_gen_done_v) {
                    js_object_set(inv_iter, WK_ITERDONE, js_true());
                    self._push(js_undefined());
                } else {
                    self._push(js_object_get(inv_gen_res, WK_VALUE));
                }
            }
        } else {
            # ── Custom user iterator ───────────────────────────────────
            # R15: handle both JS and native .next (Array Iterator uses native next).
            inv_custom: JSValue = js_object_get(inv_iter, WK_CUSTOM);
            if jsv_is_object_cell(inv_custom) {
                inv_next_fn: JSValue = js_object_get(inv_custom, WK_NEXT);
                inv_cust_res: JSValue = js_undefined();
                inv_got_next: bool = False;
                if is_fn_val(inv_next_fn) {
                    inv_next_cl: JSClosure = self.realm.closures[
                        get_fn_idx(inv_next_fn)
                    ];
                    inv_cust_res = self.run(
                        inv_next_cl.func,
                        inv_custom,
                        [],
                        inv_next_cl.free_vals,
                        inv_next_fn
                    );
                    inv_got_next = True;
                } elif is_native_val(inv_next_fn) {
                    inv_cust_res = _vm_call_native_proxy_aware(
                        self, self.realm, get_native_kind(inv_next_fn), inv_custom, []
                    );
                    if vm_has_native_exc() {
                        self.had_exception = True;
                        self.pending_exc = vm_take_native_exc();
                    }
                    inv_got_next = True;
                }
                if inv_got_next {
                    # B11: ReturnIfAbrupt after IteratorNext — a throwing next() must
                    # propagate, not be swallowed.
                    if self.had_exception {
                        js_object_set(inv_iter, WK_ITERDONE, js_true());
                        inv_exc1: JSValue = self.pending_exc;
                        self.had_exception = False;
                        self.pending_exc = js_undefined();
                        if not self._unwind_in_frame(frame, inv_exc1) {
                            self.had_exception = True;
                            self.pending_exc = inv_exc1;
                            st.running = False;
                        }
                    } else {
                        # .done / .value are read with getter support (IteratorComplete /
                        # IteratorValue); a throwing `value`/`done` getter must propagate
                        # (B11). _get_prop_accessor routes a throwing getter onto the
                        # NATIVE exception channel — fold it back into had_exception.
                        inv_cust_done: JSValue = self._get_prop_accessor(
                            inv_cust_res, WK_DONE
                        );
                        if vm_has_native_exc() {
                            self.had_exception = True;
                            self.pending_exc = vm_take_native_exc();
                        }
                        if self.had_exception {
                            js_object_set(inv_iter, WK_ITERDONE, js_true());
                            inv_exc2: JSValue = self.pending_exc;
                            self.had_exception = False;
                            self.pending_exc = js_undefined();
                            if not self._unwind_in_frame(frame, inv_exc2) {
                                self.had_exception = True;
                                self.pending_exc = inv_exc2;
                                st.running = False;
                            }
                        } elif jsv_coerce_to_bool(inv_cust_done) {
                            js_object_set(inv_iter, WK_ITERDONE, js_true());
                            self._push(js_undefined());
                        } else {
                            inv_cust_val: JSValue = self._get_prop_accessor(
                                inv_cust_res, WK_VALUE
                            );
                            if vm_has_native_exc() {
                                self.had_exception = True;
                                self.pending_exc = vm_take_native_exc();
                            }
                            if self.had_exception {
                                js_object_set(inv_iter, WK_ITERDONE, js_true());
                                inv_exc3: JSValue = self.pending_exc;
                                self.had_exception = False;
                                self.pending_exc = js_undefined();
                                if not self._unwind_in_frame(frame, inv_exc3) {
                                    self.had_exception = True;
                                    self.pending_exc = inv_exc3;
                                    st.running = False;
                                }
                            } else {
                                self._push(inv_cust_val);
                            }
                        }
                    }
                } else {
                    self._push(js_undefined());
                }
            } else {
                # ── Standard array-backed iterator {__I, __J} ─────────────
                inv_src: JSValue = js_object_get(inv_iter, WK_I);
                inv_idx_v: JSValue = js_object_get(inv_iter, WK_J);
                inv_idx: int = 0;
                if jsv_is_int32(inv_idx_v) {
                    inv_idx = jsv_to_int32(inv_idx_v);
                } elif jsv_is_double(inv_idx_v) {
                    inv_idx = int(jsv_to_double(inv_idx_v));
                }
                inv_len: int = js_array_len(inv_src);
                if inv_idx < inv_len {
                    inv_val: JSValue = js_array_get(inv_src, inv_idx);
                    js_object_set(inv_iter, WK_J, js_int(inv_idx + 1));
                    self._push(inv_val);
                } else {
                    js_object_set(inv_iter, WK_ITERDONE, js_true());
                    self._push(js_undefined());
                }
            }  # end else (non-custom)
        }  # end else (non-generator)
    }

    def _op_rest_args(frame: CallFrame, ins: Instruction, st: ExecState) {
        ra_iter: JSValue = self._peek();
        # ── Generator iterator ─────────────────────────────────────
        ra_gen: JSValue = js_object_get(ra_iter, WK_GEN);
        if jsv_is_object_cell(ra_gen) and js_is_generator(ra_gen) {
            ra_gen_items: list[JSValue] = [];
            ra_gen_abrupt: bool = False;
            ra_gen_exc: JSValue = js_undefined();
            for _rgi in range(100000) {
                ra_gen_res: JSValue = self.run_generator(
                    ra_gen, js_undefined(), False, False
                );
                # B11: a throw from the generator during rest-collection must propagate,
                # not be swallowed (leaving a truncated rest array).
                if self.had_exception {
                    ra_gen_exc = self.pending_exc;
                    ra_gen_abrupt = True;
                    self.had_exception = False;
                    self.pending_exc = js_undefined();
                    break;
                }
                ra_gen_done_v: JSValue = js_object_get(ra_gen_res, WK_DONE);
                if jsv_to_bool(ra_gen_done_v) {
                    break;
                }
                ra_gen_items.append(js_object_get(ra_gen_res, WK_VALUE));
            }
            if ra_gen_abrupt {
                # §7.4.8: an abrupt next()/getter leaves the iterator [[done]].
                js_object_set(ra_iter, WK_ITERDONE, js_true());
                if not self._unwind_in_frame(frame, ra_gen_exc) {
                    self.had_exception = True;
                    self.pending_exc = ra_gen_exc;
                    st.running = False;
                }
            } else {
                # Rest collection consumed the iterator to completion.
                js_object_set(ra_iter, WK_ITERDONE, js_true());
                self._push(js_array_create(ra_gen_items));
            }
        } else {
            # ── Custom user iterator ───────────────────────────────────
            ra_custom: JSValue = js_object_get(ra_iter, WK_CUSTOM);
            if jsv_is_object_cell(ra_custom) {
                ra_cust_items: list[JSValue] = [];
                ra_next_fn: JSValue = js_object_get(ra_custom, WK_NEXT);
                ra_cust_abrupt: bool = False;
                ra_cust_exc: JSValue = js_undefined();
                if is_fn_val(ra_next_fn) {
                    for _rci in range(100000) {
                        ra_next_cl: JSClosure = self.realm.closures[
                            get_fn_idx(ra_next_fn)
                        ];
                        ra_cust_res: JSValue = self.run(
                            ra_next_cl.func,
                            ra_custom,
                            [],
                            ra_next_cl.free_vals,
                            ra_next_fn
                        );
                        # B11: ReturnIfAbrupt after next() / .done / .value (getter-aware).
                        if self.had_exception {
                            ra_cust_exc = self.pending_exc;
                            ra_cust_abrupt = True;
                            self.had_exception = False;
                            self.pending_exc = js_undefined();
                            break;
                        }
                        # _get_prop_accessor routes a throwing done/value getter onto the
                        # NATIVE exception channel — fold it back into had_exception so the
                        # abrupt-completion break fires (else the loop spins to 100000/OOM).
                        ra_cust_done: JSValue = self._get_prop_accessor(
                            ra_cust_res, WK_DONE
                        );
                        if vm_has_native_exc() {
                            self.had_exception = True;
                            self.pending_exc = vm_take_native_exc();
                        }
                        if self.had_exception {
                            ra_cust_exc = self.pending_exc;
                            ra_cust_abrupt = True;
                            self.had_exception = False;
                            self.pending_exc = js_undefined();
                            break;
                        }
                        if jsv_coerce_to_bool(ra_cust_done) {
                            break;
                        }
                        ra_cust_v: JSValue = self._get_prop_accessor(
                            ra_cust_res, WK_VALUE
                        );
                        if vm_has_native_exc() {
                            self.had_exception = True;
                            self.pending_exc = vm_take_native_exc();
                        }
                        if self.had_exception {
                            ra_cust_exc = self.pending_exc;
                            ra_cust_abrupt = True;
                            self.had_exception = False;
                            self.pending_exc = js_undefined();
                            break;
                        }
                        ra_cust_items.append(ra_cust_v);
                    }
                }
                if ra_cust_abrupt {
                    # §7.4.8: an abrupt next()/getter leaves the iterator [[done]].
                    js_object_set(ra_iter, WK_ITERDONE, js_true());
                    if not self._unwind_in_frame(frame, ra_cust_exc) {
                        self.had_exception = True;
                        self.pending_exc = ra_cust_exc;
                        st.running = False;
                    }
                } else {
                    # Rest collection consumed the iterator to completion.
                    js_object_set(ra_iter, WK_ITERDONE, js_true());
                    self._push(js_array_create(ra_cust_items));
                }
            } else {
                # ── Standard array-backed iterator {__I, __J} ─────────────
                ra_src: JSValue = js_object_get(ra_iter, WK_I);
                ra_idx_v: JSValue = js_object_get(ra_iter, WK_J);
                ra_idx: int = 0;
                if jsv_is_int32(ra_idx_v) {
                    ra_idx = jsv_to_int32(ra_idx_v);
                } elif jsv_is_double(ra_idx_v) {
                    ra_idx = int(jsv_to_double(ra_idx_v));
                }
                ra_len: int = js_array_len(ra_src);
                ra_items: list[JSValue] = [];
                while ra_idx < ra_len {
                    ra_items.append(js_array_get(ra_src, ra_idx));
                    ra_idx = ra_idx + 1;
                }
                js_object_set(ra_iter, WK_J, js_int(ra_len));
                js_object_set(ra_iter, WK_ITERDONE, js_true());
                self._push(js_array_create(ra_items));
            }  # end else (non-custom)
        }  # end else (non-generator)
    }

    def _op_object_spread(frame: CallFrame, ins: Instruction, st: ExecState) -> None {
        os_src: JSValue = self._pop();
        os_dst: JSValue = self._peek();
        # CopyDataProperties over a String primitive: ToObject wraps it, whose own
        # enumerable properties are the index chars "0".."len-1" (ES §14.3.3.1 →
        # §7.3.25 → §10.4.3).  null/undefined are excluded (no-op); other primitives
        # (number/boolean/symbol) box to wrappers with no own enumerable props.
        if jsv_is_string_cell(os_src) {
            os_s: str = str_from_id(jsv_to_table_id(os_src));
            os_slen: int = js_string_utf16_len(os_s);
            os_si: int = 0;
            while os_si < os_slen {
                os_ch: str = str_char_at(os_s, os_si);
                os_ckey: int = str_intern_index(os_si);
                _vm_object_set_vop(
                    self, os_dst, os_ckey, jsv_from_string_id(str_intern(os_ch)), os_dst
                );
                os_si = os_si + 1;
            }
            return;
        }
        # A plain source (V4.23): its plan's slots copied with CreateDataProperty
        # (CopyDataProperties, §7.3.25) — no accessor, Proxy or exotic key order
        # can observe the difference.
        if jsv_is_object_cell(os_src) and jsv_to_table_id(os_src) > 0 {
            os_plan: list[int] = js_object_spread_plan(os_src);
            if len(os_plan) == 0 or os_plan[0] >= 0 {
                os_ex: list[int] = _OS_EXCL_NONE;
                if ins.arg2 > 0 {
                    os_ex = _vm_spread_excluded(frame.func.constants.get(ins.arg2 - 1));
                }
                os_sid: int = jsv_to_table_id(os_src);
                os_pi: int = 0;
                while os_pi < len(os_plan) {
                    if os_plan[os_pi] != _KEY_IS_ARRAY
                        and os_plan[os_pi] != _KEY_IS_SPREAD
                        and not (os_plan[os_pi] in os_ex) {
                        _ = js_object_create_data_property_or_throw(
                            os_dst,
                            os_plan[os_pi],
                            js_object_slot_at_id(os_sid, os_plan[os_pi + 1])
                        );
                        if vm_has_native_exc() {
                            os_fx: JSValue = vm_take_native_exc();
                            if not self._unwind_in_frame(
                                self.frames[len(self.frames) - 1], os_fx
                            ) {
                                self.had_exception = True;
                                self.pending_exc = os_fx;
                                st.running = False;
                            }
                            return;
                        }
                    }
                    os_pi = os_pi + 2;
                }
                return;
            }
        }
        # Functions are sources too: their own props live in fn_props / the native
        # props store, not in an object cell. postcss hands every plugin
        # `{ ...postcss, result }` where postcss is a function carrying rule/decl/…,
        # so without this CSS modules failed with "rule is not a function".
        if (jsv_is_object_cell(os_src) and jsv_to_table_id(os_src) > 0)
            or is_fn_val(os_src)
            or is_native_val(os_src) {
            # ES §14.3.3.1 / §7.3.25 CopyDataProperties iterates [[OwnPropertyKeys]] —
            # STRING *and* SYMBOL keys (not the string-only EnumerableOwnPropertyNames
            # used by Object.keys). Use the full ordered key list and filter each by its
            # own enumerability, so `{ ...obj }` copies enumerable symbol-keyed props and
            # a Proxy source sees its getOwnPropertyDescriptor trap fire for every key
            # (object-spread-proxy-*, object-rest-proxy-*).
            os_keys: list[int] = _vm_all_own_key_ids_ordered(self, os_src);
            if vm_has_native_exc() {
                os_okx: JSValue = vm_take_native_exc();
                if not self._unwind_in_frame(
                    self.frames[len(self.frames) - 1], os_okx
                ) {
                    self.had_exception = True;
                    self.pending_exc = os_okx;
                    st.running = False;
                }
                return;
            }
            # CopyDataProperties(excludedItems) — object-rest destructuring passes
            # arg2 = 1 + constant index of "\x1f"-joined excluded names.  Excluded
            # keys are FILTERED from the walk (never read), so a getter for an
            # already-destructured key does not fire a second time (ES §14.3.3.1).
            os_excl: dict[int, bool] = {};
            if ins.arg2 > 0 {
                os_excl_s: str = frame.func.constants.get(ins.arg2 - 1);
                os_ep_start: int = 0;
                os_ep_i: int = 0;
                os_ep_n: int = len(os_excl_s);
                while os_ep_i <= os_ep_n {
                    if os_ep_i == os_ep_n or os_excl_s[os_ep_i] == "\x1f" {
                        os_excl[str_intern(os_excl_s[os_ep_start:os_ep_i])] = True;
                        os_ep_start = os_ep_i + 1;
                    }
                    os_ep_i = os_ep_i + 1;
                }
            }
            oi: int = 0;
            while oi < len(os_keys) {
                ok: int = os_keys[oi];
                if ok in os_excl {
                    oi = oi + 1;
                    continue;
                }
                if ok != _KEY_IS_ARRAY and ok != _KEY_IS_SPREAD {
                    # Skip non-enumerable own props (checked per-key via [[GetOwnProperty]],
                    # so a Proxy's GOPD trap fires for each key in ownKeys order).
                    if not _vm_own_key_is_enumerable_now(self, os_src, ok) {
                        if vm_has_native_exc() {
                            os_enx: JSValue = vm_take_native_exc();
                            if not self._unwind_in_frame(
                                self.frames[len(self.frames) - 1], os_enx
                            ) {
                                self.had_exception = True;
                                self.pending_exc = os_enx;
                                st.running = False;
                            }
                            break;
                        }
                        oi = oi + 1;
                        continue;
                    }
                    # Propagating getter: a throwing accessor aborts the copy and
                    # unwinds (rather than being swallowed + reported by vm_call_js_fn).
                    ov: JSValue = _vm_object_get_vop_prop(self, os_src, ok, os_dst);
                    if self.had_exception or vm_has_native_exc() {
                        # A getter threw. run_cl set had_exception/pending_exc; try to
                        # unwind within the current frame so an enclosing try/catch (or
                        # the assignment's IteratorClose) sees it.
                        if self.had_exception {
                            os_exc: JSValue = self.pending_exc;
                            self.had_exception = False;
                            self.pending_exc = js_undefined();
                            if not self._unwind_in_frame(
                                self.frames[len(self.frames) - 1], os_exc
                            ) {
                                # No handler in this frame — the exception must propagate
                                # out of _exec so it unwinds across frames (ES §14.3.3.1:
                                # a throwing source getter aborts the destructuring and
                                # the surrounding for-of body must NOT run). Stop the loop.
                                self.had_exception = True;
                                self.pending_exc = os_exc;
                                st.running = False;
                            }
                        } else {
                            # Native-side exception (vm_has_native_exc). Consume it and
                            # route through the same in-frame unwind; if no handler here,
                            # stop the frame so it propagates across frames.
                            os_nexc: JSValue = vm_take_native_exc();
                            if not self._unwind_in_frame(
                                self.frames[len(self.frames) - 1], os_nexc
                            ) {
                                self.had_exception = True;
                                self.pending_exc = os_nexc;
                                st.running = False;
                            }
                        }
                        break;
                    }
                    if not _vm_object_set_vop(self, os_dst, ok, ov, os_dst) {
                        exc_os: JSValue = make_type_error(
                            "Cannot assign to read only property"
                        );
                        if not self._unwind_in_frame(
                            self.frames[len(self.frames) - 1], exc_os
                        ) {
                            self.had_exception = True;
                            self.pending_exc = exc_os;
                            st.running = False;
                        }
                        break;
                    }
                }
                oi = oi + 1;
            }
        }
    }

    def _op_unpack_array(frame: CallFrame, ins: Instruction, st: ExecState) {
        self._pop();
    }

    def _op_unpack_object(frame: CallFrame, ins: Instruction, st: ExecState) {
        self._pop();

        # ── Misc ──────────────────────────────────────────────────────
    }

    def _op_nop(frame: CallFrame, ins: Instruction, st: ExecState) {
        # Push the shared TDZ sentinel onto the stack.
        # Paired with STORE_GLOBAL to mark a class name as TDZ at scope entry.
        self._push(_TDZ_SENTINEL);
    }

    def _exec(frame: CallFrame) -> JSValue {
        st: ExecState = ExecState();
        st.running = True;
        st.ret = js_undefined();
        st.allow_inline = True;
        # `fn` is only for the debug probe below: frame switches rebind `code`
        # straight from frame.func, so a call+return pays one fewer
        # retain/release pair per switch.
        fn: CompiledFunction = frame.func;
        code: list[Instruction] = fn.code;
        n_code: int = len(code);
        # Gate to the Scope ctor's exact signature: 12 instrs, 0 params, 0 locals,
        # first op NEW_ARRAY(15). Logs whether _exec actually enters the loop.
        if _DBG_EXEC_ON
            and n_code == 12
            and len(fn.params) == 0
            and fn.num_locals == 0
            and opcode_to_int(code[0].opcode) == 15 {
            _dbg_tid: int = 0;
            if jsv_is_object_cell(frame.this_val) {
                _dbg_tid = jsv_to_table_id(frame.this_val);
            }
            _dbg_ex: str = "[DBG_EXEC_SCOPE] start_ip="
                + str(frame.ip)
                + " this_is_objcell="
                + str(jsv_is_object_cell(frame.this_val))
                + " this_tid="
                + str(_dbg_tid)
                + " this_binding_cell="
                + str(frame.this_binding_cell)
                + " this_uninit="
                + str(frame.this_uninitialized)
                + "\n";
            write(2, _dbg_ex, len(_dbg_ex));
        }

        # Loop invariants hoisted out of the dispatch loop (V0.4): the realm
        # is fixed once create_vm wires it, VM_DEBUG_MODE is a constant and
        # _PAIR_STATS_ON is set at startup. Read through `self` / a glob they
        # cost a null-checked load chain on every dispatch; a reference local
        # declared OUTSIDE the loop is never released per iteration.
        rlm: Realm = self.realm;
        dbg: bool = VM_DEBUG_MODE;
        trace_on: bool = VM_DEBUG_MODE or _PAIR_STATS_ON or _FN_PROF_ON;
        while st.running and frame.ip < n_code {
            # Safepoint (V0.4): process.exit (pending_exit) and a due collection
            # (gc_pending, from gc_note_alloc at the real alloc sites or a
            # deferred `global.gc()`) both raise realm.safepoint_req, so a
            # dispatch tests one byte. The root set (O(stack + all locals)) is
            # assembled only when a collection is actually due.
            if rlm.safepoint_req {
                self._loop_safepoint(st);
            }
            # No reference-typed local may live in this loop body (V0.2,
            # docs/VM_REARCH_PLAN.md): the native compiler releases each one at
            # the end of EVERY iteration (load, release, null store) whether or
            # not that iteration assigned it, and binding the fetched
            # Instruction to a local retained it on every dispatch. `ci` is the
            # instruction's index instead: `code[ci]` passed straight to a
            # handler is a borrowed temporary with no refcount traffic, and the
            # fusion peeks read `code[i].opcode` / `.arg` without binding.
            # Rare paths that need such locals run in methods (_gc_safepoint,
            # _exec_trace, _exec_unwind_inline, _vm_dispatch_d).
            # Because handlers get that borrowed reference, nothing may REPLACE
            # an Instruction object in fn.code while it runs (the old object
            # would be freed under the handler): self-patching (key caching,
            # IC fills) writes the fields of the existing instruction.
            ci: int = frame.ip;
            frame.ip = ci + 1;
            op: Opcode = code[ci].opcode;
            if trace_on {
                if _PAIR_STATS_ON and frame.ip < n_code {
                    ps_nx: int = int(code[frame.ip].opcode);
                    ps_pk: int = int(op) * 256 + ps_nx;
                    if ps_pk in _PAIR_STATS {
                        _PAIR_STATS[ps_pk] = _PAIR_STATS[ps_pk] + 1;
                    } else {
                        _PAIR_STATS[ps_pk] = 1;
                    }
                    if _TRI_PREV[0] >= 0 {
                        ps_tk: int = _TRI_PREV[0] * 65536 + ps_pk;
                        if ps_tk in _TRI_STATS {
                            _TRI_STATS[ps_tk] = _TRI_STATS[ps_tk] + 1;
                        } else {
                            _TRI_STATS[ps_tk] = 1;
                        }
                    }
                    _TRI_PREV[0] = int(op);
                }
                if dbg {
                    self._exec_trace(frame, code[ci]);
                }
                if _FN_PROF_ON {
                    _FN_PROF_CTR[0] = _FN_PROF_CTR[0] - 1;
                    if _FN_PROF_CTR[0] <= 0 {
                        _FN_PROF_CTR[0] = _FN_PROF_EVERY;
                        _fn_prof_sample(frame.func, code[ci].line);
                    }
                }
            }
            # Hot-op fast dispatch (dispatch_impl_plan Phase 2): direct static
            # calls to the SAME handlers the table holds — the native compiler
            # can inline internal-linkage callees, and the compare chain is
            # cheaper than the indirect call for the ops that dominate real
            # bytecode. Ordered by measured frequency. Everything else takes
            # the dense table.
            # The trivial stack ops below are written out here rather than
            # called: LLVM does not inline their handlers into this (very
            # large) function, and an out-of-line handler pays a register
            # save/restore prologue plus null checks — ~40 instructions for a
            # one-slot push. Their handlers stay in the table for the trace
            # path and other callers; slow cases still call them.
            if op == Opcode.LOAD_LOCAL {
                self.stack.append(frame.locals[frame.lb + (code[ci].arg)]);
                # load→const pair fusion: both trivial pushes, one dispatch
                # (top pair in every measured histogram — see RESULTS.md §5).
                if not dbg
                    and frame.ip < n_code
                    and code[frame.ip].opcode == Opcode.LOAD_CONST {
                    llc_i: int = frame.ip;
                    frame.ip = llc_i + 1;
                    # _op_load_const caches the decoded value in the
                    # instruction (ic_holder == 1, value in ic_obj).
                    if code[llc_i].ic_holder == 1 {
                        self.stack.append(code[llc_i].ic_obj);
                    } else {
                        _vm_op_load_const(self, frame, code[llc_i], st);
                    }
                }
            } elif op == Opcode.LOAD_LOCAL_CHECKED {
                # Only a binding still in its TDZ needs the handler (it throws).
                if js_is_tdz(frame.locals[frame.lb + (code[ci].arg)]) {
                    _vm_op_load_local_checked(self, frame, code[ci], st);
                } else {
                    self.stack.append(frame.locals[frame.lb + (code[ci].arg)]);
                    # checked-load→const fusion, as for LOAD_LOCAL (14M pairs).
                    if not dbg
                        and frame.ip < n_code
                        and code[frame.ip].opcode == Opcode.LOAD_CONST
                        and code[frame.ip].ic_holder == 1 {
                        self.stack.append(code[frame.ip].ic_obj);
                        frame.ip = frame.ip + 1;
                    }
                }
            } elif op == Opcode.LOAD_CONST {
                if code[ci].ic_holder == 1 {
                    self.stack.append(code[ci].ic_obj);
                } else {
                    _vm_op_load_const(self, frame, code[ci], st);
                }
                # const→arith fusion (trigram: LOAD_CONST→SUB/ADD mid-chain in
                # every arith sequence): run the int32 inline arith right here,
                # including its store/dup tails.
                if not dbg
                    and frame.ip < n_code
                    and len(self.stack) >= frame.stack_base + 2 {
                    lca_op: Opcode = code[frame.ip].opcode;
                    if lca_op == Opcode.ADD or lca_op == Opcode.SUB {
                        lca_b: JSValue = self.stack[len(self.stack) - 1];
                        lca_a: JSValue = self.stack[len(self.stack) - 2];
                        if jsv_is_int32(lca_a) and jsv_is_int32(lca_b) {
                            lca_r: int = 0;
                            if lca_op == Opcode.ADD {
                                lca_r = jsv_to_int32(lca_a) + jsv_to_int32(lca_b);
                            } else {
                                lca_r = jsv_to_int32(lca_a) - jsv_to_int32(lca_b);
                            }
                            self._pop();
                            self._pop();
                            lca_v: JSValue = js_undefined();
                            if lca_r >= -2147483648 and lca_r <= 2147483647 {
                                lca_v = js_int(lca_r);
                            } else {
                                lca_v = js_number(float(lca_r));
                            }
                            frame.ip = frame.ip + 1;
                            if frame.ip < n_code
                                and code[frame.ip].opcode == Opcode.STORE_LOCAL {
                                frame.locals[frame.lb + (code[frame.ip].arg)] = lca_v;
                                frame.ip = frame.ip + 1;
                            } else {
                                self._push(lca_v);
                            }
                        }
                    }
                }
            } elif op == Opcode.STORE_LOCAL {
                frame.locals[frame.lb + (code[ci].arg)] = self.stack.pop();
            }
            # Megaops (bytecode_optimizer_impl_plan Phase 2): one dispatch per
            # loop iteration each in fused loops — hot by construction.
            elif op == Opcode.BR_CMP_LL {
                _vm_op_br_cmp_ll(self, frame, code[ci], st);
            } elif op == Opcode.LOCAL_INC {
                _vm_op_local_inc(self, frame, code[ci], st);
            } elif op == Opcode.GET_LL_INDEX {
                _vm_op_get_ll_index(self, frame, code[ci], st);
            } elif op == Opcode.SET_LL_INDEX {
                _vm_op_set_ll_index(self, frame, code[ci], st);
            } elif op == Opcode.GET_LLC_PROP {
                # `local.key`: an IC hit on its GET_PROP (at ci + 1) is read
                # here, one dispatch. A local still in its TDZ always takes the
                # handler, which throws — the TDZ sentinel is itself an object,
                # so it must never reach the probes or the fall-through below.
                if js_is_tdz(frame.locals[frame.lb + (code[ci].arg)]) {
                    _vm_op_get_llc_prop(self, frame, code[ci], st);
                } else {
                    glp_v: JSValue = _vm_ic_probe(
                        code[ci + 1], frame.locals[frame.lb + (code[ci].arg)]
                    );
                    if jsv_is_hole(glp_v) {
                        glp_v = _vm_mgc_get(
                            code[ci + 1].arg2, frame.locals[frame.lb + (code[ci].arg)]
                        );
                    }
                    if not jsv_is_hole(glp_v) {
                        self.stack.append(glp_v);
                        frame.ip = ci + 2;
                    } elif (
                        code[ci + 1].ic_holder == 0
                        or code[ci + 1].ic_holder <= 0 - _GETTER_IC_TAG
                    )
                        and jsv_is_object_cell(
                            frame.locals[frame.lb + (code[ci].arg)]
                        ) {
                        # A possible getter site: push the local and fall into
                        # the original GET_PROP, whose dispatch tries the
                        # getter IC — the megaop slow-path contract.
                        self.stack.append(frame.locals[frame.lb + (code[ci].arg)]);
                        frame.ip = ci + 1;
                    } else {
                        _vm_op_get_llc_prop(self, frame, code[ci], st);
                    }
                }
            } elif op == Opcode.SET_THIS_PROP {
                # `this.key = value;` with an own-slot SET IC hit on the
                # window's SET_PROP (ci + 2) and a plain `this`: store, drop
                # the value, skip the window.
                if frame.this_binding_cell == 0
                    and not frame.this_uninitialized
                    and _vm_set_ic_hit(code[ci + 2], frame.this_val) {
                    js_object_slot_set_at_id(
                        jsv_to_table_id(frame.this_val),
                        code[ci + 2].ic_ver // 16,
                        self.stack[len(self.stack) - 1]
                    );
                    self.stack.pop();
                    frame.ip = ci + 4;
                } else {
                    # A prototype setter (setter IC on the window's SET_PROP):
                    # the value on the stack becomes its argument.
                    stp_fn: JSValue = jsv_hole();
                    if frame.this_binding_cell == 0 and not frame.this_uninitialized {
                        stp_fn = self._setter_ic_lookup(code[ci + 2], frame.this_val);
                    }
                    if not jsv_is_hole(stp_fn)
                        and self._setter_ic_call(stp_fn, frame.this_val, st) {
                        frame.ip = ci + 4;
                        st.frame_switched = False;
                        frame = self.frames[len(self.frames) - 1];
                        code = frame.func.code;
                        n_code = len(code);
                    } else {
                        _vm_op_set_this_prop(self, frame, code[ci], st);
                    }
                }
            } elif op == Opcode.SET_LL_PROP {
                # `localObj.key = localVal;` with an own-slot SET IC hit on the
                # window's SET_PROP (ci + 3): one store, nothing pushed. A TDZ
                # local (the sentinel is an object) takes the handler, which throws.
                if not js_is_tdz(frame.locals[frame.lb + (code[ci].arg2 & 65535)])
                    and _vm_set_ic_hit(
                        code[ci + 3], frame.locals[frame.lb + (code[ci].arg2 & 65535)]
                    ) {
                    js_object_slot_set_at_id(
                        jsv_to_table_id(
                            frame.locals[frame.lb + (code[ci].arg2 & 65535)]
                        ),
                        code[ci + 3].ic_ver // 16,
                        frame.locals[frame.lb + (code[ci].arg)]
                    );
                    frame.ip = ci + 5;
                } else {
                    # A prototype setter (setter IC on the window's SET_PROP),
                    # called with the value local as its argument.
                    sll_fn: JSValue = jsv_hole();
                    if not js_is_tdz(
                        frame.locals[frame.lb + (code[ci].arg2 & 65535)]
                    ) {
                        sll_fn = self._setter_ic_lookup(
                            code[ci + 3],
                            frame.locals[frame.lb + (code[ci].arg2 & 65535)]
                        );
                    }
                    sll_in: bool = False;
                    if not jsv_is_hole(sll_fn) {
                        self.stack.append(frame.locals[frame.lb + (code[ci].arg)]);
                        if self._setter_ic_call(
                            sll_fn, frame.locals[frame.lb + (code[ci].arg2 & 65535)], st
                        ) {
                            frame.ip = ci + 5;
                            sll_in = True;
                        } else {
                            self.stack.pop();
                        }
                    }
                    if sll_in {
                        st.frame_switched = False;
                        frame = self.frames[len(self.frames) - 1];
                        code = frame.func.code;
                        n_code = len(code);
                    } else {
                        _vm_op_set_ll_prop(self, frame, code[ci], st);
                    }
                }
            } elif op == Opcode.PROP_INC {
                _vm_op_prop_inc(self, frame, code[ci], st);
            } elif op == Opcode.DUP {
                # dup→store fusion: `locals[arg] = top` WITHOUT the dup/pop
                # round-trip (the compound-assignment expression-value pattern).
                if not dbg
                    and frame.ip < n_code
                    and len(self.stack) > frame.stack_base
                    and code[frame.ip].opcode == Opcode.STORE_LOCAL {
                    frame.locals[frame.lb + (code[frame.ip].arg)] = self.stack[
                        len(self.stack) - 1
                    ];
                    frame.ip = frame.ip + 1;
                } elif not dbg
                    and frame.ip + 1 < n_code
                    and (
                        code[frame.ip].opcode == Opcode.JUMP_IF_TRUE
                        or code[frame.ip].opcode == Opcode.JUMP_IF_FALSE
                    )
                    and code[frame.ip + 1].opcode == Opcode.POP {
                    # `a || b` / `a && b` (DUP; JUMP_IF_TRUE|FALSE end; POP): one
                    # dispatch. ToBoolean is pure. Short-circuit → jump keeping
                    # the value (it is the result); otherwise drop it and go on
                    # to `b`.
                    if jsv_coerce_to_bool(self.stack[len(self.stack) - 1])
                        == (code[frame.ip].opcode == Opcode.JUMP_IF_TRUE) {
                        frame.ip = code[frame.ip].arg;
                    } else {
                        self.stack.pop();
                        frame.ip = frame.ip + 2;
                    }
                } elif not dbg
                    and frame.ip + 1 < n_code
                    and code[frame.ip].opcode == Opcode.GET_PROP
                    and code[frame.ip + 1].opcode == Opcode.SWAP {
                    # dup→get→swap fusion: the method fetch of `obj.m(...)`
                    # ([obj] → [m, obj]) in one dispatch on an IC hit.
                    dgs_v: JSValue = _vm_ic_probe(
                        code[frame.ip], self.stack[len(self.stack) - 1]
                    );
                    if jsv_is_hole(dgs_v) {
                        dgs_v = _vm_mgc_get(
                            code[frame.ip].arg2, self.stack[len(self.stack) - 1]
                        );
                    }
                    self.stack.append(self.stack[len(self.stack) - 1]);
                    if not jsv_is_hole(dgs_v) {
                        self.stack[len(self.stack) - 2] = dgs_v;
                        frame.ip = frame.ip + 2;
                    }
                } else {
                    self.stack.append(self.stack[len(self.stack) - 1]);
                }
            } elif op == Opcode.SWAP {
                sw_t: JSValue = self.stack[len(self.stack) - 1];
                self.stack[len(self.stack) - 1] = self.stack[len(self.stack) - 2];
                self.stack[len(self.stack) - 2] = sw_t;
            } elif op == Opcode.BAND
                or op == Opcode.BOR
                or op == Opcode.BXOR
                or op == Opcode.SHL
                or op == Opcode.SHR
                or op == Opcode.USHR
                or op == Opcode.MUL
                or op == Opcode.MOD {
                # Two int32 operands need no ToNumeric / ToInt32 (no valueOf
                # can run), so these results are exact; the bit-twiddling
                # kernels (sourcemap VLQ, base64, hashes) live on them. Any
                # other operands — and a remainder with a negative operand,
                # whose JS sign rule differs from integer math — take the
                # handler.
                bnd_done: bool = False;
                if len(self.stack) >= frame.stack_base + 2 {
                    bnd_b: JSValue = self.stack[len(self.stack) - 1];
                    bnd_a: JSValue = self.stack[len(self.stack) - 2];
                    if jsv_is_int32(bnd_a) and jsv_is_int32(bnd_b) {
                        bnd_x: int = jsv_to_int32(bnd_a);
                        bnd_y: int = jsv_to_int32(bnd_b);
                        bnd_v: JSValue = jsv_hole();
                        if op == Opcode.BAND {
                            bnd_v = js_int(bnd_x & bnd_y);
                        } elif op == Opcode.BOR {
                            bnd_v = js_int(bnd_x | bnd_y);
                        } elif op == Opcode.BXOR {
                            bnd_v = js_int(bnd_x ^ bnd_y);
                        } elif op == Opcode.SHR {
                            bnd_v = js_int(bnd_x >> (bnd_y & 31));
                        } elif op == Opcode.SHL {
                            # ToInt32 of the shifted low 32 bits.
                            bnd_l: int = (bnd_x << (bnd_y & 31)) & 4294967295;
                            if bnd_l > 2147483647 {
                                bnd_l = bnd_l - 4294967296;
                            }
                            bnd_v = js_int(bnd_l);
                        } elif op == Opcode.USHR {
                            # ToUint32(a) >>> n: may exceed int32 → a double.
                            bnd_u: int = (bnd_x & 4294967295) >> (bnd_y & 31);
                            if bnd_u > 2147483647 {
                                bnd_v = js_number(float(bnd_u));
                            } else {
                                bnd_v = js_int(bnd_u);
                            }
                        } elif op == Opcode.MUL {
                            # |product| < 2^62: exact in int64; float() rounds it
                            # exactly as the double multiply would.
                            bnd_m: int = bnd_x * bnd_y;
                            if bnd_m != 0 {
                                if bnd_m >= -2147483648 and bnd_m <= 2147483647 {
                                    bnd_v = js_int(bnd_m);
                                } else {
                                    bnd_v = js_number(float(bnd_m));
                                }
                            } elif bnd_x >= 0 and bnd_y >= 0 {
                                bnd_v = js_int(0);
                            }
                            # A zero with a negative factor is -0: the double
                            # product carries the sign.
                            else {
                                bnd_v = js_number(float(bnd_x) * float(bnd_y));
                            }
                        } elif bnd_x >= 0 and bnd_y > 0 {
                            # MOD: integer and JS remainders agree for these signs.
                            bnd_v = js_int(bnd_x % bnd_y);
                        }
                        if not jsv_is_hole(bnd_v) {
                            self.stack.pop();
                            self.stack[len(self.stack) - 1] = bnd_v;
                            bnd_done = True;
                        }
                    }
                }
                if not bnd_done {
                    _vm_dispatch_d(self, frame, code[ci], st, int(op));
                }
            }
            # NOP is misleadingly named: it PUSHES the TDZ sentinel (class
            # TDZ marking, paired with STORE_GLOBAL) — route to the real
            # handler, never treat as empty.
            elif op == Opcode.NOP {
                _vm_op_nop(self, frame, code[ci], st);
            } elif op == Opcode.TDZ_CLASS {
                # let/const TDZ marking: the compiler emits TDZ_CLASS, STORE_LOCAL k
                # per binding at scope entry (jac_client: 44M pairs, mostly in runs).
                # Store the sentinel straight into the local and absorb the rest of
                # a run of such pairs: one dispatch instead of two per binding.
                # Both ops are straight-line (cannot throw or jump), and
                # STORE_LOCAL is a bare locals[arg] = pop().
                if not dbg
                    and frame.ip < n_code
                    and code[frame.ip].opcode == Opcode.STORE_LOCAL {
                    frame.locals[frame.lb + (code[frame.ip].arg)] = _TDZ_SENTINEL;
                    frame.ip = frame.ip + 1;
                    while frame.ip + 1 < n_code
                        and code[frame.ip].opcode == Opcode.TDZ_CLASS
                        and code[frame.ip + 1].opcode == Opcode.STORE_LOCAL {
                        frame.locals[frame.lb + (code[frame.ip + 1].arg)] = _TDZ_SENTINEL;
                        frame.ip = frame.ip + 2;
                    }
                } else {
                    _vm_op_nop(self, frame, code[ci], st);
                }
            } elif op == Opcode.LOAD_THIS {
                if frame.this_binding_cell == 0 and not frame.this_uninitialized {
                    # Plain `this` (what _op_load_this pushes when there is no
                    # derived-ctor this-binding to check).
                    self.stack.append(frame.this_val);
                    if not dbg and frame.ip < n_code {
                        if code[frame.ip].opcode == Opcode.GET_PROP {
                            # this→get fusion (`this.key`, jac_client's top
                            # pair): an IC hit on the next GET_PROP is read
                            # here, one dispatch for both.
                            ltg_v: JSValue = _vm_ic_probe(
                                code[frame.ip], frame.this_val
                            );
                            if jsv_is_hole(ltg_v) {
                                ltg_v = _vm_mgc_get(
                                    code[frame.ip].arg2, frame.this_val
                                );
                            }
                            if not jsv_is_hole(ltg_v) {
                                self.stack[len(self.stack) - 1] = ltg_v;
                                frame.ip = frame.ip + 1;
                            }
                        } elif code[frame.ip].opcode == Opcode.SWAP
                            and len(self.stack) >= frame.stack_base + 2 {
                            # this→swap fusion (ctor `this.x = expr`).
                            lth_t: JSValue = self.stack[len(self.stack) - 1];
                            self.stack[len(self.stack) - 1] = self.stack[
                                len(self.stack) - 2
                            ];
                            self.stack[len(self.stack) - 2] = lth_t;
                            frame.ip = frame.ip + 1;
                        }
                    }
                } else {
                    # this→swap fusion (ctor `this.x = expr`): LOAD_THIS can THROW
                    # (derived-ctor this-TDZ) — consume the SWAP only on a
                    # straight-line completion (ip unchanged, running, no pending
                    # exception), same guard pattern as SET_PROP→POP.
                    lth_ip0: int = frame.ip;
                    _vm_op_load_this(self, frame, code[ci], st);
                    if not dbg
                        and st.running
                        and frame.ip == lth_ip0
                        and not self.had_exception
                        and frame.ip < n_code
                        and len(self.stack) >= frame.stack_base + 2
                        and code[frame.ip].opcode == Opcode.SWAP {
                        lth_t2: JSValue = self.stack[len(self.stack) - 1];
                        self.stack[len(self.stack) - 1] = self.stack[
                            len(self.stack) - 2
                        ];
                        self.stack[len(self.stack) - 2] = lth_t2;
                        frame.ip = frame.ip + 1;
                    }
                }
            } elif op == Opcode.ADD or op == Opcode.SUB {
                # Inline int32 arithmetic + arith→store fusion
                # (superinstructions_impl_plan Phase 2). Two int32 operands
                # cannot trigger ToPrimitive/concat — pure number math;
                # overflow promotes to double (ES numbers ARE doubles).
                # Disabled under VM_DEBUG_MODE for exact trace fidelity.
                ar_done: bool = False;
                if not dbg and len(self.stack) >= frame.stack_base + 2 {
                    ar_b: JSValue = self.stack[len(self.stack) - 1];
                    ar_a: JSValue = self.stack[len(self.stack) - 2];
                    if jsv_is_int32(ar_a) and jsv_is_int32(ar_b) {
                        ar_r: int = 0;
                        if op == Opcode.ADD {
                            ar_r = jsv_to_int32(ar_a) + jsv_to_int32(ar_b);
                        } else {
                            ar_r = jsv_to_int32(ar_a) - jsv_to_int32(ar_b);
                        }
                        self._pop();
                        self._pop();
                        ar_v: JSValue = js_undefined();
                        if ar_r >= -2147483648 and ar_r <= 2147483647 {
                            ar_v = js_int(ar_r);
                        } else {
                            ar_v = js_number(float(ar_r));
                        }
                        # arith→store / arith→dup(→store) tails: consume a
                        # bare STORE_LOCAL, or a DUP (push result twice), or
                        # the DUP,STORE_LOCAL sequence (store AND keep the
                        # expression value). STORE_LOCAL is a bare
                        # locals[arg]=pop() — if it ever grows bookkeeping,
                        # these writes must mirror it.
                        ar_stored: bool = False;
                        if frame.ip < n_code {
                            ar_nop: Opcode = code[frame.ip].opcode;
                            if ar_nop == Opcode.STORE_LOCAL {
                                frame.locals[frame.lb + (code[frame.ip].arg)] = ar_v;
                                frame.ip = frame.ip + 1;
                                ar_stored = True;
                            } elif ar_nop == Opcode.DUP {
                                if frame.ip + 1 < n_code
                                    and code[frame.ip + 1].opcode
                                        == Opcode.STORE_LOCAL {
                                    frame.locals[frame.lb + (code[frame.ip + 1].arg)] = ar_v;
                                    self._push(ar_v);
                                    frame.ip = frame.ip + 2;
                                } else {
                                    self._push(ar_v);
                                    self._push(ar_v);
                                    frame.ip = frame.ip + 1;
                                }
                                ar_stored = True;
                            }
                        }
                        if not ar_stored {
                            self._push(ar_v);
                        }
                        ar_done = True;
                    }
                }
                if not ar_done {
                    if op == Opcode.ADD {
                        _vm_op_add(self, frame, code[ci], st);
                    } else {
                        _vm_op_sub(self, frame, code[ci], st);
                    }
                }
            } elif op == Opcode.STRICT_EQ or op == Opcode.STRICT_NEQ {
                # Strict (in)equality runs no user code and cannot throw for
                # any operands, so it is computed here — and fused with a
                # following JUMP_IF_FALSE / JUMP_IF_TRUE, the boolean never
                # materialized (jac_client: 7.3M `=== x` + branch pairs, most
                # on strings / null / undefined, which only numbers fused).
                se_r: bool = False;
                if jsv_is_bigint_cell(self.stack[len(self.stack) - 2])
                    and jsv_is_bigint_cell(self.stack[len(self.stack) - 1]) {
                    se_r = js_bigint_cells_equal(
                        self.stack[len(self.stack) - 2], self.stack[len(self.stack) - 1]
                    );
                } else {
                    se_r = self._vm_strict_eq(
                        self.stack[len(self.stack) - 2], self.stack[len(self.stack) - 1]
                    );
                }
                if op == Opcode.STRICT_NEQ {
                    se_r = not se_r;
                }
                self.stack.pop();
                if not dbg
                    and frame.ip < n_code
                    and (
                        code[frame.ip].opcode == Opcode.JUMP_IF_FALSE
                        or code[frame.ip].opcode == Opcode.JUMP_IF_TRUE
                    ) {
                    self.stack.pop();
                    if se_r == (code[frame.ip].opcode == Opcode.JUMP_IF_TRUE) {
                        frame.ip = code[frame.ip].arg;
                    } else {
                        frame.ip = frame.ip + 1;
                    }
                } else {
                    self.stack[len(self.stack) - 1] = js_boolean(se_r);
                }
            } elif op == Opcode.LT
                or op == Opcode.LTE
                or op == Opcode.GT
                or op == Opcode.GTE {
                # Fused compare→branch (superinstructions_impl_plan Phase 1).
                # Numeric operands only (no ToPrimitive ⇒ cannot throw); the
                # boolean is never materialized. Both instructions stay in
                # `code`, so a jump INTO the branch op still works standalone.
                # NaN: native float compares are false, matching ES.
                fu_done: bool = False;
                if not dbg
                    and frame.ip < n_code
                    and len(self.stack) >= frame.stack_base + 2 {
                    fu_b: JSValue = self.stack[len(self.stack) - 1];
                    fu_a: JSValue = self.stack[len(self.stack) - 2];
                    if (jsv_is_int32(fu_a) or jsv_is_double(fu_a))
                        and (jsv_is_int32(fu_b) or jsv_is_double(fu_b)) {
                        fu_nop: Opcode = code[frame.ip].opcode;
                        if fu_nop == Opcode.JUMP_IF_FALSE
                            or fu_nop == Opcode.JUMP_IF_TRUE {
                            fu_tgt: int = code[frame.ip].arg;
                            fu_av: float = 0.0;
                            fu_bv: float = 0.0;
                            if jsv_is_int32(fu_a) {
                                fu_av = float(jsv_to_int32(fu_a));
                            } else {
                                fu_av = jsv_to_double(fu_a);
                            }
                            if jsv_is_int32(fu_b) {
                                fu_bv = float(jsv_to_int32(fu_b));
                            } else {
                                fu_bv = jsv_to_double(fu_b);
                            }
                            fu_res: bool = False;
                            if op == Opcode.LT {
                                fu_res = fu_av < fu_bv;
                            } elif op == Opcode.LTE {
                                fu_res = fu_av <= fu_bv;
                            } elif op == Opcode.GT {
                                fu_res = fu_av > fu_bv;
                            } else {
                                fu_res = fu_av >= fu_bv;
                            }
                            self._pop();
                            self._pop();
                            frame.ip = frame.ip + 1;
                            if fu_nop == Opcode.JUMP_IF_FALSE {
                                if not fu_res {
                                    frame.ip = fu_tgt;
                                }
                            } else {
                                if fu_res {
                                    frame.ip = fu_tgt;
                                }
                            }
                            fu_done = True;
                        }
                    }
                }
                if not fu_done {
                    if op == Opcode.LT {
                        _vm_op_lt(self, frame, code[ci], st);
                    } elif op == Opcode.LTE {
                        _vm_op_lte(self, frame, code[ci], st);
                    } elif op == Opcode.GT {
                        _vm_op_gt(self, frame, code[ci], st);
                    } else {
                        _vm_op_gte(self, frame, code[ci], st);
                    }
                }
            } elif op == Opcode.JUMP {
                _vm_op_jump(self, frame, code[ci], st);
            } elif op == Opcode.JUMP_IF_FALSE {
                if not jsv_coerce_to_bool(self.stack.pop()) {
                    frame.ip = code[ci].arg;
                }
            } elif op == Opcode.JUMP_IF_TRUE {
                if jsv_coerce_to_bool(self.stack.pop()) {
                    frame.ip = code[ci].arg;
                }
            } elif op == Opcode.POP {
                self.stack.pop();
                # pop→jump fusion (loop tails): consume the unconditional jump.
                if not dbg
                    and frame.ip < n_code
                    and code[frame.ip].opcode == Opcode.JUMP {
                    frame.ip = code[frame.ip].arg;
                }
            } elif op == Opcode.SET_PROP
                and _vm_set_ic_hit(code[ci], self.stack[len(self.stack) - 2]) {
                # Own-slot SET IC hit in place: [obj, val] → [val], and the
                # statement form's POP absorbed (set→pop fusion).
                js_object_slot_set_at_id(
                    jsv_to_table_id(self.stack[len(self.stack) - 2]),
                    code[ci].ic_ver // 16,
                    self.stack[len(self.stack) - 1]
                );
                self.stack[len(self.stack) - 2] = self.stack[len(self.stack) - 1];
                self.stack.pop();
                if not dbg
                    and frame.ip < n_code
                    and code[frame.ip].opcode == Opcode.POP {
                    self.stack.pop();
                    frame.ip = frame.ip + 1;
                }
            } elif op == Opcode.SET_PROP {
                # Setter IC: [obj, val] → the setter runs as an inline frame
                # with `val` as its argument and leaves [val] — or nothing,
                # absorbing a statement's POP — when it returns.
                spi_fn: JSValue = self._setter_ic_lookup(
                    code[ci], self.stack[len(self.stack) - 2]
                );
                spi_in: bool = False;
                if not jsv_is_hole(spi_fn) {
                    spi_rv: JSValue = self.stack[len(self.stack) - 2];
                    spi_pop: bool = not dbg
                        and frame.ip < n_code
                        and code[frame.ip].opcode == Opcode.POP;
                    self.stack[len(self.stack) - 2] = self.stack[len(self.stack) - 1];
                    if spi_pop {
                        self.stack.pop();
                    }
                    if self._setter_ic_call(spi_fn, spi_rv, st) {
                        if spi_pop {
                            frame.ip = frame.ip + 1;
                        }
                        spi_in = True;
                    } else {
                        # Not entered: restore [obj, val] for the handler.
                        if spi_pop {
                            self.stack.append(self.stack[len(self.stack) - 1]);
                        }
                        self.stack[len(self.stack) - 2] = spi_rv;
                    }
                }
                if spi_in {
                    st.frame_switched = False;
                    frame = self.frames[len(self.frames) - 1];
                    code = frame.func.code;
                    n_code = len(code);
                } else {
                    # set→pop fusion (statement-position `o.k = v`): consume the
                    # discard of the pushed assignment value — but ONLY when the
                    # handler completed straight-line (no throw/unwind/divert:
                    # ip unchanged, still running, no pending exception), else the
                    # stack top is not our pushed value.
                    sp_ip0: int = frame.ip;
                    _vm_op_set_prop(self, frame, code[ci], st);
                    if not dbg
                        and st.running
                        and frame.ip == sp_ip0
                        and not self.had_exception
                        and frame.ip < n_code
                        and code[frame.ip].opcode == Opcode.POP {
                        self._pop();
                        frame.ip = frame.ip + 1;
                    }
                }
            } elif op == Opcode.GET_PROP {
                # IC hit read in place: no handler call, key-cache call or
                # pop/push. Anything else takes the handler.
                gpi_v: JSValue = _vm_ic_probe(
                    code[ci], self.stack[len(self.stack) - 1]
                );
                if jsv_is_hole(gpi_v) {
                    gpi_v = _vm_mgc_get(code[ci].arg2, self.stack[len(self.stack) - 1]);
                }
                if not jsv_is_hole(gpi_v) {
                    self.stack[len(self.stack) - 1] = gpi_v;
                } elif self._getter_ic_call(code[ci], st) {
                    # Getter entered as an inline frame: switch to it.
                    st.frame_switched = False;
                    frame = self.frames[len(self.frames) - 1];
                    code = frame.func.code;
                    n_code = len(code);
                } else {
                    _vm_op_get_prop(self, frame, code[ci], st);
                }
            } elif op == Opcode.GET_INDEX {
                # `o[i]` with an int32 index: a dense own element (the
                # handler's first fast path) or an integer typed-array element,
                # read here; anything else takes the handler.
                gx_v: JSValue = jsv_hole();
                if jsv_is_int32(self.stack[len(self.stack) - 1])
                    and jsv_to_int32(self.stack[len(self.stack) - 1]) >= 0 {
                    gx_v = js_object_dense_elem(
                        self.stack[len(self.stack) - 2],
                        jsv_to_int32(self.stack[len(self.stack) - 1])
                    );
                    if jsv_is_hole(gx_v) {
                        gx_v = binary_ta_int_get(
                            self.stack[len(self.stack) - 2],
                            jsv_to_int32(self.stack[len(self.stack) - 1])
                        );
                    }
                }
                if not jsv_is_hole(gx_v) {
                    self.stack.pop();
                    self.stack[len(self.stack) - 1] = gx_v;
                } else {
                    _vm_op_get_index(self, frame, code[ci], st);
                }
            } elif op == Opcode.SET_INDEX {
                _vm_op_set_index(self, frame, code[ci], st);
            } elif op == Opcode.LOAD_GLOBAL {
                _vm_op_load_global(self, frame, code[ci], st);
            } elif op == Opcode.CALL_METHOD
                or op == Opcode.RETURN
                or op == Opcode.RETURN_UNDEFINED {
                # Hot frame-switching ops off the table (jac_client: CALL_METHOD
                # ~10M, RETURN* per call): direct calls, same rebind as CALL.
                if op == Opcode.CALL_METHOD {
                    _vm_op_call_method(self, frame, code[ci], st);
                } elif op == Opcode.RETURN {
                    _vm_op_return(self, frame, code[ci], st);
                } else {
                    _vm_op_return_undefined(self, frame, code[ci], st);
                }
                if st.frame_switched {
                    st.frame_switched = False;
                    frame = self.frames[len(self.frames) - 1];
                    code = frame.func.code;
                    n_code = len(code);
                }
            } elif op == Opcode.CALL {
                _vm_op_call(self, frame, code[ci], st);
                if st.frame_switched {
                    st.frame_switched = False;
                    frame = self.frames[len(self.frames) - 1];
                    code = frame.func.code;
                    n_code = len(code);
                }
            } else {
                if not _vm_dispatch_d(self, frame, code[ci], st, int(op)) {
                    print("[VM FATAL] unknown opcode");
                    st.running = False;
                }
                # Frames switch only in CALL / CALL_METHOD / RETURN /
                # RETURN_UNDEFINED (static branches above, each rebinding) and
                # TAIL_CALL here (inline call entry and _inline_return set
                # st.frame_switched), so the loop rebinds its cached frame right
                # after those ops instead of testing the flag at the top of every
                # dispatch. The while-condition then already sees the new frame.
                elif st.frame_switched {
                    st.frame_switched = False;
                    frame = self.frames[len(self.frames) - 1];
                    code = frame.func.code;
                    n_code = len(code);
                }
            }
            # Cross-frame unwind for inline frames (Phase 3): an exception
            # that found no handler in the CURRENT frame stops the loop; if
            # inline frames are stacked, pop them and retry the callers'
            # handlers, resuming the loop on a catch.
            if (not st.running) and self.had_exception and st.inline_depth > 0 {
                frame = self._exec_unwind_inline(st);
                code = frame.func.code;
                n_code = len(code);
            }
        }

        return st.ret;
    }

    """Service realm.safepoint_req for `_exec`'s loop. A pending process.exit
    stops this loop after the current instruction and stays requested, so every
    enclosing `_exec` stops too; a due collection runs now (and its flag is
    cleared even when GC is disabled)."""
    def _loop_safepoint(st: ExecState) {
        # a pending register-frame catch keeps the flag up for its loop (V4.25)
        self.realm.safepoint_req = self.reg_unwound;
        if self.realm.pending_exit {
            st.running = False;
            self.realm.safepoint_req = True;
        }
        if self.realm.gc_pending {
            self._gc_safepoint();
        }
    }

    """Run a collection at a dispatch-loop safepoint (the loop saw
    `realm.gc_pending`). Kept out of `_exec` so the root-gathering locals
    are not released on every dispatch."""
    def _gc_safepoint {
        self.realm.gc_pending = False;
        if self.realm.gc_enabled {
            self.realm.gc_alloc_count = 0;
            gc_roots_all: list[JSValue] = [];
            for gc_sv in self.stack {
                gc_roots_all.append(gc_sv);
            }
            gc_ri: int = 0;
            while gc_ri < self.rtop {
                gc_roots_all.append(self.regs[gc_ri]);
                gc_ri = gc_ri + 1;
            }
            for gc_fr in self.frames {
                if not gc_fr.win {
                    for gc_lv in gc_fr.locals {
                        gc_roots_all.append(gc_lv);
                    }
                }
                gc_roots_all.append(gc_fr.this_val);
                # CallFrame fields previously missed — objects reachable
                # only via a closure free var / with-object / using-dispose
                # / new.target were incorrectly swept when --gc was on.
                for gc_fv in gc_fr.free_vals {
                    gc_roots_all.append(gc_fv);
                }
                gc_roots_all.append(gc_fr.self_fn);
                for gc_wo in gc_fr.with_objs {
                    gc_roots_all.append(gc_wo);
                }
                for gc_ds in gc_fr.dispose_stack {
                    gc_roots_all.append(gc_ds);
                }
                for gc_dm in gc_fr.dispose_methods {
                    gc_roots_all.append(gc_dm);
                }
                gc_roots_all.append(gc_fr.new_target);
                # Derived-ctor state: the shared this-binding cell and the
                # active ctor's class. Missing these swept the cell mid-
                # construction, so super()'s `sc_already` read a reallocated
                # slot as non-TDZ → false "Super constructor may only be
                # called once" (Buffer.from / any `extends` under --gc).
                gc_roots_all.append(gc_fr.this_binding_cell);
                gc_roots_all.append(gc_fr.ctor_class);
                if gc_fr.mod_swapped {
                    gc_roots_all.append(gc_fr.saved_mod);
                    gc_roots_all.append(gc_fr.saved_exp);
                }
                if gc_fr.ctor_this != 0 {
                    gc_roots_all.append(gc_fr.ctor_this);
                }
                if gc_fr.post_fields != 0 {
                    gc_roots_all.append(gc_fr.post_fields);
                }
                # Direct-eval-introduced `var` bindings (Annex B.3.3.3).
                for gc_dv in gc_fr.dyn_var_vals {
                    gc_roots_all.append(gc_dv);
                }
                # In-flight values of a native builtin that re-entered
                # the VM from this frame (map/filter result arrays,
                # reduce accumulators, receiver/callback) — otherwise
                # only in jac locals and swept while live.
                for gc_nr in gc_fr.native_roots {
                    gc_roots_all.append(gc_nr);
                }
            }
            # VM globals map. ESM module top-level `var`/`function`
            # bindings (STORE_MODULE_GLOBAL arg2==0) live HERE and are
            # deliberately kept OFF globalThis, so realm.global_this does
            # not reach them. Also holds __filename / CJS module+exports
            # intermediaries. Missing this root swept live module-scope
            # closures and their captured cells mid-execution — a big
            # ESM bundle (vite@6 chunk) crashed on a self-referential
            # top-level function whose own-name cell was collected
            # (`createDebug` read back undefined → TypeError reading
            # 'useColors'). The <main> frame's locals cover let/const but
            # not these global-routed bindings.
            for gc_gk in self.globals {
                gc_roots_all.append(self.globals[gc_gk]);
            }
            # Module-level `let`/`const` live in global_lexical (NOT on
            # globalThis, NOT in self.globals) — same invisible-root class
            # as self.globals above.
            for gc_lk in self.global_lexical {
                gc_roots_all.append(self.global_lexical[gc_lk]);
            }
            # Transient-but-cross-iteration VM registers. Each holds a live
            # JSValue that can outlive the opcode that set it (GC fires at
            # the top of the dispatch loop, between opcodes), yet none are on
            # the operand stack or in a frame. A swept-then-reused slot
            # reached through one of these stale references corrupts the
            # reused object — e.g. clobbering a list header, surfacing as a
            # bogus "list assignment index out of range" in an unrelated
            # _push far from the real cause. Root them all. (0 is the
            # "unset" sentinel — skip; gc_trace on a non-cell is a no-op but
            # 0 is not guaranteed to decode as a non-cell.)
            if self.pending_exc != 0 {
                gc_roots_all.append(self.pending_exc);
            }
            if self._cur_async_promise != 0 {
                gc_roots_all.append(self._cur_async_promise);
            }
            if self.pending_new_target != 0 {
                gc_roots_all.append(self.pending_new_target);
            }
            if self._pending_new_target != 0 {
                gc_roots_all.append(self._pending_new_target);
            }
            if self._pending_ctor_class != 0 {
                gc_roots_all.append(self._pending_ctor_class);
            }
            if self.ys_yield_result != 0 {
                gc_roots_all.append(self.ys_yield_result);
            }
            if self.pending_ctx_global != 0 {
                gc_roots_all.append(self.pending_ctx_global);
            }
            if self.pending_eval_this != 0 {
                gc_roots_all.append(self.pending_eval_this);
            }
            # Pending tail-call state: callee/this/args are staged by
            # TAIL_CALL and drained by the trampoline; a GC in between must
            # not sweep them.
            if self._tail_closure != 0 {
                gc_roots_all.append(self._tail_closure);
            }
            if self._tail_this != 0 {
                gc_roots_all.append(self._tail_this);
            }
            for gc_ta in self._tail_args {
                gc_roots_all.append(gc_ta);
            }
            for gc_es in self.eval_super_fns {
                gc_roots_all.append(gc_es);
            }
            gc_collect(self.realm, gc_roots_all);
            # ADAPTIVE threshold (proportional-heap heuristic). A fixed
            # 10k-alloc trigger is catastrophic once the live set is large:
            # each gc_collect is a full O(live) mark-sweep, so collecting
            # every 10k allocations against a 10M-object live heap (e.g.
            # vite bundling) spends ~all time in GC and the build never
            # finishes. Set the next trigger to ~the surviving live-object
            # count (floor 10k): allocations-between-GCs then scale with the
            # heap, bounding GC to a fixed fraction of total work (standard
            # "collect when the heap has grown by ~itself" policy), scaled by
            # _GC_GROWTH_PCT (JAC_GC_GROWTH).
            _gc_live: int = (
                (len(self.realm.objects) - len(self.realm.free_object_slots))
                * _GC_GROWTH_PCT
            )
                // 100;
            if _gc_live > _GC_MIN_THRESHOLD {
                self.realm.gc_threshold = _gc_live;
            } else {
                self.realm.gc_threshold = _GC_MIN_THRESHOLD;
            }
        }
    }

    """VM_DEBUG_MODE per-instruction trace line."""
    def _exec_trace(frame: CallFrame, ins: Instruction) {
        dbg_stk_top: str = "[empty]";
        if len(self.stack) > frame.stack_base {
            dbg_stk_top = jsval_dbg(self.stack[len(self.stack) - 1]);
        }
        self.vm_debug(
            "  ["
                + frame.func.name
                + " ip="
                + str(frame.ip - 1)
                + "] "
                + opcode_name(ins.opcode)
                + " "
                + str(ins.arg)
                + "  stk["
                + str(len(self.stack) - frame.stack_base)
                + "]="
                + dbg_stk_top
        );
    }

    """Cross-frame unwind for inline frames (Phase 3): pop each inline frame
    (dispose residue + operand stack trim, mirroring run()'s frame exit) and
    retry the caller's handlers until one catches (st.running is set again)
    or no inline frame is left. Returns the frame `_exec` continues in."""
    def _exec_unwind_inline(st: ExecState) -> CallFrame {
        while st.inline_depth > 0 and self.had_exception {
            uw_fr: CallFrame = self.frames[len(self.frames) - 1];
            if uw_fr.win {
                self.rtop = uw_fr.lb;
            }
            if uw_fr.mod_swapped {
                self._reg_mod_restore(uw_fr);
            }
            self.module_fns = uw_fr.caller_module_fns;
            if len(uw_fr.dispose_stack) > 0 {
                uw_se: bool = self.had_exception;
                uw_sp: JSValue = self.pending_exc;
                self.had_exception = False;
                self.pending_exc = js_undefined();
                self._dispose_to(uw_fr, 0);
                uw_fr.dispose_marks = [];
                if not self.had_exception {
                    self.had_exception = uw_se;
                    self.pending_exc = uw_sp;
                }
            }
            while len(self.stack) > uw_fr.stack_base {
                del self.stack[len(self.stack) - 1];
            }
            del self.frames[len(self.frames) - 1];
            st.inline_depth = st.inline_depth - 1;
            self.call_depth = self.call_depth - 1;
            uw_exc: JSValue = self.pending_exc;
            self.had_exception = False;
            self.pending_exc = js_undefined();
            if self._unwind_in_frame(self.frames[len(self.frames) - 1], uw_exc) {
                st.running = True;
            } else {
                self.had_exception = True;
                self.pending_exc = uw_exc;
            }
        }
        return self.frames[len(self.frames) - 1];
    }

    # ── Register ISA interpreter (docs/VM_REARCH_PLAN.md V2) ───────────────
    # Instruction set, encoding and translator: bytecode/regisa.jac. The
    # opcode numbers in _exec_reg's dispatch chain are literals (a glob read
    # per compare would cost a load chain on every dispatch); they are the
    # R_* table there.

    """Run `frame` on the interpreter its function was compiled for: the
    register loop when regisa translated it (risa == 1), else the stack loop."""
    def _exec_any(frame: CallFrame) -> JSValue {
        if frame.func.risa == 0 {
            reg_translate_fn(frame.func);
        }
        if frame.func.risa == 1 {
            return self._exec_reg(frame);
        }
        return self._exec(frame);
    }

    """True when `fn` runs on the register ISA — translating it first if
    this is its first run (the frame built before that is extended by
    _exec_reg_resume to the bumped num_locals)."""
    def _reg_ready(fn: CompiledFunction) -> bool {
        if fn.risa == 0 {
            reg_translate_fn(fn);
        }
        return fn.risa == 1;
    }

    """ReferenceError for a TDZ-flagged register operand (local `slot`) read
    by the register instruction derived from stack instruction `orig`."""
    def _reg_tdz_throw(frame: CallFrame, st: ExecState, slot: int, orig: int) {
        frame.ip = orig + 1;
        rt_name: str = "";
        if slot < len(frame.func.locals) {
            rt_name = frame.func.locals[slot];
        }
        rt_exc: JSValue = make_reference_error(
            "Cannot access '" + rt_name + "' before initialization"
        );
        if not self._unwind_in_frame(frame, rt_exc) {
            self.had_exception = True;
            self.pending_exc = rt_exc;
            st.running = False;
        }
    }

    """Throw `exc` from the register instruction derived from `orig`."""
    def _reg_throw(frame: CallFrame, st: ExecState, exc: JSValue, orig: int) {
        frame.ip = orig + 1;
        if not self._unwind_in_frame(frame, exc) {
            self.had_exception = True;
            self.pending_exc = exc;
            st.running = False;
        }
    }

    """After a bridged stack handler: 1 = it unwound into a handler of this
    frame (continue at frame.ip), 2 = the loop must stop, 0 = completed —
    its `npush` results are popped into regs[dst ..] and the operand stack
    is back at the frame's base."""
    def _reg_bridge_done(
        frame: CallFrame, st: ExecState, dst: int, npush: int, orig: int
    ) -> int {
        if self.reg_unwound {
            return 1;
        }
        if not st.running {
            return 2;
        }
        if _REG_VERIFY == 1 and len(self.stack) != frame.stack_base + npush {
            rv_msg: str = "[regisa verify] "
                + frame.func.name
                + " "
                + opcode_name(frame.func.code[orig].opcode)
                + ": "
                + str(len(self.stack) - frame.stack_base)
                + " values on the stack, expected "
                + str(npush)
                + "\n";
            write(2, rv_msg, len(rv_msg));
        }
        bd_k: int = npush - 1;
        while bd_k >= 0 and len(self.stack) > frame.stack_base {
            frame.locals[frame.lb + (dst + bd_k)] = self.stack.pop();
            bd_k = bd_k - 1;
        }
        while len(self.stack) > frame.stack_base {
            self.stack.pop();
        }
        return 0;
    }

    """Run the stack handler of code[orig] on up to three operand values
    (pushed in order); see _reg_bridge_done for the result."""
    def _reg_bridge(
        frame: CallFrame,
        st: ExecState,
        orig: int,
        n: int,
        v1: JSValue,
        v2: JSValue,
        v3: JSValue,
        dst: int,
        npush: int
    ) -> int {
        frame.ip = orig + 1;
        if n >= 1 {
            self.stack.append(v1);
        }
        if n >= 2 {
            self.stack.append(v2);
        }
        if n >= 3 {
            self.stack.append(v3);
        }
        self.reg_unwound = False;
        if _REG_STATS_ON == 1 {
            _reg_stat_bump(opcode_to_int(frame.func.code[orig].opcode));
            if n >= 1 {
                _reg_stat_kind(opcode_to_int(frame.func.code[orig].opcode), v1);
            }
            if frame.func.code[orig].opcode == Opcode.GET_PROP {
                _reg_stat_name(
                    _REG_BRIDGE_GPKEYS,
                    frame.func.constants.get(frame.func.code[orig].arg)
                        + " @"
                        + _reg_stat_recv_kind(v1)
                );
            }
            if n >= 2
                and (
                    frame.func.code[orig].opcode == Opcode.GET_INDEX
                    or frame.func.code[orig].opcode == Opcode.SET_INDEX
                ) {
                _reg_stat_name(
                    _REG_BRIDGE_IDX,
                    opcode_name(frame.func.code[orig].opcode)
                        + " "
                        + _reg_stat_recv_kind(v1)
                        + "["
                        + _reg_stat_key_kind(v2)
                        + "]"
                );
            }
        }
        _vm_dispatch_d(
            self,
            frame,
            frame.func.code[orig],
            st,
            opcode_to_int(frame.func.code[orig].opcode)
        );
        return self._reg_bridge_done(frame, st, dst, npush, orig);
    }

    """R_STK: the stack handler of code[orig] on registers [base, base+npop)."""
    def _reg_bridge_range(
        frame: CallFrame, st: ExecState, orig: int, base: int, npop: int, npush: int
    ) -> int {
        frame.ip = orig + 1;
        br_k: int = 0;
        while br_k < npop {
            self.stack.append(frame.locals[frame.lb + (base + br_k)]);
            br_k = br_k + 1;
        }
        self.reg_unwound = False;
        if _REG_STATS_ON == 1 {
            _reg_stat_bump(opcode_to_int(frame.func.code[orig].opcode));
            if npop >= 1 {
                _reg_stat_kind(
                    opcode_to_int(frame.func.code[orig].opcode),
                    frame.locals[frame.lb + (base)]
                );
            }
            if npop >= 1 {
                _reg_stat_name(
                    _REG_BRIDGE_IDX,
                    "STK "
                        + opcode_name(frame.func.code[orig].opcode)
                        + " "
                        + _reg_stat_recv_kind(frame.locals[frame.lb + (base)])
                );
            } else {
                _reg_stat_name(
                    _REG_BRIDGE_IDX, "STK " + opcode_name(frame.func.code[orig].opcode)
                );
            }
        }
        _vm_dispatch_d(
            self,
            frame,
            frame.func.code[orig],
            st,
            opcode_to_int(frame.func.code[orig].opcode)
        );
        return self._reg_bridge_done(frame, st, base, npush, orig);
    }

    """R_LOADGLOBAL: the LOAD_GLOBAL handler's ordinary-name fast path in
    place, else the handler."""
    def _reg_load_global(frame: CallFrame, st: ExecState, dst: int, orig: int) -> int {
        if global_obj_epoch() != self.global_obj_seen_epoch {
            self._sync_globals_from_object();
        }
        if frame.func.code[orig].ic_epoch == 1
            and len(self.eval_scope_frames) == 0
            and len(self.global_lexical) == 0
            and self._frame_ctx_global(frame) == 0 {
            # Per-site cache: the value read while no global was written since.
            if frame.func.code[orig].ic_holder == 1
                and frame.func.code[orig].ic_ver == self.gw_epoch {
                frame.locals[frame.lb + (dst)] = frame.func.code[orig].ic_obj;
                return 0;
            }
            lg_v: JSValue = self.globals.get(
                frame.func.constants.get(frame.func.code[orig].arg), jsv_hole()
            );
            if not jsv_is_hole(lg_v) and not js_is_tdz(lg_v) {
                frame.func.code[orig].ic_obj = lg_v;
                frame.func.code[orig].ic_ver = self.gw_epoch;
                frame.func.code[orig].ic_holder = 1;
                frame.locals[frame.lb + (dst)] = lg_v;
                return 0;
            }
            # A name bound only on the global object (`globalThis.x = …`):
            # its own data slot, cached while neither the globals map nor
            # the global object changed (holder 2, both epochs in ic_ver).
            if jsv_is_hole(lg_v) {
                lg_ge: int = global_obj_epoch() * 4294967296
                    + (self.gw_epoch & 4294967295);
                if frame.func.code[orig].ic_holder == 2
                    and frame.func.code[orig].ic_ver == lg_ge {
                    frame.locals[frame.lb + (dst)] = frame.func.code[orig].ic_obj;
                    return 0;
                }
                lg_kid: int = str_intern(
                    frame.func.constants.get(frame.func.code[orig].arg)
                );
                if js_object_has_own(self.global_this, lg_kid)
                    and jsv_is_undefined(
                        js_object_get_own_accessor_getter(self.global_this, lg_kid)
                    )
                    and jsv_is_undefined(
                        js_object_get_own_accessor_setter(self.global_this, lg_kid)
                    ) {
                    lg_gv: JSValue = js_object_get(self.global_this, lg_kid);
                    frame.func.code[orig].ic_obj = lg_gv;
                    frame.func.code[orig].ic_ver = lg_ge;
                    frame.func.code[orig].ic_holder = 2;
                    frame.locals[frame.lb + (dst)] = lg_gv;
                    return 0;
                }
            }
        }
        return self._reg_bridge(frame, st, orig, 0, 0, 0, 0, dst, 1);
    }

    """R_ITERNEXT through the ITER_NEXT handler: 1 = a value (in regs[dst]),
    0 = done (branch), 2 = unwound / stopped."""
    def _reg_iternext_slow(
        frame: CallFrame, st: ExecState, dst: int, iter_reg: int, orig: int
    ) -> int {
        frame.ip = orig + 1;
        # The handler's generator branch (V4.18): one raw step, no result object.
        if jsv_is_object_cell(frame.locals[frame.lb + (iter_reg)]) {
            ig_g: JSValue = js_object_get(frame.locals[frame.lb + (iter_reg)], WK_GEN);
            if jsv_is_object_cell(ig_g) and js_is_generator(ig_g) {
                self.gen_raw = True;
                self.gen_raw_hit = False;
                ig_r: JSValue = self.run_generator(ig_g, js_undefined(), False, False);
                self.gen_raw = False;
                if self.had_exception or vm_has_native_exc() {
                    # IteratorStep's abrupt completion propagates out of the for-of
                    self.gen_raw_hit = False;
                    ig_exc: JSValue = self.pending_exc;
                    if vm_has_native_exc() {
                        ig_exc = vm_take_native_exc();
                    }
                    self.had_exception = False;
                    self.pending_exc = js_undefined();
                    self._reg_throw(frame, st, ig_exc, orig);
                    return 2;
                }
                if self.gen_raw_hit {
                    self.gen_raw_hit = False;
                    if self.gen_raw_done {
                        return 0;
                    }
                    frame.locals[frame.lb + (dst)] = ig_r;
                    return 1;
                }
                if jsv_to_bool(js_object_get(ig_r, WK_DONE)) {
                    return 0;
                }
                frame.locals[frame.lb + (dst)] = js_object_get(ig_r, WK_VALUE);
                return 1;
            }
        }
        self.stack.append(frame.locals[frame.lb + (iter_reg)]);
        self.reg_unwound = False;
        if _REG_STATS_ON == 1 {
            _reg_stat_bump(23);
        }
        _vm_dispatch_d(
            self,
            frame,
            frame.func.code[orig],
            st,
            opcode_to_int(frame.func.code[orig].opcode)
        );
        if self.reg_unwound or not st.running {
            return 2;
        }
        in_res: int = 0;
        if len(self.stack) > frame.stack_base {
            in_flag: JSValue = self.stack.pop();
            if jsv_to_bool(in_flag) and len(self.stack) > frame.stack_base {
                frame.locals[frame.lb + (dst)] = self.stack.pop();
                in_res = 1;
            }
        }
        while len(self.stack) > frame.stack_base {
            self.stack.pop();
        }
        return in_res;
    }

    """The current CommonJS `exports` global (undefined when unbound), read
    once per gw_epoch (V4.22)."""
    def _reg_cur_exports -> JSValue {
        if self.cur_exp_epoch != self.gw_epoch {
            self.cur_exp_val = self.globals.get("exports", js_undefined());
            self.cur_exp_epoch = self.gw_epoch;
        }
        return self.cur_exp_val;
    }

    """The current CommonJS `module` global (undefined when unbound), read
    once per gw_epoch."""
    def _reg_cur_module -> JSValue {
        if self.cur_mod_epoch != self.gw_epoch {
            self.cur_mod_val = self.globals.get("module", js_undefined());
            self.cur_mod_epoch = self.gw_epoch;
        }
        return self.cur_mod_val;
    }

    """An in-loop callee from another CommonJS module: swap in its
    module / exports globals (run_cl's _push_cjs_module_context), the
    caller's values kept in the callee frame for the pop paths."""
    def _reg_mod_swap_enter(fr: CallFrame, mod: JSValue) {
        fr.saved_mod = self.globals.get("module", js_undefined());
        fr.saved_exp = self.globals.get("exports", js_undefined());
        fr.mod_swapped = True;
        fr.rare = True;
        _push_cjs_module_context(self, mod);
    }

    """Undo _reg_mod_swap_enter when its frame is popped (return, tail
    replacement, unwind)."""
    def _reg_mod_restore(fr: CallFrame) {
        self.globals["module"] = fr.saved_mod;
        self.gw_epoch = self.gw_epoch + 1;
        self.globals["exports"] = fr.saved_exp;
        self.gw_epoch = self.gw_epoch + 1;
        fr.mod_swapped = False;
        fr.saved_mod = 0;
        fr.saved_exp = 0;
    }

    """_reg_call_enter_cl's rare argument work: the rest parameter's array and
    a strict function's (unmapped) arguments object, from the arguments in
    whichever form argpc names (argument words / -1 list / contiguous)."""
    def _reg_enter_rest_args(
        cl: JSClosure,
        frame: CallFrame,
        rc_base: int,
        argpc: int,
        argc: int,
        cv: JSValue
    ) {
        ra_all: list[JSValue] = [];
        if argc == -1 {
            ra_all.append(self.reg_arg1);
        }
        ra_k: int = 0;
        while ra_k < argc {
            if argpc >= 0 {
                ra_all.append(
                    frame.locals[frame.lb + (frame.func.rcode[argpc + ra_k] & 32767)]
                );
            } elif argpc == -1 {
                ra_all.append(self.reg_call_args[ra_k]);
            } else {
                ra_all.append(frame.locals[frame.lb + (0 - argpc - 2 + ra_k)]);
            }
            ra_k = ra_k + 1;
        }
        ra_np: int = len(cl.func.params);
        if cl.func.has_rest and ra_np > 0 and argc >= 0 {
            ra_items: list[JSValue] = [];
            ra_k = ra_np - 1;
            while ra_k < len(ra_all) {
                ra_items.append(ra_all[ra_k]);
                ra_k = ra_k + 1;
            }
            self.regs[rc_base + cl.func.param_base + ra_np - 1] = js_array_create(
                ra_items
            );
        }
        if cl.func.arguments_slot >= 0 {
            self.regs[rc_base + cl.func.arguments_slot] = self._build_arguments(
                ra_all, cv, cl.func, self.regs
            );
        }
    }

    """R_CALL / R_CALLM: enter a register-ISA closure in this loop (the
    same eligibility as _inline_this, minus the stack loop's gate). The
    arguments are the caller registers listed in the `argc` words at
    rcode[argpc..]. 0 = not inlinable here (take the stack handler), 1 =
    entered (the frame stack changed), 2 = a TDZ check threw."""
    def _reg_call_enter(
        frame: CallFrame,
        st: ExecState,
        cv: JSValue,
        this_val: JSValue,
        dst: int,
        argpc: int,
        argc: int,
        orig: int,
        resume_pc: int
    ) -> int {
        if _INLINE_CALLS_ON == 0 {
            return 0;
        }
        rc_idx: int = get_fn_idx(cv);
        if rc_idx < 0 or rc_idx >= len(self.realm.closures) {
            return 0;
        }
        # The closure goes in as a borrowed list element (no local, so no
        # retain/release per call — the same reason _op_call passes it so).
        return self._reg_call_enter_cl(
            self.realm.closures[rc_idx],
            frame,
            st,
            cv,
            this_val,
            dst,
            argpc,
            argc,
            orig,
            resume_pc
        );
    }

    def _reg_call_enter_cl(
        cl: JSClosure,
        frame: CallFrame,
        st: ExecState,
        cv: JSValue,
        this_val: JSValue,
        dst: int,
        argpc: int,
        argc: int,
        orig: int,
        resume_pc: int
    ) -> int {
        if cl.napi_cb_ptr != 0 or not self._reg_ready(cl.func) {
            return 0;
        }
        if cl.func.is_generator or cl.func.is_async or cl.func.is_bound {
            return 0;
        }
        # (a strict function's arguments object is unmapped: built below)
        if cl.func.arguments_slot >= 0 and not cl.func.is_strict {
            return 0;
        }
        if len(cl.captured_with_objs) > 0 {
            return 0;
        }
        if cl.this_binding_cell != 0 {
            return 0;
        }
        if self.call_depth + 1 > VM_MAX_CALL_DEPTH {
            return 0;
        }
        rc_this: JSValue = this_val;
        if not jsv_is_undefined(cl.lexical_this) {
            rc_this = cl.lexical_this;
        } elif not cl.func.is_strict {
            if jsv_is_null(rc_this) or jsv_is_undefined(rc_this) {
                rc_this = self._sloppy_this_for(cl.func);
            } elif not jsv_is_any_object(rc_this) {
                return 0;
            }
        }
        rc_swap: bool = jsv_is_object_cell(cl.jac_module)
            and not (cl.jac_module == self._reg_cur_module());
        # TDZ checks of flagged argument registers, left to right (the stack
        # code checked each where it loaded it; nothing observable runs in
        # between).
        rc_k: int = 0;
        if argpc >= 0 {
            while rc_k < argc {
                rc_w: int = frame.func.rcode[argpc + rc_k];
                if (rc_w & 32768) != 0
                    and js_is_tdz(frame.locals[frame.lb + (rc_w & 32767)]) {
                    self._reg_tdz_throw(frame, st, rc_w & 32767, orig);
                    return 2;
                }
                rc_k = rc_k + 1;
            }
        }
        np: int = len(cl.func.params);
        pb: int = cl.func.param_base;
        # The callee's registers: a window pushed on the register file.
        rc_base: int = self._win_alloc(cl.func.num_locals, cl.func.reg_tmp_base);
        if argc == -1 and np > 0 {
            self.regs[rc_base + pb] = self.reg_arg1;
        }
        rc_k = 0;
        if argpc >= 0 {
            while rc_k < np and rc_k < argc {
                self.regs[rc_base + pb + rc_k] = frame.locals[
                    frame.lb + (frame.func.rcode[argpc + rc_k] & 32767)
                ];
                rc_k = rc_k + 1;
            }
        } elif argpc == -1 {
            # list mode: self.reg_call_args
            while rc_k < np and rc_k < argc {
                self.regs[rc_base + pb + rc_k] = self.reg_call_args[rc_k];
                rc_k = rc_k + 1;
            }
        } else {
            # contiguous argument registers from -(argpc + 2) (R_STK words)
            while rc_k < np and rc_k < argc {
                self.regs[rc_base + pb + rc_k] = frame.locals[
                    frame.lb + (0 - argpc - 2 + rc_k)
                ];
                rc_k = rc_k + 1;
            }
        }
        if (cl.func.has_rest and np > 0 and argc >= 0) or cl.func.arguments_slot >= 0 {
            self._reg_enter_rest_args(cl, frame, rc_base, argpc, argc, cv);
        }
        if len(self.frame_pool) == 0 {
            # Cold: no pooled frame — the general helpers allocate one.
            frame.rpc = resume_pc;
            frame.ip = orig + 1;
            self._inline_enter(cl, cv, rc_this, self.regs, st);
            st.frame_switched = False;
            rc_top: int = len(self.frames) - 1;
            self.frames[rc_top].ret_reg = dst;
            self.frames[rc_top].rpc = 0;
            self.frames[rc_top].discard_ret = False;
            self.frames[rc_top].win = True;
            self.frames[rc_top].lb = rc_base;
            if rc_swap {
                self._reg_mod_swap_enter(self.frames[rc_top], cl.jac_module);
            }
            return 1;
        }
        # The top pooled frame, filled in place (pointer fields written only
        # when they change): a loop calling the same function gets the same
        # frame back.
        fr: CallFrame = self.frame_pool[len(self.frame_pool) - 1];
        del self.frame_pool[len(self.frame_pool) - 1];
        self.frames.append(fr);
        if fr.locals is not self.regs {
            fr.locals = self.regs;
        }
        fr.win = True;
        fr.lb = rc_base;
        if fr.func is not cl.func {
            fr.func = cl.func;
        }
        if fr.free_vals is not cl.free_vals {
            fr.free_vals = cl.free_vals;
        }
        fr.ip = 0;
        fr.rpc = 0;
        fr.ret_reg = dst;
        fr.stack_base = len(self.stack);
        fr.this_val = rc_this;
        fr.self_fn = cv;
        ic_nt: JSValue = self._pending_new_target;
        if jsv_is_undefined(ic_nt) {
            ic_nt = self.pending_new_target;
        }
        if cl.is_arrow {
            ic_nt = cl.lexical_new_target;
        }
        self._pending_new_target = js_undefined();
        self.pending_new_target = js_undefined();
        fr.new_target = ic_nt;
        fr.this_uninitialized = self._pending_this_uninit;
        self._pending_this_uninit = False;
        fr.ctor_class = self._pending_ctor_class;
        self._pending_ctor_class = 0;
        fr.with_inherited = 0;
        fr.this_binding_cell = 0;
        fr.discard_ret = False;
        fr.ctor_this = 0;
        if fr.rare {
            while len(fr.catch_stack) > 0 {
                fr.catch_stack.pop();
            }
            while len(fr.with_objs) > 0 {
                fr.with_objs.pop();
            }
            while len(fr.catch_with_depths) > 0 {
                fr.catch_with_depths.pop();
            }
            while len(fr.dispose_stack) > 0 {
                fr.dispose_stack.pop();
            }
            while len(fr.dispose_async) > 0 {
                fr.dispose_async.pop();
            }
            while len(fr.dispose_methods) > 0 {
                fr.dispose_methods.pop();
            }
            while len(fr.dispose_marks) > 0 {
                fr.dispose_marks.pop();
            }
            while len(fr.catch_dispose_depths) > 0 {
                fr.catch_dispose_depths.pop();
            }
            while len(fr.dyn_var_names) > 0 {
                del fr.dyn_var_names[len(fr.dyn_var_names) - 1];
            }
            while len(fr.dyn_var_vals) > 0 {
                fr.dyn_var_vals.pop();
            }
            while len(fr.native_roots) > 0 {
                fr.native_roots.pop();
            }
            fr.rare = False;
        }
        if fr.caller_module_fns is not self.module_fns {
            fr.caller_module_fns = self.module_fns;
        }
        if len(cl.module_fns) > 0 and self.module_fns is not cl.module_fns {
            self.module_fns = cl.module_fns;
        }
        frame.rpc = resume_pc;
        frame.ip = orig + 1;
        self.call_depth = self.call_depth + 1;
        st.inline_depth = st.inline_depth + 1;
        if _PAIR_STATS_ON {
            _inline_count_bump();
        }
        if rc_swap {
            self._reg_mod_swap_enter(fr, cl.jac_module);
        }
        return 1;
    }

    """R_CALL / R_CALLM through the stack handler of code[orig] (natives,
    bound / proxy / generator callees, spread, `with`, stack-ISA callees):
    pushes the callee, the receiver (CALLM, this_reg >= 0) and the
    arguments from their registers, TDZ-checking the arguments first."""
    def _reg_bridge_call(
        frame: CallFrame,
        st: ExecState,
        orig: int,
        dst: int,
        callee_reg: int,
        this_reg: int,
        argpc: int,
        argc: int
    ) -> int {
        return self._reg_bridge_call_op(
            frame,
            st,
            orig,
            dst,
            callee_reg,
            this_reg,
            argpc,
            argc,
            opcode_to_int(frame.func.code[orig].opcode)
        );
    }

    """_reg_bridge_call dispatching on handler `dop` (R_TAILCALL runs the
    CALL handler on its TAIL_CALL instruction: same operand layout)."""
    def _reg_bridge_call_op(
        frame: CallFrame,
        st: ExecState,
        orig: int,
        dst: int,
        callee_reg: int,
        this_reg: int,
        argpc: int,
        argc: int,
        dop: int
    ) -> int {
        bc_k: int = 0;
        while bc_k < argc {
            bc_w: int = frame.func.rcode[argpc + bc_k];
            if (bc_w & 32768) != 0
                and js_is_tdz(frame.locals[frame.lb + (bc_w & 32767)]) {
                self._reg_tdz_throw(frame, st, bc_w & 32767, orig);
                return 2;
            }
            bc_k = bc_k + 1;
        }
        frame.ip = orig + 1;
        self.stack.append(frame.locals[frame.lb + (callee_reg)]);
        if this_reg >= 0 {
            self.stack.append(frame.locals[frame.lb + (this_reg)]);
        }
        bc_k = 0;
        while bc_k < argc {
            self.stack.append(
                frame.locals[frame.lb + (frame.func.rcode[argpc + bc_k] & 32767)]
            );
            bc_k = bc_k + 1;
        }
        self.reg_unwound = False;
        if _REG_STATS_ON == 1 {
            _reg_stat_bump(dop);
            _reg_stat_kind(dop, frame.locals[frame.lb + (callee_reg)]);
            if is_fn_val(frame.locals[frame.lb + (callee_reg)])
                and get_fn_idx(frame.locals[frame.lb + (callee_reg)])
                    < len(self.realm.closures) {
                _reg_stat_name(
                    _REG_BRIDGE_FNS,
                    self.realm.closures[
                        get_fn_idx(frame.locals[frame.lb + (callee_reg)])
                    ].func.name
                );
            }
            if dop == opcode_to_int(Opcode.NEW) {
                _reg_stat_name(
                    _REG_BRIDGE_IDX,
                    "NEW " + _reg_stat_new_reason(frame.locals[frame.lb + (callee_reg)])
                );
            }
        }
        _vm_dispatch_d(self, frame, frame.func.code[orig], st, dop);
        return self._reg_bridge_done(frame, st, dst, 1, orig);
    }

    """R_CALLM of %Function.prototype.call% on a closure receiver:
    `fn.call(t, args...)` enters `fn` in-loop with this = t and the remaining
    argument registers (0 = the handler takes it: bound functions, a
    TDZ-flagged `t`, whatever _reg_call_enter_cl declines)."""
    def _reg_fn_call_enter(
        frame: CallFrame,
        st: ExecState,
        fnv: JSValue,
        dst: int,
        argpc: int,
        argc: int,
        orig: int,
        resume_pc: int
    ) -> int {
        fc_this: JSValue = js_undefined();
        fc_ap: int = argpc;
        fc_ac: int = argc;
        if argc >= 1 {
            fc_w: int = frame.func.rcode[argpc];
            if (fc_w & 32768) != 0
                and js_is_tdz(frame.locals[frame.lb + (fc_w & 32767)]) {
                return 0;
            }
            fc_this = frame.locals[frame.lb + (fc_w & 32767)];
            fc_ap = argpc + 1;
            fc_ac = argc - 1;
        }
        return self._reg_call_enter(
            frame, st, fnv, fc_this, dst, fc_ap, fc_ac, orig, resume_pc
        );
    }

    """R_CALLM on a whitelisted builtin (see _NATIVE_FAST_KIND): the stack
    loop's _native_fast_call on registers — the receiver `this_val`, the
    `argc` argument registers at rcode[argpc..], the result in regs[dst].
    False with nothing done when the call does not qualify (the handler
    takes it, including any TDZ throw)."""
    def _reg_native_fast_call(
        frame: CallFrame,
        st: ExecState,
        dst: int,
        meth: JSValue,
        this_val: JSValue,
        argpc: int,
        argc: int,
        orig: int
    ) -> bool {
        rn_kind: int = get_native_kind(meth);
        if rn_kind < 0 or rn_kind >= len(_NATIVE_FAST_KIND) {
            return False;
        }
        rn_mode: int = _NATIVE_FAST_KIND[rn_kind];
        if rn_mode == 0 {
            return False;
        }
        # A whitelisted native whose shared-list fast precondition fails is
        # still none of the handlers' special kinds: the generic call (7).
        if rn_mode == 1 and not jsv_is_string_cell(this_val) {
            rn_mode = 7;
        }
        if rn_mode == 5 and argc > 1 {
            rn_mode = 7;
        }
        if rn_mode == 4
            and not (
                js_is_array(this_val)
                and js_object_class_id_id(jsv_to_table_id(this_val)) == 0
                and idx_protector_ok()
            ) {
            rn_mode = 7;
        }
        rn_k: int = 0;
        while rn_k < argc {
            rn_w: int = frame.func.rcode[argpc + rn_k];
            if (rn_w & 32768) != 0
                and js_is_tdz(frame.locals[frame.lb + (rn_w & 32767)]) {
                return False;
            }
            if rn_mode <= 2
                and not _vm_simple_prim(frame.locals[frame.lb + (rn_w & 32767)]) {
                rn_mode = 7;
            }
            rn_k = rn_k + 1;
        }
        rn_res: JSValue = js_undefined();
        if rn_mode >= 6 {
            rn_fresh: list[JSValue] = [];
            rn_k = 0;
            while rn_k < argc {
                rn_fresh.append(
                    frame.locals[frame.lb + (frame.func.rcode[argpc + rn_k] & 32767)]
                );
                rn_k = rn_k + 1;
            }
            # Root receiver + arguments in the frame as the handlers' generic
            # branch does (until this frame's next such call): natives that
            # keep a callback without pinning it rely on it (fs async ops —
            # a collected callback's reused closure slot was called again).
            while len(frame.native_roots) > 0 {
                frame.native_roots.pop();
            }
            if frame.func.code[orig].opcode == Opcode.CALL_METHOD {
                frame.native_roots.append(this_val);
            }
            rn_k = 0;
            while rn_k < argc {
                frame.native_roots.append(rn_fresh[rn_k]);
                rn_k = rn_k + 1;
            }
            frame.rare = True;
            frame.ip = orig + 1;
            self.reg_unwound = False;
            rn_res = _vm_call_native_proxy_aware(
                self, self.realm, rn_kind, this_val, rn_fresh
            );
        } else {
            while len(_NF_ARGS) > 0 {
                _NF_ARGS.pop();
            }
            rn_k = 0;
            while rn_k < argc {
                _NF_ARGS.append(
                    frame.locals[frame.lb + (frame.func.rcode[argpc + rn_k] & 32767)]
                );
                rn_k = rn_k + 1;
            }
            frame.ip = orig + 1;
            self.reg_unwound = False;
            rn_res = _vm_call_native_proxy_aware(
                self, self.realm, rn_kind, this_val, _NF_ARGS
            );
        }
        if not self._check_native_exc(frame, rn_res) {
            st.running = False;
            return True;
        }
        if self.reg_unwound {
            return True;
        }
        if len(self.stack) > frame.stack_base {
            frame.locals[frame.lb + (dst)] = self.stack.pop();
        } else {
            frame.locals[frame.lb + (dst)] = js_undefined();
        }
        # (the CALL_METHOD generic branch drains pending stream callbacks)
        if rn_mode == 7 and frame.func.code[orig].opcode == Opcode.CALL_METHOD {
            self._drain_stream_pending();
        }
        return True;
    }

    """_inline_this's eligibility for a register-ISA callee without the stack
    loop's gates (the callee runs in a register loop, in-loop or nested):
    the effective `this`, or the hole when the general call path must take
    it."""
    def _reg_eff_this(cl: JSClosure, cl_val: JSValue, this_val: JSValue) -> JSValue {
        if not self._reg_ready(cl.func) {
            return jsv_hole();
        }
        if cl.func.is_generator or cl.func.is_async or cl.func.is_bound {
            return jsv_hole();
        }
        if cl.func.arguments_slot >= 0 {
            return jsv_hole();
        }
        if len(cl.captured_with_objs) > 0 {
            return jsv_hole();
        }
        if cl.this_binding_cell != 0 {
            return jsv_hole();
        }
        if self.call_depth + 1 > VM_MAX_CALL_DEPTH {
            return jsv_hole();
        }
        re_this: JSValue = this_val;
        if not jsv_is_undefined(cl.lexical_this) {
            re_this = cl.lexical_this;
        } elif not cl.func.is_strict {
            if jsv_is_null(re_this) or jsv_is_undefined(re_this) {
                re_this = self._sloppy_this_for(cl.func);
            } elif not jsv_is_any_object(re_this) {
                return jsv_hole();
            }
        }
        if jsv_is_object_cell(cl.jac_module)
            and not (cl.jac_module == self._reg_cur_module()) {
            return jsv_hole();
        }
        return re_this;
    }

    """R_TAILCALL from an in-loop register frame: the callee's frame
    replaces the current one (frame count flat, as _op_tail_call keeps it
    for stack frames), inheriting the ret_reg the caller waits on. 0 = not
    possible here (make an ordinary call), 1 = entered, 2 = a TDZ check
    threw."""
    def _reg_tail_enter(
        frame: CallFrame, st: ExecState, cv: JSValue, argpc: int, argc: int, orig: int
    ) -> int {
        if _INLINE_CALLS_ON == 0 {
            return 0;
        }
        rt_idx: int = get_fn_idx(cv);
        if rt_idx < 0 or rt_idx >= len(self.realm.closures) {
            return 0;
        }
        return self._reg_tail_enter_cl(
            self.realm.closures[rt_idx], frame, st, cv, argpc, argc, orig
        );
    }

    def _reg_tail_enter_cl(
        cl: JSClosure,
        frame: CallFrame,
        st: ExecState,
        cv: JSValue,
        argpc: int,
        argc: int,
        orig: int
    ) -> int {
        if cl.napi_cb_ptr != 0 {
            return 0;
        }
        rt_this: JSValue = self._reg_eff_this(cl, cv, js_undefined());
        if jsv_is_hole(rt_this) {
            return 0;
        }
        rt_k: int = 0;
        while rt_k < argc {
            rt_w: int = frame.func.rcode[argpc + rt_k];
            if (rt_w & 32768) != 0
                and js_is_tdz(frame.locals[frame.lb + (rt_w & 32767)]) {
                self._reg_tdz_throw(frame, st, rt_w & 32767, orig);
                return 2;
            }
            rt_k = rt_k + 1;
        }
        # The arguments, copied out before the frame they live in is recycled.
        while len(_REG_TAIL_ARGS) > 0 {
            _REG_TAIL_ARGS.pop();
        }
        rt_k = 0;
        while rt_k < argc {
            _REG_TAIL_ARGS.append(
                frame.locals[frame.lb + (frame.func.rcode[argpc + rt_k] & 32767)]
            );
            rt_k = rt_k + 1;
        }
        rt_dst: int = frame.ret_reg;
        rt_ctor: JSValue = frame.ctor_this;
        frame.ctor_this = 0;
        # Pop the current inline frame (as _inline_tail_pop does).
        rt_top: int = len(self.frames) - 1;
        if self.module_fns is not frame.caller_module_fns {
            self.module_fns = frame.caller_module_fns;
        }
        while len(self.stack) > frame.stack_base {
            self.stack.pop();
        }
        frame.ip = 0;
        if frame.win {
            self.rtop = frame.lb;
        }
        if frame.mod_swapped {
            self._reg_mod_restore(frame);
        }
        if len(self.frame_pool) < _FRAME_POOL_MAX {
            self.frame_pool.append(frame);
        }
        del self.frames[rt_top];
        st.inline_depth = st.inline_depth - 1;
        self.call_depth = self.call_depth - 1;
        # Enter the callee in its place (its window where the popped one was).
        rt_base: int = self._win_alloc(cl.func.num_locals, cl.func.reg_tmp_base);
        rt_np: int = len(cl.func.params);
        rt_pb: int = cl.func.param_base;
        rt_k = 0;
        while rt_k < rt_np and rt_k < argc {
            self.regs[rt_base + rt_pb + rt_k] = _REG_TAIL_ARGS[rt_k];
            rt_k = rt_k + 1;
        }
        if cl.func.has_rest and rt_np > 0 {
            rt_items: list[JSValue] = [];
            rt_k = rt_np - 1;
            while rt_k < argc {
                rt_items.append(_REG_TAIL_ARGS[rt_k]);
                rt_k = rt_k + 1;
            }
            self.regs[rt_base + rt_pb + rt_np - 1] = js_array_create(rt_items);
        }
        self._inline_enter(cl, cv, rt_this, self.regs, st);
        st.frame_switched = False;
        rt_nt: int = len(self.frames) - 1;
        self.frames[rt_nt].ret_reg = rt_dst;
        self.frames[rt_nt].rpc = 0;
        self.frames[rt_nt].discard_ret = False;
        self.frames[rt_nt].ctor_this = rt_ctor;
        self.frames[rt_nt].win = True;
        self.frames[rt_nt].lb = rt_base;
        return 1;
    }

    """R_NEW: [[Construct]] of a plain function constructor that is a
    register-ISA closure, in this loop: the object is created here (its
    prototype from ctor.prototype, else %Object.prototype%, as _op_new does),
    the frame is entered as a call on it with new.target = ctor, and the frame
    remembers the object (ctor_this) for the return rule. 0 = the NEW handler
    takes it (classes, natives, bound / NAPI / non-constructor callees, and
    whatever _reg_call_enter_cl declines), 1 = entered, 2 = a TDZ check
    threw."""
    def _reg_new_enter(
        frame: CallFrame,
        st: ExecState,
        cv: JSValue,
        dst: int,
        argpc: int,
        argc: int,
        orig: int,
        resume_pc: int
    ) -> int {
        if _INLINE_CALLS_ON == 0 {
            return 0;
        }
        rn_idx: int = get_fn_idx(cv);
        if rn_idx < 0 or rn_idx >= len(self.realm.closures) {
            return 0;
        }
        return self._reg_new_enter_cl(
            self.realm.closures[rn_idx],
            frame,
            st,
            cv,
            dst,
            argpc,
            argc,
            orig,
            resume_pc
        );
    }

    """R_NEW on a class object (V4.7), _op_new's class branch for the cases it
    can run in this loop: 1 = a constructor frame entered, 3 = constructed in
    place (regs[dst] written), 2 = an exception was raised (TDZ argument, a
    field initializer), 0 = nothing done (the NEW handler takes it). Every
    check that could make the entry fail runs before any side effect."""
    def _reg_new_class_enter(
        frame: CallFrame,
        st: ExecState,
        cls: JSValue,
        dst: int,
        argpc: int,
        argc: int,
        orig: int,
        resume_pc: int
    ) -> int {
        if _INLINE_CALLS_ON == 0 {
            return 0;
        }
        nc_derived: bool = js_object_has_own(cls, WK_SUPER);
        nc_fn: JSValue = js_object_get(cls, WK_CTOR);
        nc_target: JSValue = nc_fn;
        nc_sup: JSValue = 0;
        if nc_derived {
            if is_fn_val(nc_fn) {
                if _fn_may_defer_super(self.realm.closures[get_fn_idx(nc_fn)].func) {
                    return 0;
                }
            } else {
                nc_sup = js_object_get(cls, WK_SUPER);
                if not (
                    jsv_is_object_cell(nc_sup)
                    and jsv_to_table_id(nc_sup) > 0
                    and js_object_has_own(nc_sup, WK_IS_CLASS)
                    and not js_object_has_own(nc_sup, KEY_CTOR_KIND)
                ) {
                    return 0;
                }
                nc_target = js_object_get(nc_sup, WK_CTOR);
                if not is_fn_val(nc_target) {
                    return 0;
                }
            }
        }
        if is_fn_val(nc_target) {
            if not self._reg_can_enter_cl(self.realm.closures[get_fn_idx(nc_target)]) {
                return 0;
            }
        }
        # TDZ-flagged arguments throw before anything runs (the stack code
        # checked them where it loaded them).
        nc_k: int = 0;
        while nc_k < argc {
            nc_w: int = frame.func.rcode[argpc + nc_k];
            if (nc_w & 32768) != 0
                and js_is_tdz(frame.locals[frame.lb + (nc_w & 32767)]) {
                self._reg_tdz_throw(frame, st, nc_w & 32767, orig);
                return 2;
            }
            nc_k = nc_k + 1;
        }
        nc_obj: JSValue = js_object_create(js_object_get(cls, WK_PROTOTYPE));
        frame.ip = orig + 1;
        if not nc_derived {
            if not self._reg_run_field_list(
                js_object_get(cls, WK_FIELDS), nc_obj, frame, st, orig
            ) {
                return 2;
            }
            if not is_fn_val(nc_fn) {
                frame.locals[frame.lb + (dst)] = nc_obj;
                return 3;
            }
            self._pending_new_target = cls;
            self.pending_new_target = cls;
            self._pending_ctor_class = cls;
        } elif is_fn_val(nc_fn) {
            self._pending_new_target = cls;
            self.pending_new_target = cls;
            self._pending_this_uninit = True;
            self._pending_ctor_class = cls;
        } else {
            if not self._run_class_own_fields(nc_sup, nc_obj, frame, st) {
                return 2;
            }
            if not st.running or self.had_exception {
                return 2;
            }
            # new.target stays the class being constructed (only this channel,
            # as _op_new sets it for the inherited constructor).
            self.pending_new_target = cls;
        }
        nc_r: int = self._reg_call_enter_cl(
            self.realm.closures[get_fn_idx(nc_target)],
            frame,
            st,
            nc_target,
            nc_obj,
            dst,
            argpc,
            argc,
            orig,
            resume_pc
        );
        if nc_r != 1 {
            self._pending_new_target = js_undefined();
            self.pending_new_target = js_undefined();
            self._pending_this_uninit = False;
            self._pending_ctor_class = 0;
            return 2;
        }
        nc_top: int = len(self.frames) - 1;
        self.frames[nc_top].ctor_this = nc_obj;
        if nc_derived and is_fn_val(nc_fn) {
            if jsv_is_undefined(_TDZ_SENTINEL) {
                _TDZ_SENTINEL = _js_tdz_create();
                gc_pin_value(_TDZ_SENTINEL);
            }
            self.frames[nc_top].this_binding_cell = make_cell(_TDZ_SENTINEL);
        } elif nc_derived and js_object_has_own(cls, WK_FIELDS) {
            self.frames[nc_top].post_fields = cls;
        }
        return 1;
    }

    """_reg_call_enter_cl's eligibility checks alone (no side effects), plus a
    lexical-this closure (an arrow is never a constructor)."""
    def _reg_can_enter_cl(cl: JSClosure) -> bool {
        if cl.napi_cb_ptr != 0 or not self._reg_ready(cl.func) {
            return False;
        }
        if cl.func.is_generator or cl.func.is_async or cl.func.is_bound {
            return False;
        }
        if cl.func.arguments_slot >= 0 and not cl.func.is_strict {
            return False;
        }
        if len(cl.captured_with_objs) > 0 {
            return False;
        }
        if cl.this_binding_cell != 0 {
            return False;
        }
        if not jsv_is_undefined(cl.lexical_this) {
            return False;
        }
        if self.call_depth + 1 > VM_MAX_CALL_DEPTH {
            return False;
        }
        return True;
    }

    """A base class's field initializers onto `obj` (_op_new's pre-ctor loop):
    False after an abrupt one, its exception thrown at `orig`."""
    def _reg_run_field_list(
        fields: JSValue, fobj: JSValue, frame: CallFrame, st: ExecState, orig: int
    ) -> bool {
        if not (jsv_is_object_cell(fields) and jsv_to_table_id(fields) >= 0) {
            return True;
        }
        rf_lv: JSValue = js_object_get(fields, WK_LENGTH);
        rf_n: int = 0;
        if jsv_is_int32(rf_lv) {
            rf_n = jsv_to_int32(rf_lv);
        }
        rf_i: int = 0;
        while rf_i < rf_n {
            if not self._run_one_field_init(
                js_object_get(fields, str_intern_index(rf_i)), fobj
            ) {
                rf_exc: JSValue = self.pending_exc;
                if vm_has_native_exc() {
                    rf_exc = vm_take_native_exc();
                }
                self.had_exception = False;
                self.pending_exc = js_undefined();
                self._reg_throw(frame, st, rf_exc, orig);
                return False;
            }
            rf_i = rf_i + 1;
        }
        return True;
    }

    """The value a suspended frame resumes with — a generator's next(v) send
    value, an await's settled value — delivered the way its ISA expects: a
    register frame gets it in the destination register of the YIELD / AWAIT
    word before frame.rpc (a first resume at rpc 0 has nothing to receive it;
    the stack loop simply leaves the pushed value unused), a stack frame gets
    it pushed on the operand stack."""
    def _reg_resume_value(frame: CallFrame, v: JSValue) -> None {
        if self._reg_ready(frame.func) {
            if frame.rpc > 0 {
                rv_w: int = frame.func.rcode[frame.rpc - 1];
                rv_op: int = rv_w & 255;
                if rv_op == 95 or rv_op == 96 or rv_op == 97 {
                    frame.locals[frame.lb + ((rv_w >> 8) & 65535)] = v;
                }
            }
            return;
        }
        self.stack.append(v);
    }

    """R_SETFIELD on a plain object (no IC hit): the ordinary [[Set]] in one
    pass (_op_set_prop's js_object_set_ordinary path) with the same IC fill,
    so the next store at this site hits. False when the handler must take it
    (setters, read-only or exotic chain members, non-plain receivers)."""
    def _reg_set_plain(
        frame: CallFrame, ins: Instruction, orig: int, so: JSValue, sv: JSValue
    ) -> bool {
        sp_sid0: int = js_object_ic_shape(so);
        if not js_object_set_ordinary(so, ins.arg3 >> 2, sv) {
            return False;
        }
        if sp_sid0 >= 0 {
            # The fill patches code[frame.ip - 1]: the originating SET_PROP.
            frame.ip = orig + 1;
            self._set_prop_ic_fill(
                frame, so, ins.arg3 >> 2, js_object_ic_shape(so) == sp_sid0, False
            );
        }
        return True;
    }

    def _reg_new_enter_cl(
        cl: JSClosure,
        frame: CallFrame,
        st: ExecState,
        cv: JSValue,
        dst: int,
        argpc: int,
        argc: int,
        orig: int,
        resume_pc: int
    ) -> int {
        if cl.napi_cb_ptr != 0
            or cl.is_arrow
            or cl.func.is_generator
            or cl.func.is_async
            or cl.func.is_method
            or cl.is_non_constructor
            or cl.func.is_bound
            or not self._reg_ready(cl.func) {
            return 0;
        }
        if not jsv_is_undefined(cl.lexical_this) {
            return 0;
        }
        if js_object_has_own(cl.fn_props, WK_NOT_CTOR) {
            return 0;
        }
        rn_proto: JSValue = cl.prototype_obj;
        if not (jsv_is_object_cell(rn_proto) and jsv_to_table_id(rn_proto) > 0) {
            rn_proto = js_object_get_ordinary_proto();
        }
        rn_obj: JSValue = js_object_create(rn_proto);
        self._pending_new_target = cv;
        self.pending_new_target = cv;
        rn_r: int = self._reg_call_enter_cl(
            cl, frame, st, cv, rn_obj, dst, argpc, argc, orig, resume_pc
        );
        if rn_r != 1 {
            self._pending_new_target = js_undefined();
            self.pending_new_target = js_undefined();
            return rn_r;
        }
        self.frames[len(self.frames) - 1].ctor_this = rn_obj;
        return 1;
    }

    """run_cl's register path: a register-ISA closure called from native
    code (callbacks, comparators, promise reactions) runs to completion in a
    nested register loop on a window frame — no locals list, no arguments
    object, run()'s construct-site bookkeeping skipped (a pending construct
    channel, a tail-calling or main function take run()). The result, or
    undefined with had_exception / pending_exc set; the hole when run() must
    take the call (nothing done)."""
    def _reg_run_value(
        cl: JSClosure, cl_val: JSValue, this_val: JSValue, args: list[JSValue]
    ) -> JSValue {
        if cl.napi_cb_ptr != 0 or cl.func.has_tail_call {
            return jsv_hole();
        }
        if cl.func.name == "<main>" {
            return jsv_hole();
        }
        rv_this: JSValue = self._reg_eff_this(cl, cl_val, this_val);
        if jsv_is_hole(rv_this) {
            return jsv_hole();
        }
        rv_np: int = len(cl.func.params);
        rv_pb: int = cl.func.param_base;
        rv_base: int = self._win_alloc(cl.func.num_locals, cl.func.reg_tmp_base);
        rv_k: int = 0;
        while rv_k < rv_np and rv_k < len(args) {
            self.regs[rv_base + rv_pb + rv_k] = args[rv_k];
            rv_k = rv_k + 1;
        }
        if cl.func.has_rest and rv_np > 0 {
            rv_items: list[JSValue] = [];
            rv_k = rv_np - 1;
            while rv_k < len(args) {
                rv_items.append(args[rv_k]);
                rv_k = rv_k + 1;
            }
            self.regs[rv_base + rv_pb + rv_np - 1] = js_array_create(rv_items);
        }
        # The construct channels, consumed as run() consumes them.
        rv_nt: JSValue = self._pending_new_target;
        if jsv_is_undefined(rv_nt) {
            rv_nt = self.pending_new_target;
        }
        if cl.is_arrow {
            rv_nt = cl.lexical_new_target;
        }
        self._pending_new_target = js_undefined();
        self.pending_new_target = js_undefined();
        rv_tui: bool = self._pending_this_uninit;
        self._pending_this_uninit = False;
        rv_ctc: JSValue = self._pending_ctor_class;
        self._pending_ctor_class = 0;
        rv_reuse: bool = len(self.frame_pool) > 0;
        rv_fr: CallFrame = self._frame_acquire(
            cl.func,
            len(self.stack),
            self.regs,
            cl.free_vals,
            rv_this,
            cl_val,
            rv_nt,
            rv_tui,
            rv_ctc,
            rv_reuse
        );
        rv_fr.rpc = 0;
        rv_fr.win = True;
        rv_fr.lb = rv_base;
        # A derived constructor's shared this-binding cell, TDZ until super().
        if rv_tui {
            if jsv_is_undefined(_TDZ_SENTINEL) {
                _TDZ_SENTINEL = _js_tdz_create();
                gc_pin_value(_TDZ_SENTINEL);
            }
            rv_fr.this_binding_cell = make_cell(_TDZ_SENTINEL);
        }
        rv_saved_mf: list[CompiledFunction] = self.module_fns;
        if len(cl.module_fns) > 0 {
            self.module_fns = cl.module_fns;
        }
        self.frames.append(rv_fr);
        self.call_depth = self.call_depth + 1;
        rv_res: JSValue = self._exec_reg(rv_fr);
        # run()'s derived-constructor return rules (this still uninitialized).
        if rv_tui or rv_fr.this_binding_cell != 0 {
            rv_tu_now: bool = rv_fr.this_uninitialized;
            if rv_fr.this_binding_cell != 0 {
                rv_tu_now = js_is_tdz(cell_get(rv_fr.this_binding_cell));
            }
            if rv_tu_now
                and not self.had_exception
                and not jsv_is_undefined(rv_res)
                and not jsv_is_any_object(rv_res)
                and not _fn_may_defer_super(cl.func) {
                self.had_exception = True;
                self.pending_exc = make_type_error(
                    "Derived constructors may only return object or undefined"
                );
            } elif rv_tu_now
                and not self.had_exception
                and not jsv_is_any_object(rv_res) {
                if not _fn_may_defer_super(cl.func) {
                    self.had_exception = True;
                    self.pending_exc = make_reference_error(
                        "Must call super constructor in derived class before accessing 'this' or returning from derived constructor"
                    );
                }
            }
        }
        if len(rv_fr.dispose_stack) > 0 {
            rv_se: bool = self.had_exception;
            rv_sp: JSValue = self.pending_exc;
            self.had_exception = False;
            self.pending_exc = js_undefined();
            self._dispose_to(rv_fr, 0);
            rv_fr.dispose_marks = [];
            if not self.had_exception {
                self.had_exception = rv_se;
                self.pending_exc = rv_sp;
            }
        }
        while len(self.stack) > rv_fr.stack_base {
            self.stack.pop();
        }
        del self.frames[len(self.frames) - 1];
        self.rtop = rv_base;
        if (not self.had_exception) and len(self.frame_pool) < _FRAME_POOL_MAX {
            self.frame_pool.append(rv_fr);
        }
        self.call_depth = self.call_depth - 1;
        self.module_fns = rv_saved_mf;
        if self.had_exception {
            return js_undefined();
        }
        return rv_res;
    }

    """A stack-ISA frame calling a register-ISA closure (`_op_call` /
    `_op_call_method` fast paths): the callee runs to completion in its own
    register loop right here — its frame built in place from the operand
    stack, no run_cl/run — and its result (or exception) is delivered as an
    inline return would. False when the general call path must take it."""
    def _reg_call_from_stack(
        cl: JSClosure,
        cl_val: JSValue,
        this_val: JSValue,
        nargs: int,
        below: int,
        frame: CallFrame,
        st: ExecState
    ) -> bool {
        if cl.napi_cb_ptr != 0 or cl.func.has_tail_call {
            return False;
        }
        rs_this: JSValue = self._reg_eff_this(cl, cl_val, this_val);
        if jsv_is_hole(rs_this) {
            return False;
        }
        rs_ab: int = len(self.stack) - nargs;
        rs_np: int = len(cl.func.params);
        rs_pb: int = cl.func.param_base;
        rs_base: int = self._win_alloc(cl.func.num_locals, cl.func.reg_tmp_base);
        rs_k: int = 0;
        while rs_k < rs_np and rs_k < nargs {
            self.regs[rs_base + rs_pb + rs_k] = self.stack[rs_ab + rs_k];
            rs_k = rs_k + 1;
        }
        if cl.func.has_rest and rs_np > 0 {
            rs_items: list[JSValue] = [];
            rs_k = rs_np - 1;
            while rs_k < nargs {
                rs_items.append(self.stack[rs_ab + rs_k]);
                rs_k = rs_k + 1;
            }
            self.regs[rs_base + rs_pb + rs_np - 1] = js_array_create(rs_items);
        }
        while len(self.stack) > rs_ab - below {
            self.stack.pop();
        }
        return self._reg_run_nested(cl, cl_val, rs_this, rs_base, frame, st);
    }

    """_reg_call_from_stack for the general path's argument list."""
    def _reg_call_from_list(
        cl: JSClosure,
        cl_val: JSValue,
        this_val: JSValue,
        args: list[JSValue],
        frame: CallFrame,
        st: ExecState
    ) -> bool {
        if cl.napi_cb_ptr != 0 or cl.func.has_tail_call {
            return False;
        }
        rl_this: JSValue = self._reg_eff_this(cl, cl_val, this_val);
        if jsv_is_hole(rl_this) {
            return False;
        }
        rl_np: int = len(cl.func.params);
        rl_pb: int = cl.func.param_base;
        rl_base: int = self._win_alloc(cl.func.num_locals, cl.func.reg_tmp_base);
        rl_k: int = 0;
        while rl_k < rl_np and rl_k < len(args) {
            self.regs[rl_base + rl_pb + rl_k] = args[rl_k];
            rl_k = rl_k + 1;
        }
        if cl.func.has_rest and rl_np > 0 {
            rl_items: list[JSValue] = [];
            rl_k = rl_np - 1;
            while rl_k < len(args) {
                rl_items.append(args[rl_k]);
                rl_k = rl_k + 1;
            }
            self.regs[rl_base + rl_pb + rl_np - 1] = js_array_create(rl_items);
        }
        return self._reg_run_nested(cl, cl_val, rl_this, rl_base, frame, st);
    }

    """Run a register-ISA callee to completion for a stack-ISA caller
    (locals filled): push its frame, run _exec_reg, pop and pool the frame
    as run() does, then push the result for the caller or route the
    exception to the caller frame's handlers."""
    def _reg_run_nested(
        cl: JSClosure,
        cl_val: JSValue,
        rn_this: JSValue,
        rn_base: int,
        frame: CallFrame,
        st: ExecState
    ) -> bool {
        rn_nt: JSValue = self._pending_new_target;
        if jsv_is_undefined(rn_nt) {
            rn_nt = self.pending_new_target;
        }
        if cl.is_arrow {
            rn_nt = cl.lexical_new_target;
        }
        self._pending_new_target = js_undefined();
        self.pending_new_target = js_undefined();
        rn_tui: bool = self._pending_this_uninit;
        self._pending_this_uninit = False;
        rn_ctc: JSValue = self._pending_ctor_class;
        self._pending_ctor_class = 0;
        rn_fr: CallFrame = self._frame_acquire(
            cl.func,
            len(self.stack),
            self.regs,
            cl.free_vals,
            rn_this,
            cl_val,
            rn_nt,
            rn_tui,
            rn_ctc,
            len(self.frame_pool) > 0
        );
        rn_fr.rpc = 0;
        rn_fr.win = True;
        rn_fr.lb = rn_base;
        rn_saved_mf: list[CompiledFunction] = self.module_fns;
        if len(cl.module_fns) > 0 {
            self.module_fns = cl.module_fns;
        }
        self.frames.append(rn_fr);
        self.call_depth = self.call_depth + 1;
        rn_res: JSValue = self._exec_reg(rn_fr);
        if len(rn_fr.dispose_stack) > 0 {
            rn_se: bool = self.had_exception;
            rn_sp: JSValue = self.pending_exc;
            self.had_exception = False;
            self.pending_exc = js_undefined();
            self._dispose_to(rn_fr, 0);
            rn_fr.dispose_marks = [];
            if not self.had_exception {
                self.had_exception = rn_se;
                self.pending_exc = rn_sp;
            }
        }
        while len(self.stack) > rn_fr.stack_base {
            self.stack.pop();
        }
        del self.frames[len(self.frames) - 1];
        self.rtop = rn_base;
        if (not self.had_exception) and len(self.frame_pool) < _FRAME_POOL_MAX {
            self.frame_pool.append(rn_fr);
        }
        self.call_depth = self.call_depth - 1;
        self.module_fns = rn_saved_mf;
        if self.had_exception {
            rn_exc: JSValue = self.pending_exc;
            self.had_exception = False;
            self.pending_exc = js_undefined();
            if not self._unwind_in_frame(frame, rn_exc) {
                self.had_exception = True;
                self.pending_exc = rn_exc;
                st.running = False;
            }
        } else {
            self._push(rn_res);
        }
        return True;
    }

    """R_STK SUPER_CALL whose super class is a JS class with an explicit,
    in-loop-enterable constructor (see V4.9 above): 1 = the super constructor's
    frame was entered (its return finishes the super() in _reg_super_done),
    0 = the handler takes it (nothing done), 2 = a base super's field
    initializer threw (raised here)."""
    def _reg_super_enter(frame: CallFrame, st: ExecState, w: int, pc: int) -> int {
        if _INLINE_CALLS_ON == 0 {
            return 0;
        }
        se_orig: int = (w >> 40) & 8388607;
        se_cell: JSValue = frame.this_binding_cell;
        if se_cell != 0 and not js_is_tdz(cell_get(se_cell)) {
            return 0;
        }
        if not is_fn_val(frame.self_fn) {
            return 0;
        }
        se_sup: JSValue = self.realm.closures[get_fn_idx(frame.self_fn)].super_class;
        if not (
            jsv_is_object_cell(se_sup)
            and jsv_to_table_id(se_sup) > 0
            and js_object_has_own(se_sup, WK_IS_CLASS)
            and not js_object_has_own(se_sup, KEY_CTOR_KIND)
        ) {
            return 0;
        }
        se_fn: JSValue = js_object_get(se_sup, WK_CTOR);
        if not is_fn_val(se_fn) {
            return 0;
        }
        if not self._reg_can_enter_cl(self.realm.closures[get_fn_idx(se_fn)]) {
            return 0;
        }
        se_base: int = (w >> 8) & 65535;
        se_argc: int = ((w >> 24) & 65535) & 4095;
        se_argpc: int = 0 - se_base - 2;
        if (frame.func.code[se_orig].arg3 & 8) != 0 {
            # super(...xs): the argument registers with the spread arrays
            # expanded (_op_super_call's _expand_spreads), list mode.
            se_list: list[JSValue] = [];
            se_k: int = 0;
            while se_k < se_argc {
                se_list.append(frame.locals[frame.lb + (se_base + se_k)]);
                se_k = se_k + 1;
            }
            self.reg_call_args = _expand_spreads(se_list);
            se_argc = len(self.reg_call_args);
            se_argpc = -1;
        }
        frame.ip = se_orig + 1;
        frame.this_uninitialized = False;
        if not js_object_has_own(se_sup, WK_SUPER) {
            if not self._run_class_own_fields(se_sup, frame.this_val, frame, st) {
                return 2;
            }
        }
        self._pending_new_target = frame.new_target;
        se_r: int = self._reg_call_enter_cl(
            self.realm.closures[get_fn_idx(se_fn)],
            frame,
            st,
            se_fn,
            frame.this_val,
            se_base,
            se_argpc,
            se_argc,
            se_orig,
            pc
        );
        if se_r != 1 {
            self._pending_new_target = js_undefined();
            return 2;
        }
        # ctor_this = undefined marks an in-loop super() frame (V4.10)
        self.frames[len(self.frames) - 1].ctor_this = js_undefined();
        return 1;
    }

    """The end of an in-loop super() (_op_super_call's tail) in the calling
    frame `cf`, the super constructor having returned st.ret: an object
    result replaces `this`, the result register gets undefined, and a
    this-binding cell is bound and the active class's own fields run."""
    def _reg_super_done(cf: CallFrame, st: ExecState, dst: int) {
        if jsv_is_any_object(st.ret) and st.ret != cf.this_val {
            cf.this_val = st.ret;
        }
        cf.locals[cf.lb + dst] = js_undefined();
        if cf.this_binding_cell != 0 and not self.had_exception {
            cell_set(cf.this_binding_cell, cf.this_val);
            self._run_super_derived_fields(cf, st);
        }
    }

    """SPREAD of an unmapped arguments object `src` whose own @@iterator is
    still %Array.prototype.values% and whose ArrayIterator `next` is the
    intrinsic: elements 0..length-1 (plain own data, as an ArrayIterator would
    read them), marked as a spread like the handler's array. False → handler."""
    def _reg_spread_args(frame: CallFrame, w: int, src: JSValue) -> bool {
        sa_it: JSValue = js_object_get_ordinary(src, SYMBOL_KEY_BASE + SYMBOL_ITERATOR);
        if jsv_is_hole(sa_it) or not (sa_it == self.realm.array_values_fn) {
            return False;
        }
        sa_aip: JSValue = js_get_array_iterator_proto();
        if not jsv_is_object_cell(sa_aip) {
            return False;
        }
        sa_next: JSValue = js_object_get_ordinary(sa_aip, WK_NEXT);
        if not (
            is_native_val(sa_next)
            and get_native_kind(sa_next) == NATIVE_KIND_ARRAY_ITER_NEXT
        ) {
            return False;
        }
        sa_lv: JSValue = js_object_get_ordinary(src, WK_LENGTH);
        if not jsv_is_int32(sa_lv) or jsv_to_int32(sa_lv) < 0 {
            return False;
        }
        sa_n: int = jsv_to_int32(sa_lv);
        sa_items: list[JSValue] = [];
        sa_i: int = 0;
        while sa_i < sa_n {
            sa_v: JSValue = js_object_get_ordinary(src, str_intern_index(sa_i));
            if jsv_is_hole(sa_v) {
                return False;
            }
            sa_items.append(sa_v);
            sa_i = sa_i + 1;
        }
        sa_arr: JSValue = js_array_create(sa_items);
        js_object_set(sa_arr, _KEY_IS_SPREAD, js_true());
        frame.locals[frame.lb + ((w >> 8) & 65535)] = sa_arr;
        return True;
    }

    """R_STK SUPER_GET_PROP on registers base (the super base) and base + 1 (the
    receiver): _op_super_get_prop's read, its exception raised at the word.
    False → the handler (a null / undefined base: its TypeError)."""
    def _reg_super_get_prop(
        frame: CallFrame, st: ExecState, w: int, orig: int
    ) -> bool {
        sg_base: JSValue = frame.locals[frame.lb + ((w >> 8) & 65535)];
        if jsv_is_null(sg_base) or jsv_is_undefined(sg_base) or js_is_tdz(sg_base) {
            return False;
        }
        sg_recv: JSValue = frame.locals[frame.lb + (((w >> 8) & 65535) + 1)];
        if js_is_tdz(sg_recv) {
            return False;
        }
        frame.ip = orig + 1;
        sg_v: JSValue = self._get_prop_accessor_recv(
            sg_base, _ins_cached_key_arg2(frame, frame.func.code[orig]), sg_recv
        );
        if vm_has_native_exc() {
            self._reg_throw(frame, st, vm_take_native_exc(), orig);
            return True;
        }
        if self.had_exception {
            sg_exc: JSValue = self.pending_exc;
            self.had_exception = False;
            self.pending_exc = js_undefined();
            self._reg_throw(frame, st, sg_exc, orig);
            return True;
        }
        frame.locals[frame.lb + ((w >> 8) & 65535)] = sg_v;
        return True;
    }

    """R_STK's in-place cases, on the word's registers (True = done, the
    handler not run): ITER_CLOSE_NRML on the standard {__I, __J} iterator
    (null prototype, no `return`: a no-op) and SPREAD of an array with the
    default @@iterator whose elements are all present dense elements (what
    the handler's iterator drain copies), the copy carrying the spread
    marker in regs[base]."""
    def _reg_stk_fast(frame: CallFrame, st: ExecState, w: int) -> bool {
        sk_orig: int = (w >> 40) & 8388607;
        sk_op: Opcode = frame.func.code[sk_orig].opcode;
        if sk_op == Opcode.MAKE_ARROW {
            frame.locals[frame.lb + ((w >> 8) & 65535)] = self._make_arrow_value(
                frame, frame.func.code[sk_orig]
            );
            return True;
        }
        if sk_op == Opcode.SUPER_GET_PROP {
            return self._reg_super_get_prop(frame, st, w, sk_orig);
        }
        if sk_op == Opcode.LOAD_SUPER_PROTO {
            if frame.func.code[sk_orig].arg2 == 1 or not is_fn_val(frame.self_fn) {
                return False;
            }
            sp_home: JSValue = self.realm.closures[
                get_fn_idx(frame.self_fn)
            ].home_object;
            if jsv_is_object_cell(sp_home) and jsv_to_table_id(sp_home) > 0 {
                frame.locals[frame.lb + ((w >> 8) & 65535)] = js_object_get_prototype(
                    sp_home
                );
                return True;
            }
            # no [[HomeObject]]: the super class's prototype (the handler's fallback)
            sp_sup: JSValue = self.realm.closures[
                get_fn_idx(frame.self_fn)
            ].super_class;
            if is_native_val(sp_sup) {
                frame.locals[frame.lb + ((w >> 8) & 65535)] = _native_prop(
                    sp_sup, WK_PROTOTYPE
                );
            } elif is_fn_val(sp_sup) {
                frame.locals[frame.lb + ((w >> 8) & 65535)] = _fn_prop(
                    sp_sup, WK_PROTOTYPE
                );
            } elif jsv_is_object_cell(sp_sup) and jsv_to_table_id(sp_sup) >= 0 {
                frame.locals[frame.lb + ((w >> 8) & 65535)] = js_object_get(
                    sp_sup, WK_PROTOTYPE
                );
            } else {
                frame.locals[frame.lb + ((w >> 8) & 65535)] = js_undefined();
            }
            return True;
        }
        if sk_op == Opcode.NEW_ARRAY {
            na_base: int = (w >> 8) & 65535;
            na_n: int = ((w >> 24) & 65535) & 4095;
            na_raw: list[JSValue] = [];
            na_i: int = 0;
            while na_i < na_n {
                if js_is_tdz(frame.locals[frame.lb + (na_base + na_i)]) {
                    return False;
                }
                na_raw.append(frame.locals[frame.lb + (na_base + na_i)]);
                na_i = na_i + 1;
            }
            if (frame.func.code[sk_orig].arg3 & 16) != 0 {
                frame.locals[frame.lb + (na_base)] = js_array_create(na_raw);
            } else {
                frame.locals[frame.lb + (na_base)] = js_array_create(
                    _expand_spreads(na_raw)
                );
            }
            return True;
        }
        if sk_op == Opcode.MAKE_FUNCTION {
            frame.locals[frame.lb + ((w >> 8) & 65535)] = self._make_function_value(
                frame, frame.func.code[sk_orig]
            );
            return True;
        }
        if sk_op == Opcode.ITER_CLOSE_NRML {
            return _ITER_STD_SHAPE > 0
                and js_object_ic_shape(frame.locals[frame.lb + ((w >> 8) & 65535)])
                    == _ITER_STD_SHAPE;
        }
        if sk_op == Opcode.SPREAD {
            sk_src: JSValue = frame.locals[frame.lb + ((w >> 8) & 65535)];
            if jsv_is_object_cell(sk_src)
                and jsv_to_table_id(sk_src) > 0
                and (
                    js_object_cell_flags_id(jsv_to_table_id(sk_src))
                    & (FLAG_IS_ARGUMENTS | FLAG_MAPPED_ARGS)
                )
                    == FLAG_IS_ARGUMENTS {
                return self._reg_spread_args(frame, w, sk_src);
            }
            if not (
                jsv_is_object_cell(sk_src)
                and js_is_array(sk_src)
                and self._has_default_iter(sk_src)
            ) {
                return False;
            }
            sk_n: int = js_array_len(sk_src);
            sk_items: list[JSValue] = [];
            sk_i: int = 0;
            while sk_i < sk_n {
                sk_v: JSValue = js_object_dense_elem(sk_src, sk_i);
                if jsv_is_hole(sk_v) {
                    return False;
                }
                sk_items.append(sk_v);
                sk_i = sk_i + 1;
            }
            sk_arr: JSValue = js_array_create(sk_items);
            js_object_set(sk_arr, _KEY_IS_SPREAD, js_true());
            frame.locals[frame.lb + ((w >> 8) & 65535)] = sk_arr;
            return True;
        }
        return False;
    }

    """R_SETINDEX define form (arg3 == 1: computed object-literal data property,
    class computed field) with a primitive key on an object cell: the
    handler's CreateDataProperty path — a concise method value gets this
    object as [[HomeObject]] — its result ignored as the handler ignores it.
    False → handler (object keys need ToPropertyKey's user code)."""
    def _reg_set_index_define(so: JSValue, si: JSValue, sv: JSValue) -> bool {
        if not jsv_is_object_cell(so) or jsv_to_table_id(so) <= 0 {
            return False;
        }
        sd_key: int = 0;
        if jsv_is_symbol(si) or jsv_is_string_cell(si) {
            sd_key = jsval_to_prop_key(si);
        } elif jsv_is_int32(si) and jsv_to_int32(si) >= 0 {
            sd_key = str_intern_index(jsv_to_int32(si));
        } else {
            return False;
        }
        if is_fn_val(sv) {
            sd_idx: int = get_fn_idx(sv);
            if sd_idx >= 0
                and sd_idx < len(self.realm.closures)
                and self.realm.closures[sd_idx].func.is_method
                and jsv_is_undefined(self.realm.closures[sd_idx].home_object) {
                self.realm.closures[sd_idx].home_object = so;
            }
        }
        _ = js_object_create_data_property_or_throw(so, sd_key, sv);
        return True;
    }

    """R_SETINDEX with a Symbol or string key on an object cell: ToPropertyKey of
    the primitive, then the ordinary [[Set]] the SETFIELD register path uses
    (js_object_set_ordinary declines setters, read-only and exotic chain
    members — False → handler). Arrays, typed arrays, class objects,
    `__proto__` and `exports` keep the handler."""
    def _reg_set_index_key(so: JSValue, si: JSValue, sv: JSValue) -> bool {
        if not (jsv_is_symbol(si) or jsv_is_string_cell(si))
            or not jsv_is_object_cell(so) {
            return False;
        }
        sk_id: int = jsv_to_table_id(so);
        if sk_id <= 0
            or js_object_brand(so) != 0
            or js_object_binary_kind_id(sk_id) != 0 {
            return False;
        }
        if (
            js_object_table_get(sk_id).cell_flags
            & (FLAG_IS_CLASS | FLAG_IS_ARGUMENTS | FLAG_MODULE_NS)
        )
            != 0 {
            return False;
        }
        sk_key: int = jsval_to_prop_key(si);
        if sk_key == KEY_PROTO or sk_key == WK_EXPORTS or not _vm_ic_key_ok(sk_key) {
            return False;
        }
        return js_object_set_ordinary(so, sk_key, sv);
    }

    """R_SETINDEX's in-place cases (the SET_INDEX handler's dense-element and
    typed-array fast paths, without the stack round trip). False → handler."""
    def _reg_set_index_fast(so: JSValue, si: JSValue, sv: JSValue) -> bool {
        if not (jsv_is_int32(si) and jsv_is_object_cell(so)) {
            return False;
        }
        sf_di: int = jsv_to_int32(si);
        sf_tid: int = jsv_to_table_id(so);
        if sf_di < 0 or sf_tid <= 0 {
            return False;
        }
        if js_object_binary_kind_id(sf_tid) == BINARY_KIND_TYPED_ARRAY {
            if jsv_is_int32(sv) or jsv_is_double(sv) {
                sf_f: float = 0.0;
                if jsv_is_int32(sv) {
                    sf_f = float(jsv_to_int32(sv));
                } else {
                    sf_f = jsv_to_double(sv);
                }
                return binary_ta_int_set(so, sf_di, sf_f);
            }
            return False;
        }
        sf_o: JSObject = js_object_table_get(sf_tid);
        if sf_o.elems_kind == ELEMS_NONE {
            return False;
        }
        if sf_di < len(sf_o.elems_ro()) and not jsv_is_hole(sf_o.elems_ro()[sf_di]) {
            sf_o.elems_rw()[sf_di] = sv;
            return True;
        }
        if sf_di == len(sf_o.elems_ro())
            and idx_protector_ok()
            and sf_o.is_ext()
            and sf_o.mode == MAP_MODE_SHAPE {
            sf_pk: int = shape_lookup(sf_o.shape_id, WK_LENGTH);
            if sf_pk >= 0 and (sf_pk & SHAPE_ATTR_ACCESSOR) == 0 {
                sf_len: JSValue = sf_o.slots[sf_pk // 16];
                if jsv_is_int32(sf_len) {
                    sf_cur: int = jsv_to_int32(sf_len);
                    if sf_di < sf_cur {
                        sf_o.elems_rw().append(sv);
                        return True;
                    }
                    if (sf_pk & PROP_WRITABLE) != 0 {
                        sf_o.elems_rw().append(sv);
                        sf_o.slots[sf_pk // 16] = js_int(sf_di + 1);
                        return True;
                    }
                }
            }
        }
        return False;
    }

    """RETURN from an in-loop register frame: pool it and deliver st.ret to
    the caller's ret_reg (unless discard_ret) — _inline_return's register
    form."""
    def _reg_inline_return(st: ExecState) -> None {
        ir_top: int = len(self.frames) - 1;
        if self.module_fns is not self.frames[ir_top].caller_module_fns {
            self.module_fns = self.frames[ir_top].caller_module_fns;
        }
        ir_sb: int = self.frames[ir_top].stack_base;
        while len(self.stack) > ir_sb {
            self.stack.pop();
        }
        self.frames[ir_top].ip = 0;
        ir_keep: bool = not self.frames[ir_top].discard_ret;
        ir_dst: int = self.frames[ir_top].ret_reg;
        ir_post: JSValue = 0;
        ir_super: int = 0;
        if self.frames[ir_top].ctor_this != 0 {
            if jsv_is_undefined(self.frames[ir_top].ctor_this) {
                # an in-loop super(): finished in the caller below
                ir_super = 1;
            } else {
                # [[Construct]]: a non-object result is replaced by the new object.
                if not jsv_is_any_object(st.ret) {
                    st.ret = self.frames[ir_top].ctor_this;
                }
                ir_post = self.frames[ir_top].post_fields;
                self.frames[ir_top].post_fields = 0;
            }
            self.frames[ir_top].ctor_this = 0;
        }
        if self.frames[ir_top].win {
            self.rtop = self.frames[ir_top].lb;
        }
        if self.frames[ir_top].mod_swapped {
            self._reg_mod_restore(self.frames[ir_top]);
        }
        if len(self.frame_pool) < _FRAME_POOL_MAX {
            self.frame_pool.append(self.frames[ir_top]);
        }
        del self.frames[ir_top];
        st.inline_depth = st.inline_depth - 1;
        self.call_depth = self.call_depth - 1;
        if ir_super != 0 {
            self._reg_super_done(self.frames[ir_top - 1], st, ir_dst);
            st.ret = js_undefined();
            return;
        }
        if ir_keep {
            self.frames[ir_top - 1].locals[self.frames[ir_top - 1].lb + ir_dst] = st.ret;
        }
        # An implicit derived constructor's own fields, after the super
        # constructor returned (_op_new's post-ctor block); a throw unwinds
        # into the constructing frame.
        if ir_post != 0 {
            self._run_class_own_fields(ir_post, st.ret, self.frames[ir_top - 1], st);
        }
        st.ret = js_undefined();
    }

    """R_RETURN / R_RETUNDEF tail (_op_return's): dispose open `using`
    resources, then return in-loop (True: the frame stack changed) or stop."""
    def _reg_return(frame: CallFrame, st: ExecState, rv: JSValue, pc: int) -> bool {
        if frame.ctor_this != 0 and frame.this_binding_cell != 0 {
            # An in-loop derived constructor (V4.7): run()'s return rules
            # while `this` is still uninitialized, and _op_new's TypeError
            # for any non-undefined primitive. (Only constructors without
            # try/catch run in-loop, so the throw cannot be caught inside.)
            dr_exc: JSValue = jsv_hole();
            if not jsv_is_undefined(rv) and not jsv_is_any_object(rv) {
                dr_exc = make_type_error(
                    "Derived constructors may only return object or undefined"
                );
            } elif not jsv_is_any_object(rv)
                and js_is_tdz(cell_get(frame.this_binding_cell)) {
                dr_exc = make_reference_error(
                    "Must call super constructor in derived class before accessing 'this' or returning from derived constructor"
                );
            }
            if not jsv_is_hole(dr_exc) {
                self._reg_throw(frame, st, dr_exc, frame.func.rorig[pc - 1]);
                return False;
            }
        }
        st.ret = rv;
        if len(frame.dispose_stack) > 0 {
            self._dispose_to(frame, 0);
            frame.dispose_marks = [];
        }
        if st.inline_depth > 0 and not self.had_exception {
            self._reg_inline_return(st);
            return True;
        }
        st.running = False;
        return False;
    }

    """VM_DEBUG_MODE per-instruction trace line for the register loop."""
    def _reg_trace(frame: CallFrame, pc: int, w: int) {
        self.vm_debug(
            "  ["
                + frame.func.name
                + " rpc="
                + str(pc)
                + "] op"
                + str(w & 255)
                + " a="
                + str((w >> 8) & 65535)
                + " b="
                + str((w >> 24) & 65535)
                + " c="
                + str((w >> 40) & 8388607)
                + " <- "
                + opcode_name(frame.func.code[frame.func.rorig[pc]].opcode)
        );
    }

    """GETFIELD after the IC / megamorphic-cache misses: the allocation-free
    reads (_vm_prim_get, plain objects, closures), then a plain-JS prototype
    getter entered in-loop through the getter IC (1 = frame entered), else
    the handler."""
    def _reg_getfield_slow(
        frame: CallFrame, st: ExecState, w: int, c: int, va: JSValue, pc: int
    ) -> int {
        gs_key: int = frame.func.code[c].arg2;
        gs_v: JSValue = _vm_prim_get(gs_key, va);
        if jsv_is_hole(gs_v) and gs_key != 0 and _vm_ic_key_ok_obj(gs_key, va) {
            if jsv_is_object_cell(va) {
                gs_v = _vm_obj_get_plain(va, gs_key);
                # The answer came from the ordinary walk: fill this site's
                # IC as the handler would, so the next read here hits.
                if not jsv_is_hole(gs_v) {
                    self._reg_getfield_fill(frame, c, va, gs_key, gs_v);
                }
            } elif is_fn_val(va) {
                gs_v = _vm_fn_get_plain(va, gs_key);
            } elif is_native_val(va) {
                gs_v = _native_prop(va, gs_key);
            }
        }
        if not jsv_is_hole(gs_v) {
            frame.locals[frame.lb + ((w >> 8) & 65535)] = gs_v;
            return 0;
        }
        if jsv_is_object_cell(va) {
            gs_g: JSValue = self._getter_ic_lookup(frame.func.code[c], va);
            if not jsv_is_hole(gs_g) {
                gs_r: int = self._reg_call_enter(
                    frame, st, gs_g, va, (w >> 8) & 65535, pc, 0, c, pc
                );
                if gs_r != 0 {
                    return gs_r;
                }
            }
            if gs_key != 0
                and self._reg_getfield_generic(frame, st, w, c, va, gs_key) {
                return 0;
            }
        }
        self._reg_bridge(frame, st, c, 1, va, 0, 0, (w >> 8) & 65535, 1);
        return 0;
    }

    """GETFIELD on an object cell that _op_get_prop answers in its generic
    branch — no brand branch (arrays, Map/Set/Weak*, generators, promises,
    String objects keep it), not a class object, not the {__I,__J} iterator's
    `next`, not `__proto__`, not a typed array's natively answered view keys:
    the same _get_prop_accessor call (getters, deferred namespaces, Proxy
    traps), its throw raised here, its own-data result cached as the handler
    caches it. False when the handler must take it (nothing done)."""
    def _reg_getfield_generic(
        frame: CallFrame, st: ExecState, w: int, c: int, va: JSValue, key: int
    ) -> bool {
        gg_id: int = jsv_to_table_id(va);
        if gg_id <= 0
            or key == KEY_PROTO
            or key == WK_NEXT
            or not _vm_ic_key_ok_obj(key, va) {
            return False;
        }
        if (
            js_object_brand(va) & (0 - 1 - BRAND_REGEXP - BRAND_ENV_OBJ - BRAND_PROMISE)
        )
            != 0 {
            return False;
        }
        if (js_object_table_get(gg_id).cell_flags & FLAG_IS_CLASS) != 0 {
            return False;
        }
        if js_object_binary_kind_id(gg_id) == BINARY_KIND_TYPED_ARRAY
            and (
                key == WK_LENGTH
                or key == WK_BYTELENGTH
                or key == WK_BYTEOFFSET
                or key == WK_BUFFER
            ) {
            return False;
        }
        frame.ip = c + 1;
        gg_v: JSValue = self._get_prop_accessor(va, key);
        if vm_has_native_exc() {
            self._reg_throw(frame, st, vm_take_native_exc(), c);
            return True;
        }
        if self.had_exception {
            gg_exc: JSValue = self.pending_exc;
            self.had_exception = False;
            self.pending_exc = js_undefined();
            self._reg_throw(frame, st, gg_exc, c);
            return True;
        }
        frame.locals[frame.lb + ((w >> 8) & 65535)] = gg_v;
        if VM_IC_ENABLED {
            gg_sid: int = _vm_shape_of(va);
            if gg_sid > 0 {
                gg_pk: int = shape_lookup(gg_sid, key);
                if gg_pk >= 0 and (gg_pk & SHAPE_ATTR_ACCESSOR) == 0 {
                    frame.func.code[c].ic_obj = gg_sid;
                    frame.func.code[c].ic_ver = gg_pk;
                    frame.func.code[c].ic_holder = 1;
                    frame.func.code[c].ic_epoch = 0;
                }
            }
        }
        return True;
    }

    """After the ordinary walk answered GETFIELD `c` on `obj`: fill the site
    as _op_get_prop does — an own data slot (holder 1, plus the megamorphic
    cache) or an inherited data slot (holder < 0, _get_prop_proto_ic_fill)."""
    def _reg_getfield_fill(
        frame: CallFrame, c: int, gobj: JSValue, key: int, val: JSValue
    ) -> None {
        if not VM_IC_ENABLED {
            return;
        }
        gf_sid: int = js_object_ic_shape(gobj);
        if gf_sid < 0 {
            return;
        }
        frame.ip = c + 1;
        if gf_sid > 0 {
            gf_pk: int = shape_lookup(gf_sid, key);
            if gf_pk >= 0 {
                if (gf_pk & SHAPE_ATTR_ACCESSOR) == 0 {
                    frame.func.code[c].ic_obj = gf_sid;
                    frame.func.code[c].ic_ver = gf_pk;
                    frame.func.code[c].ic_holder = 1;
                    frame.func.code[c].ic_epoch = 0;
                    if _vm_ic_key_ok(key) {
                        _mgc_put(
                            gf_sid,
                            js_object_proto_idx_id(jsv_to_table_id(gobj)),
                            key,
                            0,
                            gf_pk,
                            -1
                        );
                    }
                }
                return;
            }
        }
        self._get_prop_proto_ic_fill(frame, gobj, key, val);
    }

    """SETFIELD after the IC misses: the ordinary [[Set]] on a plain object
    (IC filled), a plain-JS prototype setter entered in-loop (1 = frame
    entered, its result dropped), else the handler."""
    def _reg_setfield_slow(
        frame: CallFrame,
        st: ExecState,
        w: int,
        c: int,
        va: JSValue,
        vb: JSValue,
        pc: int
    ) -> int {
        ss_a3: int = frame.func.code[c].arg3;
        if ss_a3 >= 2
            and (ss_a3 & 3) == 0
            and (ss_a3 >> 2) != WK_EXPORTS
            and (ss_a3 >> 2) != KEY_PROTO
            and _vm_ic_key_ok_obj(ss_a3 >> 2, va)
            and jsv_is_object_cell(va)
            and self._reg_set_plain(frame, frame.func.code[c], c, va, vb) {
            return 0;
        }
        if jsv_is_object_cell(va) {
            ss_s: JSValue = self._setter_ic_lookup(frame.func.code[c], va);
            if not jsv_is_hole(ss_s) {
                self.reg_arg1 = vb;
                ss_r: int = self._reg_call_enter(
                    frame, st, ss_s, va, frame.func.num_locals - 1, pc, -1, c, pc
                );
                if ss_r == 1 {
                    self.frames[len(self.frames) - 1].discard_ret = True;
                    return 1;
                }
                if ss_r != 0 {
                    return ss_r;
                }
            }
        }
        self._reg_bridge(frame, st, c, 2, va, vb, 0, frame.func.num_locals - 1, 1);
        return 0;
    }

    """GETINDEX after the dense / typed-array miss: string indexing, string
    and symbol keys on plain objects, out-of-range dense reads, else the
    handler."""
    def _reg_getindex_slow(
        frame: CallFrame, st: ExecState, w: int, va: JSValue, vb: JSValue, pc: int
    ) -> None {
        gi_b: int = (w >> 24) & 65535;
        gi_c: int = (w >> 40) & 8388607;
        if (gi_b & 32768) != 0 and js_is_tdz(va) {
            self._reg_tdz_throw(frame, st, gi_b & 32767, frame.func.rorig[pc - 1]);
            return;
        }
        if (gi_c & 32768) != 0 and js_is_tdz(vb) {
            self._reg_tdz_throw(frame, st, gi_c & 32767, frame.func.rorig[pc - 1]);
            return;
        }
        gi_v: JSValue = jsv_hole();
        if jsv_is_int32(vb) and jsv_to_int32(vb) >= 0 and jsv_is_string_cell(va) {
            gi_v = _vm_string_index(va, jsv_to_int32(vb));
        } elif (jsv_is_string_cell(vb) or jsv_is_symbol(vb))
            and jsv_is_object_cell(va) {
            gi_v = _vm_get_index_str(va, vb);
        } elif jsv_is_int32(vb)
            and jsv_to_int32(vb) >= 0
            and jsv_is_object_cell(va)
            and jsv_to_table_id(va) > 0
            and js_object_elems_kind_id(jsv_to_table_id(va)) != ELEMS_NONE
            and idx_protector_ok() {
            # A hole or an index past the dense elements, while no prototype
            # has index properties: undefined.
            gi_v = js_undefined();
        } elif jsv_is_int32(vb)
            and jsv_to_int32(vb) >= 0
            and jsv_is_object_cell(va)
            and jsv_to_table_id(va) > 0
            and js_object_elems_kind_id(jsv_to_table_id(va)) == ELEMS_NONE
            and js_object_brand(va) == 0
            and js_object_binary_kind_id(jsv_to_table_id(va)) == 0
            and (js_object_table_get(jsv_to_table_id(va)).cell_flags & FLAG_IS_CLASS)
                == 0 {
            # An index key on a plain object without elements (`counts[c]`):
            # the ordinary walk (hole for exotic levels / accessors).
            gi_v = js_object_get_ordinary(va, str_intern_index(jsv_to_int32(vb)));
        }
        if jsv_is_hole(gi_v)
            and jsv_is_int32(vb)
            and jsv_to_int32(vb) >= 0
            and jsv_is_object_cell(va)
            and jsv_to_table_id(va) > 0
            and js_is_array(va)
            and js_object_elems_kind_id(jsv_to_table_id(va)) == ELEMS_NONE
            and idx_protector_ok() {
            # An array whose elements went to the property map (Object.freeze /
            # seal, far writes): its own data element, or undefined when it has
            # none while no prototype has index properties.
            gs_ik: int = str_intern_index(jsv_to_int32(vb));
            gi_v = js_object_get_ordinary(va, gs_ik);
            if jsv_is_hole(gi_v) and not js_object_has_own(va, gs_ik) {
                gi_v = js_undefined();
            }
        }
        if _REG_STATS_ON == 1
            and jsv_is_hole(gi_v)
            and jsv_is_int32(vb)
            and jsv_is_object_cell(va)
            and js_is_array(va) {
            gr_why: str = "elems";
            if jsv_to_int32(vb) < 0 {
                gr_why = "negative";
            } elif js_object_elems_kind_id(jsv_to_table_id(va)) == ELEMS_NONE {
                gr_why = "no-elements (sparse/dict)";
            } elif not idx_protector_ok() {
                gr_why = "index protector broken";
            }
            _reg_stat_name(_REG_BRIDGE_IDX, "GET_INDEX array[int] miss: " + gr_why);
        }
        if not jsv_is_hole(gi_v) {
            frame.locals[frame.lb + ((w >> 8) & 65535)] = gi_v;
        } else {
            self._reg_bridge(
                frame, st, frame.func.rorig[pc - 1], 2, va, vb, 0, (w >> 8) & 65535, 1
            );
        }
    }

    """EQ / NEQ / INSTANCEOF / IN value forms (ops 54..59)."""
    def _reg_op_eqcmp(
        frame: CallFrame, st: ExecState, w: int, op: int, pc: int
    ) -> None {
        eq_b: int = (w >> 24) & 65535;
        eq_c: int = (w >> 40) & 8388607;
        va: JSValue = frame.locals[frame.lb + (eq_b & 32767)];
        vb: JSValue = frame.locals[frame.lb + (eq_c & 32767)];
        if (eq_b & 32768) != 0 and js_is_tdz(va) {
            self._reg_tdz_throw(frame, st, eq_b & 32767, frame.func.rorig[pc - 1]);
            return;
        }
        if (eq_c & 32768) != 0 and js_is_tdz(vb) {
            self._reg_tdz_throw(frame, st, eq_c & 32767, frame.func.rorig[pc - 1]);
            return;
        }
        if (op == 54 or op == 55) and _vm_eq_simple(va, vb) {
            eq_res: bool = self._abstract_equal(va, vb);
            if op == 55 {
                eq_res = not eq_res;
            }
            frame.locals[frame.lb + ((w >> 8) & 65535)] = js_boolean(eq_res);
            return;
        }
        if op == 58
            and is_native_val(vb)
            and get_native_kind(vb) == NATIVE_KIND_ARRAY {
            frame.locals[frame.lb + ((w >> 8) & 65535)] = js_boolean(js_is_array(va));
            return;
        }
        if op == 58
            and (
                (is_fn_val(vb) and _vm_instanceof_plain(vb))
                or (jsv_is_object_cell(vb) and _vm_instanceof_class(vb))
            ) {
            # OrdinaryHasInstance: a prototype walk; a bound or prototype-less
            # callee reports through the native exception channel.
            eq_v: JSValue = self._ordinary_has_instance(vb, va);
            if vm_has_native_exc() {
                self._reg_throw(
                    frame, st, vm_take_native_exc(), frame.func.rorig[pc - 1]
                );
            } elif self.had_exception {
                eq_v = self.pending_exc;
                self.had_exception = False;
                self.pending_exc = js_undefined();
                self._reg_throw(frame, st, eq_v, frame.func.rorig[pc - 1]);
            } else {
                frame.locals[frame.lb + ((w >> 8) & 65535)] = js_boolean(
                    jsv_to_bool(eq_v)
                );
            }
            return;
        }
        self._reg_bridge(
            frame, st, frame.func.rorig[pc - 1], 2, va, vb, 0, (w >> 8) & 65535, 1
        );
    }

    """NEG (non-int32 operand), BNOT, TYPEOF, TONUM, TOSTR."""
    def _reg_op_unary(
        frame: CallFrame, st: ExecState, w: int, op: int, pc: int
    ) -> None {
        un_b: int = (w >> 24) & 65535;
        va: JSValue = frame.locals[frame.lb + (un_b & 32767)];
        if (un_b & 32768) != 0 and js_is_tdz(va) {
            self._reg_tdz_throw(frame, st, un_b & 32767, frame.func.rorig[pc - 1]);
            return;
        }
        if op == 40 and (jsv_is_int32(va) or jsv_is_double(va) or jsv_is_bool(va)) {
            # -0 (the sign-flipped 0.0) stays a double, as _op_neg produces it.
            un_f: float = -js_to_num(va);
            if un_f == 0.0 and __float_bits(un_f) < 0 {
                frame.locals[frame.lb + ((w >> 8) & 65535)] = js_number(un_f);
            } else {
                frame.locals[frame.lb + ((w >> 8) & 65535)] = float_to_jsval(un_f);
            }
            return;
        }
        if op == 42 and jsv_is_int32(va) {
            frame.locals[frame.lb + ((w >> 8) & 65535)] = js_int(~jsv_to_int32(va));
            return;
        }
        if op == 43 {
            if is_fn_val(va) or is_native_val(va) {
                frame.locals[frame.lb + ((w >> 8) & 65535)] = _vm_typeof_str(
                    "function"
                );
                return;
            }
            if jsv_is_object_cell(va) {
                frame.locals[frame.lb + ((w >> 8) & 65535)] = _vm_typeof_str(
                    self._typeof_obj_cell(va)
                );
                return;
            }
            frame.locals[frame.lb + ((w >> 8) & 65535)] = _vm_typeof_str(js_typeof(va));
            return;
        }
        self._reg_bridge(
            frame, st, frame.func.rorig[pc - 1], 1, va, 0, 0, (w >> 8) & 65535, 1
        );
    }

    """NEWARRAY base, n: the array of regs[base .. base+n) -> regs[base]."""
    def _reg_op_newarray(frame: CallFrame, w: int) {
        na_base: int = (w >> 8) & 65535;
        na_n: int = (w >> 24) & 65535;
        na_items: list[JSValue] = [];
        na_k: int = 0;
        while na_k < na_n {
            na_items.append(frame.locals[frame.lb + (na_base + na_k)]);
            na_k = na_k + 1;
        }
        frame.locals[frame.lb + (na_base)] = js_array_create(na_items);
    }

    """GETITER dst, src, orig: for-of over an array with the default
    @@iterator -> the standard {__I, __J} iterator born at its learned shape
    (as _op_get_iter makes it); else the handler."""
    def _reg_op_getiter(frame: CallFrame, st: ExecState, w: int) -> None {
        gi_b: int = (w >> 24) & 65535;
        va: JSValue = frame.locals[frame.lb + (gi_b & 32767)];
        if (gi_b & 32768) != 0 and js_is_tdz(va) {
            self._reg_tdz_throw(frame, st, gi_b & 32767, (w >> 40) & 8388607);
            return;
        }
        if _ITER_STD_SHAPE > 0
            and _ITER_STD_I == 0
            and _ITER_STD_J == 1
            and jsv_is_object_cell(va)
            and js_is_array(va)
            and self._has_default_iter(va) {
            frame.locals[frame.lb + ((w >> 8) & 65535)] = js_object_new_shaped2(
                -1, _ITER_STD_SHAPE, va, js_int(0)
            );
            return;
        }
        self._reg_bridge(
            frame, st, (w >> 40) & 8388607, 1, va, 0, 0, (w >> 8) & 65535, 1
        );
    }

    """ITERNEXTVAL dst, iter, orig: the standard iterator's next value
    (destructuring); exhausted or custom -> the handler (which records
    __ITERDONE), its two results landing in regs[iter], regs[iter + 1] =
    regs[dst]."""
    def _reg_op_iternextval(frame: CallFrame, st: ExecState, w: int) -> None {
        iv_b: int = (w >> 24) & 65535;
        va: JSValue = frame.locals[frame.lb + (iv_b)];
        if _ITER_STD_SHAPE > 0 and js_object_ic_shape(va) == _ITER_STD_SHAPE {
            iv_id: int = jsv_to_table_id(va);
            iv_j: JSValue = js_object_slot_at_id(iv_id, _ITER_STD_J);
            if jsv_is_int32(iv_j)
                and jsv_to_int32(iv_j)
                    < js_array_len(js_object_slot_at_id(iv_id, _ITER_STD_I)) {
                frame.locals[frame.lb + ((w >> 8) & 65535)] = js_array_get(
                    js_object_slot_at_id(iv_id, _ITER_STD_I), jsv_to_int32(iv_j)
                );
                js_object_slot_set_at_id(
                    iv_id, _ITER_STD_J, js_int(jsv_to_int32(iv_j) + 1)
                );
                return;
            }
        }
        self._reg_bridge(frame, st, (w >> 40) & 8388607, 1, va, 0, 0, iv_b, 2);
    }

    """NEW dst, ctor, argc [args...] (CALL's operand layout, pc just past the
    word): a plain function constructor or a simple base class that is a
    register-ISA closure runs in-loop on a fresh object (1 = frame entered);
    everything else — natives, spreads, derived classes — takes the NEW
    handler. The caller advances pc past the argument words otherwise."""
    def _reg_op_new(frame: CallFrame, st: ExecState, w: int, pc: int) -> int {
        nw_a: int = (w >> 8) & 65535;
        nw_b: int = (w >> 24) & 65535;
        nw_c: int = (w >> 40) & 8388607;
        nw_orig: int = frame.func.rorig[pc - 1];
        va: JSValue = frame.locals[frame.lb + (nw_b & 32767)];
        if (nw_b & 32768) != 0 and js_is_tdz(va) {
            self._reg_tdz_throw(frame, st, nw_b & 32767, nw_orig);
            return 0;
        }
        nw_r: int = 0;
        if (frame.func.code[nw_orig].arg3 & 8) == 0 {
            if is_fn_val(va) and not is_native_val(va) {
                nw_r = self._reg_new_enter(
                    frame, st, va, nw_a, pc, nw_c, nw_orig, pc + nw_c
                );
            } elif jsv_is_object_cell(va)
                and jsv_to_table_id(va) > 0
                and (
                    js_object_table_get(jsv_to_table_id(va)).cell_flags & FLAG_IS_CLASS
                )
                    != 0 {
                nw_r = self._reg_new_class_enter(
                    frame, st, va, nw_a, pc, nw_c, nw_orig, pc + nw_c
                );
            } elif jsv_is_object_cell(va) {
                nw_coll: int = self._reg_empty_collection_kind(va);
                if (nw_coll == 1 or nw_coll == 2)
                    and (
                        nw_c == 0
                        or jsv_is_undefined(
                            frame.locals[frame.lb + (frame.func.rcode[pc] & 32767)]
                        )
                        or jsv_is_null(
                            frame.locals[frame.lb + (frame.func.rcode[pc] & 32767)]
                        )
                    ) {
                    # new Map() / new Set(): _op_new's MAP / SET branch for an
                    # absent initializer (any further arguments are ignored).
                    if nw_coll == 1 {
                        frame.locals[frame.lb + (nw_a)] = js_map_create();
                    } else {
                        frame.locals[frame.lb + (nw_a)] = js_set_create();
                    }
                    return 0;
                }
                if nw_coll == 3
                    and self._reg_new_array_call(frame, st, nw_a, pc, nw_c, nw_orig) {
                    return 0;
                }
            }
        }
        if nw_r == 1 {
            return 1;
        }
        if nw_r == 0 {
            self._reg_bridge_call(frame, st, nw_orig, nw_a, nw_b & 32767, -1, pc, nw_c);
        }
        # (3: constructed in place; 2: an exception was raised)
        return 0;
    }

    """1 when `ctor` is the Map constructor object, 2 the Set one, else 0 (the
    identities are learned on the first KEY_CTOR_KIND lookup, kept in a
    module-level box)."""
    def _reg_empty_collection_kind(ctor: JSValue) -> int {
        if ctor == _REG_COLL_CTORS[0] {
            return 1;
        }
        if ctor == _REG_COLL_CTORS[1] {
            return 2;
        }
        if ctor == _REG_COLL_CTORS[2] {
            return 3;
        }
        if jsv_to_table_id(ctor) <= 0 or not js_object_has_own(ctor, KEY_CTOR_KIND) {
            return 0;
        }
        ec_k: JSValue = js_object_get(ctor, KEY_CTOR_KIND);
        if not jsv_is_int32(ec_k) {
            return 0;
        }
        if jsv_to_int32(ec_k) == NATIVE_KIND_MAP {
            if _REG_COLL_CTORS[0] == 0 {
                _REG_COLL_CTORS[0] = ctor;
                gc_pin_value(ctor);
            }
            return 1;
        }
        if jsv_to_int32(ec_k) == NATIVE_KIND_SET {
            if _REG_COLL_CTORS[1] == 0 {
                _REG_COLL_CTORS[1] = ctor;
                gc_pin_value(ctor);
            }
            return 2;
        }
        if jsv_to_int32(ec_k) == NATIVE_KIND_ARRAY {
            if _REG_COLL_CTORS[2] == 0 {
                _REG_COLL_CTORS[2] = ctor;
                gc_pin_value(ctor);
            }
            return 3;
        }
        return 0;
    }

    """`new Array(...)`: _op_new's generic constructor-object branch — the
    native with undefined `this` and the argument registers, its throw raised
    at the NEW. False (nothing done) when an argument is still in its TDZ."""
    def _reg_new_array_call(
        frame: CallFrame, st: ExecState, dst: int, argpc: int, argc: int, orig: int
    ) -> bool {
        na_args: list[JSValue] = [];
        na_k: int = 0;
        while na_k < argc {
            na_w: int = frame.func.rcode[argpc + na_k];
            if (na_w & 32768) != 0
                and js_is_tdz(frame.locals[frame.lb + (na_w & 32767)]) {
                return False;
            }
            na_args.append(frame.locals[frame.lb + (na_w & 32767)]);
            na_k = na_k + 1;
        }
        frame.ip = orig + 1;
        na_res: JSValue = _vm_call_native_proxy_aware(
            self, self.realm, NATIVE_KIND_ARRAY, js_undefined(), na_args
        );
        if vm_has_native_exc() {
            self._reg_throw(frame, st, vm_take_native_exc(), orig);
            return True;
        }
        if self.had_exception {
            na_exc: JSValue = self.pending_exc;
            self.had_exception = False;
            self.pending_exc = js_undefined();
            self._reg_throw(frame, st, na_exc, orig);
            return True;
        }
        frame.locals[frame.lb + (dst)] = na_res;
        return True;
    }

    """TAILCALL dst, callee, argc [args] (pc just past the word): in an in-loop
    frame the callee replaces it (1 = entered); at the loop's base frame the
    TAIL_CALL handler stages run()'s trampoline; a callee that cannot run
    in-loop makes an ordinary call (CALL's handler, same operand layout),
    whose result the following RETURN returns."""
    def _reg_op_tailcall(frame: CallFrame, st: ExecState, w: int, pc: int) -> int {
        tc_a: int = (w >> 8) & 65535;
        tc_b: int = (w >> 24) & 65535;
        tc_c: int = (w >> 40) & 8388607;
        tc_orig: int = frame.func.rorig[pc - 1];
        va: JSValue = frame.locals[frame.lb + (tc_b & 32767)];
        if (tc_b & 32768) != 0 and js_is_tdz(va) {
            self._reg_tdz_throw(frame, st, tc_b & 32767, tc_orig);
            return 0;
        }
        tc_r: int = 0;
        if st.inline_depth > 0
            and (frame.func.code[tc_orig].arg3 & 8) == 0
            and len(frame.with_objs) == 0
            and len(frame.catch_stack) == 0
            and _reg_handler_at(frame.func, tc_orig) < 0
            and len(frame.dispose_stack) == 0
            and not frame.discard_ret
            and frame.this_binding_cell == 0
            and frame.post_fields == 0
            and not jsv_is_undefined(frame.ctor_this)
            and is_fn_val(va)
            and not is_native_val(va)
            and not js_is_proxy(va)
            and not jsv_is_htmldda(va) {
            tc_r = self._reg_tail_enter(frame, st, va, pc, tc_c, tc_orig);
        }
        if tc_r == 1 {
            return 1;
        }
        if tc_r == 2 {
            return 0;
        }
        if st.inline_depth == 0 {
            self._reg_bridge_call_op(
                frame, st, tc_orig, tc_a, tc_b & 32767, -1, pc, tc_c, 134
            );
        } else {
            self._reg_bridge_call_op(
                frame, st, tc_orig, tc_a, tc_b & 32767, -1, pc, tc_c, 57
            );
        }
        return 0;
    }

    """The register-ISA dispatch loop. Contracts shared with _exec: frames
    switch only in CALL / CALLM / RETURN and on an unwind; the handlers'
    `frame.ip` is a stack-instruction index (set before any call-out, so
    self-patching of code[ip - 1] and stack-trace lines work unchanged)
    while the register pc lives in `pc` (frame.rpc across calls); every
    opcode without a native case here runs its stack handler through the
    operand stack (_reg_bridge*). A catch inside this frame is signalled by
    reg_unwound (set by _unwind_in_frame) and consumed at the end of the
    dispatch that raised it. No reference-typed local is declared in the
    loop body (V0.2)."""
    def _exec_reg(frame: CallFrame) -> JSValue {
        st: ExecState = self._st_acquire();
        er_res: JSValue = self._exec_reg_resume(frame, st);
        if len(self.st_pool) < 64 {
            self.st_pool.append(st);
        }
        return er_res;
    }

    """An ExecState in its initial state: a pooled one reset field by field,
    else a new one (V4.22)."""
    def _st_acquire -> ExecState {
        if len(self.st_pool) > 0 {
            sa_st: ExecState = self.st_pool[len(self.st_pool) - 1];
            del self.st_pool[len(self.st_pool) - 1];
            sa_st.running = True;
            sa_st.ret = js_undefined();
            sa_st.tail_pending = False;
            sa_st.inline_depth = 0;
            sa_st.frame_switched = False;
            sa_st.allow_inline = False;
            return sa_st;
        }
        sn_st: ExecState = ExecState();
        sn_st.running = True;
        sn_st.ret = js_undefined();
        sn_st.allow_inline = False;
        return sn_st;
    }

    """The register loop proper, entered at frame.rpc. Its tail re-enters it
    when an exception that escaped this frame is caught by an in-loop
    caller (bounded by the try nesting of the frames involved)."""
    def _exec_reg_resume(frame: CallFrame, st: ExecState) -> JSValue {
        rc: list[int] = frame.func.rcode;
        code: list[Instruction] = frame.func.code;
        regs: list[JSValue] = frame.locals;
        if not frame.win {
            while len(regs) < frame.func.num_locals {
                regs.append(js_undefined());
            }
        }
        lb: int = frame.lb;
        n_rc: int = len(rc);
        pc: int = frame.rpc;
        # A resume in throw mode (_unwind_in_frame ran before this loop
        # started): continue at the handler it installed.
        if self.reg_unwound {
            self.reg_unwound = False;
            pc = frame.ip;
        }
        rlm: Realm = self.realm;
        dbg: bool = VM_DEBUG_MODE;
        w: int = 0;
        op: int = 0;
        a: int = 0;
        b: int = 0;
        c: int = 0;
        xi: int = 0;
        yi: int = 0;
        br: int = 0;
        cr: int = 0;
        va: JSValue = 0;
        vb: JSValue = 0;
        vr: JSValue = 0;
        fa: float = 0.0;
        fb: float = 0.0;
        res: bool = False;
        numeric: bool = False;
        ok: bool = False;
        # One flag for the rare per-dispatch work (V4.25): realm.safepoint_req
        # (GC / exit safepoint), also raised by _unwind_in_frame for a catch
        # in this frame and held while the debug trace runs.
        if dbg {
            rlm.safepoint_req = True;
        }
        while st.running {
            if rlm.safepoint_req {
                # a catch inside this frame by the previous dispatch: resume
                # at the handler's register pc (R_LANDING pops the exception)
                if self.reg_unwound {
                    self.reg_unwound = False;
                    pc = frame.ip;
                }
                self._loop_safepoint(st);
                if dbg {
                    self._reg_trace(frame, pc, rc[pc]);
                    rlm.safepoint_req = True;
                }
            }
            w = rc[pc];
            op = w & 255;
            pc = pc + 1;
            if op < 50 {
                if op == 20 or op == 21 {
                    # ADD / SUB dst, a, b
                    b = (w >> 24) & 65535;
                    c = (w >> 40) & 8388607;
                    va = regs[lb + (b & 32767)];
                    vb = regs[lb + (c & 32767)];
                    if jsv_is_int32(va) and jsv_is_int32(vb) {
                        if op == 20 {
                            xi = jsv_to_int32(va) + jsv_to_int32(vb);
                        } else {
                            xi = jsv_to_int32(va) - jsv_to_int32(vb);
                        }
                        if xi >= -2147483648 and xi <= 2147483647 {
                            regs[lb + ((w >> 8) & 65535)] = js_int(xi);
                        } else {
                            regs[lb + ((w >> 8) & 65535)] = js_number(float(xi));
                        }
                    } elif (jsv_is_int32(va) or jsv_is_double(va))
                        and (jsv_is_int32(vb) or jsv_is_double(vb)) {
                        # Number + Number: no ToPrimitive can run (js_add's own
                        # tail for two numbers).
                        if jsv_is_int32(va) {
                            fa = float(jsv_to_int32(va));
                        } else {
                            fa = jsv_to_double(va);
                        }
                        if jsv_is_int32(vb) {
                            fb = float(jsv_to_int32(vb));
                        } else {
                            fb = jsv_to_double(vb);
                        }
                        if op == 20 {
                            regs[lb + ((w >> 8) & 65535)] = float_to_jsval(fa + fb);
                        } else {
                            regs[lb + ((w >> 8) & 65535)] = float_to_jsval(fa - fb);
                        }
                    } elif (b & 32768) != 0 and js_is_tdz(va) {
                        self._reg_tdz_throw(
                            frame, st, b & 32767, frame.func.rorig[pc - 1]
                        );
                    } elif (c & 32768) != 0 and js_is_tdz(vb) {
                        self._reg_tdz_throw(
                            frame, st, c & 32767, frame.func.rorig[pc - 1]
                        );
                    } elif op == 20
                        and (jsv_is_string_cell(va) or jsv_is_string_cell(vb))
                        and _vm_add_prim(va)
                        and _vm_add_prim(vb) {
                        # String + primitive: concatenation (js_add's string
                        # tail), no ToPrimitive or Symbol throw possible.
                        regs[lb + ((w >> 8) & 65535)] = js_add(va, vb);
                    } else {
                        self._reg_bridge(
                            frame,
                            st,
                            frame.func.rorig[pc - 1],
                            2,
                            va,
                            vb,
                            0,
                            (w >> 8) & 65535,
                            1
                        );
                    }
                } elif op >= 22 and op <= 31 {
                    # MUL DIV MOD POW BAND BOR BXOR SHL SHR USHR dst, a, b
                    b = (w >> 24) & 65535;
                    c = (w >> 40) & 8388607;
                    va = regs[lb + (b & 32767)];
                    vb = regs[lb + (c & 32767)];
                    vr = jsv_hole();
                    if jsv_is_int32(va)
                        and jsv_is_int32(vb)
                        and op != 23
                        and op != 25 {
                        xi = jsv_to_int32(va);
                        yi = jsv_to_int32(vb);
                        if op == 26 {
                            vr = js_int(xi & yi);
                        } elif op == 27 {
                            vr = js_int(xi | yi);
                        } elif op == 28 {
                            vr = js_int(xi ^ yi);
                        } elif op == 30 {
                            vr = js_int(xi >> (yi & 31));
                        } elif op == 29 {
                            xi = (xi << (yi & 31)) & 4294967295;
                            if xi > 2147483647 {
                                xi = xi - 4294967296;
                            }
                            vr = js_int(xi);
