    """Advance a `{__I, __J}` array/string/Set/Map iterator and return its
    result object { value, done }. Enforces the receiver brand check
    (§23.2.5.2.1 etc.): a receiver lacking the iterator's internal slots is a
    TypeError, raised on the native-exception channel. Shared by the inline
    CALL_METHOD path and the .call/.apply path so they cannot diverge."""
    def _vm_iter_next_result(iter: JSValue) -> JSValue {
        if not (
            jsv_is_object_cell(iter)
            and jsv_to_table_id(iter) > 0
            and js_object_has_own(iter, WK_I)
            and js_object_has_own(iter, WK_J)
        ) {
            vm_throw_native(
                make_type_error(
                    "Iterator.prototype.next called on incompatible receiver"
                )
            );
            return js_undefined();
        }
        it_src: JSValue = js_object_get(iter, WK_I);
        it_idx_v: JSValue = js_object_get(iter, WK_J);
        it_idx: int = 0;
        if jsv_is_int32(it_idx_v) {
            it_idx = jsv_to_int32(it_idx_v);
        } elif jsv_is_double(it_idx_v) {
            it_idx = int(jsv_to_double(it_idx_v));
        }
        it_len: int = js_array_len(it_src);
        it_result: JSValue = js_object_create_null();
        if it_idx < it_len {
            it_val: JSValue = js_array_get(it_src, it_idx);
            js_object_set(iter, WK_J, js_int(it_idx + 1));
            js_object_set(it_result, WK_VALUE, it_val);
            js_object_set(it_result, WK_DONE, js_false());
        } else {
            js_object_set(it_result, WK_VALUE, js_undefined());
            js_object_set(it_result, WK_DONE, js_true());
        }
        return it_result;
    }

    def _op_call_method(frame: CallFrame, ins: Instruction, st: ExecState) -> None {
        nc_m: int = ins.arg;
        # Plain JS method call `recv.m(args)`: the stack holds method, receiver,
        # args. A closure method that is not NAPI / bound / generator / async (and
        # not a class constructor, which the general path rejects first) is what the
        # general path below hands to _inline_call with `this` = the receiver —
        # inline it from the stack without building an argument list.
        if (ins.arg3 & 8) == 0 {
            fm_sl: int = len(self.stack) - nc_m - 2;
            if fm_sl >= 0 {
                fm_meth: JSValue = self.stack[fm_sl];
                if is_native_val(fm_meth) {
                    if self._native_fast_call(frame, fm_sl, nc_m, st) {
                        return;
                    }
                } elif not jsv_is_htmldda(fm_meth)
                    and not (
                        jsv_is_object_cell(fm_meth)
                        and jsv_to_table_id(fm_meth) > 0
                        and js_object_has_own(fm_meth, KEY_CTOR_KIND)
                    )
                    and is_fn_val(fm_meth) {
                    # Borrowed closure, as in _op_call's fast path.
                    if self._reg_ready(self.realm.closures[get_fn_idx(fm_meth)].func) {
                        if self._reg_call_from_stack(
                            self.realm.closures[get_fn_idx(fm_meth)],
                            fm_meth,
                            self.stack[fm_sl + 1],
                            nc_m,
                            2,
                            frame,
                            st
                        ) {
