# N-API (native `.node` addon) support is INCOMPLETE and disabled by default.
# Parts of the JS↔native callback bridge are unimplemented, so loading a real
# addon would call into missing code paths. Until it is finished, both addon
# entry points (require("x.node") and the module-extension dispatch kind) refuse
# up front with a clear error instead of half-initializing. Flip to True only
# for development of the napi layer itself.
glob _NAPI_ENABLED: bool = True,
     _DBG_SETREC_COUNT: int = 0;

# JAC_DBG_SETREC probe counter (module glob, NOT a VM field — avoids ABI/scrub).
def _vm_dbg_setrec_bump {
    _DBG_SETREC_COUNT = _DBG_SETREC_COUNT + 1;
}

"""Throw the standard 'N-API disabled' error into the given VM and mark it.
Returns js_undefined() so callers can `return _napi_disabled_throw(...)`."""
def _napi_disabled_throw(vm: VM) -> JSValue {
    exc_napi: JSValue = make_error(
        "N-API native addon support is incomplete and turned off by default "
            + "in this build (loading .node addons is not supported yet)."
    );
    vm.had_exception = True;
    vm.pending_exc = exc_napi;
    return js_undefined();
}

# ══════════════════════════════════════════════════════════════════════════════
# Debug tracing
# ══════════════════════════════════════════════════════════════════════════════

"""Set to True to enable opcode-level VM execution tracing.
Flip to False to silence output for production runs."""
glob VM_DEBUG_MODE: bool = False;

# Phase 4 — monomorphic GET_PROP/SET_PROP inline cache. Default-on through
# the JS_IC gate in init_global (JS_IC=0 turns it off); this glob value only
# covers the time before init_global runs. Turning it on was checked on
# 2026-10-02: test262 0 regressions over ~18K property-access tests, vite
# output identical, wall time neutral (docs/VM_REARCH_PLAN.md V0.5, V4).
glob:pub VM_IC_ENABLED: bool = False;

def:pub vm_ic_enable {
    VM_IC_ENABLED = True;
}
def:pub vm_ic_disable {
    VM_IC_ENABLED = False;
}
"""Whether the property ICs are on (read back by feature_gates_report)."""
def:pub vm_ic_enabled -> bool {
    return VM_IC_ENABLED;
}

# Megamorphic GET cache: a global direct-mapped table (receiver shape,
# receiver [[Prototype]], key) → where the value lives, filled wherever a
# GET_PROP instruction's own monomorphic IC is filled (same eligibility) and
# probed when that IC misses. Rollup's AST visitors read the same keys on
# dozens of node classes, so their sites never stay monomorphic: ~16M GET_PROP
# misses per jac_client build each paid a full prototype-chain walk and an IC
# refill. Location: holder << 32 | packed slot, holder 0 = the receiver (own
# data, valid while the shape matches); an inherited entry is also stamped
# with the proto epoch and re-checks the receiver like the inherited-data IC.
# Location -1: the key resolves to an inlinable getter, _MGC_FN (stamped with
# the proto epoch like an inherited entry — see VM._getter_ic_call).
glob _MGC_MASK: int = 65535,
     _MGC_SID: list[int] = [],
     _MGC_PROTO: list[int] = [],
     _MGC_KEY: list[int] = [],
     _MGC_LOC: list[int] = [],
     _MGC_EPOCH: list[int] = [],
     _MGC_FN: list[JSValue] = [];

def _mgc_init {
    mgi: int = 0;
    while mgi <= _MGC_MASK {
        _MGC_SID.append(-2);
        _MGC_PROTO.append(-2);
        _MGC_KEY.append(0);
        _MGC_LOC.append(0);
        _MGC_EPOCH.append(-1);
        _MGC_FN.append(0);
        mgi = mgi + 1;
    }
}

# Megamorphic SET caches (shape-keyed, no site): _MSC_* — an own writable
# data slot of shape `sid` for `key` (valid for as long as the shape exists:
# layouts and attributes are immutable per shape); _MAC_* — the leaf add
# `key` on shape `sid` transitions to (shape after), stamped with the proto
# epoch of the fill (as the holder-4 IC is). Filled where _set_prop_ic_fill
# fills the monomorphic ICs; probed by SETFIELD after those miss.
glob _MSC_MASK: int = 16383,
     _MSC_SID: list[int] = [],
     _MSC_KEY: list[int] = [],
     _MSC_LOC: list[int] = [],
     _MAC_SID: list[int] = [],
     _MAC_KEY: list[int] = [],
     _MAC_AFTER: list[int] = [],
     _MAC_EPOCH: list[int] = [];

def _msc_init {
    msi: int = 0;
    while msi <= _MSC_MASK {
        _MSC_SID.append(-2);
        _MSC_KEY.append(0);
        _MSC_LOC.append(0);
        _MAC_SID.append(-2);
        _MAC_KEY.append(0);
        _MAC_AFTER.append(0);
        _MAC_EPOCH.append(-1);
        msi = msi + 1;
    }
}

def _msc_slot(sid: int, key: int) -> int {
    return ((sid * 40503) ^ key) & _MSC_MASK;
}

def _msc_put(sid: int, key: int, packed: int) {
    if len(_MSC_SID) == 0 {
        _msc_init();
    }
    mp_h: int = _msc_slot(sid, key);
    _MSC_SID[mp_h] = sid;
    _MSC_KEY[mp_h] = key;
    _MSC_LOC[mp_h] = packed;
}

def _mac_put(sid_before: int, key: int, sid_after: int, epoch: int) {
    if len(_MSC_SID) == 0 {
        _msc_init();
    }
    ma_h: int = _msc_slot(sid_before, key);
    _MAC_SID[ma_h] = sid_before;
    _MAC_KEY[ma_h] = key;
    _MAC_AFTER[ma_h] = sid_after;
    _MAC_EPOCH[ma_h] = epoch;
}

"""SETFIELD after the own-slot IC miss: the add-transition IC, then the
megamorphic caches, on one shape read of the receiver."""
def _vm_set_probe(ins: Instruction, rv: JSValue, val: JSValue) -> bool {
    sp_sid: int = js_object_ic_shape(rv);
    if sp_sid < 0 {
        return False;
    }
    if _vm_set_ic_add(ins, rv, val, sp_sid) {
        return True;
    }
    return _vm_set_mega(ins, rv, val, sp_sid);
}

"""SET_PROP's megamorphic caches on receiver `rv` for a plain, cached-key
[[Set]]: an own writable data slot of its shape, or the leaf add its shape
transitions to while the proto epoch is the fill's."""
def _vm_set_mega(ins: Instruction, rv: JSValue, val: JSValue, sm_sid: int) -> bool {
    if not VM_IC_ENABLED or ins.arg3 < 2 or (ins.arg3 & 3) != 0 or len(_MSC_SID) == 0 {
        return False;
    }
    sm_key: int = ins.arg3 >> 2;
    if not _vm_ic_key_ok(sm_key) {
        return False;
    }
    if sm_sid < 0 {
        return False;
    }
    sm_h: int = _msc_slot(sm_sid, sm_key);
    if _MSC_SID[sm_h] == sm_sid and _MSC_KEY[sm_h] == sm_key {
        js_object_slot_set_at_id(jsv_to_table_id(rv), _MSC_LOC[sm_h] // 16, val);
        return True;
    }
    if _MAC_SID[sm_h] == sm_sid
        and _MAC_KEY[sm_h] == sm_key
        and _MAC_EPOCH[sm_h] == proto_epoch() {
        sm_raw: JSObject = js_object_table_get(jsv_to_table_id(rv));
        if not sm_raw.is_ext() {
            return False;
        }
        sm_raw.shape_id = _MAC_AFTER[sm_h];
        sm_raw.slots.append(val);
        sm_raw.version = sm_raw.version + 1;
        if (sm_raw.cell_flags & FLAG_IS_PROTO) != 0 {
            proto_epoch_bump();
        }
        return True;
    }
    return False;
}

def _mgc_slot(sid: int, proto: int, key: int) -> int {
    return ((sid * 40503) ^ (proto * 7919) ^ key) & _MGC_MASK;
}

"""Record where `key` lives for receivers of shape `sid` and [[Prototype]]
`proto`: `holder` 0 for an own data slot, else the holder's table id (then
`epoch` is the proto epoch the walk was valid for)."""
def _mgc_put(sid: int, proto: int, key: int, holder: int, packed: int, epoch: int) {
    if len(_MGC_SID) == 0 {
        _mgc_init();
    }
    mp_h: int = _mgc_slot(sid, proto, key);
    _MGC_SID[mp_h] = sid;
    _MGC_PROTO[mp_h] = proto;
    _MGC_KEY[mp_h] = key;
    _MGC_LOC[mp_h] = (holder << 32) | packed;
    _MGC_EPOCH[mp_h] = epoch;
}

"""Record that `key` on receivers of shape `sid` and [[Prototype]] `proto`
resolves to the inlinable getter `fn` while the proto epoch is `epoch`."""
def _mgc_put_getter(sid: int, proto: int, key: int, fn: JSValue, epoch: int) {
    if len(_MGC_SID) == 0 {
        _mgc_init();
    }
    mpg_h: int = _mgc_slot(sid, proto, key);
    _MGC_SID[mpg_h] = sid;
    _MGC_PROTO[mpg_h] = proto;
    _MGC_KEY[mpg_h] = key;
    _MGC_LOC[mpg_h] = -1;
    _MGC_EPOCH[mpg_h] = epoch;
    _MGC_FN[mpg_h] = fn;
}

"""The getter the megamorphic cache records for `key` on `rv` (shape `sid`),
or the hole."""
def _vm_mgc_getter(key: int, rv: JSValue, sid: int) -> JSValue {
    if len(_MGC_SID) == 0 {
        return jsv_hole();
    }
    mgg_id: int = jsv_to_table_id(rv);
    mgg_proto: int = js_object_proto_idx_id(mgg_id);
    mgg_h: int = _mgc_slot(sid, mgg_proto, key);
    if _MGC_LOC[mgg_h] != -1
        or _MGC_SID[mgg_h] != sid
        or _MGC_KEY[mgg_h] != key
        or _MGC_PROTO[mgg_h] != mgg_proto
        or _MGC_EPOCH[mgg_h] != proto_epoch() {
        return jsv_hole();
    }
    if not js_object_proto_ic_ok(mgg_id, mgg_proto) {
        return jsv_hole();
    }
    return _MGC_FN[mgg_h];
}

"""GET_PROP value of `key` on `rv` from the megamorphic cache, or the hole."""
def _vm_mgc_get(key: int, rv: JSValue) -> JSValue {
    if len(_MGC_SID) == 0 or key == 0 or not _vm_ic_key_ok(key) {
        return jsv_hole();
    }
    return _vm_mgc_get_sid(key, rv, js_object_ic_shape(rv));
}

"""The register GETFIELD's cached reads in one call (V4.15): the site's own-slot
IC (one table access), else — on ONE shape read of the receiver — its
inherited-slot IC and the megamorphic cache. The hole on a miss."""
def _vm_get_cached(ins: Instruction, rv: JSValue) -> JSValue {
    if not VM_IC_ENABLED or ins.arg2 == 0 {
        return jsv_hole();
    }
    if ins.ic_holder == 1 and ins.ic_obj > 0 {
        gc_v: JSValue = js_object_ic_hit(rv, ins.ic_obj, ins.ic_ver // 16);
        if not jsv_is_hole(gc_v) {
            return gc_v;
        }
    }
    if not _vm_ic_key_ok(ins.arg2) {
        return jsv_hole();
    }
    gc_sid: int = js_object_ic_shape(rv);
    if gc_sid < 0 {
        return jsv_hole();
    }
    if ins.ic_holder < 0
        and gc_sid == ins.ic_obj
        and ins.ic_epoch == proto_epoch()
        and js_object_proto_ic_ok(jsv_to_table_id(rv), 0 - ins.ic_holder) {
        return js_object_slot_at_id(ins.ic_ver >> 32, (ins.ic_ver & 4294967295) // 16);
    }
    if len(_MGC_SID) == 0 {
        return jsv_hole();
    }
    return _vm_mgc_get_sid(ins.arg2, rv, gc_sid);
}

"""_vm_mgc_get with the receiver's shape id already read (-1: not cacheable)."""
def _vm_mgc_get_sid(key: int, rv: JSValue, mg_sid: int) -> JSValue {
    if mg_sid < 0 {
        return jsv_hole();
    }
    mg_id: int = jsv_to_table_id(rv);
    mg_proto: int = js_object_proto_idx_id(mg_id);
    mg_h: int = _mgc_slot(mg_sid, mg_proto, key);
    if _MGC_SID[mg_h] != mg_sid
        or _MGC_KEY[mg_h] != key
        or _MGC_PROTO[mg_h] != mg_proto {
        return jsv_hole();
    }
    mg_loc: int = _MGC_LOC[mg_h];
    if mg_loc < 0 {
        return jsv_hole();
    }  # a getter entry
    mg_holder: int = mg_loc >> 32;
    if mg_holder == 0 {
        return js_object_slot_at_id(mg_id, (mg_loc & 4294967295) // 16);
    }
    if _MGC_EPOCH[mg_h] != proto_epoch()
        or not js_object_proto_ic_ok(mg_id, mg_proto) {
        return jsv_hole();
    }
    return js_object_slot_at_id(mg_holder, (mg_loc & 4294967295) // 16);
}

# typeof results as string values, interned once (js_str interned the name
# on every typeof: a string hash + compare per evaluation).
glob _TYPEOF_NAMES: list[str] = [],
     _TYPEOF_VALS: list[JSValue] = [];

def _vm_typeof_str(name: str) -> JSValue {
    if len(_TYPEOF_NAMES) == 0 {
        for tn in [
            "undefined",
            "object",
            "boolean",
            "number",
            "string",
            "function",
            "symbol",
            "bigint"
        ] {
            _TYPEOF_NAMES.append(tn);
            _TYPEOF_VALS.append(js_str(tn));
        }
    }
    ts_i: int = 0;
    while ts_i < len(_TYPEOF_NAMES) {
        if _TYPEOF_NAMES[ts_i] == name {
            return _TYPEOF_VALS[ts_i];
        }
        ts_i = ts_i + 1;
    }
    return js_str(name);
}

# _has_default_iter's cache: the plain-array shape (`length` only), and
# where Array.prototype held its default @@iterator when last confirmed.
glob _HDI_ARR_SHAPE: int = -1,
     _HDI_AP_SHAPE: int = -2,
     _HDI_AP_SLOT: int = 0,
     _HDI_AP_FN: JSValue = 0,
     _FRAME_POOL_MAX: int = 256,
     _GETTER_IC_TAG: int = 1099511627776,
     _GETTER_IC_NONE: int = 7,
     _ITER_STD_SHAPE: int = -1,
     _ITER_STD_I: int = -1,
     _ITER_STD_J: int = -1;

# Frames kept for reuse by later calls (VM.frame_pool). Native ↔ JS recursion
# deeper than the pool emptied it, and every deeper call then built a frame
# and its bookkeeping lists from scratch.

# GET_PROP getter IC markers (see VM._getter_ic_call).
# 2^40: above any table id

# Layout of GET_ITER's standard iterator (a null-prototype object with
# exactly __I then __J), learned from the first one built — see
# _op_iter_next's shape fast path. Shapes are immutable and never freed.
def _iter_std_learn(it: JSValue) {
    isl_i: int = js_object_own_data_slot(it, WK_I);
    isl_j: int = js_object_own_data_slot(it, WK_J);
    isl_s: int = js_object_ic_shape(it);
    if isl_i >= 0 and isl_j >= 0 and isl_s > 0 {
        _ITER_STD_I = isl_i;
        _ITER_STD_J = isl_j;
        _ITER_STD_SHAPE = isl_s;
    }
}

"""Keys whose reads must always take _op_get_prop's full path (the
caller/arguments/callee poison pills and arguments-object rules run before
any cached read)."""
def _vm_ic_key_ok(k: int) -> bool {
    return k != WK_CALLER and k != WK_ARGUMENTS and k != WK_CALLEE;
}

"""_vm_ic_key_ok for receiver `v`: `callee` / `arguments` are ordinary keys
on an ordinary object cell (not an arguments object — mapped ones are dict
mode, strict ones have accessor shapes — and not a class object, whose
inherited caller/arguments are %ThrowTypeError%). Rollup's AST nodes read
node.callee / node.arguments constantly."""
def _vm_ic_key_ok_obj(k: int, v: JSValue) -> bool {
    if k != WK_ARGUMENTS and k != WK_CALLEE {
        return _vm_ic_key_ok(k);
    }
    if not jsv_is_object_cell(v) or jsv_to_table_id(v) <= 0 {
        return False;
    }
    return (
        js_object_table_get(jsv_to_table_id(v)).cell_flags
        & (FLAG_IS_ARGUMENTS | FLAG_IS_CLASS)
    )
        == 0;
}

"""_vm_set_ic_hit's instruction-side conditions alone (the receiver test
is js_object_ic_set_hit's, which also does the write)."""
def _vm_set_ic_ok(ins: Instruction) -> bool {
    return VM_IC_ENABLED
        and ins.ic_holder == 2
        and ins.arg3 >= 2
        and (ins.arg3 & 1) == 0
        and _vm_ic_key_ok(ins.arg3 >> 2)
        and ins.ic_obj > 0;
}

"""True when SET_PROP `ins` has a filled own-slot IC (ic_holder 2: an
existing writable own data property) that receiver `rv`'s shape matches —
the hit test at the top of _op_set_prop, for a plain [[Set]] (arg3 cached,
not a define-own; the IC is never filled for private names) of an ordinary
key. On True the caller stores into slot ins.ic_ver // 16 of rv."""
def _vm_set_ic_hit(ins: Instruction, rv: JSValue) -> bool {
    return VM_IC_ENABLED
        and ins.ic_holder == 2
        and ins.arg3 >= 2
        and (ins.arg3 & 1) == 0
        and _vm_ic_key_ok(ins.arg3 >> 2)
        and ins.ic_obj > 0
        and js_object_ic_shape(rv) == ins.ic_obj;
}

"""SET_PROP's transition ICs replayed on receiver `rv`: ic_holder 3 (an
object-literal / class-field define-own leaf add) or 4 (a [[Set]] leaf add
while the proto epoch is the fill's), as _op_set_prop replays them. True when
`val` was appended under the cached after-shape; a function value on a
define-own keeps the handler (its [[HomeObject]] wiring)."""
def _vm_set_ic_add(ins: Instruction, rv: JSValue, val: JSValue, sa_sid: int) -> bool {
    if not VM_IC_ENABLED or ins.arg3 < 2 {
        return False;
    }
    if ins.ic_holder == 4 {
        if (ins.arg3 & 1) != 0 or ins.ic_epoch != proto_epoch() {
            return False;
        }
    } elif ins.ic_holder == 3 {
        if (ins.arg3 & 1) == 0 or is_fn_val(val) {
            return False;
        }
    } else {
        return False;
    }
    if sa_sid < 0 or sa_sid != ins.ic_obj {
        return False;
    }
    sa_raw: JSObject = js_object_table_get(jsv_to_table_id(rv));
    if not sa_raw.is_ext() {
        return False;
    }
    sa_raw.shape_id = ins.ic_ver;
    sa_raw.slots.append(val);
    sa_raw.version = sa_raw.version + 1;
    if (sa_raw.cell_flags & FLAG_IS_PROTO) != 0 {
        proto_epoch_bump();
    }
    return True;
}

"""ToInt32 (§7.1.6) of a double: truncate, then modulo 2^32 into the
signed range; NaN and the infinities are 0. Exact for every double (the
reduction of |d| >= 2^53, where d is integral, subtracts a multiple of 2^32
computed without leaving doubles)."""
def _vm_f64_to_int32(d: float) -> int {
    if d != d or d == MATH_INF or d == -MATH_INF {
        return 0;
    }
    ti_t: float = d;
    if ti_t >= 9.0e15 or ti_t <= -9.0e15 {
        ti_q: float = ti_t / 4294967296.0;
        if ti_q < 4503599627370496.0 and ti_q > -4503599627370496.0 {
            ti_q = float(int(ti_q));
        }
        ti_t = ti_t - ti_q * 4294967296.0;
    }
    ti_i: int = int(ti_t) & 4294967295;
    if ti_i > 2147483647 {
        ti_i = ti_i - 4294967296;
    }
    return ti_i;
}

"""An operand a bitwise op converts without running user code: a Number,
a Boolean, undefined or null."""
def _vm_bit_simple(v: JSValue) -> bool {
    return jsv_is_int32(v)
        or jsv_is_double(v)
        or jsv_is_bool(v)
        or jsv_is_undefined(v)
        or jsv_is_null(v);
}

def _vm_bit_val(v: JSValue) -> int {
    if jsv_is_int32(v) {
        return jsv_to_int32(v);
    }
    if jsv_is_double(v) {
        return _vm_f64_to_int32(jsv_to_double(v));
    }
    if jsv_is_bool(v) and jsv_to_bool(v) {
        return 1;
    }
    return 0;
}

"""BAND BOR BXOR SHL SHR USHR (ops 26..31) of two simple operands
(_vm_bit_simple), or the hole (the handler: strings, objects, BigInts)."""
def _vm_bitop(op: int, va: JSValue, vb: JSValue) -> JSValue {
    if not (_vm_bit_simple(va) and _vm_bit_simple(vb)) {
        return jsv_hole();
    }
    bo_x: int = _vm_bit_val(va);
    bo_y: int = _vm_bit_val(vb);
    if op == 26 {
        return js_int(bo_x & bo_y);
    }
    if op == 27 {
        return js_int(bo_x | bo_y);
    }
    if op == 28 {
        return js_int(bo_x ^ bo_y);
    }
    if op == 30 {
        return js_int(bo_x >> (bo_y & 31));
    }
    if op == 29 {
        bo_x = (bo_x << (bo_y & 31)) & 4294967295;
        if bo_x > 2147483647 {
            bo_x = bo_x - 4294967296;
        }
        return js_int(bo_x);
    }
    bo_x = (bo_x & 4294967295) >> (bo_y & 31);
    if bo_x > 2147483647 {
        return js_number(float(bo_x));
    }
    return js_int(bo_x);
}

"""DIV (op 23) / MOD (op 24) of two Numbers — _op_div's and _op_mod's
tails (NaN, ±0 divisor sign rule, infinite operands, truncating remainder
with the dividend's sign on a zero result)."""
def _vm_num_divmod(op: int, va: JSValue, vb: JSValue) -> JSValue {
    dm_a: float = 0.0;
    dm_b: float = 0.0;
    if jsv_is_int32(va) {
        dm_a = float(jsv_to_int32(va));
    } else {
        dm_a = jsv_to_double(va);
    }
    if jsv_is_int32(vb) {
        dm_b = float(jsv_to_int32(vb));
    } else {
        dm_b = jsv_to_double(vb);
    }
    if not (dm_a == dm_a) or not (dm_b == dm_b) {
        return js_nan();
    }
    if op == 23 {
        if dm_b == 0.0 {
            if dm_a == 0.0 {
                return js_nan();
            }
            if (dm_a < 0.0) != (__float_bits(dm_b) < 0) {
                return js_neg_infinity();
            }
            return js_infinity();
        }
        return float_to_jsval(dm_a / dm_b);
    }
    dm_inf: float = MATH_INF;
    if dm_a == dm_inf or dm_a == -dm_inf or dm_b == 0.0 {
        return js_nan();
    }
    if dm_b == dm_inf or dm_b == -dm_inf {
        return float_to_jsval(dm_a);
    }
    # fmod: exact, sign of the dividend (a zero result keeps it: -1 % 1 is -0)
    dm_r: float = fmod(dm_a, dm_b);
    if dm_r == 0.0 and __float_bits(dm_a) < 0 {
        return js_number(-0.0);
    }
    return float_to_jsval(dm_r);
}

"""GET_PROP's allocation-free answers the property ICs never cover, or the
hole: a string's `length` and String.prototype's own data properties (its
methods), and an array's `length` — what _op_get_prop pushes for these
receivers. `key` is the cached intern id (0 = not yet cached)."""
def _vm_prim_get(key: int, rv: JSValue) -> JSValue {
    if key == 0 {
        return jsv_hole();
    }
    if jsv_is_string_cell(rv) {
        if key == WK_LENGTH {
            return js_int(js_string_utf16_len_cell(jsv_to_table_id(rv)));
        }
        pg_sp: JSValue = js_string_get_proto();
        if jsv_is_undefined(pg_sp) {
            return jsv_hole();
        }
        return js_object_get_ordinary(pg_sp, key);
    }
    if key == WK_LENGTH and js_is_array(rv) {
        return js_object_get(rv, WK_LENGTH);
    }
    return jsv_hole();
}

"""`sv[idx]` for a string `sv` and a non-negative int index: the UTF-16 unit
as a one-unit string, or undefined past the end (_op_get_index's string
branch)."""
def _vm_string_index(sv: JSValue, idx: int) -> JSValue {
    si_sid: int = jsv_to_table_id(sv);
    if str_cell_ascii(si_sid) == 1 {
        si_s: str = str_from_id(si_sid);
        if idx < len(si_s) {
            return js_str(str_char_at(si_s, idx));
        }
        return js_undefined();
    }
    si_u: int = js_string_unit_at_cell(si_sid, idx);
    if si_u < 0 {
        return js_undefined();
    }
    return js_str(js_string_unit_str(si_u));
}

"""The register pc of the handler covering stack instruction `orig` of a
register-ISA function with a handler table, -1 for none / no table."""
def _reg_handler_at(fn: CompiledFunction, orig: int) -> int {
    if orig < 0 or orig >= len(fn.rhandler) {
        return -1;
    }
    return fn.rhandler[orig];
}

"""An ADD operand next to a string that needs no ToPrimitive and cannot
throw: not an object, a callable or a Symbol."""
def _vm_add_prim(v: JSValue) -> bool {
    return not (
        jsv_is_object_cell(v) or is_fn_val(v) or is_native_val(v) or jsv_is_symbol(v)
    );
}

"""True when `a == b` cannot run user code: both operands primitives (no
ToPrimitive) or both objects / callables (identity) — _abstract_equal then
answers without side effects."""
def _vm_eq_simple(a: JSValue, b: JSValue) -> bool {
    es_a: bool = jsv_is_object_cell(a) or is_fn_val(a) or is_native_val(a);
    es_b: bool = jsv_is_object_cell(b) or is_fn_val(b) or is_native_val(b);
    return es_a == es_b;
}

"""`fn` is a closure whose @@hasInstance is %Function.prototype%'s default, so
`v instanceof fn` is OrdinaryHasInstance (no user code before the
prototype walk)."""
def _vm_instanceof_plain(fn: JSValue) -> bool {
    ip_h: JSValue = _fn_prop(fn, SYMBOL_KEY_BASE + SYMBOL_HAS_INSTANCE);
    return is_native_val(ip_h) and get_native_kind(ip_h) == NATIVE_KIND_FN_HAS_INSTANCE;
}

"""GET_PROP on an object cell without user code, or the hole: the ordinary
data-property chain walk (js_object_get_ordinary — hole for accessors and
exotics) on a plain object: no brand (arrays, maps, promises, env, … keep
_op_get_prop's branches), not a class (static inheritance through a
plain-function heritage), not `__proto__`, and not `next` on the standard
{__I, __J} iterator (a native singleton there)."""
def _vm_obj_get_plain(rv: JSValue, key: int) -> JSValue {
    og_id: int = jsv_to_table_id(rv);
    if og_id <= 0 or key == KEY_PROTO or js_object_brand(rv) != 0 {
        return jsv_hole();
    }
    if (js_object_table_get(og_id).cell_flags & FLAG_IS_CLASS) != 0 {
        return jsv_hole();
    }
    og_v: JSValue = js_object_get_ordinary(rv, key);
    if key == WK_NEXT and jsv_is_undefined(og_v) {
        return jsv_hole();
    }
    return og_v;
}

"""GET_PROP on a closure value for an ordinary key (not the caller /
arguments / callee poison pills): _fn_prop's answer, or the hole when it is
undefined (an accessor in fn_props may still apply — the handler's job)."""
def _vm_fn_get_plain(fv: JSValue, key: int) -> JSValue {
    fg_v: JSValue = _fn_prop(fv, key);
    if jsv_is_undefined(fg_v) {
        return jsv_hole();
    }
    return fg_v;
}

"""`cls` is a class object whose @@hasInstance resolves (data chain walk) to
%Function.prototype%'s default."""
def _vm_instanceof_class(cls: JSValue) -> bool {
    ic_id: int = jsv_to_table_id(cls);
    if ic_id <= 0 or (js_object_table_get(ic_id).cell_flags & FLAG_IS_CLASS) == 0 {
        return False;
    }
    ic_h: JSValue = js_object_get_ordinary(cls, SYMBOL_KEY_BASE + SYMBOL_HAS_INSTANCE);
    return is_native_val(ic_h) and get_native_kind(ic_h) == NATIVE_KIND_FN_HAS_INSTANCE;
}

"""`o[k]` for an object cell `o` and a string `k` without user code: the
ordinary data-property chain walk, or the hole when an accessor, an exotic
object or a class object (its static-inheritance fallback in _op_get_index)
is involved."""
def _vm_get_index_str(o: JSValue, k: JSValue) -> JSValue {
    if js_object_brand(o) != 0 {
        return jsv_hole();
    }
    gs_v: JSValue = js_object_get_ordinary(o, jsval_to_prop_key(k));
    if jsv_is_undefined(gs_v)
        and jsv_to_table_id(o) > 0
        and (js_object_table_get(jsv_to_table_id(o)).cell_flags & FLAG_IS_CLASS) != 0 {
        return jsv_hole();
    }
    return gs_v;
}

"""The value a GET_PROP's filled property IC gives for receiver `rv`, or the
hole on a miss — the same two hit tests that open _op_get_prop: an own data
slot of the cached shape (ic_holder 1), or an inherited data slot on the
cached holder while the receiver's shape and [[Prototype]] and every
prototype are unchanged (ic_holder < 0, proto epoch). Scalar table reads
only, so _exec can try it before paying for the handler."""
def _vm_ic_probe(ins: Instruction, rv: JSValue) -> JSValue {
    if not VM_IC_ENABLED or ins.arg2 == 0 {
        return jsv_hole();
    }
    if ins.ic_holder == 1 {
        # (an own-slot fill only exists for keys _vm_ic_key_ok_obj allowed
        # on a receiver of this exact shape)
        if ins.ic_obj > 0 {
            return js_object_ic_hit(rv, ins.ic_obj, ins.ic_ver // 16);
        }
    } elif ins.ic_holder < 0
        and ins.ic_epoch == proto_epoch()
        and _vm_ic_key_ok(ins.arg2) {
        ipr_sid: int = js_object_ic_shape(rv);
        if ipr_sid >= 0
            and ipr_sid == ins.ic_obj
            and js_object_proto_ic_ok(jsv_to_table_id(rv), 0 - ins.ic_holder) {
            return js_object_slot_at_id(
                ins.ic_ver >> 32, (ins.ic_ver & 4294967295) // 16
            );
        }
    }
    return jsv_hole();
}

"""Shape id for the property ICs, or -1 when the receiver must take the slow
path: non-object-cells, Proxies (traps), module namespaces (exotic [[Get]] /
deferred evaluation), and dict-mode maps (which also covers mapped arguments
and every other exotic that pm_ensure_dict'd). ICs cache (shape_id → slot);
any layout drift changes the shape id, so a stale hit is impossible."""
def _vm_shape_of(v: JSValue) -> int {
    # Scalar table reads (no JSObject reference taken) — see js_object_ic_shape.
    return js_object_ic_shape(v);
}

glob _IMPORT_DEBUG: bool = False,
     _VM_PD2: bool = getenv("PD2") != None,
     ESM_META_AST_CACHE_MAX: int = 4,
     _DBG_ENV_READY: bool = False,
     _DBG_SP_ON: bool = False,
     _DBG_NEW_ON: bool = False,
     _DBG_EXEC_ON: bool = False,
     _DBG_DM_ON: bool = False,
     _DBG_SETREC_ON: bool = False,
     _DBG_ESM_ON: bool = False;

# Debug-probe env flags, read ONCE (lazily). These used to be `getenv(...)`
# calls inline in _op_set_prop / _exec / _op_new / _vm_construct — a libc
# environ scan + string compare on EVERY property store, function entry and
# construct (~100-200ns each, ~30% of a SET_PROP).
def _dbg_env_init -> None {
    if _DBG_ENV_READY {
        return;
    }
    _DBG_SP_ON = getenv("JAC_DBG_SP") != None;
    _DBG_NEW_ON = getenv("JAC_DBG_NEW") != None;
    _DBG_EXEC_ON = getenv("JAC_DBG_EXEC") != None;
    _DBG_DM_ON = getenv("JAC_DBG_DM") != None;
    _DBG_SETREC_ON = getenv("JAC_DBG_SETREC") != None;
    _DBG_ESM_ON = getenv("JAC_DBG_ESM") != None;
    _DBG_ENV_READY = True;
}

# Reentrancy guard for uncaughtException dispatch from vm_call_js_fn.
glob _HANDLING_UNCAUGHT: bool = False;

"""Create the singleton TDZ sentinel object."""
def _js_tdz_create -> JSValue {
    v: JSValue = js_object_create_null();
    js_object_set(v, _KEY_IS_TDZ, js_true());
    return v;
}

"""Return True if v is the TDZ sentinel (class accessed before declaration)."""
def js_is_tdz(v: JSValue) -> bool {
    # The sentinel is one pinned object (_TDZ_SENTINEL, created once — every
    # _js_tdz_create site guards on it being unset), so identity decides; this
    # runs on every checked local load, where a marker-key probe was ~500
    # instructions per object value.
    return v == _TDZ_SENTINEL and jsv_is_object_cell(v);
}

"""
True if the function body contains a `try` (PUSH_CATCH) or a for-of (ITER_CLOSE) —
constructs whose abrupt-completion cleanup (a `finally` block, or an iterator's
`return()` handler) could still call `super()` after a `return`.  Used to avoid
throwing the derived-constructor this-uninitialized ReferenceError prematurely when
such a deferred `super()` is possible (only consulted on the rare frame-exit path
where a derived constructor completed without an obvious `super()`).
"""
def _fn_may_defer_super(fn: CompiledFunction) -> bool {
    for mds_ins in fn.code {
        if mds_ins.opcode == Opcode.PUSH_CATCH or mds_ins.opcode == Opcode.ITER_CLOSE {
            return True;
        }
    }
    return False;
}

"""Single shared TDZ sentinel.  All class TDZ slots point at this one object."""
glob _TDZ_SENTINEL: JSValue = js_undefined();

"""require.cache — JS object mapping resolved path → module object.  Populated by _require_module."""
glob _REQUIRE_CACHE_OBJ: JSValue = js_undefined();

"""Tag exported functions with their defining CJS module object (NCJS-EXP-103)."""
def _bind_jac_module_on_exports(exports: JSValue, mod: JSValue, realm: Realm) -> None {
    if not jsv_is_object_cell(exports) {
        return;
    }
    keys: list[int] = js_object_keys(exports);
    ki: int = 0;
    while ki < len(keys) {
        fv: JSValue = js_object_get(exports, keys[ki]);
        if is_fn_val(fv) {
            cl_idx: int = get_fn_idx(fv);
            if cl_idx >= 0 and cl_idx < len(realm.closures) {
                realm.closures[cl_idx].jac_module = mod;
            }
        }
        ki = ki + 1;
    }
}

def _fn_jac_module(fn_val: JSValue, realm: Realm) -> JSValue {
    if not is_fn_val(fn_val) {
        return js_undefined();
    }
    cl_idx_m: int = get_fn_idx(fn_val);
    if cl_idx_m < 0 or cl_idx_m >= len(realm.closures) {
        return js_undefined();
    }
    return realm.closures[cl_idx_m].jac_module;
}

# module.exports's (shape, slot) on CommonJS module objects (V4.22). Globs
# are declared above their writers (Jac binds an earlier assignment as a local).
glob _JM_EXP_SID: int = -1,
     _JM_EXP_SI: int = -1;

"""`mod.exports` (its own data slot when `mod` has the learned layout)."""
def _vm_module_exports(mod: JSValue) -> JSValue {
    if _JM_EXP_SID >= 0 {
        me_v: JSValue = js_object_ic_hit(mod, _JM_EXP_SID, _JM_EXP_SI);
        if not jsv_is_hole(me_v) {
            return me_v;
        }
    }
    me_si: int = js_object_own_data_slot(mod, WK_EXPORTS);
    if me_si >= 0 {
        _JM_EXP_SID = js_object_ic_shape(mod);
        _JM_EXP_SI = me_si;
    }
    return js_object_get(mod, WK_EXPORTS);
}

def _push_cjs_module_context(vm: VM, mod: JSValue) {
    vm.globals["module"] = mod;
    vm.gw_epoch = vm.gw_epoch + 1;
    vm.globals["exports"] = js_object_get(mod, WK_EXPORTS);
    vm.gw_epoch = vm.gw_epoch + 1;
}

"""Keep module cache aligned when module.exports is reassigned at runtime."""
def _sync_module_cache_exports(mod_obj: JSValue, exports_val: JSValue) -> None {
    if not jsv_is_object_cell(mod_obj) {
        return;
    }
    id_v: JSValue = js_object_get(mod_obj, WK_ID);
    if jsv_is_string_cell(id_v) {
        rid: str = str_from_id(jsv_to_table_id(id_v));
        module_cache_set(rid, exports_val);
    }
}

"""require.main — the module object of the entry script.  Set by event_loop."""
glob _REQUIRE_MAIN_MODULE: JSValue = js_undefined();

"""Module-level realm bridge for helper functions that lack a VM reference."""
glob _VM_REALM: Realm;

def:pub vm_set_realm(r: Realm) {
    _VM_REALM = r;
}

"""Return the module-level realm (set via vm_set_realm at engine startup)."""
def:pub vm_get_realm -> Realm {
    return _VM_REALM;
}

"""Set the require.cache JS object (called by event_loop at startup)."""
def:pub vm_set_require_cache(cache_val: JSValue) {
    # glob-held root — invisible to the GC root walk; unpin old on re-set
    gc_unpin_value(_REQUIRE_CACHE_OBJ);
    _REQUIRE_CACHE_OBJ = cache_val;
    gc_pin_value(cache_val);
}

"""Set the require.main module object (called by event_loop at startup)."""
def:pub vm_set_require_main(main_val: JSValue) {
    # glob-held root — invisible to the GC root walk; unpin old on re-set
    gc_unpin_value(_REQUIRE_MAIN_MODULE);
    _REQUIRE_MAIN_MODULE = main_val;
    gc_pin_value(main_val);
}

"""require.extensions — extension string → loader function."""
glob _REQUIRE_EXTENSIONS_OBJ: JSValue = js_undefined();

"""Default extension loaders (identity-checked against custom overrides)."""
glob _REQUIRE_EXT_DEFAULT_JS: JSValue = js_undefined();
glob _REQUIRE_EXT_DEFAULT_JSON: JSValue = js_undefined(),
     _REQUIRE_EXT_DEFAULT_NODE: JSValue = js_undefined();

def:pub vm_get_require_extensions -> JSValue {
    return _REQUIRE_EXTENSIONS_OBJ;
}

def:pub vm_set_require_extensions(ext_val: JSValue) {
    # glob-held root — invisible to the GC root walk; unpin old on re-set
    gc_unpin_value(_REQUIRE_EXTENSIONS_OBJ);
    _REQUIRE_EXTENSIONS_OBJ = ext_val;
    gc_pin_value(ext_val);
}

def _module_compile_native -> JSValue {
    return js_native_create("_compile", 2, NATIVE_KIND_MODULE_COMPILE);
}

"""Attach module._compile to a CJS module object."""
def:pub vm_attach_module_compile(mod: JSValue) {
    if jsv_is_object_cell(mod) {
        js_object_set(mod, WK_COMPILE, _module_compile_native());
    }
}

def _ext_from_resolved(resolved: str) -> str {
    n: int = len(resolved);
    i: int = n - 1;
    while i >= 0 {
        if resolved[i] == "." {
            return str_substr(resolved, i, n);
        }
        i = i - 1;
    }
    return "";
}

def _js_vals_same_identity(a: JSValue, b: JSValue) -> bool {
    if is_native_val(a) and is_native_val(b) {
        return get_native_idx(a) == get_native_idx(b);
    }
    if jsv_is_object_cell(a) and jsv_is_object_cell(b) {
        return jsv_to_table_id(a) == jsv_to_table_id(b);
    }
    return False;
}

def _lookup_ext_loader(resolved: str) -> JSValue {
    if not jsv_is_object_cell(_REQUIRE_EXTENSIONS_OBJ) {
        return js_undefined();
    }
    ext: str = _ext_from_resolved(resolved);
    if ext == "" {
        return js_undefined();
    }
    return js_object_get(_REQUIRE_EXTENSIONS_OBJ, str_intern(ext));
}

def _is_custom_ext_loader(loader: JSValue, mod_format: str) -> bool {
    if jsv_is_undefined(loader) {
        return False;
    }
    if mod_format == "cjs-json" {
        return not _js_vals_same_identity(loader, _REQUIRE_EXT_DEFAULT_JSON);
    }
    if mod_format == "napi" {
        return not _js_vals_same_identity(loader, _REQUIRE_EXT_DEFAULT_NODE);
    }
    if mod_format == "cjs-js" {
        return not _js_vals_same_identity(loader, _REQUIRE_EXT_DEFAULT_JS);
    }
    return False;
}

"""Initialize require.extensions with default .js/.cjs/.json/.node loaders."""
def:pub vm_init_require_extensions {
    ext_js: JSValue = js_native_create("extension", 2, NATIVE_KIND_MODULE_EXT_JS);
    ext_json: JSValue = js_native_create("extension", 2, NATIVE_KIND_MODULE_EXT_JSON);
    ext_node: JSValue = js_native_create("extension", 2, NATIVE_KIND_MODULE_EXT_NODE);
    _REQUIRE_EXT_DEFAULT_JS = ext_js;
    _REQUIRE_EXT_DEFAULT_JSON = ext_json;
    _REQUIRE_EXT_DEFAULT_NODE = ext_node;
    gc_pin_value(ext_js);  # glob-held singleton — invisible to the GC root walk
    gc_pin_value(ext_json);
    gc_pin_value(ext_node);

    exts: JSValue = js_object_create_null();
    js_object_set(exts, str_intern(".js"), ext_js);
    js_object_set(exts, str_intern(".cjs"), ext_js);
    js_object_set(exts, str_intern(".json"), ext_json);
    js_object_set(exts, str_intern(".node"), ext_node);
    _REQUIRE_EXTENSIONS_OBJ = exts;
    gc_pin_value(exts);  # glob-held singleton — invisible to the GC root walk
    module_set_cjs_loader_exports(_REQUIRE_EXTENSIONS_OBJ, _module_compile_native());
}

"""Mark entry module loaded and register in require.cache (Node parity)."""
def:pub vm_finalize_entry_module(vm: VM, mod: JSValue, abs_path: str) -> None {
    if not jsv_is_object_cell(mod) {
        return;
    }
    final_exports: JSValue = js_object_get(mod, WK_EXPORTS);
    js_object_set(mod, WK_LOADED, js_boolean(True));
    module_cache_set(abs_path, final_exports);
    if jsv_is_object_cell(_REQUIRE_CACHE_OBJ) {
        js_object_set(_REQUIRE_CACHE_OBJ, str_intern(abs_path), mod);
    }
    _bind_jac_module_on_exports(final_exports, mod, vm.realm);
}

"""Mark an entry/imported ESM exports object as a module namespace (pre-eval)."""
def:pub vm_mark_esm_namespace(vm: VM, ns: JSValue) {
    vm._mark_esm_namespace(ns);
}

"""Preseed export names onto an entry namespace from module source (Instantiation)."""
def:pub vm_preseed_esm_namespace(vm: VM, ns: JSValue, source: str) {
    vm._preseed_namespace_from_source(ns, source);
}

"""Seal an entry ESM exports object as a Module Namespace Exotic Object."""
def:pub vm_finalize_esm_namespace(vm: VM, ns: JSValue) {
    vm._finalize_esm_namespace(ns);
}

"""Return a short human-readable string for a JSValue (for debug output)."""
def jsval_dbg(v: JSValue) -> str {
    if jsv_is_undefined(v) {
        return "undef";
    } elif jsv_is_null(v) {
        return "null";
    } elif jsv_is_bool(v) {
        if jsv_to_bool(v) {
            return "true";
        } else {
            return "false";
        }
    } elif jsv_is_int32(v) {
        return "i32(" + str(jsv_to_int32(v)) + ")";
    } elif jsv_is_double(v) {
        return "f64(" + str(jsv_to_double(v)) + ")";
    } elif jsv_is_string_cell(v) {
        return "str(" + str_from_id(jsv_to_table_id(v)) + ")";
    } elif jsv_is_object_cell(v) {
        return "obj(@" + str(jsv_to_table_id(v)) + ")";
    } elif is_fn_val(v) {
        return "fn(#" + str(get_fn_idx(v)) + ")";
    } elif is_native_val(v) {
        return "native(kind=" + str(get_native_kind(v)) + ")";
    }
    return "?(raw=" + str(v) + ")";
}

"""Resolve the parent file path for require/import resolution.
Checks require_parent_override first, then __filename global, then falls back to
a sentinel path based on script_dir so that resolution can proceed correctly."""
def _get_parent_file(vm: VM) -> str {
    pf: str = "";
    if vm.require_parent_override != "" {
        pf = vm.require_parent_override;
    } elif "__filename" in vm.globals {
        pfn: JSValue = vm.globals["__filename"];
        if jsv_is_string_cell(pfn) {
            pf = str_from_id(jsv_to_table_id(pfn));
        }
    }
    if pf == "" and "__jacEntryFilename" in vm.globals {
        pfn_esm: JSValue = vm.globals["__jacEntryFilename"];
        if jsv_is_string_cell(pfn_esm) {
            pf = str_from_id(jsv_to_table_id(pfn_esm));
        }
    }
    if pf == "" {
        if vm.script_dir != "" {
            pf = vm.script_dir + "/.__jac_main__.js";
        } else {
            pf = "/.__jac_main__.js";
        }
    }
    return pf;
}

"""Strip a leading 'node:' prefix from a module specifier (e.g. 'node:fs' → 'fs').
Returns the input unchanged if it does not begin with 'node:'."""
def _strip_node_prefix(s: str) -> str {
    if len(s) > 5
        and s[0] == "n"
        and s[1] == "o"
        and s[2] == "d"
        and s[3] == "e"
        and s[4] == ":" {
        return s[5:];
    }
    return s;
}

"""Handle the vm-module context natives — createContext / isContext /
runInContext — in the CALL and CALL_METHOD dispatch paths.
Returns True if execution should continue, False if `running` must be set to False."""
def _handle_vm_context_native(
    vm: VM, kind: int, args: list[JSValue], frame: CallFrame
) -> bool {
    if kind == NATIVE_KIND_VM_IS_CONTEXT {
        vic_v: JSValue = js_undefined();
        if len(args) > 0 {
            vic_v = args[0];
        }
        vm._push(js_boolean(vm.vm_is_context(vic_v)));
        return True;
    }
    if kind == NATIVE_KIND_VM_CREATE_CONTEXT {
        vcc_sbx: JSValue = js_object_new_ordinary();
        if len(args) > 0
            and not jsv_is_undefined(args[0])
            and not jsv_is_null(args[0]) {
            vcc_sbx = args[0];
        }
        vcc_res: JSValue = vm.vm_create_context(vcc_sbx);
        return vm._check_native_exc(frame, vcc_res);
    }
    # NATIVE_KIND_VM_RUN_IN_CONTEXT — (code, contextifiedSandbox, filename?)
    vrc_code: str = "";
    if len(args) > 0 and jsv_is_string_cell(args[0]) {
        vrc_code = str_from_id(jsv_to_table_id(args[0]));
    }
    vrc_ctx: JSValue = js_undefined();
    if len(args) > 1 {
        vrc_ctx = args[1];
    }
    vrc_file: str = "";
    if len(args) > 2 and jsv_is_string_cell(args[2]) {
        vrc_file = str_from_id(jsv_to_table_id(args[2]));
    }
    vrc_res: JSValue = vm.run_in_context(vrc_code, vrc_ctx, vrc_file);
    return vm._check_native_exc(frame, vrc_res);
}

"""Handle NATIVE_KIND_MODULE_CREATE_REQUIRE in the CALL and CALL_METHOD dispatch paths.
Returns True if execution should continue, False if `running` must be set to False."""
def _handle_module_create_require(
    vm: VM, args: list[JSValue], frame: CallFrame
) -> bool {
    cr_base: str = "";
    if len(args) > 0 {
        if jsv_is_string_cell(args[0]) {
            cr_base = str_from_id(jsv_to_table_id(args[0]));
        } elif jsv_is_object_cell(args[0]) {
            cr_base = jsval_to_str(args[0]);
        }
    }
    cr_pf: str = cr_base;
    cr_is_file_url: bool = False;
    if len(cr_base) > 7
        and cr_base[0] == "f"
        and cr_base[1] == "i"
        and cr_base[2] == "l"
        and cr_base[3] == "e"
        and cr_base[4] == ":"
        and cr_base[5] == "/"
        and cr_base[6] == "/" {
        cr_is_file_url = True;
        cr_pf = cr_base[7:];
    }
    if not cr_is_file_url and len(cr_pf) > 0 and cr_pf[0] != "/" {
        cr_pf = path_abspath(cr_pf, vm.script_dir);
    }
    if len(cr_pf) == 0 or cr_pf[0] != "/" {
        exc_cr: JSValue = make_coded_error(
            "TypeError",
            "The argument must be a file URL or absolute path",
            "ERR_INVALID_ARG_VALUE",
            get_type_error_proto()
        );
        if not vm._unwind_in_frame(frame, exc_cr) {
            vm.had_exception = True;
            vm.pending_exc = exc_cr;
            return False;
        }
    } else {
        # Resolve symlinks so that node_modules lookup walks the real directory tree.
        # pnpm installs packages via symlinks; without realpath() the parent directory
        # appears to be inside the per-package symlink tree rather than the pnpm store,
        # so sibling packages (e.g. @rolldown/binding-linux-x64-gnu next to rolldown)
        # are not found.  This mirrors Node.js's Module._resolveFilename behaviour.
        cr_pf = path_realpath_str(cr_pf);
        cr_fn: JSValue = module_create_bound_require(cr_pf);
        vm._push(cr_fn);
    }
    return True;
}

"""Dispatch module._compile and default extension loaders."""
def _handle_module_cjs_native(
    vm: VM, kind: int, this_val: JSValue, args: list[JSValue], frame: CallFrame
) -> bool {
    if kind == NATIVE_KIND_MODULE_COMPILE {
        mod_obj: JSValue = this_val;
        code: str = "";
        filename: str = "";
        if jsv_is_object_cell(this_val) {
            if len(args) > 0 and jsv_is_string_cell(args[0]) {
                code = str_from_id(jsv_to_table_id(args[0]));
            }
            if len(args) > 1 and jsv_is_string_cell(args[1]) {
                filename = str_from_id(jsv_to_table_id(args[1]));
            }
        }
        if filename == "" and jsv_is_object_cell(mod_obj) {
            fn_v: JSValue = js_object_get(mod_obj, str_intern("filename"));
            if jsv_is_string_cell(fn_v) {
                filename = str_from_id(jsv_to_table_id(fn_v));
            }
        }
        res_mc: JSValue = vm._cjs_run_in_module(mod_obj, code, filename);
        if vm.had_exception {
            exc_mc: JSValue = vm.pending_exc;
            vm.had_exception = False;
            vm.pending_exc = js_undefined();
            if not vm._unwind_in_frame(frame, exc_mc) {
                vm.had_exception = True;
                vm.pending_exc = exc_mc;
                return False;
            }
        } else {
            vm._push(res_mc);
        }
        return True;
    }
    if kind == NATIVE_KIND_MODULE_EXT_JS {
        mod_ej: JSValue = js_undefined();
        fn_ej: str = "";
        if len(args) > 0 {
            mod_ej = args[0];
        }
        if len(args) > 1 and jsv_is_string_cell(args[1]) {
            fn_ej = str_from_id(jsv_to_table_id(args[1]));
        }
        raw_ej: JSValue = _read_file_sync_str(fn_ej);
        if jsv_is_undefined(raw_ej) {
            exc_ej: JSValue = make_type_error("Cannot find module '" + fn_ej + "'");
            if not vm._unwind_in_frame(frame, exc_ej) {
                vm.had_exception = True;
                vm.pending_exc = exc_ej;
                return False;
            }
            return True;
        }
        src_ej: str = str_from_id(jsv_to_table_id(raw_ej));
        res_ej: JSValue = vm._cjs_run_in_module(mod_ej, src_ej, fn_ej);
        if vm.had_exception {
            exc_ej2: JSValue = vm.pending_exc;
            vm.had_exception = False;
            vm.pending_exc = js_undefined();
            if not vm._unwind_in_frame(frame, exc_ej2) {
                vm.had_exception = True;
                vm.pending_exc = exc_ej2;
                return False;
            }
        } else {
            vm._push(res_ej);
        }
        return True;
    }
    if kind == NATIVE_KIND_MODULE_EXT_JSON {
        mod_ejn: JSValue = js_undefined();
        fn_ejn: str = "";
        if len(args) > 0 {
            mod_ejn = args[0];
        }
        if len(args) > 1 and jsv_is_string_cell(args[1]) {
            fn_ejn = str_from_id(jsv_to_table_id(args[1]));
        }
        raw_ejn: JSValue = _read_file_sync_str(fn_ejn);
        if jsv_is_undefined(raw_ejn) {
            exc_ejn: JSValue = make_type_error("Cannot find module '" + fn_ejn + "'");
            if not vm._unwind_in_frame(frame, exc_ejn) {
                vm.had_exception = True;
                vm.pending_exc = exc_ejn;
                return False;
            }
            return True;
        }
        txt_ejn: str = str_from_id(jsv_to_table_id(raw_ejn));
        json_ejn: JSValue = js_json_parse([jsv_from_string_id(str_intern(txt_ejn))]);
        if jsv_is_object_cell(mod_ejn) {
            js_object_set(mod_ejn, WK_EXPORTS, json_ejn);
        }
        vm._push(json_ejn);
        return True;
    }
    if kind == NATIVE_KIND_MODULE_EXT_NODE {
        # N-API addon loading is incomplete and off by default (see _NAPI_ENABLED).
        if not _NAPI_ENABLED {
            _napi_disabled_throw(vm);
            return False;
        }
        mod_en: JSValue = js_undefined();
        fn_en: str = "";
        if len(args) > 0 {
            mod_en = args[0];
        }
        if len(args) > 1 and jsv_is_string_cell(args[1]) {
            fn_en = str_from_id(jsv_to_table_id(args[1]));
        }
        _napi_set_realm(vm.realm);
        _napi_set_global_jsv(vm.global_this);
        _NAPI_ACTIVE_VM = vm;
        _NAPI_VM_ACTIVE = True;
        _push_native_obs_vm(vm);
        napi_en: JSValue = _load_napi_addon(vm.napi_env_ptr, fn_en);
        _pop_native_obs_vm();
        if vm.had_exception {
            return False;
        }
        if jsv_is_object_cell(mod_en) {
            js_object_set(mod_en, WK_EXPORTS, napi_en);
        }
        vm._push(napi_en);
        return True;
    }
    return True;
}

"""Handle NATIVE_KIND_REQUIRE_RESOLVE_PATHS in the CALL and CALL_METHOD dispatch paths.
Pushes js_null() for built-in modules, or the array of node_modules directories otherwise."""
def _handle_require_resolve_paths(vm: VM, args: list[JSValue]) {
    rp_spec: str = "";
    if len(args) > 0 and jsv_is_string_cell(args[0]) {
        rp_spec = str_from_id(jsv_to_table_id(args[0]));
    }
    rp_bare: str = rp_spec;
    if len(rp_spec) > 5
        and rp_spec[0] == "n"
        and rp_spec[1] == "o"
        and rp_spec[2] == "d"
        and rp_spec[3] == "e"
        and rp_spec[4] == ":" {
        rp_bare = rp_spec[5:];
    }
    if is_builtin_module(rp_bare) {
        vm._push(js_null());
    } else {
        rp_dir: str = vm.script_dir;
        if "__filename" in vm.globals {
            rp_fn: JSValue = vm.globals["__filename"];
            if jsv_is_string_cell(rp_fn) {
                rp_dir = path_dirname(str_from_id(jsv_to_table_id(rp_fn)));
            }
        }
        vm._push(vm._make_module_paths(rp_dir));
    }
}


def make_closure(
    fn: CompiledFunction,
    free_vals: list[JSValue],
    lexical_this: JSValue,
    prototype_obj: JSValue
) -> JSClosure {
    empty_mf: list[CompiledFunction] = [];
    return JSClosure(
        func=fn,
        free_vals=free_vals,
        lexical_this=lexical_this,
        prototype_obj=prototype_obj,
        super_class=js_undefined(),
        fn_props=js_object_create_null(),
        module_fns=empty_mf,
        is_arrow=False
    );
}

"""
Function values are stored with kind=NATIVE, id in [0, BUILTIN_BASE).
Builtin and native-registry values share the same kind but use higher ids.
"""
def js_fn_val(idx: int) -> JSValue {
    return jsv_from_cell_kind(idx, JS_CELL_KIND_NATIVE);
}

def is_fn_val(v: JSValue) -> bool {
    if not jsv_is_cell(v) {
        return False;
    }
    if jsv_cell_kind(v) != JS_CELL_KIND_NATIVE {
        return False;
    }
    # Closures have table id in [0, BUILTIN_BASE=1_000_000)
    # Builtins: [1M, 2M), Native registry: [2M, ∞). Exclude both.
    return jsv_to_table_id(v) < 1000000;
}

"""True when `v` is an Object in the ECMAScript sense (§6.1.7).

Functions, native functions and proxies are Objects but are not `object_cell`s in
this value representation, so a bare `jsv_is_object_cell` check misclassifies them
as primitives. ToPrimitive result validation must use this predicate: a toString
that returns a function has NOT produced a primitive and must fall through to
valueOf (and ultimately throw)."""
def _vm_is_object_like(v: JSValue) -> bool {
    if jsv_is_symbol(v) {
        return False;
    }
    return jsv_is_object_cell(v) or is_fn_val(v) or is_native_val(v) or js_is_proxy(v);
}

def:pub get_fn_idx(v: JSValue) -> int {
    return jsv_to_table_id(v);
}

# ══════════════════════════════════════════════════════════════════════════════
# 2.  Value helpers
# ══════════════════════════════════════════════════════════════════════════════

"""Create a JSValue{tag=String} by interning the raw Jac string."""
def js_str(s: str) -> JSValue {
    id: int = str_intern(s);
    return jsv_from_string_id(id);
}

"""Wrap a computed string VALUE without interning it.

For strings produced by evaluation (concatenation, slice, replace, template) —
which are numerous, long, and essentially never reused as keys. Interning them
re-hashed and double-stored the whole string per operation, making `s += x` in a
loop O(n^2). Use js_str for identifiers / property keys where dedup matters."""
def js_str_heap(s: str) -> JSValue {
    return jsv_from_string_id(str_heap(s));
}

# BigInt storage uses decimal strings in the string table.  Literals keep the
# full source digits (including values > 2^53).  Arithmetic results use the
# bignat decimal path when both operands are decimal strings; otherwise a
# float fallback may lose precision.  Strict equality compares numeric value.
glob _BIGINT_SAFE_MAX: float = 9007199254740992.0;  # 2^53

def _bigint_is_decimal_str(s: str) -> bool {
    if len(s) == 0 {
        return False;
    }
    i: int = 0;
    if s[0:1] == "-" {
        i = 1;
    }
    if i >= len(s) {
        return False;
    }
    while i < len(s) {
        ch: str = s[i:i + 1];
        if ch < "0" or ch > "9" {
            return False;
        }
        i = i + 1;
    }
    return True;
}

def _bigint_trim_zeros(s: str) -> str {
    i: int = 0;
    n: int = len(s);
    while i < n - 1 {
        if s[i:i + 1] != "0" {
            break;
        }
        i = i + 1;
    }
    out: str = "";
    while i < n {
        out = out + s[i:i + 1];
        i = i + 1;
    }
    return out;
}

def _bigint_str_mul_int(s: str, n: int) -> str {
    if n == 0 or s == "0" or len(s) == 0 {
        return "0";
    }
    carry: int = 0;
    out: str = "";
    i: int = len(s) - 1;
    while i >= 0 {
        d: int = int(s[i:i + 1]);
        prod: int = d * n + carry;
        carry = prod // 10;
        out = str(prod % 10) + out;
        i = i - 1;
    }
    if carry > 0 {
        out = str(carry) + out;
    }
    return _bigint_trim_zeros(out);
}

def _bigint_str_of(v: JSValue) -> str {
    return str_from_id(jsv_to_table_id(v));
}

"""IsLooselyEqual for a BigInt (decimal-string `bi_str`) and a Number `nf`
(ES §7.2.15 step 12/13): equal iff `nf` is a finite integer whose mathematical
value equals the BigInt. NaN/±Infinity/non-integer → not equal. Exact for
integers within int64 (decimal-string compare); falls back to a float compare
for magnitudes beyond that (already imprecise as a Number)."""
def _bigint_loose_eq_number(bi_str: str, nf: float) -> bool {
    if not (nf == nf) {
        return False;
    }
    if nf == MATH_INF or nf == -MATH_INF {
        return False;
    }
    if nf <= 9.2e18 and nf >= -9.2e18 {
        if nf != float(int(nf)) {
            return False;
        }
        nis: str = str(int(nf));
        return _bigint_norm_dec(bi_str) == nis;
    }
    # Huge: `bi_str` may exceed int64; compare via float (lossy, but so is nf).
    return _bigint_str_to_float(bi_str) == nf;
}

"""Normalize a signed decimal string: drop a redundant leading sign on zero and
any leading zeros (`-0`→`0`, `007`→`7`). `bi_str` from BigInt is already
normalized; this guards strings coming from elsewhere."""
def _bigint_norm_dec(bi_str: str) -> str {
    if len(bi_str) == 0 {
        return "0";
    }
    neg: bool = bi_str[0:1] == "-";
    body: str = bi_str[1:] if neg else bi_str;
    body = _bigint_trim_zeros(body);
    if body == "0" or len(body) == 0 {
        return "0";
    }
    if neg {
        return "-" + body;
    }
    return body;
}

def _bigint_str_to_float(bi_str: str) -> float {
    return str_to_float(bi_str);
}

"""StringToBigInt (ES §7.1.14) → normalized decimal string, or "" when the string
is not a valid BigInt (the caller treats "" as not-equal). Leading/trailing ASCII
whitespace is ignored; an empty/whitespace-only string is 0n; an optional +/- sign
precedes decimal digits, or a `0x`/`0o`/`0b` radix prefix (no sign allowed then)."""
def _string_to_bigint_or_empty(s: str) -> str {
    lo: int = 0;
    hi: int = len(s);
    while lo < hi
        and (
            s[lo:lo + 1] == " "
            or s[lo:lo + 1] == "\t"
            or s[lo:lo + 1] == "\n"
            or s[lo:lo + 1] == "\r"
            or s[lo:lo + 1] == "\x0b"
            or s[lo:lo + 1] == "\x0c"
        ) {
        lo = lo + 1;
    }
    while hi > lo
        and (
            s[hi - 1:hi] == " "
            or s[hi - 1:hi] == "\t"
            or s[hi - 1:hi] == "\n"
            or s[hi - 1:hi] == "\r"
            or s[hi - 1:hi] == "\x0b"
            or s[hi - 1:hi] == "\x0c"
        ) {
        hi = hi - 1;
    }
    t: str = s[lo:hi];
    if len(t) == 0 {
        return "0";
    }
    # Radix-prefixed (no sign): 0x / 0o / 0b.
    if len(t) >= 2 and t[0:1] == "0" {
        p: str = t[1:2];
        if p == "x" or p == "X" or p == "o" or p == "O" or p == "b" or p == "B" {
            radix: int = 16
                if (p == "x" or p == "X")
                else (8 if (p == "o" or p == "O") else 2);
            return _radix_digits_to_dec(t[2:], radix);
        }
    }
    sign: str = "";
    i: int = 0;
    if t[0:1] == "+" {
        i = 1;
    } elif t[0:1] == "-" {
        sign = "-";
        i = 1;
    }
    body: str = t[i:];
    if len(body) == 0 {
        return "";
    }
    j: int = 0;
    while j < len(body) {
        c: str = body[j:j + 1];
        if c < "0" or c > "9" {
            return "";
        }
        j = j + 1;
    }
    n: str = _bigint_trim_zeros(body);
    if n == "0" {
        return "0";
    }
    return sign + n;
}

"""Add two NON-NEGATIVE decimal strings → decimal string."""
def _bigint_str_add_dec(a: str, b: str) -> str {
    i: int = len(a) - 1;
    j: int = len(b) - 1;
    carry: int = 0;
    out: str = "";
    while i >= 0 or j >= 0 or carry > 0 {
        da: int = int(a[i:i + 1]) if i >= 0 else 0;
        db: int = int(b[j:j + 1]) if j >= 0 else 0;
        s: int = da + db + carry;
        carry = s // 10;
        out = str(s % 10) + out;
        i = i - 1;
        j = j - 1;
    }
    return _bigint_trim_zeros(out);
}

# ── BigInt bitwise (two's complement over base-2^32 limbs) ────────────────────
# BigInt has `& | ^ ~ << >>` (ES §6.1.6.2). Operands are signed decimal strings;
# negatives use infinite two's-complement sign extension. We work over W limbs where
# W is one past the widest magnitude, which leaves room for the sign bit. Limbs
# are least significant first. (A bit list built by halving the decimal string
# cost O(digits^2 * bits); Rollup's chunk bitsets made that a build hot spot.)

glob _LIMB_MASK: int = 0xFFFFFFFF,
     _DEC_CHUNK: int = 1000000000;

"""Non-negative decimal string → base-2^32 limbs (never empty)."""
def _dec_to_limbs(dec: str) -> list[int] {
    limbs: list[int] = [0];
    n: int = len(dec);
    start: int = 0;
    end: int = n % 9;
    if end == 0 {
        end = 9;
    }
    while start < n {
        carry: int = int(dec[start:end]);
        i: int = 0;
        while i < len(limbs) {
            v: int = limbs[i] * _DEC_CHUNK + carry;
            limbs[i] = v & _LIMB_MASK;
            carry = v >> 32;
            i = i + 1;
        }
        if carry > 0 {
            limbs.append(carry);
        }
        start = end;
        end = end + 9;
    }
    return limbs;
}

def _pad9_dec(n: int) -> str {
    s: str = str(n);
    while len(s) < 9 {
        s = "0" + s;
    }
    return s;
}

"""Base-2^32 limbs → non-negative decimal string."""
def _limbs_to_dec(limbs_in: list[int]) -> str {
    limbs: list[int] = [];
    for li in limbs_in {
        limbs.append(li);
    }
    while len(limbs) > 0 and limbs[len(limbs) - 1] == 0 {
        limbs.pop();
    }
    if len(limbs) == 0 {
        return "0";
    }
    chunks: list[int] = [];
    while len(limbs) > 0 {
        rem: int = 0;
        i: int = len(limbs) - 1;
        while i >= 0 {
            cur: int = (rem << 32) | limbs[i];
            limbs[i] = cur // _DEC_CHUNK;
            rem = cur % _DEC_CHUNK;
            i = i - 1;
        }
        chunks.append(rem);
        while len(limbs) > 0 and limbs[len(limbs) - 1] == 0 {
            limbs.pop();
        }
    }
    j: int = len(chunks) - 1;
    out: str = str(chunks[j]);
    j = j - 1;
    while j >= 0 {
        out = out + _pad9_dec(chunks[j]);
        j = j - 1;
    }
    return out;
}

"""Magnitude limbs of a signed decimal string."""
def _dec_mag_limbs(dec: str) -> list[int] {
    if len(dec) > 0 and dec[0:1] == "-" {
        return _dec_to_limbs(dec[1:]);
    }
    return _dec_to_limbs(dec);
}

"""Two's-complement negation of `w` limbs, in place."""
def _limbs_negate(limbs: list[int], w: int) {
    carry: int = 1;
    i: int = 0;
    while i < w {
        v: int = (limbs[i] ^ _LIMB_MASK) + carry;
        limbs[i] = v & _LIMB_MASK;
        carry = v >> 32;
        i = i + 1;
    }
}

"""Signed decimal string → `w` limbs of two's complement."""
def _dec_to_twos(dec: str, w: int) -> list[int] {
    limbs: list[int] = _dec_mag_limbs(dec);
    while len(limbs) < w {
        limbs.append(0);
    }
    if len(dec) > 0 and dec[0:1] == "-" {
        _limbs_negate(limbs, w);
    }
    return limbs;
}

"""`w` limbs of two's complement → signed decimal string."""
def _twos_to_dec(limbs: list[int], w: int) -> str {
    if (limbs[w - 1] >> 31) == 0 {
        return _limbs_to_dec(limbs);
    }
    _limbs_negate(limbs, w);
    mag: str = _limbs_to_dec(limbs);
    if mag == "0" {
        return "0";
    }
    return "-" + mag;
}

"""`a op b` for op 0=AND, 1=OR, 2=XOR — signed decimal strings."""
def _bigint_bit_binop(a_dec: str, b_dec: str, op: int) -> str {
    w: int = len(_dec_mag_limbs(a_dec));
    wb: int = len(_dec_mag_limbs(b_dec));
    if wb > w {
        w = wb;
    }
    w = w + 1;
    la: list[int] = _dec_to_twos(a_dec, w);
    lb: list[int] = _dec_to_twos(b_dec, w);
    i: int = 0;
    while i < w {
        if op == 0 {
            la[i] = la[i] & lb[i];
        } elif op == 1 {
            la[i] = la[i] | lb[i];
        } else {
            la[i] = la[i] ^ lb[i];
        }
        i = i + 1;
    }
    return _twos_to_dec(la, w);
}

"""`~a` (ES: ~a == -a-1) — invert every bit in two's complement."""
def _bigint_bit_not(a_dec: str) -> str {
    w: int = len(_dec_mag_limbs(a_dec)) + 1;
    la: list[int] = _dec_to_twos(a_dec, w);
    i: int = 0;
    while i < w {
        la[i] = la[i] ^ _LIMB_MASK;
        i = i + 1;
    }
    return _twos_to_dec(la, w);
}

"""`a << shift` for a signed decimal `a` and non-negative int `shift` (a * 2^shift)."""
def _bigint_shl_dec(a_dec: str, shift: int) -> str {
    if a_dec == "0" or len(a_dec) == 0 {
        return "0";
    }
    neg: bool = a_dec[0:1] == "-";
    mag: list[int] = _dec_mag_limbs(a_dec);
    out: list[int] = [];
    k: int = shift // 32;
    while len(out) < k {
        out.append(0);
    }
    r: int = shift % 32;
    carry: int = 0;
    for ml in mag {
        v: int = (ml << r) | carry;
        out.append(v & _LIMB_MASK);
        carry = v >> 32;
    }
    if carry > 0 {
        out.append(carry);
    }
    res: str = _limbs_to_dec(out);
    if neg and res != "0" {
        return "-" + res;
    }
    return res;
}

"""Magnitude limbs >> `shift` (floor)."""
def _limbs_shr(limbs: list[int], shift: int) -> list[int] {
    k: int = shift // 32;
    r: int = shift % 32;
    out: list[int] = [];
    i: int = k;
    while i < len(limbs) {
        v: int = limbs[i] >> r;
        if r > 0 and i + 1 < len(limbs) {
            v = v | ((limbs[i + 1] << (32 - r)) & _LIMB_MASK);
        }
        out.append(v);
        i = i + 1;
    }
    if len(out) == 0 {
        out.append(0);
    }
    return out;
}

"""`a >> shift` = floor(a / 2^shift), for non-negative int `shift`
(arithmetic: a negative `a` gives -(((|a| - 1) >> shift) + 1))."""
def _bigint_shr_dec(a_dec: str, shift: int) -> str {
    if not (len(a_dec) > 0 and a_dec[0:1] == "-") {
        return _limbs_to_dec(_limbs_shr(_dec_to_limbs(a_dec), shift));
    }
    m1: str = _limbs_to_dec(
        _limbs_shr(_dec_to_limbs(_dec_str_sub_vm(a_dec[1:], "1")), shift)
    );
    return "-" + _bigint_str_add_dec(m1, "1");
}

"""Convert `digits` in `radix` (2/8/16) to a decimal string, or "" if any digit is
invalid or `digits` is empty. Positive only (radix prefixes disallow a sign)."""
def _radix_digits_to_dec(digits: str, radix: int) -> str {
    if len(digits) == 0 {
        return "";
    }
    acc: str = "0";
    k: int = 0;
    while k < len(digits) {
        ch: str = digits[k:k + 1];
        d: int = -1;
        if ch >= "0" and ch <= "9" {
            d = int(ch);
        } elif ch >= "a" and ch <= "f" {
            d = 10 + (ord(ch) - ord("a"));
        } elif ch >= "A" and ch <= "F" {
            d = 10 + (ord(ch) - ord("A"));
        }
        if d < 0 or d >= radix {
            return "";
        }
        acc = _bigint_str_add_dec(_bigint_str_mul_int(acc, radix), str(d));
        k = k + 1;
    }
    return acc;
}

def _bigint_both_decimal(a: JSValue, b: JSValue) -> bool {
    return _bigint_is_decimal_str(_bigint_str_of(a))
        and _bigint_is_decimal_str(_bigint_str_of(b));
}

def _bigint_from_jsv(v: JSValue) -> list[int] {
    return bn_parse_decimal(_bigint_str_of(v));
}

def _bigint_to_jsv(bn: list[int]) -> JSValue {
    return jsv_from_cell_kind(str_intern(bn_to_string(bn, 10)), JS_CELL_KIND_BIGINT);
}

glob _BIGINT_DIV_REM_STR: str = "0";

def _dec_str_trim_vm(s: str) -> str {
    while len(s) > 1 and s[0:1] == "0" {
        s = s[1:len(s)];
    }
    if len(s) == 0 {
        return "0";
    }
    return s;
}

def _dec_str_cmp_vm(a: str, b: str) -> int {
    a = _dec_str_trim_vm(a);
    b = _dec_str_trim_vm(b);
    if len(a) != len(b) {
        if len(a) > len(b) {
            return 1;
        }
        return -1;
    }
    i: int = 0;
    while i < len(a) {
        if a[i:i + 1] != b[i:i + 1] {
            if a[i:i + 1] > b[i:i + 1] {
                return 1;
            }
            return -1;
        }
        i = i + 1;
    }
    return 0;
}

def _dec_str_sub_vm(a: str, b: str) -> str {
    out: str = "";
    borrow: int = 0;
    i: int = len(a) - 1;
    j: int = len(b) - 1;
    while i >= 0 {
        da: int = int(a[i:i + 1]) - borrow;
        db: int = 0;
        if j >= 0 {
            db = int(b[j:j + 1]);
        }
        if da < db {
            da = da + 10;
            borrow = 1;
        } else {
            borrow = 0;
        }
        out = str(da - db) + out;
        i = i - 1;
        j = j - 1;
    }
    return _dec_str_trim_vm(out);
}

def _dec_str_mul_small_vm(s: str, n: int) -> str {
    if n == 0 or s == "0" {
        return "0";
    }
    carry: int = 0;
    out: str = "";
    i: int = len(s) - 1;
    while i >= 0 {
        prod: int = int(s[i:i + 1]) * n + carry;
        carry = prod // 10;
        out = str(prod % 10) + out;
        i = i - 1;
    }
    if carry > 0 {
        out = str(carry) + out;
    }
    return _dec_str_trim_vm(out);
}

def _bigint_str_divmod_pos(a: str, b: str) -> str {
    if _dec_str_cmp_vm(a, b) < 0 {
        _BIGINT_DIV_REM_STR = a;
        return "0";
    }
    q: str = "";
    rem: str = "";
    pos: int = 0;
    while pos < len(a) {
        rem = rem + a[pos:pos + 1];
        rem = _dec_str_trim_vm(rem);
        digit: str = "0";
        if _dec_str_cmp_vm(rem, b) >= 0 {
            lo: int = 1;
            hi: int = 9;
            best: int = 0;
            while lo <= hi {
                mid: int = (lo + hi) // 2;
                trial: str = _dec_str_mul_small_vm(b, mid);
                if _dec_str_cmp_vm(trial, rem) <= 0 {
                    best = mid;
                    lo = mid + 1;
                } else {
                    hi = mid - 1;
                }
            }
            digit = str(best);
            rem = _dec_str_sub_vm(rem, _dec_str_mul_small_vm(b, best));
        }
        q = q + digit;
        pos = pos + 1;
    }
    _BIGINT_DIV_REM_STR = _dec_str_trim_vm(rem);
    return _dec_str_trim_vm(q);
}

def _bigint_divmod_decimal(a_str: str, b_str: str) -> str {
    aneg: bool = False;
    bneg: bool = False;
    ap: str = a_str;
    bp: str = b_str;
    if len(ap) > 0 and ap[0:1] == "-" {
        aneg = True;
        ap = ap[1:len(ap)];
    }
    if len(bp) > 0 and bp[0:1] == "-" {
        bneg = True;
        bp = bp[1:len(bp)];
    }
    q: str = _bigint_str_divmod_pos(ap, bp);
    r: str = _BIGINT_DIV_REM_STR;
    qneg: bool = aneg != bneg;
    if qneg and q != "0" {
        q = "-" + q;
    }
    if aneg and r != "0" {
        r = "-" + r;
    }
    _BIGINT_DIV_REM_STR = r;
    return q;
}

def _bigint_str_mul(a_str: str, b_str: str) -> str {
    if a_str == "0" or b_str == "0" or len(a_str) == 0 or len(b_str) == 0 {
        return "0";
    }
    if not _bigint_is_decimal_str(a_str) or not _bigint_is_decimal_str(b_str) {
        return "0";
    }
    return bn_to_string(bn_mul(bn_parse_decimal(a_str), bn_parse_decimal(b_str)), 10);
}

def _bigint_pow10(exp: int) -> str {
    if exp <= 0 {
        return "1";
    }
    out: str = "1";
    i: int = 0;
    while i < exp {
        out = out + "0";
        i = i + 1;
    }
    return out;
}

def _bigint_str_pow(base_s: str, exp: int) -> str {
    if exp == 0 {
        return "1";
    }
    if base_s == "10" {
        return _bigint_pow10(exp);
    }
    if exp == 1 {
        return base_s;
    }
    if exp < 0 {
        return "0";
    }
    result: str = "1";
    cur: str = base_s;
    e: int = exp;
    while e > 0 {
        if e % 2 == 1 {
            result = _bigint_str_mul(result, cur);
        }
        cur = _bigint_str_mul(cur, cur);
        e = e // 2;
    }
    return result;
}

"""Create a BigInt JSValue from a float64 value."""
def js_bigint_from_num(f: float) -> JSValue {
    s: str = "";
    if f > -_BIGINT_SAFE_MAX and f < _BIGINT_SAFE_MAX {
        s = str(int(f));
    } else {
        s = str(f);
    }
    return jsv_from_cell_kind(str_intern(s), JS_CELL_KIND_BIGINT);
}

"""Create a BigInt JSValue from an int64 integer (stores decimal string in string table)."""
def js_bigint(n: int) -> JSValue {
    id: int = str_intern_index(n);
    return jsv_from_cell_kind(id, JS_CELL_KIND_BIGINT);
}

"""Extract the numeric value from a BigInt JSValue as a float."""
def jsv_to_bigint_num(v: JSValue) -> float {
    s: str = str_from_id(jsv_to_table_id(v));
    return float(s);
}

"""Extract the int64 value from a BigInt JSValue (only safe for |value| < 2^63)."""
def jsv_to_bigint_int(v: JSValue) -> int {
    s: str = str_from_id(jsv_to_table_id(v));
    return int(s);
}

"""Extract the Jac str from a JSValue (any tag)."""
def:pub jsval_to_str(v: JSValue) -> str {
    if jsv_is_string_cell(v) {
        return str_from_id(jsv_to_table_id(v));
    }
    # A BigInt cell stores its decimal digit string in the string table; ToString
    # of a BigInt is those digits (no `n` suffix) — ES §7.1.17 / §21.2.3.
    if jsv_is_bigint_cell(v) {
        return str_from_id(jsv_to_table_id(v));
    }
    # All finite doubles: ES §6.1.6.1.20 Number::ToString via dtoa (not Jac/Python
    # str(n), which emits scientific forms like "1e+20" for property keys).
    if jsv_is_double(v) {
        return number_to_string_radix10(jsv_to_double(v));
    }
    return jsv_coerce_to_str(v);
}

"""
Convert a JSValue used as a property key to an integer key suitable for
js_object_get / js_object_set.

- Symbol JSValues use their symbol ID offset by SYMBOL_KEY_BASE so they
  never collide with string-interned key IDs.
- Everything else is coerced to a string and run through str_intern.
"""
def jsval_to_prop_key(v: JSValue) -> int {
    if jsv_is_symbol(v) {
        return SYMBOL_KEY_BASE + jsv_to_table_id(v);
    }
    # An interned string's id is already its key; an index uses the cached
    # decimal key. (Both re-interned their text: a hash + dict probe each.)
    if jsv_is_string_cell(v) and jsv_to_table_id(v) < HEAP_STRING_BASE {
        return jsv_to_table_id(v);
    }
    if jsv_is_int32(v) and jsv_to_int32(v) >= 0 {
        return str_intern_index(jsv_to_int32(v));
    }
    return str_intern(jsval_to_str(v));
}

"""Convert a float result to the most compact JSValue (Int32 when exact)."""
def float_to_jsval(n: float) -> JSValue {
    if not (n == n) {
        return js_nan();
    }
    # Preserve negative zero: int(-0.0)==0 and float(0)==-0.0 (IEEE 0.0 == -0.0),
    # so the Int32 fast path would silently turn -0 into +0. -0 must stay a double
    # so `1/(-0+-0) === -Infinity` holds (test262 S11.6.1_A4_T5). Detect it via the
    # sign bit (__float_bits<0). NOTE: never use `1.0/n` here — float division by
    # zero aborts in Jac native; the codebase uses __float_bits for sign-of-zero.
    if n == 0.0 {
        if __float_bits(n) < 0 {
            return js_number(n);
        }
        return js_int(0);
    }
    if n >= -2147483648.0 and n <= 2147483647.0 {
        i: int = int(n);
        if float(i) == n {
            return js_int(i);
        }
    }
    return js_number(n);
}

"""ECMAScript ToNumber — handles all tags including String (via str_to_float)."""
def js_to_num(v: JSValue) -> float {
    if jsv_is_string_cell(v) {
        return str_to_float(str_from_id(jsv_to_table_id(v)));
    }
    if jsv_is_bigint_cell(v) {
        vm_throw_native(make_type_error("Cannot convert a BigInt value to a number"));
        return 0.0;
    }
    return jsv_coerce_to_number(v);
}

"""ECMAScript ToInt32 — convert an arbitrary Python integer to a signed 32-bit
integer, matching the spec behaviour for all bitwise operators.
  to_int32(0xFFFFFFFF)  == -1
  to_int32(0xFF000000)  == -16777216
  to_int32(255)         == 255
"""
def to_int32(x: int) -> int {
    masked: int = x & 4294967295;  # keep only the low 32 bits
    if masked >= 2147483648 {
        return masked - 4294967296;
    }  # sign-extend
    return masked;
}

"""Legacy octal value (Annex B.1.1) of a decimal-integer literal's digits `rest`:
if `rest` is `0` followed by only octal digits (0-7), returns its octal value (>=0);
otherwise -1 (a decimal number, or contains 8/9/`.`/`e`).  Sloppy mode only."""
def _legacy_octal_value(rest: str) -> int {
    ln: int = len(rest);
    if ln < 2 {
        return -1;
    }
    if rest[0] != "0" {
        return -1;
    }
    val: int = 0;
    i: int = 1;
    while i < ln {
        c: str = rest[i];
        if c < "0" or c > "7" {
            return -1;
        }
        val = val * 8 + ord(c) - 48;
        i = i + 1;
    }
    return val;
}

"""
Decode a constant-pool entry into a JSValue.

Convention set by the compiler :
  "n:<digits>"  — numeric literal → parsed as float → Int32 or Float64
  "s:<text>"    — string literal  → interned string
  anything else — bare identifier string (used by LOAD_GLOBAL / GET_PROP)
"""
def const_to_jsval(s: str) -> JSValue {
    n: int = len(s);
    if n >= 2 {
        c0: str = s[0];
        c1: str = s[1];
        if c0 == "n" and c1 == ":" {
            rest: str = str_substr(s, 2, n);
            rn: int = len(rest);
            # Handle 0o/0O octal and 0b/0B binary prefixes (strtod handles 0x already)
            if rn >= 3 and rest[0] == "0" {
                pfx: str = rest[1];
                if pfx == "o" or pfx == "O" {
                    ov: int = 0;
                    oi: int = 2;
                    while oi < rn {
                        oc: str = rest[oi];
                        if oc != "_" and oc >= "0" and oc <= "7" {
                            ov = ov * 8 + ord(oc) - 48;
                        }
                        oi = oi + 1;
                    }
                    return float_to_jsval(float(ov));
                }
                if pfx == "b" or pfx == "B" {
                    bv: int = 0;
                    bi: int = 2;
                    while bi < rn {
                        bc: str = rest[bi];
                        if bc == "1" {
                            bv = bv * 2 + 1;
                        } elif bc == "0" {
                            bv = bv * 2;
                        }
                        bi = bi + 1;
                    }
                    return float_to_jsval(float(bv));
                }
            }
            # Legacy octal (Annex B.1.1): a `0`-prefixed integer with only octal digits
            # (0-7) and no `.`/`e`/`x` is octal in sloppy mode (`012` === 10).  Detected
            # via a helper (keeps this function small — vm.na.jac parser fn-budget).
            lo_val: int = _legacy_octal_value(rest);
            if lo_val >= 0 {
                return float_to_jsval(float(lo_val));
            }
            f: float = float(rest);
            return float_to_jsval(f);
        }
        if c0 == "b" and c1 == ":" {
            # BigInt literal: "b:digits".  A decimal literal is stored as-is (full
            # precision).  A hex/octal/binary literal (0x…/0o…/0b…) is converted to its
            # decimal digit string here so String()/arithmetic see the true value —
            # BigInt cells store a base-10 string (else `String(0x…n)` leaked the hex
            # form and arithmetic fell back to lossy float).
            bi_rest: str = str_substr(s, 2, n);
            bi_base: int = 0;
            bi_neg: bool = False;
            bi_start: int = 0;
            if len(bi_rest) > 0 and bi_rest[0] == "-" {
                bi_neg = True;
                bi_start = 1;
            }
            if len(bi_rest) >= bi_start + 2 and bi_rest[bi_start] == "0" {
                bi_pfx: str = bi_rest[bi_start + 1];
                if bi_pfx == "x" or bi_pfx == "X" {
                    bi_base = 16;
                } elif bi_pfx == "o" or bi_pfx == "O" {
                    bi_base = 8;
                } elif bi_pfx == "b" or bi_pfx == "B" {
                    bi_base = 2;
                }
            }
            if bi_base != 0 {
                bi_acc: list[int] = bn_from_int(0);
                bi_di: int = bi_start + 2;
                while bi_di < len(bi_rest) {
                    bi_ch: str = bi_rest[bi_di];
                    bi_dv: int = -1;
                    if bi_ch >= "0" and bi_ch <= "9" {
                        bi_dv = ord(bi_ch) - ord("0");
                    } elif bi_ch >= "a" and bi_ch <= "f" {
                        bi_dv = ord(bi_ch) - ord("a") + 10;
                    } elif bi_ch >= "A" and bi_ch <= "F" {
                        bi_dv = ord(bi_ch) - ord("A") + 10;
                    }
                    if bi_dv >= 0 and bi_dv < bi_base {
                        bi_acc = bn_mul_small(bi_acc, bi_base);
                        if bi_dv > 0 {
                            bi_acc = bn_add(bi_acc, bn_from_int(bi_dv));
                        }
                    }
                    bi_di = bi_di + 1;
                }
                bi_dec: str = bn_to_string(bi_acc, 10);
                if bi_neg and bi_dec != "0" {
                    bi_dec = "-" + bi_dec;
                }
                return jsv_from_cell_kind(str_intern(bi_dec), JS_CELL_KIND_BIGINT);
            }
            return jsv_from_cell_kind(str_intern(bi_rest), JS_CELL_KIND_BIGINT);
        }
        if c0 == "s" and c1 == ":" {
            rest2: str = str_substr(s, 2, n);
            return js_str(rest2);
        }
    }
    # Fallback: old-style or unexpected constant — treat as string
    return js_str(s);
}

"""
JS Addition — ECMAScript §13.15.3 ApplyStringOrNumericBinaryOperator.
String + anything → string concatenation; otherwise numeric addition.
"""
def js_add(a: JSValue, b: JSValue) -> JSValue {
    if jsv_is_string_cell(a) and jsv_is_string_cell(b) {
        # Both already strings: build a lazy rope over their cell ids — O(1), no
        # copy. A `s += chunk` loop becomes amortized O(n); the text is only
        # materialised when read (str_from_id). This is the whole fix for the
        # O(n^2) concat blowup.
        return jsv_from_string_id(str_rope(jsv_to_table_id(a), jsv_to_table_id(b)));
    }
    if jsv_is_string_cell(a) or jsv_is_string_cell(b) {
        # One operand needs ToString/ToPrimitive first; do that, then rope.
        return jsv_from_string_id(
            str_rope(str_heap(jsval_to_str(a)), str_heap(jsval_to_str(b)))
        );
    }
    # Int32+int32 fast path: stay in int32 when the mathematical sum fits.
    # Overflow falls through to float64 so IEEE-754 / Number semantics hold
    # (e.g. 2147483647 + 1 → 2147483648, not int32 wrap).
    if jsv_is_int32(a) and jsv_is_int32(b) {
        ia: int = jsv_to_int32(a);
        ib: int = jsv_to_int32(b);
        sum_i: int = ia + ib;
        if sum_i >= -2147483648 and sum_i <= 2147483647 {
            return js_int(sum_i);
        }
    }
    return float_to_jsval(js_to_num(a) + js_to_num(b));
}

"""Compare two NON-NEGATIVE decimal magnitude strings → -1/0/1."""
def _dec_mag_cmp(a: str, b: str) -> int {
    x: str = _bigint_trim_zeros(a);
    y: str = _bigint_trim_zeros(b);
    if len(x) != len(y) {
        return -1 if len(x) < len(y) else 1;
    }
    if x < y {
        return -1;
    }
    if x > y {
        return 1;
    }
    return 0;
}

"""Compare two SIGNED decimal strings → -1/0/1."""
def _bigint_dec_cmp(a: str, b: str) -> int {
    an: bool = len(a) > 0 and a[0:1] == "-";
    bn: bool = len(b) > 0 and b[0:1] == "-";
    am: str = a[1:] if an else a;
    bm: str = b[1:] if bn else b;
    # -0 == 0
    az: bool = _bigint_trim_zeros(am) == "0";
    bz: bool = _bigint_trim_zeros(bm) == "0";
    if az {
        an = False;
    }
    if bz {
        bn = False;
    }
    if an and not bn {
        return -1;
    }
    if bn and not an {
        return 1;
    }
    c: int = _dec_mag_cmp(am, bm);
    if an {
        return -c;
    }
    return c;
}

"""ES §7.2.13 IsLessThan for two Strings: lexicographic by UTF-16 CODE UNIT (not by
UTF-8 bytes or code point). A supplementary-plane char (U+10000+) begins with a high
surrogate 0xD800–0xDBFF, which is LESS than a BMP char in 0xE000–0xFFFF — the opposite
of a code-point/byte compare (test262 <op>/S11.8.*_A4.12: `"\\u{10000}" < "\\uFFFF"`)."""
def _js_str_lt_utf16(a: str, b: str) -> bool {
    ua: list[int] = js_string_utf16_units(a);
    ub: list[int] = js_string_utf16_units(b);
    la: int = len(ua);
    lb: int = len(ub);
    n: int = la if la < lb else lb;
    i: int = 0;
    while i < n {
        if ua[i] != ub[i] {
            return ua[i] < ub[i];
        }
        i = i + 1;
    }
    return la < lb;
}

"""IsLessThan(a, b) as a 3-state result (ES §7.2.13): 1 = a<b, 0 = a>=b,
2 = undefined/incomparable (a NaN Number, or a String that is not a valid BigInt
in a BigInt↔String comparison). Operands are already ToPrimitive(number)'d; Symbol
operands must be rejected by the caller before this runs."""
def _js_lt3(a: JSValue, b: JSValue) -> int {
    # Normalize a Boolean/null/undefined/Number operand to a Number (ToNumeric for the
    # relational operators): Boolean→0/1, null→0, undefined→NaN. Leaves String and BigInt
    # untouched (their comparisons are special-cased below) so js_to_num(BigInt) — which
    # throws — is never reached (test262 <op>/bigint-and-boolean).
    if jsv_is_bool(a)
        or jsv_is_null(a)
        or jsv_is_undefined(a)
        or jsv_is_int32(a)
        or jsv_is_double(a) {
        a = js_number(js_to_num(a));
    }
    if jsv_is_bool(b)
        or jsv_is_null(b)
        or jsv_is_undefined(b)
        or jsv_is_int32(b)
        or jsv_is_double(b) {
        b = js_number(js_to_num(b));
    }
    if jsv_is_string_cell(a) and jsv_is_string_cell(b) {
        return 1 if _js_str_lt_utf16(jsval_to_str(a), jsval_to_str(b)) else 0;
    }
    if jsv_is_bigint_cell(a) and jsv_is_bigint_cell(b) {
        return 1 if _bigint_dec_cmp(_bigint_str_of(a), _bigint_str_of(b)) < 0 else 0;
    }
    # BigInt ↔ String: StringToBigInt(the string); invalid → incomparable.
    if jsv_is_bigint_cell(a) and jsv_is_string_cell(b) {
        sb: str = _string_to_bigint_or_empty(str_from_id(jsv_to_table_id(b)));
        if len(sb) == 0 {
            return 2;
        }
        return 1 if _bigint_dec_cmp(_bigint_str_of(a), sb) < 0 else 0;
    }
    if jsv_is_string_cell(a) and jsv_is_bigint_cell(b) {
        sa: str = _string_to_bigint_or_empty(str_from_id(jsv_to_table_id(a)));
        if len(sa) == 0 {
            return 2;
        }
        return 1 if _bigint_dec_cmp(sa, _bigint_str_of(b)) < 0 else 0;
    }
    # BigInt ↔ Number: mathematical; a NaN Number is incomparable.
    if jsv_is_bigint_cell(a) and (jsv_is_int32(b) or jsv_is_double(b)) {
        return _bigint_num_lt3(
            _bigint_str_of(a),
            float(jsv_to_int32(b)) if jsv_is_int32(b) else jsv_to_double(b),
            True
        );
    }
    if (jsv_is_int32(a) or jsv_is_double(a)) and jsv_is_bigint_cell(b) {
        return _bigint_num_lt3(
            _bigint_str_of(b),
            float(jsv_to_int32(a)) if jsv_is_int32(a) else jsv_to_double(a),
            False
        );
    }
    # Number ↔ Number (and Number ↔ String already coerced): a NaN → incomparable.
    a_ln: float = js_to_num(a);
    b_ln: float = js_to_num(b);
    if not (a_ln == a_ln) or not (b_ln == b_ln) {
        return 2;
    }
    return 1 if a_ln < b_ln else 0;
}

"""IsLessThan for a BigInt (`bi`, decimal) and a Number `nf`. `bi_is_left` picks
the operand order (bi<nf vs nf<bi). Returns the 3-state code (2 = NaN)."""
def _bigint_num_lt3(bi: str, nf: float, bi_is_left: bool) -> int {
    if not (nf == nf) {
        return 2;
    }
    cmp: int = 0;
    if nf == MATH_INF {
        cmp = -1;
    } elif nf == -MATH_INF {
        cmp = 1;
    } elif nf <= 9.2e18 and nf >= -9.2e18 {
        fl: int = int(nf);  # truncates toward zero
        base: int = _bigint_dec_cmp(bi, str(fl));
        if base != 0 {
            cmp = base;
        } else {
            # bi == trunc(nf): the fractional part decides. nf > fl ⇒ bi < nf.
            if nf > float(fl) {
                cmp = -1;
            } elif nf < float(fl) {
                cmp = 1;
            } else {
                cmp = 0;
            }
        }
    } else {
        # Beyond int64: compare via float (nf is already imprecise at this scale).
        bf: float = str_to_float(bi);
        if bf < nf {
            cmp = -1;
        } elif bf > nf {
            cmp = 1;
        } else {
            cmp = 0;
        }
    }
    # cmp is sign of (bi - nf). bi<nf ⟺ cmp<0.
    if bi_is_left {
        return 1 if cmp < 0 else 0;
    }
    return 1 if cmp > 0 else 0;  # nf < bi ⟺ (bi - nf) > 0
}

def js_lt(a: JSValue, b: JSValue) -> bool {
    return _js_lt3(a, b) == 1;
}

# ══════════════════════════════════════════════════════════════════════════════
# 3.  Call frame
# ══════════════════════════════════════════════════════════════════════════════

"""
One activation record on the JS call stack — owns everything execution of a single
function call needs: its bytecode + IP, local/parameter slots, captured free
variables, the `this` binding, and the per-frame handler stacks for exceptions,
`with` scopes, and `using` disposal.

Invariants:
  - The operand stack is shared across frames; `stack_base` records this frame's
    depth at entry so RETURN and exception unwinding restore the stack to it.
  - Each exception handler snapshots the dynamic `with` and `using` scope depths
    active when it was installed: catch_with_depths and catch_dispose_depths run
    PARALLEL to catch_stack, and an unwind restores those depths before entering
    the handler. The three stacks must stay parallel.
  - A derived constructor's `this` is in TDZ until super() completes (ES §13.3.7.1).
    this_binding_cell is the shared cell so arrows nested in the ctor observe the
    same initialization; ctor_class (not new.target) selects which class's instance
    fields super() initializes in an A←B←C chain (ES §15.7).
  - A `using` resource's [Symbol.dispose]/[Symbol.asyncDispose] is resolved ONCE at
    declaration (ES §13.15.4) and cached in dispose_methods — never re-read at
    disposal (the accessor must be observed exactly once).

Field order is ABI-/serialization-sensitive: fields must be APPENDED, never inserted
mid-struct, or activation-record offsets shift (see js_engine-vm-struct-field-order).
A default of `0` means "none"/"undefined" for the JSValue-typed slots.
"""
# GC invariant: every JSValue / list[JSValue] field here MUST be appended to
# the frame root walk in _exec's gc_collect trigger, or its referent can be
# swept while the frame is live (use-after-free / false super-double-init).
obj CallFrame {
    # Core execution state
    has func: CompiledFunction,
        stack_base: int,
        locals: list[JSValue],
        catch_stack: list[int],
        free_vals: list[JSValue],
        this_val: JSValue,
        self_fn: JSValue,
        ip: int = 0,
        win: bool = False,
        lb: int = 0,
        rare: bool = False,
        with_objs: list[JSValue] = [],
        catch_with_depths: list[int] = [],
        dispose_stack: list[JSValue] = [],
        dispose_async: list[int] = [],
        dispose_methods: list[JSValue] = [],
        dispose_marks: list[int] = [],
        catch_dispose_depths: list[int] = [],
        new_target: JSValue = 0,
        this_uninitialized: bool = False,
        with_inherited: int = 0,
        dyn_var_names: list[str] = [],
        dyn_var_vals: list[JSValue] = [],
        this_binding_cell: JSValue = 0,
        ctor_class: JSValue = 0,
        caller_module_fns: list[CompiledFunction] = [],
        native_roots: list[JSValue] = [],
        ctor_this: JSValue = 0,
        discard_ret: bool = False,
        rpc: int = 0,
        ret_reg: int = 0,
        mod_swapped: bool = False,
        post_fields: JSValue = 0,
        saved_mod: JSValue = 0,
        saved_exp: JSValue = 0;
}

# pending handler IPs (PUSH_CATCH / PUSH_FINALLY arg)

# the closure JSValue for this call (for LOAD_SELF)

# Register window (V3.1): a window frame's `locals` IS the VM's register
# file (`vm.regs`) and its registers are locals[lb .. lb + func.num_locals);
# a list frame owns its `locals` list and has lb = 0.

# True once any of the rare-state lists below got an element: the in-loop
# call entry clears them only then (every site that fills one sets it).

# Dynamic `with` scope state
# active `with` chain (innermost last)
# with_objs depth per handler (parallel to catch_stack)

# Explicit resource management (`using` / `await using`)
# disposable resources (innermost last)
# 1 if the resource uses Symbol.asyncDispose
# dispose method resolved once at declaration (see docstring)
# Scope markers (dispose_stack depth per DISPOSE_MARK), kept off the operand stack
# so abrupt completion can still dispose down to the enclosing marker.

# dispose_marks depth per handler (parallel to catch_stack)

# Constructor / new.target state
# ES §9.4.3; arrows inherit lexically. 0 = ordinary call
# derived-ctor `this` TDZ until super() (see docstring)

# Direct-eval dynamic bindings
# Number of leading `with_objs` inherited from an outer lexical environment; a local
# of this frame shadows them, so only indices >= with_inherited are inner to locals
# (LOAD_NAME/STORE_NAME resolution order, ES §9.1).

# `var`s introduced by direct eval (Annex B.3.3.3). Per-frame so recursive activations
# stay isolated (not stored on the shared CompiledFunction).

# Shared this-binding cell for a derived ctor + its nested arrows (ES §9.1.1.3): a cell
# holding the TDZ sentinel = uninitialized, else the bound `this`. 0 = ordinary frame.

# active ctor's class for super()'s field init (see docstring)
# Inline calls (call_path Phase 3): the module_fns list that was active
# in the CALLER when this frame was entered inline — restored on inline
# return/unwind. Unused (stale) on natively-run frames. Appended at END.

# GC roots for a native builtin's in-flight values (call_path/GC): while a
# native like Array.prototype.map re-enters the VM per element, its
# receiver/callback/RESULT live only in jac locals — invisible to the GC
# root walk. A collection during the callback swept the live result array
# mid-loop (vite cac Option.names corruption: names became a cleared,
# re-appended non-array and option.name stored undefined — the razor-thin
# alignment-sensitive `checkOptionValue` `.split` crash). Builtins stash
# such values here; the collection safepoint traces it per frame. Reset at
# each native-call entry — no balanced pops needed, over-retention is
# bounded by one native call. Appended at struct END (ABI).

# Register loop [[Construct]] frame (R_NEW): the object under construction,
# returned unless the body returns an object; 0 for an ordinary call.

# Inline setter frame (setter IC): its return value is dropped instead of
# pushed for the caller — the assignment's value is already in place.

# Register ISA frames (func.risa == 1, VM._exec_reg): `rpc` is the register
# pc to resume at (the frame's `ip` keeps meaning "stack instruction index
# + 1" of the instruction last executing or calling out, so handler
# self-patching of code[ip - 1] and stack-trace lines work unchanged);
# `ret_reg` is the CALLER's register an in-loop callee's result goes to.
# Appended at struct END (ABI).

# In-loop call into another CommonJS module (V4.3): the caller's
# `module` / `exports` globals, restored when this frame is popped.

# In-loop construction (V4.7): the derived class whose own instance
# fields run on the result when this (super-)constructor frame returns.
"""Resolve a constant-name property key, caching the intern id into Instruction.arg2.

GET_PROP / DEL_PROP / SUPER_GET_PROP / SUPER_SET_PROP never use arg2 for anything
else (arg2 is always 0 at compile time).  First execution interns once and
self-patches the bytecode so every later dispatch skips the hash lookup.
Compile-time emitters may also pre-fill arg2 via str_intern(name)."""
def _ins_cached_key_arg2(frame: CallFrame, ins: Instruction) -> int {
    if ins.arg2 != 0 {
        return ins.arg2;
    }
    kid: int = str_intern(frame.func.constants.get(ins.arg));
    pip: int = frame.ip - 1;
    if pip >= 0 and pip < len(frame.func.code) {
        old: Instruction = frame.func.code[pip];
        old.arg2 = kid;
        old.ic_epoch = 0;
    }
    return kid;
}

"""Resolve SET_PROP key + define-own flag, caching into arg3 as
`(kid<<2)|(private<<1)|define`.

Compile-time encodings:
  arg3 == 0 → normal [[Set]], uncached
  arg3 == 1 → CreateDataProperty (object-literal / class field), uncached
  arg3 >= 2 → cached: key = arg3>>2, private = (arg3>>1)&1, define_own = arg3&1

Returns the SAME encoding as a plain int — callers decode with `>> 2` /
`(>> 1) & 1` / `& 1`. (This used to return a 2-element list, which
allocated a fresh list per property store per RUN — 2 heap allocations
per store on the hot ctor path.)"""
def _ins_cached_set_prop_key(frame: CallFrame, ins: Instruction) -> int {
    a3: int = ins.arg3;
    if a3 >= 2 {
        return a3;
    }
    kid: int = str_intern(frame.func.constants.get(ins.arg));
    define_own: int = 1 if a3 == 1 else 0;
    # Private-name keys (`__priv_…` brand storage) are classified ONCE here;
    # the store path used to str_from_id + str_substr the key on every slow
    # write to find out.
    privkey: int = 0;
    kname: str = frame.func.constants.get(ins.arg);
    if len(kname) >= 7 and str_substr(kname, 0, 7) == "__priv_" {
        privkey = 1;
    }
    encoded: int = (kid << 2) | (privkey << 1) | define_own;
    pip: int = frame.ip - 1;
    if pip >= 0 and pip < len(frame.func.code) {
        old: Instruction = frame.func.code[pip];
        old.arg3 = encoded;
        old.ic_epoch = 0;
    }
    return encoded;
}

"""G0.5 — register a VM-created closure (arrow / concise-method / bound), reusing
a GC-freed slot from `free_closure_slots` when one is available instead of always
growing `realm.closures` (previously arrow/method/bound churn grew the closures
table unbounded; only `make_closure` reused). Mirrors make_closure's slot
discipline; the parallel `functions[idx]` metadata slot is cleared to a dummy on
reuse (VM closures carry their real name/length in `fn_props` and have no
[[prototype]] of their own, so `undefined` is the correct, consistent state —
gc_sweep_closures does NOT clear functions on free). Returns the 0-based idx."""
def:pub vm_register_closure(realm: Realm, cl: JSClosure) -> int {
    if len(realm.free_closure_slots) > 0 {
        _rc_last: int = len(realm.free_closure_slots) - 1;
        idx: int = realm.free_closure_slots[_rc_last];
        del realm.free_closure_slots[_rc_last];
        realm.closures[idx] = cl;  # fresh cl (cell_flags=0) clears the DEAD tombstone
        realm.closures_mark_epoch[idx] = 0;
        if idx < len(realm.functions) {
            # reset the freed slot's record in place (V4.24): the fields a
            # fresh JSFunctionMeta(name="", arg_count=0, prototype_obj=
            # undefined, source="") has
            rc_fm: JSFunctionMeta = realm.functions[idx];
            rc_fm.name = "";
            rc_fm.arg_count = 0;
            rc_fm.prototype_obj = js_undefined();
            rc_fm.source = "";
            rc_fm.cell_kind = 3;
            rc_fm.cell_flags = 0;
            rc_fm.structure_id = 0;
            if idx < len(realm.functions_mark_epoch) {
                realm.functions_mark_epoch[idx] = 0;
            }
        }
        gc_note_alloc(realm);
        return idx;
    }
    _rc_idx: int = len(realm.closures);
    realm.closures.append(cl);
    realm.closures_mark_epoch.append(0);
    gc_note_alloc(realm);
    return _rc_idx;
}

# ══════════════════════════════════════════════════════════════════════════════
# 4.  VM
# ══════════════════════════════════════════════════════════════════════════════

"""Per-invocation loop state for _exec. Passed to every _op_* handler so
recursive _exec calls each have their own running/ret without aliasing."""
obj ExecState {
    has running: bool = True,
        ret: JSValue = 0,
        tail_pending: bool = False,
        inline_depth: int = 0,
        frame_switched: bool = False,
        allow_inline: bool = False;
}


# Same-loop inline calls (call_path_impl_plan Phase 3): number of
# frames on self.frames that belong to THIS _exec invocation beyond
# the one it was entered with, and the rebind signal set whenever the
# current frame changed (inline call entry / return / unwind).

# SAFETY DEFAULT FALSE: only VM._exec's own loop understands the
# frame_switched protocol — auxiliary dispatch loops that share the
# handlers (the generator-parameter prologue, and anything future)
# must never admit inline calls (an inline entry there corrupted the
# operand stack: gen-meth destructuring core dump, 2026-08-26).
def _is_arr_callback_kind(kind: int) -> bool {
    return kind == NATIVE_KIND_ARRAY_FOREACH
        or kind == NATIVE_KIND_ARRAY_MAP
        or kind == NATIVE_KIND_ARRAY_FILTER
        or kind == NATIVE_KIND_ARRAY_REDUCE
        or kind == NATIVE_KIND_ARRAY_REDUCERIGHT
        or kind == NATIVE_KIND_ARRAY_FIND
        or kind == NATIVE_KIND_ARRAY_FINDINDEX
        or kind == NATIVE_KIND_ARRAY_FINDLAST
        or kind == NATIVE_KIND_ARRAY_FINDLASTINDEX
        or kind == NATIVE_KIND_ARRAY_SOME
        or kind == NATIVE_KIND_ARRAY_EVERY
        or kind == NATIVE_KIND_ARRAY_SORT
        or kind == NATIVE_KIND_ARRAY_FLATMAP;
}

"""
Bytecode interpreter — owns all mutable JS execution state for one context.

The VM holds:
  - the execution core: the shared operand `stack` (every frame indexes it via its
    own stack_base) and the `frames` call stack;
  - global/module state: `globals`, `global_this`, and `module_fns` (MAKE_FUNCTION /
    MAKE_ARROW index into module_fns);
  - exception state: `pending_exc` + `had_exception` while an exception propagates;
  - the suspension state machines for generators (`yielded` / yield* forwarding),
    async/await (`vm_awaiting` / `_cur_async_promise`), and forced-return
    (`_gen_ret_pending`);
  - module/ESM, direct-eval/cross-realm, constructor/new.target, and tail-call
    channels used to thread information into the next frame.

Field-level comments below carry the per-field invariants; most one-shot "channel"
fields (pending_new_target, _tail_*, ys_*) are set by a call site immediately before
run()/run_cl() and consumed + reset as the callee frame is built. `call_depth`
guards against native-stack overflow (VM_MAX_CALL_DEPTH).

Struct field order is offset-sensitive — append new fields, never insert
(js_engine-vm-struct-field-order).
"""
obj VM {
    # ── Core execution / global / module state ──
    has realm: Realm,
        stack: list[JSValue],
        frames: list[CallFrame],
        globals: dict[str, JSValue],
        global_this: JSValue,
        module_fns: list[CompiledFunction],
        pending_exc: JSValue,
        _cur_async_promise: JSValue,
        pending_new_target: JSValue = js_undefined(),
        had_exception: bool = False,
        _coerce_diverted: bool = False,
        _gen_ret_pending: bool = False,
        call_depth: int = 0,
        yielded: bool = False,
        yielded_star: bool = False,
        vm_awaiting: bool = False,
        _draining_streams: bool = False,
        script_dir: str = "",
        engine_root: str = "",
        require_parent_override: str = "",
        require_is_esm: int = 0,
        dynamic_import_active: int = 0,
        esm_entry: int = 0,
        entry_file: str = "",
        current_esm_exports_global: str = "",
        sync_require_esm: int = 0,
        sync_require_esm_file: str = "",
        sync_require_esm_parent: str = "",
        import_source_phase: int = 0,
        import_defer_phase: int = 0,
        esm_meta_ast: dict[str, ASTNode] = {},
        esm_meta_src: dict[str, str] = {},
        eval_scope_frames: list[int] = [],
        eval_super_fns: list[JSValue] = [],
        obs_handle: int = 0,
        napi_env_ptr: int = 1,
        ys_return_out: bool = False,
        ys_yield_result: JSValue = 0,
        _pending_new_target: JSValue = 0,
        _pending_this_uninit: bool = False,
        _pending_ctor_class: JSValue = 0,
        _pending_source_realm_id: int = 0,
        pending_eval_source_realm: int = 0,
        _tail_closure: JSValue = 0,
        _tail_this: JSValue = 0,
        _tail_args: list[JSValue] = [],
        pending_ctx_realm_only: bool = False,
        pending_ctx_global: JSValue = 0,
        pending_ctx_filename: str = "",
        global_lexical: dict[str, JSValue] = {},
        global_obj_seen_epoch: int = 0,
        globals_off_object: dict[str, bool] = {},
        pending_eval_this_set: bool = False,
        pending_eval_this: JSValue = js_undefined(),
        import_attr_type: str = "",
        class_brand_seq: int = 1,
        frame_pool: list[CallFrame] = [],
        gen_frame_pool: list[CallFrame] = [],
        gen_raw: bool = False,
        gen_raw_hit: bool = False,
        gen_raw_done: bool = False,
        reg_unwound: bool = False,
        regs: list[JSValue] = [],
        rtop: int = 0,
        gw_epoch: int = 0,
        cur_mod_val: JSValue = 0,
        reg_call_args: list[JSValue] = [],
        cur_mod_epoch: int = -1,
        cur_exp_val: JSValue = 0,
        cur_exp_epoch: int = -1,
        st_pool: list[ExecState] = [],
        reg_arg1: JSValue = 0;  # Per-context state (strings, symbols, queues…)

    # ── Debug helper ──────────────────────────────────────────────────────

    """Print msg to stdout when VM_DEBUG_MODE is True."""
    def vm_debug(msg: str) {
        print("[VM]", msg);
    }

    # ── Stack helpers ─────────────────────────────────────────────────────

    def _push(v: JSValue) {
        self.stack.append(v);
    }
    def _pop -> JSValue {
        n: int = len(self.stack);
        if n == 0 {
            print("[FATAL] VM stack underflow in _pop() — stack is empty");
            fflush(0);
            abort();
        }
        return self.stack.pop();
    }

    def _peek -> JSValue {
        return self.stack[len(self.stack) - 1];
    }
    # ── Exception helpers ─────────────────────────────────────────────────

    """
    Try to handle `exc` inside `frame` using its catch_stack.
    If a handler exists: pop it, push `exc` onto the operand stack,
    set frame.ip to the handler address, return True.
    If not: return False (caller must propagate).
    """
    def _propagate_exc(frame: CallFrame, exc: JSValue) -> bool {
        self.had_exception = False;
        self.pending_exc = js_undefined();
        if not self._unwind_in_frame(frame, exc) {
            self.had_exception = True;
            self.pending_exc = exc;
            return False;
        }
        return True;
    }

    def _unwind_in_frame(frame: CallFrame, exc: JSValue) -> bool {
        self._maybe_attach_frames(exc, frame);
        if frame.func.risa == 1 and frame.rpc >= 0 and len(frame.func.rhandler) > 0 {
            # Handler table (the throwing instruction is frame.ip - 1, which
            # every register call-out sets); such functions have no `with` /
            # `using`, so there are no depths to restore.
            uw_h: int = _reg_handler_at(frame.func, frame.ip - 1);
            if uw_h < 0 {
                return False;
            }
            self._push(exc);
            frame.ip = uw_h;
            self.reg_unwound = True;
            self.realm.safepoint_req = True;
            return True;
        }
        nc: int = len(frame.catch_stack);
        if nc > 0 {
            handler_ip: int = frame.catch_stack[nc - 1];
            del frame.catch_stack[nc - 1];
            # unwind any `with` scopes entered inside the try block, so the
            # catch handler runs with the with-chain it had at try-entry.
            ncw: int = len(frame.catch_with_depths);
            if ncw > 0 {
                target_wd: int = frame.catch_with_depths[ncw - 1];
                del frame.catch_with_depths[ncw - 1];
                while len(frame.with_objs) > target_wd {
                    del frame.with_objs[len(frame.with_objs) - 1];
                }
            }
            # Dispose `using` resources opened inside the try block before the catch
            # handler runs (abrupt completion of the disposable scope, ES §14.x).
            ncd: int = len(frame.catch_dispose_depths);
            if ncd > 0 {
                target_dd: int = frame.catch_dispose_depths[ncd - 1];
                del frame.catch_dispose_depths[ncd - 1];
                if len(frame.dispose_stack) > target_dd {
                    self._dispose_to(frame, target_dd);
                    # Drop any markers that pointed above the disposed depth.
                    while len(frame.dispose_marks) > 0
                        and frame.dispose_marks[len(frame.dispose_marks) - 1]
                            >= target_dd {
                        del frame.dispose_marks[len(frame.dispose_marks) - 1];
                    }
                }
            }
            self._push(exc);
            frame.ip = handler_ip;
            # A register frame's handler pc: the register loop re-reads it
            # (R_LANDING then pops the exception pushed above).
            if frame.func.risa == 1 {
                self.reg_unwound = True;
                self.realm.safepoint_req = True;
            }
            return True;
        }
        return False;
    }

    """
    Check the native-exception side-channel after a call_native() return.
    If a builtin signalled a throw (via vm_throw_native), consume the
    exception and enter the normal THROW/unwind path.
    If no exception, pushes `result` onto the value stack.
    Returns True if execution should continue, False if `running` must
    be set to False (exception not caught).
    """
    def _check_native_exc(frame: CallFrame, result: JSValue) -> bool {
        if vm_has_native_exc() {
            exc_ne: JSValue = vm_take_native_exc();
            if not self._unwind_in_frame(frame, exc_ne) {
                self.had_exception = True;
                self.pending_exc = exc_ne;
                return False;
            }
            return True;
        }
        # A JS closure invoked from inside the native builtin (run_cl re-entry,
        # e.g. a user iterator's next() under Object.fromEntries) reports its
        # throw via had_exception, not the native-exc slot. Without this check
        # the result was pushed and the pending exception detonated at a later,
        # unrelated checkpoint — escaping the caller's try/catch.
        if self.had_exception {
            exc_he: JSValue = self.pending_exc;
            self.had_exception = False;
            self.pending_exc = js_undefined();
            if not self._unwind_in_frame(frame, exc_he) {
                self.had_exception = True;
                self.pending_exc = exc_he;
                return False;
            }
            return True;
        }
        self._push(result);
        return True;
    }

    """
    Settle promise `p` with `state`/`value` (if not already settled) then enqueue
    all registered reactions on the deferred scheduler queue (Node.js / ECMAScript
  HostEnqueuePromiseJob semantics).  Reactions run on the next scheduler drain
    (nextTick → promise reactions → queueMicrotask), not synchronously here.
    """
    def _promise_settle_and_drain(p: JSValue, state: int, value: JSValue) -> None {
        if js_promise_get_state(p) != PROMISE_PENDING {
            return;
        }
        # Already resolved with a thenable whose job has not run yet: the
        # promise is still PENDING but its fate is sealed, so ignore any further
        # settle attempt (§27.2.1.3 step 3).
        if js_object_has_own(p, _KEY_PRESOLVED) {
            return;
        }
        # §27.2.1.3.2 step 6: resolving a promise with itself is a self-
        # resolution cycle and rejects with a TypeError rather than fulfilling.
        # Only fulfilment resolves; `reject(p)` legitimately rejects with p.
        if state == PROMISE_FULFILLED and jsv_is_object_cell(value) and value == p {
            self._promise_settle_and_drain_raw(
                p,
                PROMISE_REJECTED,
                make_type_error("Chaining cycle detected for promise #<Promise>")
            );
            return;
        }
        # §27.2.1.3.2 ResolvePromise steps 8-12: fulfilling with an object whose
        # `then` is callable adopts that thenable's state rather than fulfilling
        # with the object. The `then` lookup happens now (once, and its throw
        # rejects p), but the call is deferred to a job so user code never runs
        # synchronously inside resolve(). Rejection never assimilates.
        if state == PROMISE_FULFILLED
            and jsv_is_object_cell(value)
            and jsv_to_table_id(value) > 0 {
            # A promise is itself a thenable, so §27.2.1.3.2 applies to it as
            # well: `resolve(otherPromise)` must adopt that promise's state, not
            # fulfil with the promise object. Excluding promises here left
            # `new Promise(res => res(p))` fulfilled with p itself. The generic
            # thenable job below handles them correctly — it reads `then` (the
            # intrinsic one) and defers the call to a job, which is exactly
            # NewPromiseResolveThenableJob. (Self-resolution is rejected above,
            # so `value` is never `p` by the time control reaches here.)
            if value != p {
                then_fn: JSValue = js_undefined();
                had_exc_before: bool = self.had_exception;
                then_fn = self._get_prop_accessor(value, str_intern("then"));
                # A throwing `then` getter rejects the promise with that error.
                # It can surface on either channel: a JS getter is run by
                # _get_prop_accessor_recv, which clears self.had_exception and
                # re-raises through vm_throw_native, so checking had_exception
                # alone missed every accessor-based thenable and let the throw
                # escape synchronously out of resolve().
                if vm_has_native_exc() {
                    thr_nexc: JSValue = vm_take_native_exc();
                    self._promise_settle_and_drain_raw(p, PROMISE_REJECTED, thr_nexc);
                    return;
                }
                if self.had_exception and not had_exc_before {
                    thr_exc: JSValue = self.pending_exc;
                    self.had_exception = False;
                    self.pending_exc = js_undefined();
                    self._promise_settle_and_drain_raw(p, PROMISE_REJECTED, thr_exc);
                    return;
                }
                if self._value_is_callable(then_fn) {
                    # Adopting `value` installs handlers on it, so a rejected
                    # promise being adopted is no longer unhandled — otherwise
                    # `await Promise.reject(e)` inside a try/catch reported an
                    # "Uncaught (in promise)" alongside the caught exception.
                    if js_is_promise(value) {
                        promise_unmark_unhandled(value);
                        process_queue_rejection_handled(value);
                    }
                    # §27.2.1.3 [[AlreadyResolved]]: the promise counts as
                    # resolved from here even though it stays PENDING until the
                    # job runs, so a later reject (e.g. an executor that throws
                    # after resolve(thenable)) must be ignored.
                    js_object_set(p, _KEY_PRESOLVED, js_true());
                    job: JSValue = js_object_create_null();
                    js_object_set(job, _KEY_IS_THENABLE_JOB, js_true());
                    js_object_set(job, _KEY_THENABLE_VALUE, value);
                    js_object_set(job, _KEY_THENABLE_THEN, then_fn);
                    # p stays PENDING; the job settles it via resolve/reject fns.
                    scheduler_push_reaction(
                        self.realm,
                        job,
                        js_undefined(),
                        SCHED_REACT_MICROTASK,
                        p,
                        js_undefined()
                    );
                    return;
                }
            }
        }
        self._promise_settle_and_drain_raw(p, state, value);
    }

    """
    Settle a promise and drain its reactions with no thenable assimilation.

    _promise_settle_and_drain routes here once it has established that `value`
    is not a thenable (or that the settlement is a rejection, which never
    assimilates). Split out so the thenable job can settle unconditionally.
    """
    def _promise_settle_and_drain_raw(p: JSValue, state: int, value: JSValue) -> None {
        if js_promise_get_state(p) != PROMISE_PENDING {
            return;
        }
        js_promise_settle(p, state, value);
        reactions: JSValue = js_promise_get_reactions(p);
        n_r: int = js_array_len(reactions);
        if state == PROMISE_REJECTED and n_r == 0 {
            promise_track_unhandled(value, p);
        }
        i_r: int = 0;
        while i_r < n_r {
            r: JSValue = js_array_get(reactions, i_r);
            on_f: JSValue = js_object_get(r, _RKEY_ONFULFILL);
            on_r: JSValue = js_object_get(r, _RKEY_ONREJECT);
            next_p: JSValue = js_object_get(r, _RKEY_NEXT);
            if _VM_PD2
                and jsv_is_object_cell(on_f)
                and jsv_to_table_id(on_f) > 0
                and js_object_has_own(on_f, _KEY_IS_ASYNC_RESUME) {
                _ps: str = "[PD2] SCHED async-resume for settled promise id="
                    + str(jsv_to_table_id(p))
                    + " state="
                    + str(state)
                    + "\n";
                write(2, _ps, len(_ps));
            }
            scheduler_push_reaction(self.realm, on_f, on_r, state, value, next_p);
            i_r = i_r + 1;
        }
        js_object_set(p, _KEY_PREACTIONS, js_array_create([]));
    }

    """
    Promise Resolve Function (ES §27.2.1.3.2): adopt thenables / chain Promises
    instead of fulfilling with the thenable object itself.
    """
    def _promise_resolve_value(p: JSValue, resolution: JSValue) -> None {
        if js_promise_get_state(p) != PROMISE_PENDING {
            if _VM_PD2 {
                _erv: str = "[PD2] resolve_value EARLY-RETURN (not pending) id="
                    + str(jsv_to_table_id(p))
                    + " state="
                    + str(js_promise_get_state(p))
                    + " nReact="
                    + str(js_array_len(js_promise_get_reactions(p)))
                    + "\n";
                write(2, _erv, len(_erv));
            }
            return;
        }
        if _VM_PD2 {
            _rv2: str = "[PD2] resolve_value ENTER id="
                + str(jsv_to_table_id(p))
                + " resIsPromise="
                + str(js_is_promise(resolution))
                + " resIsObj="
                + str(jsv_is_object_cell(resolution))
                + "\n";
            write(2, _rv2, len(_rv2));
        }
        if js_is_promise(resolution) {
            if jsv_to_table_id(resolution) == jsv_to_table_id(p) {
                self._promise_settle_and_drain(
                    p,
                    PROMISE_REJECTED,
                    make_type_error("Cannot resolve Promise with itself")
                );
                return;
            }
            pst: int = js_promise_get_state(resolution);
            if pst == PROMISE_PENDING {
                js_promise_add_reaction(resolution, js_undefined(), js_undefined(), p);
                promise_unmark_unhandled(resolution);
            } else {
                self._promise_settle_and_drain(
                    p, pst, js_promise_get_value(resolution)
                );
                if pst == PROMISE_REJECTED {
                    promise_unmark_unhandled(resolution);
                }
            }
            return;
        }
        if jsv_is_object_cell(resolution) and jsv_to_table_id(resolution) > 0 {
            then_fn: JSValue = self.obs_get(resolution, WK_THEN, resolution);
            if vm_has_native_exc() {
                self._promise_settle_and_drain(
                    p, PROMISE_REJECTED, vm_take_native_exc()
                );
                return;
            }
            if self.had_exception {
                exc_th: JSValue = self.pending_exc;
                self.had_exception = False;
                self.pending_exc = js_undefined();
                self._promise_settle_and_drain(p, PROMISE_REJECTED, exc_th);
                return;
            }
            if self._value_is_callable(then_fn) {
                resolve_fn: JSValue = js_make_resolve_fn(p);
                reject_fn: JSValue = js_make_reject_fn(p);
                _vm_invoke_callback(self, then_fn, resolution, [resolve_fn, reject_fn]);
                if self.had_exception {
                    exc_call: JSValue = self.pending_exc;
                    self.had_exception = False;
                    self.pending_exc = js_undefined();
                    if js_promise_get_state(p) == PROMISE_PENDING {
                        self._promise_settle_and_drain(p, PROMISE_REJECTED, exc_call);
                    }
                } elif vm_has_native_exc() {
                    if js_promise_get_state(p) == PROMISE_PENDING {
                        self._promise_settle_and_drain(
                            p, PROMISE_REJECTED, vm_take_native_exc()
                        );
                    }
                }
                return;
            }
        }
        self._promise_settle_and_drain(p, PROMISE_FULFILLED, resolution);
    }

    """
    Resume a suspended async frame (saved by the AWAIT PENDING handler).

    Restores the operand stack, creates a new CallFrame from the saved
    JSGeneratorState, and calls _exec from the instruction after AWAIT.

    On completion (or another suspension):
      - If the function completes normally:  settle state.async_promise FULFILLED.
      - If the function throws:              settle state.async_promise REJECTED.
      - If the function hits another AWAIT:  state.async_promise stays pending;
          the new suspended frame will settle it later.

    ECMAScript §27.7.5 (PerformPromiseThen) / §27.2.4 (Promise Reactions).
    """
    # Consume a TAIL_CALL staged by a frame driven OUTSIDE run()'s trampoline.
    # The async / async-iterator / generator resume paths call _exec directly;
    # a strict `return f(...)` in such a frame stages the callee in the VM
    # _tail_* channel and stops the loop. Without draining here the callee
    # never runs — the resumed frame settles `undefined` — and the STALE
    # channel is later consumed by the next unrelated run(), delivering the
    # callee's result into the wrong caller (the rollup §5a value-loss bug).
    # Plain nested invocation (not run()'s O(1)-native-stack trampoline):
    # resume-site tail chains are shallow, and _invoke_callable_value routes
    # JS callees through run_cl → run(), whose own trampoline handles any
    # further tail recursion at O(1).
    def _drain_tail_channel(seed: JSValue) -> JSValue {
        dt_result: JSValue = seed;
        while self._tail_closure != 0 and not self.had_exception {
            dt_closure: JSValue = self._tail_closure;
            dt_this: JSValue = self._tail_this;
            dt_args: list[JSValue] = self._tail_args;
            self._tail_closure = 0;
            self._tail_this = 0;
            self._tail_args = [];
            dt_result = self._invoke_callable_value(dt_closure, dt_this, dt_args);
        }
        return dt_result;
    }

    def _resume_async_frame(idx: int, send_val: JSValue, is_rejection: bool) -> None {
        raf_state: JSGeneratorState = self.realm.generators[idx];
        if raf_state.done {
            return;
        }
        raf_state.done = True;
        self.realm.generators[idx] = raf_state;
        # The awaited promise for this frame has settled (we are its reaction):
        # release the suspend-time root registered by _op_await.
        gc_await_root_del(idx);

        raf_outer_p: JSValue = raf_state.async_promise;
        # Root the result promise across the resumed body. For a PLAIN async
        # function delegate_gen is not a generator object, so the frame's
        # self_fn does not root the generator state — and the state is the only
        # thing referencing raf_outer_p. A GC triggered by allocation in the
        # resumed body would otherwise sweep raf_outer_p and its pending-
        # reactions array, silently dropping every .then() attached before the
        # first await (repro: async fn that awaits then allocates heavily).
        raf_gtr0: int = len(self.realm.gc_temp_roots);
        self.realm.gc_temp_roots.append(raf_outer_p);

        # The saved stack_base was an ABSOLUTE index into self.stack, valid only while
        # the frame was live deep in the original (possibly very deep) call stack. By the
        # time the scheduler resumes us, that call stack has unwound, so self.stack is far
        # shorter and the old base points above the current top. Rebase to the current
        # stack length so the restored operands and all subsequent stack_base-relative
        # accesses (SWAP/_pop/etc.) address the correct slots.
        raf_new_base: int = len(self.stack);

        # Restore the saved operand stack above stack_base
        raf_si: int = 0;
        while raf_si < len(raf_state.saved_stack) {
            self.stack.append(raf_state.saved_stack[raf_si]);
            raf_si = raf_si + 1;
        }

        # Create resumed CallFrame
        # self_fn = raf_state.delegate_gen so that nested AWAIT PENDING handlers inside this
        # frame (2nd/3rd timer await in async generator body) store gen_obj in their
        # delegate_gen field, enabling _resume_async_frame to save gen state on YIELD.
        raf_frame: CallFrame = CallFrame(
            func=raf_state.func,
            stack_base=raf_new_base,
            locals=raf_state.locals,
            catch_stack=raf_state.catch_stack,
            free_vals=raf_state.free_vals,
            this_val=raf_state.this_val,
            self_fn=raf_state.delegate_gen,
            ip=raf_state.saved_ip,
            with_objs=[],
            native_roots=[]
        );
        self.frames.append(raf_frame);
        raf_frame.rpc = raf_state.saved_rpc;
        self.call_depth = self.call_depth + 1;

        # Set up module_fns for the resumed closure (may differ from caller's module)
        saved_mf_raf: list[CompiledFunction] = self.module_fns;
        self.module_fns = raf_state.module_fns;

        # Wire _cur_async_promise so nested AWAIT in this frame sees raf_outer_p
        old_cap_raf: JSValue = self._cur_async_promise;
        self._cur_async_promise = raf_outer_p;

        raf_result: JSValue = js_undefined();
        if is_rejection {
            # Inject the rejection as an exception into the frame
            if self._unwind_in_frame(raf_frame, send_val) {
                raf_result = self._drain_tail_channel(self._exec_any(raf_frame));
            } else {
                self.had_exception = True;
                self.pending_exc = send_val;
            }
        } else {
            # The resolved value is the AWAIT expression's result
            self._reg_resume_value(raf_frame, send_val);
            raf_result = self._drain_tail_channel(self._exec_any(raf_frame));
        }

        self._cur_async_promise = old_cap_raf;
        self.module_fns = saved_mf_raf;

        # ── YIELD from inside an async generator body ────────────────────────
        # When run_generator's async gen frame hits `yield v` (e.g. after `await timer`),
        # _exec returns with self.yielded=True and ret_val=v.  We must save the generator
        # state from the current CallFrame and settle rg_outer_p with {value:v, done:false}
        # BEFORE stack cleanup, while raf_frame's fields are still valid.
        raf_did_yield: bool = False;
        if self.yielded {
            raf_did_yield = True;
            # Capture residual operand stack above stack_base
            rfy_stk: list[JSValue] = [];
            rfy_cur: int = len(self.stack);
            rfy_ext: int = rfy_cur - raf_new_base;
            rfy_i: int = 0;
            while rfy_i < rfy_ext {
                rfy_stk.append(self.stack[raf_new_base + rfy_i]);
                rfy_i = rfy_i + 1;
            }
            # Save generator state back (raf_state.delegate_gen == gen_obj, set by AWAIT PENDING)
            rfy_gen_obj: JSValue = raf_state.delegate_gen;
            if js_is_generator(rfy_gen_obj) {
                rfy_gstate: JSGeneratorState = js_get_generator_state(rfy_gen_obj);
                rfy_gstate.saved_ip = raf_frame.ip;
                rfy_gstate.saved_rpc = raf_frame.rpc;
                rfy_gstate.locals = raf_frame.locals;
                rfy_gstate.catch_stack = raf_frame.catch_stack;
                rfy_gstate.saved_stack = rfy_stk;
                rfy_gstate.done = False;
                js_set_generator_state(rfy_gen_obj, rfy_gstate);
            }
            self.yielded = False;
        }

        # Stack cleanup
        while len(self.stack) > raf_new_base {
            del self.stack[len(self.stack) - 1];
        }
        raf_nf: int = len(self.frames);
        del self.frames[raf_nf - 1];
        self.call_depth = self.call_depth - 1;

        # Settle the outer async promise based on outcome
        if self.vm_awaiting {
            # Hit another AWAIT — raf_outer_p stays pending; the new suspended
            # frame already stored raf_outer_p in its async_promise field.
            self.vm_awaiting = False;
        } elif self.had_exception {
            exc_raf: JSValue = self.pending_exc;
            self.had_exception = False;
            self.pending_exc = js_undefined();
            if js_is_promise(raf_outer_p) {
                self._promise_settle_and_drain(raf_outer_p, PROMISE_REJECTED, exc_raf);
            } elif _vm_is_entry_module_frame(self, raf_state.func) {
                # No result promise: the resumed frame is the ENTRY module's top level,
                # suspended at a top-level await. Its throw is the program's
                # evaluation failing — report it as uncaught (Node prints it and
                # exits 1) instead of dropping it and exiting 0 silently.
                _vm_handle_callback_uncaught(self, exc_raf);
            } else {
                # A module loaded via import(): its import() promise was already
                # fulfilled when the module's synchronous part finished (this engine
                # does not yet make import() wait for top-level await), so the
                # importer's .catch() cannot see this rejection. Node delivers it
                # there; treating it as fatal here would kill programs that handle
                # it (test262 module-code/top-level-await/rejection-order).
                _vm_note_orphan_module_rejection(exc_raf);
            }
        } elif raf_did_yield {
            # Async generator yielded — settle outer_p with {value, done:false}
            raf_yval: JSValue = raf_result;
            raf_y_reject: bool = False;
            if js_is_promise(raf_yval) {
                raf_pst: int = js_promise_get_state(raf_yval);
                if raf_pst == PROMISE_FULFILLED {
                    raf_yval = js_promise_get_value(raf_yval);
                } elif raf_pst == PROMISE_REJECTED {
                    raf_y_reject = True;
                    if js_is_promise(raf_outer_p) {
                        self._promise_settle_and_drain(
                            raf_outer_p,
                            PROMISE_REJECTED,
                            js_promise_get_value(raf_yval)
                        );
                    }
                }
            }
            if not raf_y_reject and js_is_promise(raf_outer_p) {
                self._promise_settle_and_drain(
                    raf_outer_p, PROMISE_FULFILLED, js_iter_result(raf_yval, False)
                );
            }
        } else {
            # RETURN / ran off end: check whether it is an async gen or a regular async fn
            rfy_gen_obj2: JSValue = raf_state.delegate_gen;
            if js_is_generator(rfy_gen_obj2) {
                # Async generator returned — mark done and settle with {value, done:true}
                rfy_gstate2: JSGeneratorState = js_get_generator_state(rfy_gen_obj2);
                rfy_gstate2.done = True;
                js_set_generator_state(rfy_gen_obj2, rfy_gstate2);
                if js_is_promise(raf_outer_p) {
                    self._promise_settle_and_drain(
                        raf_outer_p, PROMISE_FULFILLED, js_iter_result(raf_result, True)
                    );
                }
            } else {
                # Regular async function return
                if js_is_promise(raf_outer_p) {
                    if js_is_promise(raf_result) {
                        raf_st: int = js_promise_get_state(raf_result);
                        if raf_st != PROMISE_PENDING {
                            self._promise_settle_and_drain(
                                raf_outer_p, raf_st, js_promise_get_value(raf_result)
                            );
                        } else {
                            js_promise_add_reaction(
                                raf_result, js_undefined(), js_undefined(), raf_outer_p
                            );
                        }
                    } else {
                        self._promise_settle_and_drain(
                            raf_outer_p, PROMISE_FULFILLED, raf_result
                        );
                    }
                }
            }
        }
        # Release the result-promise temp root (settle already ran its reactions).
        while len(self.realm.gc_temp_roots) > raf_gtr0 {
            del self.realm.gc_temp_roots[len(self.realm.gc_temp_roots) - 1];
        }
    }

    """
    Resume a frame suspended at ASYNC_ITER_NEXT while vm_awaiting an async generator's
    .next() Promise.  iter_result is the settled {value, done} object.
    Decodes it into the stack shape JUMP_IF_FALSE expects and continues _exec.
    """
    def _resume_async_iter_frame(
        idx: int, iter_result: JSValue, is_rejection: bool
    ) -> None {
        rait_state: JSGeneratorState = self.realm.generators[idx];
        if rait_state.done {
            return;
        }
        rait_state.done = True;
        self.realm.generators[idx] = rait_state;

        rait_outer_p: JSValue = rait_state.async_promise;
        # Root the result promise across the resumed body (see _resume_async_frame).
        rait_gtr0: int = len(self.realm.gc_temp_roots);
        self.realm.gc_temp_roots.append(rait_outer_p);

        # Rebase the operand stack: see _resume_async_frame. The saved absolute
        # stack_base is stale once the original deep call stack has unwound.
        rait_new_base: int = len(self.stack);

        # Restore the saved operand stack (contains the iter wrapper object)
        rait_si: int = 0;
        while rait_si < len(rait_state.saved_stack) {
            self.stack.append(rait_state.saved_stack[rait_si]);
            rait_si = rait_si + 1;
        }

        rait_frame: CallFrame = CallFrame(
            func=rait_state.func,
            stack_base=rait_new_base,
            locals=rait_state.locals,
            catch_stack=rait_state.catch_stack,
            free_vals=rait_state.free_vals,
            this_val=rait_state.this_val,
            self_fn=js_undefined(),
            ip=rait_state.saved_ip,
            with_objs=[],
            native_roots=[]
        );
        self.frames.append(rait_frame);
        self.call_depth = self.call_depth + 1;

        saved_mf_rait: list[CompiledFunction] = self.module_fns;
        self.module_fns = rait_state.module_fns;
        old_cap_rait: JSValue = self._cur_async_promise;
        self._cur_async_promise = rait_outer_p;

        rait_result: JSValue = js_undefined();
        if is_rejection {
            if self._unwind_in_frame(rait_frame, iter_result) {
                rait_result = self._drain_tail_channel(self._exec(rait_frame));
            } else {
                self.had_exception = True;
                self.pending_exc = iter_result;
            }
        } else {
            # Decode {value, done} → push expected stack items
            rait_done: bool = jsv_coerce_to_bool(js_object_get(iter_result, WK_DONE));
            if rait_done {
                self._push(js_false());
            } else {
                rait_val: JSValue = js_object_get(iter_result, WK_VALUE);
                self._push(rait_val);
                self._push(js_true());
            }
            rait_result = self._drain_tail_channel(self._exec(rait_frame));
        }

        self._cur_async_promise = old_cap_rait;
        self.module_fns = saved_mf_rait;

        # Stack cleanup
        while len(self.stack) > rait_new_base {
            del self.stack[len(self.stack) - 1];
        }
        rait_nf: int = len(self.frames);
        del self.frames[rait_nf - 1];
        self.call_depth = self.call_depth - 1;

        # Settle the outer async promise
        if self.vm_awaiting {
            self.vm_awaiting = False;
        } elif self.had_exception {
            exc_rait: JSValue = self.pending_exc;
            self.had_exception = False;
            self.pending_exc = js_undefined();
            if js_is_promise(rait_outer_p) {
                self._promise_settle_and_drain(
                    rait_outer_p, PROMISE_REJECTED, exc_rait
                );
            } elif _vm_is_entry_module_frame(self, rait_state.func) {
                # Entry module top level (top-level `for await`): see _resume_async_frame.
                _vm_handle_callback_uncaught(self, exc_rait);
            } else {
                _vm_note_orphan_module_rejection(exc_rait);
            }
        } else {
            if js_is_promise(rait_outer_p) {
                if js_is_promise(rait_result) {
                    rait_st: int = js_promise_get_state(rait_result);
                    if rait_st != PROMISE_PENDING {
                        self._promise_settle_and_drain(
                            rait_outer_p, rait_st, js_promise_get_value(rait_result)
                        );
                    } else {
                        js_promise_add_reaction(
                            rait_result, js_undefined(), js_undefined(), rait_outer_p
                        );
                    }
                } else {
                    self._promise_settle_and_drain(
                        rait_outer_p, PROMISE_FULFILLED, rait_result
                    );
                }
            }
        }
        # Release the result-promise temp root.
        while len(self.realm.gc_temp_roots) > rait_gtr0 {
            del self.realm.gc_temp_roots[len(self.realm.gc_temp_roots) - 1];
        }
    }

    """
    Drain pending stream event callbacks queued by streams.na.jac.

    Stream methods (.on, .push, .pipe) cannot directly invoke JS callbacks
    because they don't have a VM reference. Instead they enqueue (fn, args)
    pairs into _PENDING_EMIT_FNS/_PENDING_EMIT_ARGS. This method drains
    that queue, calling each callback through the VM.
    """
    def _drain_stream_pending -> None {
        # Re-entrancy guard: if a JS callback triggers more stream
        # events, the new entries stay queued for the outer loop.
        if self._draining_streams {
            return;
        }
        self._draining_streams = True;
        while stream_pending_count() > 0 {
            sp_n: int = len(_PENDING_EMIT_FNS);
            sp_i: int = 0;
            while sp_i < sp_n {
                sp_fn: JSValue = _PENDING_EMIT_FNS[sp_i];
                sp_args: list[JSValue] = _PENDING_EMIT_ARGS[sp_i];
                sp_i = sp_i + 1;
                vm_call_js_fn(self, sp_fn, js_undefined(), sp_args);
            }
            # Remove processed entries (O(remaining) via stream_pending_clear).
            stream_pending_clear(sp_n);
        }
        self._draining_streams = False;
    }

    # ── Stack-trace helpers ───────────────────────────────────────────────

    """
    Build the `    at FuncName (file:line)` lines for a TypeError "not a
    function" throw.  `fn` / `ins` describe the *current* frame; parent
    frames are read from `self.frames`.

    Returns a multi-line string that starts with `\n` (so it can be
    appended directly to the error header: `"TypeError: foo\n    at ..."`).
    """
    def _frames_to_stack_str(fn: CompiledFunction, ins: Instruction) -> str {
        st: str = "";
        # -- innermost (current) frame --
        cf_name: str = fn.name;
        if cf_name == "" or cf_name == "<main>" {
            cf_name = "Object.<anonymous>";
        }
        if fn.file != "" and ins.line != 0 {
            st = st
                + "\n    at "
                + cf_name
                + " ("
                + fn.file
                + ":"
                + str(ins.line)
                + ")";
        } elif ins.line != 0 {
            st = st + "\n    at " + cf_name + " (line " + str(ins.line) + ")";
        } else {
            st = st + "\n    at " + cf_name;
        }
        # -- parent frames (second-to-last → first) --
        n_frames: int = len(self.frames);
        fi: int = n_frames - 2;
        while fi >= 0 {
            pf: CallFrame = self.frames[fi];
            pf_name: str = pf.func.name;
            if pf_name == "" or pf_name == "<main>" {
                pf_name = "Object.<anonymous>";
            }
            pf_line: int = 0;
            if pf.ip > 0 and pf.ip - 1 < len(pf.func.code) {
                pf_ins: Instruction = pf.func.code[pf.ip - 1];
                pf_line = pf_ins.line;
            }
            if pf.func.file != "" and pf_line != 0 {
                st = st
                    + "\n    at "
                    + pf_name
                    + " ("
                    + pf.func.file
                    + ":"
                    + str(pf_line)
                    + ")";
            } elif pf_line != 0 {
                st = st + "\n    at " + pf_name + " (line " + str(pf_line) + ")";
            } else {
                st = st + "\n    at " + pf_name;
            }
            fi = fi - 1;
        }
        return st;
    }

    """
    Attach Node.js-style `    at funcName (file:line)` frames to `exc` if it
    is an Error object whose stack property is still a bare single-line header
    (set by create_error as just "ErrorName: message", no newline).

    Safe to call multiple times — skips if frames are already present.
    Called automatically by _unwind_in_frame so every thrown value gets frames.
    """
    def _maybe_attach_frames(exc: JSValue, frame: CallFrame) -> int {
        if not jsv_is_object_cell(exc) {
            return 0;
        }
        stack_v: JSValue = js_object_get(exc, key_stack_internal());
        if not jsv_is_string_cell(stack_v) {
            return 0;
        }
        stack_s: str = str_from_id(jsv_to_table_id(stack_v));
        # A bare stack ("ErrorName: message") has no newline.
        # If frames are already attached, the string will contain "\n".
        if "\n" in stack_s {
            return 0;
        }
        # Derive the current instruction from the frame.
        # frame.ip was already incremented past the instruction that caused the
        # error, so frame.ip - 1 is the index of that instruction.
        cf: CompiledFunction = frame.func;
        cf_ip: int = frame.ip - 1;
        if cf_ip < 0 or cf_ip >= len(cf.code) {
            return 0;
        }
        cf_code: list[Instruction] = cf.code;
        cur_ins: Instruction = cf_code[cf_ip];
        frames_str: str = self._frames_to_stack_str(cf, cur_ins);
        return attach_stack(exc, stack_s + frames_str);
    }

    # ── B12: function-value own-property queries ───────────────────────────
    # name/length/prototype are intrinsics synthesized by _fn_prop (not real
    # fn_props entries), so hasOwnProperty / getOwnPropertyDescriptor /
    # getOwnPropertyNames on a function must consult them explicitly.

    """True if `key` is an own property of function value `fn_v`: an intrinsic
    (name/length/prototype) or a user-defined property in its fn_props store."""
    def _fn_has_own_key(fn_v: JSValue, key: int) -> bool {
        if is_native_val(fn_v) {
            # Native: name/length unless tombstoned; plus any props-store keys.
            np_store: JSValue = native_props_get(fn_v);
            if jsv_is_object_cell(np_store) and js_object_has_own(np_store, key) {
                return True;
            }
            if key == WK_NAME or key == WK_LENGTH {
                return not native_key_removed(fn_v, key);
            }
            return False;
        }
        if not is_fn_val(fn_v) {
            return False;
        }
        if key == WK_NAME or key == WK_LENGTH {
            fhk_idx2: int = get_fn_idx(fn_v);
            if fhk_idx2 >= 0 and fhk_idx2 < len(self.realm.closures) {
                fhk_cl: JSClosure = self.realm.closures[fhk_idx2];
                if key == WK_NAME and fhk_cl.name_removed {
                    return False;
                }
                if key == WK_LENGTH and fhk_cl.length_removed {
                    return False;
                }
            }
            return True;
        }
        if key == WK_PROTOTYPE {
            # `prototype` is an own property only for constructable functions —
            # arrows and concise methods have no `prototype` (their prototype_obj is
            # undefined). Gate on the actual value to match GET semantics.
            return not jsv_is_undefined(_fn_prop(fn_v, WK_PROTOTYPE));
        }
        if key == WK_JAC_MODULE {
            return False;
        }  # internal sentinel, not user-visible
        if key == WK_NOT_CTOR {
            return False;
        }  # internal sentinel, not user-visible
        fhk_idx: int = get_fn_idx(fn_v);
        if fhk_idx >= 0 and fhk_idx < len(self.realm.closures) {
            fhk_fp: JSValue = self.realm.closures[fhk_idx].fn_props;
            if jsv_is_object_cell(fhk_fp) {
                return js_object_has_own(fhk_fp, key);
            }
        }
        return False;
    }

    """Build the own-property descriptor object for a function-value key, or
    undefined if not an own property. Intrinsics use the spec attributes
    (name/length: {w:F,e:F,c:T}; prototype: {w:T,e:F,c:F})."""
    def _fn_own_descriptor(fn_v: JSValue, key_v: JSValue) -> JSValue {
        if not jsv_is_string_cell(key_v) and not jsv_is_symbol(key_v) {
            return js_undefined();
        }
        fod_key: int = jsval_to_prop_key(key_v);
        fod_is_native: bool = is_native_val(fn_v);
        if fod_is_native {
            # Props-store override (including restored name/length).
            fod_np: JSValue = native_props_get(fn_v);
            if jsv_is_object_cell(fod_np) and js_object_has_own(fod_np, fod_key) {
                return _vm_call_native_proxy_aware(
                    self,
                    self.realm,
                    NATIVE_KIND_OBJ_GETOWNPD,
                    js_undefined(),
                    [fod_np, key_v]
                );
            }
            if fod_key == WK_NAME or fod_key == WK_LENGTH {
                if native_key_removed(fn_v, fod_key) {
                    return js_undefined();
                }
                fod_val_n: JSValue = js_undefined();
                if fod_key == WK_NAME {
                    fod_val_n = jsv_from_string_id(str_intern(get_native_name(fn_v)));
                } else {
                    fod_val_n = js_int(get_native_arity(fn_v));
                }
                fod_dn: JSValue = js_object_create_null();
                js_object_set(fod_dn, str_intern("value"), fod_val_n);
                js_object_set(fod_dn, str_intern("writable"), js_boolean(False));
                js_object_set(fod_dn, str_intern("enumerable"), js_boolean(False));
                js_object_set(fod_dn, str_intern("configurable"), js_boolean(True));
                return fod_dn;
            }
            return js_undefined();
        }
        # Definitions made while sealing/freezing an intrinsic are materialized in
        # fn_props; once present they override the synthesized descriptor.
        fod_idx0: int = get_fn_idx(fn_v);
        if fod_idx0 >= 0 and fod_idx0 < len(self.realm.closures) {
            fod_fp0: JSValue = self.realm.closures[fod_idx0].fn_props;
            if jsv_is_object_cell(fod_fp0) and js_object_has_own(fod_fp0, fod_key) {
                return _vm_call_native_proxy_aware(
                    self,
                    self.realm,
                    NATIVE_KIND_OBJ_GETOWNPD,
                    js_undefined(),
                    [fod_fp0, key_v]
                );
            }
        }
        if fod_key == WK_NAME or fod_key == WK_LENGTH {
            fod_idx2: int = get_fn_idx(fn_v);
            if fod_idx2 >= 0 and fod_idx2 < len(self.realm.closures) {
                fod_cl: JSClosure = self.realm.closures[fod_idx2];
                if fod_key == WK_NAME and fod_cl.name_removed {
                    return js_undefined();
                }
                if fod_key == WK_LENGTH and fod_cl.length_removed {
                    return js_undefined();
                }
                fod_fp_od: JSValue = fod_cl.fn_props;
                if jsv_is_object_cell(fod_fp_od)
                    and js_object_has_own(fod_fp_od, fod_key) {
                    return _vm_call_native_proxy_aware(
                        self,
                        self.realm,
                        NATIVE_KIND_OBJ_GETOWNPD,
                        js_undefined(),
                        [fod_fp_od, key_v]
                    );
                }
            }
            fod_val: JSValue = _fn_prop(fn_v, fod_key);
            fod_d: JSValue = js_object_create_null();
            js_object_set(fod_d, str_intern("value"), fod_val);
            js_object_set(fod_d, str_intern("writable"), js_boolean(False));
            js_object_set(fod_d, str_intern("enumerable"), js_boolean(False));
            js_object_set(fod_d, str_intern("configurable"), js_boolean(True));
            return fod_d;
        }
        if fod_key == WK_PROTOTYPE {
            # Arrows / concise methods have no own prototype.
            if jsv_is_undefined(_fn_prop(fn_v, WK_PROTOTYPE)) {
                return js_undefined();
            }
            fod_d2: JSValue = js_object_create_null();
            js_object_set(fod_d2, str_intern("value"), _fn_prop(fn_v, fod_key));
            # ES §20.2.4.2 / §27.3.1: a (generator) function's `prototype` is
            # { writable:true, enumerable:false, configurable:false } by default;
            # Object.defineProperty may downgrade writable to false (tracked on the
            # closure). Class constructors (non-writable) are WK_IS_CLASS objects,
            # handled elsewhere.
            fod_pw: bool = True;
            fod_pw_idx: int = get_fn_idx(fn_v);
            if fod_pw_idx >= 0 and fod_pw_idx < len(self.realm.closures) {
                fod_pw = self.realm.closures[fod_pw_idx].prototype_writable;
            }
            js_object_set(fod_d2, str_intern("writable"), js_boolean(fod_pw));
            js_object_set(fod_d2, str_intern("enumerable"), js_boolean(False));
            js_object_set(fod_d2, str_intern("configurable"), js_boolean(False));
            return fod_d2;
        }
        # User-defined fn_props property.
        if fod_key == WK_NOT_CTOR {
            return js_undefined();
        }  # internal sentinel
        fod_idx: int = get_fn_idx(fn_v);
        if fod_idx >= 0 and fod_idx < len(self.realm.closures) {
            fod_fp: JSValue = self.realm.closures[fod_idx].fn_props;
            if jsv_is_object_cell(fod_fp) and js_object_has_own(fod_fp, fod_key) {
                return _vm_call_native_proxy_aware(
                    self,
                    self.realm,
                    NATIVE_KIND_OBJ_GETOWNPD,
                    js_undefined(),
                    [fod_fp, key_v]
                );
            }
        }
        return js_undefined();
    }

    """Own *enumerable* string keys of a function value, as a JS array.

    Object.keys / Reflect.ownKeys on a function returned an empty array: both
    route through js_Object_keys, which bails on anything that is not an object
    cell, and a function value is not one. `length`/`name`/`prototype` are
    non-enumerable intrinsics and are excluded, so only user-assigned
    properties (stored in fn_props / the native props store) are listed."""
    def _fn_own_enum_keys(fn_v: JSValue) -> JSValue {
        ekeys: list[JSValue] = [];
        if is_native_val(fn_v) {
            fek_np: JSValue = native_props_get(fn_v);
            if jsv_is_object_cell(fek_np) {
                for fek_n in js_object_all_keys(fek_np) {
                    if fek_n != WK_NAME
                        and fek_n != WK_LENGTH
                        and fek_n != WK_PROTOTYPE
                        and fek_n > 0 {
                        ekeys.append(jsv_from_string_id(fek_n));
                    }
                }
            }
            return js_array_create(ekeys);
        }
        fek_idx: int = get_fn_idx(fn_v);
        if fek_idx >= 0 and fek_idx < len(self.realm.closures) {
            fek_fp: JSValue = self.realm.closures[fek_idx].fn_props;
            if jsv_is_object_cell(fek_fp) and jsv_to_table_id(fek_fp) > 0 {
                for fek_k in js_object_all_keys(fek_fp) {
                    if fek_k != WK_NAME
                        and fek_k != WK_LENGTH
                        and fek_k != WK_PROTOTYPE
                        and fek_k != WK_JAC_MODULE
                        and fek_k != WK_NOT_CTOR
                        and fek_k != WK_CLASS_NAME
                        and fek_k != WK_CTOR
                        and fek_k != WK_IS_CLASS
                        and fek_k != WK_SUPER
                        and fek_k > 0 {
                        ekeys.append(jsv_from_string_id(fek_k));
                    }
                }
            }
        }
        return js_array_create(ekeys);
    }

    """getOwnPropertyNames for a function value: length, name, prototype, then
    user-defined fn_props string keys (as a JS array)."""
    def _fn_own_prop_names(fn_v: JSValue) -> JSValue {
        fnames: list[JSValue] = [];
        if is_native_val(fn_v) {
            # Native: length + name (unless tombstoned), then other props-store keys.
            # Restored name/length live in props with tombstone cleared, so the
            # intrinsic checks below still cover them.
            if not native_key_removed(fn_v, WK_LENGTH) {
                fnames.append(jsv_from_string_id(WK_LENGTH));
            }
            if not native_key_removed(fn_v, WK_NAME) {
                fnames.append(jsv_from_string_id(WK_NAME));
            }
            fop_np: JSValue = native_props_get(fn_v);
            if jsv_is_object_cell(fop_np) {
                for fk_n in js_object_all_keys(fop_np) {
                    if fk_n != WK_NAME and fk_n != WK_LENGTH and fk_n > 0 {
                        fnames.append(jsv_from_string_id(fk_n));
                    }
                }
            }
            return js_array_create(fnames);
        }
        fop_idx: int = get_fn_idx(fn_v);
        fop_len_removed: bool = False;
        fop_name_removed: bool = False;
        if fop_idx >= 0 and fop_idx < len(self.realm.closures) {
            fop_cl: JSClosure = self.realm.closures[fop_idx];
            fop_len_removed = fop_cl.length_removed;
            fop_name_removed = fop_cl.name_removed;
        }
        if not fop_len_removed {
            fnames.append(jsv_from_string_id(WK_LENGTH));
        }
        if not fop_name_removed {
            fnames.append(jsv_from_string_id(WK_NAME));
        }
        # Only constructable functions list `prototype` (arrows/methods don't).
        if not jsv_is_undefined(_fn_prop(fn_v, WK_PROTOTYPE)) {
            fnames.append(jsv_from_string_id(WK_PROTOTYPE));
        }
        if fop_idx >= 0 and fop_idx < len(self.realm.closures) {
            fop_fp: JSValue = self.realm.closures[fop_idx].fn_props;
            if jsv_is_object_cell(fop_fp) {
                for fk in js_object_all_keys(fop_fp) {
                    if fk != WK_NAME
                        and fk != WK_LENGTH
                        and fk != WK_PROTOTYPE
                        and fk != WK_JAC_MODULE
                        and fk != WK_NOT_CTOR {
                        # Only string keys (skip symbols / internal sentinels).
                        if fk > 0 and not _vm_fn_prop_key_hidden(fk) {
                            fnames.append(jsv_from_string_id(fk));
                        }
                    }
                }
            }
        }
        return js_array_create(fnames);
    }

    # ── Entry points ──────────────────────────────────────────────────────

    """
    Build the implicit `arguments` object for a function activation.

    Ordinary object (not an Array exotic — ES §10.4.4) with own indexed data
    properties, a writable non-enumerable `length`, and a non-enumerable own
    `callee`. Index writes must NOT auto-grow `length` (unlike Array exotic
    [[DefineOwnProperty]]). For a sloppy-mode function with a simple parameter
    list, indexed entries are *mapped* to the live parameter slots via
    js_object_set_mapped_args, sharing the frame's `locals` list.
    """
    def _build_arguments(
        args: list[JSValue],
        callee: JSValue,
        fn: CompiledFunction,
        locals: list[JSValue]
    ) -> JSValue {
        # The arguments object is an ORDINARY object (ES §10.4.4) — NOT an Array — with
        # [[Prototype]] = %Object.prototype%.  Build it as a plain object with indexed
        # data properties (writable/enumerable/configurable), a `length` data property
        # {w:T,e:F,c:T}, an own @@iterator (= Array.prototype.values, {w:T,e:F,c:T}),
        # and `callee` {w:T,e:F,c:T} (mapped) / a poison-pill accessor (unmapped/strict).
        ba_obj: JSValue = js_object_new_ordinary();
        # Hidden marker: an arguments exotic object iterates array-style and reports
        # [object Arguments].  js_object_set stores it above the string-key range so
        # it never enumerates.  Value carries strictness: js_true() for an *unmapped*
        # (strict / non-simple-params) arguments object, which gets %ThrowTypeError%
        # poison-pill `callee`/`caller` accessors (ES §10.4.4.7); js_false() otherwise.
        js_object_set(ba_obj, _KEY_IS_ARGUMENTS, js_boolean(fn.is_strict));
        # Also set the JSObject struct flag so js_object_is_arguments() (used by the
        # native dispatch path) agrees with the _KEY_IS_ARGUMENTS property mechanism.
        js_object_mark_arguments(ba_obj);
        ba_flags_idx: int = PROP_WRITABLE | PROP_ENUMERABLE | PROP_CONFIGURABLE;  # 7
        ba_flags_nonenum: int = PROP_WRITABLE | PROP_CONFIGURABLE;  # 5
        ba_n: int = len(args);
        ba_i: int = 0;
        while ba_i < ba_n {
            js_object_set_flags(
                ba_obj, str_intern_index(ba_i), args[ba_i], ba_flags_idx
            );
            ba_i = ba_i + 1;
        }
        js_object_set_flags(ba_obj, WK_LENGTH, js_int(ba_n), ba_flags_nonenum);
        if not jsv_is_undefined(callee) {
            # Sloppy: `callee` is the function (data, {w:T,e:F,c:T}).  Strict functions
            # get a %ThrowTypeError% poison-pill on both callee AND caller (handled in
            # GET/SET via is_strict), so only install the data `callee` when sloppy.
            if not fn.is_strict {
                js_object_set_flags(
                    ba_obj, str_intern("callee"), callee, ba_flags_nonenum
                );
            }
        }
        # `arguments` has its *own* @@iterator (= %Array.prototype.values%), a data
        # property {w:T,e:F,c:T} (ES §10.4.4).  Share the cached canonical native so
        # `arguments[@@iterator] === [][Symbol.iterator]` (SameValue identity).
        ba_iter_fn: JSValue = self.realm.array_values_fn;
        if jsv_is_undefined(ba_iter_fn)
            or (jsv_is_int32(ba_iter_fn) and jsv_to_int32(ba_iter_fn) == 0) {
            ba_iter_fn = js_native_singleton("values", 0, NATIVE_KIND_ARRAY_ITER);
        }
        js_object_set_flags(
            ba_obj, SYMBOL_KEY_BASE + SYMBOL_ITERATOR, ba_iter_fn, ba_flags_nonenum
        );
        # Mapped arguments (ES §10.4.4): for a *sloppy*-mode function with a *simple*
        # parameter list (no defaults / rest / destructuring) and no duplicate param
        # names, indexed entries alias the live parameter slots. Build the index→slot
        # map and share the frame's `locals` list so writes alias both ways.
        # (Simple-param + dup-name checks inlined; a separate helper method here
        # miscompiled under Jac native.)
        ba_simple: bool = fn.expected_arg_count == len(fn.params);
        if ba_simple {
            for pn_s in fn.params {
                if len(pn_s) >= 4
                    and pn_s[0] == "_"
                    and pn_s[1] == "_"
                    and pn_s[2] == "d"
                    and pn_s[3] == "p" {
                    ba_simple = False;
                }
            }
        }
        ba_can_map: bool = (not fn.is_strict) and (not fn.has_rest) and ba_simple;
        if ba_can_map {
            ba_nseen: dict[str, bool] = {};
            ba_has_dup: bool = False;
            for pn in fn.params {
                if pn in ba_nseen {
                    ba_has_dup = True;
                }
                ba_nseen[pn] = True;
            }
            if not ba_has_dup {
                ba_slot_map: dict[int, int] = {};
                ba_np: int = len(fn.params);
                ba_pi: int = 0;
                while ba_pi < ba_np and ba_pi < len(args) {
                    ba_key: int = str_intern_index(ba_pi);
                    ba_slot_map[ba_key] = fn.param_base + ba_pi;
                    ba_pi = ba_pi + 1;
                }
                if len(ba_slot_map) > 0 {
                    js_object_set_mapped_args(ba_obj, locals, ba_slot_map);
                }
            }
        }
        return ba_obj;
    }

    """
    Eagerly run a generator's parameter-binding prologue ([0, end_ip)) so that an
    abrupt completion in a default value or destructured parameter is raised at
    generator-creation time (B5 / FunctionDeclarationInstantiation), rather than
    being deferred to the first .next(). Mutates `locals` in place with the bound
    parameter values. Returns True on normal completion; on an abrupt completion
    leaves self.had_exception/self.pending_exc set and returns False.
    """
    def _run_gen_prologue(
        fn: CompiledFunction,
        locals: list[JSValue],
        free_vals: list[JSValue],
        this_val: JSValue,
        callee: JSValue,
        end_ip: int
    ) -> bool {
        gp_sbase: int = len(self.stack);
        gp_frame: CallFrame = CallFrame(
            func=fn,
            ip=0,
            stack_base=gp_sbase,
            locals=locals,
            catch_stack=[],
            free_vals=free_vals,
            this_val=this_val,
            self_fn=callee,
            with_objs=[],
            native_roots=[]
        );
        self.frames.append(gp_frame);
        # Stack execution of a (possibly register-ISA) function: its catch
        # stack, not the handler table, serves any throw in here.
        gp_frame.rpc = -1;
        # Default/destructured parameters run in the generator function's own
        # compilation unit (see run_generator), not the caller's.
        gp_saved_mf: list[CompiledFunction] = self.module_fns;
        if is_fn_val(callee) {
            gp_cl: JSClosure = self.realm.closures[get_fn_idx(callee)];
            if len(gp_cl.module_fns) > 0 {
                self.module_fns = gp_cl.module_fns;
            }
        }
        gp_st: ExecState = ExecState();
        gp_st.running = True;
        gp_st.ret = js_undefined();
        gp_code: list[Instruction] = fn.code;
        gp_n: int = len(gp_code);
        while gp_st.running and gp_frame.ip < end_ip and gp_frame.ip < gp_n {
            gp_ins: Instruction = gp_code[gp_frame.ip];
            gp_frame.ip = gp_frame.ip + 1;
            gp_op: Opcode = gp_ins.opcode;
            gp_dop: int = int(gp_op);
            if gp_dop >= 0 and gp_dop < _OPCODE_TABLE_D_N {
                gp_h: Callable[[VM, CallFrame, Instruction, ExecState], None] = _OPCODE_TABLE_D[
                    gp_dop
                ];
                gp_h(self, gp_frame, gp_ins, gp_st);
            }
            if self.had_exception {
                gp_st.running = False;
            }
        }
        self.module_fns = gp_saved_mf;
        self.reg_unwound = False;
        # Clean up any operand-stack residue from the prologue frame.
        while len(self.stack) > gp_sbase {
            del self.stack[len(self.stack) - 1];
        }
        gp_nf: int = len(self.frames);
        del self.frames[gp_nf - 1];
        if self.had_exception {
            return False;
        }
        return True;
    }

    """The tail callee's frame for run()'s trampoline: _build_plain_frame's
    setup on a pooled frame and its (resized) locals list when the pool has
    one, so a tail call allocates nothing."""
    def _build_tail_frame(
        fn: CompiledFunction,
        this_val: JSValue,
        args: list[JSValue],
        free_vals: list[JSValue],
        closure_val: JSValue
    ) -> CallFrame {
        if len(self.frame_pool) == 0 {
            return self._build_plain_frame(fn, this_val, args, free_vals, closure_val);
        }
        btf_locals: list[JSValue] = self._inline_locals(fn);
        btf_a: int = 0;
        while btf_a < len(fn.params) and btf_a < len(args) {
            btf_locals[fn.param_base + btf_a] = args[btf_a];
            btf_a = btf_a + 1;
        }
        if fn.has_rest and len(fn.params) > 0 {
            btf_items: list[JSValue] = [];
            btf_ri: int = len(fn.params) - 1;
            while btf_ri < len(args) {
                btf_items.append(args[btf_ri]);
                btf_ri = btf_ri + 1;
            }
            btf_locals[fn.param_base + len(fn.params) - 1] = js_array_create(btf_items);
        }
        if fn.arguments_slot >= 0 {
            btf_locals[fn.arguments_slot] = self._build_arguments(
                args, closure_val, fn, btf_locals
            );
        }
        btf_frame: CallFrame = self._frame_acquire(
            fn,
            len(self.stack),
            btf_locals,
            free_vals,
            this_val,
            closure_val,
            js_undefined(),
            False,
            0,
            True
        );
        if is_fn_val(closure_val) {
            btf_idx: int = get_fn_idx(closure_val);
            if btf_idx >= 0
                and btf_idx < len(self.realm.closures)
                and len(self.realm.closures[btf_idx].captured_with_objs) > 0 {
                btf_wseed: list[JSValue] = [];
                for btf_wo in self.realm.closures[btf_idx].captured_with_objs {
                    btf_wseed.append(btf_wo);
                }
                btf_frame.with_objs = btf_wseed;
                btf_frame.rare = True;
                btf_frame.with_inherited = len(btf_wseed);
            }
        }
        return btf_frame;
    }

    """Build a fresh CallFrame for a PLAIN function call (no construct semantics) — used by
    the tail-call trampoline in run(). Allocates locals, binds params/rest/arguments, seeds
    captured with-objects. new.target/ctor_class/this-uninit are undefined (a tail call is
    never a constructor call, ES §15.10.3). stack_base = current operand-stack length."""
    def _build_plain_frame(
        fn: CompiledFunction,
        this_val: JSValue,
        args: list[JSValue],
        free_vals: list[JSValue],
        closure_val: JSValue
    ) -> CallFrame {
        bpf_locals: list[JSValue] = [];
        bpf_i: int = 0;
        while bpf_i < fn.num_locals {
            bpf_locals.append(js_undefined());
            bpf_i = bpf_i + 1;
        }
        bpf_a: int = 0;
        while bpf_a < len(fn.params) and bpf_a < len(args) {
            bpf_tmp: JSValue = args[bpf_a];
            bpf_locals[fn.param_base + bpf_a] = bpf_tmp;
            bpf_a = bpf_a + 1;
        }
        if fn.has_rest and len(fn.params) > 0 {
            bpf_rest_slot: int = fn.param_base + len(fn.params) - 1;
            bpf_rest_items: list[JSValue] = [];
            bpf_ri: int = len(fn.params) - 1;
            while bpf_ri < len(args) {
                bpf_rest_items.append(args[bpf_ri]);
                bpf_ri = bpf_ri + 1;
            }
            bpf_locals[bpf_rest_slot] = js_array_create(bpf_rest_items);
        }
        if fn.arguments_slot >= 0 {
            bpf_locals[fn.arguments_slot] = self._build_arguments(
                args, closure_val, fn, bpf_locals
            );
        }
        bpf_sbase: int = len(self.stack);
        bpf_frame: CallFrame = CallFrame(
            func=fn,
            ip=0,
            stack_base=bpf_sbase,
            locals=bpf_locals,
            catch_stack=[],
            free_vals=free_vals,
            this_val=this_val,
            self_fn=closure_val,
            with_objs=[],
            new_target=js_undefined(),
            native_roots=[]
        );
        if is_fn_val(closure_val) {
            bpf_idx: int = get_fn_idx(closure_val);
            if bpf_idx >= 0 and bpf_idx < len(self.realm.closures) {
                bpf_cw: list[JSValue] = self.realm.closures[bpf_idx].captured_with_objs;
                if len(bpf_cw) > 0 {
                    bpf_wseed: list[JSValue] = [];
                    for bpf_wo in bpf_cw {
                        bpf_wseed.append(bpf_wo);
                    }
                    bpf_frame.with_objs = bpf_wseed;
                    bpf_frame.rare = True;
                    bpf_frame.with_inherited = len(bpf_wseed);
                }
            }
        }
        return bpf_frame;
    }

    """
    Execute `fn` as a new call frame with the given `this`, `args`, and
    captured `free_vals`.  Returns the function's return value.

    If an exception propagates out: sets had_exception=True and pending_exc;
    callers must check self.had_exception after every recursive run() call.
    """
    # Try to run a plain sync closure call in the SAME _exec loop
    # (call_path Phase 3) instead of natively recursing run_cl->run->_exec.
    # Returns True when the callee frame was entered inline. Eligibility is
    # deliberately narrow - anything with per-call VM bookkeeping (arrows'
    # lexical channels, module contexts, with-captures, arguments objects,
    # generators/async/bound, sloppy primitive-this boxing) falls back.
    # _inline_this returns the `this` such a call runs with, or jsv_hole() when
    # it must take run_cl; _inline_call (arguments in a list) and
    # _inline_call_from_stack (arguments on the operand stack) share it.
    def _inline_this(
        cl: JSClosure, cl_val: JSValue, this_val: JSValue, st: ExecState
    ) -> JSValue {
        if _INLINE_CALLS_ON == 0 {
            return jsv_hole();
        }
        if not st.allow_inline {
            return jsv_hole();
        }
        # cl.func is read through the closure each time rather than bound to
        # a local: a CompiledFunction local costs a retain/release pair per
        # call (this runs once per JS call).
        if cl.func.is_generator or cl.func.is_async or cl.func.is_bound {
            _inline_rej(1);
            return jsv_hole();
        }
        # A register-ISA callee runs in VM._exec_reg (_reg_call_from_stack or
        # run_cl), never inside the stack loop.
        if self._reg_ready(cl.func) {
            _inline_rej(11);
            return jsv_hole();
        }
        # A fn containing TAIL_CALL inlines too: its tail calls replace its
        # inline frame (_op_tail_call), so proper-tail-call depth stays O(1)
        # as run()'s trampoline keeps it for a base frame.
        if cl.func.arguments_slot >= 0 {
            _inline_rej(2);
            return jsv_hole();
        }
        # Arrows inline too (they were 1.6M of jac_client's 2.9M slow-path
        # calls): `this` comes from lexical_this below and new.target from
        # lexical_new_target in _inline_enter, as run_cl / run() do.
        # module_fns handled by per-frame save/restore (no rejection).
        if len(cl.captured_with_objs) > 0 {
            _inline_rej(6);
            return jsv_hole();
        }
        if cl.this_binding_cell != 0 {
            _inline_rej(7);
            return jsv_hole();
        }
        if self.call_depth + 1 > VM_MAX_CALL_DEPTH {
            _inline_rej(8);
            return jsv_hole();
        }
        ic_this: JSValue = this_val;
        if not jsv_is_undefined(cl.lexical_this) {
            # Captured at MAKE_ARROW; takes precedence over the caller's this (run_cl).
            ic_this = cl.lexical_this;
        } elif not cl.func.is_strict {
            if jsv_is_null(ic_this) or jsv_is_undefined(ic_this) {
                ic_this = self._sloppy_this_for(cl.func);
            } elif not jsv_is_any_object(ic_this) {
                _inline_rej(9);
                return jsv_hole();
            }
        }
        # cl IS realm.closures[get_fn_idx(cl_val)], so its jac_module field is
        # what _fn_jac_module(cl_val, realm) would look up.
        if jsv_is_object_cell(cl.jac_module) {
            # Same-module fast path: when the callee's CJS module context is
            # already the active one, run_cl's module/exports globals swap
            # would be a no-op — inline without it. Cross-module calls fall
            # back to run_cl (which swaps and restores). JSValue == is an
            # int64 bit compare = object identity.
            icm_cur: JSValue = self.globals.get("module", js_undefined());
            if not (cl.jac_module == icm_cur) {
                _inline_rej(10);
                return jsv_hole();
            }
        }
        return ic_this;
    }

    """The number of registers of `frame`: its function's for a window
    frame, its list's length for a list frame (0 once detached)."""
    def _frame_nl(frame: CallFrame) -> int {
        if frame.win {
            return frame.func.num_locals;
        }
        return len(frame.locals);
    }

    """Push a register window of `nl` undefined slots on the register file;
    returns its base."""
    def _win_alloc(nl: int, nfill: int) -> int {
        wa_base: int = self.rtop;
        wa_end: int = wa_base + nl;
        while len(self.regs) < wa_end {
            self.regs.append(js_undefined());
        }
        # Only the function's own locals start as undefined; the translator's
        # temporaries are written before they are read.
        wa_k: int = wa_base;
        wa_fe: int = wa_base + nfill;
        while wa_k < wa_fe {
            self.regs[wa_k] = js_undefined();
            wa_k = wa_k + 1;
        }
        self.rtop = wa_end;
        return wa_base;
    }

    """A locals list for an inline frame of `fn`, all undefined: the pooled
    frame's list resized in place when the pool has one, else a fresh list."""
    def _inline_locals(fn: CompiledFunction) -> list[JSValue] {
        # No `= []` up front: that allocated a list on every call only to drop
        # it again when the pooled frame's list was taken.
        if len(self.frame_pool) > 0 {
            if self.frame_pool[len(self.frame_pool) - 1].win {
                # A pooled window frame: its "list" is the register file.
                self.frame_pool[len(self.frame_pool) - 1].locals = [];
                self.frame_pool[len(self.frame_pool) - 1].win = False;
                self.frame_pool[len(self.frame_pool) - 1].lb = 0;
            }
            ic_locals: list[JSValue] = self.frame_pool[len(self.frame_pool) - 1].locals;
            while len(ic_locals) > fn.num_locals {
                del ic_locals[len(ic_locals) - 1];
            }
            ic_i: int = 0;
            ic_cur: int = len(ic_locals);
            while ic_i < ic_cur {
                ic_locals[ic_i] = js_undefined();
                ic_i = ic_i + 1;
            }
            while len(ic_locals) < fn.num_locals {
                ic_locals.append(js_undefined());
            }
            return ic_locals;
        }
        ic_fresh: list[JSValue] = [];
        ic_j: int = 0;
        while ic_j < fn.num_locals {
            ic_fresh.append(js_undefined());
            ic_j = ic_j + 1;
        }
        return ic_fresh;
    }

    """A new locals list for a frame of `fn`, all undefined."""
    def _fresh_locals(fn: CompiledFunction) -> list[JSValue] {
        fl: list[JSValue] = [];
        fl_i: int = 0;
        while fl_i < fn.num_locals {
            fl.append(js_undefined());
            fl_i = fl_i + 1;
        }
        return fl;
    }

    """Push the inline frame for `cl` (arguments already in `ic_locals`), consuming
    the construct channels exactly as run() would."""
    def _inline_enter(
        cl: JSClosure,
        cl_val: JSValue,
        ic_this: JSValue,
        ic_locals: list[JSValue],
        st: ExecState
    ) {
        ic_nt: JSValue = self._pending_new_target;
        if jsv_is_undefined(ic_nt) {
            ic_nt = self.pending_new_target;
        }
        # new.target is lexical for an arrow: the value captured at its
        # definition, not the caller's (same rule as run()).
        if cl.is_arrow {
            ic_nt = cl.lexical_new_target;
        }
        self._pending_new_target = js_undefined();
        self.pending_new_target = js_undefined();
        ic_tui: bool = self._pending_this_uninit;
        self._pending_this_uninit = False;
        ic_ctc: JSValue = self._pending_ctor_class;
        self._pending_ctor_class = 0;
        ic_reuse: bool = len(self.frame_pool) > 0;
        ic_sbase: int = len(self.stack);
        ic_frame: CallFrame = self._frame_acquire(
            cl.func,
            ic_sbase,
            ic_locals,
            cl.free_vals,
            ic_this,
            cl_val,
            ic_nt,
            ic_tui,
            ic_ctc,
            ic_reuse
        );
        ic_frame.caller_module_fns = self.module_fns;
        if len(cl.module_fns) > 0 {
            self.module_fns = cl.module_fns;
        }
        self.frames.append(ic_frame);
        self.call_depth = self.call_depth + 1;
        st.inline_depth = st.inline_depth + 1;
        st.frame_switched = True;
        if _PAIR_STATS_ON {
            _inline_count_bump();
        }
    }

    def _inline_call(
        cl: JSClosure,
        cl_val: JSValue,
        this_val: JSValue,
        args: list[JSValue],
        st: ExecState
    ) -> bool {
        ic_this: JSValue = self._inline_this(cl, cl_val, this_val, st);
        if jsv_is_hole(ic_this) {
            return False;
        }
        fn: CompiledFunction = cl.func;
        ic_locals: list[JSValue] = self._inline_locals(fn);
        ic_a: int = 0;
        while ic_a < len(fn.params) and ic_a < len(args) {
            ic_tmp: JSValue = args[ic_a];
            ic_locals[fn.param_base + ic_a] = ic_tmp;
            ic_a = ic_a + 1;
        }
        if fn.has_rest and len(fn.params) > 0 {
            ic_rs: int = fn.param_base + len(fn.params) - 1;
            ic_items: list[JSValue] = [];
            ic_ri: int = len(fn.params) - 1;
            while ic_ri < len(args) {
                ic_items.append(args[ic_ri]);
                ic_ri = ic_ri + 1;
            }
            ic_locals[ic_rs] = js_array_create(ic_items);
        }
        self._inline_enter(cl, cl_val, ic_this, ic_locals, st);
        return True;
    }

    """CALL_METHOD fast path for a whitelisted builtin (see _NATIVE_FAST_KIND):
    method at stack[msl], receiver above it, then `nargs` arguments. Runs it
    through the same _vm_call_native_proxy_aware / _check_native_exc pair as the
    general path, minus the argument-list allocation, rooting and special-kind
    scan. Returns False with the stack untouched when the call does not qualify."""
    def _native_fast_call(
        frame: CallFrame, msl: int, nargs: int, st: ExecState
    ) -> bool {
        nf_kind: int = get_native_kind(self.stack[msl]);
        if nf_kind < 0 or nf_kind >= len(_NATIVE_FAST_KIND) {
            return False;
        }
        nf_mode: int = _NATIVE_FAST_KIND[nf_kind];
        # modes 6 / 7 (re-entrant / generic natives) are register-loop only:
        # this path shares _NF_ARGS and skips the stream drain.
        if nf_mode == 0 or nf_mode >= 6 {
            return False;
        }
        nf_this: JSValue = self.stack[msl + 1];
        if nf_mode == 1 and not jsv_is_string_cell(nf_this) {
            return False;
        }
        if nf_mode == 5 and nargs > 1 {
            return False;
        }
        if nf_mode == 4
            and not (
                js_is_array(nf_this)
                and js_object_class_id_id(jsv_to_table_id(nf_this)) == 0
                and idx_protector_ok()
            ) {
            return False;
        }
        nf_ab: int = msl + 2;
        nf_k: int = 0;
        if nf_mode <= 2 {
            while nf_k < nargs {
                if not _vm_simple_prim(self.stack[nf_ab + nf_k]) {
                    return False;
                }
                nf_k = nf_k + 1;
            }
        }
        while len(_NF_ARGS) > 0 {
            _NF_ARGS.pop();
        }
        nf_k = 0;
        while nf_k < nargs {
            _NF_ARGS.append(self.stack[nf_ab + nf_k]);
            nf_k = nf_k + 1;
        }
        nf_res: JSValue = _vm_call_native_proxy_aware(
            self, self.realm, nf_kind, nf_this, _NF_ARGS
        );
        while len(self.stack) > msl {
            self.stack.pop();
        }
        if not self._check_native_exc(frame, nf_res) {
            st.running = False;
        }
        return True;
    }

    """CALL / CALL_METHOD fast path: an inline call whose `nargs` arguments are
    still on the operand stack, above `below` more slots (the callee for CALL;
    the method and its receiver for CALL_METHOD). The arguments go straight into
    the callee's locals, so no argument list is allocated; on success all of
    those slots are popped. Returns False with the stack untouched when the call
    cannot run inline.

    `cl` is passed as the borrowed realm.closures element (no refcount), and
    the frame is set up here in place rather than through _inline_locals /
    _inline_enter / _frame_acquire: with a pooled frame (the common case) the
    only refcount traffic left is moving the frame from the pool to the frame
    stack, plus the pointer fields that really change. Each retain/release
    pair costs ~30 instructions, and the split path paid ~20 of them per call.
    The frame ends up exactly as _inline_enter + _frame_acquire leave it."""
    def _inline_call_from_stack(
        cl: JSClosure,
        cl_val: JSValue,
        this_val: JSValue,
        nargs: int,
        below: int,
        st: ExecState
    ) -> bool {
        if cl.napi_cb_ptr != 0 {
            return False;
        }
        ic_this: JSValue = self._inline_this(cl, cl_val, this_val, st);
        if jsv_is_hole(ic_this) {
            return False;
        }
        ab: int = len(self.stack) - nargs;
        np: int = len(cl.func.params);
        pb: int = cl.func.param_base;
        if len(self.frame_pool) == 0 {
            # Cold: no pooled frame — the general helpers allocate one.
            ic_locals: list[JSValue] = self._fresh_locals(cl.func);
            ic_a: int = 0;
            while ic_a < np and ic_a < nargs {
                ic_locals[pb + ic_a] = self.stack[ab + ic_a];
                ic_a = ic_a + 1;
            }
            if cl.func.has_rest and np > 0 {
                ic_items: list[JSValue] = [];
                ic_ri: int = np - 1;
                while ic_ri < nargs {
                    ic_items.append(self.stack[ab + ic_ri]);
                    ic_ri = ic_ri + 1;
                }
                ic_locals[pb + np - 1] = js_array_create(ic_items);
            }
            while len(self.stack) > ab - below {
                self.stack.pop();
            }
            self._inline_enter(cl, cl_val, ic_this, ic_locals, st);
            return True;
        }
        # Move the top pooled frame onto the frame stack.
        fr: CallFrame = self.frame_pool[len(self.frame_pool) - 1];
        del self.frame_pool[len(self.frame_pool) - 1];
        self.frames.append(fr);
        if fr.win {
            fr.locals = [];
            fr.win = False;
            fr.lb = 0;
        }
        # Its locals list is reused, resized in place, all undefined
        # (as _inline_locals does).
        nl: int = cl.func.num_locals;
        while len(fr.locals) > nl {
            fr.locals.pop();
        }
        li: int = 0;
        lc: int = len(fr.locals);
        while li < lc {
            fr.locals[fr.lb + (li)] = js_undefined();
            li = li + 1;
        }
        while lc < nl {
            fr.locals.append(js_undefined());
            lc = lc + 1;
        }
        ia: int = 0;
        while ia < np and ia < nargs {
            fr.locals[fr.lb + (pb + ia)] = self.stack[ab + ia];
            ia = ia + 1;
        }
        if cl.func.has_rest and np > 0 {
            rs_items: list[JSValue] = [];
            rs_i: int = np - 1;
            while rs_i < nargs {
                rs_items.append(self.stack[ab + rs_i]);
                rs_i = rs_i + 1;
            }
            fr.locals[fr.lb + (pb + np - 1)] = js_array_create(rs_items);
        }
        # Drop the arguments and the `below` slots under them.
        while len(self.stack) > ab - below {
            self.stack.pop();
        }
        # Pointer fields are written only when they change: a loop calling
        # the same function gets the same pooled frame back every time.
        if fr.func is not cl.func {
            fr.func = cl.func;
        }
        if fr.free_vals is not cl.free_vals {
            fr.free_vals = cl.free_vals;
        }
        fr.ip = 0;
        fr.stack_base = len(self.stack);
        fr.this_val = ic_this;
        fr.self_fn = cl_val;
        # Construct channels, consumed exactly as _inline_enter does; an
        # arrow's new.target is the one captured at its definition.
        ic_nt: JSValue = self._pending_new_target;
        if jsv_is_undefined(ic_nt) {
            ic_nt = self.pending_new_target;
        }
        if cl.is_arrow {
            ic_nt = cl.lexical_new_target;
        }
        self._pending_new_target = js_undefined();
        self.pending_new_target = js_undefined();
        fr.new_target = ic_nt;
        fr.this_uninitialized = self._pending_this_uninit;
        self._pending_this_uninit = False;
        fr.ctor_class = self._pending_ctor_class;
        self._pending_ctor_class = 0;
        fr.with_inherited = 0;
        fr.this_binding_cell = 0;
        fr.discard_ret = False;
        fr.ctor_this = 0;
        while len(fr.catch_stack) > 0 {
            fr.catch_stack.pop();
        }
        while len(fr.with_objs) > 0 {
            fr.with_objs.pop();
        }
        while len(fr.catch_with_depths) > 0 {
            fr.catch_with_depths.pop();
        }
        while len(fr.dispose_stack) > 0 {
            fr.dispose_stack.pop();
        }
        while len(fr.dispose_async) > 0 {
            fr.dispose_async.pop();
        }
        while len(fr.dispose_methods) > 0 {
            fr.dispose_methods.pop();
        }
        while len(fr.dispose_marks) > 0 {
            fr.dispose_marks.pop();
        }
        while len(fr.catch_dispose_depths) > 0 {
            fr.catch_dispose_depths.pop();
        }
        while len(fr.dyn_var_names) > 0 {
            del fr.dyn_var_names[len(fr.dyn_var_names) - 1];
        }
        while len(fr.dyn_var_vals) > 0 {
            fr.dyn_var_vals.pop();
        }
        while len(fr.native_roots) > 0 {
            fr.native_roots.pop();
        }
        if fr.caller_module_fns is not self.module_fns {
            fr.caller_module_fns = self.module_fns;
        }
        if len(cl.module_fns) > 0 and self.module_fns is not cl.module_fns {
            self.module_fns = cl.module_fns;
        }
        self.call_depth = self.call_depth + 1;
        st.inline_depth = st.inline_depth + 1;
        st.frame_switched = True;
        if _PAIR_STATS_ON {
            _inline_count_bump();
        }
        return True;
    }

    def _frame_acquire(
        fn: CompiledFunction,
        sbase: int,
        locals: list[JSValue],
        free_vals: list[JSValue],
        this_val: JSValue,
        closure_val: JSValue,
        ntv: JSValue,
        tui: bool,
        ctc: JSValue,
        reuse: bool
    ) -> CallFrame {
        if reuse and len(self.frame_pool) > 0 {
            fa_fr: CallFrame = self.frame_pool[len(self.frame_pool) - 1];
            del self.frame_pool[len(self.frame_pool) - 1];
            fa_fr.func = fn;
            fa_fr.ip = 0;
            fa_fr.rpc = 0;
            fa_fr.stack_base = sbase;
            fa_fr.locals = locals;
            fa_fr.win = False;
            fa_fr.lb = 0;
            fa_fr.free_vals = free_vals;
            fa_fr.this_val = this_val;
            fa_fr.self_fn = closure_val;
            fa_fr.new_target = ntv;
            fa_fr.this_uninitialized = tui;
            fa_fr.ctor_class = ctc;
            fa_fr.with_inherited = 0;
            fa_fr.this_binding_cell = 0;
            fa_fr.discard_ret = False;
            fa_fr.ctor_this = 0;
            # The rare-state lists can only be non-empty when `rare` was set
            # (every appending site sets it — V3.3).
            if fa_fr.rare {
                while len(fa_fr.catch_stack) > 0 {
                    del fa_fr.catch_stack[len(fa_fr.catch_stack) - 1];
                }
                while len(fa_fr.with_objs) > 0 {
                    del fa_fr.with_objs[len(fa_fr.with_objs) - 1];
                }
                while len(fa_fr.catch_with_depths) > 0 {
                    del fa_fr.catch_with_depths[len(fa_fr.catch_with_depths) - 1];
                }
                while len(fa_fr.dispose_stack) > 0 {
                    del fa_fr.dispose_stack[len(fa_fr.dispose_stack) - 1];
                }
                while len(fa_fr.dispose_async) > 0 {
                    del fa_fr.dispose_async[len(fa_fr.dispose_async) - 1];
                }
                while len(fa_fr.dispose_methods) > 0 {
                    del fa_fr.dispose_methods[len(fa_fr.dispose_methods) - 1];
                }
                while len(fa_fr.dispose_marks) > 0 {
                    del fa_fr.dispose_marks[len(fa_fr.dispose_marks) - 1];
                }
                while len(fa_fr.catch_dispose_depths) > 0 {
                    del fa_fr.catch_dispose_depths[len(fa_fr.catch_dispose_depths) - 1];
                }
                while len(fa_fr.dyn_var_names) > 0 {
                    del fa_fr.dyn_var_names[len(fa_fr.dyn_var_names) - 1];
                }
                while len(fa_fr.dyn_var_vals) > 0 {
                    del fa_fr.dyn_var_vals[len(fa_fr.dyn_var_vals) - 1];
                }
                while len(fa_fr.native_roots) > 0 {
                    del fa_fr.native_roots[len(fa_fr.native_roots) - 1];
                }
                fa_fr.rare = False;
            }
            fa_fr.mod_swapped = False;
            fa_fr.post_fields = 0;
            return fa_fr;
        }
        fa_new: CallFrame = CallFrame(
            func=fn,
            ip=0,
            stack_base=sbase,
            locals=locals,
            catch_stack=[],
            free_vals=free_vals,
            this_val=this_val,
            self_fn=closure_val,
            with_objs=[],
            new_target=ntv,
            native_roots=[]
        );
        fa_new.this_uninitialized = tui;
        fa_new.ctor_class = ctc;
        return fa_new;
    }

    def run(
        fn: CompiledFunction,
        this_val: JSValue,
        args: list[JSValue],
        free_vals: list[JSValue],
        closure_val: JSValue
    ) -> JSValue {
        self.call_depth = self.call_depth + 1;
        if self.call_depth > VM_MAX_CALL_DEPTH {
            self.call_depth = self.call_depth - 1;
            self.pending_exc = make_range_error("Maximum call stack size exceeded");
            self.had_exception = True;
            return js_undefined();
        }
        if VM_DEBUG_MODE {
            self.vm_debug(
                "→ run  fn="
                    + fn.name
                    + "  depth="
                    + str(self.call_depth)
                    + "  nparams="
                    + str(len(fn.params))
                    + "  nargs="
                    + str(len(args))
                    + "  param_base="
                    + str(fn.param_base)
            );
        }

        # Allocate local slots (all undefined). Frame pooling (call_path
        # Phase 2): eligible calls reuse the pooled frame's locals list —
        # resized in place — instead of allocating a fresh one per call.
        # A pooled frame serves any non-generator, non-async call; its locals
        # list only when no arguments object can alias the locals.
        rp_reuse: bool = (not fn.is_generator)
            and (not fn.is_async)
            and len(self.frame_pool) > 0;
        # (_inline_locals takes the pooled list; no throwaway `[]` first.)
        locals: list[JSValue] = self._inline_locals(fn)
            if rp_reuse and fn.arguments_slot < 0
            else self._fresh_locals(fn);

        # Bind arguments to parameter slots (params start at fn.param_base,
        # which is 1 for named functions that reserve slot 0 for self-ref)
        a: int = 0;
        while a < len(fn.params) and a < len(args) {
            # TODO: remove typed-local workaround once cross-module-list-subscript-multilevel-field-access is fixed.
            # Typed local forces correct i8* → %"JSValue"* bitcast for cross-module lists.
            tmp_arg: JSValue = args[a];
            locals[fn.param_base + a] = tmp_arg;
            if VM_DEBUG_MODE {
                self.vm_debug(
                    "   bind arg["
                        + str(a)
                        + "]="
                        + jsval_dbg(tmp_arg)
                        + " \u2192 local["
                        + str(fn.param_base + a)
                        + "]"
                );
            }
            a = a + 1;
        }

        if fn.has_rest and len(fn.params) > 0 {
            rest_slot: int = fn.param_base + len(fn.params) - 1;
            rest_start: int = len(fn.params) - 1;
            rest_items: list[JSValue] = [];
            ri: int = rest_start;
            while ri < len(args) {
                rest_items.append(args[ri]);
                ri = ri + 1;
            }
            locals[rest_slot] = js_array_create(rest_items);
        }

        # Populate the implicit `arguments` object for non-arrow functions.
        # ECMAScript: arguments is an Array-like containing all passed args,
        # plus a non-enumerable `callee`.
        if fn.arguments_slot >= 0 {
            locals[fn.arguments_slot] = self._build_arguments(
                args, closure_val, fn, locals
            );
        }

        sbase: int = len(self.stack);
        # NewTarget for this frame: an arrow inherits it lexically from the enclosing
        # frame (new.target is lexical); any other function takes the pending value set
        # by a construct site (undefined for an ordinary call).  Consume it once.
        rn_is_arrow: bool = False;
        if is_fn_val(closure_val) {
            rn_cl_idx: int = get_fn_idx(closure_val);
            if rn_cl_idx >= 0 and rn_cl_idx < len(self.realm.closures) {
                rn_is_arrow = self.realm.closures[rn_cl_idx].is_arrow;
            }
        }
        rn_new_target: JSValue = js_undefined();
        if rn_is_arrow {
            # new.target is lexical: an arrow inherits the value captured at its DEFINITION
            # site (MAKE_ARROW stores frame.new_target into closure.lexical_new_target), NOT
            # the new.target of whoever calls it later. Reading the call-time enclosing frame
            # (self.frames[-1]) is wrong once the defining ctor has returned — e.g. an arrow
            # created in `new F()` and stored on the instance still sees new.target === F when
            # invoked plainly (test262 arrow-function/lexical-new.target-closure-returned).
            if rn_cl_idx >= 0 and rn_cl_idx < len(self.realm.closures) {
                rn_new_target = self.realm.closures[rn_cl_idx].lexical_new_target;
            }
        } else {
            # Two one-shot construct channels feed NewTarget: `_pending_new_target`
            # and `pending_new_target`. Whichever a construct site set wins (they are
            # never both meaningfully set at once).
            rn_new_target = self._pending_new_target;
            if jsv_is_undefined(rn_new_target) {
                rn_new_target = self.pending_new_target;
            }
        }
        self._pending_new_target = js_undefined();
        self.pending_new_target = js_undefined();
        rn_this_uninit: bool = self._pending_this_uninit;
        self._pending_this_uninit = False;
        rn_ctor_class: JSValue = self._pending_ctor_class;
        self._pending_ctor_class = 0;
        frame: CallFrame = self._frame_acquire(
            fn,
            sbase,
            locals,
            free_vals,
            this_val,
            closure_val,
            rn_new_target,
            rn_this_uninit,
            rn_ctor_class,
            rp_reuse
        );
        # Seed the frame's `with` scope chain from the closure's captured with-objects
        # (a function defined inside a `with` body — ES §9.1). Copy so the callee's
        # WITH_PUSH/WITH_POP don't mutate the closure's captured list.
        if is_fn_val(closure_val) {
            rn_cl_idx: int = get_fn_idx(closure_val);
            if rn_cl_idx >= 0 and rn_cl_idx < len(self.realm.closures) {
                rn_cw: list[JSValue] = self.realm.closures[
                    rn_cl_idx
                ].captured_with_objs;
                if len(rn_cw) > 0 {
                    rn_wseed: list[JSValue] = [];
                    for rn_wo in rn_cw {
                        rn_wseed.append(rn_wo);
                    }
                    frame.with_objs = rn_wseed;
                    frame.rare = True;
                    frame.with_inherited = len(rn_wseed);  # these are OUTER-scope with-objs
                }
                # An arrow lexically inside a derived constructor shares that ctor's
                # this-binding cell (captured at MAKE_ARROW), so `super()` in the arrow
                # initializes the enclosing ctor's `this` (ES §9.1.1.3 / §13.3.7.1).
                rn_encl_cell: JSValue = self.realm.closures[
                    rn_cl_idx
                ].this_binding_cell;
                if rn_is_arrow and rn_encl_cell != 0 {
                    frame.this_binding_cell = rn_encl_cell;
                }
            }
        }
        # A derived constructor allocates a fresh shared this-binding cell, uninitialized
        # (TDZ sentinel) until super() binds it. Arrows created in the body capture it.
        if frame.this_binding_cell == 0 and rn_this_uninit {
            if jsv_is_undefined(_TDZ_SENTINEL) {
                _TDZ_SENTINEL = _js_tdz_create();
                gc_pin_value(_TDZ_SENTINEL);  # glob-held singleton — invisible to the GC root walk
            }
            frame.this_binding_cell = make_cell(_TDZ_SENTINEL);
        }
        self.frames.append(frame);

        # ── Proper-tail-call trampoline (ES §15.10.3) ────────────────────────────────
        # _exec may stop with a plain-JS-function tail call staged in the VM _tail_* channel
        # (st.tail_pending). Rather than recurse into run() (growing the native stack), we
        # DISCARD the current frame here and re-enter the tail callee in THIS same native
        # `run` invocation — so unbounded tail recursion uses O(1) native stack. `frame`,
        # `fn`, and `sbase` are reassigned to the tail callee each iteration.
        frame.rpc = 0;
        result: JSValue = self._exec_any(frame);
        while self._tail_closure != 0 and not self.had_exception {
            tr_closure: JSValue = self._tail_closure;
            tr_this: JSValue = self._tail_this;
            tr_args: list[JSValue] = self._tail_args;
            self._tail_closure = 0;
            self._tail_this = 0;
            self._tail_args = [];
            # Discard the OUTGOING frame: clear its operand-stack residue and pop it. The
            # native call_depth is NOT decremented — we reuse this level for the tail callee.
            while len(self.stack) > sbase {
                self.stack.pop();
            }
            tr_of: int = len(self.frames);
            if tr_of > 0 {
                # Recycle the outgoing frame through the frame pool — it
                # completed normally (a tail call is staged, no exception) —
                # unless an arguments object may alias its locals or it is a
                # generator/async frame: the eligibility run() applies at exit.
                # A fresh frame per tail call allocated the frame, its locals
                # and a dozen bookkeeping lists every time (jac_client: 6.6M
                # tail calls, ~89M mallocs and as many frees).
                if len(self.frame_pool) < _FRAME_POOL_MAX
                    and not self.frames[tr_of - 1].func.is_generator
                    and not self.frames[tr_of - 1].func.is_async {
                    # (Pooled with a fresh locals list when an arguments
                    # object may alias the current one, as at run() exit.)
                    if self.frames[tr_of - 1].func.arguments_slot >= 0 {
                        self.frames[tr_of - 1].locals = [];
                    }
                    self.frame_pool.append(self.frames[tr_of - 1]);
                }
                del self.frames[tr_of - 1];
            }
            # Build the tail callee's frame (mirrors run_cl's effective-this + run's setup).
            tr_cl: JSClosure = self.realm.closures[get_fn_idx(tr_closure)];
            tr_fn: CompiledFunction = tr_cl.func;
            tr_eff_this: JSValue = tr_this;
            if not jsv_is_undefined(tr_cl.lexical_this) {
                tr_eff_this = tr_cl.lexical_this;
            } elif not tr_fn.is_strict {
                if jsv_is_null(tr_eff_this) or jsv_is_undefined(tr_eff_this) {
                    tr_eff_this = self._sloppy_this_for(tr_fn);
                } elif not jsv_is_any_object(tr_eff_this) {
                    tr_eff_this = _to_object_or_throw(tr_eff_this);
                }
            }
            tr_mf_saved: list[CompiledFunction] = self.module_fns;
            if len(tr_cl.module_fns) > 0 {
                self.module_fns = tr_cl.module_fns;
            }
            frame = self._build_tail_frame(
                tr_fn, tr_eff_this, tr_args, tr_cl.free_vals, tr_closure
            );
            self.frames.append(frame);
            fn = tr_fn;
            sbase = frame.stack_base;
            frame.rpc = 0;
            result = self._exec_any(frame);
            self.module_fns = tr_mf_saved;
        }

        # ES §10.2.11 / §15.7.15: on normal completion of a *derived* constructor whose
        # `this` was never initialized (no `super()` ran), returning undefined/primitive
        # is a ReferenceError.  Returning an object is allowed (it becomes the instance).
        # NOTE: a `try/finally` or `for-of` in the body could still call `super()` during
        # abrupt-completion cleanup *after* the (unimplemented here) finally / IteratorClose
        # runs — so if the body contains such a construct we conservatively skip this check
        # rather than throw prematurely (tests derived-class-return-override-{finally,for-of}).
        # this-uninitialized status: the shared cell (if present) is authoritative — an
        # arrow's super() may have initialized it through the cell without touching this
        # frame's own this_uninitialized flag; fall back to the flag when there is no cell.
        rn_this_uninit_now: bool = frame.this_uninitialized;
        if frame.this_binding_cell != 0 {
            rn_this_uninit_now = js_is_tdz(cell_get(frame.this_binding_cell));
        }
        # ES §10.2.2 [[Construct]] step 13: a derived constructor's return value is checked
        # BEFORE the this-binding. When `this` is UNINITIALIZED (super() never ran) and the
        # ctor returned a non-undefined non-object primitive, that is a TypeError, not the
        # ReferenceError (test262 subclass/builtin-objects/Object/constructor-returns-non-
        # object: `return 42` in a derived ctor without super()). Gated on rn_this_uninit_now
        # so it fires ONLY for a genuine derived-ctor-before-super frame — never for arrows,
        # async, or Promise reaction frames (which also carry a this_binding_cell but have an
        # INITIALIZED this and may legitimately return a primitive).
        if rn_this_uninit_now
            and not self.had_exception
            and not jsv_is_undefined(result)
            and not jsv_is_any_object(result)
            and not _fn_may_defer_super(fn) {
            exc_dro2: JSValue = make_type_error(
                "Derived constructors may only return object or undefined"
            );
            self.had_exception = True;
            self.pending_exc = exc_dro2;
        } elif rn_this_uninit_now
            and not self.had_exception
            and not jsv_is_any_object(result) {
            if not _fn_may_defer_super(fn) {
                exc_tu: JSValue = make_reference_error(
                    "Must call super constructor in derived class before accessing 'this' or returning from derived constructor"
                );
                self.had_exception = True;
                self.pending_exc = exc_tu;
            }
        }

        # Dispose any `using` resources still open when control leaves the frame
        # (exception propagating out without a handler, or a stray leftover). Normal
        # completion already ran DISPOSE_RUN, so this is usually a no-op. Save/restore
        # the in-flight exception so dispose() calls run cleanly and the original
        # exception still propagates (a throw from dispose() would replace it, but the
        # common case is no throw).
        if len(frame.dispose_stack) > 0 {
            re_saved_exc: bool = self.had_exception;
            re_saved_pending: JSValue = self.pending_exc;
            self.had_exception = False;
            self.pending_exc = js_undefined();
            self._dispose_to(frame, 0);
            frame.dispose_marks = [];
            if not self.had_exception {
                # No throw from dispose() — restore the original propagating exception.
                self.had_exception = re_saved_exc;
                self.pending_exc = re_saved_pending;
            }
        }

        # Clean up any operand-stack residue from this frame
        while len(self.stack) > sbase {
            del self.stack[len(self.stack) - 1];
        }

        nf: int = len(self.frames);
        del self.frames[nf - 1];
        # Module/script top-level environment retention. A `<main>` frame is the
        # top-level body of a module or script; its locals ARE the module-level
        # bindings (`const`/`let`/`var`/hoisted `function`). Node keeps a loaded
        # module's environment alive for the process lifetime, so functions that
        # run LATER (a registered command action, an event handler) can still
        # read module-level state. This engine discards the <main> frame's locals
        # when it pops, so a module-level binding not captured by some surviving
        # closure became unreachable and was collected out from under still-live
        # code — e.g. vite's cli.js `const cli = cac('vite')`: after its top-level
        # ran, the cac command/option graph was unrooted, a later --gc collection
        # (during esbuild config-load) reclaimed an Option's `names` array, and
        # `option.name` read undefined → `checkOptionValue` `.split` crash. Pin
        # the locals so the environment persists (bounded: one pass over a
        # module's top-level slots, once, not per allocation).
        if fn.name == "<main>" {
            if frame.win {
                mp_i: int = 0;
                while mp_i < frame.func.num_locals {
                    gc_pin_value(frame.locals[frame.lb + (mp_i)]);
                    mp_i = mp_i + 1;
                }
            } else {
                for mlv in frame.locals {
                    gc_pin_value(mlv);
                }
            }
        }
        # Pool release (call_path Phase 2): NORMAL completion only — an
        # abrupt frame may still be referenced by in-flight unwind state.
        # `fn`/`frame` are the FINAL callee here (the tail trampoline
        # reassigns both), so eligibility is rechecked against them.
        if (not self.had_exception)
            and (not fn.is_generator)
            and (not fn.is_async)
            and len(self.frame_pool) < _FRAME_POOL_MAX {
            # An arguments object may alias the locals: the frame is pooled
            # with a fresh list instead (the next user resizes it).
            if fn.arguments_slot >= 0 {
                frame.locals = [];
            }
            self.frame_pool.append(frame);
        }
        self.call_depth = self.call_depth - 1;
        if VM_DEBUG_MODE {
            self.vm_debug("← run  fn=" + fn.name + "  result=" + jsval_dbg(result));
        }
        return result;
    }

    """
    Convenience entry point for evaluating a top-level compiled program.
    Sets module_fns then runs the top-level function with no args.
    """
    def eval(fn: CompiledFunction, module_fns: list[CompiledFunction]) -> JSValue {
        # Seed the TDZ sentinel once (its tag is Undefined until first eval call)
        if jsv_is_undefined(_TDZ_SENTINEL) {
            _TDZ_SENTINEL = _js_tdz_create();
            gc_pin_value(_TDZ_SENTINEL);  # glob-held singleton — invisible to the GC root walk
        }
        if VM_DEBUG_MODE {
            self.vm_debug(
                "→ eval  fn=" + fn.name + "  n_module_fns=" + str(len(module_fns))
            );
        }
        self.module_fns = module_fns;
        # Top-level (global code) `this` is the global object for a non-module script
        # (ES §9.4.1 / §16.1.7). ESM entry modules have `this === undefined`.
        # Direct eval overrides via pending_eval_this (caller's this — ES §19.2.1.1).
        toplevel_this: JSValue = self.global_this;
        if self.esm_entry == 1 {
            toplevel_this = js_undefined();
        }
        if self.pending_eval_this_set {
            toplevel_this = self.pending_eval_this;
            self.pending_eval_this_set = False;
            self.pending_eval_this = js_undefined();
        }
        result: JSValue = self.run(fn, toplevel_this, [], [], js_undefined());
        # Top-level await: resume async frames suspended on import() promises
        tl_guard: int = 0;
        while self.vm_awaiting and tl_guard < 4096 {
            tl_guard = tl_guard + 1;
            self.vm_awaiting = False;  # reset before resuming so any generator that suspends again re-sets it
            gi: int = 0;
            while gi < len(self.realm.generators) {
                gst: JSGeneratorState = self.realm.generators[gi];
                if not gst.done and not jsv_is_undefined(gst.send_val) {
                    self._resume_async_frame(gi, gst.send_val, False);
                }
                gi = gi + 1;
            }
        }
        return result;
    }

    """
    vm.runInThisContext(code) — compile and run in current global scope (Vite V-10).
    Returns the completion value of the script.
    """
    def run_in_this_context(source: str) -> JSValue {
        return self.run_in_this_context_ex(source, False);
    }

    # $262.evalScript / ScriptEvaluation on the current realm (not eval).
    def eval_script_source(source: str) -> JSValue {
        ast = parse(source, False, False);
        if _PARSE_HAD_ERRORS {
            vm_throw_native(make_syntax_error("Invalid or unexpected token"));
            return js_undefined();
        }
        # GDI §16.1.7 early errors for LexicallyDeclaredNames (top-level only).
        es_si: int = 0;
        while es_si < len(ast.children) {
            es_stmt: ASTNode = ast.children[es_si];
            es_names: list[str] = [];
            if es_stmt.ntype == ASTNodeType.VariableDeclaration {
                if es_stmt.value == "let" or es_stmt.value == "const" {
                    for es_d in es_stmt.declarations {
                        if es_d.id is not None {
                            self._eval_script_collect_pattern(es_d.id, es_names);
                        }
                    }
                }
            } elif es_stmt.ntype == ASTNodeType.ClassDeclaration {
                if es_stmt.id is not None {
                    es_names.append(es_stmt.id.name);
                }
            }
            for es_name in es_names {
                if es_name in self.global_lexical {
                    vm_throw_native(
                        make_syntax_error(
                            "Identifier '" + es_name + "' has already been declared"
                        )
                    );
                    return js_undefined();
                }
                es_kid: int = str_intern(es_name);
                es_desc: JSProperty = js_object_get_own_property_descriptor(
                    self.global_this, es_kid
                );
                if es_desc.key != 0
                    and not es_desc.deleted
                    and not es_desc.configurable {
                    # HasRestrictedGlobalProperty
                    vm_throw_native(
                        make_syntax_error(
                            "Identifier '" + es_name + "' has already been declared"
                        )
                    );
                    return js_undefined();
                }
                if es_name in self.globals {
                    if es_desc.key == 0 or es_desc.deleted {
                        # Script var tracked only in the globals map.
                        vm_throw_native(
                            make_syntax_error(
                                "Identifier '" + es_name + "' has already been declared"
                            )
                        );
                        return js_undefined();
                    }
                    # Configurable own property (eval-introduced annex B) — allowed.
                    # Drop the object-env binding so the new lexical shadows it.
                    if es_name in self.globals {
                        del self.globals[es_name];
                        self.gw_epoch = self.gw_epoch + 1;
                    }
                    js_object_delete(self.global_this, es_kid);
                }
            }
            es_si = es_si + 1;
        }
        c = make_compiler();
        c.source_text = source;
        top_fn: CompiledFunction = c.compile_program(ast);
        if c.had_error {
            ce_msg: str = c.last_error_msg;
            if ce_msg == "" {
                ce_msg = "Invalid or unexpected token";
            }
            if ce_msg.startswith("SyntaxError: ") {
                ce_msg = ce_msg[13:];
            }
            vm_throw_native(make_syntax_error(ce_msg));
            return js_undefined();
        }
        result: JSValue = self.eval(top_fn, c.all_fns);
        if self.had_exception {
            es_exc: JSValue = self.pending_exc;
            self.had_exception = False;
            self.pending_exc = js_undefined();
            vm_throw_native(es_exc);
            return js_undefined();
        }
        # Publish top-level let/const into the persistent global lexical env.
        # Re-evaluate each declarator init in a tiny script so values survive
        # after the ephemeral <main> frame is discarded.
        es_si2: int = 0;
        while es_si2 < len(ast.children) {
            es_stmt2: ASTNode = ast.children[es_si2];
            if es_stmt2.ntype == ASTNodeType.VariableDeclaration {
                if es_stmt2.value == "let" or es_stmt2.value == "const" {
                    for es_d2 in es_stmt2.declarations {
                        if es_d2.id is not None
                            and es_d2.id.ntype == ASTNodeType.Identifier {
                            es_nm2: str = es_d2.id.name;
                            es_val2: JSValue = js_undefined();
                            if es_d2.init is not None {
                                es_val2 = self._eval_script_init_value(es_d2.init);
                            }
                            self.global_lexical[es_nm2] = es_val2;
                        }
                    }
                }
            }
            es_si2 = es_si2 + 1;
        }
        return result;
    }

    # Collect binding names from a pattern AST node into out (evalScript helper).
    def _eval_script_collect_pattern(nd: ASTNode, out: list[str]) -> None {
        if nd is None {
            return;
        }
        if nd.ntype == ASTNodeType.Identifier {
            out.append(nd.name);
        } elif nd.ntype == ASTNodeType.AssignmentPattern {
            if nd.left is not None {
                self._eval_script_collect_pattern(nd.left, out);
            }
        } elif nd.ntype == ASTNodeType.RestElement {
            if nd.argument is not None {
                self._eval_script_collect_pattern(nd.argument, out);
            }
        }
    }

    # Evaluate a simple initializer AST for evalScript lexical publish.
    def _eval_script_init_value(init_nd: ASTNode) -> JSValue {
        if init_nd is None {
            return js_undefined();
        }
        if init_nd.ntype == ASTNodeType.Literal {
            if init_nd.value == "null" {
                return js_null();
            }
            if init_nd.kind == "boolean" {
                if init_nd.value == "true" {
                    return js_true();
                }
                return js_false();
            }
            if init_nd.kind == "number" {
                return js_number(str_to_float(init_nd.value));
            }
            if init_nd.kind == "string" {
                return js_str(init_nd.value);
            }
        }
        return js_undefined();
    }

    """
    Compile and run `source` as a top-level program in the current realm.
    `inherit_caller_scope` is True for *direct* eval (§19.2.1.1): the eval'd code
    inherits the calling frame's strictness and resolves bare names against the
    caller's locals/free-vars; False for indirect eval / runInThisContext.
    """
    def run_in_this_context_ex(source: str, inherit_caller_scope: bool) -> JSValue {
        return self.run_in_this_context_ex2(source, inherit_caller_scope, 0);
    }

    """
    As run_in_this_context_ex, plus `param_eval_mode` (B7): 0 = not a parameter
    eval; 1 = direct eval inside an *ordinary* function's parameter expression
    (reject `arguments` and `eval` bindings); 2 = inside an *arrow* function's
    parameter expression (reject only `eval` — arrows have no own `arguments`).
    ES §15.1.1.
    """
    def run_in_this_context_ex2(
        source: str, inherit_caller_scope: bool, param_eval_mode: int
    ) -> JSValue {
        # One-shot channels set by run_in_context(): the contextified sandbox that
        # is the global object of this compilation unit, and the script name to
        # attribute its frames to.
        ctx_global_rc: JSValue = self.pending_ctx_global;
        ctx_realm_only_rc: bool = self.pending_ctx_realm_only;
        self.pending_ctx_realm_only = False;
        ctx_file_rc: str = self.pending_ctx_filename;
        # Cross-realm: if this eval came from a foreign realm's `eval`, hold that realm id
        # for the whole run so every top-level closure MAKE_FUNCTION creates is stamped with
        # it (see _op_make_function). Save/restore to survive nested evals.
        saved_src_realm: int = self._pending_source_realm_id;
        eval_src_realm: int = self.pending_eval_source_realm;
        self.pending_eval_source_realm = 0;
        if eval_src_realm != 0 {
            self._pending_source_realm_id = eval_src_realm;
        }
        self.pending_ctx_global = 0;
        self.pending_ctx_filename = "";
        # eval code is Script goal, never a Module (import/export are syntax
        # errors in eval) — skip the module-goal pre-scan.
        ast = parse(source, False, False);
        # ECMAScript §19.2.1.1 (PerformEval): a parse error in eval'd code is a
        # SyntaxError thrown into the calling context — not a silent no-op.
        if _PARSE_HAD_ERRORS {
            exc_pe: JSValue = make_syntax_error("Invalid or unexpected token");
            vm_throw_native(exc_pe);
            self._pending_source_realm_id = saved_src_realm;
            return js_undefined();
        }
        c = make_compiler();
        c.in_direct_eval = True;
        c.eval_in_param_expr = param_eval_mode;
        c.source_text = source;
        if len(ctx_file_rc) > 0 {
            c.source_file = ctx_file_rc;
        }
        # ES §15.7.1: direct eval inside a class field initializer inherits the
        # field context — top-level `arguments`/`new.target` in the eval'd code are
        # early SyntaxErrors. Detect via the caller frame's field-init function
        # (also set on arrows nested in a field initializer).
        caller_is_field_init: bool = False;
        if inherit_caller_scope and len(self.frames) > 0 {
            if self.frames[len(self.frames) - 1].func.is_field_init {
                c.eval_field_forbid = True;
                caller_is_field_init = True;
            }
        }
        # ES §13.3.12: INDIRECT eval / runInThisContext is GLOBAL code — a top-level
        # `new.target` (or one inside an arrow, which inherits the global's absent
        # new.target) is an early SyntaxError.
        if not inherit_caller_scope {
            c.eval_forbid_newtarget = True;
        }
        # Direct eval inherits the caller's strict mode (so e.g. `with` / `delete x`
        # / duplicate params in a strict caller are early errors even when the eval
        # source itself has no "use strict" directive).
        caller_strict: bool = False;
        if inherit_caller_scope and len(self.frames) > 0 {
            caller_strict = self.frames[len(self.frames) - 1].func.is_strict;
        }
        if caller_strict {
            c.eval_force_strict = True;
        }
        # B13 / W7: direct eval inherits the caller's super context. If the calling
        # frame's function has a [[HomeObject]] (object method) or super_class
        # (class method / field init), permit `super.x` in the eval'd code; permit
        # `super()` only for a derived constructor (super_class set and not an
        # object-method home). Field initializers always allow SuperProperty and
        # never SuperCall (ES §15.7.1).
        eval_super_fn: JSValue = js_undefined();
        if inherit_caller_scope and len(self.frames) > 0 {
            es_caller_self: JSValue = self.frames[len(self.frames) - 1].self_fn;
            if is_fn_val(es_caller_self) {
                es_cl: JSClosure = self.realm.closures[get_fn_idx(es_caller_self)];
                es_has_home: bool = jsv_is_object_cell(es_cl.home_object)
                    and jsv_to_table_id(es_cl.home_object) > 0;
                es_has_super: bool = not jsv_is_undefined(es_cl.super_class);
                if es_has_home or es_has_super or caller_is_field_init {
                    c.super_prop_allowed = True;
                    eval_super_fn = es_caller_self;
                }
                if es_has_super and not es_has_home and not caller_is_field_init {
                    c.super_call_allowed = True;
                }
                # W7: thread the caller's PrivateEnvironment into eval compilation
                # so `#name` in the eval'd source resolves to the same brands.
                es_cf: CompiledFunction = es_cl.func;
                if len(es_cf.priv_env_keys) > 0 {
                    ep_i: int = 0;
                    while ep_i < len(es_cf.priv_env_keys) {
                        c.eval_priv_keys.append(es_cf.priv_env_keys[ep_i]);
                        c.eval_priv_mangles.append(es_cf.priv_env_mangles[ep_i]);
                        ep_i = ep_i + 1;
                    }
                    if es_cf.priv_env_next_sid > c.priv_scope_seq {
                        c.priv_scope_seq = es_cf.priv_env_next_sid;
                    }
                }
            } elif caller_is_field_init {
                # Field-init frame without a callable self_fn still forbids SuperCall
                # and allows SuperProperty at compile time.
                c.super_prop_allowed = True;
            }
            # Fallback: caller CompiledFunction may carry priv_env even when self_fn
            # is missing (e.g. odd frame shapes); prefer the live frame's func.
            if len(c.eval_priv_keys) == 0 {
                es_cf2: CompiledFunction = self.frames[len(self.frames) - 1].func;
                if len(es_cf2.priv_env_keys) > 0 {
                    ep_j: int = 0;
                    while ep_j < len(es_cf2.priv_env_keys) {
                        c.eval_priv_keys.append(es_cf2.priv_env_keys[ep_j]);
                        c.eval_priv_mangles.append(es_cf2.priv_env_mangles[ep_j]);
                        ep_j = ep_j + 1;
                    }
                    if es_cf2.priv_env_next_sid > c.priv_scope_seq {
                        c.priv_scope_seq = es_cf2.priv_env_next_sid;
                    }
                }
            }
        }
        top_fn: CompiledFunction = c.compile_program(ast);
        # Compiler-detected early errors (strict-mode `with`, `delete` of an
        # unqualified name, duplicate params, etc.) are also SyntaxErrors.
        if c.had_error {
            ce_msg: str = c.last_error_msg;
            if ce_msg == "" {
                ce_msg = "Invalid or unexpected token";
            }
            if ce_msg.startswith("SyntaxError: ") {
                ce_msg = ce_msg[13:];
            }
            exc_ce: JSValue = make_syntax_error(ce_msg);
            vm_throw_native(exc_ce);
            self._pending_source_realm_id = saved_src_realm;
            return js_undefined();
        }
        # ES §19.2.1.3 EvalDeclarationInstantiation static check: a *non-strict*
        # direct eval whose top-level `var`-declared name collides with a lexical
        # binding (let/const/class) or a parameter of the enclosing function must
        # throw a SyntaxError *before* the body runs (so callCount stays 0).
        # Excluded:
        #   - indirect eval — its vars target the global scope, checked elsewhere;
        #   - STRICT eval (strict caller or `"use strict"` in the eval source) —
        #     a strict direct eval gets its OWN variable environment, so its `var`
        #     never enters the enclosing scope and cannot collide (var-env-*-strict);
        #   - eval in a *parameter* expression — its `var` shares the PARAMETER
        #     environment, not the body's, so it collides with parameters only,
        #     never with a body `let`/`const` (arrow-fn-body-*-arguments cases).
        eval_is_strict: bool = caller_strict or top_fn.is_strict;
        if inherit_caller_scope and len(self.frames) > 0 and not eval_is_strict {
            eval_vars: list[str] = c.collect_toplevel_var_names(ast.children);
            if len(eval_vars) > 0 {
                caller_fn: CompiledFunction = self.frames[len(self.frames) - 1].func;
                clash: str = "";
                for ev_name in eval_vars {
                    for pm_name in caller_fn.params {
                        if pm_name == ev_name {
                            clash = ev_name;
                        }
                    }
                    # Body lexical bindings only clash with a body-position eval —
                    # a parameter-expression eval shares the parameter env, not the
                    # body env, so skip lexical_names when param_eval_mode > 0.
                    if param_eval_mode == 0 {
                        for lx_name in caller_fn.lexical_names {
                            if lx_name == ev_name {
                                # B.3.5: a simple CatchParameter does not make
                                # `var`/function of the same name an early error.
                                edi_catch_ok: bool = False;
                                for scp in caller_fn.simple_catch_params {
                                    if scp == ev_name {
                                        edi_catch_ok = True;
                                    }
                                }
                                if not edi_catch_ok {
                                    clash = ev_name;
                                }
                            }
                        }
                    }
                }
                if clash != "" {
                    exc_edi: JSValue = make_syntax_error(
                        "Identifier '" + clash + "' has already been declared"
                    );
                    vm_throw_native(exc_edi);
                    self._pending_source_realm_id = saved_src_realm;
                    return js_undefined();
                }
            }
        }
        # Annex B.3.3.3 EvalDeclarationInstantiation: create varEnv bindings for
        # eligible block-level function names before the body runs.
        # Use program_annexb_fn_names — annexb_block_fn_names is cleared by _pop_fn.
        if not eval_is_strict {
            for ab_edi_name in c.program_annexb_fn_names {
                if inherit_caller_scope and len(self.frames) > 0 {
                    ab_edi_cf: CallFrame = self.frames[len(self.frames) - 1];
                    # Function varEnv (not script <main>): CreateMutableBinding on caller.
                    if ab_edi_cf.func.name != "<main>" {
                        self._edi_ensure_var_binding(ab_edi_cf, ab_edi_name);
                    } else {
                        # Direct eval at global code — configurable:true.
                        self._create_global_fn_binding(
                            ab_edi_name, js_undefined(), True
                        );
                    }
                } else {
                    # Indirect eval — global varEnv, configurable:true.
                    self._create_global_fn_binding(ab_edi_name, js_undefined(), True);
                }
            }
        }
        # ES §19.2.1.3 EvalDeclarationInstantiation (var bindings): each top-level
        # `var` name in the eval'd source gets a binding in the RUNNING execution
        # context's VariableEnvironment.  For a direct eval inside an ordinary
        # function this is the caller frame's own var env — create a dyn_var there
        # so the name SHADOWS a captured outer free-var of the same name
        # (test262 compound-assignment/S11.13.2_A6.*_T1: `x *= (eval("var x=2"),4)`
        # must leave the eval-introduced inner x === 2, distinct from the outer x it
        # writes).  A `<main>`/global var env is handled by the eval'd code's own
        # STORE_GLOBAL, so only bind on a real function frame.
        # Only for a BODY direct eval (param_eval_mode == 0): its `var` bindings live in
        # the function's own VariableEnvironment, so create a dyn_var that SHADOWS any
        # captured outer binding of the same name (test262 compound-assignment/
        # S11.13.2_A6.*_T1). A PARAMETER-expression eval (> 0) is deliberately SKIPPED:
        # its `var` belongs to the separate parameter Environment Record, and the
        # param-list closures capture that binding through the ordinary (global/free-var)
        # write path — installing a frame dyn_var here would hide the eval-assigned value
        # from those closures (test262 */scope-param-*elem-var-*).
        if inherit_caller_scope
            and len(self.frames) > 0
            and not eval_is_strict
            and param_eval_mode == 0 {
            edi_var_cf: CallFrame = self.frames[len(self.frames) - 1];
            if edi_var_cf.func.name != "<main>" {
                edi_vars: list[str] = c.collect_toplevel_var_names(ast.children);
                for edi_vn in edi_vars {
                    self._edi_shadow_var_binding(edi_var_cf, edi_vn);
                }
            }
        }
        # Name-resolution boundary for the eval'd code's LOAD_GLOBAL fallback:
        #   - direct eval: the whole live caller chain (locals/free-vars of every
        #     enclosing frame), so caller block/function bindings are visible.
        #   - indirect eval: only the *global* lexical environment — frame 0 (the
        #     <main> wrapper that holds top-level let/const/function bindings) — NOT
        #     the caller's block/function scope.
        #   - vm.runInContext: nothing — the sandbox is the whole scope, so not even
        #     the host's <main> bindings may leak in (boundary = 0).
        pushed_eval_scope: bool = False;
        if len(self.frames) > 0 {
            if ctx_global_rc != 0 and not ctx_realm_only_rc {
                self.eval_scope_frames.append(0);
                pushed_eval_scope = True;
            } elif inherit_caller_scope {
                self.eval_scope_frames.append(len(self.frames));
                pushed_eval_scope = True;
            } else {
                # Indirect (incl. a foreign-realm eval): global frame only (boundary = 1).
                self.eval_scope_frames.append(1);
                pushed_eval_scope = True;
            }
        }
        # Bind every function compiled from this source to the sandbox so its
        # bare-name loads/stores resolve there — including closures that outlive
        # the run (a function returned out of runInContext keeps its context).
        # A foreign-REALM eval only routes its TOP-LEVEL var/global writes to the realm
        # global (top_fn.ctx_global); nested closures are ordinary global code and must NOT
        # be sandbox-stamped (that mis-scopes generic function bodies).
        if ctx_global_rc != 0 {
            top_fn.ctx_global = ctx_global_rc;
            if not ctx_realm_only_rc {
                for cf_ctx in c.all_fns {
                    cf_ctx.ctx_global = ctx_global_rc;
                }
            }
        }
        # B13: make the inherited super-fn available to LOAD_SUPER_PROTO in the eval frame.
        self.eval_super_fns.append(eval_super_fn);
        # Direct eval inherits the caller's `this` (methods / field inits / arrows).
        if inherit_caller_scope and len(self.frames) > 0 {
            self.pending_eval_this = self.frames[len(self.frames) - 1].this_val;
            self.pending_eval_this_set = True;
        }
        saved_exc: bool = self.had_exception;
        saved_pending: JSValue = self.pending_exc;
        saved_module_fns: list[CompiledFunction] = self.module_fns;
        self.had_exception = False;
        self.pending_exc = js_undefined();
        result: JSValue = self.eval(top_fn, c.all_fns);
        self._pending_source_realm_id = saved_src_realm;
        self.pending_eval_this_set = False;
        self.pending_eval_this = js_undefined();
        self.module_fns = saved_module_fns;
        del self.eval_super_fns[len(self.eval_super_fns) - 1];
        if pushed_eval_scope {
            del self.eval_scope_frames[len(self.eval_scope_frames) - 1];
        }
        if self.had_exception {
            exc_out: JSValue = self.pending_exc;
            # Surface the eval'd exception to the *caller* via the native-exception
            # channel (so `_check_native_exc` unwinds into the caller's try/catch).
            # Clear the VM-level had_exception/pending_exc first: leaving them set
            # would make the caller frame believe it is still unwinding even after
            # the catch handler fires, so the exception would escape.
            self.had_exception = False;
            self.pending_exc = js_undefined();
            vm_throw_native(exc_out);
            return js_undefined();
        }
        self.had_exception = saved_exc;
        self.pending_exc = saved_pending;
        return result;
    }

    # ── vm.createContext / vm.runInContext ───────────────────────────

    """True for a host-global name that a contextified sandbox must NOT inherit.

    A bare Node vm context exposes the ECMAScript (plus WebAssembly / Intl)
    intrinsics and nothing else — no `process`, `require`, `console`, `Buffer`,
    timers or web APIs — so the sandbox cannot reach the embedder.  Engine-internal
    `__*` bridges are excluded for the same reason."""
    def _ctx_global_is_host_only(name: str) -> bool {
        if len(name) >= 2 and name[0] == "_" and name[1] == "_" {
            return True;
        }
        # Node / CommonJS host surface
        if name == "process" or name == "require" or name == "module" {
            return True;
        }
        if name == "exports" or name == "global" or name == "globalThis" {
            return True;
        }
        if name == "console" or name == "Buffer" or name == "fs" {
            return True;
        }
        if name == "Bun" or name == "js_engine" or name == "Server" {
            return True;
        }
        # Timers / scheduling
        if name == "setTimeout" or name == "clearTimeout" {
            return True;
        }
        if name == "setInterval" or name == "clearInterval" {
            return True;
        }
        if name == "setImmediate" or name == "clearImmediate" {
            return True;
        }
        if name == "queueMicrotask" or name == "structuredClone" {
            return True;
        }
        # Web / WHATWG platform globals Node installs on its own global
        if name == "fetch" or name == "crypto" or name == "performance" {
            return True;
        }
        if name == "URL" or name == "URLSearchParams" {
            return True;
        }
        if name == "TextEncoder" or name == "TextDecoder" {
            return True;
        }
        if name == "AbortController" or name == "AbortSignal" {
            return True;
        }
        if name == "EventTarget" or name == "CustomEvent" or name == "DOMException" {
            return True;
        }
        if name == "FormData"
            or name == "Headers"
            or name == "Request"
            or name == "Response" {
            return True;
        }
        if name == "ReadableStream" or name == "ReadableStreamDefaultReader" {
            return True;
        }
        if name == "WritableStream" or name == "WritableStreamDefaultWriter" {
            return True;
        }
        if name == "TransformStream" or name == "CountQueuingStrategy" {
            return True;
        }
        if name == "ByteLengthQueuingStrategy" {
            return True;
        }
        if name == "Blob" or name == "WebSocket" {
            return True;
        }
        # Engine-only reflection helpers that are not V8 context globals
        if name == "TypedArray" or name == "Generator" or name == "GeneratorFunction" {
            return True;
        }
        return False;
    }

    """
    vm.createContext(sandbox) — contextify `sandbox` and return it.

    Node identity semantics: the SAME object comes back (`createContext(s) === s`),
    marked so `vm.isContext(s)` is true.  The ECMAScript intrinsics it does not
    already own are seeded onto it as *non-enumerable* own properties, matching how
    V8 installs a context's globals — so `Object.keys(sandbox)` keeps showing only
    what the embedder and the sandboxed script put there.
    """
    def vm_create_context(sandbox: JSValue) -> JSValue {
        if not jsv_is_object_cell(sandbox) or jsv_to_table_id(sandbox) <= 0 {
            vm_throw_native(
                make_type_error("The \"contextObject\" argument must be an object")
            );
            return js_undefined();
        }
        if js_object_has_own(sandbox, _KEY_IS_VM_CONTEXT) {
            return sandbox;
        }
        host: JSValue = self.global_this;
        for hk in js_object_all_keys(host) {
            if hk < 0 or hk >= BUILTIN_BASE {
                continue;
            }
            if js_object_has_own(sandbox, hk) {
                continue;
            }
            if self._ctx_global_is_host_only(str_from_id(hk)) {
                continue;
            }
            # Lazy-loaded accessor globals (e.g. WebAssembly): js_object_get reads
            # the raw slot without firing the getter, so copying would install a
            # stale `undefined` data property that then shadows nothing useful.
            # Skip accessor host-keys — the sandbox simply lacks the not-yet-loaded
            # global (matching lazy semantics), rather than getting a bad value.
            if js_object_has_own_accessor(host, hk) {
                continue;
            }
            js_object_define_nonenum(sandbox, hk, js_object_get(host, hk));
        }
        # `globalThis` inside a context is the context's own global object.
        k_ctx_gt: int = str_intern("globalThis");
        if not js_object_has_own(sandbox, k_ctx_gt) {
            js_object_define_nonenum(sandbox, k_ctx_gt, sandbox);
        }
        js_object_set(sandbox, _KEY_IS_VM_CONTEXT, js_true());
        # Functions compiled for this context reference the sandbox from their
        # CompiledFunction, which the GC does not trace — pin it so a context kept
        # alive only through such a closure survives a collection.  Node likewise
        # holds a strong reference from the context to its sandbox.
        gc_pin_value(sandbox);
        return sandbox;
    }

    """True if `v` has been contextified by vm.createContext()."""
    def vm_is_context(v: JSValue) -> bool {
        if not jsv_is_object_cell(v) or jsv_to_table_id(v) <= 0 {
            return False;
        }
        return js_object_has_own(v, _KEY_IS_VM_CONTEXT);
    }

    """
    vm.runInContext(code, contextifiedSandbox[, filename]) — run `source` as global
    code whose global object IS the sandbox.  Top-level `this`, `globalThis`, bare
    name reads/writes and top-level `var`/`function` declarations all target the
    sandbox; the host globals map is unreachable from the compiled code.
    """
    def run_in_context(source: str, sandbox: JSValue, filename: str) -> JSValue {
        if not jsv_is_object_cell(sandbox) or jsv_to_table_id(sandbox) <= 0 {
            vm_throw_native(
                make_type_error(
                    "The \"contextifiedObject\" argument must be a vm.Context"
                )
            );
            return js_undefined();
        }
        saved_gt_ric: JSValue = self.global_this;
        saved_esm_ric: int = self.esm_entry;
        saved_exp_ric: str = self.current_esm_exports_global;
        self.global_this = sandbox;
        self.esm_entry = 0;
        self.current_esm_exports_global = "";
        self.pending_ctx_global = sandbox;
        self.pending_ctx_filename = filename;
        res_ric: JSValue = self.run_in_this_context_ex2(source, False, 0);
        self.pending_ctx_global = 0;
        self.pending_ctx_filename = "";
        self.global_this = saved_gt_ric;
        self.esm_entry = saved_esm_ric;
        self.current_esm_exports_global = saved_exp_ric;
        return res_ric;
    }

    """
    ECMAScript ToPrimitive (hint "string") — §7.1.1.
    If `v` is an Object, look up its `toString` method (own or prototype chain,
    including accessors).  If found and callable, call it and return the result.
    Fall back to `valueOf`.  If neither produces a non-object, return
    "[object Object]".
    For non-Object values, returns `v` unchanged.
    """
    def _to_primitive_string(v: JSValue) -> JSValue {
        # Callable values: OrdinaryToPrimitive must Get("toString") then Call, so a
        # user override of Function.prototype.toString is honoured (import(()=>{})).
        # Fall back to the intrinsic source-shaped string when Get/Call fails.
        if is_fn_val(v) or is_native_val(v) {
            ts_fn_c: JSValue = _fn_prop(v, WK_TOSTRING);
            if is_native_val(ts_fn_c)
                and get_native_kind(ts_fn_c) == NATIVE_KIND_FN_TOSTRING {
                return self._fn_to_string_value(v);
            }
            if is_fn_val(ts_fn_c) or is_native_val(ts_fn_c) or js_is_proxy(ts_fn_c) {
                ts_res_c: JSValue = _vm_invoke_callback(self, ts_fn_c, v, []);
                if self.had_exception {
                    return js_undefined();
                }
                if not _vm_is_object_like(ts_res_c) {
                    return ts_res_c;
                }
            }
            return self._fn_to_string_value(v);
        }
        if jsv_is_object_cell(v)
            and jsv_to_table_id(v) > 0
            and js_object_has_own(v, WK_IS_CLASS) {
            ts_fn_cls: JSValue = self._get_prop_accessor(v, WK_TOSTRING);
            if self.had_exception or vm_has_native_exc() {
                return js_undefined();
            }
            if is_native_val(ts_fn_cls)
                and get_native_kind(ts_fn_cls) == NATIVE_KIND_FN_TOSTRING {
                return self._fn_to_string_value(v);
            }
            if is_fn_val(ts_fn_cls)
                or is_native_val(ts_fn_cls)
                or js_is_proxy(ts_fn_cls) {
                ts_res_cls: JSValue = _vm_invoke_callback(self, ts_fn_cls, v, []);
                if self.had_exception {
                    return js_undefined();
                }
                if not _vm_is_object_like(ts_res_cls) {
                    return ts_res_cls;
                }
            }
            return self._fn_to_string_value(v);
        }
        if not jsv_is_object_cell(v) {
            return v;
        }
        # ── ECMAScript §7.1.1.1: check [Symbol.toPrimitive]("string") first ──
        # Use run_cl / _vm_invoke_callback (not vm_call_js_fn) so abrupt
        # completions propagate to the caller (R17 join/toString/sort).
        # GetMethod(@@toPrimitive) must run through the accessor path so a getter's
        # side effect fires (spec: Get(input, @@toPrimitive)); a raw get would miss it.
        tp_fn: JSValue = self._get_prop_accessor(
            v, SYMBOL_KEY_BASE + SYMBOL_TO_PRIMITIVE
        );
        if self.had_exception or vm_has_native_exc() {
            return js_undefined();
        }
        if not jsv_is_undefined(tp_fn) and not jsv_is_null(tp_fn) {
            # GetMethod(@@toPrimitive): accept any callable (fn/native/proxy), not
            # just a plain JS closure. A non-callable non-undefined/null value is a
            # TypeError (§7.3.10 step 3) — must NOT fall through to toString/valueOf.
            if is_fn_val(tp_fn) or is_native_val(tp_fn) or js_is_proxy(tp_fn) {
                tp_res: JSValue = _vm_invoke_callback(
                    self, tp_fn, v, [js_str("string")]
                );
                if self.had_exception {
                    return js_undefined();
                }
                # ES §7.1.1.1: @@toPrimitive returning an OBJECT is a TypeError (it must
                # NOT fall through to toString/valueOf). Symbols are valid primitives.
                if jsv_is_object_cell(tp_res) and not jsv_is_symbol(tp_res) {
                    self.had_exception = True;
                    self.pending_exc = make_type_error(
                        "Cannot convert object to primitive value"
                    );
                    return js_undefined();
                }
                return tp_res;
            }
            # ES §7.1.1.1 step 2.b: @@toPrimitive present but not callable → TypeError.
            self.had_exception = True;
            self.pending_exc = make_type_error(
                "Cannot convert object to primitive value"
            );
            return js_undefined();
        }
        # ── hint "string": try toString first, then valueOf ──
        k_tostr: int = WK_TOSTRING;
        ts_fn: JSValue = self._get_prop_accessor(v, k_tostr);
        # A poisoned toString/valueOf *getter* throws while being read — propagate
        # that (do not fall through to the TypeError below and clobber it).
        if self.had_exception or vm_has_native_exc() {
            return js_undefined();
        }
        if not jsv_is_undefined(ts_fn) {
            if is_fn_val(ts_fn) or is_native_val(ts_fn) or js_is_proxy(ts_fn) {
                ts_result: JSValue = _vm_invoke_callback(self, ts_fn, v, []);
                if self.had_exception {
                    return js_undefined();
                }
                # A callable result is still an Object per ES §6.1.7 — it must not
                # be accepted as the primitive, so fall through to valueOf.
                if not _vm_is_object_like(ts_result) {
                    return ts_result;
                }
            }
        }
        # Fallback: try valueOf
        k_valof: int = WK_VALUEOF;
        vo_fn: JSValue = self._get_prop_accessor(v, k_valof);
        if self.had_exception or vm_has_native_exc() {
            return js_undefined();
        }
        if not jsv_is_undefined(vo_fn) {
            if is_fn_val(vo_fn) or is_native_val(vo_fn) or js_is_proxy(vo_fn) {
                vo_result: JSValue = _vm_invoke_callback(self, vo_fn, v, []);
                if self.had_exception {
                    return js_undefined();
                }
                if not _vm_is_object_like(vo_result) {
                    return vo_result;
                }
            }
        }
        # OrdinaryToPrimitive: both toString and valueOf returned objects → TypeError.
        self.had_exception = True;
        self.pending_exc = make_type_error("Cannot convert object to primitive value");
        return js_undefined();
    }

    """
    ECMAScript ToPrimitive (hint "default") for additive `+` — §7.1.1.
    Invokes [Symbol.toPrimitive] with hint "default", then OrdinaryToPrimitive
    with number order (valueOf before toString) for ordinary objects.
    """
    def _to_primitive_default(v: JSValue) -> JSValue {
        # Non-objects pass through. A callable (function / native) IS an object per
        # ES §6.1.7 and must go through the full ToPrimitive lookup below — a
        # user-assigned `fn.valueOf`/`fn.toString` overrides the source-text default
        # (test262 S11.6.1_A2.2_T3: `1 + f2` uses f2's own valueOf). The source-text
        # fallback (Function.prototype.toString) is applied only if the ordinary
        # lookup yields no primitive.
        is_callable_v: bool = is_fn_val(v) or is_native_val(v);
        if not jsv_is_object_cell(v) and not is_callable_v {
            return v;
        }
        # ── ECMAScript §7.1.1.1: check [Symbol.toPrimitive]("default") first ──
        # GetMethod(@@toPrimitive) must run through the accessor path so a getter's
        # side effect fires (spec: Get(input, @@toPrimitive)); a raw get would miss
        # it (test262 get-symbol-to-prim-err). undefined/null → no method (skip).
        tp_fn_d: JSValue = self._get_prop_accessor(
            v, SYMBOL_KEY_BASE + SYMBOL_TO_PRIMITIVE
        );
        if self.had_exception or vm_has_native_exc() {
            return js_undefined();
        }
        if not jsv_is_undefined(tp_fn_d) and not jsv_is_null(tp_fn_d) {
            if is_fn_val(tp_fn_d) or is_native_val(tp_fn_d) or js_is_proxy(tp_fn_d) {
                tp_res_d: JSValue = _vm_invoke_callback(
                    self, tp_fn_d, v, [js_str("default")]
                );
                if self.had_exception {
                    return js_undefined();
                }
                # ES §7.1.1.1: @@toPrimitive returning an OBJECT is a TypeError (it must
                # NOT fall through to valueOf/toString). Symbols are valid primitives.
                if jsv_is_object_cell(tp_res_d) and not jsv_is_symbol(tp_res_d) {
                    self.had_exception = True;
                    self.pending_exc = make_type_error(
                        "Cannot convert object to primitive value"
                    );
                    return js_undefined();
                }
                return tp_res_d;
            }
            # ES §7.1.1.1 step 2.b: @@toPrimitive is present but not callable (and not
            # undefined/null) → TypeError (test262 bigint-toprimitive `{@@toPrimitive: 1}`).
            self.had_exception = True;
            self.pending_exc = make_type_error(
                "Cannot convert object to primitive value"
            );
            return js_undefined();
        }
        # Arrays have no own valueOf that returns a primitive; their default hint
        # result is the join. (Kept after the @@toPrimitive check so a custom
        # @@toPrimitive on an array is still honoured.)
        if js_is_array(v) {
            return js_Array_toString(v);
        }
        # ── hint "default" → OrdinaryToPrimitive with number order: valueOf, then toString ──
        k_valof_d: int = WK_VALUEOF;
        vo_fn_d: JSValue = self._get_prop_accessor(v, k_valof_d);
        if self.had_exception or vm_has_native_exc() {
            return js_undefined();
        }
        if not jsv_is_undefined(vo_fn_d) {
            if is_fn_val(vo_fn_d) or is_native_val(vo_fn_d) or js_is_proxy(vo_fn_d) {
                vo_res_d: JSValue = _vm_invoke_callback(self, vo_fn_d, v, []);
                if self.had_exception {
                    return js_undefined();
                }
                if not _vm_is_object_like(vo_res_d) {
                    return vo_res_d;
                }
            }
        }
        k_tostr_d: int = WK_TOSTRING;
        ts_fn_d: JSValue = self._get_prop_accessor(v, k_tostr_d);
        if self.had_exception or vm_has_native_exc() {
            return js_undefined();
        }
        if not jsv_is_undefined(ts_fn_d) {
            if is_fn_val(ts_fn_d) or is_native_val(ts_fn_d) or js_is_proxy(ts_fn_d) {
                ts_res_d: JSValue = _vm_invoke_callback(self, ts_fn_d, v, []);
                if self.had_exception {
                    return js_undefined();
                }
                if not _vm_is_object_like(ts_res_d) {
                    return ts_res_d;
                }
            }
        }
        # A callable whose valueOf/toString lookups did not yield a primitive falls
        # back to Function.prototype.toString source text (ES §20.2.3.5) rather than
        # a TypeError — a plain function has Object.prototype.valueOf (returns the fn,
        # an object) and Function.prototype.toString (returns source).
        if is_callable_v {
            return self._fn_to_string_value(v);
        }
        # OrdinaryToPrimitive: both valueOf and toString returned objects → TypeError.
        self.had_exception = True;
        self.pending_exc = make_type_error("Cannot convert object to primitive value");
        return js_undefined();
    }

    """Abstract Equality Comparison (==) — ECMAScript §7.2.15."""
    def _abstract_equal(a: JSValue, b: JSValue) -> bool {
        if a == b {
            return js_strict_equal(a, b);
        }
        # Two strings compare by content (§7.2.15 step 1.b). Needed because heap
        # (computed) strings are not deduped, so equal content has different ids
        # and the `a == b` fast path above misses them.
        if jsv_is_string_cell(a) and jsv_is_string_cell(b) {
            return str_from_id(jsv_to_table_id(a)) == str_from_id(jsv_to_table_id(b));
        }
        if (jsv_is_int32(a) or jsv_is_double(a))
            and (jsv_is_int32(b) or jsv_is_double(b)) {
            fa: float = float(jsv_to_int32(a)) if jsv_is_int32(a) else jsv_to_double(a);
            fb: float = float(jsv_to_int32(b)) if jsv_is_int32(b) else jsv_to_double(b);
            if not (fa == fa) {
                return False;
            }
            return fa == fb;
        }
        # BigInt loose equality (ES §7.2.15). Same-type BigInt uses content equality;
        # BigInt↔Number/String compare mathematically.
        if jsv_is_bigint_cell(a) and jsv_is_bigint_cell(b) {
            return js_bigint_cells_equal(a, b);
        }
        if jsv_is_bigint_cell(a) and (jsv_is_int32(b) or jsv_is_double(b)) {
            return _bigint_loose_eq_number(
                _bigint_str_of(a),
                float(jsv_to_int32(b)) if jsv_is_int32(b) else jsv_to_double(b)
            );
        }
        if jsv_is_bigint_cell(b) and (jsv_is_int32(a) or jsv_is_double(a)) {
            return _bigint_loose_eq_number(
                _bigint_str_of(b),
                float(jsv_to_int32(a)) if jsv_is_int32(a) else jsv_to_double(a)
            );
        }
        if jsv_is_bigint_cell(a) and jsv_is_string_cell(b) {
            eqb: str = _string_to_bigint_or_empty(str_from_id(jsv_to_table_id(b)));
            if len(eqb) == 0 {
                return False;
            }
            return _bigint_norm_dec(_bigint_str_of(a)) == _bigint_norm_dec(eqb);
        }
        if jsv_is_bigint_cell(b) and jsv_is_string_cell(a) {
            eqa: str = _string_to_bigint_or_empty(str_from_id(jsv_to_table_id(a)));
            if len(eqa) == 0 {
                return False;
            }
            return _bigint_norm_dec(_bigint_str_of(b)) == _bigint_norm_dec(eqa);
        }
        if jsv_is_null(a) and jsv_is_undefined(b) {
            return True;
        }
        if jsv_is_undefined(a) and jsv_is_null(b) {
            return True;
        }
        # Annex B [[IsHTMLDDA]]: only Abstract Equality treats this distinct
        # object as nullish. Strict/SameValue identity remains object identity.
        if jsv_is_htmldda(a) and (jsv_is_null(b) or jsv_is_undefined(b)) {
            return True;
        }
        if jsv_is_htmldda(b) and (jsv_is_null(a) or jsv_is_undefined(a)) {
            return True;
        }
        if (jsv_is_int32(a) or jsv_is_double(a)) and jsv_is_string_cell(b) {
            return self._abstract_equal(
                a, js_number(str_to_float(str_from_id(jsv_to_table_id(b))))
            );
        }
        if (jsv_is_int32(b) or jsv_is_double(b)) and jsv_is_string_cell(a) {
            return self._abstract_equal(
                js_number(str_to_float(str_from_id(jsv_to_table_id(a)))), b
            );
        }
        if jsv_is_bool(a) {
            an: float = 1.0 if jsv_to_bool(a) else 0.0;
            return self._abstract_equal(js_number(an), b);
        }
        if jsv_is_bool(b) {
            bn: float = 1.0 if jsv_to_bool(b) else 0.0;
            return self._abstract_equal(a, js_number(bn));
        }
        if jsv_is_object_cell(a)
            and not jsv_is_object_cell(b)
            and not jsv_is_null(b)
            and not jsv_is_undefined(b) {
            return self._abstract_equal(self._to_primitive_default(a), b);
        }
        if jsv_is_object_cell(b)
            and not jsv_is_object_cell(a)
            and not jsv_is_null(a)
            and not jsv_is_undefined(a) {
            return self._abstract_equal(a, self._to_primitive_default(b));
        }
        return False;
    }

    """True if v is callable (user fn, native fn, callable JSObject ctor, or callable Proxy)."""
    def _value_is_callable(v: JSValue) -> bool {
        return spec_is_callable(v);
    }

    """Function.prototype.toString for a callable VALUE, as a js string (ES §20.2.3.5).
    Inlined here (vm.na.jac cannot import builtins/function without a cycle) so
    ToString / ToPrimitive / ToPropertyKey of a function produce a consistent
    source-shaped string instead of "[object Object]".  Uses the "[native code]"
    canonical form (identity/consistency is what callers need)."""
    def _fn_to_string_value(v: JSValue) -> JSValue {
        fts_name: str = "";
        fts_bound: bool = False;
        if is_fn_val(v) {
            fts_i: int = get_fn_idx(v);
            if fts_i < len(self.realm.closures) {
                fts_name = self.realm.closures[fts_i].func.name;
                fts_bound = self.realm.closures[fts_i].func.is_bound;
                # Prefer preserved source text when available.
                fts_src: str = self.realm.closures[fts_i].func.source;
                if len(fts_src) > 0 {
                    return js_str(fts_src);
                }
            }
        } elif is_native_val(v) {
            fts_name = get_native_name(v);
        } elif jsv_is_object_cell(v)
            and jsv_to_table_id(v) > 0
            and js_object_has_own(v, WK_IS_CLASS) {
            fts_nm_v: JSValue = js_object_get(v, WK_CLASS_NAME);
            if jsv_is_string_cell(fts_nm_v) {
                fts_name = str_from_id(jsv_to_table_id(fts_nm_v));
            } elif js_object_has_own(v, WK_NAME) {
                fts_nm_v = js_object_get(v, WK_NAME);
                if jsv_is_string_cell(fts_nm_v) {
                    fts_name = str_from_id(jsv_to_table_id(fts_nm_v));
                }
            }
        } elif jsv_is_object_cell(v)
            and jsv_to_table_id(v) > 0
            and js_object_has_own(v, KEY_CTOR_KIND) {
            fts_nm_v: JSValue = js_object_get(v, str_intern("name"));
            if jsv_is_string_cell(fts_nm_v) {
                fts_name = str_from_id(jsv_to_table_id(fts_nm_v));
            }
        }
        if fts_bound or fts_name == "" or fts_name.find(" ") >= 0 {
            return js_str("function () { [native code] }");
        }
        return js_str("function " + fts_name + "() { [native code] }");
    }

    """True if v is valid RHS of instanceof (callable or user class constructor)."""
    def _value_is_instanceof_rhs(v: JSValue) -> bool {
        if self._value_is_callable(v) {
            return True;
        }
        if jsv_is_object_cell(v)
            and jsv_to_table_id(v) > 0
            and js_object_has_own(v, WK_IS_CLASS) {
            return True;
        }
        return False;
    }

    """ECMAScript OrdinaryHasInstance: walk obj's [[Prototype]] chain for targetProto."""
    def _proto_chain_has_instance(inst_val: JSValue, target_proto: JSValue) -> bool {
        if not jsv_is_object_cell(target_proto) {
            return False;
        }
        # A function VALUE stores its [[Prototype]] specially (not in an object
        # cell): a generator function → %Generator%, an async generator →
        # %AsyncGenerator%, otherwise Function.prototype.  Without seeding the walk
        # from the right base, `fn instanceof Function` was always false.
        io_cur: JSValue = js_undefined();
        if is_fn_val(inst_val) {
            pci_cl: JSClosure = self.realm.closures[get_fn_idx(inst_val)];
            if pci_cl.func.is_generator {
                if pci_cl.func.is_async {
                    io_cur = js_async_generator_get_intrinsic();
                } else {
                    io_cur = js_generator_get_intrinsic();
                }
            } else {
                io_cur = js_function_get_proto();
            }
        } elif is_native_val(inst_val) {
            io_cur = js_function_get_proto();
        } elif jsv_is_object_cell(inst_val)
            and jsv_to_table_id(inst_val) > 0
            and js_object_has_own(inst_val, KEY_CTOR_KIND) {
            # Native constructors (Function, Object, Array, …) are callable JSObjects
            # tagged with KEY_CTOR_KIND; their [[Prototype]] is Function.prototype
            # (mirrors js_Object_getPrototypeOf).  User classes use WK_IS_CLASS + a
            # real chain and are NOT KEY_CTOR_KIND-tagged, so they fall through.
            io_cur = js_function_get_proto();
        } elif js_is_proxy(inst_val) {
            # Instance itself may be a Proxy — start from trapped [[GetPrototypeOf]].
            io_cur = _vm_proxy_get_prototype_of(self, inst_val);
            if vm_has_native_exc() or self.had_exception {
                return False;
            }
        } else {
            io_cur = js_object_get_prototype(inst_val);
        }
        io_depth: int = 0;
        while io_depth < 1000 {
            if not jsv_is_object_cell(io_cur) {
                return False;
            }
            if jsv_to_table_id(io_cur) == jsv_to_table_id(target_proto) {
                return True;
            }
            # Proxy [[GetPrototypeOf]] may trap — OrdinaryHasInstance must observe it.
            if js_is_proxy(io_cur) {
                io_cur = _vm_proxy_get_prototype_of(self, io_cur);
                if vm_has_native_exc() or self.had_exception {
                    return False;
                }
            } else {
                io_cur = js_object_get_prototype(io_cur);
            }
            io_depth = io_depth + 1;
        }
        return False;
    }

    """
    ECMAScript OrdinaryHasInstance (§7.3.22) as a value-returning primitive, used
    by `Function.prototype[@@hasInstance]` (§20.2.3.6). Returns js_boolean; a
    non-object `prototype` on C raises a native exception (vm_throw_native).
      1. IsCallable(C) false → false.  2. bound target handled by the proto-chain
      seed / _get_constructor_prototype.  3. Type(V) not Object → false.
      4. P = Get(C,"prototype"); non-object → TypeError.  5. walk V's chain for P.
    """
    def _ordinary_has_instance(c_val: JSValue, v_val: JSValue) -> JSValue {
        if not self._value_is_callable(c_val) {
            return js_false();
        }
        if not jsv_is_any_object(v_val) {
            return js_false();
        }
        c_proto: JSValue = self._get_constructor_prototype(c_val);
        if vm_has_native_exc() or self.had_exception {
            return js_false();
        }
        if not jsv_is_object_cell(c_proto) {
            vm_throw_native(
                make_type_error(
                    "Function has non-object prototype 'undefined' in instanceof check"
                )
            );
            return js_false();
        }
        ohi_res: bool = self._proto_chain_has_instance(v_val, c_proto);
        if vm_has_native_exc() or self.had_exception {
            return js_false();
        }
        return js_boolean(ohi_res);
    }

    """Transfer a primitive-wrapper internal data slot from a freshly native-
    constructed wrapper `src` onto the derived instance `dst`. Boolean/Number/
    String store their [[…Data]] slot under a NEGATIVE key id (engine-internal
    sentinel), which js_object_all_keys DOES surface but the generic own-property
    copy path treats as an ordinary key — copying it would work, except the value
    can be false/0/"" whose truthiness is irrelevant. We copy it explicitly so a
    subclass instance (`class B extends Boolean {}; new B(1)`) carries the slot
    and Boolean.prototype.valueOf / Number.prototype.valueOf / String coercion
    read the wrapped primitive (ES §.OrdinaryCreateFromConstructor with the
    …Data internal slot). Returns nothing; a no-op when `src` has no such slot."""
    def _copy_primitive_wrapper_slot(src: JSValue, dst: JSValue) -> None {
        if not jsv_is_object_cell(dst) {
            return;
        }
        # `src` may be either a native-constructed WRAPPER object (js_*_new) or, when
        # the construct dispatch is the plain-call form (js_Boolean_call etc.), the
        # bare PRIMITIVE result. Handle both: a boolean/number/string primitive is
        # itself the [[…Data]] value to install.
        if jsv_is_bool(src) {
            js_object_set(dst, KEY_IS_BOOLEAN_OBJ, src);
        } elif jsv_is_int32(src) or jsv_is_double(src) {
            js_object_set(dst, KEY_IS_NUMBER_OBJ, src);
        } elif jsv_is_string_cell(src) {
            self._install_string_wrapper_slot(dst, src);
        } elif is_boolean_object(src) {
            js_object_set(dst, KEY_IS_BOOLEAN_OBJ, boolean_value_of(src));
        } elif is_number_object(src) {
            js_object_set(dst, KEY_IS_NUMBER_OBJ, number_value_of(src));
        } elif is_string_object(src) {
            self._install_string_wrapper_slot(dst, string_value_of(src));
        }
    }

    """Install the [[StringData]] slot AND the exotic own `length` property (ES
    §22.1.4.1: non-writable, non-enumerable, non-configurable, = UTF-16 length) on a
    String subclass instance, mirroring js_String_new so indexed access and `.length`
    behave like a genuine String wrapper (class/subclass/.../String/length)."""
    def _install_string_wrapper_slot(dst: JSValue, prim: JSValue) -> None {
        if not jsv_is_string_cell(prim) {
            return;
        }
        js_object_set(dst, KEY_IS_STRING_OBJ, prim);
        s_sw: str = str_from_id(jsv_to_table_id(prim));
        js_object_define_property(
            dst,
            WK_LENGTH,
            JSProperty(
                key=WK_LENGTH,
                value=js_int(js_string_utf16_len(s_sw)),
                writable=False,
                enumerable=False,
                configurable=False,
                deleted=False
            )
        );
    }

    """Resolve Constructor.prototype for instanceof (fn, native, or plain object)."""
    def _get_constructor_prototype(ctor: JSValue) -> JSValue {
        resolved: JSValue = ctor;
        if is_fn_val(resolved) {
            io_cl: JSClosure = self.realm.closures[get_fn_idx(resolved)];
            if io_cl.func.is_bound {
                while io_cl.func.is_bound and len(io_cl.free_vals) > 0 {
                    resolved = io_cl.free_vals[0];
                    if not is_fn_val(resolved) {
                        break;
                    }
                    io_cl = self.realm.closures[get_fn_idx(resolved)];
                }
            }
        }
        if is_fn_val(resolved) {
            # ES §13.10.2 OrdinaryHasInstance step 5: `Get(C, "prototype")` is OBSERVABLE —
            # a user-defined own accessor or overridden data property on the function's
            # `prototype` (e.g. `Object.defineProperty(Function.prototype,'prototype',{get})`
            # or `Function.prototype.prototype = ""`) must be honored. Consult the function
            # object's own props first (accessor-aware so a getter runs / throws); fall back
            # to the synthesized default only when no own `prototype` is defined.
            io_props: JSValue = self.realm.closures[get_fn_idx(resolved)].fn_props;
            if jsv_is_object_cell(io_props) and jsv_to_table_id(io_props) > 0 {
                # Own overridden `prototype` (data or accessor), or an INHERITED accessor
                # (defined on %Function.prototype%) — either is observable and must win over
                # the synthesized default. Accessor-aware get runs a getter (and propagates a
                # throw) and walks the chain.
                if js_object_has_own(io_props, WK_PROTOTYPE)
                    or (
                        not jsv_is_undefined(
                            js_object_lookup_getter(io_props, WK_PROTOTYPE)
                        )
                    ) {
                    return self._get_prop_accessor(io_props, WK_PROTOTYPE);
                }
            }
            return _fn_prop(resolved, WK_PROTOTYPE);
        }
        if is_native_val(resolved) {
            return _native_prop(resolved, WK_PROTOTYPE);
        }
        if jsv_is_object_cell(resolved) and jsv_to_table_id(resolved) > 0 {
            # ES §13.10.2 step 5: `Get(C,"prototype")` is observable — a `prototype` accessor
            # (own or inherited, e.g. defined on %Function.prototype% which IS an object cell
            # here) must run its getter. Use accessor-aware get, not a plain data read.
            return self._get_prop_accessor(resolved, WK_PROTOTYPE);
        }
        return js_undefined();
    }

    """
    ECMAScript InstanceofOperator for non-built-in constructors.
    Returns js_boolean result, or throws TypeError via frame unwind.
    Sets had_exception / running=False on failure when caller checks.
    """
    def _eval_instanceof_general(
        frame: CallFrame, left: JSValue, right: JSValue
    ) -> JSValue {
        hi_key: int = SYMBOL_KEY_BASE + SYMBOL_HAS_INSTANCE;
        has_inst_fn: JSValue = js_undefined();
        if is_fn_val(right) {
            has_inst_fn = _fn_prop(right, hi_key);
        } elif is_native_val(right) {
            has_inst_fn = _native_prop(right, hi_key);
        } elif jsv_is_object_cell(right) and jsv_to_table_id(right) > 0 {
            # GetMethod(right, @@hasInstance): accessor-aware so a getter runs (and a
            # throwing one propagates — test262 symbol-hasinstance-get-err), not a plain
            # js_object_get that returns undefined for an accessor.
            has_inst_fn = self._get_prop_accessor(right, hi_key);
            if vm_has_native_exc() or self.had_exception {
                exc_hg: JSValue = vm_take_native_exc()
                    if vm_has_native_exc()
                    else self.pending_exc;
                self.had_exception = False;
                self.pending_exc = js_undefined();
                if not self._unwind_in_frame(frame, exc_hg) {
                    self.had_exception = True;
                    self.pending_exc = exc_hg;
                }
                return js_false();
            }
        }
        if not jsv_is_undefined(has_inst_fn) {
            # The default %Function.prototype%[@@hasInstance] resolves here now that
            # it is a real own property. Short-circuit to the native OrdinaryHasInstance
            # (vm_call_js_fn can't invoke a native, and this is the common case).
            if is_native_val(has_inst_fn)
                and get_native_kind(has_inst_fn) == NATIVE_KIND_FN_HAS_INSTANCE {
                ohi_v: JSValue = self._ordinary_has_instance(right, left);
                if vm_has_native_exc() {
                    exc_ohi: JSValue = vm_take_native_exc();
                    if not self._unwind_in_frame(frame, exc_ohi) {
                        self.had_exception = True;
                        self.pending_exc = exc_ohi;
                    }
                    return js_false();
                }
                if self.had_exception {
                    return js_false();
                }
                return js_boolean(jsv_to_bool(ohi_v));
            }
            if self._value_is_callable(has_inst_fn) {
                hi_args: list[JSValue] = [];
                hi_args.append(left);
                hi_res: JSValue = self._invoke_callable_value(
                    has_inst_fn, right, hi_args
                );
                if self.had_exception {
                    return js_false();
                }
                if vm_has_native_exc() {
                    exc_hi: JSValue = vm_take_native_exc();
                    if not self._unwind_in_frame(frame, exc_hi) {
                        self.had_exception = True;
                        self.pending_exc = exc_hi;
                    }
                    return js_false();
                }
                # ES §13.10.2 InstanceofOperator step 5: ToBoolean(result of @@hasInstance).
                # Must be jsv_coerce_to_bool (real ToBoolean), NOT jsv_to_bool (which only
                # tests for the boolean `true` bit pattern — `return 1`/`5`/nonempty string
                # from @@hasInstance were wrongly false). test262 symbol-hasinstance-to-boolean.
                return js_boolean(jsv_coerce_to_bool(hi_res));
            }
        }
        if not self._value_is_instanceof_rhs(right) {
            exc_nc: JSValue = make_type_error(
                "Right-hand side of 'instanceof' is not callable"
            );
            if not self._unwind_in_frame(frame, exc_nc) {
                self.had_exception = True;
                self.pending_exc = exc_nc;
            }
            return js_false();
        }
        right_proto: JSValue = self._get_constructor_prototype(right);
        if not jsv_is_object_cell(right_proto) {
            exc_np: JSValue = make_type_error(
                "Function has non-object prototype 'undefined' in instanceof check"
            );
            if not self._unwind_in_frame(frame, exc_np) {
                self.had_exception = True;
                self.pending_exc = exc_np;
            }
            return js_false();
        }
        has_inst: bool = self._proto_chain_has_instance(left, right_proto);
        # Proxy [[GetPrototypeOf]] / invariant TypeErrors must unwind into the frame
        # (otherwise assert.throws cannot catch them).
        if vm_has_native_exc() {
            exc_gi: JSValue = vm_take_native_exc();
            if not self._unwind_in_frame(frame, exc_gi) {
                self.had_exception = True;
                self.pending_exc = exc_gi;
            }
            return js_false();
        }
        if self.had_exception {
            return js_false();
        }
        return js_boolean(has_inst);
    }

    """Load exports for a JS-implemented built-in (path, buffer, events, …)."""
    def _load_js_builtin_exports(bare_spec: str) -> JSValue {
        if not self._is_js_builtin(bare_spec) {
            return js_undefined();
        }
        js_path: str = self.engine_root + "/src/builtins/js/" + bare_spec + ".js";
        if self._js_builtin_cache_ready(js_path) {
            return module_get_cached(js_path);
        }
        # Always evaluate JS builtins as CJS. Nested under dynamic import() the
        # loader would otherwise promote path.js → esm-js (dynamic_import_active)
        # and throw "require is not defined in ES module scope".
        saved_esm: int = self.require_is_esm;
        saved_dia: int = self.dynamic_import_active;
        self.require_is_esm = 0;
        self.dynamic_import_active = 0;
        result: JSValue = self._require_module(bare_spec);
        self.require_is_esm = saved_esm;
        self.dynamic_import_active = saved_dia;
        return result;
    }

    """
    Helper: resolve a property on an object, checking for accessor getters first.
    If an accessor getter exists (on own or prototype chain), call it with
    this=obj and return the result.  Otherwise, fall back to js_object_get.
    """
    def _get_prop_accessor(js_obj: JSValue, key: int) -> JSValue {
        return self._get_prop_accessor_recv(js_obj, key, js_obj);
    }

    # A Module Namespace stores its exports as own data properties on a marked object,
    # so [[HasProperty]] / [[GetOwnProperty]] flow through the ordinary own-property
    # paths once _defer_ns_maybe_eval has forced evaluation.

    """Resolve a non-index property of a primitive string through String.prototype.

    ES §9.1.1.1: a property read on a primitive string behaves as though the value
    were boxed, so lookup walks String.prototype and on through Object.prototype.
    Rather than allocating a wrapper per access, the chain is walked directly —
    the observable result is the same and no garbage is produced.

    `length` and integer indices are handled by the callers before reaching here.
    Returns undefined if String.prototype is not yet installed (during bootstrap)."""
    def _string_proto_get(key: int) -> JSValue {
        sp: JSValue = js_string_get_proto();
        if jsv_is_undefined(sp) {
            return js_undefined();
        }
        # Method lookups (`str.charCodeAt`) are plain own data properties of
        # String.prototype: one ordinary chain walk, no accessor machinery or
        # String-exotic index probe (~2K instructions per lookup before).
        sp_fast: JSValue = js_object_get_ordinary(sp, key);
        if not jsv_is_hole(sp_fast) {
            return sp_fast;
        }
        return self._get_prop_accessor(sp, key);
    }

    """Read the `global` flag of a RegExp instance.

    `global` is a RegExp.prototype accessor (ES §22.2.6.6), not an own data
    property, so a raw js_object_get returns undefined. Read the compiled state
    directly — same answer as invoking the getter, without the call."""
    def _regexp_is_global(re_val: JSValue) -> bool {
        if not jsv_is_object_cell(re_val) {
            return False;
        }
        mk: JSValue = js_object_get(re_val, _KEY_IS_REGEXP);
        if not jsv_is_int32(mk) {
            return False;
        }
        ri: int = jsv_to_int32(mk);
        if ri < 0 or ri >= len(self.realm.regexps) {
            return False;
        }
        return self.realm.regexps[ri].flag_g;
    }

    """As _get_prop_accessor, but any accessor getter is invoked with `receiver`
    as its `this` value rather than `js_obj`.  For an ordinary Get, receiver ==
    js_obj; for a `super.x` reference (ES §13.3.7.1 MakeSuperPropertyReference),
    the property is looked up on the super base (js_obj) but the getter runs with
    `this` = the current method's `this` (receiver)."""
    def _get_prop_accessor_recv(
        js_obj: JSValue, key: int, receiver: JSValue
    ) -> JSValue {
        # A chain of ordinary objects with no accessor for `key` is a plain data
        # lookup: answer it in one native pass (one own lookup per level) instead
        # of the per-level exotic probes and four separate lookups below.
        if jsv_is_object_cell(js_obj) and jsv_to_table_id(js_obj) > 0 {
            go_r: JSValue = js_object_get_ordinary(js_obj, key);
            if not jsv_is_hole(go_r) {
                return go_r;
            }
        }
        # Deferred module namespace: [[Get]] of a non-symbol / non-"then" key
        # triggers synchronous evaluation (TC39 import defer).
        self._defer_ns_maybe_eval(js_obj, key, False);
        if self.had_exception or vm_has_native_exc() {
            return js_undefined();
        }
        if js_is_proxy(js_obj) {
            pres: JSValue = self._proxy_trap_get(js_obj, key, receiver);
            if self.had_exception or vm_has_native_exc() {
                return js_undefined();
            }
            return pres;
        }
        # Module Namespace Exotic [[Get]] (ES §10.4.6.8): the namespace is a real
        # marked object whose exports are stored as own data properties
        # (js_object_namespace_export_set). `_defer_ns_maybe_eval`
        # above forces evaluation of a deferred namespace, and the own-data path
        # below (with the TDZ ReferenceError) handles the read — no source-snapshot
        # indirection is needed, so there is no dedicated js_is_module_namespace
        # branch here.
        # Function / native values are callable objects whose own properties live
        # in the closure's fn_props store (not the object-cell heap), so the
        # object-cell own/proto walk below never sees them. Route through the
        # function-aware getter: an own accessor on fn_props is invoked with
        # `receiver`, otherwise _fn_prop resolves own data props, the synthesized
        # name/length/prototype/call/apply/bind/toString, and the Function.prototype
        # → Object.prototype chain (so `valueOf`/`toString` used by ToPrimitive on a
        # function with a user-assigned `fn.valueOf` resolve correctly).
        if is_fn_val(js_obj) or is_native_val(js_obj) {
            if is_fn_val(js_obj) {
                fga_idx: int = get_fn_idx(js_obj);
                if fga_idx < len(self.realm.closures) {
                    fga_fp: JSValue = self.realm.closures[fga_idx].fn_props;
                    fga_getter: JSValue = js_object_get_own_accessor_getter(
                        fga_fp, key
                    );
                    if not jsv_is_undefined(fga_getter) {
                        if is_fn_val(fga_getter) {
                            fga_cl: JSClosure = self.realm.closures[
                                get_fn_idx(fga_getter)
                            ];
                            fga_res: JSValue = self.run_cl(
                                fga_cl, fga_getter, receiver, []
                            );
                            if self.had_exception {
                                exc_fga: JSValue = self.pending_exc;
                                self.had_exception = False;
                                self.pending_exc = js_undefined();
                                vm_throw_native(exc_fga);
                                return js_undefined();
                            }
                            return fga_res;
                        }
                        if is_native_val(fga_getter) {
                            return _vm_call_native_proxy_aware(
                                self,
                                self.realm,
                                get_native_kind(fga_getter),
                                receiver,
                                [],
                                fga_getter
                            );
                        }
                    }
                    # Own accessor with [[Get]] undefined (setter-only) → undefined.
                    if js_object_has_own_accessor(fga_fp, key) {
                        return js_undefined();
                    }
                }
            }
            return _fn_prop(js_obj, key);
        }
        if self._ta_is_instance(js_obj) {
            ta_key_g: tuple[bool, int] = self._ta_key_index(key);
            if ta_key_g[0] {
                return self._ta_get_index(js_obj, ta_key_g[1]);
            }
        }
        if is_string_object(js_obj) {
            idx_val_g: JSValue = js_string_exotic_get_index(js_obj, key);
            if not jsv_is_undefined(idx_val_g) {
                return idx_val_g;
            }
        }
        # Own accessor getter.
        getter_fn: JSValue = js_object_get_own_accessor_getter(js_obj, key);
        if not jsv_is_undefined(getter_fn) {
            if is_fn_val(getter_fn) {
                g_cl: JSClosure = self.realm.closures[get_fn_idx(getter_fn)];
                # NAPI accessor getter: the closure has no bytecode (code=[]),
                # its behavior lives in a C callback. run_cl() would execute the
                # empty body and return undefined (F5), so dispatch the callback
                # here just like the CALL/method paths do.
                if g_cl.napi_cb_ptr != 0 {
                    g_napi_ret: int = _vm_invoke_napi_cb(
                        self, g_cl.napi_cb_ptr, g_cl.napi_cb_data, receiver, [], 0
                    );
                    if _napi_get_had_exception() {
                        vm_throw_native(_napi_consume_exception());
                        return js_undefined();
                    }
                    return g_napi_ret;
                }
                # Bound function: unwrap the binding chain before calling.
                # The CALL opcode handler does this for regular calls; we must
                # mirror it here for getters, otherwise run_cl() would try to
                # execute the empty "<bound>" stub and return undefined.
                if g_cl.func.is_bound {
                    gf_orig: JSValue = js_undefined();
                    if len(g_cl.free_vals) > 0 {
                        gf_orig = g_cl.free_vals[0];
                    }
                    gf_this: JSValue = g_cl.lexical_this;
                    gf_args: list[JSValue] = [];
                    gf_bi: int = 1;
                    while gf_bi < len(g_cl.free_vals) {
                        gf_args.append(g_cl.free_vals[gf_bi]);
                        gf_bi = gf_bi + 1;
                    }
                    # Unwrap nested bound layers
                    while is_fn_val(gf_orig) {
                        gf_inner: JSClosure = self.realm.closures[get_fn_idx(gf_orig)];
                        if not gf_inner.func.is_bound {
                            break;
                        }
                        gf_this = gf_inner.lexical_this;
                        gf_prepend: list[JSValue] = [];
                        gf_ii: int = 1;
                        while gf_ii < len(gf_inner.free_vals) {
                            gf_prepend.append(gf_inner.free_vals[gf_ii]);
                            gf_ii = gf_ii + 1;
                        }
                        gf_new: list[JSValue] = [];
                        for gf_p in gf_prepend {
                            gf_new.append(gf_p);
                        }
                        for gf_a in gf_args {
                            gf_new.append(gf_a);
                        }
                        gf_args = gf_new;
                        gf_orig = js_undefined();
                        if len(gf_inner.free_vals) > 0 {
                            gf_orig = gf_inner.free_vals[0];
                        }
                    }
                    if is_fn_val(gf_orig) {
                        gf_cl2: JSClosure = self.realm.closures[get_fn_idx(gf_orig)];
                        return self.run_cl(gf_cl2, gf_orig, gf_this, gf_args);
                    }
                    if is_native_val(gf_orig) {
                        gf_nk: int = get_native_kind(gf_orig);
                        return _vm_call_native_proxy_aware(
                            self, self.realm, gf_nk, gf_this, gf_args
                        );
                    }
                    return js_undefined();
                }
                g_result: JSValue = self.run_cl(g_cl, getter_fn, receiver, []);
                if self.had_exception {
                    exc_g: JSValue = self.pending_exc;
                    self.had_exception = False;
                    self.pending_exc = js_undefined();
                    vm_throw_native(exc_g);
                    return js_undefined();
                }
                return g_result;
            }
            if is_native_val(getter_fn) {
                lgk: int = get_native_kind(getter_fn);
                if lgk == NATIVE_KIND_ESM_LIVE_GET {
                    lg_val: JSValue = esm_live_getter_read(
                        esm_live_getter_id(getter_fn)
                    );
                    if js_is_module_namespace(js_obj) and js_is_tdz(lg_val) {
                        vm_throw_native(
                            make_reference_error(
                                "Cannot access '"
                                    + str_from_id(key)
                                    + "' before initialization"
                            )
                        );
                        return js_undefined();
                    }
                    return lg_val;
                }
                return _vm_call_native_proxy_aware(
                    self, self.realm, lgk, receiver, [], getter_fn
                );
            }
        }
        # Own accessor with [[Get]] undefined (setter-only or get:undefined) →
        # undefined; do not fall through to data / prototype.
        if js_object_has_own_accessor(js_obj, key) {
            return js_undefined();
        }
        # Own data property.
        if js_object_has_own(js_obj, key) {
            own_val: JSValue = js_object_get(js_obj, key);
            # Module Namespace Exotic [[Get]] → GetBindingValue(…, true): TDZ throws.
            if js_is_module_namespace(js_obj) and js_is_tdz(own_val) {
                vm_throw_native(
                    make_reference_error(
                        "Cannot access '" + str_from_id(key) + "' before initialization"
                    )
                );
                return js_undefined();
            }
            return own_val;
        }
        # OrdinaryGet: missing own property → parent.[[Get]](P, Receiver), Proxy-aware.
        parent_g: JSValue = js_object_get_prototype(js_obj);
        if jsv_is_null(parent_g) or jsv_is_undefined(parent_g) {
            return js_undefined();
        }
        if js_is_proxy(parent_g) {
            return self._proxy_trap_get(parent_g, key, receiver);
        }
        if jsv_is_object_cell(parent_g) and jsv_to_table_id(parent_g) > 0 {
            return self._get_prop_accessor_recv(parent_g, key, receiver);
        }
        return js_undefined();
    }

    """
    Helper: set a property on an object, checking for accessor setters first.
    Implements OrdinarySet (ES §10.1.9) with Proxy-aware prototype forwarding:
    when `key` is not an own property, parent.[[Set]](P, V, Receiver) is used
    (Receiver remains `js_obj` for assignment expressions).
    Returns the assigned value (for assignment expression semantics).
    """
    def _set_prop_accessor(js_obj: JSValue, key: int, val: JSValue) -> JSValue {
        _ = self._set_prop_accessor_recv(js_obj, key, val, js_obj);
        return val;
    }

    """OrdinarySet; returns True on success / False when [[Set]] rejects."""
    def _set_prop_accessor_recv(
        js_obj: JSValue, key: int, val: JSValue, receiver: JSValue
    ) -> bool {
        if _DBG_SETREC_ON {
            _vm_dbg_setrec_bump();
            if (_DBG_SETREC_COUNT % 200000) == 0 {
                _sr_dbg: str = "[DBG_SETREC] n="
                    + str(_DBG_SETREC_COUNT)
                    + " key='"
                    + str_from_id(key)
                    + "' obj_tid="
                    + str(jsv_to_table_id(js_obj))
                    + " recv_tid="
                    + str(jsv_to_table_id(receiver))
                    + "\n";
                write(2, _sr_dbg, len(_sr_dbg));
            }
        }
        if js_is_proxy(js_obj) {
            pset_ok: bool = self._proxy_trap_set(js_obj, key, val, receiver);
            if vm_has_native_exc() {
                exc_pn: JSValue = vm_take_native_exc();
                if len(self.frames) > 0 {
                    if not self._unwind_in_frame(
                        self.frames[len(self.frames) - 1], exc_pn
                    ) {
                        self.had_exception = True;
                        self.pending_exc = exc_pn;
                    }
                } else {
                    vm_throw_native(exc_pn);
                }
                return False;
            }
            if self.had_exception {
                return False;
            }
            if not pset_ok {
                set_strict: bool = False;
                if len(self.frames) > 0 {
                    set_strict = self.frames[len(self.frames) - 1].func.is_strict;
                }
                if set_strict {
                    exc_ps: JSValue = make_type_error("Proxy set trap returned false");
                    if not self._unwind_in_frame(
                        self.frames[len(self.frames) - 1], exc_ps
                    ) {
                        self.had_exception = True;
                        self.pending_exc = exc_ps;
                    }
                }
                return False;
            }
            return True;
        }
        # Module Namespace Exotic Object [[Set]] (ES §10.4.6.9): always fails.
        # Returns false; strict-mode assignment then throws a TypeError.
        if js_is_module_namespace(js_obj) {
            set_strict_mns: bool = False;
            if len(self.frames) > 0 {
                set_strict_mns = self.frames[len(self.frames) - 1].func.is_strict;
            }
            if set_strict_mns {
                exc_mns: JSValue = make_type_error(
                    "Cannot assign to read only property of module namespace object"
                );
                if len(self.frames) > 0 {
                    if not self._unwind_in_frame(
                        self.frames[len(self.frames) - 1], exc_mns
                    ) {
                        self.had_exception = True;
                        self.pending_exc = exc_mns;
                    }
                } else {
                    self.had_exception = True;
                    self.pending_exc = exc_mns;
                }
            }
            return False;
        }
        if self._ta_is_instance(js_obj) {
            ta_key_sp: tuple[bool, int] = self._ta_key_index(key);
            if ta_key_sp[0] {
                # IntegerIndexed [[Set]]: Receiver !== O → OrdinarySet (never write TA).
                ok_ta_sr: bool = self._ta_set_with_receiver(
                    js_obj, key, ta_key_sp[1], val, receiver
                );
                if vm_has_native_exc() {
                    return False;
                }
                if not ok_ta_sr {
                    set_strict_ta: bool = False;
                    if len(self.frames) > 0 {
                        set_strict_ta = self.frames[
                            len(self.frames) - 1
                        ].func.is_strict;
                    }
                    if set_strict_ta and not self.had_exception {
                        exc_ta: JSValue = make_type_error(
                            "Cannot assign to read only property"
                        );
                        if len(self.frames) > 0 {
                            if not self._unwind_in_frame(
                                self.frames[len(self.frames) - 1], exc_ta
                            ) {
                                self.had_exception = True;
                                self.pending_exc = exc_ta;
                            }
                        } else {
                            self.had_exception = True;
                            self.pending_exc = exc_ta;
                        }
                    }
                }
                return ok_ta_sr;
            }
        }
        # Own accessor setter.
        setter_fn: JSValue = js_object_get_own_accessor_setter(js_obj, key);
        if not jsv_is_undefined(setter_fn) {
            if is_fn_val(setter_fn) {
                s_cl: JSClosure = self.realm.closures[get_fn_idx(setter_fn)];
                # NAPI accessor setter: no bytecode; dispatch the C callback
                # (mirror of the getter path — run_cl would drop the write, F5).
                if s_cl.napi_cb_ptr != 0 {
                    _ = _vm_invoke_napi_cb(
                        self, s_cl.napi_cb_ptr, s_cl.napi_cb_data, receiver, [val], 0
                    );
                    if _napi_get_had_exception() {
                        vm_throw_native(_napi_consume_exception());
                        return False;
                    }
                    return True;
                }
                self.run_cl(s_cl, setter_fn, receiver, [val]);
                return not self.had_exception and not vm_has_native_exc();
            }
            if is_native_val(setter_fn) {
                _ = _vm_call_native_proxy_aware(
                    self, self.realm, get_native_kind(setter_fn), receiver, [val]
                );
                return not vm_has_native_exc();
            }
        }
        # Own accessor without [[Set]] — no-op / strict TypeError. Any own accessor
        # counts, including one whose getter is undefined too (it is still not a
        # data property; writing there used to add a stray data entry).
        if js_object_has_own_accessor(js_obj, key) {
            set_ns_strict: bool = False;
            if len(self.frames) > 0 {
                set_ns_strict = self.frames[len(self.frames) - 1].func.is_strict;
            }
            if set_ns_strict {
                exc_ns: JSValue = make_type_error(
                    "Cannot assign to read only property (no setter)"
                );
                if len(self.frames) > 0 {
                    if not self._unwind_in_frame(
                        self.frames[len(self.frames) - 1], exc_ns
                    ) {
                        self.had_exception = True;
                        self.pending_exc = exc_ns;
                    }
                } else {
                    self.had_exception = True;
                    self.pending_exc = exc_ns;
                }
            }
            return False;
        }
        # Own data property.
        if js_object_has_own(js_obj, key) {
            # When Receiver differs from O, OrdinarySetWithOwnDescriptor defines on Receiver.
            if jsv_is_object_cell(receiver)
                and not (
                    jsv_is_object_cell(js_obj)
                    and jsv_to_table_id(receiver) == jsv_to_table_id(js_obj)
                ) {
                ok_dr: bool = _vm_ordinary_set_differing_receiver(
                    self, js_obj, key, val, receiver
                );
                if vm_has_native_exc() {
                    return False;
                }
                if not ok_dr {
                    set_strict_dr: bool = False;
                    if len(self.frames) > 0 {
                        set_strict_dr = self.frames[
                            len(self.frames) - 1
                        ].func.is_strict;
                    }
                    if set_strict_dr and not self.had_exception {
                        exc_dr: JSValue = make_type_error(
                            "Cannot assign to read only property"
                        );
                        if len(self.frames) > 0 {
                            if not self._unwind_in_frame(
                                self.frames[len(self.frames) - 1], exc_dr
                            ) {
                                self.had_exception = True;
                                self.pending_exc = exc_dr;
                            }
                        } else {
                            self.had_exception = True;
                            self.pending_exc = exc_dr;
                        }
                    }
                }
                return ok_dr;
            }
            set_rc: int = js_object_set(js_obj, key, val);
            if set_rc != 0 {
                set_strict: bool = False;
                if len(self.frames) > 0 {
                    set_strict = self.frames[len(self.frames) - 1].func.is_strict;
                }
                if set_strict {
                    exc_set: JSValue = make_type_error(
                        "Cannot assign to read only property"
                    );
                    if len(self.frames) > 0 {
                        if not self._unwind_in_frame(
                            self.frames[len(self.frames) - 1], exc_set
                        ) {
                            self.had_exception = True;
                            self.pending_exc = exc_set;
                        }
                    } else {
                        self.had_exception = True;
                        self.pending_exc = exc_set;
                    }
                }
                return False;
            }
            return True;
        }
        # Missing own property → parent.[[Set]](P, V, Receiver).
        parent_s: JSValue = js_object_get_prototype(js_obj);
        if not jsv_is_null(parent_s) and not jsv_is_undefined(parent_s) {
            if js_is_proxy(parent_s)
                or (jsv_is_object_cell(parent_s) and jsv_to_table_id(parent_s) > 0) {
                return self._set_prop_accessor_recv(parent_s, key, val, receiver);
            }
        }
        # No parent: OrdinarySetWithOwnDescriptor with undefined ownDesc —
        # first Receiver.[[GetOwnProperty]](P) (TDZ exports throw), then
        # CreateDataProperty on Receiver when it is an object.
        if jsv_is_object_cell(receiver) and jsv_to_table_id(receiver) > 0 {
            if not _vm_receiver_obs_gopd(self, receiver, _vm_key_id_to_jsvalue(key)) {
                return False;
            }
            if vm_has_native_exc() {
                return False;
            }
            if js_is_proxy(receiver) {
                desc_new: JSValue = js_object_create_null();
                js_object_set(desc_new, WK_VALUE, val);
                js_object_set(desc_new, str_intern("writable"), js_boolean(True));
                js_object_set(desc_new, str_intern("enumerable"), js_boolean(True));
                js_object_set(desc_new, str_intern("configurable"), js_boolean(True));
                return proxy_trap_define_property(
                    self, receiver, _vm_key_id_to_jsvalue(key), desc_new
                );
            }
            # Module namespace exotic [[DefineOwnProperty]] / non-extensible: reject.
            if js_is_module_namespace(receiver) {
                return False;
            }
            set_rc2: int = js_object_set(receiver, key, val);
            if set_rc2 != 0 {
                set_strict2: bool = False;
                if len(self.frames) > 0 {
                    set_strict2 = self.frames[len(self.frames) - 1].func.is_strict;
                }
                if set_strict2 {
                    exc_set2: JSValue = make_type_error(
                        "Cannot assign to read only property"
                    );
                    if len(self.frames) > 0 {
                        if not self._unwind_in_frame(
                            self.frames[len(self.frames) - 1], exc_set2
                        ) {
                            self.had_exception = True;
                            self.pending_exc = exc_set2;
                        }
                    } else {
                        self.had_exception = True;
                        self.pending_exc = exc_set2;
                    }
                }
                return False;
            }
            return True;
        }
        return False;
    }

    """
    Invoke a JS closure for observable accessor dispatch.
    Propagates throws via vm_throw_native. Used by obs_get/obs_set and vm_obs.
    """
    def obs_call_js_fn(
        fn_val: JSValue, this_val: JSValue, args: list[JSValue]
    ) -> JSValue {
        if not is_fn_val(fn_val) {
            return js_undefined();
        }
        fn_idx: int = get_fn_idx(fn_val);
        if fn_idx >= len(self.realm.closures) {
            return js_undefined();
        }
        cl: JSClosure = self.realm.closures[fn_idx];
        result: JSValue = self.run_cl(cl, fn_val, this_val, args);
        if self.had_exception {
            exc_obs: JSValue = self.pending_exc;
            self.had_exception = False;
            self.pending_exc = js_undefined();
            vm_throw_native(exc_obs);
            return js_undefined();
        }
        return result;
    }

    """
    Call ANY callable (JS closure, native fn, bound/ctor-kind object, or Proxy)
    from native builtin code, bridging vm.had_exception into the native-exc
    channel. This backs js_call_observable — the re-entry path for custom
    @@match/@@replace methods and function replaceValue.
    """
    def obs_call_any(
        fn_val: JSValue, this_val: JSValue, args: list[JSValue]
    ) -> JSValue {
        result: JSValue = _vm_invoke_callback(self, fn_val, this_val, args);
        if self.had_exception {
            exc_any: JSValue = self.pending_exc;
            self.had_exception = False;
            self.pending_exc = js_undefined();
            vm_throw_native(exc_any);
            return js_undefined();
        }
        return result;
    }

    """True for JS TypedArray instances created by binary_types.js.

    The brand is an own, non-configurable property and is combined with the
    required backing-store slots so an inherited marker cannot brand an object.
    """
    def _ta_is_instance(v: JSValue) -> bool {
        return binary_is_typed_array(v);
    }

    def _ta_slot_int(v: JSValue, key: str) -> int {
        slot: JSValue = js_object_get(v, str_intern(key));
        if jsv_is_int32(slot) {
            return jsv_to_int32(slot);
        }
        if jsv_is_double(slot) {
            return int(jsv_to_double(slot));
        }
        return 0;
    }

    """Current integer-indexed length, including detached and resizable OOB rules."""
    def _ta_length(v: JSValue) -> int {
        if not self._ta_is_instance(v) {
            return 0;
        }
        return binary_view_witness(v).length;
    }

    """CanonicalNumericIndexString classification.

    Returns (is canonical numeric key, integer candidate).  Non-integral,
    negative, -0, NaN and infinities are canonical but use -1 so they are
    intercepted and rejected by IsValidIntegerIndex.
    """
    def _ta_key_index(key: int) -> tuple[bool, int] {
        if key >= SYMBOL_KEY_BASE {
            return (False, -1);
        }
        s: str = str_from_id(key);
        if s == "" {
            return (False, -1);
        }
        # Every canonical numeric string starts with a digit, '-', 'N'(aN) or
        # 'I'(nfinity). Reject the rest up front: named-property reads on Buffers /
        # typed arrays (`buf.length`, `buf.subarray`) land here, and most names
        # contain an 'e', which used to drive them through str_to_float below.
        c0: int = ord(s[0]);
        if not ((c0 >= 48 and c0 <= 57) or c0 == 45 or c0 == 78 or c0 == 73) {
            return (False, -1);
        }
        if s == "-0" or s == "NaN" or s == "Infinity" or s == "-Infinity" {
            return (True, -1);
        }
        neg: bool = str_substr(s, 0, 1) == "-";
        start: int = 1 if neg else 0;
        if start >= len(s) {
            return (False, -1);
        }
        n: int = 0;
        i: int = start;
        all_digits: bool = True;
        overflowed: bool = False;
        while i < len(s) {
            ch: str = str_substr(s, i, i + 1);
            if ch < "0" or ch > "9" {
                all_digits = False;
                break;
            }
            if not overflowed {
                n = n * 10 + (ord(ch) - 48);
                if n > 9007199254740991 {
                    overflowed = True;
                }
            }
            i = i + 1;
        }
        if all_digits {
            if (len(s) - start) > 1 and str_substr(s, start, start + 1) == "0" {
                return (False, -1);
            }
            # CanonicalNumericIndexString: SameValueString(s, ToString(ToNumber(s))).
            # Digit strings that exceed MAX_SAFE_INTEGER stringify as scientific
            # notation (e.g. "1000000000000000000000" → "1e+21") and are therefore
            # NOT canonical — treat as ordinary property keys. Avoid float parsing
            # of huge digit strings (host str_to_float can abort).
            if overflowed {
                return (False, -1);
            }
            if neg {
                return (True, -1);
            }
            return (True, n);
        }
        # Canonical decimal / scientific forms stringify identically via Number.
        # Non-canonical ("1.0", "1e0", "01") stay ordinary. Canonical non-integers
        # ("0.5", "1e-7") are intercepted and rejected by IsValidIntegerIndex.
        if "." in s or "e" in s or "E" in s {
            f: float = str_to_float(s);
            # Reject if parse failed (NaN) unless s itself is "NaN" (handled above).
            if f != f {
                return (False, -1);
            }
            # SameValueString(s, NumberToString(n)) — ES dtoa, not host str(float).
            # Critical for small decimals: NumberToString(1e-6) is "0.000001".
            if number_to_string_radix10(f) == s {
                return (True, -1);
            }
            return (False, -1);
        }
        return (False, -1);
    }

    def _ta_get_index(v: JSValue, index: int) -> JSValue {
        if index < 0 or index >= self._ta_length(v) {
            return js_undefined();
        }
        element_kind: int = binary_typed_array_element_kind(v);
        if element_kind >= 1 and element_kind <= 9 {
            return binary_typed_array_load(v, index);
        }
        read_fn: JSValue = js_object_get(v, str_intern("_readAt"));
        if not is_fn_val(read_fn) {
            return js_undefined();
        }
        return self.obs_call_js_fn(read_fn, v, [js_number(float(index))]);
    }

    """IntegerIndexedElementSet. Invalid indices, including detached/OOB, succeed.

    Hot path (kinds 1–7): obs_to_number (OrdinaryToPrimitive) then native store.
    BigInt / exotic: JS `_writeAt` for ToBigInt + immutable checks.

    IntegerIndexedElementSet: always ToNumber/ToBigInt before IsValidIntegerIndex.
    """
    def _ta_set_with_receiver(
        v: JSValue, key: int, index: int, val: JSValue, receiver: JSValue
    ) -> bool {
        if _vm_same_value(v, receiver) {
            return self._ta_set_index(v, index, val);
        }
        # ES IntegerIndexed [[Set]]: Receiver !== O and !IsValidIntegerIndex → true
        # (no TypedArraySetElement / no OrdinarySet / no value coercion).
        if index < 0 or index >= self._ta_length(v) {
            return True;
        }
        # Valid index + Receiver !== O → OrdinarySet (define on Receiver).
        recv_is_obj: bool = (
            jsv_is_object_cell(receiver)
            or is_fn_val(receiver)
            or is_native_val(receiver)
            or js_is_proxy(receiver)
        );
        if not recv_is_obj {
            return False;
        }
        key_v: JSValue = _vm_key_id_to_jsvalue(key);
        if not _vm_receiver_obs_gopd(self, receiver, key_v) {
            return False;
        }
        desc_obj: JSValue = js_object_create_null();
        js_object_set(desc_obj, WK_VALUE, val);
        js_object_set(desc_obj, str_intern("writable"), js_boolean(True));
        js_object_set(desc_obj, str_intern("enumerable"), js_boolean(True));
        js_object_set(desc_obj, str_intern("configurable"), js_boolean(True));
        if js_is_proxy(receiver) {
            return proxy_trap_define_property(self, receiver, key_v, desc_obj);
        }
        return js_Reflect_defineProperty(receiver, key_v, desc_obj);
    }

    def _ta_set_index(v: JSValue, index: int, val: JSValue) -> bool {
        if index < 0 {
            return True;
        }
        element_kind: int = binary_typed_array_element_kind(v);
        if element_kind >= 1 and element_kind <= 9 {
            # Fast path: already numeric — skip ToPrimitive entirely.
            if jsv_is_int32(val) or jsv_is_double(val) {
                if index >= self._ta_length(v) {
                    return True;
                }
                number_fast: float = 0.0;
                if jsv_is_int32(val) {
                    number_fast = float(jsv_to_int32(val));
                } else {
                    number_fast = jsv_to_double(val);
                }
                _ = binary_typed_array_store_number(v, index, number_fast);
                return not vm_has_native_exc();
            }
            # Coerce before IsValidIntegerIndex (detach / OOB / length 0).
            number_value: float = self.obs_to_number(val);
            if vm_has_native_exc() {
                return False;
            }
            if index >= self._ta_length(v) {
                return True;
            }
            _ = binary_typed_array_store_number(v, index, number_value);
            return not vm_has_native_exc();
        }
        write_fn: JSValue = js_object_get(v, str_intern("_writeAt"));
        if is_fn_val(write_fn) {
            _ = self.obs_call_js_fn(write_fn, v, [js_number(float(index)), val]);
            return not vm_has_native_exc();
        }
        return False;
    }

    def _ta_is_internal_key(key: int) -> bool {
        return (
            key == str_intern("_isTypedArrayInstance")
            or key == str_intern("_typedArrayName")
            or key == str_intern("BYTES_PER_ELEMENT")
            or key == str_intern("_getter")
            or key == str_intern("_setter")
            or key == str_intern("_ctor")
            or key == str_intern("_buffer")
            or key == str_intern("_byteOffset")
            or key == str_intern("_fixedLength")
            or key == str_intern("_length")
        );
    }

    """Virtual integer keys followed by ordinary user-defined own keys."""
    def _ta_own_keys(v: JSValue, enumerable_only: bool) -> list[int] {
        out: list[int] = [];
        length: int = self._ta_length(v);
        i: int = 0;
        while i < length {
            out.append(str_intern_index(i));
            i = i + 1;
        }
        for key in js_object_all_keys(v) {
            if self._ta_is_internal_key(key) {
                continue;
            }
            key_info: tuple[bool, int] = self._ta_key_index(key);
            if key_info[0] {
                continue;
            }
            if enumerable_only {
                prop: JSProperty = js_object_get_own_property_descriptor(v, key);
                if prop.deleted or not prop.enumerable {
                    continue;
                }
            }
            out.append(key);
        }
        return out;
    }

    """ES [[PreventExtensions]] for TypedArray exotic objects."""
    def _ta_prevent_extensions(v: JSValue) -> bool {
        if not binary_typed_array_prevent_extensions_allowed(v) {
            return False;
        }
        return js_object_prevent_extensions(v) == 0;
    }

    def _ta_own_descriptor(v: JSValue, key: int) -> JSValue {
        info: tuple[bool, int] = self._ta_key_index(key);
        if info[0] {
            idx: int = info[1];
            if idx < 0 or idx >= self._ta_length(v) {
                return js_undefined();
            }
            desc: JSValue = js_object_new_ordinary();
            js_object_set(desc, str_intern("value"), self._ta_get_index(v, idx));
            js_object_set(desc, str_intern("writable"), js_true());
            js_object_set(desc, str_intern("enumerable"), js_true());
            # ES2023 IntegerIndexedExoticObject — integer indices are configurable.
            js_object_set(desc, str_intern("configurable"), js_true());
            return desc;
        }
        return js_Object_getOwnPropertyDescriptor(v, _vm_key_id_to_jsvalue(key));
    }

    """
    IntegerIndexedExoticObject [[DefineOwnProperty]] (ES §10.4.5.4 / ES2023).
    Canonical numeric indices reject accessor / non-enumerable / non-writable /
    configurable:false descriptors; [[Value]] updates go through IntegerIndexedElementSet.
    """
    def _ta_define_own_property(v: JSValue, key: int, descriptor: JSValue) -> bool {
        info: tuple[bool, int] = self._ta_key_index(key);
        if not info[0] {
            return js_Reflect_defineProperty(v, _vm_key_id_to_jsvalue(key), descriptor);
        }
        idx: int = info[1];
        # Invalid integer indices (non-integral, negative, OOB) must not become
        # ordinary own properties — ES §10.4.5.4 step 3 returns false.
        if idx < 0 or idx >= self._ta_length(v) {
            return False;
        }
        if not jsv_is_object_cell(descriptor) {
            return False;
        }
        gk: int = str_intern("get");
        sk: int = str_intern("set");
        if js_object_has(descriptor, gk) or js_object_has(descriptor, sk) {
            return False;
        }
        ck: int = str_intern("configurable");
        ek: int = str_intern("enumerable");
        wk: int = str_intern("writable");
        # ES2023: reject configurable:false; allow configurable:true (or omitted).
        if js_object_has(descriptor, ck) {
            if not jsv_coerce_to_bool(
                js_object_get_observable(descriptor, ck, descriptor)
            ) {
                return False;
            }
            if vm_has_native_exc() {
                return False;
            }
        }
        if js_object_has(descriptor, ek) {
            if not jsv_coerce_to_bool(
                js_object_get_observable(descriptor, ek, descriptor)
            ) {
                return False;
            }
            if vm_has_native_exc() {
                return False;
            }
        }
        if js_object_has(descriptor, wk) {
            if not jsv_coerce_to_bool(
                js_object_get_observable(descriptor, wk, descriptor)
            ) {
                return False;
            }
            if vm_has_native_exc() {
                return False;
            }
        }
        vk: int = str_intern("value");
        if js_object_has(descriptor, vk) {
            val: JSValue = js_object_get_observable(descriptor, vk, descriptor);
            if vm_has_native_exc() {
                return False;
            }
            return self._ta_set_index(v, idx, val);
        }
        return True;
    }

    """
    Observable [[Get]] for native builtins.
    Canonical accessor/proxy-aware get used by the native-call handle path.
    """
    def obs_get(jsobj: JSValue, key: int, receiver: JSValue) -> JSValue {
        if jsv_is_undefined(receiver) {
            receiver = jsobj;
        }
        if js_is_proxy(jsobj) {
            pres: JSValue = self._proxy_trap_get(jsobj, key, receiver);
            if self.had_exception {
                exc_p: JSValue = self.pending_exc;
                self.had_exception = False;
                self.pending_exc = js_undefined();
                vm_throw_native(exc_p);
                return js_undefined();
            }
            if vm_has_native_exc() {
                return js_undefined();
            }
            return pres;
        }
        if is_fn_val(jsobj) {
            return _fn_prop(jsobj, key);
        }
        if is_native_val(jsobj) {
            return _native_prop(jsobj, key);
        }
        # STRING primitive: route through String.prototype (GetV boxing) with the
        # primitive as receiver — same gap class as the BigInt branch below. Without
        # this, obs_get(string, @@iterator) returned undefined, so `new Set("abc")`
        # (and any builtin doing an observable method lookup on a string) reported
        # "object is not iterable". Own `length`/index properties are not resolved
        # here (unchanged — no obs_get caller relies on them).
        if jsv_is_string_cell(jsobj) {
            obg_sp: JSValue = js_string_get_proto();
            if jsv_is_object_cell(obg_sp) and jsv_to_table_id(obg_sp) > 0 {
                return self._get_prop_accessor_recv(obg_sp, key, receiver);
            }
            return js_undefined();
        }
        # BigInt primitive: route through BigInt.prototype (GetV boxing) with
        # the primitive as receiver, so native builtins that Invoke element
        # methods (Array.prototype.toLocaleString, Object.prototype
        # .toLocaleString, …) resolve toString/valueOf/toLocaleString the same
        # way the GET_PROP opcode's jsv_is_bigint_cell branch does. Without
        # this, _vm_lookup_method(bigint, …) returned undefined — a gap masked
        # for weeks by stale .jsbc (the loader does not validate source_hash)
        # and exposed by the v10 regeneration (2026-08-25).
        if jsv_is_bigint_cell(jsobj) {
            obg_bp: JSValue = js_bigint_get_proto();
            if jsv_is_object_cell(obg_bp) and jsv_to_table_id(obg_bp) > 0 {
                return self._get_prop_accessor_recv(obg_bp, key, receiver);
            }
            return js_undefined();
        }
        # Shared OrdinaryGet (own + Proxy-aware prototype walk).
        return self._get_prop_accessor_recv(jsobj, key, receiver);
    }

    """
    Observable [[Set]] for native builtins.
    """
    def obs_set(jsobj: JSValue, key: int, val: JSValue, receiver: JSValue) -> bool {
        if jsv_is_undefined(receiver) {
            receiver = jsobj;
        }
        if js_is_proxy(jsobj) {
            ok_p: bool = self._proxy_trap_set(jsobj, key, val, receiver);
            if self.had_exception {
                exc_ps: JSValue = self.pending_exc;
                self.had_exception = False;
                self.pending_exc = js_undefined();
                vm_throw_native(exc_ps);
                return False;
            }
            if vm_has_native_exc() {
                return False;
            }
            return ok_p;
        }
        if js_is_module_namespace(jsobj) {
            return False;
        }
        if is_fn_val(jsobj) {
            fn_idx_sv: int = get_fn_idx(jsobj);
            if fn_idx_sv < len(self.realm.closures) {
                cl_sv: JSClosure = self.realm.closures[fn_idx_sv];
                if key == WK_PROTOTYPE {
                    # OrdinarySet on a non-writable `prototype` fails (ES §10.2.4) —
                    # return False so the caller throws in strict mode.
                    if not cl_sv.prototype_writable {
                        return False;
                    }
                    cl_sv.prototype_obj = val;
                } else {
                    js_object_set(cl_sv.fn_props, key, val);
                }
            }
            return True;
        }
        if self._ta_is_instance(jsobj) {
            ta_key_s: tuple[bool, int] = self._ta_key_index(key);
            if ta_key_s[0] {
                return self._ta_set_with_receiver(
                    jsobj, key, ta_key_s[1], val, receiver
                );
            }
        }
        if is_string_object(jsobj) and js_string_exotic_has_index(jsobj, key) {
            return False;
        }
        # Array exotic [[Set]] for "length" / indices on the target itself.
        if js_is_array(jsobj) and key == WK_LENGTH {
            len_desc_os: JSProperty = js_object_get_own_property_descriptor(
                jsobj, WK_LENGTH
            );
            if len_desc_os.key != 0 and not len_desc_os.writable {
                return False;
            }
            rc_os: int = js_array_set_length_via_set(jsobj, val);
            if vm_has_native_exc() {
                return False;
            }
            return rc_os == 0;
        }
        if js_is_array(jsobj) {
            idx_os: int = _array_index_key_numeric(key);
            if idx_os >= 0 and js_object_has_own(jsobj, key) {
                # Own accessor at index — Invoke [[Set]] (sort precise-getter tests).
                own_g: JSValue = js_object_get_own_accessor_getter(jsobj, key);
                own_s: JSValue = js_object_get_own_accessor_setter(jsobj, key);
                if not jsv_is_undefined(own_g) or not jsv_is_undefined(own_s) {
                    return self._set_prop_accessor_recv(jsobj, key, val, receiver);
                }
                if not _array_index_write_allowed(jsobj, idx_os) {
                    return False;
                }
                ok_os: bool = js_object_set(jsobj, key, val) == 0;
                if ok_os {
                    _array_grow_length_if_needed(jsobj, idx_os);
                }
                return ok_os;
            }
        }
        # OrdinarySet with Proxy-aware prototype forwarding.
        return self._set_prop_accessor_recv(jsobj, key, val, receiver);
    }

    """
    Observable [[HasProperty]] for native builtins.
    Includes Proxy has traps, function fn_props, and own accessor properties.
    """
    def obs_has(jsobj: JSValue, key: int) -> bool {
        # Deferred module namespace: [[HasProperty]] of a non-symbol / non-"then"
        # key triggers evaluation (TC39 import defer).
        self._defer_ns_maybe_eval(jsobj, key, False);
        if self.had_exception or vm_has_native_exc() {
            return False;
        }
        if js_is_proxy(jsobj) {
            has_p: bool = proxy_trap_has(self, jsobj, key);
            if vm_has_native_exc() {
                return False;
            }
            return has_p;
        }
        if is_fn_val(jsobj) {
            # Intrinsic own keys + user fn_props, then Function.prototype chain.
            # name/length are always own; `prototype` is own ONLY for constructable
            # functions — arrows and concise methods have no `prototype` (§10.2.2 /
            # §15.3), so gate it on the actual value to match _fn_has_own_key and the
            # GET path. (Returning True unconditionally made `'prototype' in method`
            # true, failing class/definition/methods.js which requires false.)
            if key == WK_NAME or key == WK_LENGTH {
                return True;
            }
            if key == WK_PROTOTYPE {
                return not jsv_is_undefined(_fn_prop(jsobj, WK_PROTOTYPE));
            }
            fn_idx_h: int = get_fn_idx(jsobj);
            if fn_idx_h >= 0 and fn_idx_h < len(self.realm.closures) {
                fp: JSValue = self.realm.closures[fn_idx_h].fn_props;
                if js_object_has_own(fp, key) {
                    return True;
                }
            }
            fp_proto_h: JSValue = js_function_get_proto();
            if jsv_is_object_cell(fp_proto_h) and jsv_to_table_id(fp_proto_h) > 0 {
                return self.obs_has(fp_proto_h, key);
            }
            return False;
        }
        if self._ta_is_instance(jsobj) {
            ta_key_h: tuple[bool, int] = self._ta_key_index(key);
            if ta_key_h[0] {
                return ta_key_h[1] >= 0 and ta_key_h[1] < self._ta_length(jsobj);
            }
        }
        # Array indices: holes are not [[HasProperty]] (own or inherited by default).
        if js_is_array(jsobj) {
            aidx_h: int = _array_index_key_numeric(key);
            if aidx_h >= 0 {
                if js_object_has_own(jsobj, key) {
                    return True;
                }
                # Fall through to prototype walk for inherited index properties.
            }
        }
        if is_string_object(jsobj) and js_string_exotic_has_index(jsobj, key) {
            return True;
        }
        if js_object_has_own(jsobj, key) {
            return True;
        }
        if not jsv_is_undefined(js_object_get_own_accessor_getter(jsobj, key)) {
            return True;
        }
        if not jsv_is_undefined(js_object_get_own_accessor_setter(jsobj, key)) {
            return True;
        }
        proto: JSValue = js_object_get_prototype(jsobj);
        if jsv_is_null(proto) or jsv_is_undefined(proto) {
            return False;
        }
        return self.obs_has(proto, key);
    }

    """
    Observable [[Delete]] for native builtins.
    Routes Proxy deleteProperty traps and propagates abrupt completions.
    """
    def obs_delete(jsobj: JSValue, key: int) -> bool {
        # Deferred module namespace: [[Delete]] of a non-symbol / non-"then" key
        # triggers evaluation (TC39 import defer).
        self._defer_ns_maybe_eval(jsobj, key, False);
        if self.had_exception or vm_has_native_exc() {
            return False;
        }
        if js_is_module_namespace(jsobj) {
            if key >= SYMBOL_KEY_BASE {
                return js_object_delete(jsobj, key);
            }
            # Export bindings may be data properties or live-getter accessors
            # (REEXPORT_LIVE / REEXPORT_STAR).  Either form is an [[Exports]] name.
            if (
                js_object_has_own(jsobj, key) or js_object_has_own_accessor(jsobj, key)
            ) {
                return False;
            }
            return True;
        }
        if js_is_proxy(jsobj) {
            ok_d: bool = proxy_trap_delete(self, jsobj, key);
            if self.had_exception {
                exc_d: JSValue = self.pending_exc;
                self.had_exception = False;
                self.pending_exc = js_undefined();
                vm_throw_native(exc_d);
                return False;
            }
            if vm_has_native_exc() {
                return False;
            }
            return ok_d;
        }
        if is_fn_val(jsobj) {
            # Function exotic: name/length are configurable; prototype is not.
            fn_idx_d: int = get_fn_idx(jsobj);
            if key == WK_NAME or key == WK_LENGTH {
                if fn_idx_d >= 0 and fn_idx_d < len(self.realm.closures) {
                    fn_cl_d: JSClosure = self.realm.closures[fn_idx_d];
                    if key == WK_NAME {
                        fn_cl_d.name_removed = True;
                    } else {
                        fn_cl_d.length_removed = True;
                    }
                    return True;
                }
                return False;
            }
            if key == WK_PROTOTYPE {
                return False;
            }
            if fn_idx_d >= 0 and fn_idx_d < len(self.realm.closures) {
                fn_fp_d: JSValue = self.realm.closures[fn_idx_d].fn_props;
                if jsv_is_object_cell(fn_fp_d) and jsv_to_table_id(fn_fp_d) > 0 {
                    return js_object_delete(fn_fp_d, key);
                }
            }
            return True;
        }
        if is_native_val(jsobj) {
            return native_delete_own(jsobj, key);
        }
        if self._ta_is_instance(jsobj) {
            ta_key_d: tuple[bool, int] = self._ta_key_index(key);
            if ta_key_d[0] {
                return not (ta_key_d[1] >= 0 and ta_key_d[1] < self._ta_length(jsobj));
            }
        }
        if is_string_object(jsobj) and js_string_exotic_has_index(jsobj, key) {
            return False;
        }
        return js_object_delete(jsobj, key);
    }

    """
    Observable ToNumber for native builtins (OrdinaryToPrimitive number hint).
    Calls valueOf then toString so throws propagate via vm_throw_native.
    """
    def obs_to_number(v: JSValue) -> float {
        a_tn: JSValue = v;
        if jsv_is_object_cell(a_tn) {
            # ECMAScript §7.1.1: [Symbol.toPrimitive]("number") before OrdinaryToPrimitive.
            # Accessor-aware get so a @@toPrimitive getter's side effect fires.
            tp_fn: JSValue = self._get_prop_accessor(
                a_tn, SYMBOL_KEY_BASE + SYMBOL_TO_PRIMITIVE
            );
            if vm_has_native_exc() {
                return 0.0;
            }
            if not jsv_is_undefined(tp_fn) and not jsv_is_null(tp_fn) {
                if is_fn_val(tp_fn) {
                    tp_res: JSValue = self.obs_call_js_fn(
                        tp_fn, a_tn, [js_str("number")]
                    );
                    if vm_has_native_exc() {
                        return 0.0;
                    }
                    if jsv_is_object_cell(tp_res) {
                        vm_throw_native(
                            make_type_error("Cannot convert object to primitive value")
                        );
                        return 0.0;
                    }
                    a_tn = tp_res;
                } elif is_native_val(tp_fn) {
                    tp_nat: JSValue = _vm_call_native_proxy_aware(
                        self,
                        self.realm,
                        get_native_kind(tp_fn),
                        a_tn,
                        [js_str("number")]
                    );
                    if vm_has_native_exc() {
                        return 0.0;
                    }
                    if jsv_is_object_cell(tp_nat) {
                        vm_throw_native(
                            make_type_error("Cannot convert object to primitive value")
                        );
                        return 0.0;
                    }
                    a_tn = tp_nat;
                } else {
                    # @@toPrimitive present but not callable → TypeError (ES GetMethod).
                    vm_throw_native(
                        make_type_error("Cannot convert object to primitive value")
                    );
                    return 0.0;
                }
            } else {
                # OrdinaryToPrimitive hint "number": valueOf, then toString.
                vo_fn: JSValue = self._get_prop_accessor(a_tn, WK_VALUEOF);
                if vm_has_native_exc() {
                    return 0.0;
                }
                if not jsv_is_undefined(vo_fn) and is_fn_val(vo_fn) {
                    vo_res: JSValue = self.obs_call_js_fn(vo_fn, a_tn, []);
                    if vm_has_native_exc() {
                        return 0.0;
                    }
                    if not jsv_is_object_cell(vo_res) {
                        a_tn = vo_res;
                    }
                } elif not jsv_is_undefined(vo_fn) and is_native_val(vo_fn) {
                    vo_nat: JSValue = _vm_call_native_proxy_aware(
                        self, self.realm, get_native_kind(vo_fn), a_tn, []
                    );
                    if vm_has_native_exc() {
                        return 0.0;
                    }
                    if not jsv_is_object_cell(vo_nat) {
                        a_tn = vo_nat;
                    }
                }
                if jsv_is_object_cell(a_tn) {
                    ts_fn: JSValue = self._get_prop_accessor(a_tn, WK_TOSTRING);
                    if vm_has_native_exc() {
                        return 0.0;
                    }
                    if not jsv_is_undefined(ts_fn) and is_fn_val(ts_fn) {
                        ts_res: JSValue = self.obs_call_js_fn(ts_fn, a_tn, []);
                        if vm_has_native_exc() {
                            return 0.0;
                        }
                        if not jsv_is_object_cell(ts_res) {
                            a_tn = ts_res;
                        }
                    } elif not jsv_is_undefined(ts_fn) and is_native_val(ts_fn) {
                        ts_nat: JSValue = _vm_call_native_proxy_aware(
                            self, self.realm, get_native_kind(ts_fn), a_tn, []
                        );
                        if vm_has_native_exc() {
                            return 0.0;
                        }
                        if not jsv_is_object_cell(ts_nat) {
                            a_tn = ts_nat;
                        }
                    }
                }
                if jsv_is_object_cell(a_tn) {
                    vm_throw_native(
                        make_type_error("Cannot convert object to primitive value")
                    );
                    return 0.0;
                }
            }
        }
        if jsv_is_symbol(a_tn) {
            vm_throw_native(
                make_type_error("Cannot convert a Symbol value to a number")
            );
            return 0.0;
        }
        if jsv_is_bigint_cell(a_tn) {
            vm_throw_native(
                make_type_error("Cannot convert a BigInt value to a number")
            );
            return 0.0;
        }
        return js_to_num(a_tn);
    }

    """
    Observable ToPrimitive(input, hint) — ECMAScript §7.1.1. hint: 0 default,
    1 string, 2 number. Invokes @@toPrimitive with the matching hint string, else
    OrdinaryToPrimitive with the hint's method order (string: toString→valueOf;
    default/number: valueOf→toString). Primitives pass through. Abrupt completions
    propagate via the native-exception channel (vm_has_native_exc).
    """
    def obs_to_primitive(v: JSValue, hint: int) -> JSValue {
        if not jsv_is_object_cell(v) {
            return v;
        }
        hint_str: str = "default";
        if hint == 1 {
            hint_str = "string";
        } elif hint == 2 {
            hint_str = "number";
        }
        # §7.1.1.1 / GetMethod: @@toPrimitive takes precedence. Use the accessor-
        # aware getter so a poisoned @@toPrimitive getter's throw propagates.
        tp_fn: JSValue = self._get_prop_accessor(
            v, SYMBOL_KEY_BASE + SYMBOL_TO_PRIMITIVE
        );
        if vm_has_native_exc() {
            return js_undefined();
        }
        if not jsv_is_undefined(tp_fn) and not jsv_is_null(tp_fn) {
            tp_res: JSValue = js_undefined();
            if is_fn_val(tp_fn) {
                tp_res = self.obs_call_js_fn(tp_fn, v, [js_str(hint_str)]);
            } elif is_native_val(tp_fn) {
                tp_res = _vm_call_native_proxy_aware(
                    self, self.realm, get_native_kind(tp_fn), v, [js_str(hint_str)]
                );
            } else {
                vm_throw_native(
                    make_type_error("Cannot convert object to primitive value")
                );
                return js_undefined();
            }
            if vm_has_native_exc() {
                return js_undefined();
            }
            if jsv_is_object_cell(tp_res) and not jsv_is_symbol(tp_res) {
                vm_throw_native(
                    make_type_error("Cannot convert object to primitive value")
                );
                return js_undefined();
            }
            return tp_res;
        }
        # OrdinaryToPrimitive: method order depends on the hint. "string" tries
        # toString first; "default"/"number" try valueOf first.
        m1: int = WK_VALUEOF;
        m2: int = WK_TOSTRING;
        if hint == 1 {
            m1 = WK_TOSTRING;
            m2 = WK_VALUEOF;
        }
        i_otp: int = 0;
        while i_otp < 2 {
            mkey: int = m1;
            if i_otp == 1 {
                mkey = m2;
            }
            mfn: JSValue = self._get_prop_accessor(v, mkey);
            if vm_has_native_exc() {
                return js_undefined();
            }
            if not jsv_is_undefined(mfn) {
                mres: JSValue = js_undefined();
                if is_fn_val(mfn) {
                    mres = self.obs_call_js_fn(mfn, v, []);
                } elif is_native_val(mfn) {
                    mres = _vm_call_native_proxy_aware(
                        self, self.realm, get_native_kind(mfn), v, []
                    );
                } elif js_is_proxy(mfn) {
                    mres = _vm_invoke_callback(self, mfn, v, []);
                } else {
                    i_otp = i_otp + 1;
                    continue;
                }
                if vm_has_native_exc() {
                    return js_undefined();
                }
                if not jsv_is_object_cell(mres) {
                    return mres;
                }
            }
            i_otp = i_otp + 1;
        }
        vm_throw_native(make_type_error("Cannot convert object to primitive value"));
        return js_undefined();
    }

    """
    Observable ToBigInt for BigInt(value) / ToBigInt — §21.2.1.1 / §7.1.13.
    Objects: ToPrimitive(hint default) via @@toPrimitive → valueOf → toString,
    then NumberToBigInt / ToBigInt on the primitive. Abrupt completions via
    vm_throw_native. §7.1.13 ToBigInt uses hint "default"; allow_number distinguishes
    BigInt(number) (True) from plain ToBigInt (False, rejects Number).
    """
    def obs_to_bigint(v: JSValue, allow_number: bool = False) -> JSValue {
        a_tb: JSValue = v;
        if jsv_is_object_cell(a_tb) {
            if jsv_is_bigint_cell(a_tb) {
                return js_bigint_from_primitive(a_tb, allow_number);
            }
            tp_fn_b: JSValue = js_object_get(
                a_tb, SYMBOL_KEY_BASE + SYMBOL_TO_PRIMITIVE
            );
            if not jsv_is_undefined(tp_fn_b) {
                if is_fn_val(tp_fn_b) {
                    # ToBigInt uses @@toPrimitive hint "default".
                    tp_res_b: JSValue = self.obs_call_js_fn(
                        tp_fn_b, a_tb, [js_str("default")]
                    );
                    if vm_has_native_exc() {
                        return js_bigint_from_decimal_str("0");
                    }
                    if jsv_is_object_cell(tp_res_b) {
                        vm_throw_native(
                            make_type_error("Cannot convert object to primitive value")
                        );
                        return js_bigint_from_decimal_str("0");
                    }
                    a_tb = tp_res_b;
                } elif is_native_val(tp_fn_b) {
                    tp_nat_b: JSValue = _vm_call_native_proxy_aware(
                        self,
                        self.realm,
                        get_native_kind(tp_fn_b),
                        a_tb,
                        [js_str("default")]
                    );
                    if vm_has_native_exc() {
                        return js_bigint_from_decimal_str("0");
                    }
                    if jsv_is_object_cell(tp_nat_b) {
                        vm_throw_native(
                            make_type_error("Cannot convert object to primitive value")
                        );
                        return js_bigint_from_decimal_str("0");
                    }
                    a_tb = tp_nat_b;
                } else {
                    vm_throw_native(
                        make_type_error("Cannot convert object to primitive value")
                    );
                    return js_bigint_from_decimal_str("0");
                }
            } else {
                # OrdinaryToPrimitive hint "number": valueOf, then toString.
                vo_fn_b: JSValue = self._get_prop_accessor(a_tb, WK_VALUEOF);
                if vm_has_native_exc() {
                    return js_bigint_from_decimal_str("0");
                }
                if not jsv_is_undefined(vo_fn_b) and is_fn_val(vo_fn_b) {
                    vo_res_b: JSValue = self.obs_call_js_fn(vo_fn_b, a_tb, []);
                    if vm_has_native_exc() {
                        return js_bigint_from_decimal_str("0");
                    }
                    if not jsv_is_object_cell(vo_res_b) {
                        a_tb = vo_res_b;
                    }
                } elif not jsv_is_undefined(vo_fn_b) and is_native_val(vo_fn_b) {
                    vo_nat_b: JSValue = _vm_call_native_proxy_aware(
                        self, self.realm, get_native_kind(vo_fn_b), a_tb, []
                    );
                    if vm_has_native_exc() {
                        return js_bigint_from_decimal_str("0");
                    }
                    if not jsv_is_object_cell(vo_nat_b) {
                        a_tb = vo_nat_b;
                    }
                }
                if jsv_is_object_cell(a_tb) {
                    ts_fn_b: JSValue = self._get_prop_accessor(a_tb, WK_TOSTRING);
                    if vm_has_native_exc() {
                        return js_bigint_from_decimal_str("0");
                    }
                    if not jsv_is_undefined(ts_fn_b) and is_fn_val(ts_fn_b) {
                        ts_res_b: JSValue = self.obs_call_js_fn(ts_fn_b, a_tb, []);
                        if vm_has_native_exc() {
                            return js_bigint_from_decimal_str("0");
                        }
                        if not jsv_is_object_cell(ts_res_b) {
                            a_tb = ts_res_b;
                        }
                    } elif not jsv_is_undefined(ts_fn_b) and is_native_val(ts_fn_b) {
                        ts_nat_b: JSValue = _vm_call_native_proxy_aware(
                            self, self.realm, get_native_kind(ts_fn_b), a_tb, []
                        );
                        if vm_has_native_exc() {
                            return js_bigint_from_decimal_str("0");
                        }
                        if not jsv_is_object_cell(ts_nat_b) {
                            a_tb = ts_nat_b;
                        }
                    }
                }
                if jsv_is_object_cell(a_tb) {
                    vm_throw_native(
                        make_type_error("Cannot convert object to primitive value")
                    );
                    return js_bigint_from_decimal_str("0");
                }
            }
        }
        return js_bigint_from_primitive(a_tb, allow_number);
    }

    """
    Observable ToPropertyKey for Reflect.get/set/deleteProperty — §7.1.19.
    Runs Symbol.toPrimitive("string") / toString / valueOf and propagates
    abrupt completions via vm_throw_native (no CallFrame available).
    """
    def obs_to_property_key(v: JSValue) -> int {
        if jsv_is_symbol(v) {
            return SYMBOL_KEY_BASE + jsv_to_table_id(v);
        }
        if is_fn_val(v) or is_native_val(v) {
            fpk_s: JSValue = self._fn_to_string_value(v);
            return str_intern(jsval_to_str(fpk_s));
        }
        if not jsv_is_object_cell(v) {
            return str_intern(jsval_to_str(v));
        }
        prim_pk: JSValue = self._to_primitive_string(v);
        if self.had_exception {
            exc_pk: JSValue = self.pending_exc;
            self.had_exception = False;
            self.pending_exc = js_undefined();
            vm_throw_native(exc_pk);
            return 0;
        }
        if vm_has_native_exc() {
            return 0;
        }
        if jsv_is_symbol(prim_pk) {
            return SYMBOL_KEY_BASE + jsv_to_table_id(prim_pk);
        }
        return str_intern(jsval_to_str(prim_pk));
    }

    """
    Run a user closure, switching self.module_fns to the closure's own fn list.
    This ensures that MAKE_FUNCTION/MAKE_ARROW opcodes inside the closure look up
    inner functions from the right compilation unit (not the caller's module).

    Without this, closures created in module A (e.g. require('events').once) would
    execute with the user script's module_fns, making MAKE_FUNCTION indices wrong
    and causing 'list index out of range' panics.
    """
    # Call a JS closure value like the CALL opcode does — async-aware.
    # run_cl executes an async function's body directly: at the first AWAIT it
    # suspends and run_cl returns undefined, so a caller that treats that as the
    # return value fulfills downstream promises with undefined and the resumed
    # body's result is lost.  This mirrors the CALL opcode's async wrapper
    # (pre-create the outer promise, set _cur_async_promise, adopt the result)
    # so promise reactions can invoke `async` handlers correctly.  For non-async
    # closures it is exactly run_cl (exceptions stay on self.had_exception; for
    # async closures a throw before the first await REJECTS the returned promise
    # and had_exception is consumed).
    def _call_closure_async_aware(
        fn_val: JSValue, this_v: JSValue, args: list[JSValue]
    ) -> JSValue {
        caa_cl: JSClosure = self.realm.closures[get_fn_idx(fn_val)];
        if not caa_cl.func.is_async or caa_cl.func.is_generator {
            return self.run_cl(caa_cl, fn_val, this_v, args);
        }
        caa_old_cap: JSValue = self._cur_async_promise;
        caa_cap: JSValue = js_promise_create();
        caa_gtr: int = len(self.realm.gc_temp_roots);
        self.realm.gc_temp_roots.append(caa_cap);
        self._cur_async_promise = caa_cap;
        caa_res: JSValue = self.run_cl(caa_cl, fn_val, this_v, args);
        self._cur_async_promise = caa_old_cap;
        caa_n: int = len(self.realm.gc_temp_roots);
        while caa_n > caa_gtr {
            caa_n = caa_n - 1;
            del self.realm.gc_temp_roots[caa_n];
        }
        if self.vm_awaiting {
            self.vm_awaiting = False;
            return caa_cap;
        }
        if self.had_exception {
            caa_exc: JSValue = self.pending_exc;
            self.had_exception = False;
            self.pending_exc = js_undefined();
            self._promise_settle_and_drain(caa_cap, PROMISE_REJECTED, caa_exc);
            return caa_cap;
        }
        if js_is_promise(caa_res) {
            caa_st: int = js_promise_get_state(caa_res);
            if caa_st != PROMISE_PENDING {
                self._promise_settle_and_drain(
                    caa_cap, caa_st, js_promise_get_value(caa_res)
                );
            } else {
                js_promise_add_reaction(
                    caa_res, js_undefined(), js_undefined(), caa_cap
                );
            }
        } else {
            self._promise_settle_and_drain(caa_cap, PROMISE_FULFILLED, caa_res);
        }
        return caa_cap;
    }

    def run_cl(
        closure: JSClosure, cl_val: JSValue, this_val: JSValue, args: list[JSValue]
    ) -> JSValue {
        saved_mf: list[CompiledFunction] = self.module_fns;
        if len(closure.module_fns) > 0 {
            self.module_fns = closure.module_fns;
        }
        # Arrow functions capture `this` lexically at definition time (MAKE_ARROW).
        # When lexical_this is set, it takes precedence over the caller-provided this_val.
        effective_this: JSValue = this_val;
        if not jsv_is_undefined(closure.lexical_this) {
            effective_this = closure.lexical_this;
        } elif not closure.func.is_strict {
            # §10.2.1.2 OrdinaryCallBindThis (non-strict): null/undefined → globalThis,
            # otherwise ToObject(thisArg) — a primitive `this` is boxed to its wrapper
            # (so `f.call(1)` / `f.call("x")` gives the function an object receiver).
            if jsv_is_null(effective_this) or jsv_is_undefined(effective_this) {
                # §10.2.1.2: undefined/null → the callee realm's globalThis.
                # _sloppy_this_for honours a module/sandbox function's own ctx_global
                # (falling back to realm.global_this).
                effective_this = self._sloppy_this_for(closure.func);
            } elif not jsv_is_any_object(effective_this) {
                # §10.2.1.2: a primitive thisArg is boxed via ToObject so
                # f.call(1) / f.call("x") give the callee an object receiver.
                effective_this = _to_object_or_throw(effective_this);
            }
        }
        # Arrows also inherit `new.target` lexically (override any caller-set channel).
        if closure.is_arrow {
            self.pending_new_target = closure.lexical_new_target;
        }
        saved_mod_g: JSValue = js_undefined();
        saved_exp_g: JSValue = js_undefined();
        use_mod_ctx: bool = False;
        jm: JSValue = _fn_jac_module(cl_val, self.realm);
        if jsv_is_object_cell(jm)
            and jm == self._reg_cur_module()
            and self._reg_cur_exports() == _vm_module_exports(jm) {
            # (the swap would write the values already there)
            jm = js_undefined();
        }
        if jsv_is_object_cell(jm) {
            if "module" in self.globals {
                saved_mod_g = self.globals["module"];
            }
            if "exports" in self.globals {
                saved_exp_g = self.globals["exports"];
            }
            _push_cjs_module_context(self, jm);
            use_mod_ctx = True;
        }
        result: JSValue = self._reg_run_value(closure, cl_val, effective_this, args);
        if jsv_is_hole(result) {
            result = self.run(
                closure.func, effective_this, args, closure.free_vals, cl_val
            );
        }
        if use_mod_ctx {
            self.globals["module"] = saved_mod_g;
            self.gw_epoch = self.gw_epoch + 1;
            self.globals["exports"] = saved_exp_g;
            self.gw_epoch = self.gw_epoch + 1;
        }
        self.module_fns = saved_mf;
        return result;
    }

    """
    Implement require(specifier): resolve, cache-check, load, execute, return exports.

    For built-in modules (fs, path, etc.), returns a pre-built module object.
    For user files (.js), reads the file, parses, compiles, executes in a CJS
    wrapper context (module.exports / exports), and returns module.exports.

    Saves and restores VM state (module_fns, script_dir) around nested
    require() calls to support recursive/nested requires.

    Node.js reference: https://nodejs.org/api/modules.html#requireid
    """
    # True when a JS builtin file module is cached with finished exports (not mid-load empty cache).
    def _js_builtin_cache_ready(js_builtin_path: str) -> bool {
        if not module_is_cached(js_builtin_path) {
            return False;
        }
        exp_v: JSValue = module_get_cached(js_builtin_path);
        if not jsv_is_object_cell(exp_v) {
            return False;
        }
        if jsv_is_object_cell(_REQUIRE_CACHE_OBJ) {
            cm_v: JSValue = js_object_get(
                _REQUIRE_CACHE_OBJ, str_intern(js_builtin_path)
            );
            if jsv_is_object_cell(cm_v) {
                loaded_v: JSValue = js_object_get(cm_v, WK_LOADED);
                if jsv_is_bool(loaded_v) {
                    if jsv_to_bool(loaded_v) {
                        return True;
                    }
                    # loaded=False means circular require still in progress.
                    # Fall through to exp_keys check — partial exports are usable
                    # and returning False here would cause harmful re-execution.
                }
            }
        }
        exp_keys: list[int] = js_object_keys(exp_v);
        return len(exp_keys) > 0;
    }

