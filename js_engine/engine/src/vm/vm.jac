    def _build_cjs_module_object(resolved: str, parent_mod: JSValue) -> JSValue {
        req_exports: JSValue = js_object_create_null();
        req_module: JSValue = js_object_create_null();
        js_object_set(req_module, WK_EXPORTS, req_exports);
        js_object_set(req_module, str_intern("filename"), js_str(resolved));
        js_object_set(req_module, WK_ID, js_str(resolved));
        js_object_set(req_module, WK_LOADED, js_boolean(False));
        js_object_set(req_module, str_intern("parent"), parent_mod);
        js_object_set(req_module, str_intern("children"), js_array_create([]));
        req_mod_paths: JSValue = self._make_module_paths(path_dirname(resolved));
        js_object_set(req_module, str_intern("paths"), req_mod_paths);
        js_object_set(
            req_module, str_intern("require"), module_create_bound_require(resolved)
        );
        vm_attach_module_compile(req_module);
        return req_module;
    }

    def _wire_module_parent_child(req_module: JSValue, parent_mod: JSValue) {
        if jsv_is_object_cell(parent_mod) {
            parent_children: JSValue = js_object_get(
                parent_mod, str_intern("children")
            );
            if jsv_is_object_cell(parent_children) {
                parent_children_len_v: JSValue = js_object_get(
                    parent_children, WK_LENGTH
                );
                parent_children_len: int = 0;
                if jsv_is_int32(parent_children_len_v) {
                    parent_children_len = jsv_to_int32(parent_children_len_v);
                } elif jsv_is_double(parent_children_len_v) {
                    parent_children_len = int(jsv_to_double(parent_children_len_v));
                }
                js_array_set(parent_children, parent_children_len, req_module);
            }
        }
    }

    def _cache_cjs_module(resolved: str, req_module: JSValue, req_exports: JSValue) {
        if jsv_is_object_cell(_REQUIRE_CACHE_OBJ) {
            js_object_set(_REQUIRE_CACHE_OBJ, str_intern(resolved), req_module);
        }
        module_cache_set(resolved, req_exports);
    }

    """
    Sibling `.jsbc` path for a JS-builtin source file, or "" if `filename` is not
    a builtin under `src/builtins/js/*.js`. Only builtins ship precompiled
    bytecode — user CJS/ESM modules always parse.
    """
    def _jsbc_path_for(filename: str) -> str {
        n: int = len(filename);
        if n < 3 {
            return "";
        }
        # must end in ".js"
        if str_substr(filename, n - 3, n) != ".js" {
            return "";
        }
        # must live under the builtins/js directory
        if not ("/src/builtins/js/" in filename) {
            return "";
        }
        return str_substr(filename, 0, n - 3) + ".jsbc";
    }

    """
    Load a JS builtin's precompiled `.jsbc` into (top_fn, all_fns) when the JSBC
    cache is enabled and `filename` is a builtin. Returns a JSBCModule with
    ok=True on success, or ok=False to fall through to normal JS parse+compile.

    `.jsbc` files are a build artifact (`make build` regenerates them; not
    committed). A **missing** `.jsbc` is NOT an error — we simply parse the `.js`
    (so a fresh checkout / partial build still runs). A **present-but-broken**
    `.jsbc` (bad magic, or a format/opcode-version mismatch vs this engine) IS a
    hard error: it means a stale build shipped incompatible bytecode, which must
    be surfaced loudly rather than silently masked by parsing.
    """
    def _load_builtin_jsbc(filename: str) -> JSBCModule {
        miss: JSBCModule = JSBCModule(
            top_fn=make_compiled_fn("", ""),
            all_fns=[],
            source_hash=0,
            format_ver=0,
            opcode_count=0,
            ok=False,
            err=""
        );
        # JSBC=0 disables the cache entirely (escape hatch → always parse).
        if getenv("JSBC") == "0" {
            return miss;
        }
        jsbc_path: str = self._jsbc_path_for(filename);
        if jsbc_path == "" {
            return miss;
        }  # not a builtin → parse path

        # Read the .jsbc into a single fixed raw byte buffer (binary-safe — NEVER
        # interned into a Jac str, which would truncate at the first embedded NUL).
        # A missing/unreadable/empty .jsbc is NOT fatal → parse fallback. `fb` stays
        # in scope for the whole decode, keeping fb.ptr referenced.
        fb: FileBytes = _read_file_bytes(jsbc_path);
        if not fb.ok {
            # No .jsbc yet (not built) → fall back to parsing the .js.
            return miss;
        }
        mod: JSBCModule = jsbc_decode(fb.ptr, fb.size);
        if not mod.ok {
            print(
                "FATAL: corrupt bytecode "
                    + jsbc_path
                    + ": "
                    + mod.err
                    + " — run `make builtins-bytecode`"
            );
            fflush(0);
            abort();
        }
        if mod.format_ver != JSBC_FORMAT_VER or mod.opcode_count != JSBC_OPCODE_COUNT {
            print(
                "FATAL: stale bytecode "
                    + jsbc_path
                    + " (format v"
                    + str(mod.format_ver)
                    + "/opc "
                    + str(mod.opcode_count)
                    + " vs engine v"
                    + str(JSBC_FORMAT_VER)
                    + "/opc "
                    + str(JSBC_OPCODE_COUNT)
                    + "): run `make builtins-bytecode`"
            );
            fflush(0);
            abort();
        }
        return mod;
    }

    """
    Compile and execute CJS source in a module object's context.
    Returns final module.exports (handles reassignment during execution).
    """
    def _cjs_run_in_module(module_obj: JSValue, source: str, filename: str) -> JSValue {
        # Startup profiling (JSBC_PROF=1): time decode vs execute per builtin so
        # we can see where cold-start goes. uvhrtime() is ns; only builtins with a
        # .jsbc are timed (the interesting ones).
        _prof: bool = getenv("JSBC_PROF") == "1";
        _t_dec0: int = 0;
        if _prof {
            _t_dec0 = uvhrtime();
        }

        # Fast path: JS builtins load precompiled bytecode (.jsbc) and skip
        # parse+compile entirely. User modules (non-builtin filenames) and the
        # JSBC=0 escape hatch fall through to the parse path below.
        jsbc_mod: JSBCModule = self._load_builtin_jsbc(filename);
        _t_dec_ns: int = 0;
        if _prof {
            _t_dec_ns = uvhrtime() - _t_dec0;
        }
        top_fn: CompiledFunction = make_compiled_fn("", "");
        module_all_fns: list[CompiledFunction] = [];
        if jsbc_mod.ok {
            top_fn = jsbc_mod.top_fn;
            module_all_fns = jsbc_mod.all_fns;
        } else {
            # Shared wrapper (bytecode/jsbc.na.jac) — js_compiler MUST apply the
            # same one so precompiled .jsbc top_fn/all_fns match what this runtime
            # produces.
            wrapped_source: str = _cjs_wrap_source(source);
            # CJS-wrapped source is never an ES module — skip the module-goal token
            # pre-scan (a full extra lex). This is the hot path: every builtin loads
            # through here, so the scan cost dominated startup (~30ms regression).
            ast = parse(wrapped_source, False, False);
            c = make_compiler();
            c.source_file = filename;
            # Source slice for Function.prototype.toString (nd.loc offsets are
            # into wrapped_source, so slicing against it is correct).
            c.source_text = wrapped_source;
            top_fn = c.compile_program(ast);
            # A compile error surfaces as a JS SyntaxError (not a silent empty
            # module) so require() of malformed CJS throws correctly.
            if c.had_error {
                ce_msg: str = c.last_error_msg;
                if ce_msg == "" {
                    ce_msg = "Invalid or unexpected token";
                }
                if ce_msg.startswith("SyntaxError: ") {
                    ce_msg = ce_msg[13:];
                }
                self.had_exception = True;
                self.pending_exc = make_syntax_error(ce_msg);
                return js_undefined();
            }
            module_all_fns = c.all_fns;
        }

        saved_module_fns: list[CompiledFunction] = self.module_fns;
        saved_dir: str = self.script_dir;

        req_exports: JSValue = js_object_get(module_obj, WK_EXPORTS);
        saved_mod_g: JSValue = js_undefined();
        saved_exp_g: JSValue = js_undefined();
        saved_dirname_g: JSValue = js_undefined();
        saved_filename_g: JSValue = js_undefined();
        if "module" in self.globals {
            saved_mod_g = self.globals["module"];
        }
        if "exports" in self.globals {
            saved_exp_g = self.globals["exports"];
        }
        if "__dirname" in self.globals {
            saved_dirname_g = self.globals["__dirname"];
        }
        if "__filename" in self.globals {
            saved_filename_g = self.globals["__filename"];
        }

        self.globals["module"] = module_obj;
        self.gw_epoch = self.gw_epoch + 1;
        self.globals["exports"] = req_exports;
        self.gw_epoch = self.gw_epoch + 1;
        self.globals["__jac_esm_exports"] = req_exports;
        self.gw_epoch = self.gw_epoch + 1;
        self.globals["__dirname"] = js_str(path_dirname(filename));
        self.gw_epoch = self.gw_epoch + 1;
        self.globals["__filename"] = js_str(filename);
        self.gw_epoch = self.gw_epoch + 1;

        self.module_fns = module_all_fns;
        self.script_dir = path_dirname(filename);
        saved_esm_for_cjs: int = self.esm_entry;
        self.esm_entry = 0;
        _t_exe0: int = 0;
        if _prof {
            _t_exe0 = uvhrtime();
        }
        self.run(top_fn, js_undefined(), [], [], js_undefined());
        if _prof and jsbc_mod.ok {
            _t_exe_ns: int = uvhrtime() - _t_exe0;
            print(
                "JSBC_PROF "
                    + filename
                    + " decode="
                    + str(_t_dec_ns // 1000)
                    + "us"
                    + " exec="
                    + str(_t_exe_ns // 1000)
                    + "us"
                    + " fns="
                    + str(1 + len(module_all_fns))
            );
        }
        self.esm_entry = saved_esm_for_cjs;

        if self.had_exception {
            self.globals["module"] = saved_mod_g;
            self.gw_epoch = self.gw_epoch + 1;
            self.globals["exports"] = saved_exp_g;
            self.gw_epoch = self.gw_epoch + 1;
            self.globals["__dirname"] = saved_dirname_g;
            self.gw_epoch = self.gw_epoch + 1;
            self.globals["__filename"] = saved_filename_g;
            self.gw_epoch = self.gw_epoch + 1;
            self.module_fns = saved_module_fns;
            self.script_dir = saved_dir;
            return js_undefined();
        }

        final_exports: JSValue = js_object_get(module_obj, WK_EXPORTS);
        self.module_fns = saved_module_fns;
        self.script_dir = saved_dir;
        self.globals["module"] = saved_mod_g;
        self.gw_epoch = self.gw_epoch + 1;
        self.globals["exports"] = saved_exp_g;
        self.gw_epoch = self.gw_epoch + 1;
        self.globals["__dirname"] = saved_dirname_g;
        self.gw_epoch = self.gw_epoch + 1;
        self.globals["__filename"] = saved_filename_g;
        self.gw_epoch = self.gw_epoch + 1;
        return final_exports;
    }

    def _finalize_cjs_module(
        req_module: JSValue,
        resolved: str,
        final_exports: JSValue,
        mod_bare: str,
        is_esm_import: int
    ) -> JSValue {
        module_cache_set(resolved, final_exports);
        _bind_jac_module_on_exports(final_exports, req_module, self.realm);
        js_object_set(req_module, WK_LOADED, js_boolean(True));
        if jsv_is_object_cell(_REQUIRE_CACHE_OBJ) {
            js_object_set(_REQUIRE_CACHE_OBJ, str_intern(resolved), req_module);
        }
        if is_builtin_module(mod_bare) or self._is_js_builtin(mod_bare) {
            esm_builtin_namespace_for(mod_bare, final_exports);
        }
        if mod_bare == "perf_hooks" {
            ph_perf: JSValue = js_object_get(final_exports, str_intern("performance"));
            if jsv_is_object_cell(ph_perf) {
                js_object_set(self.global_this, str_intern("performance"), ph_perf);
                self.globals["performance"] = ph_perf;
                self.gw_epoch = self.gw_epoch + 1;
            }
        }
        if is_esm_import != 0 or self.dynamic_import_active != 0 {
            if is_builtin_module(mod_bare) or self._is_js_builtin(mod_bare) {
                return esm_builtin_namespace_for(mod_bare, final_exports);
            }
            # Userland CJS → ESM: expose module.exports as namespace.default
            # (and copy named keys) so `import x from './file.js'` works.
            return esm_cjs_namespace_for(resolved, final_exports);
        }
        return final_exports;
    }

    def _load_via_extension_loader(
        resolved: str,
        loader: JSValue,
        mod_format: str,
        mod_bare: str,
        is_esm_import: int,
        parent_mod: JSValue
    ) -> JSValue {
        req_module: JSValue = self._build_cjs_module_object(resolved, parent_mod);
        req_exports: JSValue = js_object_get(req_module, WK_EXPORTS);
        self._wire_module_parent_child(req_module, parent_mod);
        self._cache_cjs_module(resolved, req_module, req_exports);

        vm_call_js_fn(self, loader, js_undefined(), [req_module, js_str(resolved)]);
        if self.had_exception {
            return js_undefined();
        }

        final_exports: JSValue = js_object_get(req_module, WK_EXPORTS);
        return self._finalize_cjs_module(
            req_module, resolved, final_exports, mod_bare, is_esm_import
        );
    }

    def _make_module_paths(start_dir: str) -> JSValue {
        # Build node_modules search path array from start_dir up to root.
        # e.g. ["/a/b/node_modules", "/a/node_modules", "/node_modules"]
        mp_arr: JSValue = js_array_create([]);
        mp_idx: int = 0;
        mp_dir: str = start_dir;
        mp_prev: str = "";
        while mp_dir != mp_prev and mp_dir != "" {
            mp_nm: str = mp_dir + "/node_modules";
            js_array_set(mp_arr, mp_idx, js_str(mp_nm));
            mp_idx = mp_idx + 1;
            mp_prev = mp_dir;
            mp_dir = path_dirname(mp_dir);
        }
        return mp_arr;
    }

    """True if `js_obj` is a deferred module namespace awaiting first evaluation."""
    def _is_defer_pending_ns(js_obj: JSValue) -> bool {
        if not jsv_is_object_cell(js_obj) {
            return False;
        }
        if jsv_to_table_id(js_obj) <= 0 {
            return False;
        }
        # Only a module namespace object (marked before its __DEFER_PENDING is
        # defined) can be pending — skip the own-property probe for the rest.
        if (js_object_cell_flags_id(jsv_to_table_id(js_obj)) & FLAG_MODULE_NS) == 0 {
            return False;
        }
        if not js_object_has_own(js_obj, WK_DEFER_PENDING) {
            return False;
        }
        return jsv_coerce_to_bool(js_object_get(js_obj, WK_DEFER_PENDING));
    }

    """True if AST node contains an AwaitExpression (module HasTLA probe)."""
    def _ast_contains_await(nd: ASTNode) -> bool {
        if nd is None {
            return False;
        }
        if nd.ntype == ASTNodeType.AwaitExpression {
            return True;
        }
        if nd.expression is not None and self._ast_contains_await(nd.expression) {
            return True;
        }
        if nd.argument is not None and self._ast_contains_await(nd.argument) {
            return True;
        }
        if nd.init is not None and self._ast_contains_await(nd.init) {
            return True;
        }
        if nd.body is not None and self._ast_contains_await(nd.body) {
            return True;
        }
        if nd.left is not None and self._ast_contains_await(nd.left) {
            return True;
        }
        if nd.right is not None and self._ast_contains_await(nd.right) {
            return True;
        }
        if nd.consequent is not None and self._ast_contains_await(nd.consequent) {
            return True;
        }
        if nd.alternate is not None and self._ast_contains_await(nd.alternate) {
            return True;
        }
        if nd.cond_expr is not None and self._ast_contains_await(nd.cond_expr) {
            return True;
        }
        for ch in nd.children {
            if self._ast_contains_await(ch) {
                return True;
            }
        }
        for d in nd.declarations {
            if self._ast_contains_await(d) {
                return True;
            }
        }
        for el in nd.elements {
            if self._ast_contains_await(el) {
                return True;
            }
        }
        return False;
    }

    """Module-level HasTLA: top-level await in the Program body (not nested fns)."""
    def _module_ast_has_tla(ast: ASTNode) -> bool {
        if ast is None {
            return False;
        }
        for stmt in ast.children {
            # Skip nested function/class bodies — only module evaluation body.
            if stmt.ntype == ASTNodeType.FunctionDeclaration {
                continue;
            }
            if stmt.ntype == ASTNodeType.ClassDeclaration {
                continue;
            }
            if self._ast_contains_await(stmt) {
                return True;
            }
        }
        return False;
    }

    """
    GatherAsynchronousTransitiveDependencies (ES import.defer): absolute paths of
    modules with HasTLA reachable from `resolved` via static imports.  If the
    module itself has TLA it is the sole result (spec short-circuit).
    """
    def _gather_async_transitive_deps(
        resolved: str, ast: ASTNode, seen: dict[str, bool]
    ) -> list[str] {
        out: list[str] = [];
        if resolved in seen {
            return out;
        }
        seen[resolved] = True;
        if self._module_ast_has_tla(ast) {
            out.append(resolved);
            return out;
        }
        from_dir: str = path_dirname(resolved);
        for stmt in ast.children {
            if stmt.ntype != ASTNodeType.ImportDeclaration {
                continue;
            }
            if stmt.source is None {
                continue;
            }
            spec: str = stmt.source.value;
            dep: str = module_resolve(spec, from_dir, resolved, 1);
            if dep == "" {
                continue;
            }
            if dep in seen {
                continue;
            }
            dep_raw: JSValue = _read_file_sync_str(dep);
            if jsv_is_undefined(dep_raw) {
                continue;
            }
            dep_src: str = str_from_id(jsv_to_table_id(dep_raw));
            dep_ast: ASTNode = parse(dep_src, True);
            dep_list: list[str] = self._gather_async_transitive_deps(
                dep, dep_ast, seen
            );
            for d in dep_list {
                already: bool = False;
                for e in out {
                    if e == d {
                        already = True;
                    }
                }
                if not already {
                    out.append(d);
                }
            }
        }
        return out;
    }

    """
    Collect ESM ExportEntries from a Program AST (relative specifiers as written).
    Prefixes:
      L:name  — local export initialized at Instantiation (var / function)
      T:name  — local export uninitialized at Instantiation (let/const/class/default)
      I:exp:imp:spec — indirect re-export
      S:dep   — star re-export
    """
    def _esm_collect_export_entries_raw(ast: ASTNode) -> list[str] {
        out: list[str] = [];
        if ast is None {
            return out;
        }
        # Map local binding name → "tdz" | "init" for classifying `export { local }`.
        bind_kind: dict[str, str] = {};
        for stmt0 in ast.children {
            d0: ASTNode = stmt0;
            if stmt0.ntype == ASTNodeType.ExportNamedDecl
                and stmt0.expression is not None {
                d0 = stmt0.expression;
            } elif stmt0.ntype == ASTNodeType.ExportDefaultDecl
                and stmt0.expression is not None {
                d0 = stmt0.expression;
            }
            if d0.ntype == ASTNodeType.VariableDeclaration {
                vk: str = d0.value;
                for dd0 in d0.declarations {
                    if dd0.id is not None and dd0.id.ntype == ASTNodeType.Identifier {
                        if vk == "let" or vk == "const" {
                            bind_kind[dd0.id.name] = "tdz";
                        } else {
                            bind_kind[dd0.id.name] = "init";
                        }
                    }
                }
            } elif d0.ntype == ASTNodeType.FunctionDeclaration {
                if d0.id is not None {
                    bind_kind[d0.id.name] = "init";
                }
            } elif d0.ntype == ASTNodeType.ClassDeclaration {
                if d0.id is not None {
                    bind_kind[d0.id.name] = "tdz";
                }
            }
        }
        for stmt in ast.children {
            if stmt.ntype == ASTNodeType.ExportDefaultDecl {
                # default is created uninitialized at Instantiation, initialized at evaluation.
                out.append("T:default");
            } elif stmt.ntype == ASTNodeType.ExportAllDecl {
                src: str = "";
                if stmt.source is not None {
                    src = stmt.source.value;
                }
                if stmt.expression is not None and stmt.expression.name != "" {
                    # `export * as ns from "mod"` — local export of `ns` (init once linked).
                    out.append("L:" + stmt.expression.name);
                } elif src != "" {
                    out.append("S:" + src);
                }
            } elif stmt.ntype == ASTNodeType.ExportNamedDecl {
                if stmt.source is not None and len(stmt.specifiers) > 0 {
                    src2: str = stmt.source.value;
                    for sp in stmt.specifiers {
                        if sp.left is None or sp.right is None {
                            continue;
                        }
                        imp_n: str = sp.left.name;
                        exp_n: str = sp.right.name;
                        out.append("I:" + exp_n + ":" + imp_n + ":" + src2);
                    }
                } elif stmt.expression is not None {
                    ed: ASTNode = stmt.expression;
                    if ed.ntype == ASTNodeType.VariableDeclaration {
                        ek: str = ed.value;
                        for dd in ed.declarations {
                            if dd.id is not None
                                and dd.id.ntype == ASTNodeType.Identifier {
                                if ek == "let" or ek == "const" {
                                    out.append("T:" + dd.id.name);
                                } else {
                                    out.append("L:" + dd.id.name);
                                }
                            }
                        }
                    } elif ed.ntype == ASTNodeType.FunctionDeclaration {
                        if ed.id is not None {
                            out.append("L:" + ed.id.name);
                        }
                    } elif ed.ntype == ASTNodeType.ClassDeclaration {
                        if ed.id is not None {
                            out.append("T:" + ed.id.name);
                        }
                    }
                }
                if len(stmt.specifiers) > 0 and stmt.source is None {
                    for sp2 in stmt.specifiers {
                        if sp2.right is None or sp2.right.name == "" {
                            continue;
                        }
                        exp_as: str = sp2.right.name;
                        loc_n: str = "";
                        if sp2.left is not None {
                            loc_n = sp2.left.name;
                        }
                        if loc_n != ""
                            and loc_n in bind_kind
                            and bind_kind[loc_n] == "tdz" {
                            out.append("T:" + exp_as);
                        } else {
                            out.append("L:" + exp_as);
                        }
                    }
                }
            }
        }
        return out;
    }

    """
    Ensure export metadata for `resolved` is registered (parse-only, cycle-safe),
    then recursively register dependencies.  Returns False on I/O failure.
    """
    def _esm_ensure_export_meta(resolved: str) -> bool {
        if esm_export_meta_has(resolved) {
            return True;
        }
        # Sentinel to break circular registration.
        empty_e: list[str] = [];
        esm_export_meta_set(resolved, empty_e);
        file_content: JSValue = _read_file_sync_str(resolved);
        if jsv_is_undefined(file_content) {
            esm_export_meta_delete(resolved);
            return False;
        }
        source: str = str_from_id(jsv_to_table_id(file_content));
        # A dependency with no ESM import/export syntax is a CommonJS module. Tag
        # it with a "C:" marker so esm_resolve_export treats it as providing any
        # named binding (its namespace is synthesized from module.exports at
        # runtime). Without this, `export { x as y } from './cjs'` fails
        # ResolveExport: the CJS source has no I:/L:/T: entries and an empty ESM
        # entry list is indistinguishable from "genuinely missing export".
        if not _source_is_module(source) {
            cjs_e: list[str] = ["C:"];
            esm_export_meta_set(resolved, cjs_e);
            return True;
        }
        ast_m: ASTNode = parse(source, True);
        # Hand the AST to the _require_module that will load this module shortly
        # (it is a re-export target of the module being instantiated).
        if len(self.esm_meta_ast) < ESM_META_AST_CACHE_MAX {
            self.esm_meta_ast[resolved] = ast_m;
            self.esm_meta_src[resolved] = source;
        }
        self._esm_register_export_meta(resolved, ast_m);
        return True;
    }

    """
    The module-goal AST of ESM `resolved`: the one _esm_ensure_export_meta already
    parsed from this same source when cached (the entry is consumed), else a fresh
    parse (top-level await allowed).
    """
    def _esm_take_meta_ast(resolved: str, source: str) -> ASTNode {
        if resolved in self.esm_meta_ast {
            cached_ast: ASTNode = self.esm_meta_ast[resolved];
            same_src: bool = self.esm_meta_src[resolved] == source;
            del self.esm_meta_ast[resolved];
            del self.esm_meta_src[resolved];
            if same_src {
                return cached_ast;
            }
        }
        return parse(source, True);
    }

    """
    Collect `resolved`'s ExportEntries from its parsed AST, resolve S:/I: entries
    to absolute dependency paths (ensuring their metadata, cycle-safe), register
    the result and return it.
    """
    def _esm_register_export_meta(resolved: str, ast_m: ASTNode) -> list[str] {
        raw_e: list[str] = self._esm_collect_export_entries_raw(ast_m);
        from_dir: str = path_dirname(resolved);
        abs_e: list[str] = [];
        ri: int = 0;
        while ri < len(raw_e) {
            e: str = raw_e[ri];
            if len(e) >= 2 and (e[0] == "L" or e[0] == "T") and e[1] == ":" {
                abs_e.append(e);
            } elif len(e) >= 2 and e[0] == "S" and e[1] == ":" {
                spec: str = e[2:];
                dep: str = module_resolve(spec, from_dir, resolved, 1);
                if dep != "" {
                    self._esm_ensure_export_meta(dep);
                    abs_e.append("S:" + dep);
                }
            } elif len(e) >= 2 and e[0] == "I" and e[1] == ":" {
                rest: str = e[2:];
                c1: int = -1;
                c2: int = -1;
                ci: int = 0;
                while ci < len(rest) {
                    if rest[ci] == ":" {
                        if c1 < 0 {
                            c1 = ci;
                        } elif c2 < 0 {
                            c2 = ci;
                        }
                    }
                    ci = ci + 1;
                }
                if c1 >= 0 and c2 > c1 {
                    exp_n: str = rest[0:c1];
                    imp_n: str = rest[c1 + 1:c2];
                    spec2: str = rest[c2 + 1:];
                    dep2: str = module_resolve(spec2, from_dir, resolved, 1);
                    if dep2 != "" {
                        self._esm_ensure_export_meta(dep2);
                        abs_e.append("I:" + exp_n + ":" + imp_n + ":" + dep2);
                    }
                }
            }
            ri = ri + 1;
        }
        esm_export_meta_set(resolved, abs_e);
        return abs_e;
    }

    """
    Mark an ESM exports object as a Module Namespace Exotic Object *before*
    evaluation so self-imports observe exotic [[Set]]/[[Delete]]/[[IsExtensible]]
    and @@toStringTag.  Export keys may still be installed afterward via the
    privileged namespace-export write path; call `_finalize_esm_namespace` after
    evaluation to seal.
    """
    def _mark_esm_namespace(ns: JSValue) -> None {
        if not jsv_is_object_cell(ns) {
            return;
        }
        tag_key: int = SYMBOL_KEY_BASE + SYMBOL_TO_STRING_TAG;
        js_object_define_property(
            ns,
            tag_key,
            JSProperty(
                key=tag_key,
                value=js_str("Module"),
                writable=False,
                enumerable=False,
                configurable=False,
                deleted=False
            )
        );
        js_object_mark_module_namespace(ns);
    }

    """
    Pre-create own export keys on a namespace from ExportEntries so Instantiation
    semantics hold: [[Delete]]/[[HasProperty]]/[[OwnPropertyKeys]] see every
    export name before evaluation (including TDZ bindings).
    Entries are `L:name` (init), `T:name` (TDZ), `I:exp:imp:spec`, or `S:dep`.
    """
    def _preseed_namespace_exports(ns: JSValue, entries: list[str]) -> None {
        if not jsv_is_object_cell(ns) {
            return;
        }
        # Seed the TDZ sentinel once (glob written directly, like eval() above —
        # no `global` declaration statement, which jac-native does not accept).
        if jsv_is_undefined(_TDZ_SENTINEL) {
            _TDZ_SENTINEL = _js_tdz_create();
            gc_pin_value(_TDZ_SENTINEL);  # glob-held singleton — invisible to the GC root walk
        }
        for em in entries {
            if len(em) < 2 or em[1] != ":" {
                continue;
            }
            if em[0] == "L" or em[0] == "T" {
                # Copy via str_substr, NOT a native `em[2:]` suffix-slice: a
                # suffix-view slice of a rope is an interior pointer with no
                # string header, so retaining it in the long-lived str_intern
                # table dangles once the rope's flatten buffer is reused —
                # corrupting the interned key to "" (spurious empty namespace
                # export key; see module-namespace own-property-keys tests).
                name_l: str = str_substr(em, 2, len(em));
                if name_l != "" {
                    kid_l: int = str_intern(name_l);
                    if not js_object_has_own(ns, kid_l) {
                        seed_v: JSValue = js_undefined();
                        if em[0] == "T" {
                            seed_v = _TDZ_SENTINEL;
                        }
                        _ = js_object_namespace_export_set(ns, kid_l, seed_v);
                    }
                }
            } elif em[0] == "I" {
                # I:expName:importName:resolvedPath
                rest_i: str = str_substr(em, 2, len(em));
                c1: int = -1;
                c2: int = -1;
                ci: int = 0;
                while ci < len(rest_i) {
                    if rest_i[ci] == ":" {
                        if c1 < 0 {
                            c1 = ci;
                        } elif c2 < 0 {
                            c2 = ci;
                        }
                    }
                    ci = ci + 1;
                }
                if c1 > 0 {
                    exp_n: str = str_substr(rest_i, 0, c1);
                    if exp_n != "" {
                        kid_i: int = str_intern(exp_n);
                        if not js_object_has_own(ns, kid_i)
                            and not js_object_has_own_accessor(ns, kid_i) {
                            # Seed TDZ when the imported binding is uninitialized so
                            # self-reexports (`export { local as x } from './self'`)
                            # throw ReferenceError before REEXPORT_LIVE installs.
                            seed_i: JSValue = js_undefined();
                            imp_n: str = "";
                            dep_path: str = "";
                            if c2 > c1 {
                                imp_n = rest_i[c1 + 1:c2];
                                dep_path = rest_i[c2 + 1:];
                            }
                            is_tdz_imp: bool = False;
                            if imp_n != "" {
                                # Prefer dependency meta; else scan this module's entries
                                # (self-reexport / Instantiation before link).
                                if dep_path != "" and esm_export_meta_has(dep_path) {
                                    for cem in esm_export_meta_get(dep_path) {
                                        if len(cem) > 2
                                            and cem[0] == "T"
                                            and cem[1] == ":" {
                                            if cem[2:] == imp_n {
                                                is_tdz_imp = True;
                                            }
                                        }
                                    }
                                }
                                if not is_tdz_imp {
                                    ei_chk: int = 0;
                                    while ei_chk < len(entries) {
                                        cem2: str = entries[ei_chk];
                                        if len(cem2) > 2
                                            and cem2[0] == "T"
                                            and cem2[1] == ":" {
                                            if cem2[2:] == imp_n {
                                                is_tdz_imp = True;
                                            }
                                        }
                                        ei_chk = ei_chk + 1;
                                    }
                                }
                            }
                            if is_tdz_imp {
                                seed_i = _TDZ_SENTINEL;
                            }
                            _ = js_object_namespace_export_set(ns, kid_i, seed_i);
                        }
                    }
                }
            } elif em[0] == "S" {
                dep_s: str = str_substr(em, 2, len(em));
                if dep_s != "" and esm_export_meta_has(dep_s) {
                    for dem in esm_export_meta_get(dep_s) {
                        if len(dem) >= 2
                            and dem[1] == ":"
                            and (dem[0] == "L" or dem[0] == "T") {
                            dn: str = str_substr(dem, 2, len(dem));
                            if dn != "" and dn != "default" {
                                kid_s: int = str_intern(dn);
                                if not js_object_has_own(ns, kid_s) {
                                    seed_s: JSValue = js_undefined();
                                    if dem[0] == "T" {
                                        seed_s = _TDZ_SENTINEL;
                                    }
                                    _ = js_object_namespace_export_set(
                                        ns, kid_s, seed_s
                                    );
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    """Parse `source` and preseed the namespace with its ExportEntries (entry modules)."""
    def _preseed_namespace_from_source(ns: JSValue, source: str) -> None {
        if not jsv_is_object_cell(ns) {
            return;
        }
        ast_ps: ASTNode = parse(source, True);
        raw_ps: list[str] = self._esm_collect_export_entries_raw(ast_ps);
        self._preseed_namespace_exports(ns, raw_ps);
    }

    """Seal an ESM namespace as a Module Namespace Exotic Object after evaluation."""
    def _finalize_esm_namespace(ns: JSValue) -> None {
        if not jsv_is_object_cell(ns) {
            return;
        }
        self._mark_esm_namespace(ns);
        js_object_finalize_module_namespace(ns);
    }

    """
    Trigger deferred module evaluation when a namespace exotic operation requires
    the export list.  Symbols and the key "then" do not trigger (IsSymbolLikeNamespaceKey).
    When `for_own_keys` is True, evaluation is always triggered.
    """
    def _defer_ns_maybe_eval(js_obj: JSValue, key: int, for_own_keys: bool) -> None {
        if not self._is_defer_pending_ns(js_obj) {
            return;
        }
        if not for_own_keys {
            if key >= SYMBOL_KEY_BASE {
                return;
            }
            if key == WK_THEN {
                return;
            }
        }
        self._evaluate_deferred_module(js_obj);
    }

    """
    Evaluate a deferred module namespace into the cached object (identity-preserving).
    Accepts the namespace object or a path string (resolved via __DEFER_PATH / cache).
    """
    def _evaluate_deferred_module(ns_or_path: JSValue) -> None {
        ns: JSValue = js_undefined();
        resolved: str = "";
        if jsv_is_string_cell(ns_or_path) {
            resolved = str_from_id(jsv_to_table_id(ns_or_path));
            if module_is_cached(resolved) {
                ns = module_get_cached(resolved);
            }
        } elif jsv_is_object_cell(ns_or_path) {
            ns = ns_or_path;
            dpk: int = str_intern("__DEFER_PATH");
            if js_object_has_own(ns, dpk) {
                resolved = jsval_to_str(js_object_get(ns, dpk));
            }
        }
        if not jsv_is_object_cell(ns) or jsv_to_table_id(ns) <= 0 {
            return;
        }
        if not self._is_defer_pending_ns(ns) {
            return;
        }
        if resolved == "" {
            return;
        }

        # Clear pending early to avoid re-entrant evaluation loops.
        pend_k: int = str_intern("__DEFER_PENDING");
        path_k: int = str_intern("__DEFER_PATH");
        js_object_delete(ns, pend_k);

        file_content: JSValue = _read_file_sync_str(resolved);
        if jsv_is_undefined(file_content) {
            self.had_exception = True;
            self.pending_exc = make_type_error(
                "Cannot evaluate deferred module: " + resolved
            );
            js_object_delete(ns, path_k);
            module_cache_delete(resolved);
            return;
        }
        source: str = str_from_id(jsv_to_table_id(file_content));
        ast_def = parse(source, True);
        c_def = make_compiler();
        mod_exp_gname: str = "__jac_modexp_" + resolved;
        c_def.esm_exports_global = mod_exp_gname;
        c_def.source_file = resolved;
        c_def.source_text = source;  # source slice for Function.prototype.toString
        top_fn_def = c_def.compile_program(ast_def);
        if c_def.had_error {
            ce_msg: str = c_def.last_error_msg;
            if ce_msg == "" {
                ce_msg = "Invalid or unexpected token";
            }
            if ce_msg.startswith("SyntaxError: ") {
                ce_msg = ce_msg[13:];
            }
            self.had_exception = True;
            self.pending_exc = make_syntax_error(ce_msg);
            js_object_delete(ns, path_k);
            module_cache_delete(resolved);
            return;
        }

        saved_module_fns: list[CompiledFunction] = self.module_fns;
        saved_dir: str = self.script_dir;
        saved_esm_flag: int = self.esm_entry;
        saved_cur_exp: str = self.current_esm_exports_global;
        saved_jac_exp: JSValue = js_undefined();
        saved_mod_exp: JSValue = js_undefined();
        had_mod_exp: int = 0;
        saved_fn: JSValue = js_undefined();
        saved_dn: JSValue = js_undefined();
        if "__jac_esm_exports" in self.globals {
            saved_jac_exp = self.globals["__jac_esm_exports"];
        }
        if mod_exp_gname in self.globals {
            saved_mod_exp = self.globals[mod_exp_gname];
            had_mod_exp = 1;
        }
        if "__filename" in self.globals {
            saved_fn = self.globals["__filename"];
        }
        if "__dirname" in self.globals {
            saved_dn = self.globals["__dirname"];
        }
        # A dynamic import may have set require_parent_override to the IMPORTING
        # module's file so THIS specifier resolved against it. That job is done
        # once we are here evaluating the resolved module: its own static imports
        # must resolve against ITS directory (script_dir, set below), not the
        # importer's. Leaving the override set made `import('./cli.js')` load
        # cli.js but then resolve cli.js's `import './chunks/x.js'` against the
        # importer's dir. Clear it for the module body; the caller restores it.
        saved_rpo_esm: str = self.require_parent_override;
        self.require_parent_override = "";

        self.current_esm_exports_global = mod_exp_gname;
        self.globals["__jac_esm_exports"] = ns;
        self.gw_epoch = self.gw_epoch + 1;
        self.globals[mod_exp_gname] = ns;
        self.gw_epoch = self.gw_epoch + 1;
        self.globals["__filename"] = js_str(resolved);
        self.gw_epoch = self.gw_epoch + 1;
        self.globals["__dirname"] = js_str(path_dirname(resolved));
        self.gw_epoch = self.gw_epoch + 1;
        self.esm_entry = 1;
        # Ensure cache holds this namespace before nested imports run.
        module_cache_set(resolved, ns);
        self.module_fns = c_def.all_fns;
        self.script_dir = path_dirname(resolved);
        # Nested `import defer` still defers via IMPORT arg2=2; leave defer_phase alone.
        self.run(top_fn_def, js_undefined(), [], [], js_undefined());

        js_object_delete(ns, path_k);

        if self.had_exception {
            module_cache_delete(resolved);
            self.module_fns = saved_module_fns;
            self.script_dir = saved_dir;
            self.esm_entry = saved_esm_flag;
            self.current_esm_exports_global = saved_cur_exp;
            self.globals["__jac_esm_exports"] = saved_jac_exp;
            self.gw_epoch = self.gw_epoch + 1;
            if had_mod_exp != 0 {
                self.globals[mod_exp_gname] = saved_mod_exp;
                self.gw_epoch = self.gw_epoch + 1;
            } else {
                self.globals[mod_exp_gname] = ns;
                self.gw_epoch = self.gw_epoch + 1;
            }
            self.globals["__filename"] = saved_fn;
            self.gw_epoch = self.gw_epoch + 1;
            self.globals["__dirname"] = saved_dn;
            self.gw_epoch = self.gw_epoch + 1;
            self.require_parent_override = saved_rpo_esm;
            return;
        }

        self.module_fns = saved_module_fns;
        self.script_dir = saved_dir;
        self.esm_entry = saved_esm_flag;
        self.current_esm_exports_global = saved_cur_exp;
        self.globals["__jac_esm_exports"] = saved_jac_exp;
        self.gw_epoch = self.gw_epoch + 1;
        if had_mod_exp != 0 {
            self.globals[mod_exp_gname] = saved_mod_exp;
            self.gw_epoch = self.gw_epoch + 1;
        } else {
            self.globals[mod_exp_gname] = ns;
            self.gw_epoch = self.gw_epoch + 1;
        }
        self.globals["__filename"] = saved_fn;
        self.gw_epoch = self.gw_epoch + 1;
        self.globals["__dirname"] = saved_dn;
        self.gw_epoch = self.gw_epoch + 1;
        self.require_parent_override = saved_rpo_esm;
        self._finalize_esm_namespace(ns);
        module_cache_set(resolved, ns);
    }

    def _require_module(specifier: str) -> JSValue {
        from_dir: str = self.script_dir;
        parent_file: str = _get_parent_file(self);
        is_esm_import: int = self.require_is_esm;
        if self.dynamic_import_active != 0 {
            is_esm_import = 1;
        }

        # 0. Strip "node:" prefix for bare name check
        bare_spec: str = _strip_node_prefix(specifier);

        # 0a. module.registerHooks resolve chain — Node contract enforcement:
        # each resolve hook must either call nextResolve or return
        # { shortCircuit: true }; otherwise the require throws. Hooks run LIFO.
        # Engine-internal requires (builtin names, or issued from files under
        # engine_root, e.g. fs.js → ./fs/streams.js) bypass the chain, and a
        # require() issued from INSIDE a running hook does not re-enter it.
        if module_hooks_count() > 0
            and module_hooks_running_get() == 0
            and not is_builtin_module(bare_spec) {
            hk_internal: bool = False;
            hk_bi_root: str = self.engine_root + "/src/builtins/";
            hk_er_len: int = len(hk_bi_root);
            if hk_er_len > 0
                and len(parent_file) >= hk_er_len
                and parent_file[0:hk_er_len] == hk_bi_root {
                hk_internal = True;
            }
            if not hk_internal {
                if vm_fire_register_hooks(self, specifier) != 0 {
                    return js_undefined();
                }
            }
        }

        # 0b. Sub-module routing: X/promises → load X, return .promises
        if bare_spec == "timers/promises" {
            timers_mod: JSValue = self._require_module("timers");
            return js_object_get(timers_mod, WK_PROMISES);
        }
        if bare_spec == "readline/promises" {
            rl_mod: JSValue = self._require_module("readline");
            return js_object_get(rl_mod, WK_PROMISES);
        }
        if bare_spec == "dns/promises" {
            dns_mod: JSValue = self._require_module("dns");
            return js_object_get(dns_mod, WK_PROMISES);
        }
        if bare_spec == "stream/promises" {
            stream_mod: JSValue = self._require_module("stream");
            return js_object_get(stream_mod, WK_PROMISES);
        }

        # 1. Try built-in module (fs, process, console, timers, etc.)
        #    Skip native dispatch for JS-implemented builtins → they load from file below
        if not self._is_js_builtin(bare_spec) {
            builtin_result: JSValue = module_require_builtin(
                specifier, from_dir, self.globals
            );
            if not jsv_is_undefined(builtin_result) and is_esm_import == 0 {
                return builtin_result;
            }
        } else {
            # JS builtins still use the cache
            js_builtin_path: str = self.engine_root
                + "/src/builtins/js/"
                + bare_spec
                + ".js";
            if self._js_builtin_cache_ready(js_builtin_path) {
                cached_jsb: JSValue = module_get_cached(js_builtin_path);
                if is_esm_import != 0 or self.dynamic_import_active != 0 {
                    return esm_builtin_namespace_for(bare_spec, cached_jsb);
                }
                return cached_jsb;
            }
            # Override specifier so the file-loading path below picks it up
            specifier = js_builtin_path;
        }

        # 2. Canonical resolution (package.json, node_modules, extensions)
        rerr: JSValue = module_resolve_error(
            specifier, from_dir, parent_file, is_esm_import
        );
        if not jsv_is_undefined(rerr) {
            self.had_exception = True;
            self.pending_exc = rerr;
            return js_undefined();
        }
        resolved: str = module_resolve(specifier, from_dir, parent_file, is_esm_import);
        resolved_before_rp: str = resolved;
        # --preserve-symlinks: keep the symlink path as the module identity so
        # require('./real') and require('./link') are distinct cache entries.
        if not process_get_preserve_symlinks() {
            if len(resolved) > 0 and resolved[0] == "/" {
                rp_res: str = path_realpath_str(resolved);
                if rp_res != "" {
                    resolved = rp_res;
                }
            }
        }
        mod_format: str = module_resolve_format(
            specifier, from_dir, parent_file, is_esm_import
        );
        # Symlink targets: format follows the realpath (e.g. foo.json → bar.mjs),
        # unless --preserve-symlinks keeps the link path.
        if (
            not process_get_preserve_symlinks()
            and resolved != resolved_before_rp
            and len(resolved) > 0
            and resolved[0] == "/"
        ) {
            fmt_rp: str = module_resolve_format(
                resolved, path_dirname(resolved), resolved, is_esm_import
            );
            if fmt_rp != "" {
                mod_format = fmt_rp;
            }
        }
        # Canonical module id for ESM namespace / builtin interop (package #imports → "path", etc.)
        mod_bare: str = bare_spec;
        if mod_format == "builtin" {
            mod_bare = _strip_node_prefix(resolved);
        }

        # 3. Cache check — return live module.exports (NCJS-EXP-103)
        cache_ready: bool = module_is_cached(resolved);
        if self._is_js_builtin(bare_spec) {
            js_bp: str = self.engine_root + "/src/builtins/js/" + bare_spec + ".js";
            if resolved == js_bp {
                cache_ready = self._js_builtin_cache_ready(js_bp);
            }
        }
        # Source-phase imports must not reuse the evaluation-phase cache entry
        # (instance namespace); they need a WebAssembly.Module / source object.
        if cache_ready and self.import_source_phase == 0 {
            live0: JSValue = module_get_cached(resolved);
            if jsv_is_object_cell(_REQUIRE_CACHE_OBJ) {
                cm0: JSValue = js_object_get(_REQUIRE_CACHE_OBJ, str_intern(resolved));
                if jsv_is_object_cell(cm0) {
                    exp0: JSValue = js_object_get(cm0, WK_EXPORTS);
                    if jsv_is_object_cell(exp0) {
                        live0 = exp0;
                        module_cache_set(resolved, live0);
                    }
                }
            }
            # Eager import of a module that was only defer-loaded must evaluate it.
            # A second `import defer` of an already-pending ns just returns it.
            if self.import_defer_phase == 0 and self._is_defer_pending_ns(live0) {
                self._evaluate_deferred_module(live0);
                if self.had_exception {
                    return js_undefined();
                }
            }
            if is_esm_import != 0 or self.dynamic_import_active != 0 {
                if is_builtin_module(mod_bare) or self._is_js_builtin(mod_bare) {
                    return esm_builtin_namespace_for(mod_bare, live0);
                }
                # ESM/wasm modules are already namespace objects — return as-is
                # (do NOT wrap via esm_cjs_namespace_for; that snapshots values and
                # breaks live bindings / module identity across require↔import).
                if mod_format == "esm-js" or mod_format == "wasm" {
                    return live0;
                }
                # Plain `.js` entries that contain import/export are marked as
                # Module Namespace Exotics on the CJS-wrapper path (test262 cyclic
                # sandboxes keep the `.js` basename).  Returning a fresh
                # esm_cjs_namespace_for wrapper would drop the exotic flag and
                # break identity with the evaluating module's exports object.
                if js_is_module_namespace(live0) {
                    return live0;
                }
                return esm_cjs_namespace_for(resolved, live0);
            }
            # require(esm) cache hit: re-apply Node populateCJSExportsFromESM shaping.
            if self.sync_require_esm > 0 and mod_format == "esm-js" {
                return self._shape_require_esm_exports(live0);
            }
            return live0;
        }

        # 3b. Built-in modules resolved via package imports / node: prefix
        if mod_format == "builtin" {
            builtin_spec: str = _strip_node_prefix(resolved);
            mod_bare = builtin_spec;
            if self._is_js_builtin(builtin_spec) {
                # JS builtins (path.js, …) must evaluate as CJS even when reached
                # via ESM `import` / package `#imports` (e.g. `"#p": "path"`).
                # Under dynamic import(), _require_module promotes .js → esm-js
                # when dynamic_import_active is set — clear it for this load.
                bi_js: JSValue = self._load_js_builtin_exports(builtin_spec);
                if self.had_exception {
                    return js_undefined();
                }
                if jsv_is_undefined(bi_js) {
                    return js_undefined();
                }
                if is_esm_import != 0 or self.dynamic_import_active != 0 {
                    return esm_builtin_namespace_for(builtin_spec, bi_js);
                }
                return bi_js;
            } else {
                bi_exports: JSValue = module_require_builtin(
                    resolved, from_dir, self.globals
                );
                if not jsv_is_undefined(bi_exports) {
                    if is_esm_import != 0 or self.dynamic_import_active != 0 {
                        return esm_builtin_namespace_for(builtin_spec, bi_exports);
                    }
                    return bi_exports;
                }
                return js_undefined();
            }
        }

        # Capture parent module for nested CJS loads / extension loaders
        parent_mod: JSValue = js_null();
        if "module" in self.globals {
            parent_mod = self.globals["module"];
        }

        # Extension loader routing (Vite §4.2 — custom require.extensions override)
        if mod_format == "cjs-json" or mod_format == "napi" or mod_format == "cjs-js" {
            ext_loader: JSValue = _lookup_ext_loader(resolved);
            if _is_custom_ext_loader(ext_loader, mod_format) {
                return self._load_via_extension_loader(
                    resolved,
                    ext_loader,
                    mod_format,
                    mod_bare,
                    is_esm_import,
                    parent_mod
                );
            }
        }

        # 4. JSON / text modules — load file bytes without executing JS
        if mod_format == "cjs-json" {
            json_raw: JSValue = _read_file_sync_str(resolved);
            if jsv_is_undefined(json_raw) {
                mnf: JSValue = module_resolve_error(
                    specifier, from_dir, parent_file, is_esm_import
                );
                self.had_exception = True;
                self.pending_exc = mnf;
                return js_undefined();
            }
            json_txt: str = str_from_id(jsv_to_table_id(json_raw));
            # `with { type: "text" }` → CreateTextModule: default export is the
            # source text string (even when the specifier ends in `.json`).
            if self.import_attr_type == "text" {
                text_ns: JSValue = js_object_create_null();
                js_object_set(
                    text_ns, WK_DEFAULT, jsv_from_string_id(str_intern(json_txt))
                );
                module_cache_set(resolved, text_ns);
                return text_ns;
            }
            json_val: JSValue = js_json_parse(
                [jsv_from_string_id(str_intern(json_txt))]
            );
            # ESM JSON module (ES import-attributes `with { type: "json" }`): the
            # parsed value is the module's DEFAULT export, so return a namespace
            # `{ default: value }` (the `import x from …` binding reads `.default`).
            # For CJS `require("./x.json")` the module value IS the parsed JSON.
            if is_esm_import != 0 {
                json_ns: JSValue = js_object_create_null();
                js_object_set(json_ns, WK_DEFAULT, json_val);
                module_cache_set(resolved, json_ns);
                return json_ns;
            }
            module_cache_set(resolved, json_val);
            return json_val;
        }

        # 4b. NAPI native addons (.node shared libraries)
        if mod_format == "napi" {
            if not _NAPI_ENABLED {
                return _napi_disabled_throw(self);
            }
            # N4: prime the NAPI env with the live realm and global_this so
            # napi_func.na.jac can create closures without a circular import.
            _napi_set_realm(self.realm);
            _napi_set_global_jsv(self.global_this);
            napi_exports: JSValue = _load_napi_addon(self.napi_env_ptr, resolved);
            if self.had_exception {
                return js_undefined();
            }
            module_cache_set(resolved, napi_exports);
            return napi_exports;
        }

        # 4c. WebAssembly ESM modules (.wasm) — Node --experimental-wasm-modules
        if mod_format == "wasm" {
            wasm_loader: JSValue = js_undefined();
            if "__jacLoadWasmEsmFile" in self.globals {
                wasm_loader = self.globals["__jacLoadWasmEsmFile"];
            } elif jsv_is_object_cell(self.global_this) {
                wasm_loader = js_object_get(
                    self.global_this, str_intern("__jacLoadWasmEsmFile")
                );
            }
            if not is_fn_val(wasm_loader) {
                # Ensure the WebAssembly builtin (defines the helper) is loaded.
                _ = self._require_module("webassembly");
                if "__jacLoadWasmEsmFile" in self.globals {
                    wasm_loader = self.globals["__jacLoadWasmEsmFile"];
                } elif jsv_is_object_cell(self.global_this) {
                    wasm_loader = js_object_get(
                        self.global_this, str_intern("__jacLoadWasmEsmFile")
                    );
                }
            }
            if not is_fn_val(wasm_loader) {
                self.had_exception = True;
                self.pending_exc = make_type_error(
                    "WebAssembly ESM loader unavailable for: " + resolved
                );
                return js_undefined();
            }
            # Source-phase: compile only, return WebAssembly.Module (no instantiate).
            if self.import_source_phase != 0 {
                saved_dir_wasm_sp: str = self.script_dir;
                self.script_dir = path_dirname(resolved);
                wasm_mod: JSValue = self.obs_call_js_fn(
                    wasm_loader, js_undefined(), [js_str(resolved), js_true()]
                );
                self.script_dir = saved_dir_wasm_sp;
                if self.had_exception or vm_has_native_exc() {
                    if vm_has_native_exc() {
                        self.had_exception = True;
                        self.pending_exc = vm_take_native_exc();
                    }
                    return js_undefined();
                }
                return wasm_mod;
            }
            # Placeholder cache entry so cyclic imports see a namespace object.
            wasm_ns: JSValue = js_object_create_null();
            js_object_define_nonenum(
                wasm_ns, SYMBOL_KEY_BASE + SYMBOL_TO_STRING_TAG, js_str("Module")
            );
            module_cache_set(resolved, wasm_ns);
            saved_dir_wasm: str = self.script_dir;
            self.script_dir = path_dirname(resolved);
            wasm_result: JSValue = self.obs_call_js_fn(
                wasm_loader, js_undefined(), [js_str(resolved)]
            );
            self.script_dir = saved_dir_wasm;
            if self.had_exception or vm_has_native_exc() {
                if vm_has_native_exc() {
                    self.had_exception = True;
                    self.pending_exc = vm_take_native_exc();
                }
                module_cache_delete(resolved);
                return js_undefined();
            }
            # Copy enumerable exports onto the cached namespace (preserve identity).
            if jsv_is_object_cell(wasm_result) {
                wk_wasm: list[int] = js_object_keys(wasm_result);
                wi: int = 0;
                while wi < len(wk_wasm) {
                    wkey: int = wk_wasm[wi];
                    js_object_set(wasm_ns, wkey, js_object_get(wasm_result, wkey));
                    wi = wi + 1;
                }
            }
            module_cache_set(resolved, wasm_ns);
            return wasm_ns;
        }

        # 5. Read JS source
        file_content: JSValue = _read_file_sync_str(resolved);
        if jsv_is_undefined(file_content) {
            self.had_exception = True;
            self.pending_exc = module_resolve_error(
                specifier, from_dir, parent_file, is_esm_import
            );
            return js_undefined();
        }
        source: str = str_from_id(jsv_to_table_id(file_content));

        # Ambiguous files resolve to `cjs-js` by default (no package `type:module`),
        # but when source is actually an ES module (top-level import/export), they
        # must run on the ESM path — both for ESM `import` and Node 22+ require(esm).
        # Explicit `.cjs` stays CJS even with `export` tokens (syntax error).
        is_dot_cjs: bool = (
            len(resolved) >= 4
            and resolved[len(resolved) - 4] == "."
            and resolved[len(resolved) - 3] == "c"
            and resolved[len(resolved) - 2] == "j"
            and resolved[len(resolved) - 1] == "s"
        );
        allow_req_esm: bool = process_get_require_esm();
        # `import defer` must still instantiate as an ESM namespace without
        # evaluation — side-effect-only fixtures (common in test262) have neither
        # import nor export, so force the ESM path whenever defer phase is active.
        # Dynamic `import()` creates a Module Record for a plain script target
        # (test262 eval-script-code-target: script-valid `var`+`function` same-name
        # is a Module early SyntaxError) — but NOT for a CommonJS file: one that
        # uses module.exports / require / __dirname and has no import/export is
        # loaded as CJS, as Node does (react-refresh/babel via @vitejs/plugin-react's
        # `import("react-refresh/babel")` threw "require is not defined in ES
        # module scope").
        _esm_by_ctx: bool = (
            is_esm_import != 0 or (self.sync_require_esm > 0 and allow_req_esm)
        );
        # JS builtins are CJS by contract (_load_js_builtin_exports forces the
        # CJS context) — never ESM-sniff them. _source_is_module fully tokenizes
        # the source, and doing that for every builtin at startup dominated boot
        # (the lexer's per-char str ops each recompute strlen on the unstamped
        # source string — ~950M strlen instructions before this guard).
        _is_builtin_src: bool = "/src/builtins/js/" in resolved;
        if (
            mod_format == "cjs-js"
            and not is_dot_cjs
            and not _is_builtin_src
            and (
                self.import_defer_phase != 0
                or (
                    self.dynamic_import_active != 0
                    and (
                        not _source_uses_cjs_bindings(source)
                        or _source_is_module(source)
                    )
                )
                or (_esm_by_ctx and _source_is_module(source))
            )
        ) {
            mod_format = "esm-js";
        }

        # Source-phase import (`import.source` / `import source … from`):
        # Source Text Module Record's GetModuleSource always throws SyntaxError
        # (test262 import-source-source-text-module).  Only WebAssembly module
        # records expose a usable module source in this host.
        if self.import_source_phase != 0 and mod_format != "wasm" {
            self.had_exception = True;
            self.pending_exc = make_syntax_error(
                "Source phase import is not available for Source Text Module"
            );
            return js_undefined();
        }

        # --no-experimental-require-module: require() of detected ESM / .mjs must
        # fail. Ambiguous `.js` with export tokens → SyntaxError (Node); explicit
        # ESM (`.mjs` / type:module) → ERR_REQUIRE_ESM.
        if (
            self.sync_require_esm > 0
            and is_esm_import == 0
            and self.dynamic_import_active == 0
            and not allow_req_esm
            and (
                mod_format == "esm-js"
                or (
                    mod_format == "cjs-js"
                    and not is_dot_cjs
                    and not _is_builtin_src
                    and _source_is_module(source)
                )
            )
        ) {
            self.had_exception = True;
            if mod_format == "esm-js" {
                self.pending_exc = make_err_require_esm(
                    "require() of ES Module "
                        + resolved
                        + " not supported. "
                        + "Instead change the require of "
                        + resolved
                        + " to a dynamic import() which is available in all CommonJS modules."
                );
            } else {
                self.pending_exc = make_syntax_error("Unexpected token 'export'");
            }
            return js_undefined();
        }
        if mod_format == "esm-js" {
            ast_esm: ASTNode = self._esm_take_meta_ast(resolved, source);
            # Register ExportEntries from the AST we evaluate, then validate
            # IndirectExportEntries (circular / ambiguous ResolveExport → SyntaxError
            # at Instantiation). Registered straight from ast_esm: going through
            # _esm_ensure_export_meta re-read and re-parsed the whole module. The
            # sentinel lets a circular re-export back to this module find it.
            if not esm_export_meta_has(resolved) {
                sentinel_meta: list[str] = [];
                esm_export_meta_set(resolved, sentinel_meta);
            }
            abs_meta: list[str] = self._esm_register_export_meta(resolved, ast_esm);
            inst_err: str = esm_validate_indirect_exports(resolved);
            if inst_err != "" {
                self.had_exception = True;
                self.pending_exc = make_syntax_error(inst_err);
                esm_export_meta_delete(resolved);
                return js_undefined();
            }
            c_esm = make_compiler();
            mod_exp_gname: str = "__jac_modexp_" + resolved;
            c_esm.esm_exports_global = mod_exp_gname;
            c_esm.source_file = resolved;
            # Feed the module source so each function's source slice is captured
            # for Function.prototype.toString (compiler.jac ~L7893). Without this,
            # every function in an ESM module stringified to "[native code]" —
            # breaking vite's modulepreload polyfill (`${polyfill.toString()}`).
            c_esm.source_text = source;
            self.current_esm_exports_global = mod_exp_gname;
            top_fn_esm = c_esm.compile_program(ast_esm);
            if c_esm.had_error {
                ce_msg_esm: str = c_esm.last_error_msg;
                if ce_msg_esm == "" {
                    ce_msg_esm = "Invalid or unexpected token";
                }
                if ce_msg_esm.startswith("SyntaxError: ") {
                    ce_msg_esm = ce_msg_esm[13:];
                }
                self.had_exception = True;
                self.pending_exc = make_syntax_error(ce_msg_esm);
                esm_export_meta_delete(resolved);
                return js_undefined();
            }

            saved_module_fns_esm: list[CompiledFunction] = self.module_fns;
            saved_dir_esm: str = self.script_dir;
            saved_esm_flag: int = self.esm_entry;

            req_exports_esm: JSValue = js_object_create_null();
            saved_jac_exp_esm: JSValue = js_undefined();
            saved_mod_exp_esm: JSValue = js_undefined();
            had_mod_exp_esm: int = 0;
            saved_fn_esm: JSValue = js_undefined();
            saved_dn_esm: JSValue = js_undefined();
            if "__jac_esm_exports" in self.globals {
                saved_jac_exp_esm = self.globals["__jac_esm_exports"];
            }
            if mod_exp_gname in self.globals {
                saved_mod_exp_esm = self.globals[mod_exp_gname];
                had_mod_exp_esm = 1;
            }
            if "__filename" in self.globals {
                saved_fn_esm = self.globals["__filename"];
            }
            if "__dirname" in self.globals {
                saved_dn_esm = self.globals["__dirname"];
            }
            self.globals["__jac_esm_exports"] = req_exports_esm;
            self.gw_epoch = self.gw_epoch + 1;
            self.globals[mod_exp_gname] = req_exports_esm;
            self.gw_epoch = self.gw_epoch + 1;
            self.globals["__filename"] = js_str(resolved);
            self.gw_epoch = self.gw_epoch + 1;
            self.globals["__dirname"] = js_str(path_dirname(resolved));
            self.gw_epoch = self.gw_epoch + 1;
            self.esm_entry = 1;
            # A dynamic import set require_parent_override to the IMPORTER so THIS
            # specifier resolved against it. That is done now: this module's own
            # static imports must resolve against ITS dir (__filename/script_dir,
            # just set), not the importer's. Leaving it set made a dynamically-
            # imported module's `import './x'` resolve against the importer's dir.
            saved_rpo_esm2: str = self.require_parent_override;
            self.require_parent_override = "";

            # Mark as Module Namespace Exotic before evaluation so self-imports
            # observe exotic [[Set]]/[[Delete]]/[[IsExtensible]]/@@toStringTag.
            self._mark_esm_namespace(req_exports_esm);
            # Instantiation: own keys for every ExportEntry exist before evaluation
            # (so [[Delete]]/[[HasProperty]] see TDZ exports).
            self._preseed_namespace_exports(req_exports_esm, abs_meta);

            # `import defer * as ns` / import.defer(): instantiate namespace, skip
            # evaluation — EXCEPT GatherAsynchronousTransitiveDependencies: any
            # module with HasTLA in the static import graph is evaluated eagerly
            # before the defer promise resolves (ES ContinueDynamicImport).
            if self.import_defer_phase != 0 {
                defer_seen: dict[str, bool] = {};
                async_deps: list[str] = self._gather_async_transitive_deps(
                    resolved, ast_esm, defer_seen
                );
                self_has_tla: bool = False;
                for ad in async_deps {
                    if ad == resolved {
                        self_has_tla = True;
                    }
                }
                if not self_has_tla and len(async_deps) > 0 {
                    # Evaluate async transitive deps with defer phase off.
                    saved_def_eval: int = self.import_defer_phase;
                    saved_dir_def: str = self.script_dir;
                    saved_fn_def: JSValue = js_undefined();
                    saved_dn_def: JSValue = js_undefined();
                    if "__filename" in self.globals {
                        saved_fn_def = self.globals["__filename"];
                    }
                    if "__dirname" in self.globals {
                        saved_dn_def = self.globals["__dirname"];
                    }
                    self.import_defer_phase = 0;
                    self.script_dir = path_dirname(resolved);
                    self.globals["__filename"] = js_str(resolved);
                    self.gw_epoch = self.gw_epoch + 1;
                    self.globals["__dirname"] = js_str(path_dirname(resolved));
                    self.gw_epoch = self.gw_epoch + 1;
                    for ad in async_deps {
                        _ = self._require_module(ad);
                        if self.had_exception {
                            break;
                        }
                    }
                    self.import_defer_phase = saved_def_eval;
                    self.script_dir = saved_dir_def;
                    self.globals["__filename"] = saved_fn_def;
                    self.gw_epoch = self.gw_epoch + 1;
                    self.globals["__dirname"] = saved_dn_def;
                    self.gw_epoch = self.gw_epoch + 1;
                    if self.had_exception {
                        self.module_fns = saved_module_fns_esm;
                        self.script_dir = saved_dir_esm;
                        self.esm_entry = saved_esm_flag;
                        self.current_esm_exports_global = "";
                        self.globals["__jac_esm_exports"] = saved_jac_exp_esm;
                        self.gw_epoch = self.gw_epoch + 1;
                        if had_mod_exp_esm != 0 {
                            self.globals[mod_exp_gname] = saved_mod_exp_esm;
                            self.gw_epoch = self.gw_epoch + 1;
                        }
                        self.globals["__filename"] = saved_fn_esm;
                        self.gw_epoch = self.gw_epoch + 1;
                        self.globals["__dirname"] = saved_dn_esm;
                        self.gw_epoch = self.gw_epoch + 1;
                        self.require_parent_override = saved_rpo_esm2;
                        return js_undefined();
                    }
                }
                if self_has_tla {
                    # Module itself has TLA — fall through to normal evaluation
                    # (do not leave a deferred pending namespace).
                } else {
                    js_object_define_nonenum(
                        req_exports_esm, str_intern("__DEFER_PENDING"), js_true()
                    );
                    js_object_define_nonenum(
                        req_exports_esm, str_intern("__DEFER_PATH"), js_str(resolved)
                    );
                    module_cache_set(resolved, req_exports_esm);
                    self.module_fns = saved_module_fns_esm;
                    self.script_dir = saved_dir_esm;
                    self.esm_entry = saved_esm_flag;
                    self.current_esm_exports_global = "";
                    # Restore importer globals (set above before the defer early-return).
                    self.globals["__jac_esm_exports"] = saved_jac_exp_esm;
                    self.gw_epoch = self.gw_epoch + 1;
                    if had_mod_exp_esm != 0 {
                        self.globals[mod_exp_gname] = saved_mod_exp_esm;
                        self.gw_epoch = self.gw_epoch + 1;
                    } else {
                        self.globals[mod_exp_gname] = req_exports_esm;
                        self.gw_epoch = self.gw_epoch + 1;
                    }
                    self.globals["__filename"] = saved_fn_esm;
                    self.gw_epoch = self.gw_epoch + 1;
                    self.globals["__dirname"] = saved_dn_esm;
                    self.gw_epoch = self.gw_epoch + 1;
                    self.require_parent_override = saved_rpo_esm2;
                    return req_exports_esm;
                }
            }

            saved_req_file: str = self.sync_require_esm_file;
            saved_req_parent: str = self.sync_require_esm_parent;
            if self.sync_require_esm > 0 {
                self.sync_require_esm_file = resolved;
                self.sync_require_esm_parent = parent_file;
            }

            module_cache_set(resolved, req_exports_esm);
            self.module_fns = c_esm.all_fns;
            self.script_dir = path_dirname(resolved);
            self.run(top_fn_esm, js_undefined(), [], [], js_undefined());

            if self.sync_require_esm > 0 {
                self.sync_require_esm_file = saved_req_file;
                self.sync_require_esm_parent = saved_req_parent;
            }

            # require(esm) with TLA → ERR_REQUIRE_ASYNC_MODULE (Node 22+).
            if self.sync_require_esm > 0
                and self.vm_awaiting
                and not self.had_exception {
                self.vm_awaiting = False;
                self.had_exception = True;
                self.pending_exc = make_err_require_async_module_full(
                    resolved, parent_file
                );
            }

            if self.had_exception {
                # Evict failed module from cache (Node: do not retain broken modules).
                module_cache_delete(resolved);
                self.module_fns = saved_module_fns_esm;
                self.script_dir = saved_dir_esm;
                self.esm_entry = saved_esm_flag;
                self.current_esm_exports_global = "";
                self.globals["__jac_esm_exports"] = saved_jac_exp_esm;
                self.gw_epoch = self.gw_epoch + 1;
                if had_mod_exp_esm != 0 {
                    self.globals[mod_exp_gname] = saved_mod_exp_esm;
                    self.gw_epoch = self.gw_epoch + 1;
                } else {
                    self.globals[mod_exp_gname] = req_exports_esm;
                    self.gw_epoch = self.gw_epoch + 1;
                }
                self.globals["__filename"] = saved_fn_esm;
                self.gw_epoch = self.gw_epoch + 1;
                self.globals["__dirname"] = saved_dn_esm;
                self.gw_epoch = self.gw_epoch + 1;
                self.require_parent_override = saved_rpo_esm2;
                # Leave had_exception / pending_exc set so require()/import rethrows.
                return js_undefined();
            }

            final_esm: JSValue = req_exports_esm;
            self.module_fns = saved_module_fns_esm;
            self.script_dir = saved_dir_esm;
            self.esm_entry = saved_esm_flag;
            self.current_esm_exports_global = "";
            self.globals["__jac_esm_exports"] = saved_jac_exp_esm;
            self.gw_epoch = self.gw_epoch + 1;
            if had_mod_exp_esm != 0 {
                self.globals[mod_exp_gname] = saved_mod_exp_esm;
                self.gw_epoch = self.gw_epoch + 1;
            } else {
                self.globals[mod_exp_gname] = req_exports_esm;
                self.gw_epoch = self.gw_epoch + 1;
            }
            self.globals["__filename"] = saved_fn_esm;
            self.gw_epoch = self.gw_epoch + 1;
            self.globals["__dirname"] = saved_dn_esm;
            self.gw_epoch = self.gw_epoch + 1;
            self.require_parent_override = saved_rpo_esm2;
            # Native ESM namespaces must NOT invent a synthetic `default`.
            # CJS↔ESM interop uses esm_cjs_namespace_for / esm_builtin_namespace_for.
            self._finalize_esm_namespace(final_esm);
            module_cache_set(resolved, final_esm);
            # Node populateCJSExportsFromESM for require(esm).
            if self.sync_require_esm > 0 {
                return self._shape_require_esm_exports(final_esm);
            }
            if is_esm_import != 0 or self.dynamic_import_active != 0 {
                if is_builtin_module(mod_bare) or self._is_js_builtin(mod_bare) {
                    return esm_builtin_namespace_for(mod_bare, final_esm);
                }
            }
            return final_esm;
        }

        # 5b. Parse and compile (CJS) via shared module._compile path
        req_module: JSValue = self._build_cjs_module_object(resolved, parent_mod);
        req_exports: JSValue = js_object_get(req_module, WK_EXPORTS);
        self._wire_module_parent_child(req_module, parent_mod);
        self._cache_cjs_module(resolved, req_module, req_exports);

        final_exports: JSValue = self._cjs_run_in_module(req_module, source, resolved);
        if self.had_exception {
            # Propagate the load failure: do not finalize/cache a broken module.
            # Node deletes the entry from require.cache when module evaluation throws.
            module_cache_delete(resolved);
            if jsv_is_object_cell(_REQUIRE_CACHE_OBJ) {
                js_object_delete(_REQUIRE_CACHE_OBJ, str_intern(resolved));
            }
            return js_undefined();
        }

        return self._finalize_cjs_module(
            req_module, resolved, final_exports, mod_bare, is_esm_import
        );
    }

    """
    Resume a suspended generator object.
    On YIELD:   saves frame state back into JSGeneratorState, returns {value, done:false}.
    On RETURN:  marks generator done, returns {value, done:true}.
    On throw:   marks generator done, propagates exception.
    ECMAScript §27.5.1.2 GeneratorResume.
    """
    def run_generator(
        gen_obj: JSValue, send_val: JSValue, throw_mode: bool, ret_mode: bool
    ) -> JSValue {
        rg_raw: bool = self.gen_raw;
        self.gen_raw = False;
        if not js_is_generator(gen_obj) {
            return js_iter_result(js_undefined(), True);
        }
        state: JSGeneratorState = js_get_generator_state(gen_obj);
        is_ag: bool = js_is_async_generator(gen_obj);
        rg_abrupt_ret: bool = False;
        # ES §27.5.3.3 GeneratorResume / §27.5.3.4 GeneratorResumeAbrupt: a
        # generator whose body is currently on the stack ("executing") must not be
        # re-entered — throw a TypeError. Prevents unbounded self-recursion when a
        # yielded value's consumer calls back into the same generator's next().
        if state.executing {
            gen_re_err: JSValue = make_type_error("Generator is already running");
            if is_ag {
                rg_run_p: JSValue = js_promise_create();
                self._promise_settle_and_drain(rg_run_p, PROMISE_REJECTED, gen_re_err);
                return rg_run_p;
            }
            self.had_exception = True;
            self.pending_exc = gen_re_err;
            return js_iter_result(js_undefined(), True);
        }
        if state.done {
            if is_ag {
                rg_done_p: JSValue = js_promise_create();
                self._promise_settle_and_drain(
                    rg_done_p, PROMISE_FULFILLED, js_iter_result(js_undefined(), True)
                );
                return rg_done_p;
            }
            if rg_raw {
                self.gen_raw_hit = True;
                self.gen_raw_done = True;
                return js_undefined();
            }
            return js_iter_result(js_undefined(), True);
        }

        # Async generator: create a per-.next() outer promise and wire _cur_async_promise.
        # Every .next()/.throw()/.return() call gets its own Promise<{value,done}>.
        rg_outer_p: JSValue = js_undefined();
        rg_old_cap: JSValue = self._cur_async_promise;
        if is_ag {
            rg_outer_p = js_promise_create();
            self._cur_async_promise = rg_outer_p;
        }

        # Force-close via .return(val)
        # When an *external* (non-generator) yield* delegate is active, .return()
        # and .throw() must be forwarded to that iterator's own return/throw method
        # (ES §14.4.14) — the forwarding block below drives that, and the inner
        # iterator may legitimately keep yielding.  Skip the generic force-close.
        rg_ext_delegate: bool = jsv_is_object_cell(state.delegate_gen)
            and not js_is_generator(state.delegate_gen);
        if ret_mode and not rg_ext_delegate {
            # Close active yield* generator delegate before completing outer .return()
            if js_is_generator(state.delegate_gen) {
                self.run_generator(state.delegate_gen, send_val, False, True);
                state.delegate_gen = js_undefined();
            }
            if state.saved_ip > 0
                and not state.done
                and (
                    len(state.catch_stack) > 0
                    or _reg_handler_at(state.func, state.saved_ip - 1) >= 0
                ) {
                # Suspended inside try/finally — jump to try handler (finally path)
                state.ret_mode = True;
                state.send_val = send_val;
                rg_abrupt_ret = True;
                send_val = js_undefined();
                throw_mode = False;
            } else {
                state.done = True;
                js_set_generator_state(gen_obj, state);
                if is_ag {
                    self._cur_async_promise = rg_old_cap;
                    self._promise_settle_and_drain(
                        rg_outer_p, PROMISE_FULFILLED, js_iter_result(send_val, True)
                    );
                    return rg_outer_p;
                }
                return js_iter_result(send_val, True);
            }
        }

        # ── yield* delegate forwarding ───────────────────────────────────
        # If delegate_gen is active, forward call to it; resume outer when done.
        if js_is_generator(state.delegate_gen) {
            del_result: JSValue = self.run_generator(
                state.delegate_gen, send_val, throw_mode, state.ret_mode
            );
            # An ASYNC-generator delegate's .next() returns a Promise<{value,done}>
            # (ES §27.6), not a bare result object. Unwrap the settled promise so the
            # {value,done} read below works. (A REJECTED delegate promise re-throws
            # into the outer generator; a still-PENDING one means the delegate awaited
            # — extremely rare here — and is surfaced as a rejection for now.)
            if js_is_promise(del_result) {
                del_pst: int = js_promise_get_state(del_result);
                if del_pst == PROMISE_REJECTED {
                    del_rexc: JSValue = js_promise_get_value(del_result);
                    # yield* consumes the delegate's rejection (it re-throws into the
                    # outer generator): not an unhandled rejection.
                    promise_unmark_unhandled(del_result);
                    state.delegate_gen = js_undefined();
                    js_set_generator_state(gen_obj, state);
                    if is_ag {
                        self._cur_async_promise = rg_old_cap;
                    }
                    return self.run_generator(gen_obj, del_rexc, True, False);
                }
                del_result = js_promise_get_value(del_result);
                if not jsv_is_object_cell(del_result) {
                    del_result = js_iter_result(js_undefined(), True);
                }
            }
            del_done: bool = jsv_to_bool(js_object_get(del_result, WK_DONE));
            if not del_done {
                # Delegate still running — outer stays suspended, return inner value.
                # For an ASYNC generator, every .next() must resolve to a Promise
                # (ES §27.6): settle the per-call outer promise with the delegated
                # {value,done:false} rather than returning the raw result object.
                js_set_generator_state(gen_obj, state);
                if is_ag {
                    self._cur_async_promise = rg_old_cap;
                    self._promise_settle_and_drain(
                        rg_outer_p, PROMISE_FULFILLED, del_result
                    );
                    return rg_outer_p;
                }
                return del_result;
            } else {
                # Delegate exhausted — clear it, inject its return value, continue outer
                state.delegate_gen = js_undefined();
                send_val = js_object_get(del_result, WK_VALUE);
                throw_mode = False;
                if state.ret_mode {
                    send_val = js_undefined();
                }
            }
        } elif jsv_is_object_cell(state.delegate_gen) {
            # External (non-generator) delegate — one spec §14.4.14 step in the
            # right mode: normal next / forwarded throw / forwarded return.
            ys_mode: int = 0;
            if throw_mode {
                ys_mode = 1;
            } elif ret_mode or state.ret_mode {
                ys_mode = 2;
            }
            ys_ext_iter: JSValue = state.delegate_gen;
            # Cleared so it reliably reflects THIS step: _vm_ys_normalize sets it (the raw
            # inner result) only when IteratorComplete found done===false. A fast-path
            # (array/map/set) delegate returns a plain {value,done} without normalize and
            # leaves it undefined — that plain result is safe to re-read (no getters).
            self.ys_yield_result = js_undefined();
            del_result2: JSValue = _vm_iter_next_delegate_mode(
                self, ys_ext_iter, send_val, ys_mode, is_ag
            );
            if self.had_exception {
                # Get/call error, non-object result, or missing-`throw` TypeError —
                # re-raise inside the outer generator (throw-mode resume) so its own
                # try/catch at the yield* site can handle it.
                state.delegate_gen = js_undefined();
                exc_ys_ext: JSValue = self.pending_exc;
                self.had_exception = False;
                self.pending_exc = js_undefined();
                js_set_generator_state(gen_obj, state);
                return self.run_generator(gen_obj, exc_ys_ext, True, False);
            }
            if self.ys_return_out {
                # Inner return (or absent return method) → ReturnCompletion(value).
                self.ys_return_out = False;
                state.delegate_gen = js_undefined();
                ys_ret_val: JSValue = js_object_get(del_result2, WK_VALUE);
                return self.run_generator(gen_obj, ys_ret_val, False, True);
            }
            # Determine done WITHOUT a second observable `.done` read: when
            # _vm_ys_normalize stashed the raw inner result (ys_yield_result set), it
            # already found done===false via IteratorComplete — re-reading `.done` here
            # would fire a `get done` accessor a second time (async-gen-yield-star-async-*).
            # A fast-path/plain result leaves the stash empty; re-reading its data `.done`
            # is side-effect-free.
            del_done2: bool = False;
            if jsv_is_object_cell(self.ys_yield_result) {
                del_done2 = False;
            } else {
                del_done2 = jsv_to_bool(js_object_get(del_result2, WK_DONE));
            }
            if not del_done2 {
                # Inner yielded — surface the inner result. For an ASYNC generator,
                # wrap it in the per-call outer Promise (ES §27.6) instead of
                # returning the raw {value,done} object.
                ys_surf: JSValue = self.ys_yield_result;
                self.ys_yield_result = js_undefined();
                js_set_generator_state(gen_obj, state);
                ys_out_result: JSValue = del_result2;
                if jsv_is_object_cell(ys_surf) {
                    ys_out_result = ys_surf;
                }
                if is_ag {
                    # IteratorValue(innerResult): read `.value` ONCE via its GETTER (spec-
                    # instrumented; `.done` was already read by _vm_ys_normalize) and
                    # surface a fresh {value, done:false}. Whether the value is Await'ed
                    # depends on the iterator kind:
                    #   - SYNC iterable (WK_FROM_SYNC): AsyncFromSyncIteratorContinuation
                    #     (§27.1.4.4) Awaits it — a rejected promise throws into the outer
                    #     generator (yield-promise-reject-next-yield-star-sync-iterator).
                    #   - real ASYNC iterator: the value passes through UNWRAPPED — a manual
                    #     async iterator that yields a promise is NOT unwrapped (test262
                    #     yield-star-promise-not-unwrapped).
                    if jsv_is_object_cell(ys_out_result) {
                        ys_out_val: JSValue = self._get_prop_accessor(
                            ys_out_result, WK_VALUE
                        );
                        if self.had_exception or vm_has_native_exc() {
                            ys_ve: JSValue = vm_take_native_exc()
                                if vm_has_native_exc()
                                else self.pending_exc;
                            self.had_exception = False;
                            self.pending_exc = js_undefined();
                            self._cur_async_promise = rg_old_cap;
                            state.delegate_gen = js_undefined();
                            js_set_generator_state(gen_obj, state);
                            return self.run_generator(gen_obj, ys_ve, True, False);
                        }
                        ys_fsm: JSValue = js_object_get(ys_ext_iter, WK_FROM_SYNC);
                        ys_is_fsync: bool = jsv_is_bool(ys_fsm) and jsv_to_bool(ys_fsm);
                        if ys_is_fsync and js_is_promise(ys_out_val) {
                            ys_out_pst: int = js_promise_get_state(ys_out_val);
                            if ys_out_pst == PROMISE_REJECTED {
                                # AsyncFromSyncIteratorContinuation awaits the value: its
                                # rejection is handled (thrown into the outer generator).
                                promise_unmark_unhandled(ys_out_val);
                                self._cur_async_promise = rg_old_cap;
                                state.delegate_gen = js_undefined();
                                js_set_generator_state(gen_obj, state);
                                return self.run_generator(
                                    gen_obj,
                                    js_promise_get_value(ys_out_val),
                                    True,
                                    False
                                );
                            } elif ys_out_pst == PROMISE_FULFILLED {
                                ys_out_val = js_promise_get_value(ys_out_val);
                            }
                        }
                        ys_out_result = js_iter_result(ys_out_val, False);
                    }
                    self._cur_async_promise = rg_old_cap;
                    self._promise_settle_and_drain(
                        rg_outer_p, PROMISE_FULFILLED, ys_out_result
                    );
                    return rg_outer_p;
                }
                return ys_out_result;
            } else {
                # Inner exhausted on a normal next → value becomes the yield* result.
                state.delegate_gen = js_undefined();
                send_val = js_object_get(del_result2, WK_VALUE);
                throw_mode = False;
                if state.ret_mode {
                    send_val = js_undefined();
                }
            }
        }

        self.call_depth = self.call_depth + 1;
        if self.call_depth > VM_MAX_CALL_DEPTH {
            self.call_depth = self.call_depth - 1;
            state.done = True;
            js_set_generator_state(gen_obj, state);
            self.pending_exc = make_range_error("Maximum call stack size exceeded");
            self.had_exception = True;
            if is_ag {
                self._cur_async_promise = rg_old_cap;
                exc_rg_oom: JSValue = self.pending_exc;
                self.had_exception = False;
                self.pending_exc = js_undefined();
                self._promise_settle_and_drain(
                    rg_outer_p, PROMISE_REJECTED, exc_rg_oom
                );
                return rg_outer_p;
            }
            return js_iter_result(js_undefined(), True);
        }

        # Restore frame from saved state
        sbase: int = len(self.stack);
        # Restore saved operand stack slice (values pushed before yield)
        for sv in state.saved_stack {
            self.stack.append(sv);
        }

        frame: CallFrame = self._gen_frame_acquire(state, sbase, gen_obj);
        self.frames.append(frame);
        frame.rpc = state.saved_rpc;
        if frame.rpc == 0
            and state.saved_ip > 0
            and state.saved_ip == state.func.gen_prologue_end_ip
            and self._reg_ready(state.func)
            and state.func.reg_gen_start >= 0 {
            # First run of a register-ISA body whose parameter prologue
            # _run_gen_prologue already executed: start after it.
            frame.rpc = state.func.reg_gen_start;
        }

        if rg_abrupt_ret {
            nc_ab: int = len(frame.catch_stack);
            if nc_ab == 0 and _reg_handler_at(frame.func, frame.ip - 1) >= 0 {
                frame.rpc = _reg_handler_at(frame.func, frame.ip - 1);
                self._gen_ret_pending = True;
            } elif nc_ab > 0 {
                # (a register frame's catch stack holds register pcs)
                if frame.func.risa == 1 {
                    frame.rpc = frame.catch_stack[nc_ab - 1];
                } else {
                    frame.ip = frame.catch_stack[nc_ab - 1];
                }
                del frame.catch_stack[nc_ab - 1];
                # Signal an in-flight forced-return so a destructuring IteratorClose
                # handler (ITER_CLOSE_THRW) reached during this unwind closes its
                # iterator and re-raises the *return* rather than a throw.  Harmless
                # for ordinary try/finally handlers: they complete via RETURN without
                # touching ITER_CLOSE_THRW, and the flag is cleared on completion.
                self._gen_ret_pending = True;
            }
        }

        # Inject sent value: on resume the YIELD expression evaluates to `send_val`
        # (or throw_mode raises it)
        if throw_mode {
            exc_inj: JSValue = send_val;
            if not self._unwind_in_frame(frame, exc_inj) {
                self.had_exception = True;
                self.pending_exc = exc_inj;
            }
        } elif not state.ret_mode {
            # send_val becomes the result of the yield expression
            self._reg_resume_value(frame, send_val);
        }

        self.yielded = False;
        result: JSValue = js_undefined();
        # Mark the generator as executing (persisted to the table) so any re-entrant
        # next/throw/return during _exec is rejected with a TypeError at the guard
        # above (ES §27.5.3.3). Cleared unconditionally after _exec returns.
        state.executing = True;
        js_set_generator_state(gen_obj, state);
        # Run the body in the generator's own compilation unit (like run_cl does for
        # a closure): MAKE_CLOSURE indexes self.module_fns, and .next() often comes
        # from another module. Babel's chainWalker, stepped by gensync, created its
        # `({config: {...}}) => ...` arrow as gensync's assertTypeof and every
        # plugin-react transform failed ("makeError is not a function").
        rg_saved_mf: list[CompiledFunction] = self.module_fns;
        if len(state.module_fns) > 0 {
            self.module_fns = state.module_fns;
        }
        if not self.had_exception {
            result = self._drain_tail_channel(self._exec_any(frame));
        }
        self.module_fns = rg_saved_mf;
        # Body has suspended (yield/await) or completed — no longer on the stack.
        gen_exec_state: JSGeneratorState = js_get_generator_state(gen_obj);
        gen_exec_state.executing = False;
        js_set_generator_state(gen_obj, gen_exec_state);
        state.executing = False;

        # Restore _cur_async_promise (was set to rg_outer_p for async generators above)
        if is_ag {
            self._cur_async_promise = rg_old_cap;
        }

        # Save frame state back before cleanup
        saved_stk: list[JSValue] = [];
        # Capture any extra items pushed onto the stack (from sub-expressions)
        # above sbase that weren't cleaned by _exec (stack residue from yield point)
        cur_sp: int = len(self.stack);
        extra: int = cur_sp - sbase;
        if extra > 0 {
            si2: int = 0;
            while si2 < extra {
                saved_stk.append(self.stack[sbase + si2]);
                si2 = si2 + 1;
            }
        }

        # Clean up stack
        while len(self.stack) > sbase {
            del self.stack[len(self.stack) - 1];
        }
        nfg: int = len(self.frames);
        del self.frames[nfg - 1];
        self.call_depth = self.call_depth - 1;
        # the frame is reused by the next step unless an AWAIT keeps it
        if not self.vm_awaiting and len(self.gen_frame_pool) < 16 {
            self.gen_frame_pool.append(frame);
        }

        if self.had_exception {
            exc_g: JSValue = self.pending_exc;
            self.had_exception = False;
            self.pending_exc = js_undefined();
            state.done = True;
            js_set_generator_state(gen_obj, state);
            if is_ag {
                # Async gen: settle outer promise REJECTED; do NOT re-raise
                self._promise_settle_and_drain(rg_outer_p, PROMISE_REJECTED, exc_g);
                return rg_outer_p;
            }
            # Re-propagate — caller must check self.had_exception
            self.had_exception = True;
            self.pending_exc = exc_g;
            return js_iter_result(js_undefined(), True);
        }

        if self.vm_awaiting {
            # Async generator body hit AWAIT with a PENDING promise.
            # The inner frame is saved in self.realm.generators with:
            #   delegate_gen = gen_obj  (set by the AWAIT PENDING handler via frame.self_fn)
            #   async_promise = rg_outer_p
            # When the timer fires _resume_async_frame will continue the body.
            # On YIELD it saves gen state and settles rg_outer_p with {value, done:false}.
            # We do NOT mark state.done here.
            self.vm_awaiting = False;
            return rg_outer_p;
        }

        if self.yielded {
            # Check if this was a YIELD_STAR — save outer state, set delegate, recurse
            if self.yielded_star {
                self.yielded_star = False;
                self.yielded = False;
                # Save outer frame so we can resume it when delegate is done
                state.saved_ip = frame.ip;
                state.saved_rpc = frame.rpc;
                state.locals = frame.locals;
                state.catch_stack = frame.catch_stack;
                state.saved_stack = saved_stk;
                state.delegate_gen = _vm_materialize_delegate_iter(self, result, is_ag);
                if self.had_exception {
                    # GetIterator (Symbol.iterator get / call / non-object result)
                    # threw — surface it at the yield* site so the generator's own
                    # try/catch can handle it (resume in throw-mode, don't kill it).
                    exc_ys: JSValue = self.pending_exc;
                    self.had_exception = False;
                    self.pending_exc = js_undefined();
                    state.delegate_gen = js_undefined();
                    js_set_generator_state(gen_obj, state);
                    return self.run_generator(gen_obj, exc_ys, True, False);
                }
                js_set_generator_state(gen_obj, state);
                # Re-enter: the delegate-forwarding block at the top will drive it
                return self.run_generator(gen_obj, js_undefined(), False, False);
            }
            # Suspended at a YIELD: save state
            self.yielded = False;
            state.saved_ip = frame.ip;
            state.saved_rpc = frame.rpc;
            state.locals = frame.locals;
            state.catch_stack = frame.catch_stack;
            state.saved_stack = saved_stk;
            js_set_generator_state(gen_obj, state);
            if is_ag {
                ag_yval: JSValue = result;
                if js_is_promise(ag_yval) {
                    ag_pst: int = js_promise_get_state(ag_yval);
                    if ag_pst == PROMISE_FULFILLED {
                        ag_yval = js_promise_get_value(ag_yval);
                    } elif ag_pst == PROMISE_REJECTED {
                        exc_ag: JSValue = js_promise_get_value(ag_yval);
                        state.done = True;
                        js_set_generator_state(gen_obj, state);
                        self._promise_settle_and_drain(
                            rg_outer_p, PROMISE_REJECTED, exc_ag
                        );
                        return rg_outer_p;
                    }
                }
                # Settle outer promise with {value, done:false}
                self._promise_settle_and_drain(
                    rg_outer_p, PROMISE_FULFILLED, js_iter_result(ag_yval, False)
                );
                return rg_outer_p;
            }
            if rg_raw {
                self.gen_raw_hit = True;
                self.gen_raw_done = False;
                return result;
            }
            return js_iter_result(result, False);
        } else {
            # Generator returned (RETURN / RETURN_UNDEFINED / ran off end)
            state.done = True;
            self._gen_ret_pending = False;  # forced-return fully unwound
            close_val: JSValue = result;
            if state.ret_mode {
                close_val = state.send_val;
                state.ret_mode = False;
            }
            js_set_generator_state(gen_obj, state);
            if is_ag {
                self._promise_settle_and_drain(
                    rg_outer_p, PROMISE_FULFILLED, js_iter_result(close_val, True)
                );
                return rg_outer_p;
            }
            if rg_raw {
                self.gen_raw_hit = True;
                self.gen_raw_done = True;
                return close_val;
            }
            return js_iter_result(close_val, True);
        }
    }

    """A frame for one generator step: a pooled one with every field the
    CallFrame constructor sets reset (the rare lists cleared when `rare`;
    catch_stack is the generator's own), else a new one."""
    def _gen_frame_acquire(
        state: JSGeneratorState, sbase: int, gen_obj: JSValue
    ) -> CallFrame {
        if len(self.gen_frame_pool) > 0 {
            gf: CallFrame = self.gen_frame_pool[len(self.gen_frame_pool) - 1];
            del self.gen_frame_pool[len(self.gen_frame_pool) - 1];
            gf.func = state.func;
            gf.ip = state.saved_ip;
            gf.stack_base = sbase;
            gf.locals = state.locals;
            gf.catch_stack = state.catch_stack;
            gf.free_vals = state.free_vals;
            gf.this_val = state.this_val;
            gf.self_fn = gen_obj;
            gf.win = False;
            gf.lb = 0;
            gf.rpc = 0;
            gf.ret_reg = 0;
            gf.new_target = 0;
            gf.this_uninitialized = False;
            gf.with_inherited = 0;
            gf.this_binding_cell = 0;
            gf.ctor_class = 0;
            gf.ctor_this = 0;
            gf.discard_ret = False;
            gf.mod_swapped = False;
            gf.post_fields = 0;
            gf.saved_mod = 0;
            gf.saved_exp = 0;
            if gf.rare {
                while len(gf.with_objs) > 0 {
                    del gf.with_objs[len(gf.with_objs) - 1];
                }
                while len(gf.catch_with_depths) > 0 {
                    del gf.catch_with_depths[len(gf.catch_with_depths) - 1];
                }
                while len(gf.dispose_stack) > 0 {
                    del gf.dispose_stack[len(gf.dispose_stack) - 1];
                }
                while len(gf.dispose_async) > 0 {
                    del gf.dispose_async[len(gf.dispose_async) - 1];
                }
                while len(gf.dispose_methods) > 0 {
                    del gf.dispose_methods[len(gf.dispose_methods) - 1];
                }
                while len(gf.dispose_marks) > 0 {
                    del gf.dispose_marks[len(gf.dispose_marks) - 1];
                }
                while len(gf.catch_dispose_depths) > 0 {
                    del gf.catch_dispose_depths[len(gf.catch_dispose_depths) - 1];
                }
                while len(gf.dyn_var_names) > 0 {
                    del gf.dyn_var_names[len(gf.dyn_var_names) - 1];
                }
                while len(gf.dyn_var_vals) > 0 {
                    del gf.dyn_var_vals[len(gf.dyn_var_vals) - 1];
                }
                while len(gf.native_roots) > 0 {
                    del gf.native_roots[len(gf.native_roots) - 1];
                }
                gf.rare = False;
            }
            return gf;
        }
        return CallFrame(
            func=state.func,
            ip=state.saved_ip,
            stack_base=sbase,
            locals=state.locals,
            catch_stack=state.catch_stack,
            free_vals=state.free_vals,
            this_val=state.this_val,
            self_fn=gen_obj,
            with_objs=[],
            native_roots=[]
        );
    }

    # ── Interpreter loop ──────────────────────────────────────────────────

    """Main opcode dispatch loop — runs until RETURN / RETURN_UNDEFINED / THROW."""
    def _op_import(frame: CallFrame, ins: Instruction, st: ExecState) {
        imp_src_e: str = frame.func.constants.get(ins.arg);
        saved_esm_e: int = self.require_is_esm;
        # Save/restore the current module's exports-global context across the nested
        # module load.  Loading the imported module (esm-js path) overwrites
        # current_esm_exports_global and leaves it "" on return; without restoring it,
        # a following REEXPORT_LIVE / REEXPORT_STAR / EXPORT in the *importing* module
        # (e.g. `export { v } from './dep.js'`, which compiles to IMPORT then
        # REEXPORT_LIVE) would install the re-export on the wrong exports object — so
        # indirect re-exports silently vanished from the importer's namespace.
        saved_cur_exp_e: str = self.current_esm_exports_global;
        self.require_is_esm = 1;
        # dynamic_import_active only governs the DIRECT target of import() — a
        # transitive static import (e.g. `import picomatch from "picomatch"` inside
        # a module reached via import()) must resolve its format from extension +
        # package.json like Node does, not be blanket-promoted to esm-js.
        saved_dia_imp_e: int = self.dynamic_import_active;
        self.dynamic_import_active = 0;
        # arg2==1 → source-phase import (compile only for .wasm).
        # arg2==2 → deferred evaluation (`import defer * as`).
        saved_src_phase_e: int = self.import_source_phase;
        saved_def_phase_e: int = self.import_defer_phase;
        if ins.arg2 == 1 {
            self.import_source_phase = 1;
        }
        if ins.arg2 == 2 {
            self.import_defer_phase = 1;
        }
        imp_result_e: JSValue = self._require_module(imp_src_e);
        self.import_source_phase = saved_src_phase_e;
        self.import_defer_phase = saved_def_phase_e;
        self.require_is_esm = saved_esm_e;
        self.dynamic_import_active = saved_dia_imp_e;
        self.current_esm_exports_global = saved_cur_exp_e;
        if self.had_exception {
            self._maybe_attach_frames(self.pending_exc, frame);
            st.running = False;
        } else {
            if _IMPORT_DEBUG {
                imp_dbg_pf: str = _get_parent_file(self);
                imp_dbg_resolved: str = module_resolve(
                    imp_src_e, self.script_dir, imp_dbg_pf, 1
                );
                print("[IMPORT OK] " + imp_src_e + " -> " + imp_dbg_resolved);
            }
            self._push(imp_result_e);
        }
    }

    # A module's exports object is marked as the namespace at import time
    # (js_object_mark_module_namespace) — there is no separate namespace-wrap opcode.

    def _op_export(frame: CallFrame, ins: Instruction, st: ExecState) {
        exp_val_e: JSValue = self._pop();
        exp_tgt_e: JSValue = js_undefined();
        if self.current_esm_exports_global != ""
            and self.current_esm_exports_global in self.globals {
            exp_tgt_e = self.globals[self.current_esm_exports_global];
        } elif "__jac_esm_exports" in self.globals {
            exp_tgt_e = self.globals["__jac_esm_exports"];
        } elif "exports" in self.globals {
            exp_tgt_e = self.globals["exports"];
        }
        if jsv_is_object_cell(exp_tgt_e) {
            if js_is_module_namespace(exp_tgt_e) {
                _ = js_object_namespace_export_set(exp_tgt_e, WK_DEFAULT, exp_val_e);
            } else {
                js_object_set(exp_tgt_e, WK_DEFAULT, exp_val_e);
            }
        }
    }

    def _op_dynamic_import(frame: CallFrame, ins: Instruction, st: ExecState) -> None {
        # Merged arg convention (from the merged compiler, compiler.jac ~L5407):
        #   ins.arg  = phase   (0 normal / 1 source-phase / 2 defer-phase)
        #   ins.arg2 = has_opts (an options / attributes object is on the stack)
        # Validation is spec-ordered: ToString(specifier) before GetImportOptions
        # (§13.3.10.1). Flag-based phase semantics (import_source_phase /
        # import_defer_phase → richer source/defer behaviour in _require_module) are
        # applied on the shared tail below, keyed on ins.arg.
        # Optional import options / attributes object (§13.3.10.1). When present it was
        # pushed ABOVE the specifier, so pop it first.
        di_has_opts_e: int = ins.arg2;
        di_resolved_attr_type: str = "";
        di_opts_val_e: JSValue = js_undefined();
        if di_has_opts_e != 0 {
            di_opts_val_e = self._pop();
        }
        di_spec_val_e: JSValue = self._pop();
        # ES §13.3.10.1 EvaluateImportCall: ToString(specifier) runs OBSERVABLY (the
        # object's @@toPrimitive/toString), and if it throws the returned promise is
        # REJECTED with that error (never a synchronous throw). jsval_to_str is the
        # non-observable coercion (objects → "[object Object]") — use ToPrimitive(string)
        # first so a throwing/​custom specifier reports its own error (test262
        # dynamic-import/.../*-specifier-tostring*, catch/*-specifier-tostring*).
        if jsv_is_object_cell(di_spec_val_e)
            or is_fn_val(di_spec_val_e)
            or is_native_val(di_spec_val_e) {
            di_spec_val_e = self._to_primitive_string(di_spec_val_e);
            if self.had_exception or vm_has_native_exc() {
                di_ce_exc: JSValue = vm_take_native_exc()
                    if vm_has_native_exc()
                    else self.pending_exc;
                self.had_exception = False;
                self.pending_exc = js_undefined();
                di_ce_prom: JSValue = js_promise_create();
                self._promise_settle_and_drain(di_ce_prom, PROMISE_REJECTED, di_ce_exc);
                self._push(di_ce_prom);
                return;
            }
        }
        # A Symbol specifier: ToString(Symbol) is a TypeError → reject.
        if jsv_is_symbol(di_spec_val_e) {
            di_sym_prom: JSValue = js_promise_create();
            self._promise_settle_and_drain(
                di_sym_prom,
                PROMISE_REJECTED,
                make_type_error("Cannot convert a Symbol value to a string")
            );
            self._push(di_sym_prom);
            return;
        }
        di_spec_e: str = jsval_to_str(di_spec_val_e);
        if _DBG_ESM_ON {
            _di_dbg: str = "[DBG_ESM] dyn-import spec='" + di_spec_e + "'\n";
            write(2, _di_dbg, len(_di_dbg));
        }
        # Import options / attributes (§13.3.10.1.1 EvaluateImportCall + §13.3.10.2
        # GetImportOptions): if an options argument was supplied and is not undefined,
        # it must be an Object, and Get(options, "with") is read observably (a throwing
        # getter rejects the promise). A non-object options value rejects with a
        # TypeError. Attribute values, when present, must be strings.
        if di_has_opts_e != 0 and not jsv_is_undefined(di_opts_val_e) {
            if not jsv_is_object_cell(di_opts_val_e) {
                di_opt_prom: JSValue = js_promise_create();
                self._promise_settle_and_drain(
                    di_opt_prom,
                    PROMISE_REJECTED,
                    make_type_error("import options must be an object")
                );
                self._push(di_opt_prom);
                return;
            }
            # Get(options, "with") — may trigger a getter that throws → reject.
            di_with_e: JSValue = self._get_prop_accessor_recv(
                di_opts_val_e, str_intern("with"), di_opts_val_e
            );
            if self.had_exception or vm_has_native_exc() {
                di_with_exc: JSValue = vm_take_native_exc()
                    if vm_has_native_exc()
                    else self.pending_exc;
                self.had_exception = False;
                self.pending_exc = js_undefined();
                di_with_prom: JSValue = js_promise_create();
                self._promise_settle_and_drain(
                    di_with_prom, PROMISE_REJECTED, di_with_exc
                );
                self._push(di_with_prom);
                return;
            }
            # A present (non-undefined) `with` must be an Object (§13.3.10.2
            # EvaluateImportAttributes). This host honours no attributes, so a
            # well-formed `with` is accepted and ignored; but the enumeration is
            # OBSERVABLE: [[OwnPropertyKeys]] (a proxy ownKeys trap can throw → reject),
            # then Get for each own enumerable string key (a throwing getter/get-trap →
            # reject), and each value must be a string (else TypeError → reject).
            if not jsv_is_undefined(di_with_e) {
                if not (jsv_is_object_cell(di_with_e) or js_is_proxy(di_with_e)) {
                    di_wt_prom: JSValue = js_promise_create();
                    self._promise_settle_and_drain(
                        di_wt_prom,
                        PROMISE_REJECTED,
                        make_type_error(
                            "import attributes (the 'with' option) must be an object"
                        )
                    );
                    self._push(di_wt_prom);
                    return;
                }
                di_wkeys: list[int] = [];
                if js_is_proxy(di_with_e) {
                    di_wkeys = proxy_trap_own_keys_list(self, di_with_e);
                } else {
                    di_wkeys = object_enumerable_own_key_ids_ordered(di_with_e);
                }
                if vm_has_native_exc() {
                    di_wk_exc: JSValue = vm_take_native_exc();
                    di_wk_prom: JSValue = js_promise_create();
                    self._promise_settle_and_drain(
                        di_wk_prom, PROMISE_REJECTED, di_wk_exc
                    );
                    self._push(di_wk_prom);
                    return;
                }
                di_type_key_e: int = str_intern("type");
                di_attr_err: int = 0;  # 0 ok, 1 non-string value, 2 trap/getter threw
                di_attr_exc: JSValue = js_undefined();
                for di_wk in di_wkeys {
                    if di_wk >= SYMBOL_KEY_BASE {
                        continue;
                    }  # only string attribute keys
                    # §13.3.10.2: for each key, [[GetOwnProperty]] first — only ENUMERABLE
                    # string keys have their value read via [[Get]] (a proxy get trap must
                    # not fire for non-enumerable/absent keys). The descriptor trap itself
                    # is observable and may throw → reject.
                    di_wk_enum: bool = _vm_own_key_is_enumerable_now(
                        self, di_with_e, di_wk
                    );
                    if vm_has_native_exc() {
                        di_attr_exc = vm_take_native_exc();
                        di_attr_err = 2;
                        break;
                    }
                    if not di_wk_enum {
                        continue;
                    }
                    di_wv: JSValue = self._get_prop_accessor_recv(
                        di_with_e, di_wk, di_with_e
                    );
                    if self.had_exception or vm_has_native_exc() {
                        di_attr_exc = vm_take_native_exc()
                            if vm_has_native_exc()
                            else self.pending_exc;
                        self.had_exception = False;
                        self.pending_exc = js_undefined();
                        di_attr_err = 2;
                    } elif not jsv_is_string_cell(di_wv) {
                        di_attr_err = 1;
                    } elif di_wk == di_type_key_e {
                        # Capture `with: { type: "..." }` for import_attr_type — the
                        # source/defer phase behaviour in _require_module consults it.
                        di_resolved_attr_type = str_from_id(jsv_to_table_id(di_wv));
                    }
                    if di_attr_err != 0 {
                        break;
                    }
                }
                if di_attr_err == 2 {
                    di_ae_prom: JSValue = js_promise_create();
                    self._promise_settle_and_drain(
                        di_ae_prom, PROMISE_REJECTED, di_attr_exc
                    );
                    self._push(di_ae_prom);
                    return;
                }
                if di_attr_err == 1 {
                    di_wv_prom: JSValue = js_promise_create();
                    self._promise_settle_and_drain(
                        di_wv_prom,
                        PROMISE_REJECTED,
                        make_type_error("import attribute values must be strings")
                    );
                    self._push(di_wv_prom);
                    return;
                }
            }
        }
        # Phase (ins.arg): 0 normal / 1 source-phase / 2 defer-phase. Source- and
        # defer-phase are handled by flag-based semantics on the shared tail below
        # (import_source_phase / import_defer_phase → richer behaviour, incl. WASM
        # source-phase returning a WebAssembly.Module, inside _require_module) — no
        # blanket SyntaxError reject here. ToString(specifier) already ran above.
        saved_esm2_e: int = self.require_is_esm;
        saved_dia_e: int = self.dynamic_import_active;
        saved_src_phase_di: int = self.import_source_phase;
        saved_def_phase_di: int = self.import_defer_phase;
        self.require_is_esm = 1;
        self.dynamic_import_active = 1;
        self.import_attr_type = di_resolved_attr_type;
        # Phase in ins.arg (merged compiler convention):
        #   ins.arg==1 → import.source(specifier) (source-phase)
        #   ins.arg==2 → import.defer(specifier)  (deferred evaluation)
        if ins.arg == 1 {
            self.import_source_phase = 1;
        }
        if ins.arg == 2 {
            self.import_defer_phase = 1;
        }
        # Node parity: `import()` inside sourceless code with NO script identity
        # (a `new Function(...)` body detached from any file) resolves relative to
        # the CURRENT WORKING DIRECTORY — rollup's function suite chdir()s into each
        # fixture and executes bundles via `new Function`.  This must NOT hijack:
        #   • direct `eval("import('./x')")` in a script — eval inherits the calling
        #     script's referrer (test262 dynamic-import/usage-from-eval,
        #     eval-self-once-script), which _get_parent_file already returns via
        #     __filename / __jacEntryFilename;
        #   • ordinary module/script code (frame.func.file set).
        # So gate on the ABSENCE of any script referrer, not merely frame.func.file
        # being empty. _get_parent_file returns its script_dir sentinel
        # ("…/.__jac_main__.js") only when __filename and __jacEntryFilename are both
        # unset — exactly the detached-Function case.
        di_saved_po_e: str = self.require_parent_override;
        di_has_script_ident: bool = ("__filename" in self.globals)
            or ("__jacEntryFilename" in self.globals);
        if frame.func.file == ""
            and self.require_parent_override == ""
            and not di_has_script_ident {
            di_cwd_v: JSValue = process_get_cwd();
            if jsv_is_string_cell(di_cwd_v) {
                self.require_parent_override = str_from_id(jsv_to_table_id(di_cwd_v))
                    + "/.__dynamic_import__.js";
            }
        } elif frame.func.file != "" and self.require_parent_override == "" {
            # A relative `import('./x')` resolves against the MODULE THAT WROTE the
            # import call, not the process entry. __filename tracks the currently-
            # *loading* module and is restored once a module's top-level code
            # finishes — so an exported (esp. async) function from module A, called
            # while entry B is on top, would resolve A's `import('./x')` against B's
            # directory. frame.func.file is the compiled function's own source and
            # is stable across calls / async resumption, so it is the correct
            # referrer. (frame.func.file == "" — detached `new Function` — keeps the
            # CWD fallback above; an explicit createRequire override still wins.)
            self.require_parent_override = frame.func.file;
        }
        di_result_e: JSValue = self._require_module(di_spec_e);
        self.require_parent_override = di_saved_po_e;
        self.import_source_phase = saved_src_phase_di;
        self.import_defer_phase = saved_def_phase_di;
        self.import_attr_type = "";
        self.require_is_esm = saved_esm2_e;
        self.dynamic_import_active = saved_dia_e;
        # Instantiation / Evaluation failures (and native throws) reject the promise.
        if self.had_exception or vm_has_native_exc() {
            di_exc_e: JSValue = self.pending_exc;
            if vm_has_native_exc() {
                di_exc_e = vm_take_native_exc();
            }
            self.had_exception = False;
            self.pending_exc = js_undefined();
            self._maybe_attach_frames(di_exc_e, frame);
            di_prom_e: JSValue = js_promise_create();
            self._promise_settle_and_drain(di_prom_e, PROMISE_REJECTED, di_exc_e);
            self._push(di_prom_e);
        } else {
            # In the canonical module model the module's exports object is already
            # marked as its Module Namespace Exotic Object (ES §10.4.6) at import time
            # (js_object_mark_module_namespace / esm_cjs_namespace_for), so the require
            # result is used directly — no separate module_namespace_for wrap step.
            di_ns_e: JSValue = di_result_e;
            di_prom2_e: JSValue = js_promise_create();
            self._promise_settle_and_drain(di_prom2_e, PROMISE_FULFILLED, di_ns_e);
            self._push(di_prom2_e);
        }
    }

    def _op_reexport_live(frame: CallFrame, ins: Instruction, st: ExecState) {
        rl_pair_e: str = frame.func.constants.get(ins.arg);
        rl_colon_e: int = -1;
        rl_pi_e: int = 0;
        while rl_pi_e < len(rl_pair_e) {
            if rl_pair_e[rl_pi_e] == ":" {
                rl_colon_e = rl_pi_e;
            }
            rl_pi_e = rl_pi_e + 1;
        }
        rl_imp_e: str = rl_pair_e;
        rl_out_e: str = rl_pair_e;
        if rl_colon_e >= 0 {
            rl_imp_e = rl_pair_e[0:rl_colon_e];
            rl_out_e = rl_pair_e[rl_colon_e + 1:];
        }
        rl_ns_e: JSValue = self._pop();
        rl_exp_e: JSValue = js_undefined();
        if self.current_esm_exports_global != ""
            and self.current_esm_exports_global in self.globals {
            rl_exp_e = self.globals[self.current_esm_exports_global];
        } elif "__jac_esm_exports" in self.globals {
            rl_exp_e = self.globals["__jac_esm_exports"];
        }
        if jsv_is_object_cell(rl_exp_e) and jsv_is_object_cell(rl_ns_e) {
            rl_ik_e: int = str_intern(rl_imp_e);
            rl_ok_e: int = str_intern(rl_out_e);
            rl_getter_e: JSValue = esm_create_live_getter(rl_ns_e, rl_ik_e);
            js_object_set_accessor_getter(rl_exp_e, rl_ok_e, rl_getter_e);
        }
    }

    # Live `export { local as exported }` bindings are implemented by the
    # _esm_alias_add store-hook system, not a dedicated opcode.

    def _op_reexport_star(frame: CallFrame, ins: Instruction, st: ExecState) {
        rs_ns_e: JSValue = self._pop();
        rs_exp_e: JSValue = js_undefined();
        if self.current_esm_exports_global != ""
            and self.current_esm_exports_global in self.globals {
            rs_exp_e = self.globals[self.current_esm_exports_global];
        } elif "__jac_esm_exports" in self.globals {
            rs_exp_e = self.globals["__jac_esm_exports"];
        } elif "exports" in self.globals {
            rs_exp_e = self.globals["exports"];
        }
        if jsv_is_object_cell(rs_exp_e) and jsv_is_object_cell(rs_ns_e) {
            if _DBG_ESM_ON {
                _rs_dbg: str = "[DBG_ESM] reexport_star ns_tid="
                    + str(jsv_to_table_id(rs_ns_e))
                    + " exp_tid="
                    + str(jsv_to_table_id(rs_exp_e))
                    + " same="
                    + str(jsv_to_table_id(rs_ns_e) == jsv_to_table_id(rs_exp_e))
                    + "\n";
                write(2, _rs_dbg, len(_rs_dbg));
            }
            # Iterate plain own-property keys (e.g. direct exports).
            rs_keys_e: list[int] = js_object_keys(rs_ns_e);
            rs_ki_e: int = 0;
            while rs_ki_e < len(rs_keys_e) {
                rs_kid_e: int = rs_keys_e[rs_ki_e];
                rs_kname_e: str = str_from_id(rs_kid_e);
                if rs_kname_e != "default" {
                    rs_getter_e: JSValue = esm_create_live_getter(rs_ns_e, rs_kid_e);
                    js_object_set_accessor_getter(rs_exp_e, rs_kid_e, rs_getter_e);
                }
                rs_ki_e = rs_ki_e + 1;
            }
            # Also iterate accessor-getter keys: ESM namespaces produced by
            # a prior REEXPORT_STAR store their exports as live getters, not
            # plain properties.  Without this second pass, transitive
            # `export * from` chains (A re-exports B which re-exports C)
            # copy nothing and the caller sees all exports as undefined.
            rs_ag_keys_e: list[int] = js_object_accessor_getter_keys(rs_ns_e);
            rs_ag_ki_e: int = 0;
            while rs_ag_ki_e < len(rs_ag_keys_e) {
                rs_ag_kid_e: int = rs_ag_keys_e[rs_ag_ki_e];
                rs_ag_kname_e: str = str_from_id(rs_ag_kid_e);
                if rs_ag_kname_e != "default" {
                    rs_ag_getter_e: JSValue = esm_create_live_getter(
                        rs_ns_e, rs_ag_kid_e
                    );
                    js_object_set_accessor_getter(
                        rs_exp_e, rs_ag_kid_e, rs_ag_getter_e
                    );
                }
                rs_ag_ki_e = rs_ag_ki_e + 1;
            }
        }
    }

    def _op_import_meta(frame: CallFrame, ins: Instruction, st: ExecState) -> None {
        im_url_e: str = "";
        im_file_e: str = "";
        # The compiled function's own source file is the authoritative referrer:
        # it is stable across calls and async resumption, unlike __filename (which
        # tracks the currently-*loading* module and is restored once a module's
        # top-level code finishes — so a function from module A called while entry
        # B is on top would otherwise report B's path). Fall back to __filename,
        # then the entry filename, then a script_dir sentinel.
        if frame.func.file != "" {
            im_file_e = frame.func.file;
            im_url_e = "file://" + im_file_e;
        } elif "__filename" in self.globals
            and jsv_is_string_cell(self.globals["__filename"]) {
            im_file_e = jsval_to_str(self.globals["__filename"]);
            im_url_e = "file://" + im_file_e;
        } elif "__jacEntryFilename" in self.globals {
            im_file_e = jsval_to_str(self.globals["__jacEntryFilename"]);
            im_url_e = "file://" + im_file_e;
        } elif self.script_dir != "" {
            im_file_e = self.script_dir + "/index.mjs";
            im_url_e = "file://" + im_file_e;
        }
        # import.meta.main — true only for the process entry module (Node 22+).
        im_main_e: bool = False;
        if "__jacEntryFilename" in self.globals {
            entry_e: str = jsval_to_str(self.globals["__jacEntryFilename"]);
            if im_file_e != "" and im_file_e == entry_e {
                im_main_e = True;
            }
        } elif im_file_e != ""
            and (
                "__filename" not in self.globals
                or not jsv_is_string_cell(self.globals["__filename"])
            ) {
            # Entry script before nested imports set __filename — treat as main.
            im_main_e = True;
        }
        # For the entry module, __filename may equal entry even when both set.
        if not im_main_e and im_file_e != "" and "__jacEntryFilename" in self.globals {
            if im_file_e == jsval_to_str(self.globals["__jacEntryFilename"]) {
                im_main_e = True;
            }
        }
        # ES §16.2.1.10: return the SAME import.meta object for this module on every access
        # (properties persist; `import.meta === import.meta`). Cache keyed by the module's
        # filename (the module identity); a module with no filename uses the "" key.
        if im_file_e in self.realm.import_meta_cache {
            self._push(self.realm.import_meta_cache[im_file_e]);
            return;
        }
        # First access for this module: build the meta object once. It is an ORDINARY,
        # extensible object with a NULL [[Prototype]] and mutable own data properties
        # (test262 import-meta-is-an-ordinary-object).
        im_obj_e: JSValue = js_object_create_null();
        js_object_set(im_obj_e, str_intern("url"), js_str(im_url_e));
        if im_file_e != "" {
            js_object_set(im_obj_e, str_intern("filename"), js_str(im_file_e));
            js_object_set(
                im_obj_e, str_intern("dirname"), js_str(path_dirname(im_file_e))
            );
        }
        if im_main_e {
            js_object_set(im_obj_e, str_intern("main"), js_true());
        } else {
            js_object_set(im_obj_e, str_intern("main"), js_false());
        }
        js_object_set(im_obj_e, str_intern("env"), js_object_create_null());
        js_object_set(im_obj_e, WK_RESOLVE, js_undefined());
        self.realm.import_meta_cache[im_file_e] = im_obj_e;
        self._push(im_obj_e);
    }

    def _op_iter_close(frame: CallFrame, ins: Instruction, st: ExecState) -> None {
        ic_iter_e: JSValue = self._pop();
        # arg == 1: ABRUPT completion (an exception is unwinding out of the for-of body) — per
        # §7.4.11 IteratorClose, errors from `return()` (a throw, or a non-object result) are
        # DISCARDED and the original exception (thrown by the following THROW opcode) wins. arg
        # == 0: a NORMAL/break/return completion — a throwing or non-object `return()` PROPAGATES
        # as the completion (test262 for-of/iterator-close-*). The plain closer swallows, so the
        # normal path must route through the error-returning dstr closer.
        if ins.arg == 1 {
            _vm_iterator_close(self, ic_iter_e);
            return;
        }
        ic_err_e: JSValue = _vm_iterator_close_dstr(self, ic_iter_e, False);
        if not jsv_is_undefined(ic_err_e) {
            if not self._unwind_in_frame(frame, ic_err_e) {
                self.had_exception = True;
                self.pending_exc = ic_err_e;
                st.running = False;
            }
        }
    }

    # Array-destructuring IteratorClose on NORMAL completion (§13.15.5.2 step:
    # if !iteratorRecord.[[done]], IteratorClose).  Stack: [iterator] → [].
    # A throwing return() or a non-object return value surfaces as an exception.
    def _op_iter_close_nrml(frame: CallFrame, ins: Instruction, st: ExecState) {
        icn_iter: JSValue = self._pop();
        icn_err: JSValue = _vm_iterator_close_dstr(self, icn_iter, False);
        if not jsv_is_undefined(icn_err) {
            if not self._unwind_in_frame(frame, icn_err) {
                self.had_exception = True;
                self.pending_exc = icn_err;
                st.running = False;
            }
        }
    }

    # Array-destructuring IteratorClose on ABRUPT completion.  Stack: [exc, iter].
    # Close swallowing any error from return(); then re-throw the original exc.
    def _op_iter_close_thrw(frame: CallFrame, ins: Instruction, st: ExecState) -> None {
        if self._gen_ret_pending {
            # Forced generator return unwinding through this destructuring handler:
            # the abrupt-ret jump did not push an exception value onto the stack (it
            # is not a throw), so only the iterator record (from LOAD_LOCAL) is here.
            # Per §7.4.11, a *return* completion is not "abrupt" for the purpose of
            # discarding return()'s own errors: a throwing return() (or one returning
            # a non-object) REPLACES the return completion with that throw.  So close
            # with abrupt=False and, if it yields an error, throw it; otherwise the
            # generator completes with a return (state.send_val → {value, done:true}).
            self._gen_ret_pending = False;
            ict_iter_r: JSValue = self._pop();
            ict_close_err: JSValue = _vm_iterator_close_dstr(self, ict_iter_r, False);
            if not jsv_is_undefined(ict_close_err) {
                if not self._unwind_in_frame(frame, ict_close_err) {
                    self.had_exception = True;
                    self.pending_exc = ict_close_err;
                    st.running = False;
                }
                return;
            }
            st.running = False;  # return completion; state.ret_mode → send_val
            return;
        }
        ict_iter: JSValue = self._pop();
        ict_exc: JSValue = self._pop();
        _vm_iterator_close_dstr(self, ict_iter, True);
        if not self._unwind_in_frame(frame, ict_exc) {
            self.had_exception = True;
            self.pending_exc = ict_exc;
            st.running = False;
        }
    }

    """FINALLY_ENTER (ES §14.15.3, exception path of a try…finally with no catch).
    Reached when an escaping exception — OR a generator forced-return (.return())
    suspended inside the try body — routes to the finalizer. For a genuine exception
    _unwind_in_frame pushed the exception value: stash it in local[arg] so the
    finalizer (which may yield/await) runs with a clean operand stack. For a forced
    return NO value was pushed (`_gen_ret_pending`), so leave the stack untouched;
    the matching FINALLY_RETHROW will hand control back for the return completion."""
    def _op_finally_enter(frame: CallFrame, ins: Instruction, st: ExecState) -> None {
        if self._gen_ret_pending {
            # Forced-return: no exception on the stack. Record undefined so a spurious
            # value is not thrown at FINALLY_RETHROW if _gen_ret_pending were cleared.
            frame.locals[frame.lb + (ins.arg)] = js_undefined();
            return;
        }
        frame.locals[frame.lb + (ins.arg)] = self._pop();
    }

    """FINALLY_RETHROW — exit of the exception-path finalizer. If a generator forced
    return is in flight, stop this frame so run_generator completes the generator with
    its return value (state.ret_mode → send_val) rather than throwing. Otherwise
    reload the stashed exception and re-raise it (unwinding to an enclosing handler),
    completing the abrupt try completion the finalizer did not itself replace."""
    def _op_finally_rethrow(frame: CallFrame, ins: Instruction, st: ExecState) -> None {
        if self._gen_ret_pending {
            # Return completion: the generator resume driver reads state.ret_mode.
            st.running = False;
            return;
        }
        fr_exc: JSValue = frame.locals[frame.lb + (ins.arg)];
        if not self._unwind_in_frame(frame, fr_exc) {
            self.had_exception = True;
            self.pending_exc = fr_exc;
            st.running = False;
        }
    }

    def _op_load_const(frame: CallFrame, ins: Instruction, st: ExecState) -> None {
        # Fields are read through frame.func (borrowed): a CompiledFunction local
        # cost a retain/release on every constant load.
        # The decoded value is also cached in the instruction itself
        # (ic_holder = 1, value in ic_obj) for _exec's inline LOAD_CONST path.
        # Constants are immutable (numbers + interned strings, see
        # CompiledFunction.const_cache), an Instruction belongs to exactly one
        # function's code, and nothing rewrites a LOAD_CONST's arg, so the
        # entry never goes stale.
        lc_i: int = ins.arg;
        if lc_i < len(frame.func.const_cache) {
            lc_v: JSValue = frame.func.const_cache[lc_i];
            if not jsv_is_hole(lc_v) {
                ins.ic_obj = lc_v;
                ins.ic_holder = 1;
                self.stack.append(lc_v);
                return;
            }
        } else {
            while len(frame.func.const_cache) < lc_i + 1 {
                frame.func.const_cache.append(jsv_hole());
            }
        }
        lc_dv: JSValue = const_to_jsval(frame.func.constants.get(lc_i));
        frame.func.const_cache[lc_i] = lc_dv;
        ins.ic_obj = lc_dv;
        ins.ic_holder = 1;
        self._push(lc_dv);
    }

    def _op_load_undefined(frame: CallFrame, ins: Instruction, st: ExecState) {
        self._push(js_undefined());
    }

    def _op_load_null(frame: CallFrame, ins: Instruction, st: ExecState) {
        self._push(js_null());
    }

    def _op_load_true(frame: CallFrame, ins: Instruction, st: ExecState) {
        self._push(js_true());
    }

    def _op_load_false(frame: CallFrame, ins: Instruction, st: ExecState) {
        self._push(js_false());
    }

    def _op_load_hole(frame: CallFrame, ins: Instruction, st: ExecState) {
        self._push(jsv_hole());
    }

    def _op_pop(frame: CallFrame, ins: Instruction, st: ExecState) {
        self._pop();
    }

    def _op_dup(frame: CallFrame, ins: Instruction, st: ExecState) {
        self._push(self._peek());
    }

    def _op_swap(frame: CallFrame, ins: Instruction, st: ExecState) {
        sn: int = len(self.stack);
        tmp_sw: JSValue = self.stack[sn - 1];
        self.stack[sn - 1] = self.stack[sn - 2];
        self.stack[sn - 2] = tmp_sw;

        # ── Variables ─────────────────────────────────────────────────
    }

    def _op_load_local(frame: CallFrame, ins: Instruction, st: ExecState) {
        self._push(frame.locals[frame.lb + (ins.arg)]);
    }

    def _op_load_local_checked(frame: CallFrame, ins: Instruction, st: ExecState) {
        lc_v: JSValue = frame.locals[frame.lb + (ins.arg)];
        if js_is_tdz(lc_v) {
            lc_name: str = "";
            if ins.arg < len(frame.func.locals) {
                lc_name = frame.func.locals[ins.arg];
            }
            exc_lc: JSValue = make_reference_error(
                "Cannot access '" + lc_name + "' before initialization"
            );
            if not self._unwind_in_frame(frame, exc_lc) {
                self.had_exception = True;
                self.pending_exc = exc_lc;
                st.running = False;
            }
        } else {
            self._push(lc_v);
        }
    }

    def _op_store_new_cell(frame: CallFrame, ins: Instruction, st: ExecState) {
        snc_v: JSValue = self._pop();
        frame.locals[frame.lb + (ins.arg)] = make_cell(snc_v);
    }

    def _op_store_local(frame: CallFrame, ins: Instruction, st: ExecState) {
        frame.locals[frame.lb + (ins.arg)] = self._pop();
    }

    # ── vm.runInContext name resolution ─────────────────────────────
    #
    # Code compiled for a contextified sandbox carries that sandbox on its
    # CompiledFunction (`ctx_global`).  For such code the sandbox IS the global
    # object: bare names resolve against it alone, never against the host
    # `globals` map, so `process` / `require` / the embedder's top-level bindings
    # stay invisible.  The tag lives on the function rather than on a VM-wide
    # flag so a host callback invoked *from* sandbox code still sees the host
    # globals, and a closure returned *out* of the sandbox keeps resolving
    # against the sandbox after the run has finished.

    """The contextified sandbox `frame` resolves bare names against, or 0."""
    def _frame_ctx_global(frame: CallFrame) -> JSValue {
        cg: JSValue = frame.func.ctx_global;
        if jsv_is_object_cell(cg) and jsv_to_table_id(cg) > 0 {
            return cg;
        }
        return 0;
    }

    """The global object a sloppy-mode call on `cf` substitutes for null/undefined
    `this` — the contextified sandbox for sandbox code, else the realm global."""
    def _sloppy_this_for(cf: CompiledFunction) -> JSValue {
        cg: JSValue = cf.ctx_global;
        if jsv_is_object_cell(cg) and jsv_to_table_id(cg) > 0 {
            return cg;
        }
        return self.realm.global_this;
    }

    """Direct-eval scope inheritance lookup (ES §19.2.1.1): resolve `gn` against the
    live caller frames captured at eval entry, innermost first.  Returns jsv_hole()
    when the name is bound in none of them (including when the active boundary is 0,
    as it is for vm.runInContext — the sandbox is the whole scope)."""
    def _eval_scope_lookup(gn: str) -> JSValue {
        esl_n: int = len(self.eval_scope_frames);
        if esl_n == 0 {
            return jsv_hole();
        }
        esl_boundary: int = self.eval_scope_frames[esl_n - 1];
        if esl_boundary > len(self.frames) {
            esl_boundary = len(self.frames);
        }
        esl_i: int = esl_boundary - 1;
        while esl_i >= 0 {
            esl_cf: CallFrame = self.frames[esl_i];
            esl_li: int = 0;
            while esl_li < len(esl_cf.func.locals) {
                if esl_cf.func.locals[esl_li] == gn and esl_li < len(esl_cf.locals) {
                    esl_lv: JSValue = esl_cf.locals[esl_cf.lb + (esl_li)];
                    if is_cell(esl_lv) {
                        return cell_get(esl_lv);
                    }
                    return esl_lv;
                }
                esl_li = esl_li + 1;
            }
            # EDI / Annex B dyn vars introduced on this activation are part of the
            # frame's OWN variable environment, so they shadow a captured OUTER
            # free-var of the same name — resolve them before free_vars.
            esl_di: int = 0;
            while esl_di < len(esl_cf.dyn_var_names) {
                if esl_cf.dyn_var_names[esl_di] == gn
                    and esl_di < len(esl_cf.dyn_var_vals) {
                    return esl_cf.dyn_var_vals[esl_di];
                }
                esl_di = esl_di + 1;
            }
            esl_fvi: int = 0;
            while esl_fvi < len(esl_cf.func.free_vars) {
                if esl_cf.func.free_vars[esl_fvi] == gn
                    and esl_fvi < len(esl_cf.free_vals) {
                    return cell_get(esl_cf.free_vals[esl_fvi]);
                }
                esl_fvi = esl_fvi + 1;
            }
            esl_i = esl_i - 1;
        }
        return jsv_hole();
    }

    """Write `val` into a direct-eval caller DYN_VAR binding named `gn` (a `var`
    created at runtime by a prior direct eval), searching the eval-boundary frames
    innermost-first.  Returns True iff a dyn_var was found and updated.  Unlike
    _eval_scope_store this matches ONLY dyn_vars — used before the global-binding
    check so an eval-introduced function-var shadows a like-named global."""
    def _eval_dynvar_store(gn: str, val: JSValue) -> bool {
        eds_n: int = len(self.eval_scope_frames);
        if eds_n == 0 {
            return False;
        }
        eds_boundary: int = self.eval_scope_frames[eds_n - 1];
        if eds_boundary > len(self.frames) {
            eds_boundary = len(self.frames);
        }
        eds_i: int = eds_boundary - 1;
        while eds_i >= 0 {
            eds_cf: CallFrame = self.frames[eds_i];
            eds_di: int = 0;
            while eds_di < len(eds_cf.dyn_var_names) {
                if eds_cf.dyn_var_names[eds_di] == gn
                    and eds_di < len(eds_cf.dyn_var_vals) {
                    eds_cf.dyn_var_vals[eds_di] = val;
                    return True;
                }
                eds_di = eds_di + 1;
            }
            eds_i = eds_i - 1;
        }
        return False;
    }

    """Read a direct-eval caller DYN_VAR binding named `gn`, innermost-first.
    Returns the value, or jsv_hole() if no dyn_var of that name exists.  Used before
    the global-binding read so an eval-introduced function-var shadows a like-named
    global (test262 compound-assignment/S11.13.2_A6.*_T1)."""
    def _eval_dynvar_lookup(gn: str) -> JSValue {
        edl_n: int = len(self.eval_scope_frames);
        if edl_n == 0 {
            return jsv_hole();
        }
        edl_boundary: int = self.eval_scope_frames[edl_n - 1];
        if edl_boundary > len(self.frames) {
            edl_boundary = len(self.frames);
        }
        edl_i: int = edl_boundary - 1;
        while edl_i >= 0 {
            edl_cf: CallFrame = self.frames[edl_i];
            edl_di: int = 0;
            while edl_di < len(edl_cf.dyn_var_names) {
                if edl_cf.dyn_var_names[edl_di] == gn
                    and edl_di < len(edl_cf.dyn_var_vals) {
                    return edl_cf.dyn_var_vals[edl_di];
                }
                edl_di = edl_di + 1;
            }
            edl_i = edl_i - 1;
        }
        return jsv_hole();
    }

    """Write `val` into a direct-eval caller binding named `gn`.  Returns True if a
    binding was found and updated (locals, free-vars, or dyn_var).

    `skip_main` skips a `<main>`-frame's own LOCALS: at script level those slots ARE the
    global bindings (and Annex B may leave a stale `<main>` local for a block `let`), so
    resolving them here would shadow the real global. Pass True from STORE_GLOBAL, where the
    global-binding path handles `<main>` bindings; pass False elsewhere."""
    def _eval_scope_store(gn: str, val: JSValue, skip_main: bool = False) -> bool {
        ess_n: int = len(self.eval_scope_frames);
        if ess_n == 0 {
            return False;
        }
        ess_boundary: int = self.eval_scope_frames[ess_n - 1];
        if ess_boundary > len(self.frames) {
            ess_boundary = len(self.frames);
        }
        ess_i: int = ess_boundary - 1;
        while ess_i >= 0 {
            ess_cf: CallFrame = self.frames[ess_i];
            ess_is_main: bool = ess_cf.func.name == "<main>";
            ess_li: int = 0;
            if skip_main and ess_is_main {
                ess_li = len(ess_cf.func.locals);
            }
            while ess_li < len(ess_cf.func.locals) {
                if ess_cf.func.locals[ess_li] == gn and ess_li < len(ess_cf.locals) {
                    # ES §15.2.5: a named-function-expression self-name is an IMMUTABLE
                    # binding, held in the named-fn frame's own slot.  A direct eval
                    # reassigning it (`eval("f = 1")`) is a silent no-op (sloppy) /
                    # TypeError (strict).  Direct body code is caught at compile time
                    # (fnself kind); this covers the eval-only resolution path.
                    if ess_cf.func.self_name == gn {
                        if ess_cf.func.is_strict {
                            vm_throw_native(
                                make_type_error("Assignment to constant variable.")
                            );
                        }
                        return True;
                    }
                    ess_lv: JSValue = ess_cf.locals[ess_cf.lb + (ess_li)];
                    if is_cell(ess_lv) {
                        cell_set(ess_lv, val);
                    } else {
                        ess_cf.locals[ess_cf.lb + (ess_li)] = val;
                    }
                    return True;
                }
                ess_li = ess_li + 1;
            }
            # dyn_var bindings are part of THIS frame's own variable environment
            # (created by a prior direct-eval `var x`), so they shadow a captured
            # OUTER free-var of the same name — check them before free_vars
            # (ES §19.2.1.3: eval `var` binds in the running ctx's VariableEnvironment).
            ess_di: int = 0;
            while ess_di < len(ess_cf.dyn_var_names) {
                if ess_cf.dyn_var_names[ess_di] == gn
                    and ess_di < len(ess_cf.dyn_var_vals) {
                    ess_cf.dyn_var_vals[ess_di] = val;
                    return True;
                }
                ess_di = ess_di + 1;
            }
            ess_fvi: int = 0;
            while ess_fvi < len(ess_cf.func.free_vars) {
                if ess_cf.func.free_vars[ess_fvi] == gn
                    and ess_fvi < len(ess_cf.free_vals) {
                    # ES §15.2.5: a named-function-expression self-name is an IMMUTABLE
                    # binding.  The captured self-cell lives in the named-fn frame; a
                    # direct eval reassigning it (`eval("f = 1")`) must be a silent
                    # no-op (sloppy) / TypeError (strict).  Direct body code is caught
                    # at compile time (fnself kind); this covers the eval-only path.
                    if ess_cf.func.self_name == gn {
                        if ess_cf.func.is_strict {
                            vm_throw_native(
                                make_type_error("Assignment to constant variable.")
                            );
                        }
                        return True;
                    }
                    cell_set(ess_cf.free_vals[ess_fvi], val);
                    return True;
                }
                ess_fvi = ess_fvi + 1;
            }
            ess_i = ess_i - 1;
        }
        return False;
    }

    """ES CreateGlobalFunctionBinding(N, V, D) / CreateGlobalVarBinding for Annex B.

    When a binding already exists on the global object, leave its [[Value]] and
    attributes alone (existing-global-init).  Only create a new data property when
    absent.  Always ensure `self.globals` tracks the live binding for LOAD_GLOBAL."""
    def _create_global_fn_binding(name: str, val: JSValue, configurable: bool) -> None {
        cg_kid: int = str_intern(name);
        cg_existing: JSProperty = js_object_get_own_property_descriptor(
            self.global_this, cg_kid
        );
        if cg_existing.key != 0 and not cg_existing.deleted {
            # Already bound.  ES §16.1.7 GlobalDeclarationInstantiation processes
            # function declarations LAST and duplicates are last-wins: a redeclared
            # (or shadowing) function updates the binding's VALUE via SetMutableBinding
            # (writable data property), preserving the existing [[Configurable]] so
            # `function f(){} function f(){}` still yields the second body while
            # `delete f` stays false (S13_A6_T2 / S14_A5_*). A non-writable / accessor
            # binding is left untouched (existing-global-init from a prior host def).
            cg_is_acc: bool = (
                not jsv_is_undefined(js_object_lookup_getter(self.global_this, cg_kid))
            )
                or (
                    not jsv_is_undefined(
                        js_object_lookup_setter(self.global_this, cg_kid)
                    )
                );
            if cg_existing.writable and not cg_is_acc {
                self.globals[name] = val;
                self.gw_epoch = self.gw_epoch + 1;
                js_object_set(self.global_this, cg_kid, val);
            } elif name not in self.globals {
                self.globals[name] = js_object_get(self.global_this, cg_kid);
                self.gw_epoch = self.gw_epoch + 1;
            }
            return;
        }
        self.globals[name] = val;
        self.gw_epoch = self.gw_epoch + 1;
        cg_desc: JSProperty = JSProperty(
            key=cg_kid,
            value=val,
            writable=True,
            enumerable=True,
            configurable=configurable,
            deleted=False
        );
        js_object_define_property(self.global_this, cg_kid, cg_desc);
    }

    """Ensure a mutable varEnv binding `name` exists on `frame` (EDI / Annex B).
    Creates a per-activation dyn_var initialized to undefined when absent.  A name that is
    already a local OR a captured free-var of the frame is left alone (its existing binding
    is the varEnv binding).  Used for Annex B block-function names in a direct eval."""
    def _edi_ensure_var_binding(frame: CallFrame, name: str) -> None {
        eev_li: int = 0;
        while eev_li < len(frame.func.locals) {
            if frame.func.locals[eev_li] == name {
                return;
            }
            eev_li = eev_li + 1;
        }
        eev_fi: int = 0;
        while eev_fi < len(frame.func.free_vars) {
            if frame.func.free_vars[eev_fi] == name {
                return;
            }
            eev_fi = eev_fi + 1;
        }
        eev_di: int = 0;
        while eev_di < len(frame.dyn_var_names) {
            if frame.dyn_var_names[eev_di] == name {
                return;
            }
            eev_di = eev_di + 1;
        }
        frame.dyn_var_names.append(name);
        frame.rare = True;
        frame.dyn_var_vals.append(js_undefined());
        frame.rare = True;
    }

    """ES §19.2.1.3 var binding for a BODY direct eval: create a dyn_var that SHADOWS a
    captured outer binding of `name` (test262 compound-assignment/S11.13.2_A6.*_T1).  Only
    fires when the frame's OWN code already captures `name` as a free-var — so the shadowing
    binding and the code that reads it back live in the same activation.  When `name` is a
    local it already IS the varEnv binding; when `name` is captured by no code of this frame
    (e.g. an eval-in-parameter var that only PARAM-list closures observe), the ordinary
    global/free-var write path must reach it, so no dyn_var is created (test262
    */scope-param-*elem-var-*)."""
    def _edi_shadow_var_binding(frame: CallFrame, name: str) -> None {
        eev_li: int = 0;
        while eev_li < len(frame.func.locals) {
            if frame.func.locals[eev_li] == name {
                return;
            }
            eev_li = eev_li + 1;
        }
        eev_is_free: bool = False;
        eev_fi: int = 0;
        while eev_fi < len(frame.func.free_vars) {
            if frame.func.free_vars[eev_fi] == name {
                eev_is_free = True;
            }
            eev_fi = eev_fi + 1;
        }
        if not eev_is_free {
            return;
        }
        eev_di: int = 0;
        while eev_di < len(frame.dyn_var_names) {
            if frame.dyn_var_names[eev_di] == name {
                return;
            }
            eev_di = eev_di + 1;
        }
        frame.dyn_var_names.append(name);
        frame.rare = True;
        frame.dyn_var_vals.append(js_undefined());
        frame.rare = True;
    }

    """LOAD_GLOBAL inside a contextified sandbox: the sandbox and its prototype
    chain are the only scope (mirrors V8's global-object property lookup, which
    a Node vm context terminates at %Object.prototype%).  arg2 == 1 marks a
    tolerant load (`typeof x`) that yields undefined instead of throwing."""
    def _load_global_ctx(
        frame: CallFrame, ins: Instruction, st: ExecState, gn: str, gobj: JSValue
    ) -> None {
        lgx_kid: int = str_intern(gn);
        if js_object_has(gobj, lgx_kid) {
            lgx_v: JSValue = self._get_prop_accessor(gobj, lgx_kid);
            if self.had_exception {
                lgx_exc: JSValue = self.pending_exc;
                self.had_exception = False;
                self.pending_exc = js_undefined();
                if not self._unwind_in_frame(frame, lgx_exc) {
                    self.had_exception = True;
                    self.pending_exc = lgx_exc;
                    st.running = False;
                }
                return;
            }
            self._push(lgx_v);
            return;
        }
        # A *direct* eval inside sandbox code still inherits its caller's scope
        # chain (the eval'd source is not a fresh context) — those frames belong to
        # the sandbox, since an indirect/runInContext entry pushes a 0 boundary.
        lgx_esc: JSValue = self._eval_scope_lookup(gn);
        if not jsv_is_hole(lgx_esc) {
            self._push(lgx_esc);
            return;
        }
        if ins.arg2 == 1 {
            self._push(js_undefined());
            return;
        }
        lgx_unres: JSValue = make_reference_error(gn + " is not defined");
        if not self._unwind_in_frame(frame, lgx_unres) {
            self.had_exception = True;
            self.pending_exc = lgx_unres;
            st.running = False;
        }
    }

    """STORE_GLOBAL inside a contextified sandbox — writes land on the sandbox
    (never the host globals map).  Accessors defined on the sandbox are honoured
    and a strict-mode write to a name with no binding is a ReferenceError."""
    def _store_global_ctx(
        frame: CallFrame,
        ins: Instruction,
        st: ExecState,
        gn: str,
        val: JSValue,
        gobj: JSValue
    ) -> None {
        sgx_kid: int = str_intern(gn);
        sgx_getter: JSValue = js_object_get_own_accessor_getter(gobj, sgx_kid);
        sgx_setter: JSValue = js_object_get_own_accessor_setter(gobj, sgx_kid);
        if not jsv_is_undefined(sgx_getter) or not jsv_is_undefined(sgx_setter) {
            if not jsv_is_undefined(sgx_setter) {
                if is_fn_val(sgx_setter) {
                    self.run_cl(
                        self.realm.closures[get_fn_idx(sgx_setter)],
                        sgx_setter,
                        gobj,
                        [val]
                    );
                    if self.had_exception {
                        sgx_sx: JSValue = self.pending_exc;
                        self.had_exception = False;
                        self.pending_exc = js_undefined();
                        if not self._unwind_in_frame(frame, sgx_sx) {
                            self.had_exception = True;
                            self.pending_exc = sgx_sx;
                            st.running = False;
                        }
                    }
                }
            } elif ins.arg2 == 1 {
                sgx_ro: JSValue = make_type_error(
                    "Cannot set property " + gn + " which has only a getter"
                );
                if not self._unwind_in_frame(frame, sgx_ro) {
                    self.had_exception = True;
                    self.pending_exc = sgx_ro;
                    st.running = False;
                }
            }
            return;
        }
        if ins.arg2 == 1 and not js_object_has(gobj, sgx_kid) {
            sgx_unres: JSValue = make_reference_error(gn + " is not defined");
            if not self._unwind_in_frame(frame, sgx_unres) {
                self.had_exception = True;
                self.pending_exc = sgx_unres;
                st.running = False;
            }
            return;
        }
        sgx_pdesc: JSProperty = js_object_get_own_property_descriptor(gobj, sgx_kid);
        if sgx_pdesc.deleted or sgx_pdesc.writable {
            js_object_set(gobj, sgx_kid, val);
        }
    }

    # Apply writes made through the global object since the last bare read: a data
    # property's value replaces the copy in self.globals; an accessor or a deleted key
    # drops the copy so the read falls back to the object (getters run, deleted names
    # throw). Names bound only in self.globals are left alone.
    def _sync_globals_from_object {
        self.global_obj_seen_epoch = global_obj_epoch();
        sgo_g: JSValue = self.realm.global_this;
        sgo_keys: list[int] = global_obj_take_dirty();
        for sgo_k in sgo_keys {
            if sgo_k < 0 or sgo_k >= SYMBOL_KEY_BASE {
                continue;
            }
            sgo_nm: str = str_from_id(sgo_k);
            if sgo_nm not in self.globals or sgo_nm in self.globals_off_object {
                continue;
            }
            if sgo_nm == "require"
                or sgo_nm == "module"
                or sgo_nm == "exports"
                or sgo_nm == "__dirname"
                or sgo_nm == "__filename"
                or sgo_nm.startswith("__jac") {
                continue;
            }
            if js_object_has_own(sgo_g, sgo_k)
                and jsv_is_undefined(js_object_get_own_accessor_getter(sgo_g, sgo_k))
                and jsv_is_undefined(js_object_get_own_accessor_setter(sgo_g, sgo_k)) {
                self.globals[sgo_nm] = js_object_get(sgo_g, sgo_k);
                self.gw_epoch = self.gw_epoch + 1;
            } else {
                del self.globals[sgo_nm];
                self.gw_epoch = self.gw_epoch + 1;
            }
        }
    }

    def _op_load_global(frame: CallFrame, ins: Instruction, st: ExecState) -> None {
        gn: str = frame.func.constants.get(ins.arg);
        if global_obj_epoch() != self.global_obj_seen_epoch {
            self._sync_globals_from_object();
        }
        # Fast path for an ordinary global name. Whether the name is one of the
        # CJS pseudo-globals / the ESM exports carrier never changes, so it is
        # classified once per instruction in ic_epoch (unused by LOAD_GLOBAL;
        # 1 = ordinary, 2 = special) instead of string-compared on every load.
        # With no sandbox context global, no direct-eval scope and no
        # $262.evalScript lexical bindings, an ordinary name resolves straight
        # from self.globals; anything else (absent, TDZ) takes the full path.
        if ins.ic_epoch == 0 {
            if gn == "require"
                or gn == "module"
                or gn == "exports"
                or gn == "__dirname"
                or gn == "__filename"
                or gn == "__jac_esm_exports" {
                ins.ic_epoch = 2;
            } else {
                ins.ic_epoch = 1;
            }
        }
        if ins.ic_epoch == 1
            and len(self.eval_scope_frames) == 0
            and len(self.global_lexical) == 0
            and self._frame_ctx_global(frame) == 0 {
            lgf_v: JSValue = self.globals.get(gn, jsv_hole());
            if not jsv_is_hole(lgf_v) and not js_is_tdz(lgf_v) {
                self._push(lgf_v);
                return;
            }
        }
        lg_ctx: JSValue = self._frame_ctx_global(frame);
        if lg_ctx != 0 {
            self._load_global_ctx(frame, ins, st, gn, lg_ctx);
            return;
        }
        if self.esm_entry != 0 {
            lg_cjs_pseudo: bool = (
                gn == "require"
                or gn == "module"
                or gn == "exports"
                or gn == "__dirname"
                or gn == "__filename"
            );
            lg_pseudo_bound: bool = False;
            if lg_cjs_pseudo and gn in self.globals {
                if not jsv_is_undefined(self.globals[gn]) {
                    lg_pseudo_bound = True;
                }
            }
            if lg_cjs_pseudo and not lg_pseudo_bound {
                # Guard only UNBOUND CJS pseudo-global names: a module may legitimately
                # declare one itself — Rollup emits a top-level `var exports = {…}` when
                # inlining a package.json — and that binding (a module global in
                # self.globals) must resolve normally instead of tripping this guard.
                # "Bound" requires a non-undefined value: _strip_cjs_pseudo_globals
                # leaves stripped names in self.globals as undefined, and the var-hoist
                # prologue pre-seeds declared names as undefined too — so a declared
                # `var exports` resolves from its first real assignment onward, while a
                # never-declared name keeps the helpful ReferenceError below.
                # typeof x must yield "undefined" for unresolvable names (ES §13.5.3),
                # even for CJS pseudo-globals that throw on bare reference in ESM.
                # Compiler sets ins.arg2 == 1 for typeof operands (tolerant load).
                if ins.arg2 == 1 {
                    self._push(js_undefined());
                    return;
                }
                exc_esm_g: JSValue = make_reference_error(
                    gn + " is not defined in ES module scope"
                );
                if not self._unwind_in_frame(frame, exc_esm_g) {
                    self.had_exception = True;
                    self.pending_exc = exc_esm_g;
                    st.running = False;
                }
                return;
            }
            if gn == "__jac_esm_exports" {
                if gn in self.globals {
                    self._push(self.globals[gn]);
                    return;
                }
            }
        }
        lg_use_cjs: bool = False;
        lg_cjs_mod: JSValue = js_undefined();
        if gn == "module" or gn == "exports" {
            lg_cjs_mod = _fn_jac_module(frame.self_fn, self.realm);
            if jsv_is_object_cell(lg_cjs_mod) {
                lg_use_cjs = True;
            }
        }
        # Direct-eval dyn_var (ES §19.2.1.3): a `var` created at runtime by a direct eval
        # lives in a caller frame's variable environment and SHADOWS a like-named global,
        # so it must be read before self.globals (test262 compound-assignment/
        # S11.13.2_A6.*_T1). Only meaningful while an eval scope is active.
        lg_dynv: JSValue = self._eval_dynvar_lookup(gn);
        if not jsv_is_hole(lg_dynv) {
            self._push(lg_dynv);
            return;
        }
        if lg_use_cjs {
            if gn == "module" {
                self._push(lg_cjs_mod);
            } else {
                self._push(js_object_get(lg_cjs_mod, WK_EXPORTS));
            }
        } elif gn in self.global_lexical {
            # Persistent ScriptEvaluation let/const from $262.evalScript.
            self._push(self.global_lexical[gn]);
        } elif gn in self.globals {
            gn_val: JSValue = self.globals[gn];
            # TDZ check: class used before its declaration was reached
            if js_is_tdz(gn_val) {
                exc_tdz: JSValue = make_reference_error(
                    "Cannot access '" + gn + "' before initialization"
                );
                if not self._unwind_in_frame(frame, exc_tdz) {
                    self.had_exception = True;
                    self.pending_exc = exc_tdz;
                    st.running = False;
                }
            } else {
                self._push(gn_val);
            }
        } else {
            # Fallback: globalThis own property, else unresolvable reference.
            # A9: a name that is neither a tracked global (`gn in self.globals`, which now
            # includes every hoisted `var` after the recursive-hoist pre-pass) nor an own
            # property of globalThis is an *unresolvable reference* — reading it must throw
            # ReferenceError (ES §6.2.4.6 GetValue).  arg2 == 1 marks a tolerant load
            # (`typeof x`, existence probes) that yields `undefined` instead of throwing.
            lg_kid: int = str_intern(gn);
            if js_object_has_own(self.global_this, lg_kid) {
                # A global may be defined as an accessor (Object.defineProperty(globalThis,
                # …, {get})).  Use the accessor-aware getter so the getter runs and its
                # side effects (and any throw) are observed; falls back to the data value.
                lg_gv: JSValue = self._get_prop_accessor(self.global_this, lg_kid);
                if self.had_exception {
                    lg_gexc: JSValue = self.pending_exc;
                    self.had_exception = False;
                    self.pending_exc = js_undefined();
                    if not self._unwind_in_frame(frame, lg_gexc) {
                        self.had_exception = True;
                        self.pending_exc = lg_gexc;
                        st.running = False;
                    }
                } else {
                    self._push(lg_gv);
                }
            } else {
                # Direct-eval scope inheritance (ES §19.2.1.1): a name unresolved in
                # globals/globalThis may be a binding of the eval caller's scope chain
                # (e.g. a top-level `function`/`let` stored as a <main> local, possibly
                # reached through nested function frames). Walk the live caller frames
                # captured at eval entry, innermost first.
                lg_eval_ok: bool = False;
                lg_eval_val: JSValue = js_undefined();
                lg_esf: int = len(self.eval_scope_frames);
                if lg_esf > 0 {
                    lg_boundary: int = self.eval_scope_frames[lg_esf - 1];
                    if lg_boundary > len(self.frames) {
                        lg_boundary = len(self.frames);
                    }
                    lg_fr_i: int = lg_boundary - 1;
                    while lg_fr_i >= 0 and not lg_eval_ok {
                        lg_cf: CallFrame = self.frames[lg_fr_i];
                        lg_li: int = 0;
                        while lg_li < len(lg_cf.func.locals) {
                            if lg_cf.func.locals[lg_li] == gn
                                and lg_li < len(lg_cf.locals) {
                                lg_lv: JSValue = lg_cf.locals[lg_cf.lb + (lg_li)];
                                if is_cell(lg_lv) {
                                    lg_eval_val = cell_get(lg_lv);
                                } else {
                                    lg_eval_val = lg_lv;
                                }
                                lg_eval_ok = True;
                                lg_li = len(lg_cf.func.locals);
                            }
                            lg_li = lg_li + 1;
                        }
                        if not lg_eval_ok {
                            lg_fvi: int = 0;
                            while lg_fvi < len(lg_cf.func.free_vars) {
                                if lg_cf.func.free_vars[lg_fvi] == gn
                                    and lg_fvi < len(lg_cf.free_vals) {
                                    lg_eval_val = cell_get(lg_cf.free_vals[lg_fvi]);
                                    lg_eval_ok = True;
                                    lg_fvi = len(lg_cf.func.free_vars);
                                }
                                lg_fvi = lg_fvi + 1;
                            }
                        }
                        if not lg_eval_ok {
                            lg_di: int = 0;
                            while lg_di < len(lg_cf.dyn_var_names) {
                                if lg_cf.dyn_var_names[lg_di] == gn
                                    and lg_di < len(lg_cf.dyn_var_vals) {
                                    lg_eval_val = lg_cf.dyn_var_vals[lg_di];
                                    lg_eval_ok = True;
                                    lg_di = len(lg_cf.dyn_var_names);
                                }
                                lg_di = lg_di + 1;
                            }
                        }
                        lg_fr_i = lg_fr_i - 1;
                    }
                }
                if lg_eval_ok {
                    self._push(lg_eval_val);
                } elif js_object_has(self.global_this, lg_kid) {
                    # Inherited through globalThis's [[Prototype]] (Object.prototype, as in
                    # every host): a bare `hasOwnProperty.call(o, k)` / `toString` resolves
                    # there (@babel/types' definitions/placeholders.js).
                    lg_pv: JSValue = self._get_prop_accessor(self.global_this, lg_kid);
                    if self.had_exception {
                        lg_pexc: JSValue = self.pending_exc;
                        self.had_exception = False;
                        self.pending_exc = js_undefined();
                        if not self._unwind_in_frame(frame, lg_pexc) {
                            self.had_exception = True;
                            self.pending_exc = lg_pexc;
                            st.running = False;
                        }
                    } else {
                        self._push(lg_pv);
                    }
                } elif ins.arg2 == 1 {
                    self._push(js_undefined());
                } else {
                    exc_unres: JSValue = make_reference_error(gn + " is not defined");
                    if not self._unwind_in_frame(frame, exc_unres) {
                        self.had_exception = True;
                        self.pending_exc = exc_unres;
                        st.running = False;
                    }
                }
            }
        }
    }

    def _op_store_global(frame: CallFrame, ins: Instruction, st: ExecState) -> None {
        gn2: str = frame.func.constants.get(ins.arg);
        sg_val: JSValue = self._pop();
        sg_ctx: JSValue = self._frame_ctx_global(frame);
        if sg_ctx != 0 {
            self._store_global_ctx(frame, ins, st, gn2, sg_val, sg_ctx);
            return;
        }
        # Direct-eval `var x` introduced a dyn_var on a caller frame's variable
        # environment — that binding SHADOWS a like-named global, so an assignment to
        # `x` from within the eval must target the dyn_var even when `x` is also a
        # global (test262 compound-assignment/S11.13.2_A6.*_T1: `eval("var x = 2")`
        # inside a function whose enclosing `var x` is a global). Checked before the
        # `gn2 in self.globals` guard, which otherwise routes straight to the global.
        if self._eval_dynvar_store(gn2, sg_val) {
            return;
        }
        # Direct-eval assignment to a free name resolves the CALLER's scope chain first
        # (ES §9.1 / §19.2.1.1): a caller function's local `var x` SHADOWS a like-named global,
        # so `eval("x = 1")` inside `function(){ var x; … }` must hit that local, not the global
        # (eval-spread / compound-assignment scope tests). Skip the <main> frame's own locals
        # (those ARE the globals, handled below) via skip_main=True. This runs even when `x`
        # is also a global — the caller local wins.
        if self._eval_scope_store(gn2, sg_val, True) {
            return;
        }
        # Cache intern id in arg3 (unused by STORE_GLOBAL at compile time).
        sg_kid2: int = ins.arg3;
        if sg_kid2 == 0 {
            sg_kid2 = str_intern(gn2);
            sg_pip: int = frame.ip - 1;
            if sg_pip >= 0 and sg_pip < len(frame.func.code) {
                sg_old: Instruction = frame.func.code[sg_pip];
                sg_old.arg3 = sg_kid2;
                sg_old.ic_epoch = 0;
            }
        }
        sg_pdesc: JSProperty = js_object_get_own_property_descriptor(
            self.global_this, sg_kid2
        );
        # Strict mode (arg2 == 1): assigning to an *unresolvable* reference (a name with
        # no binding anywhere) is a ReferenceError (ES §6.2.5.6 PutValue).  A binding
        # that merely holds `undefined` still exists and must not throw — so we test
        # membership, not the value.
        if ins.arg2 == 1 {
            sg_exists: bool = gn2 in self.globals or not sg_pdesc.deleted;
            if not sg_exists {
                exc_sg: JSValue = make_reference_error(gn2 + " is not defined");
                if not self._unwind_in_frame(frame, exc_sg) {
                    self.had_exception = True;
                    self.pending_exc = exc_sg;
                    st.running = False;
                }
                return;
            }
        }
        # Global defined as an accessor (Object.defineProperty(globalThis, …, {get/set})):
        # route through the setter — running it (and observing its throw), or, for a
        # getter-only accessor, throwing TypeError in strict mode (no-op in sloppy).
        sg_getter: JSValue = js_object_get_own_accessor_getter(
            self.global_this, sg_kid2
        );
        sg_setter: JSValue = js_object_get_own_accessor_setter(
            self.global_this, sg_kid2
        );
        if not jsv_is_undefined(sg_getter) or not jsv_is_undefined(sg_setter) {
            if not jsv_is_undefined(sg_setter) {
                if is_fn_val(sg_setter) {
                    self.run_cl(
                        self.realm.closures[get_fn_idx(sg_setter)],
                        sg_setter,
                        self.global_this,
                        [sg_val]
                    );
                    if self.had_exception {
                        sg_sx: JSValue = self.pending_exc;
                        self.had_exception = False;
                        self.pending_exc = js_undefined();
                        if not self._unwind_in_frame(frame, sg_sx) {
                            self.had_exception = True;
                            self.pending_exc = sg_sx;
                            st.running = False;
                        }
                    }
                }
            } elif ins.arg2 == 1 {
                exc_sgns: JSValue = make_type_error(
                    "Cannot set property " + gn2 + " which has only a getter"
                );
                if not self._unwind_in_frame(frame, exc_sgns) {
                    self.had_exception = True;
                    self.pending_exc = exc_sgns;
                    st.running = False;
                }
            }
            return;
        }
        # Sloppy-mode: silently ignore writes to non-writable own properties (§19.1)
        if sg_pdesc.deleted or sg_pdesc.writable {
            self.globals[gn2] = sg_val;
            self.gw_epoch = self.gw_epoch + 1;
            js_object_set(self.global_this, sg_kid2, sg_val);
        }
    }

    def _op_store_module_global(
        frame: CallFrame, ins: Instruction, st: ExecState
    ) -> None {
        smg_name: str = frame.func.constants.get(ins.arg);
        smg_val: JSValue = self._pop();
        # Sandbox code has no separate module-globals map: a top-level `var` /
        # `function` in vm.runInContext becomes an own property of the sandbox
        # (V8 GlobalDeclarationInstantiation on the context's global object).
        smg_ctx: JSValue = self._frame_ctx_global(frame);
        if smg_ctx != 0 {
            js_object_set(smg_ctx, str_intern(smg_name), smg_val);
            return;
        }
        # Direct-eval `var x` created a dyn_var on a caller frame's variable environment
        # (a top-level `var` in the eval'd Script also lowers to STORE_MODULE_GLOBAL). That
        # binding SHADOWS a like-named global, so the write must target it even when `x` is
        # already a global — checked before the `smg_name not in self.globals` guard, which
        # otherwise routes straight to self.globals (test262 compound-assignment/
        # S11.13.2_A6.*_T1).
        if self._eval_dynvar_store(smg_name, smg_val) {
            return;
        }
        if smg_name not in self.globals and self._eval_scope_store(smg_name, smg_val) {
            return;
        }
        self.globals[smg_name] = smg_val;
        self.gw_epoch = self.gw_epoch + 1;
        if ins.arg2 != 1 {
            self.globals_off_object[smg_name] = True;
        }
        # Classic script (arg2==1): a top-level `var`/`function`/`class` binding is also an
        # own property of the global object (GlobalDeclarationInstantiation), so `globalThis.x`
        # sees it. Modules (arg2==0) keep their top-level bindings off globalThis. Guard on
        # writability so a redeclared non-writable global (undefined/NaN/Infinity) is a no-op,
        # mirroring _op_store_global.
        if ins.arg2 == 1 {
            smg_kid: int = str_intern(smg_name);
            smg_pd: JSProperty = js_object_get_own_property_descriptor(
                self.global_this, smg_kid
            );
            if smg_pd.deleted {
                # ES §9.1.1.4.17 CreateGlobalVarBinding: a top-level `var`/`function` global
                # property is { writable:T, enumerable:T, configurable:F } — so `delete
                # globalThis.x` / `delete this.x` returns false (test262 delete/S11.4.1_A3.1).
                smg_new: JSProperty = JSProperty(
                    key=smg_kid,
                    value=smg_val,
                    writable=True,
                    enumerable=True,
                    configurable=False,
                    deleted=False
                );
                js_object_define_property(self.global_this, smg_kid, smg_new);
            } elif smg_pd.writable {
                js_object_set(self.global_this, smg_kid, smg_val);
            }
        }
    }

    def _op_create_global_fn_binding(
        frame: CallFrame, ins: Instruction, st: ExecState
    ) {
        cgfb_name: str = frame.func.constants.get(ins.arg);
        cgfb_val: JSValue = self._pop();
        cgfb_cfg: bool = ins.arg2 != 0;
        self._create_global_fn_binding(cgfb_name, cgfb_val, cgfb_cfg);
    }

    # ── with statement ──────────────────────────────────────────────────

    def _op_with_push(frame: CallFrame, ins: Instruction, st: ExecState) -> None {
        wp_obj: JSValue = self._pop();
        # §13.11.7: with(null|undefined) throws TypeError when evaluated.
        if jsv_is_null(wp_obj) or jsv_is_undefined(wp_obj) {
            wp_exc: JSValue = make_type_error(
                "Cannot convert undefined or null to object"
            );
            if not self._unwind_in_frame(frame, wp_exc) {
                self.had_exception = True;
                self.pending_exc = wp_exc;
                st.running = False;
            }
            return;
        }
        frame.with_objs.append(wp_obj);
        frame.rare = True;
    }

    def _op_with_pop(frame: CallFrame, ins: Instruction, st: ExecState) {
        wpn: int = len(frame.with_objs);
        if wpn > 0 {
            del frame.with_objs[wpn - 1];
        }
    }

    # ── using / explicit resource management ──────────────────────────────────

    """Resolve a [Symbol.dispose]/[Symbol.asyncDispose] method on a disposable
    resource, walking the prototype chain for ordinary objects and resolving
    function/native receivers (so a function with the method on Function.prototype,
    or a getter-defined dispose, is found). Returns undefined if absent."""
    def _dispose_lookup(res: JSValue, key: int) -> JSValue {
        if is_fn_val(res) {
            return _fn_prop(res, key);
        }
        if is_native_val(res) {
            return _native_prop(res, key);
        }
        if jsv_is_object_cell(res) {
            return self._get_prop_accessor(res, key);
        }
        return js_undefined();
    }

    """USING_DECLARE — register the resource on TOS for disposal (ES §13.15).
    null/undefined are recorded as no-op resources; otherwise the value must have a
    callable [Symbol.dispose] (or [Symbol.asyncDispose] when arg2==1) — else TypeError.
    Pops the resource value."""
    def _op_using_declare(frame: CallFrame, ins: Instruction, st: ExecState) -> None {
        ud_res: JSValue = self._pop();
        # The async-dispose flag is emitted in `arg` (both compiler sites, and the
        # opcode's own doc in op.na.jac say so); reading arg2 always saw 0, so
        # `await using` never looked up [Symbol.asyncDispose] and an object that
        # only had it was rejected as "not disposable".
        ud_async: int = ins.arg;
        # null / undefined → no-op resource (still tracked so reverse order is correct,
        # but with no dispose method invoked).
        if jsv_is_null(ud_res) or jsv_is_undefined(ud_res) {
            frame.dispose_stack.append(ud_res);
            frame.rare = True;
            frame.dispose_async.append(ud_async);
            frame.rare = True;
            frame.dispose_methods.append(js_undefined());
            frame.rare = True;
            return;
        }
        # GetDisposeMethod: look up [Symbol.dispose] (sync) — for `await using` prefer
        # [Symbol.asyncDispose], falling back to [Symbol.dispose]. Resolved through the
        # full prototype chain incl. function/native receivers (e.g. a disposable
        # function with [Symbol.dispose] on Function.prototype).
        ud_method: JSValue = js_undefined();
        if ud_async == 1 {
            ud_method = self._dispose_lookup(
                ud_res, SYMBOL_KEY_BASE + SYMBOL_ASYNC_DISPOSE
            );
            if jsv_is_undefined(ud_method) {
                ud_method = self._dispose_lookup(
                    ud_res, SYMBOL_KEY_BASE + SYMBOL_DISPOSE
                );
            }
        } else {
            ud_method = self._dispose_lookup(ud_res, SYMBOL_KEY_BASE + SYMBOL_DISPOSE);
        }
        if jsv_is_undefined(ud_method)
            or not (is_fn_val(ud_method) or is_native_val(ud_method)) {
            ud_exc: JSValue = make_type_error(
                "using declaration value is not disposable (missing [Symbol.dispose] method)"
            );
            if not self._unwind_in_frame(frame, ud_exc) {
                self.had_exception = True;
                self.pending_exc = ud_exc;
                st.running = False;
            }
            return;
        }
        frame.dispose_stack.append(ud_res);
        frame.rare = True;
        frame.dispose_async.append(ud_async);
        frame.rare = True;
        frame.dispose_methods.append(ud_method);
        frame.rare = True;
    }

    """DISPOSE_MARK — push the current dispose-stack depth onto the frame's marker
    stack (not the operand stack), so abrupt completion can still find it."""
    def _op_dispose_mark(frame: CallFrame, ins: Instruction, st: ExecState) {
        frame.dispose_marks.append(len(frame.dispose_stack));
        frame.rare = True;
    }

    """DISPOSE_RUN — pop the innermost marker, dispose all resources registered above
    it in reverse (LIFO) order by calling their [Symbol.dispose](), skipping
    null/undefined."""
    def _op_dispose_run(frame: CallFrame, ins: Instruction, st: ExecState) -> None {
        dr_n: int = len(frame.dispose_marks);
        if dr_n == 0 {
            return;
        }
        dr_mark: int = frame.dispose_marks[dr_n - 1];
        del frame.dispose_marks[dr_n - 1];
        self._dispose_to(frame, dr_mark);
        # A throw from a dispose method is the completion of the block (§13.15.4).
        # Leaving had_exception set without unwinding let execution continue past
        # the scope, so the error escaped the function entirely — it never reached
        # an enclosing try/catch, nor an async function's returned promise.
        if self.had_exception {
            dr_exc: JSValue = self.pending_exc;
            self.had_exception = False;
            self.pending_exc = js_undefined();
            if not self._unwind_in_frame(frame, dr_exc) {
                self.had_exception = True;
                self.pending_exc = dr_exc;
                st.running = False;
            }
        }
    }

    """Dispose resources in frame.dispose_stack down to index `mark` (exclusive),
    in reverse order.  Shared by DISPOSE_RUN and abrupt-completion unwinding."""
    def _dispose_to(frame: CallFrame, mark: int) {
        di: int = len(frame.dispose_stack) - 1;
        while di >= mark {
            d_res: JSValue = frame.dispose_stack[di];
            # Use the dispose method captured at declaration time (ES §13.15.4) — do NOT
            # re-read [Symbol.dispose] here, or an accessor getter would be observed twice.
            d_method: JSValue = js_undefined();
            if di < len(frame.dispose_methods) {
                d_method = frame.dispose_methods[di];
            }
            di = di - 1;
            if jsv_is_null(d_res) or jsv_is_undefined(d_res) {
                continue;
            }
            d_ret: JSValue = js_undefined();
            if is_fn_val(d_method) {
                d_ret = vm_call_js_fn(self, d_method, d_res, []);
            } elif is_native_val(d_method) {
                d_ret = _vm_call_native_proxy_aware(
                    self, self.realm, get_native_kind(d_method), d_res, []
                );
            }
            # An async dispose returns a promise; a rejection from it is the
            # completion of the `await using` scope (§13.15.4 AsyncDisposeResources).
            # Dropping the result left it as an unhandled rejection and the error
            # never reached the enclosing async function.
            if js_is_promise(d_ret)
                and js_promise_get_state(d_ret) == PROMISE_REJECTED {
                promise_unmark_unhandled(d_ret);
                process_queue_rejection_handled(d_ret);
                if not self.had_exception {
                    self.had_exception = True;
                    self.pending_exc = js_promise_get_value(d_ret);
                }
            }
        }
        # Truncate the dispose stack back to the mark.
        while len(frame.dispose_stack) > mark {
            del frame.dispose_stack[len(frame.dispose_stack) - 1];
            del frame.dispose_async[len(frame.dispose_async) - 1];
            if len(frame.dispose_methods) > mark {
                del frame.dispose_methods[len(frame.dispose_methods) - 1];
            }
        }
    }

    """
    Return the with-object (innermost first) that provides a binding for `name`,
    honouring @@unscopables (ECMAScript §9.1.1.2.1 HasBinding for object
    environment records).  Returns js_undefined() if no with-object binds it.
    """
    def _with_resolve(frame: CallFrame, name: str) -> JSValue {
        return self._with_resolve_range(frame, name, 0, len(frame.with_objs));
    }

    """
    Like _with_resolve but only scans with_objs[lo:hi) (innermost-first within that
    window).  Lets LOAD_NAME/STORE_NAME check the current frame's own with-objects
    (indices >= with_inherited) before locals, and the inherited (outer) ones after.
    """
    def _with_resolve_range(frame: CallFrame, name: str, lo: int, hi: int) -> JSValue {
        wr_i: int = hi - 1;
        wr_key: int = str_intern(name);
        while wr_i >= lo {
            wr_obj: JSValue = frame.with_objs[wr_i];
            # Object Environment Record HasBinding uses [[HasProperty]] — must observe
            # Proxy `has` traps (and propagate TypeError from invariant failures).
            wr_has: bool = self.obs_has(wr_obj, wr_key);
            if vm_has_native_exc() {
                return js_undefined();
            }
            if wr_has {
                # @@unscopables: a truthy entry blocks the binding.
                wr_unscop: JSValue = self.obs_get(
                    wr_obj, SYMBOL_KEY_BASE + SYMBOL_UNSCOPABLES, wr_obj
                );
                if vm_has_native_exc() {
                    return js_undefined();
                }
                wr_blocked: bool = False;
                if jsv_is_object_cell(wr_unscop) {
                    wr_flag: JSValue = self.obs_get(wr_unscop, wr_key, wr_unscop);
                    if vm_has_native_exc() {
                        return js_undefined();
                    }
                    if jsv_coerce_to_bool(wr_flag) {
                        wr_blocked = True;
                    }
                }
                if not wr_blocked {
                    return wr_obj;
                }
            }
            wr_i = wr_i - 1;
        }
        return js_undefined();
    }

    def _op_load_name(frame: CallFrame, ins: Instruction, st: ExecState) -> None {
        ln_name: str = frame.func.constants.get(ins.arg);
        # 1. with-objects pushed *within this frame* (inner to the frame's own bindings).
        #    Inherited (outer-closure) with-objects are checked in step 3a, AFTER locals,
        #    so a `var` hoisted into this function shadows an outer with-binding (ES §9.1).
        ln_wobj: JSValue = self._with_resolve_range(
            frame, ln_name, frame.with_inherited, len(frame.with_objs)
        );
        if vm_has_native_exc() {
            # Proxy has / unscopables abrupt → TypeError (not ReferenceError).
            exc_ln_w: JSValue = vm_take_native_exc();
            if not self._unwind_in_frame(frame, exc_ln_w) {
                self.had_exception = True;
                self.pending_exc = exc_ln_w;
                st.running = False;
            }
            return;
        }
        if jsv_is_object_cell(ln_wobj) {
            # ES §9.1.1.2.6 GetBindingValue: after HasBinding resolves the object env
            # record, step 2 performs a SECOND HasProperty(bindings, N) (observable via a
            # Proxy `has` trap), and step 3 throws a ReferenceError in strict mode if it
            # is now false (the binding was deleted between HasBinding and the read).
            ln_has2: bool = self.obs_has(ln_wobj, str_intern(ln_name));
            if vm_has_native_exc() {
                exc_ln_h2: JSValue = vm_take_native_exc();
                if not self._unwind_in_frame(frame, exc_ln_h2) {
                    self.had_exception = True;
                    self.pending_exc = exc_ln_h2;
                    st.running = False;
                }
                return;
            }
            if not ln_has2 {
                if frame.func.is_strict {
                    exc_ln_rf: JSValue = make_reference_error(
                        ln_name + " is not defined"
                    );
                    if not self._unwind_in_frame(frame, exc_ln_rf) {
                        self.had_exception = True;
                        self.pending_exc = exc_ln_rf;
                        st.running = False;
                    }
                    return;
                }
                self._push(js_undefined());
                return;
            }
            ln_got: JSValue = self.obs_get(ln_wobj, str_intern(ln_name), ln_wobj);
            if vm_has_native_exc() {
                exc_ln_g: JSValue = vm_take_native_exc();
                if not self._unwind_in_frame(frame, exc_ln_g) {
                    self.had_exception = True;
                    self.pending_exc = exc_ln_g;
                    st.running = False;
                }
                return;
            }
            self._push(ln_got);
            return;
        }
        # 2. frame locals by name (a name compiled inside `with` may still be a local)
        ln_li: int = 0;
        ln_nloc: int = len(frame.func.locals);
        while ln_li < ln_nloc {
            if frame.func.locals[ln_li] == ln_name {
                ln_lv: JSValue = frame.locals[frame.lb + (ln_li)];
                if is_cell(ln_lv) {
                    self._push(cell_get(ln_lv));
                } else {
                    self._push(ln_lv);
                }
                return;
            }
            ln_li = ln_li + 1;
        }
        # 2b. direct-eval dyn_var bindings (ES §19.2.1.3): a `var` introduced at runtime by
        #     a direct eval lives in THIS frame's variable environment, so it resolves after
        #     the frame's own compiled locals but BEFORE any captured free-var of the same
        #     name (which it shadows).  test262 compound-assignment/S11.13.2_A6.*_T1.
        ln_di: int = 0;
        while ln_di < len(frame.dyn_var_names) {
            if frame.dyn_var_names[ln_di] == ln_name
                and ln_di < len(frame.dyn_var_vals) {
                self._push(frame.dyn_var_vals[ln_di]);
                return;
            }
            ln_di = ln_di + 1;
        }
        # 3a. inherited (outer-closure) with-objects: an object env record from the scope
        #     where this function was defined.  Checked after this frame's own locals but
        #     before free variables / globals (ES §9.1 nesting).
        if frame.with_inherited > 0 {
            ln_iwobj: JSValue = self._with_resolve_range(
                frame, ln_name, 0, frame.with_inherited
            );
            if vm_has_native_exc() {
                exc_ln_iw: JSValue = vm_take_native_exc();
                if not self._unwind_in_frame(frame, exc_ln_iw) {
                    self.had_exception = True;
                    self.pending_exc = exc_ln_iw;
                    st.running = False;
                }
                return;
            }
            if jsv_is_object_cell(ln_iwobj) {
                # GetBindingValue second HasProperty (§9.1.1.2.6) — same as the in-frame
                # with path above; strict ReferenceError if the binding was deleted (e.g.
                # by the @@unscopables getter during HasBinding).
                ln_ihas2: bool = self.obs_has(ln_iwobj, str_intern(ln_name));
                if vm_has_native_exc() {
                    exc_ln_ih2: JSValue = vm_take_native_exc();
                    if not self._unwind_in_frame(frame, exc_ln_ih2) {
                        self.had_exception = True;
                        self.pending_exc = exc_ln_ih2;
                        st.running = False;
                    }
                    return;
                }
                if not ln_ihas2 {
                    if frame.func.is_strict {
                        exc_ln_irf: JSValue = make_reference_error(
                            ln_name + " is not defined"
                        );
                        if not self._unwind_in_frame(frame, exc_ln_irf) {
                            self.had_exception = True;
                            self.pending_exc = exc_ln_irf;
                            st.running = False;
                        }
                        return;
                    }
                    self._push(js_undefined());
                    return;
                }
                ln_igot: JSValue = self.obs_get(
                    ln_iwobj, str_intern(ln_name), ln_iwobj
                );
                if vm_has_native_exc() {
                    exc_ln_ig: JSValue = vm_take_native_exc();
                    if not self._unwind_in_frame(frame, exc_ln_ig) {
                        self.had_exception = True;
                        self.pending_exc = exc_ln_ig;
                        st.running = False;
                    }
                    return;
                }
                self._push(ln_igot);
                return;
            }
        }
        # 3. captured free variables by name
        ln_fi: int = 0;
        ln_nfree: int = len(frame.func.free_vars);
        while ln_fi < ln_nfree {
            if frame.func.free_vars[ln_fi] == ln_name
                and ln_fi < len(frame.free_vals) {
                self._push(cell_get(frame.free_vals[ln_fi]));
                return;
            }
            ln_fi = ln_fi + 1;
        }
        # 4. globals → globalThis fallback (mirrors _op_load_global)
        ln_ctx: JSValue = self._frame_ctx_global(frame);
        if ln_ctx != 0 {
            self._load_global_ctx(frame, ins, st, ln_name, ln_ctx);
            return;
        }
        # Top-level lexical bindings (script `let`/`const`, $262.evalScript persistents) live
        # in global_lexical, NOT self.globals — LOAD_GLOBAL checks it first, so LOAD_NAME must
        # too, else a direct-eval-forced dynamic body cannot see a top-level `let` (e.g. a fn
        # that reads an outer `let callCount` and also contains a direct eval).
        if ln_name in self.global_lexical {
            self._push(self.global_lexical[ln_name]);
            return;
        }
        if ln_name in self.globals {
            self._push(self.globals[ln_name]);
        } else {
            ln_gt: JSValue = js_object_get(self.global_this, str_intern(ln_name));
            if jsv_is_undefined(ln_gt)
                and not js_object_has(self.global_this, str_intern(ln_name)) {
                ln_exc: JSValue = make_reference_error(ln_name + " is not defined");
                if not self._unwind_in_frame(frame, ln_exc) {
                    self.had_exception = True;
                    self.pending_exc = ln_exc;
                    st.running = False;
                }
            } else {
                self._push(ln_gt);
            }
        }
    }

    """True if `name` is the IMMUTABLE named-function-expression self-name of some
    frame in the current direct-eval scope boundary (ES §15.2.5).  Used by
    STORE_NAME to reject an eval-driven reassignment of a function's own name.
    Only the frames at/above the eval boundary are consulted, so a same-named
    ordinary binding in an unrelated frame is never mistaken for a self-name."""
    def _name_is_immutable_fnself(name: str) -> bool {
        nif_boundary: int = 0;
        if len(self.eval_scope_frames) > 0 {
            nif_boundary = self.eval_scope_frames[len(self.eval_scope_frames) - 1];
        }
        nif_i: int = len(self.frames) - 1;
        while nif_i >= 0 and nif_i >= nif_boundary - 1 {
            if self.frames[nif_i].func.self_name == name {
                return True;
            }
            nif_i = nif_i - 1;
        }
        return False;
    }

    def _op_store_name(frame: CallFrame, ins: Instruction, st: ExecState) {
        sn_name: str = frame.func.constants.get(ins.arg);
        sn_val: JSValue = self._pop();
        self._store_name_resolved(frame, ins, st, sn_name, sn_val, False, -1);
    }

    """Store `sn_val` to the binding named `sn_name`, resolving with-object → local →
    inherited-with → free → global (the normal chain). When `skip_with` is True the
    with-object scopes (this frame's own AND inherited) are NOT consulted — used by
    STORE_NAME_REF after LOAD_NAME_REF resolved the reference to a lexical binding, so a
    with-property ADDED during RHS evaluation cannot re-target the write (ES §13.15.2
    once-semantics; test262 S11.13.1_A6_T3: `with(scope){ x = (scope.x = 2, 1) }` writes
    the local `x`, not the freshly-created `scope.x`)."""
    def _store_name_resolved(
        frame: CallFrame,
        ins: Instruction,
        st: ExecState,
        sn_name: str,
        sn_val: JSValue,
        skip_with: bool,
        dynvar_cutoff: int
    ) -> None {
        # `dynvar_cutoff` implements ES §13.15.2 once-semantics for the dyn_var scope on the
        # STORE_NAME_REF path: -1 = consult ALL dyn_vars (the normal STORE_NAME path); >= 0 =
        # only dyn_vars that already EXISTED when LOAD_NAME_REF resolved the reference (index <
        # cutoff), so a dyn_var a direct eval created DURING the RHS cannot re-target the write
        # (test262 compound-assignment/S11.13.2_A6.*_T1: `x *= (eval("var x=2"),4)` writes the
        # OUTER x while the eval-introduced inner x stays 2).
        # 1. with-objects pushed within THIS frame (inner to the frame's own bindings).
        if not skip_with {
            sn_wobj: JSValue = self._with_resolve_range(
                frame, sn_name, frame.with_inherited, len(frame.with_objs)
            );
            if vm_has_native_exc() {
                exc_sn_w: JSValue = vm_take_native_exc();
                if not self._unwind_in_frame(frame, exc_sn_w) {
                    self.had_exception = True;
                    self.pending_exc = exc_sn_w;
                    st.running = False;
                }
                return;
            }
            if jsv_is_object_cell(sn_wobj) {
                # ES §9.1.1.2.5 SetMutableBinding: step 1 re-checks HasProperty(bindings, N)
                # (observable `has` trap); step 2 throws a ReferenceError in strict mode if
                # the binding no longer exists.
                sn_has2: bool = self.obs_has(sn_wobj, str_intern(sn_name));
                if vm_has_native_exc() {
                    exc_sn_h2: JSValue = vm_take_native_exc();
                    if not self._unwind_in_frame(frame, exc_sn_h2) {
                        self.had_exception = True;
                        self.pending_exc = exc_sn_h2;
                        st.running = False;
                    }
                    return;
                }
                if not sn_has2 and frame.func.is_strict {
                    exc_sn_rf: JSValue = make_reference_error(
                        sn_name + " is not defined"
                    );
                    if not self._unwind_in_frame(frame, exc_sn_rf) {
                        self.had_exception = True;
                        self.pending_exc = exc_sn_rf;
                        st.running = False;
                    }
                    return;
                }
                _ = self.obs_set(sn_wobj, str_intern(sn_name), sn_val, sn_wobj);
                if vm_has_native_exc() {
                    exc_sn_s: JSValue = vm_take_native_exc();
                    if not self._unwind_in_frame(frame, exc_sn_s) {
                        self.had_exception = True;
                        self.pending_exc = exc_sn_s;
                        st.running = False;
                    }
                }
                return;
            }
        }
        # 2. frame locals by name
        sn_li: int = 0;
        sn_nloc: int = len(frame.func.locals);
        while sn_li < sn_nloc {
            if frame.func.locals[sn_li] == sn_name {
                sn_lv: JSValue = frame.locals[frame.lb + (sn_li)];
                if is_cell(sn_lv) {
                    cell_set(sn_lv, sn_val);
                } else {
                    frame.locals[frame.lb + (sn_li)] = sn_val;
                }
                return;
            }
            sn_li = sn_li + 1;
        }
        # 2b. direct-eval dyn_var bindings (ES §19.2.1.3): part of THIS frame's variable
        #     environment — written after the frame's own locals but BEFORE any captured
        #     free-var of the same name (which it shadows).  A `var x` created by a direct
        #     eval must receive later writes to `x` from this frame's code, not the outer
        #     binding.  `dynvar_cutoff` enforces once-semantics on the REF path: a dyn_var
        #     the RHS's eval created AFTER LOAD_NAME_REF resolved the reference (index >=
        #     cutoff) is NOT a valid write target (test262 compound-assignment/
        #     S11.13.2_A6.*_T1).  cutoff < 0 (normal STORE_NAME) consults all dyn_vars.
        sn_di: int = 0;
        while sn_di < len(frame.dyn_var_names) {
            if frame.dyn_var_names[sn_di] == sn_name
                and sn_di < len(frame.dyn_var_vals)
                and (dynvar_cutoff < 0 or sn_di < dynvar_cutoff) {
                frame.dyn_var_vals[sn_di] = sn_val;
                return;
            }
            sn_di = sn_di + 1;
        }
        # 3a. inherited (outer-closure) with-objects — after this frame's locals.
        if not skip_with and frame.with_inherited > 0 {
            sn_iwobj: JSValue = self._with_resolve_range(
                frame, sn_name, 0, frame.with_inherited
            );
            if jsv_is_object_cell(sn_iwobj) {
                js_object_set(sn_iwobj, str_intern(sn_name), sn_val);
                return;
            }
        }
        # 3. captured free variables by name
        sn_fi: int = 0;
        sn_nfree: int = len(frame.func.free_vars);
        while sn_fi < sn_nfree {
            if frame.func.free_vars[sn_fi] == sn_name
                and sn_fi < len(frame.free_vals) {
                # ES §15.2.5: the named-function-expression self-name is an IMMUTABLE
                # binding.  Direct code enforces this at compile time (fnself kind), but
                # a *direct eval* inside the body compiles a separate program that can
                # only see `name` as a runtime free-var and reaches this write.  If any
                # frame in the eval's inherited scope owns `sn_name` as its self-name,
                # the write targets that immutable cell: silent no-op (sloppy) /
                # TypeError (strict).  self_name is "" for declarations/arrows/anon and
                # when a body decl shadowed it, so ordinary free-var writes are unaffected.
                if len(self.eval_scope_frames) > 0
                    and self._name_is_immutable_fnself(sn_name) {
                    if frame.func.is_strict {
                        exc_sn_fs: JSValue = make_type_error(
                            "Assignment to constant variable."
                        );
                        if not self._unwind_in_frame(frame, exc_sn_fs) {
                            self.had_exception = True;
                            self.pending_exc = exc_sn_fs;
                            st.running = False;
                        }
                    }
                    return;
                }
                cell_set(frame.free_vals[sn_fi], sn_val);
                return;
            }
            sn_fi = sn_fi + 1;
        }
        # 4. globals (mirrors _op_store_global semantics)
        sn_ctx: JSValue = self._frame_ctx_global(frame);
        if sn_ctx != 0 {
            self._store_global_ctx(frame, ins, st, sn_name, sn_val, sn_ctx);
            return;
        }
        # Top-level lexical binding (script `let`/`const`) — update it in place rather than
        # shadowing it with a self.globals data property (mirrors LOAD_NAME step 4).
        if sn_name in self.global_lexical {
            self.global_lexical[sn_name] = sn_val;
            return;
        }
        sn_kid: int = str_intern(sn_name);
        sn_pdesc: JSProperty = js_object_get_own_property_descriptor(
            self.global_this, sn_kid
        );
        # Strict mode (arg2 == 1): an unresolvable reference — no with-object binding (a
        # deleted with property falls through to here), no local/free, and no global
        # binding — is a ReferenceError (ES §6.2.5.6 PutValue / object env record
        # SetMutableBinding with S=true).
        if ins.arg2 == 1 {
            sn_exists: bool = sn_name in self.globals or not sn_pdesc.deleted;
            if not sn_exists {
                exc_sn: JSValue = make_reference_error(sn_name + " is not defined");
                if not self._unwind_in_frame(frame, exc_sn) {
                    self.had_exception = True;
                    self.pending_exc = exc_sn;
                    st.running = False;
                }
                return;
            }
        }
        if sn_pdesc.deleted or sn_pdesc.writable {
            self.globals[sn_name] = sn_val;
            self.gw_epoch = self.gw_epoch + 1;
            js_object_set(self.global_this, sn_kid, sn_val);
        }
    }

    """LOAD_NAME_REF — resolve a bare identifier reference ONCE for a read-modify-write
    inside `with` (ES §13.15.2). Pushes [base, value] (arg2==0) or just [base] (arg2==1,
    "base-only"): `base` is the resolving with-object cell when the name binds to one,
    else js_null() (the lexical/global sentinel). STORE_NAME_REF later writes through this
    captured base, so a getter/side effect that mutates the scope during the RHS cannot
    re-target the write.
      - Compound assignment (`x op= rhs`) needs the current value, so it reads it
        (arg2==0) — a read of an unbound name correctly throws ReferenceError.
      - Plain assignment (`x = rhs`) needs ONLY the base: it must NOT read the value, or a
        write to an unbound/write-only target (`with(o){ p5 = 1 }`, sloppy implicit global)
        would throw a spurious ReferenceError. Those emit arg2==1."""
    def _op_load_name_ref(frame: CallFrame, ins: Instruction, st: ExecState) -> None {
        lnr_name: str = frame.func.constants.get(ins.arg);
        lnr_base_only: bool = ins.arg2 == 1;
        # With-objects in this frame (inner to the frame's own bindings), then locals,
        # then inherited (outer-closure) with-objects — matching _op_load_name order.
        lnr_wobj: JSValue = self._with_resolve_range(
            frame, lnr_name, frame.with_inherited, len(frame.with_objs)
        );
        if vm_has_native_exc() {
            exc_lnr_w: JSValue = vm_take_native_exc();
            if not self._unwind_in_frame(frame, exc_lnr_w) {
                self.had_exception = True;
                self.pending_exc = exc_lnr_w;
                st.running = False;
            }
            return;
        }
        if not jsv_is_object_cell(lnr_wobj) {
            # Not bound by an in-frame with-object; check locals before inherited with.
            lnr_li: int = 0;
            while lnr_li < len(frame.func.locals) {
                if frame.func.locals[lnr_li] == lnr_name {
                    # Lexical base sentinel carrying the dyn_var count at ref-resolution
                    # time (ES §13.15.2 once-semantics — STORE_NAME_REF only writes a
                    # dyn_var that already existed here).
                    self._push(js_int(len(frame.dyn_var_names)));
                    if not lnr_base_only {
                        lnr_lv: JSValue = frame.locals[frame.lb + (lnr_li)];
                        if is_cell(lnr_lv) {
                            self._push(cell_get(lnr_lv));
                        } else {
                            self._push(lnr_lv);
                        }
                    }
                    return;
                }
                lnr_li = lnr_li + 1;
            }
            if frame.with_inherited > 0 {
                lnr_iw: JSValue = self._with_resolve_range(
                    frame, lnr_name, 0, frame.with_inherited
                );
                if vm_has_native_exc() {
                    exc_lnr_iw: JSValue = vm_take_native_exc();
                    if not self._unwind_in_frame(frame, exc_lnr_iw) {
                        self.had_exception = True;
                        self.pending_exc = exc_lnr_iw;
                        st.running = False;
                    }
                    return;
                }
                if jsv_is_object_cell(lnr_iw) {
                    lnr_wobj = lnr_iw;
                }
            }
        }
        if jsv_is_object_cell(lnr_wobj) {
            if lnr_base_only {
                self._push(lnr_wobj);
                return;
            }
            # ES §9.1.1.2.6 GetBindingValue: second HasProperty (observable `has`
            # trap) before the Get; strict ReferenceError if the binding vanished.
            lnr_has2: bool = self.obs_has(lnr_wobj, str_intern(lnr_name));
            if vm_has_native_exc() {
                exc_lnr_h2: JSValue = vm_take_native_exc();
                if not self._unwind_in_frame(frame, exc_lnr_h2) {
                    self.had_exception = True;
                    self.pending_exc = exc_lnr_h2;
                    st.running = False;
                }
                return;
            }
            if not lnr_has2 {
                if frame.func.is_strict {
                    exc_lnr_rf: JSValue = make_reference_error(
                        lnr_name + " is not defined"
                    );
                    if not self._unwind_in_frame(frame, exc_lnr_rf) {
                        self.had_exception = True;
                        self.pending_exc = exc_lnr_rf;
                        st.running = False;
                    }
                    return;
                }
                self._push(lnr_wobj);
                self._push(js_undefined());
                return;
            }
            lnr_got: JSValue = self.obs_get(lnr_wobj, str_intern(lnr_name), lnr_wobj);
            if vm_has_native_exc() {
                exc_lnr_g: JSValue = vm_take_native_exc();
                if not self._unwind_in_frame(frame, exc_lnr_g) {
                    self.had_exception = True;
                    self.pending_exc = exc_lnr_g;
                    st.running = False;
                }
                return;
            }
            self._push(lnr_wobj);
            self._push(lnr_got);
            return;
        }
        # Lexical/global: push the sentinel base carrying the dyn_var count at
        # ref-resolution time (ES §13.15.2 once-semantics). For arg2==0 also fetch the
        # value the normal way (may throw ReferenceError if unbound — correct for
        # compound assign); for base-only (arg2==1) leave just the sentinel, so a
        # write-only target never triggers a value read.
        self._push(js_int(len(frame.dyn_var_names)));
        if not lnr_base_only {
            self._op_load_name(frame, ins, st);
        }
    }

    """STORE_NAME_REF — write the top value to the base captured by LOAD_NAME_REF.
    Stack: [base, newValue]. A with-object base is written directly (PutValue on the
    initially-created Reference — even when a getter deleted the property mid-read, ES
    §13.15.2 / object env record SetMutableBinding). A js_null() base falls back to the
    normal STORE_NAME resolution (arg2=1 → strict)."""
    def _op_store_name_ref(frame: CallFrame, ins: Instruction, st: ExecState) -> None {
        snr_val: JSValue = self._pop();
        snr_base: JSValue = self._pop();
        snr_name: str = frame.func.constants.get(ins.arg);
        if jsv_is_object_cell(snr_base) {
            snr_key: int = str_intern(snr_name);
            # ES §9.1.1.2.5 SetMutableBinding on an object env record: step 1 ALWAYS
            # performs `stillExists = HasProperty(bindings, N)` (observable `has` trap,
            # even in sloppy mode — set-mutable-binding-idref-with-proxy-env). Only the
            # step-2 throw is gated on strict mode (…-putvalue-lref--v--*); sloppy
            # silently create/updates it on the with-object.
            snr_still: bool = self.obs_has(snr_base, snr_key);
            if vm_has_native_exc() {
                exc_snr_h: JSValue = vm_take_native_exc();
                if not self._unwind_in_frame(frame, exc_snr_h) {
                    self.had_exception = True;
                    self.pending_exc = exc_snr_h;
                    st.running = False;
                }
                return;
            }
            if ins.arg2 == 1 and not snr_still {
                snr_rerr: JSValue = make_reference_error(snr_name + " is not defined");
                if not self._unwind_in_frame(frame, snr_rerr) {
                    self.had_exception = True;
                    self.pending_exc = snr_rerr;
                    st.running = False;
                }
                return;
            }
            _ = self.obs_set(snr_base, snr_key, snr_val, snr_base);
            if vm_has_native_exc() {
                exc_snr: JSValue = vm_take_native_exc();
                if not self._unwind_in_frame(frame, exc_snr) {
                    self.had_exception = True;
                    self.pending_exc = exc_snr;
                    st.running = False;
                }
                return;
            }
            # Leave the assigned value as the assignment-expression result.
            self._push(snr_val);
            return;
        }
        # Lexical/global sentinel: LOAD_NAME_REF resolved the reference to a lexical
        # binding (local/free/global) with the with-objects already excluded, so the
        # write must SKIP the with-object scopes too — a property added to a with-object
        # during RHS evaluation must not capture this store (ES §13.15.2; S11.13.1_A6_T3).
        # The sentinel is js_int(dyn_var count at ref time); pass it as the dyn_var
        # write cutoff so a dyn_var a direct eval created DURING the RHS (index >= cutoff)
        # is not a valid target either (S11.13.2_A6.*_T1).
        snr_cutoff: int = 0;
        if jsv_is_int32(snr_base) {
            snr_cutoff = jsv_to_int32(snr_base);
        }
        self._store_name_resolved(frame, ins, st, snr_name, snr_val, True, snr_cutoff);
        self._push(snr_val);
    }

    """LOAD_CLASS_BRAND — push the per-evaluation private brand of the class the executing
    method / field-initializer belongs to (ES §6.2.12 / §15.7): the running closure's
    `class_brand`, captured at DEFINE_* time from the class object. js_int(0) when the frame
    has no class-member self_fn."""
    def _op_load_class_brand(frame: CallFrame, ins: Instruction, st: ExecState) {
        lcb_brand: JSValue = js_int(0);
        # Workaround: read through a local ref (direct glob_list[i].field read is dropped).
        if is_fn_val(frame.self_fn) {
            lcb_cl: JSClosure = self.realm.closures[get_fn_idx(frame.self_fn)];
            lcb_brand = lcb_cl.class_brand;
        }
        self._push(lcb_brand);
    }

    def _op_install_brand(frame: CallFrame, ins: Instruction, st: ExecState) -> None {
        ib_val: JSValue = self._pop();
        ib_obj: JSValue = self._pop();
        ib_key: int = str_intern(frame.func.constants.get(ins.arg));
        # ES §7.3.28 PrivateMethodOrAccessorAdd step 3 / §7.3.27 PrivateFieldAdd: if the
        # object ALREADY has this class's private brand as an OWN property, adding it again
        # is a TypeError (a Base ctor that `return o` lets `new C(o)` install onto the same o
        # twice — test262 private-method-double-initialisation*). Also enforce
        # non-extensibility: PrivateFieldAdd on a non-extensible object where the brand isn't
        # already present must still succeed (private state is not an ordinary own property),
        # so use js_object_define_nonenum which bypasses the extensibility gate.
        if jsv_is_object_cell(ib_obj) and jsv_to_table_id(ib_obj) > 0 {
            if js_object_has_own(ib_obj, ib_key) {
                exc_ib: JSValue = make_type_error(
                    "Cannot install private members on an object more than once"
                );
                if not self._unwind_in_frame(frame, exc_ib) {
                    self.had_exception = True;
                    self.pending_exc = exc_ib;
                    st.running = False;
                }
                return;
            }
            js_object_define_nonenum(ib_obj, ib_key, ib_val);
        }
    }

    def _op_load_free(frame: CallFrame, ins: Instruction, st: ExecState) -> None {
        if ins.arg < len(frame.free_vals) {
            lf_v: JSValue = cell_get(frame.free_vals[ins.arg]);
            # TDZ: a captured `let`/`const` still holding the sentinel was read through a
            # closure before its declaration ran — ReferenceError (ES §9.1.1.1.6 / §14.3.1).
            if js_is_tdz(lf_v) {
                lf_name: str = "";
                if ins.arg < len(frame.func.free_vars) {
                    lf_name = frame.func.free_vars[ins.arg];
                }
                exc_lf: JSValue = make_reference_error(
                    "Cannot access '" + lf_name + "' before initialization"
                );
                if not self._unwind_in_frame(frame, exc_lf) {
                    self.had_exception = True;
                    self.pending_exc = exc_lf;
                    st.running = False;
                }
                return;
            }
            self._push(lf_v);
        } else {
            self._push(js_undefined());
        }
    }

    def _op_store_free(frame: CallFrame, ins: Instruction, st: ExecState) -> None {
        if ins.arg < len(frame.free_vals) {
            sf_val: JSValue = self._pop();
            # TDZ: assigning to a captured `let`/`const` still uninitialized (sentinel) is a
            # ReferenceError — the binding exists but has no value yet (ES §9.1.1.1.5).
            if js_is_tdz(cell_get(frame.free_vals[ins.arg])) {
                sf_name: str = "";
                if ins.arg < len(frame.func.free_vars) {
                    sf_name = frame.func.free_vars[ins.arg];
                }
                exc_sf: JSValue = make_reference_error(
                    "Cannot access '" + sf_name + "' before initialization"
                );
                if not self._unwind_in_frame(frame, exc_sf) {
                    self.had_exception = True;
                    self.pending_exc = exc_sf;
                    st.running = False;
                }
                return;
            }
            cell_set(frame.free_vals[ins.arg], sf_val);
        } else {
            self._pop();
        }
    }

    def _op_make_cell(frame: CallFrame, ins: Instruction, st: ExecState) {
        frame.locals[frame.lb + (ins.arg)] = make_cell(
            frame.locals[frame.lb + (ins.arg)]
        );
    }

    def _op_load_deref(frame: CallFrame, ins: Instruction, st: ExecState) {
        ld_v: JSValue = frame.locals[frame.lb + (ins.arg)];
        if js_is_tdz(ld_v) {
            ld_name: str = "";
            if ins.arg < len(frame.func.locals) {
                ld_name = frame.func.locals[ins.arg];
            }
            exc_ld: JSValue = make_reference_error(
                "Cannot access '" + ld_name + "' before initialization"
            );
            if not self._unwind_in_frame(frame, exc_ld) {
                self.had_exception = True;
                self.pending_exc = exc_ld;
                st.running = False;
            }
        } else {
            self._push(cell_get(ld_v));
        }
    }

    def _op_store_deref(frame: CallFrame, ins: Instruction, st: ExecState) {
        cell_set(frame.locals[frame.lb + (ins.arg)], self._pop());

        # ── Objects ───────────────────────────────────────────────────
    }

    def _op_new_object(frame: CallFrame, ins: Instruction, st: ExecState) {
        self._push(js_object_new_ordinary());
    }

    def _op_new_array(frame: CallFrame, ins: Instruction, st: ExecState) -> None {
        na_n: int = ins.arg;
        na_raw: list[JSValue] = [];
        na_k: int = 0;
        while na_k < na_n {
            na_raw.append(js_undefined());
            na_k = na_k + 1;
        }
        na_k = na_n - 1;
        while na_k >= 0 {
            na_raw[na_k] = self._pop();
            na_k = na_k - 1;
        }
        # arg3 bit 16: the compiler proved the literal has no spread element.
        if (ins.arg3 & 16) != 0 {
            self._push(js_array_create(na_raw));
            return;
        }
        na_items: list[JSValue] = _expand_spreads(na_raw);
        self._push(js_array_create(na_items));
    }

    def _op_template_object(frame: CallFrame, ins: Instruction, st: ExecState) -> None {
        # ES §13.2.8.4 GetTemplateObject: the template strings array for a given source
        # site is created once and reused (SameValue) on every evaluation.  On a cache
        # hit, discard the freshly-built array and push the cached (frozen) one.
        to_site: int = ins.arg;
        if to_site in self.realm.template_cache {
            self._pop();  # discard the fresh array
            self._push(self.realm.template_cache[to_site]);
            return;
        }
        to_arr: JSValue = self._peek();
        # ES §13.2.8.4 step 12: the `raw` property is { writable:F, enumerable:F, configurable:F }.
        # The compiler set it enumerable via SET_PROP; re-define it non-enumerable here (before the
        # freeze) so `Object.getOwnPropertyDescriptor(strings,'raw').enumerable === false` and it
        # does not appear in `for-in`/Object.keys (test262 tagged-template/template-object).
        to_raw_key: int = str_intern("raw");
        to_raw: JSValue = js_object_get(to_arr, to_raw_key);
        if jsv_is_object_cell(to_raw) {
            _ = js_object_freeze(to_raw);
            js_object_define_property(
                to_arr,
                to_raw_key,
                JSProperty(
                    key=to_raw_key,
                    value=to_raw,
                    writable=False,
                    enumerable=False,
                    configurable=False,
                    deleted=False
                )
            );
        }
        _ = js_object_freeze(to_arr);
        self.realm.template_cache[to_site] = to_arr;
    }

    """Static lookup through a class's heritage chain once the ordinary
    [[Prototype]] walk came up undefined. A class whose parent is a plain
    function (fn_val) — `class M extends Uint8Array` — cannot store the function
    as prototype_idx, so static inheritance goes through WK_SUPER. The walk is
    TRANSITIVE (acorn's Parser.extend(pluginA, pluginB) chains: with
    `class R extends Q`, `class Q extends P`, P a plain function, R reaches Q
    via the object [[Prototype]] but Q's parent only via Q's WK_SUPER). A fn_val
    parent is resolved with its fn_props accessors honoured — the getter runs
    with this = `cls_obj` (inherited `get [Symbol.species]` returns the
    subclass) — before _fn_prop's synthesized name/length/prototype."""
    def _class_super_static_lookup(cls_obj: JSValue, key: int) -> JSValue {
        css_res: JSValue = js_undefined();
        # An existing property on the ordinary chain — own or inherited, even
        # with the VALUE undefined (`static [Symbol.species] = undefined`, or
        # Object.defineProperty(Sub, @@species, {value: undefined})) — shadows
        # the heritage; only a genuinely absent key continues into WK_SUPER.
        if js_object_has(cls_obj, key) {
            return css_res;
        }
        css_cur: JSValue = cls_obj;
        css_steps: int = 0;
        while jsv_is_undefined(css_res)
            and css_steps < 100
            and jsv_is_object_cell(css_cur)
            and jsv_to_table_id(css_cur) > 0
            and js_object_has_own(css_cur, WK_SUPER) {
            css_sup: JSValue = js_object_get(css_cur, WK_SUPER);
            if is_fn_val(css_sup) {
                css_res = self._get_prop_accessor_recv(css_sup, key, cls_obj);
                break;  # plain-function heritage: end of the class chain
            } elif is_native_val(css_sup) {
                css_res = _native_prop(css_sup, key);
                break;
            } elif jsv_is_object_cell(css_sup) and jsv_to_table_id(css_sup) > 0 {
                css_res = self._get_prop_accessor(css_sup, key);
                css_cur = css_sup;
            } else {
                break;
            }
            css_steps = css_steps + 1;
        }
        return css_res;
    }

    def _op_get_prop(frame: CallFrame, ins: Instruction, st: ExecState) -> None {
        gp_key: int = _ins_cached_key_arg2(frame, ins);
        gp_obj: JSValue = self._pop();
        # ── HOISTED shape-IC hit (ctor campaign P2b) ───────────────────────────
        # The holder==1 hit used to sit at the BOTTOM of this function, so even
        # a perfect monomorphic hit paid the full receiver-type gauntlet
        # (map/set/generator/promise/array/class probes — ~8 has_own/table
        # fetches per read). A shape match proves the receiver's layout, and
        # the fill only ever happens for own DATA props on receivers that fell
        # through to the ordinary-object path, so the hit is sound up here for
        # any receiver kind. EXCLUSION: callee/caller/arguments keys keep the
        # slow path — the poison-pill / arguments-exotic throws below must run
        # before any cached read (strict and sloppy arguments objects can share
        # a shape; the marker differs by VALUE, not by key).
        if VM_IC_ENABLED
            and ins.ic_holder == 1
            and gp_key != WK_CALLER
            and gp_key != WK_ARGUMENTS
            and gp_key != WK_CALLEE {
            gp_hsid: int = _vm_shape_of(gp_obj);
            if gp_hsid > 0 and gp_hsid == ins.ic_obj {
                self._push(
                    js_object_slot_at_id(jsv_to_table_id(gp_obj), ins.ic_ver // 16)
                );
                return;
            }
        }
        # ── HOISTED inherited-data IC hit (ic_holder < 0, _get_prop_proto_ic_fill) ─
        # A method or other DATA property found on the prototype chain: every
        # `obj.method()` on a class instance. Without this each such read paid the
        # receiver-type gauntlet plus a full OrdinaryGet walk. Valid while the
        # receiver's shape and [[Prototype]] are the filled ones and no prototype
        # anywhere changed shape/link (proto epoch): then the chain still reaches
        # the same holder slot, which is read live. Receivers whose [[Get]] is
        # exotic for non-index keys are never cached: _vm_shape_of excludes
        # Proxies, namespaces and dict mode; arguments objects and class objects are
        # excluded here, typed arrays by binary_kind.
        if VM_IC_ENABLED
            and ins.ic_holder < 0
            and gp_key != WK_CALLER
            and gp_key != WK_ARGUMENTS
            and gp_key != WK_CALLEE {
            gp_psid: int = _vm_shape_of(gp_obj);
            if gp_psid >= 0
                and gp_psid == ins.ic_obj
                and ins.ic_epoch == proto_epoch() {
                if js_object_proto_ic_ok(jsv_to_table_id(gp_obj), 0 - ins.ic_holder) {
                    self._push(
                        js_object_slot_at_id(
                            ins.ic_ver >> 32, (ins.ic_ver & 4294967295) // 16
                        )
                    );
                    return;
                }
            }
        }
        # Class constructors are strict functions: `C.caller` / `C.arguments` are %ThrowTypeError%
        # poison-pills (ES §10.2.4 / §17). A class is an object-cell (not is_fn_val), so it would
        # otherwise miss the function poison-pill branch below and return undefined.
        if (gp_key == WK_CALLER or gp_key == WK_ARGUMENTS)
            and jsv_is_object_cell(gp_obj)
            and jsv_to_table_id(gp_obj) > 0
            and js_object_has_own(gp_obj, WK_IS_CLASS)
            and not js_object_has_own(gp_obj, gp_key) {
            exc_cpp: JSValue = make_type_error(
                "'caller', 'callee', and 'arguments' properties may not be accessed on strict mode functions or the arguments objects for calls to them"
            );
            if not self._unwind_in_frame(frame, exc_cpp) {
                self.had_exception = True;
                self.pending_exc = exc_cpp;
                st.running = False;
            }
            return;
        }
        if jsv_is_null(gp_obj) or jsv_is_undefined(gp_obj) {
            gp_type_name: str = "null";
            if jsv_is_undefined(gp_obj) {
                gp_type_name = "undefined";
            }
            gp_prop_name: str = frame.func.constants.get(ins.arg);
            exc_gp: JSValue = make_type_error(
                "Cannot read properties of "
                    + gp_type_name
                    + " (reading '"
                    + gp_prop_name
                    + "')"
            );
            if not self._unwind_in_frame(frame, exc_gp) {
                self.had_exception = True;
                self.pending_exc = exc_gp;
                st.running = False;
            }
        } elif jsv_is_string_cell(gp_obj) {
            # `length` stays inline: it is per-instance, allocation-free, and the
            # hottest string property by a wide margin.
            if gp_key == WK_LENGTH {
                # O(1) for ASCII cells via the cached length/flag — `.length` in a
                # loop header was O(n) per read (full byte rescan), i.e. O(n^2).
                self._push(js_int(js_string_utf16_len_cell(jsv_to_table_id(gp_obj))));
            } else {
                # Everything else resolves through the real String.prototype
                # (ES §22.1.3 / §9.1.1.1 via ToObject). This walks the prototype chain
                # (→ Object.prototype) so inherited methods resolve, and makes
                # `"".split === "".split`, `String.prototype.split` and computed access
                # all work — WITHOUT allocating a wrapper object on every string
                # property read. This proto walk is allocation-free; boxing via
                # js_String_new here would heap-allocate on a hot path.
                self._push(self._string_proto_get(gp_key));
            }
        } elif jsv_is_int32(gp_obj) or jsv_is_double(gp_obj) {
            if gp_key == WK_TOFIXED {
                self._push(js_native_singleton("toFixed", 1, NATIVE_KIND_NUM_TOFIXED));
            } elif gp_key == WK_TOPRECISION {
                self._push(
                    js_native_singleton("toPrecision", 1, NATIVE_KIND_NUM_TOPRECISION)
                );
            } elif gp_key == WK_TOEXPONENTIAL {
                self._push(
                    js_native_singleton(
                        "toExponential", 1, NATIVE_KIND_NUM_TOEXPONENTIAL
                    )
                );
            } elif gp_key == WK_TOSTRING {
                self._push(
                    js_native_singleton("toString", 1, NATIVE_KIND_NUM_TOSTRING)
                );
            } elif gp_key == WK_VALUEOF {
                self._push(js_native_singleton("valueOf", 0, NATIVE_KIND_NUM_VALUEOF));
            } elif gp_key == WK_TOLOCALESTRING {
                # Number.prototype.toLocaleString (stubs may replace Object-delegate).
                boxed_num_tls: JSValue = js_Number_new([gp_obj]);
                self._push(self._get_prop_accessor_recv(boxed_num_tls, gp_key, gp_obj));
            } else {
                # ES §9.1.1.1: a property read on a primitive behaves as though the
                # value were boxed, so anything not an intrinsic resolves through
                # Number.prototype (and on to Object.prototype). Pushing undefined
                # here made user-added Number.prototype properties invisible from a
                # primitive receiver.
                gp_np: JSValue = js_number_get_proto();
                if jsv_is_object_cell(gp_np) and jsv_to_table_id(gp_np) > 0 {
                    self._push(self._get_prop_accessor_recv(gp_np, gp_key, gp_obj));
                } else {
                    self._push(js_undefined());
                }
            }
        } elif jsv_is_bool(gp_obj) {
            if gp_key == WK_TOSTRING {
                self._push(
                    js_native_singleton("toString", 0, NATIVE_KIND_BOOL_TOSTRING)
                );
            } elif gp_key == WK_VALUEOF {
                self._push(js_native_singleton("valueOf", 0, NATIVE_KIND_BOOL_VALUEOF));
            } elif gp_key == WK_CONSTRUCTOR {
                self._push(js_object_get(self.global_this, WK_BOOLEAN));
            } else {
                # Same boxing rule as the number branch above.
                gp_bp: JSValue = js_boolean_get_proto();
                if jsv_is_object_cell(gp_bp) and jsv_to_table_id(gp_bp) > 0 {
                    self._push(self._get_prop_accessor_recv(gp_bp, gp_key, gp_obj));
                } else {
                    self._push(js_undefined());
                }
            }
        } elif is_fn_val(gp_obj) {
            # Strict / arrow / generator / async functions have poison-pill `caller` and
            # `arguments` accessors (%ThrowTypeError%): reading either throws TypeError
            # (ES §10.2.4 / §20.2.3).  Sloppy ordinary functions keep the legacy behaviour.
            gp_pp_idx: int = get_fn_idx(gp_obj);
            if (gp_key == WK_CALLER or gp_key == WK_ARGUMENTS)
                and gp_pp_idx >= 0
                and gp_pp_idx < len(self.realm.closures) {
                gp_pp_cl: JSClosure = self.realm.closures[gp_pp_idx];
                # Bound functions are exotic (§10.4.1) and also carry the %ThrowTypeError%
                # poison-pill on `caller`/`arguments` (BoundFunctionCreate — no own such
                # props, so Get throws).
                gp_pp_poison: bool = gp_pp_cl.func.is_strict
                    or gp_pp_cl.is_arrow
                    or gp_pp_cl.func.is_generator
                    or gp_pp_cl.func.is_async
                    or gp_pp_cl.func.is_bound;
                # A user-defined own accessor/data property via defineProperty overrides.
                gp_pp_has_own: bool = False;
                gp_pp_props0: JSValue = gp_pp_cl.fn_props;
                if jsv_is_object_cell(gp_pp_props0)
                    and js_object_has_own(gp_pp_props0, gp_key) {
                    gp_pp_has_own = True;
                }
                if gp_pp_poison and not gp_pp_has_own {
                    exc_pp: JSValue = make_type_error(
                        "'caller', 'callee', and 'arguments' properties may not be accessed on strict mode functions or the arguments objects for calls to them"
                    );
                    if not self._unwind_in_frame(frame, exc_pp) {
                        self.had_exception = True;
                        self.pending_exc = exc_pp;
                        st.running = False;
                    }
                    return;
                }
            }
            gp_fn_res: JSValue = _fn_prop(gp_obj, gp_key);
            # _fn_prop checks data properties on fn_props but not accessor
            # getters (set via Object.defineProperty). Check fn_props for
            # accessor getters when no data property was found.
            if jsv_is_undefined(gp_fn_res) {
                gp_fn_idx: int = get_fn_idx(gp_obj);
                if gp_fn_idx < len(self.realm.closures) {
                    gp_fn_props: JSValue = self.realm.closures[gp_fn_idx].fn_props;
                    if jsv_is_object_cell(gp_fn_props) {
                        gp_fn_res = self._get_prop_accessor(gp_fn_props, gp_key);
                    }
                }
            }
            self._push(gp_fn_res);
        } elif is_native_val(gp_obj) {
            self._push(_native_prop(gp_obj, gp_key));
        } elif jsv_is_symbol(gp_obj) {
            # Symbol.prototype method access
            if gp_key == WK_TOSTRING {
                self._push(
                    js_native_singleton("toString", 0, NATIVE_KIND_SYMBOL_TOSTRING)
                );
            } elif gp_key == WK_VALUEOF {
                self._push(
                    js_native_singleton("valueOf", 0, NATIVE_KIND_SYMBOL_VALUEOF)
                );
            } elif gp_key == WK_DESCRIPTION {
                # ECMAScript: Symbol.prototype.description getter. A description-less symbol
                # (Symbol() → _SYMBOL_NO_DESC sentinel) yields undefined; a genuine empty
                # description (Symbol("")) yields "".
                sym_desc_str: str = symbol_description(self.realm, gp_obj);
                if sym_desc_str == _SYMBOL_NO_DESC {
                    self._push(js_undefined());
                } else {
                    self._push(jsv_from_string_id(str_intern(sym_desc_str)));
                }
            } else {
                # Same boxing rule as the number/boolean branches: resolve through
                # Symbol.prototype so user-added properties are visible.
                gp_sp: JSValue = js_symbol_get_proto();
                if jsv_is_object_cell(gp_sp) and jsv_to_table_id(gp_sp) > 0 {
                    self._push(self._get_prop_accessor_recv(gp_sp, gp_key, gp_obj));
                } else {
                    self._push(js_undefined());
                }
            }
        } elif jsv_is_bigint_cell(gp_obj) {
            # BigInt.prototype method access
            if gp_key == WK_TOSTRING {
                self._push(
                    js_native_singleton("toString", 0, NATIVE_KIND_BIGINT_TOSTRING)
                );
            } elif gp_key == WK_VALUEOF {
                self._push(
                    js_native_singleton("valueOf", 0, NATIVE_KIND_BIGINT_VALUEOF)
                );
            } elif gp_key == str_intern("toLocaleString") {
                self._push(
                    js_native_singleton(
                        "toLocaleString", 0, NATIVE_KIND_BIGINT_TOLOCALESTRING
                    )
                );
            } else {
                self._push(js_undefined());
            }
        } else {
            # Object property access — check Map/Set/WeakMap/WeakSet before js_object_get.
            # An *unmapped* (strict) arguments object has %ThrowTypeError% poison-pill
            # `callee` / `caller` accessors: reading either throws TypeError (ES §10.4.4.7).
            if (gp_key == WK_CALLEE or gp_key == WK_CALLER)
                and jsv_is_object_cell(gp_obj)
                and jsv_to_table_id(gp_obj) > 0
                and js_object_has_own(gp_obj, _KEY_IS_ARGUMENTS)
                and jsv_coerce_to_bool(js_object_get(gp_obj, _KEY_IS_ARGUMENTS)) {
                exc_ac: JSValue = make_type_error(
                    "'callee' and 'caller' cannot be accessed in this context"
                );
                if not self._unwind_in_frame(frame, exc_ac) {
                    self.had_exception = True;
                    self.pending_exc = exc_ac;
                    st.running = False;
                }
                return;
            }
            # ── TypedArray getter fast path (buffer_native.jac) ───────────────────
            # `length` / `byteLength` / `byteOffset` / `buffer` on a typed-array view
            # resolve to %TypedArray%.prototype accessors whose getters are natives
            # (NATIVE_KIND_TA_GET_*). When the prototype walk finds that pristine
            # native — no own shadow, no user-replaced getter, no Proxy — answer
            # straight from the binary side-table instead of invoking the getter
            # (~12µs of JS per read → ~0.2µs). Anything else takes the ordinary path.
            if (
                gp_key == WK_LENGTH
                or gp_key == WK_BYTELENGTH
                or gp_key == WK_BYTEOFFSET
                or gp_key == WK_BUFFER
            )
                and jsv_is_object_cell(gp_obj)
                and jsv_to_table_id(gp_obj) > 0
                and js_object_table_get(jsv_to_table_id(gp_obj)).binary_kind
                    == BINARY_KIND_TYPED_ARRAY {
                gp_ta_g: JSValue = js_object_lookup_getter(gp_obj, gp_key);
                if is_native_val(gp_ta_g) {
                    gp_ta_k: int = get_native_kind(gp_ta_g);
                    if gp_ta_k == NATIVE_KIND_TA_GET_LENGTH {
                        self._push(js_int(binary_typed_array_length(gp_obj)));
                        return;
                    } elif gp_ta_k == NATIVE_KIND_TA_GET_BYTELENGTH {
                        self._push(
                            js_int(
                                binary_typed_array_length(gp_obj)
                                    * binary_typed_array_bytes_per_element(gp_obj)
                            )
                        );
                        return;
                    } elif gp_ta_k == NATIVE_KIND_TA_GET_BYTEOFFSET {
                        self._push(js_int(binary_typed_array_byte_offset(gp_obj)));
                        return;
                    } elif gp_ta_k == NATIVE_KIND_TA_GET_BUFFER {
                        self._push(binary_typed_array_buffer(gp_obj));
                        return;
                    }
                }
            }
            # Arrays are by far the most common exotic receiver (`.length`, `.push`
            # in every loop), and each `js_is_*` probe below is a marker-key lookup
            # (shape/dict probe): test arrays FIRST so an array read pays one probe
            # instead of seven. The predicates are mutually exclusive (constructor-
            # set brand markers), so the order does not change results.
            # The predicates below were one js_object_has_own marker probe each (~500
            # instructions, nearly always a miss); the markers are mirrored in the
            # object's brand, so a single field read answers all of them.
            gp_brand: int = js_object_brand(gp_obj);
            if js_is_array(gp_obj) {
                # return the stored length value (may be float64 for lengths > 2^31-1).
                if gp_key == WK_LENGTH {
                    self._push(js_object_get(gp_obj, WK_LENGTH));
                } else {
                    self._push(self._get_prop_brand_generic(frame, gp_obj, gp_key));
                }
            } elif (gp_brand & BRAND_MAP) != 0 {
                if gp_key == WK_SIZE {
                    self._push(js_int(js_map_size(gp_obj)));
                } else {
                    self._push(self._get_prop_brand_generic(frame, gp_obj, gp_key));
                }
            } elif (gp_brand & BRAND_WEAKMAP) != 0 {
                self._push(self._get_prop_brand_generic(frame, gp_obj, gp_key));
            } elif (gp_brand & BRAND_SET) != 0 {
                if gp_key == WK_SIZE {
                    self._push(js_int(js_set_size(gp_obj)));
                } else {
                    self._push(self._get_prop_brand_generic(frame, gp_obj, gp_key));
                }
            } elif (gp_brand & BRAND_WEAKSET) != 0 {
                self._push(self._get_prop_brand_generic(frame, gp_obj, gp_key));
            } elif (gp_brand & BRAND_GENERATOR) != 0 {
                k_gen_sym_it: int = SYMBOL_KEY_BASE + SYMBOL_ITERATOR;
                if gp_key == WK_NEXT {
                    self._push(
                        js_native_singleton("next", 1, NATIVE_KIND_GENERATOR_NEXT)
                    );
                } elif gp_key == WK_RETURN {
                    self._push(
                        js_native_singleton("return", 1, NATIVE_KIND_GENERATOR_RETURN)
                    );
                } elif gp_key == WK_THROW {
                    self._push(
                        js_native_singleton("throw", 1, NATIVE_KIND_GENERATOR_THROW)
                    );
                } elif gp_key == k_gen_sym_it {
                    self._push(
                        js_native_singleton(
                            "[Symbol.iterator]", 0, NATIVE_KIND_GENERATOR_SYMBOL_ITER
                        )
                    );
                } else {
                    self._push(self._get_prop_accessor(gp_obj, gp_key));
                }
            } elif (gp_brand & BRAND_PROMISE) != 0 and js_is_promise(gp_obj) {
                # `then`/`catch`/`finally` are real own properties of
                # Promise.prototype (installed by _init_promise_proto_methods), so
                # they resolve through the ordinary prototype walk. The old fast
                # path minted a fresh native here instead, which made every read
                # return a *different* function object and — worse — ignored a
                # user-installed Promise.prototype.then entirely. The combinators
                # are specified to invoke whatever `then` is currently on the
                # prototype (§27.2.4.1.2 step 1.k), so the fast path is removed.
                #
                # An own accessor can throw (test262 installs a poisoned `then`
                # getter on a promise): _get_prop_accessor_recv re-raises a JS
                # getter's throw on the native-exception channel, so it has to be
                # drained here or the read yields undefined and the caller reports
                # a bogus "(object).then is not a function" instead of the error.
                gp_prom_v: JSValue = self._get_prop_accessor(gp_obj, gp_key);
                if vm_has_native_exc() {
                    exc_gpp: JSValue = vm_take_native_exc();
                    if not self._unwind_in_frame(frame, exc_gpp) {
                        self.had_exception = True;
                        self.pending_exc = exc_gpp;
                        st.running = False;
                    }
                } elif self.had_exception {
                    exc_gpp2: JSValue = self.pending_exc;
                    self.had_exception = False;
                    self.pending_exc = js_undefined();
                    if not self._unwind_in_frame(frame, exc_gpp2) {
                        self.had_exception = True;
                        self.pending_exc = exc_gpp2;
                        st.running = False;
                    }
                } else {
                    self._push(gp_prom_v);
                }
            } elif jsv_to_table_id(gp_obj) >= 0
                and (
                    js_object_table_get(jsv_to_table_id(gp_obj)).cell_flags
                    & FLAG_IS_CLASS
                )
                    != 0 {
                # ── Class objects are functions — expose Function.prototype methods ──
                gp_k_call: int = WK_CALL;
                gp_k_apply: int = WK_APPLY;
                gp_k_bind: int = WK_BIND;
                gp_k_tostr: int = WK_TOSTRING;
                gp_k_name: int = WK_NAME;
                gp_k_len: int = WK_LENGTH;
                if gp_key == gp_k_call {
                    self._push(js_native_singleton("call", 1, NATIVE_KIND_FN_CALL));
                } elif gp_key == gp_k_apply {
                    self._push(js_native_singleton("apply", 2, NATIVE_KIND_FN_APPLY));
                } elif gp_key == gp_k_bind {
                    self._push(js_native_singleton("bind", 1, NATIVE_KIND_FN_BIND));
                } elif gp_key == gp_k_tostr {
                    self._push(
                        js_native_singleton("toString", 0, NATIVE_KIND_FN_TOSTRING)
                    );
                } elif gp_key == gp_k_name {
                    # An explicit `static name` member — data method/field OR an accessor
                    # (`static get name()` / `static set name()`) — shadows the inferred
                    # class name (ES §15.7.14 step 25.b overwrites F.name). Use the
                    # accessor-aware getter so a `static get name` runs and a setter-only
                    # accessor yields undefined (test262 fn-name-static-precedence).
                    if js_object_has_own(gp_obj, gp_k_name)
                        or js_object_has_own_accessor(gp_obj, gp_k_name) {
                        self._push(self._get_prop_accessor(gp_obj, gp_k_name));
                    } else {
                        cls_nm: str = "";
                        cls_nm_v: JSValue = js_object_get(gp_obj, WK_CLASS_NAME);
                        if jsv_is_string_cell(cls_nm_v) {
                            cls_nm = str_from_id(jsv_to_table_id(cls_nm_v));
                        }
                        self._push(js_str(cls_nm));
                    }
                } elif gp_key == gp_k_len {
                    # A static `length` member (data or accessor) shadows the inferred arity
                    # (test262 fn-length-static-precedence).
                    if js_object_has_own(gp_obj, gp_k_len)
                        or js_object_has_own_accessor(gp_obj, gp_k_len) {
                        self._push(self._get_prop_accessor(gp_obj, gp_k_len));
                    } else {
                        cls_ctor_v: JSValue = js_object_get(gp_obj, WK_CTOR);
                        cls_arity: int = 0;
                        if is_fn_val(cls_ctor_v) {
                            cls_arity = len(
                                self.realm.closures[get_fn_idx(cls_ctor_v)].func.params
                            );
                        }
                        self._push(js_int(cls_arity));
                    }
                } else {
                    # Own / ordinary [[Prototype]] walk first.  When the heritage is a
                    # plain function (fn_val) — e.g. `class M extends Uint8Array` —
                    # `js_object_set_prototype` cannot store the function as
                    # prototype_idx, so static inheritance goes through WK_SUPER.
                    # The walk must be TRANSITIVE: with `class R extends Q` and
                    # `class Q extends P` where P is a plain function, R's lookup
                    # reaches Q via the object [[Prototype]] but Q's parent P is
                    # only reachable through Q's WK_SUPER (acorn's
                    # Parser.extend(pluginA, pluginB) chains — a single-hop
                    # fallback lost every static past depth 1).
                    gp_cls_res: JSValue = self._get_prop_accessor(gp_obj, gp_key);
                    if jsv_is_undefined(gp_cls_res)
                        and not vm_has_native_exc()
                        and not self.had_exception {
                        gp_cls_res = self._class_super_static_lookup(gp_obj, gp_key);
                    }
                    self._push(gp_cls_res);
                }
            } elif gp_key == WK_NEXT
                and js_object_has_own(gp_obj, WK_I)
                and js_object_has_own(gp_obj, WK_J) {
                # Internal {__I,__J} iterator: expose .next() as NATIVE_KIND_ITER_NEXT.
                # Keyed on `next` first: any other key on such an object is an ordinary
                # read (the branch below), so plain objects skip both marker probes.
                self._push(js_native_singleton("next", 0, NATIVE_KIND_ITER_NEXT));
            } else {
                if gp_key == KEY_PROTO
                    and jsv_is_object_cell(gp_obj)
                    and jsv_to_table_id(gp_obj) > 0
                    and not js_is_module_namespace(gp_obj)
                    and not js_object_has_own(gp_obj, KEY_PROTO) {
                    # `obj.__proto__` reads the [[Prototype]] via the inherited Object.prototype
                    # accessor — UNLESS the object has an OWN "__proto__" property (created by a
                    # computed `['__proto__']` or shorthand), which shadows the accessor and is
                    # read as an ordinary data property (Annex B.2.2.1 / test262 computed-__proto__).
                    self._push(js_object_get_prototype(gp_obj));
                } else {
                    # ── Shape-based monomorphic GET IC (shapes plan Phase 5) ──────────
                    # ic_holder==1: own-data hit cached as (ic_obj=shape_id,
                    # ic_ver=packed slot*16+attrs). A shape-id match proves the layout
                    # (any own-key add/delete/attr change moves the object to a new
                    # shape or to dict mode), so the hit is a bare slot load — no dict
                    # probe, no JSProperty materialization, no allocation.
                    gp_ic_hit: bool = False;
                    if VM_IC_ENABLED and ins.ic_holder == 1 {
                        gp_sid: int = _vm_shape_of(gp_obj);
                        if gp_sid > 0 and gp_sid == ins.ic_obj {
                            gp_raw_ic: JSObject = js_object_table_get(
                                jsv_to_table_id(gp_obj)
                            );
                            self._push(gp_raw_ic.slots[ins.ic_ver // 16]);
                            gp_ic_hit = True;
                        }
                    }
                    if not gp_ic_hit {
                        gp_res_v: JSValue = self._get_prop_accessor(gp_obj, gp_key);
                        if vm_has_native_exc() {
                            exc_gpr: JSValue = vm_take_native_exc();
                            if not self._unwind_in_frame(frame, exc_gpr) {
                                self.had_exception = True;
                                self.pending_exc = exc_gpr;
                                st.running = False;
                            }
                        } elif self.had_exception {
                            exc_gpr2: JSValue = self.pending_exc;
                            self.had_exception = False;
                            self.pending_exc = js_undefined();
                            if not self._unwind_in_frame(frame, exc_gpr2) {
                                self.had_exception = True;
                                self.pending_exc = exc_gpr2;
                                st.running = False;
                            }
                        } else {
                            self._push(gp_res_v);
                            # Fill / refresh: cache only own DATA props on shape-mode
                            # receivers (accessor entries dispatch getters — never cached).
                            if VM_IC_ENABLED {
                                gp_sid2: int = _vm_shape_of(gp_obj);
                                if gp_sid2 > 0 {
                                    gp_pk2: int = shape_lookup(gp_sid2, gp_key);
                                    if gp_pk2 >= 0
                                        and (gp_pk2 & SHAPE_ATTR_ACCESSOR) == 0 {
                                        gp_pip: int = frame.ip - 1;
                                        if gp_pip >= 0
                                            and gp_pip < len(frame.func.code) {
                                            gp_old: Instruction = frame.func.code[
                                                gp_pip
                                            ];
                                            gp_old.ic_obj = gp_sid2;
                                            gp_old.ic_ver = gp_pk2;
                                            gp_old.ic_holder = 1;
                                            gp_old.ic_epoch = 0;
                                        }
                                        if _vm_ic_key_ok(gp_key) {
                                            _mgc_put(
                                                gp_sid2,
                                                js_object_proto_idx_id(
                                                    jsv_to_table_id(gp_obj)
                                                ),
                                                gp_key,
                                                0,
                                                gp_pk2,
                                                -1
                                            );
                                        }
                                    }
                                }
                                # Not own: maybe an inherited data property (holder < 0).
                                self._get_prop_proto_ic_fill(
                                    frame, gp_obj, gp_key, gp_res_v
                                );
                            }
                        }
                    }
                }
            }
        }
    }

    """Generic [[Get]] for an Array/Map/Set/WeakMap/WeakSet receiver (the
    brand-specific keys `length` / `size` are handled by the caller), then the
    inherited-data IC fill: these receivers read their methods from the
    prototype (`arr.push`, `map.get`), so they are the hottest inherited reads.
    The fill is skipped when the read raised."""
    def _get_prop_brand_generic(
        frame: CallFrame, gp_obj: JSValue, gp_key: int
    ) -> JSValue {
        gbg_v: JSValue = self._get_prop_accessor(gp_obj, gp_key);
        if VM_IC_ENABLED and not vm_has_native_exc() and not self.had_exception {
            self._get_prop_proto_ic_fill(frame, gp_obj, gp_key, gbg_v);
        }
        return gbg_v;
    }

    """GET_PROP inherited-data IC fill (ic_holder < 0), after the slow path read
    `gp_val` for `gp_key` on `gp_obj`. Caches when the value came from a DATA slot
    of a shape-mode object on the prototype chain and every level before it is
    plain for this key: no own copy or accessor, no Proxy / namespace / typed
    array / arguments object, and (receiver) shape mode, not a class object.
    Only non-index keys other than `length` / `__proto__` / caller / callee /
    arguments: those are the keys exotic receivers answer before OrdinaryGet.
    Encoding: ic_obj = receiver shape, ic_holder = -(receiver [[Prototype]] id),
    ic_ver = (holder id << 32) | packed holder slot, ic_epoch = proto epoch. The
    epoch is bumped by every shape change, dict conversion, [[Prototype]] change
    and GC free of an object flagged FLAG_IS_PROTO, so while it holds, the chain
    from the receiver's [[Prototype]] up to the holder is exactly as filled."""
    def _get_prop_proto_ic_fill(
        frame: CallFrame, gp_obj: JSValue, gp_key: int, gp_val: JSValue
    ) -> None {
        if not VM_IC_ENABLED {
            return;
        }
        if gp_key == WK_LENGTH
            or gp_key == KEY_PROTO
            or gp_key == WK_CALLER
            or gp_key == WK_ARGUMENTS
            or gp_key == WK_CALLEE {
            return;
        }
        pf_rsid: int = _vm_shape_of(gp_obj);
        if pf_rsid < 0 {
            return;
        }
        pf_rraw: JSObject = js_object_table_get(jsv_to_table_id(gp_obj));
        if pf_rraw.binary_kind != 0
            or (pf_rraw.cell_flags & (FLAG_IS_ARGUMENTS | FLAG_IS_CLASS)) != 0 {
            return;
        }
        if pf_rraw.accessors is not None {
            return;
        }
        if shape_lookup(pf_rsid, gp_key) >= 0 {
            return;
        }  # own: the holder==1 IC's case
        if _vm_is_array_index_key_id(gp_key) {
            return;
        }
        pf_p1: int = pf_rraw.prototype_idx;
        pf_lvl: int = pf_p1;
        pf_depth: int = 0;
        while pf_lvl > 0 and pf_depth < 16 {
            pf_lraw: JSObject = js_object_table_get(pf_lvl);
            if pf_lraw.class_id != 0 or pf_lraw.binary_kind != 0 {
                return;
            }
            if (pf_lraw.cell_flags & (FLAG_MODULE_NS | FLAG_IS_ARGUMENTS)) != 0 {
                return;
            }
            if pf_lraw.mode == MAP_MODE_SHAPE {
                if pf_lraw.accessors is not None {
                    return;
                }
                pf_lpk: int = shape_lookup(pf_lraw.shape_id, gp_key);
                if pf_lpk >= 0 {
                    if (pf_lpk & SHAPE_ATTR_ACCESSOR) != 0 {
                        return;
                    }
                    # The slow path must have read exactly this slot.
                    if pf_lraw.slots[pf_lpk // 16] != gp_val {
                        return;
                    }
                    pf_pip: int = frame.ip - 1;
                    if pf_pip >= 0 and pf_pip < len(frame.func.code) {
                        pf_old: Instruction = frame.func.code[pf_pip];
                        pf_old.ic_obj = pf_rsid;
                        pf_old.ic_ver = (pf_lvl << 32) | pf_lpk;
                        pf_old.ic_holder = 0 - pf_p1;
                        pf_old.ic_epoch = proto_epoch();
                        _mgc_put(pf_rsid, pf_p1, gp_key, pf_lvl, pf_lpk, proto_epoch());
                    }
                    return;
                }
            } elif js_object_has_own(jsv_from_object_id(pf_lvl), gp_key) {
                return;  # found on a dict-mode level: no slot to cache
            }
            pf_lvl = pf_lraw.prototype_idx;
            pf_depth = pf_depth + 1;
        }
    }

    """GET_PROP getter IC: after the data ICs miss, when the receiver's
    prototype chain resolves the key to an accessor whose getter is a plain JS
    function, call the getter as an inline frame on the receiver (the TOS: the
    call pops it and RETURN pushes the result in its place, exactly GET_PROP's
    stack effect). Rollup's AST nodes read flags through prototype getters
    (`get included()` …), which went native → JS through run() per read.
    Returns True when the getter frame was entered.

    Encoding (on the GET_PROP instruction): ic_obj = receiver shape,
    ic_holder = −(_GETTER_IC_TAG + receiver [[Prototype]] id), ic_ver = the
    getter, ic_epoch = proto epoch. The epoch is bumped by every mutation of an
    object flagged as a prototype (set, delete, define, accessor install,
    [[Prototype]] change, GC free), so while it holds, the chain from the
    receiver's [[Prototype]] still resolves the key to that getter, and the
    getter is alive (its holder still references it). The tag keeps the value
    out of the inherited-data IC's range: its prototype-id test can never
    match. ic_holder == _GETTER_IC_NONE records a walk that found no inlinable
    getter for (shape, epoch), so misses on data-less keys do not re-walk."""
    def _getter_ic_call(ins: Instruction, st: ExecState) -> bool {
        gic_fn0: JSValue = self._getter_ic_lookup(ins, self.stack[len(self.stack) - 1]);
        if jsv_is_hole(gic_fn0) {
            return False;
        }
        return self._inline_call_from_stack(
            self.realm.closures[get_fn_idx(gic_fn0)],
            gic_fn0,
            self.stack[len(self.stack) - 1],
            0,
            1,
            st
        );
    }

    """The prototype getter GET_PROP `ins`'s getter IC resolves for receiver
    `gic_obj` (filling the IC on a first miss), or the hole: shared by the
    stack loop's _getter_ic_call and the register loop's GETFIELD."""
    def _getter_ic_lookup(ins: Instruction, gic_obj: JSValue) -> JSValue {
        if not VM_IC_ENABLED or ins.arg2 == 0 {
            return jsv_hole();
        }
        gic_sid: int = js_object_ic_shape(gic_obj);
        if gic_sid < 0 {
            return jsv_hole();
        }
        gic_fn: JSValue = jsv_hole();
        gic_data: bool = False;
        if ins.ic_holder <= 0 - _GETTER_IC_TAG {
            if gic_sid == ins.ic_obj
                and ins.ic_epoch == proto_epoch()
                and js_object_proto_ic_ok(
                    jsv_to_table_id(gic_obj), 0 - ins.ic_holder - _GETTER_IC_TAG
                ) {
                gic_fn = ins.ic_ver;
            }
        } elif ins.ic_holder == _GETTER_IC_NONE {
            if gic_sid == ins.ic_obj and ins.ic_epoch == proto_epoch() {
                return jsv_hole();
            }
        } elif ins.ic_holder != 0 {
            # A data IC (own or inherited) owns this site: a getter for
            # another receiver class is resolved without touching it.
            gic_data = True;
        }
        if jsv_is_hole(gic_fn) {
            gic_fn = _vm_mgc_getter(ins.arg2, gic_obj, gic_sid);
        }
        if jsv_is_hole(gic_fn) {
            if gic_data {
                gic_fn = self._getter_resolve(ins.arg2, gic_obj, gic_sid);
            } else {
                gic_fn = self._getter_ic_fill(ins, gic_obj, gic_sid);
            }
        }
        return gic_fn;
    }

    """Fill GET_PROP `ins`'s getter IC for receiver `rv` (shape `sid`): the
    getter _getter_resolve finds, or the _GETTER_IC_NONE marker and the hole."""
    def _getter_ic_fill(ins: Instruction, rv: JSValue, sid: int) -> JSValue {
        gif_fn: JSValue = self._getter_resolve(ins.arg2, rv, sid);
        ins.ic_obj = sid;
        ins.ic_epoch = proto_epoch();
        if jsv_is_hole(gif_fn) {
            ins.ic_holder = _GETTER_IC_NONE;
        } else {
            ins.ic_ver = gif_fn;
            ins.ic_holder = 0
                - (_GETTER_IC_TAG + js_object_proto_idx_id(jsv_to_table_id(rv)));
        }
        return gif_fn;
    }

    """Resolve `gf_key` on receiver `rv` (shape `sid`) for the getter IC: walk
    the prototype chain the way OrdinaryGet would and return the getter when
    the first own property found is an accessor whose getter is a JS function
    that can run inline (also recorded in the megamorphic cache), else the
    hole. Every level must be an ordinary object."""
    def _getter_resolve(gf_key: int, rv: JSValue, sid: int) -> JSValue {
        if not _vm_ic_key_ok(gf_key) or gf_key == WK_LENGTH or gf_key == KEY_PROTO {
            return jsv_hole();
        }
        if _vm_is_array_index_key_id(gf_key) {
            return jsv_hole();
        }
        gf_raw: JSObject = js_object_table_get(jsv_to_table_id(rv));
        if gf_raw.binary_kind != 0
            or (gf_raw.cell_flags & (FLAG_IS_ARGUMENTS | FLAG_IS_CLASS)) != 0 {
            return jsv_hole();
        }
        if gf_raw.accessors is not None {
            return jsv_hole();
        }
        if shape_lookup(sid, gf_key) >= 0 {
            return jsv_hole();
        }
        gf_p1: int = gf_raw.prototype_idx;
        gf_lvl: int = gf_p1;
        gf_depth: int = 0;
        while gf_lvl > 0 and gf_depth < 16 {
            gf_lraw: JSObject = js_object_table_get(gf_lvl);
            if gf_lraw.class_id != 0 or gf_lraw.binary_kind != 0 {
                return jsv_hole();
            }
            if (gf_lraw.cell_flags & (FLAG_MODULE_NS | FLAG_IS_ARGUMENTS)) != 0 {
                return jsv_hole();
            }
            gf_lv: JSValue = jsv_from_object_id(gf_lvl);
            if js_object_has_own_accessor(gf_lv, gf_key) {
                gf_fn: JSValue = js_object_get_own_accessor_getter(gf_lv, gf_key);
                if not is_fn_val(gf_fn) {
                    return jsv_hole();
                }
                gf_ci: int = get_fn_idx(gf_fn);
                if gf_ci < 0 or gf_ci >= len(self.realm.closures) {
                    return jsv_hole();
                }
                if self.realm.closures[gf_ci].napi_cb_ptr != 0
                    or self.realm.closures[gf_ci].func.is_generator
                    or self.realm.closures[gf_ci].func.is_async
                    or self.realm.closures[gf_ci].func.is_bound
                    or self.realm.closures[gf_ci].func.arguments_slot >= 0 {
                    return jsv_hole();
                }
                _mgc_put_getter(sid, gf_p1, gf_key, gf_fn, proto_epoch());
                return gf_fn;
            }
            if js_object_has_own(gf_lv, gf_key) {
                return jsv_hole();
            }
            gf_lvl = gf_lraw.prototype_idx;
            gf_depth = gf_depth + 1;
        }
        return jsv_hole();
    }

    """SET_PROP setter IC (the write-side twin of the getter IC): the setter a
    [[Set]] of SET_PROP `ins`'s key on receiver `rv` would call, when it is a
    plain JS function that can run inline, else the hole. Rollup's AST nodes
    write their flags through prototype setters (`set included(v)`), which
    went native → JS through run() per write; _setter_ic_call enters the
    setter as an inline frame instead.

    Encoding on the SET_PROP instruction (as the getter IC's): ic_obj =
    receiver shape, ic_holder = −(_GETTER_IC_TAG + receiver [[Prototype]] id),
    ic_ver = the setter, ic_epoch = proto epoch; _GETTER_IC_NONE records a
    walk that found none. A data SET IC (holder 2 / 3 / 4) owns its site.
    Object-literal defines and private names never reach a setter."""
    def _setter_ic_lookup(ins: Instruction, rv: JSValue) -> JSValue {
        if not VM_IC_ENABLED or ins.arg3 < 2 or (ins.arg3 & 3) != 0 {
            return jsv_hole();
        }
        sic_sid: int = js_object_ic_shape(rv);
        if sic_sid < 0 {
            return jsv_hole();
        }
        if ins.ic_holder <= 0 - _GETTER_IC_TAG {
            if sic_sid == ins.ic_obj
                and ins.ic_epoch == proto_epoch()
                and js_object_proto_ic_ok(
                    jsv_to_table_id(rv), 0 - ins.ic_holder - _GETTER_IC_TAG
                ) {
                return ins.ic_ver;
            }
        } elif ins.ic_holder == _GETTER_IC_NONE {
            if sic_sid == ins.ic_obj and ins.ic_epoch == proto_epoch() {
                return jsv_hole();
            }
        } elif ins.ic_holder != 0 {
            return jsv_hole();
        }
        return self._setter_ic_fill(ins, rv, sic_sid);
    }

    """Walk `rv`'s prototype chain (shape `sid`) the way OrdinarySet would for
    SET_PROP `ins`'s key: when the first property found is an accessor whose
    setter is a JS function that can run inline, fill the setter IC and return
    the setter; else the hole (and the _GETTER_IC_NONE marker). An own
    property, a data property on the chain, or any exotic level ends it."""
    def _setter_ic_fill(ins: Instruction, rv: JSValue, sid: int) -> JSValue {
        sf_key: int = ins.arg3 >> 2;
        ins.ic_holder = _GETTER_IC_NONE;
        ins.ic_obj = sid;
        ins.ic_epoch = proto_epoch();
        if not _vm_ic_key_ok(sf_key) or sf_key == WK_LENGTH or sf_key == KEY_PROTO {
            return jsv_hole();
        }
        if _vm_is_array_index_key_id(sf_key) {
            return jsv_hole();
        }
        sf_raw: JSObject = js_object_table_get(jsv_to_table_id(rv));
        if sf_raw.binary_kind != 0
            or (sf_raw.cell_flags & (FLAG_IS_ARGUMENTS | FLAG_IS_CLASS)) != 0 {
            return jsv_hole();
        }
        if sf_raw.accessors is not None {
            return jsv_hole();
        }
        if shape_lookup(sid, sf_key) >= 0 {
            return jsv_hole();
        }
        sf_p1: int = sf_raw.prototype_idx;
        sf_lvl: int = sf_p1;
        sf_depth: int = 0;
        while sf_lvl > 0 and sf_depth < 16 {
            sf_lraw: JSObject = js_object_table_get(sf_lvl);
            if sf_lraw.class_id != 0 or sf_lraw.binary_kind != 0 {
                return jsv_hole();
            }
            if (sf_lraw.cell_flags & (FLAG_MODULE_NS | FLAG_IS_ARGUMENTS)) != 0 {
                return jsv_hole();
            }
            sf_lv: JSValue = jsv_from_object_id(sf_lvl);
            if js_object_has_own_accessor(sf_lv, sf_key) {
                sf_fn: JSValue = js_object_get_own_accessor_setter(sf_lv, sf_key);
                if not is_fn_val(sf_fn) {
                    return jsv_hole();
                }
                sf_ci: int = get_fn_idx(sf_fn);
                if sf_ci < 0 or sf_ci >= len(self.realm.closures) {
                    return jsv_hole();
                }
                if self.realm.closures[sf_ci].napi_cb_ptr != 0
                    or self.realm.closures[sf_ci].func.is_generator
                    or self.realm.closures[sf_ci].func.is_async
                    or self.realm.closures[sf_ci].func.is_bound
                    or self.realm.closures[sf_ci].func.arguments_slot >= 0 {
                    return jsv_hole();
                }
                ins.ic_obj = sid;
                ins.ic_ver = sf_fn;
                ins.ic_holder = 0 - (_GETTER_IC_TAG + sf_p1);
                ins.ic_epoch = proto_epoch();
                return sf_fn;
            }
            if js_object_has_own(sf_lv, sf_key) {
                return jsv_hole();
            }
            sf_lvl = sf_lraw.prototype_idx;
            sf_depth = sf_depth + 1;
        }
        return jsv_hole();
    }

    """Enter setter `fn` (from _setter_ic_lookup) on receiver `rv` as an inline
    frame, its one argument being the operand-stack top; the frame drops its
    return value, so whatever lies under the argument is what the caller sees
    afterwards. Returns True when the frame was entered."""
    def _setter_ic_call(fn: JSValue, rv: JSValue, st: ExecState) -> bool {
        if not self._inline_call_from_stack(
            self.realm.closures[get_fn_idx(fn)], fn, rv, 1, 0, st
        ) {
            return False;
        }
        self.frames[len(self.frames) - 1].discard_ret = True;
        return True;
    }

    """SET_PROP inline-cache fill after a successful ordinary [[Set]] — shared by
    the sloppy path (_set_prop_accessor) and the strict path (_vm_object_set_vop),
    which used to return WITHOUT filling, so every property write in strict code
    (all ES modules, classes, 'use strict') took the full slow path forever:
    ~0.22µs per write vs ~0.04µs for a cached read.
    holder=2: existing writable own data prop (shape, packed slot).
    holder=4: fresh add (shape before → after, proto epoch), overrides 2."""
    def _set_prop_ic_fill(
        frame: CallFrame,
        sp_obj: JSValue,
        sp_key: int,
        sp_ic_was_own: bool,
        sp_ic_private: bool
    ) {
        # SET-IC fill: writable own data prop on a shape-mode receiver, with
        # the specials excluded (env-object string coercion, module `exports`
        # cache sync, private-accessor brand storage) — their markers/behavior
        # must keep taking this slow path.
        if VM_IC_ENABLED
            and not sp_ic_private
            and sp_key != WK_EXPORTS
            and not js_object_has_own(sp_obj, _KEY_IS_ENV_OBJ) {
            sp_gsid: int = _vm_shape_of(sp_obj);
            if sp_gsid > 0 {
                sp_gpk: int = shape_lookup(sp_gsid, sp_key);
                if sp_gpk >= 0
                    and (sp_gpk & SHAPE_ATTR_ACCESSOR) == 0
                    and (sp_gpk & PROP_WRITABLE) != 0 {
                    sp_gpip: int = frame.ip - 1;
                    if sp_gpip >= 0 and sp_gpip < len(frame.func.code) {
                        sp_gold: Instruction = frame.func.code[sp_gpip];
                        sp_gold.ic_obj = sp_gsid;
                        sp_gold.ic_ver = sp_gpk;
                        sp_gold.ic_holder = 2;
                        sp_gold.ic_epoch = 0;
                        if _vm_ic_key_ok(sp_key) {
                            _msc_put(sp_gsid, sp_key, sp_gpk);
                        }
                    }
                }
            }
        }
        # [[Set]]-ADD IC fill (holder=4, overrides the holder-2 fill above for
        # fresh adds): key was NOT own before, IS the just-added own-data leaf
        # now (last slot, shape-mode, non-accessor), receiver extensible, and
        # NO accessor named key exists on the prototype chain (a chain setter
        # consuming the assignment leaves the key not-own → no leaf → no fill;
        # a setter that itself adds an own same-named prop is excluded by this
        # explicit chain walk). Epoch-stamped: any later prototype mutation
        # invalidates all holder-4 entries at hit time.
        if VM_IC_ENABLED
            and not sp_ic_was_own
            and not sp_ic_private
            and sp_key != WK_EXPORTS
            and not js_object_has_own(sp_obj, _KEY_IS_ENV_OBJ) {
            sp4_fsid: int = _vm_shape_of(sp_obj);
            if sp4_fsid > 0 {
                sp4_fpk: int = shape_lookup(sp4_fsid, sp_key);
                sp4_fparent: int = shape_parent(sp4_fsid);
                if sp4_fpk >= 0
                    and (sp4_fpk & SHAPE_ATTR_ACCESSOR) == 0
                    and sp4_fparent >= 0 {
                    sp4_fraw: JSObject = js_object_table_get(jsv_to_table_id(sp_obj));
                    if sp4_fraw.is_ext()
                        and (sp4_fpk // 16) == len(sp4_fraw.slots) - 1
                        and not self._chain_has_accessor(sp_obj, sp_key) {
                        sp4_fpip: int = frame.ip - 1;
                        if sp4_fpip >= 0 and sp4_fpip < len(frame.func.code) {
                            sp4_fold: Instruction = frame.func.code[sp4_fpip];
                            sp4_fold.ic_obj = sp4_fparent;
                            sp4_fold.ic_ver = sp4_fsid;
                            sp4_fold.ic_holder = 4;
                            sp4_fold.ic_epoch = proto_epoch();
                            if _vm_ic_key_ok(sp_key) {
                                _mac_put(sp4_fparent, sp_key, sp4_fsid, proto_epoch());
                            }
                        }
                    }
                }
            }
        }
    }

    """SET_PROP define-own transition-IC fill (holder 3) after a CreateDataProperty
    of `sp_key` on `sp_obj`: only when the key is the just-added leaf of a
    shape-mode receiver (its slot is the last one), so replaying the cached
    (before → after) edge on the next same-shaped receiver is a pure append."""
    def _set_prop_define_ic_fill(
        frame: CallFrame, sp_obj: JSValue, sp_key: int
    ) -> None {
        if not VM_IC_ENABLED {
            return;
        }
        sp_fsid: int = _vm_shape_of(sp_obj);
        if sp_fsid <= 0 {
            return;
        }
        sp_fpk: int = shape_lookup(sp_fsid, sp_key);
        sp_fparent: int = shape_parent(sp_fsid);
        if sp_fpk < 0 or (sp_fpk & SHAPE_ATTR_ACCESSOR) != 0 or sp_fparent < 0 {
            return;
        }
        sp_fraw: JSObject = js_object_table_get(jsv_to_table_id(sp_obj));
        if (sp_fpk // 16) != len(sp_fraw.slots) - 1 {
            return;
        }
        sp_fpip: int = frame.ip - 1;
        if sp_fpip >= 0 and sp_fpip < len(frame.func.code) {
            sp_fold: Instruction = frame.func.code[sp_fpip];
            sp_fold.ic_obj = sp_fparent;
            sp_fold.ic_ver = sp_fsid;
            sp_fold.ic_holder = 3;
            sp_fold.ic_epoch = 0;
        }
    }

    def _op_set_prop(frame: CallFrame, ins: Instruction, st: ExecState) -> None {
        sp_key_enc: int = _ins_cached_set_prop_key(frame, ins);
        sp_key: int = sp_key_enc >> 2;
        sp_define_own: int = sp_key_enc & 1;
        sp_priv_enc: int = (sp_key_enc >> 1) & 1;
        sp_val: JSValue = self._pop();
        sp_obj: JSValue = self._pop();
        if _DBG_SP_ON
            and len(frame.func.code) == 12
            and len(frame.func.params) == 0
            and frame.func.num_locals == 0 {
            _sp_ot: int = 0;
            if jsv_is_object_cell(sp_obj) {
                _sp_ot = jsv_to_table_id(sp_obj);
            }
            _sp_dbg: str = "[DBG_SP] SET_PROP key="
                + str(sp_key)
                + "('"
                + str_from_id(sp_key)
                + "') obj_is_objcell="
                + str(jsv_is_object_cell(sp_obj))
                + " obj_tid="
                + str(_sp_ot)
                + " define_own="
                + str(sp_define_own)
                + "\n";
            write(2, _sp_dbg, len(_sp_dbg));
        }
        # Class constructors are strict: `C.caller = x` / `C.arguments = x` hit the
        # %ThrowTypeError% poison-pill (ES §10.2.4). A class is an object-cell (not is_fn_val),
        # so it misses the function poison-pill in the is_fn_val branch below — handle it here.
        # (sp_define_own object-literal defines never target a class, so this is safe first.)
        if sp_define_own == 0
            and (sp_key == WK_CALLER or sp_key == WK_ARGUMENTS)
            and jsv_is_object_cell(sp_obj)
            and jsv_to_table_id(sp_obj) > 0
            and js_object_has_own(sp_obj, WK_IS_CLASS)
            and not js_object_has_own(sp_obj, sp_key) {
            exc_cpps: JSValue = make_type_error(
                "'caller', 'callee', and 'arguments' properties may not be accessed on strict mode functions"
            );
            if not self._unwind_in_frame(frame, exc_cpps) {
                self.had_exception = True;
                self.pending_exc = exc_cpps;
                st.running = False;
            }
            return;
        }
        # ── Shape-based SET IC: existing writable own data prop (Phase 5) ───────
        # ic_holder==2 caches (shape_id, packed slot). Writability and same-attrs
        # are checked at FILL time and guaranteed by the shape match (attr changes
        # move the shape). Fill-time exclusions (env objects, module exports,
        # private keys) also hold on hit: gaining such a marker key changes shape.
        if VM_IC_ENABLED and ins.ic_holder == 2 and sp_define_own == 0 {
            sp_sid_ic: int = _vm_shape_of(sp_obj);
            if sp_sid_ic > 0 and sp_sid_ic == ins.ic_obj {
                js_object_slot_set_at_id(
                    jsv_to_table_id(sp_obj), ins.ic_ver // 16, sp_val
                );
                self._push(sp_val);
                return;
            }
        }
        # ── [[Set]]-ADD transition IC (call_path P4 / shapes Phase-6 gap) ──────
        # holder==4 caches (ic_obj=shape BEFORE, ic_ver=shape AFTER, ic_epoch=
        # proto epoch at fill). Shape match + unchanged proto epoch proves the
        # fill-time verification (no accessor named key anywhere on the chain,
        # fresh own-data leaf add) still holds → pure append-and-retag, skipping
        # the whole OrdinarySet prototype walk (was 39% of a ctor).
        if VM_IC_ENABLED and ins.ic_holder == 4 and sp_define_own == 0 {
            sp4_sid: int = _vm_shape_of(sp_obj);
            # >= 0: _vm_shape_of returns -1 for every non-shape case, so 0
            # UNAMBIGUOUSLY means "shape-mode object at the empty ROOT shape"
            # — the before-state of the FIRST store in every constructor. The
            # old `> 0` guard forced one full slow [[Set]] walk per construct.
            if sp4_sid >= 0
                and sp4_sid == ins.ic_obj
                and ins.ic_epoch == proto_epoch() {
                sp4_raw: JSObject = js_object_table_get(jsv_to_table_id(sp_obj));
                if sp4_raw.is_ext() {
                    sp4_raw.shape_id = ins.ic_ver;
                    sp4_raw.slots.append(sp_val);
                    sp4_raw.version = sp4_raw.version + 1;
                    # A new key on a prototype can shadow an inherited-read IC's holder.
                    if (sp4_raw.cell_flags & FLAG_IS_PROTO) != 0 {
                        proto_epoch_bump();
                    }
                    self._push(sp_val);
                    return;
                }
            }
        }
        # CreateDataProperty on a PROXY receiver (a class public-field initializer whose `this`
        # is a Proxy — a derived class extending a base that `return new Proxy(this, …)`) must
        # route through the proxy's `defineProperty` trap (§7.3.7 → §10.5.6), not a raw own
        # define (test262 class-field-is-observable-by-proxy, public-class-field-...-visible-to-
        # proxy). The trap sees { value, writable:T, enumerable:T, configurable:T }.
        if sp_define_own == 1 and js_is_proxy(sp_obj) {
            sp_pd: JSValue = js_object_create_null();
            js_object_set(sp_pd, WK_VALUE, sp_val);
            js_object_set(sp_pd, str_intern("writable"), js_boolean(True));
            js_object_set(sp_pd, str_intern("enumerable"), js_boolean(True));
            js_object_set(sp_pd, str_intern("configurable"), js_boolean(True));
            _ = proxy_trap_define_property(
                self, sp_obj, _vm_key_id_to_jsvalue(sp_key), sp_pd
            );
            if self.had_exception or vm_has_native_exc() {
                sp_pd_exc: JSValue = self.pending_exc;
                if vm_has_native_exc() {
                    sp_pd_exc = vm_take_native_exc();
                }
                self.had_exception = False;
                self.pending_exc = js_undefined();
                if not self._unwind_in_frame(frame, sp_pd_exc) {
                    self.had_exception = True;
                    self.pending_exc = sp_pd_exc;
                    st.running = False;
                }
                return;
            }
            self._push(sp_val);
            return;
        }
        # define_own: object-literal data property (§13.2.5.5 PropertyDefinition) —
        # define an OWN property via CreateDataProperty, never [[Set]].  A read-only
        # data property inherited from Object.prototype must not block the own
        # definition, so this bypasses the prototype-walking OrdinarySet below.
        # (Cached in arg3 as `(kid<<1)|define` after first dispatch.)
        if sp_define_own == 1
            and jsv_is_object_cell(sp_obj)
            and jsv_to_table_id(sp_obj) > 0 {
            # Concise-method [[HomeObject]] wiring (B13): a method value defined here
            # resolves `super.x` against this object's prototype.
            if is_fn_val(sp_val) {
                sp_dm_idx: int = get_fn_idx(sp_val);
                if sp_dm_idx >= 0 and sp_dm_idx < len(self.realm.closures) {
                    sp_dm_cl: JSClosure = self.realm.closures[sp_dm_idx];
                    if sp_dm_cl.func.is_method
                        and jsv_is_undefined(sp_dm_cl.home_object) {
                        sp_dm_cl.home_object = sp_obj;
                    }
                }
            }
            # ── Shape-based transition IC: object-literal / class-field define
            # (Phase 5). ic_holder==3 caches (ic_obj=shape BEFORE the add,
            # ic_ver=shape AFTER). CreateDataProperty ignores the prototype chain,
            # so a shape match + extensible receiver makes the add a pure
            # append-and-retag. (Module namespaces are excluded by _vm_shape_of.)
            if VM_IC_ENABLED and ins.ic_holder == 3 {
                sp_tsid: int = _vm_shape_of(sp_obj);
                if sp_tsid >= 0 and sp_tsid == ins.ic_obj {
                    sp_traw: JSObject = js_object_table_get(jsv_to_table_id(sp_obj));
                    if sp_traw.is_ext() {
                        sp_traw.shape_id = ins.ic_ver;
                        sp_traw.slots.append(sp_val);
                        sp_traw.version = sp_traw.version + 1;
                        if (sp_traw.cell_flags & FLAG_IS_PROTO) != 0 {
                            proto_epoch_bump();
                        }
                        self._push(sp_val);
                        return;
                    }
                }
            }
            # A new key on a plain extensible object: CreateDataProperty is a plain
            # add (no namespace, accessor, extensibility or attribute cases apply).
            if js_object_add_data_ordinary(sp_obj, sp_key, sp_val) {
                self._set_prop_define_ic_fill(frame, sp_obj, sp_key);
                self._push(sp_val);
                return;
            }
            # Module namespace: privileged export-binding install/update.  Exotic [[Set]]
            # always returns false, so ordinary CreateDataProperty cannot be used for
            # `export`/`export let` stores onto the namespace object.
            if js_is_module_namespace(sp_obj) {
                _ = js_object_namespace_export_set(sp_obj, sp_key, sp_val);
                self._push(sp_val);
                return;
            }
            # CreateDataPropertyOrThrow (ES §7.3.7): if [[DefineOwnProperty]] returns false —
            # e.g. the receiver is non-extensible / frozen and the key is not already an own
            # property — throw a TypeError (test262 class-field-on-frozen-objects: a public field
            # initializer on a frozen `this` throws). Non-zero return == failure.
            # CreateDataPropertyOrThrow (ES §7.3.7 / §15.7.10 DefineField): defining a NEW own
            # property on a non-extensible / frozen receiver fails, and a class FIELD initializer
            # must then throw a TypeError (test262 class-field-on-frozen-objects). Check
            # extensibility explicitly (only when the key is not already own) rather than the
            # define return code, which is non-zero for other benign reasons too.
            if not js_object_has_own(sp_obj, sp_key)
                and not js_object_is_extensible(sp_obj) {
                sp_cdp_exc: JSValue = make_type_error(
                    "Cannot define property, object is not extensible"
                );
                if not self._unwind_in_frame(frame, sp_cdp_exc) {
                    self.had_exception = True;
                    self.pending_exc = sp_cdp_exc;
                    st.running = False;
                }
                return;
            }
            _ = js_object_create_data_property_or_throw(sp_obj, sp_key, sp_val);
            self._set_prop_define_ic_fill(frame, sp_obj, sp_key);
            self._push(sp_val);
            return;
        }
        # ES §13.15 / §6.2.5.6 PutValue → RequireObjectCoercible: assigning a member of
        # `null` or `undefined` (`base.prop = v`, `base[k] = v`) is a TypeError.
        if jsv_is_null(sp_obj) or jsv_is_undefined(sp_obj) {
            sp_nb_tn: str = "null";
            if jsv_is_undefined(sp_obj) {
                sp_nb_tn = "undefined";
            }
            sp_nb_exc: JSValue = make_type_error(
                "Cannot set properties of "
                    + sp_nb_tn
                    + " (setting '"
                    + str_from_id(sp_key)
                    + "')"
            );
            if not self._unwind_in_frame(frame, sp_nb_exc) {
                self.had_exception = True;
                self.pending_exc = sp_nb_exc;
                st.running = False;
            }
            return;
        }
        # Module Namespace Exotic [[Set]] always returns false → TypeError in strict
        # only (PutValue); non-strict AssignmentExpression evaluates to the RHS.
        if js_is_module_namespace(sp_obj) {
            if frame.func.is_strict or ins.arg2 == 1 {
                sp_ns_exc: JSValue = make_type_error(
                    "Cannot assign to read only property '"
                        + str_from_id(sp_key)
                        + "' of object '[object Module]'"
                );
                if not self._unwind_in_frame(frame, sp_ns_exc) {
                    self.had_exception = True;
                    self.pending_exc = sp_ns_exc;
                    st.running = False;
                }
                return;
            }
            self._push(sp_val);
            return;
        }
        # B13: a concise object-literal method's [[HomeObject]] is the object it is
        # defined on, so `super.x` inside it resolves to GetPrototypeOf(home)[x].
        if is_fn_val(sp_val)
            and jsv_is_object_cell(sp_obj)
            and jsv_to_table_id(sp_obj) > 0 {
            sp_mcl_idx: int = get_fn_idx(sp_val);
            if sp_mcl_idx >= 0 and sp_mcl_idx < len(self.realm.closures) {
                sp_mcl: JSClosure = self.realm.closures[sp_mcl_idx];
                if sp_mcl.func.is_method and jsv_is_undefined(sp_mcl.home_object) {
                    sp_mcl.home_object = sp_obj;
                }
            }
        }
        if jsv_is_string_cell(sp_obj)
            or jsv_is_int32(sp_obj)
            or jsv_is_double(sp_obj)
            or jsv_is_bool(sp_obj) {
            # ECMAScript §10.2.1: setting a property on a primitive in strict mode is a TypeError.
            # Silently ignore in non-strict mode, but since we don't track strict mode we
            # throw always — no valid code intentionally assigns to a primitive property.
            exc_sp_prim: JSValue = make_type_error(
                "Cannot assign to read only property 'length' of a string"
            );
            if not self._unwind_in_frame(frame, exc_sp_prim) {
                self.had_exception = True;
                self.pending_exc = exc_sp_prim;
                st.running = False;
            }
            return;
        } elif is_fn_val(sp_obj) {
            # Function values use negative as_ptr — store in the closure's backing object.
            sp_fn_idx: int = get_fn_idx(sp_obj);
            if sp_fn_idx < len(self.realm.closures) {
                sp_cl: JSClosure = self.realm.closures[sp_fn_idx];
                # Poison-pill `caller`/`arguments` (%ThrowTypeError%): writing either on a
                # strict/arrow/generator/async/bound function throws TypeError (ES §10.2.4).
                if (sp_key == WK_CALLER or sp_key == WK_ARGUMENTS)
                    and not js_object_has_own(sp_cl.fn_props, sp_key) {
                    if sp_cl.func.is_strict
                        or sp_cl.is_arrow
                        or sp_cl.func.is_generator
                        or sp_cl.func.is_async
                        or sp_cl.func.is_bound {
                        exc_pps: JSValue = make_type_error(
                            "'caller', 'callee', and 'arguments' properties may not be accessed on strict mode functions"
                        );
                        if not self._unwind_in_frame(frame, exc_pps) {
                            self.had_exception = True;
                            self.pending_exc = exc_pps;
                            st.running = False;
                        }
                        return;
                    }
                }
                # `name` and `length` are non-writable, configurable own properties of a
                # function (ES §20.2.4.1/2).  An ordinary assignment is a silent no-op in
                # sloppy mode (TypeError in strict, handled by the strict-store path) —
                # unless the key was already reconfigured via defineProperty (a prior
                # fn_props entry), in which case respect that entry.
                sp_fn_readonly: bool = (sp_key == WK_NAME or sp_key == WK_LENGTH)
                    and not js_object_has_own(sp_cl.fn_props, sp_key);
                if sp_key == WK_PROTOTYPE {
                    # A non-writable `prototype` (downgraded via defineProperty) rejects a
                    # plain assignment: no-op in sloppy, TypeError in strict (ES §10.2.4).
                    if sp_cl.prototype_writable {
                        sp_cl.prototype_obj = sp_val;
                    } elif ins.arg2 == 1 {
                        sp_proto_ro_exc: JSValue = make_type_error(
                            "Cannot assign to read only property 'prototype' of function"
                        );
                        if not self._unwind_in_frame(frame, sp_proto_ro_exc) {
                            self.had_exception = True;
                            self.pending_exc = sp_proto_ro_exc;
                            st.running = False;
                        }
                        return;
                    }
                } elif not sp_fn_readonly {
                    js_object_set(sp_cl.fn_props, sp_key, sp_val);
                } elif ins.arg2 == 1 {
                    # Strict assignment to a function's non-writable `name`/`length`
                    # (ES §20.2.4) is a TypeError.
                    sp_fnro_exc: JSValue = make_type_error(
                        "Cannot assign to read only property '"
                            + str_from_id(sp_key)
                            + "' of function"
                    );
                    if not self._unwind_in_frame(frame, sp_fnro_exc) {
                        self.had_exception = True;
                        self.pending_exc = sp_fnro_exc;
                        st.running = False;
                    }
                    return;
                }
            }
        } elif is_native_val(sp_obj) {
            # Native builtins: name/length are non-writable (silent no-op); other
            # keys go into the lazy props store (R3).
            if sp_key != WK_NAME and sp_key != WK_LENGTH {
                sp_np: JSValue = native_props_ensure(sp_obj);
                if jsv_is_object_cell(sp_np) {
                    js_object_set(sp_np, sp_key, sp_val);
                }
            }
        } elif jsv_is_object_cell(sp_obj)
            and jsv_to_table_id(sp_obj) >= 0
            and (
                js_object_table_get(jsv_to_table_id(sp_obj)).cell_flags & FLAG_IS_CLASS
            )
                != 0 {
            # Class objects: avoid walking the static prototype chain
            # (Child.__proto__ = Parent) for inherited setters — BUT an *own* accessor
            # setter on the class itself (e.g. a `static set #x(v)` private accessor)
            # must still fire. Check own setter first; otherwise set directly.
            sp_own_setter: JSValue = js_object_get_own_accessor_setter(sp_obj, sp_key);
            if is_fn_val(sp_own_setter) {
                sp_ss_cl: JSClosure = self.realm.closures[get_fn_idx(sp_own_setter)];
                self.run_cl(sp_ss_cl, sp_own_setter, sp_obj, [sp_val]);
                if self.had_exception {
                    # The setter threw — unwind into the current frame so an enclosing
                    # try/catch can handle it (mirrors the call-native unwind pattern).
                    # Must `return` so the trailing `self._push(sp_val)` (assignment
                    # result) does not land on top of the unwound exception value.
                    sp_ss_exc: JSValue = self.pending_exc;
                    self.had_exception = False;
                    self.pending_exc = js_undefined();
                    if not self._unwind_in_frame(frame, sp_ss_exc) {
                        self.had_exception = True;
                        self.pending_exc = sp_ss_exc;
                        st.running = False;
                    }
                    return;
                }
            } else {
                if sp_key == WK_CLASS_NAME {
                    # NamedEvaluation / SetFunctionName (§15.7.14, §10.2.9): the
                    # inferred class name is only applied when the class does NOT
                    # already have a *meaningful* own `name` from a static element —
                    # e.g. `class { static name() {} }` or `static name = 1` keeps its
                    # own definition. A plain anonymous class is seeded with an empty
                    # own `name` ("") placeholder, which the inferred name replaces.
                    # Guarding on has-own alone wrongly skipped that replacement.
                    sp_cn_apply: bool = True;
                    if js_object_has_own(sp_obj, WK_NAME) {
                        sp_cn_cur: JSValue = js_object_get(sp_obj, WK_NAME);
                        # Only the empty-string placeholder is overwritten; any other
                        # own name (a static method, a static field value) wins.
                        sp_cn_is_placeholder: bool = jsv_is_string_cell(sp_cn_cur)
                            and str_from_id(jsv_to_table_id(sp_cn_cur)) == "";
                        if not sp_cn_is_placeholder {
                            sp_cn_apply = False;
                        }
                    }
                    if sp_cn_apply {
                        sp_name_desc: JSProperty = JSProperty(
                            key=WK_NAME,
                            value=sp_val,
                            writable=False,
                            enumerable=False,
                            configurable=True,
                            deleted=False
                        );
                        js_object_define_property(sp_obj, WK_NAME, sp_name_desc);
                    }
                    # The __CLASS_NAME__ marker is engine-internal and must never
                    # surface via Object.keys/getOwnPropertyNames on a class object
                    # (computed-property-names/class/static/method-*). Store it
                    # non-enumerable so the descriptor-based key walk skips it, in
                    # addition to the fn-value key filter (_vm_filter_fn_prop_keys).
                    sp_cn_marker_desc: JSProperty = JSProperty(
                        key=sp_key,
                        value=sp_val,
                        writable=True,
                        enumerable=False,
                        configurable=True,
                        deleted=False
                    );
                    js_object_define_property(sp_obj, sp_key, sp_cn_marker_desc);
                } else {
                    js_object_set(sp_obj, sp_key, sp_val);
                }
            }
        } elif jsv_is_object_cell(sp_obj)
            and js_is_array(sp_obj)
            and sp_key == WK_LENGTH {
            # Array exotic [[Set]] for "length" — pre-check writable, then ArraySetLength.
            sp_len_desc: JSProperty = js_object_get_own_property_descriptor(
                sp_obj, WK_LENGTH
            );
            sp_len_strict: bool = False;
            if len(self.frames) > 0 {
                sp_len_strict = self.frames[len(self.frames) - 1].func.is_strict;
            }
            if sp_len_desc.key != 0 and not sp_len_desc.writable {
                if sp_len_strict {
                    exc_sp_ro: JSValue = make_type_error(
                        "Cannot assign to read only property 'length'"
                    );
                    if not self._unwind_in_frame(frame, exc_sp_ro) {
                        self.had_exception = True;
                        self.pending_exc = exc_sp_ro;
                        st.running = False;
                    }
                    return;
                }
            } else {
                _push_native_obs_vm(self);
                sp_len_rc: int = js_array_set_length_via_set(sp_obj, sp_val);
                _pop_native_obs_vm();
                if vm_has_native_exc() {
                    exc_sp_len: JSValue = vm_take_native_exc();
                    if not self._unwind_in_frame(frame, exc_sp_len) {
                        self.had_exception = True;
                        self.pending_exc = exc_sp_len;
                        st.running = False;
                    }
                    return;
                }
                if sp_len_rc != 0 and sp_len_strict {
                    exc_sp_rej: JSValue = make_type_error(
                        "Cannot assign to read only property 'length'"
                    );
                    if not self._unwind_in_frame(frame, exc_sp_rej) {
                        self.had_exception = True;
                        self.pending_exc = exc_sp_rej;
                        st.running = False;
                    }
                    return;
                }
            }
        } elif sp_key == KEY_PROTO
            and jsv_is_object_cell(sp_obj)
            and jsv_to_table_id(sp_obj) > 0 {
            # `__proto__:` in an object literal (arg2==1) is the special PropertyDefinition
            # form (ES §13.2.5.5): it sets [[Prototype]] only when the value is an Object
            # or null; any other value (undefined, number, string, …) is SILENTLY IGNORED
            # — no throw, and no own `__proto__` property is created.
            if not (jsv_is_null(sp_val) or jsv_is_object_cell(sp_val)) {
                # ignore non-object / non-null __proto__ initializer
                sp_ignore_proto: bool = True;
            } elif js_object_set_prototype(sp_obj, sp_val) != 0 {
                exc_sp_proto2: JSValue = make_type_error(
                    "Object prototype may only be an Object or null"
                );
                if not self._unwind_in_frame(frame, exc_sp_proto2) {
                    self.had_exception = True;
                    self.pending_exc = exc_sp_proto2;
                    st.running = False;
                }
            }
        } else {
            # An *unmapped* (strict) arguments object has %ThrowTypeError% poison-pill
            # `callee` / `caller` accessors with no setter: assigning either throws
            # TypeError (ES §10.4.4.7 — [[Set]] on a data-less accessor).
            if (sp_key == WK_CALLEE or sp_key == WK_CALLER)
                and jsv_is_object_cell(sp_obj)
                and jsv_to_table_id(sp_obj) > 0
                and js_object_has_own(sp_obj, _KEY_IS_ARGUMENTS)
                and jsv_coerce_to_bool(js_object_get(sp_obj, _KEY_IS_ARGUMENTS)) {
                exc_acs: JSValue = make_type_error(
                    "'callee' and 'caller' cannot be set in this context"
                );
                if not self._unwind_in_frame(frame, exc_acs) {
                    self.had_exception = True;
                    self.pending_exc = exc_acs;
                    st.running = False;
                }
                return;
            }
            # OrdinarySet on a plain receiver whose chain has no setter / read-only
            # property / exotic for the key: one native pass. `exports` stays on the
            # full path (module-cache sync below), as do private names.
            if sp_priv_enc == 0
                and sp_key != WK_EXPORTS
                and jsv_is_object_cell(sp_obj) {
                # The IC fill below needs to know whether the key was own: a
                # shape-mode receiver keeps its shape on an overwrite and leaves
                # it on an add, so the shape id before the write answers that
                # without a has-own probe.
                sp_so_sid: int = js_object_ic_shape(sp_obj);
                if js_object_set_ordinary(sp_obj, sp_key, sp_val) {
                    if sp_so_sid >= 0 {
                        self._set_prop_ic_fill(
                            frame,
                            sp_obj,
                            sp_key,
                            js_object_ic_shape(sp_obj) == sp_so_sid,
                            False
                        );
                    }
                    self._push(sp_val);
                    return;
                }
            }
            # process.env coercion: values assigned to env must be strings (Node parity).
            sp_val_store: JSValue = sp_val;
            if jsv_is_object_cell(sp_obj)
                and (js_object_brand(sp_obj) & BRAND_ENV_OBJ) != 0 {
                sp_val_store = js_str_heap(jsval_to_str(sp_val));  # G1.5: env value coercion
            }
            # Strict mode (arg2 == 1): a failed [[Set]] — a non-writable data property
            # (own OR inherited on the prototype chain) or an accessor without a setter —
            # is a TypeError (ES §6.2.5.6 PutValue). `_vm_object_set_vop` performs the
            # spec OrdinarySet and returns False on such a failure (mirrors _super_set).
            # env/exports objects are never non-writable, so it is safe to skip their
            # special-casing here (they take the sloppy path below).
            # Private keys (`#x`) use brand-based accessor storage that _vm_object_set_vop
            # does not consult (a private setter would be missed), so let them take the
            # regular _set_prop_accessor path below.
            sp_is_private: bool = sp_priv_enc == 1;
            # Strict writability guard — but ONLY for the write-FAILS cases (non-writable
            # data prop, or a getter-only accessor). A property that HAS a setter goes
            # through the proven _set_prop_accessor path below, which correctly runs the
            # setter and unwinds a throw from within it (native or VM channel). Detecting
            # the setter up front keeps that path unchanged and avoids re-plumbing setter
            # exception handling through _vm_object_set_vop.
            if ins.arg2 == 1
                and not sp_is_private
                and jsv_is_object_cell(sp_obj)
                and jsv_to_table_id(sp_obj) > 0
                and (js_object_brand(sp_obj) & BRAND_ENV_OBJ) == 0
                and jsv_is_undefined(js_object_lookup_setter(sp_obj, sp_key)) {
                sp_vop_ip0: int = frame.ip;
                sp_vop_was: bool = js_object_has_own(sp_obj, sp_key);
                sp_strict_ok: bool = _vm_object_set_vop(
                    self, sp_obj, sp_key, sp_val_store, sp_obj
                );
                # A throwing OrdinarySet (e.g. a Proxy trap in the prototype chain, or a
                # native-channel error) already surfaced its own exception — unwind THAT, and do
                # not also raise the generic read-only TypeError (which would leave the original
                # native exc pending → escaping the caller's try/catch, test262 super/prop-*-strict
                # and the ordinary frozen-object write).
                if vm_has_native_exc() {
                    sp_ro_nexc: JSValue = vm_take_native_exc();
                    if not self._unwind_in_frame(frame, sp_ro_nexc) {
                        self.had_exception = True;
                        self.pending_exc = sp_ro_nexc;
                        st.running = False;
                    }
                    return;
                }
                if self.had_exception {
                    sp_ro_hexc: JSValue = self.pending_exc;
                    self.had_exception = False;
                    self.pending_exc = js_undefined();
                    if not self._unwind_in_frame(frame, sp_ro_hexc) {
                        self.had_exception = True;
                        self.pending_exc = sp_ro_hexc;
                        st.running = False;
                    }
                    return;
                }
                if not sp_strict_ok {
                    # DOUBLE-THROW guard: _set_prop_accessor_recv (via obs_set)
                    # already raises its own strict TypeError and, when the catch
                    # is in THIS frame, unwinds into it directly — consuming the
                    # handler, pushing the exception, and moving frame.ip. In that
                    # case had_exception/native-exc are both clear here, so the
                    # old code minted a SECOND TypeError whose unwind found the
                    # catch stack empty → the write escaped a same-frame
                    # try/catch as uncaught (cross-frame propagation, the
                    # assert.throws pattern, was unaffected — which is how this
                    # hid). frame.ip moving during the call is the unwind tell
                    # (nested calls run in their own frames and cannot move it).
                    if frame.ip != sp_vop_ip0 {
                        return;
                    }
                    sp_ro_exc: JSValue = make_type_error(
                        "Cannot assign to read only property '"
                            + str_from_id(sp_key)
                            + "' of object"
                    );
                    if not self._unwind_in_frame(frame, sp_ro_exc) {
                        self.had_exception = True;
                        self.pending_exc = sp_ro_exc;
                        st.running = False;
                    }
                    return;
                }
                self._set_prop_ic_fill(
                    frame, sp_obj, sp_key, sp_vop_was, sp_is_private
                );
                self._push(sp_val);
                return;
            }
            sp4_was: bool = js_object_has_own(sp_obj, sp_key);
            self._set_prop_accessor(sp_obj, sp_key, sp_val_store);
            if self.had_exception {
                # A setter invoked by _set_prop_accessor threw — unwind into this frame
                # so an enclosing try/catch (or destructuring close region) handles it,
                # and skip the trailing result-push.
                sp_acc_exc: JSValue = self.pending_exc;
                self.had_exception = False;
                self.pending_exc = js_undefined();
                if not self._unwind_in_frame(frame, sp_acc_exc) {
                    self.had_exception = True;
                    self.pending_exc = sp_acc_exc;
                    st.running = False;
                }
                return;
            }
            if sp_key == WK_EXPORTS and jsv_is_object_cell(sp_obj) {
                _sync_module_cache_exports(sp_obj, sp_val_store);
            }
            self._set_prop_ic_fill(frame, sp_obj, sp_key, sp4_was, sp_is_private);
        }
        # ECMAScript: assignment expression result is the assigned value, not the object.
        self._push(sp_val);
    }

    # True when any object on sp_obj's PROTOTYPE chain (excluding sp_obj
    # itself) carries an accessor named `key` (getter or setter) — the
    # [[Set]]-add IC must not cache past one. Bounded walk.
    def _chain_has_accessor(sp_obj: JSValue, key: int) -> bool {
        ch_p: JSValue = js_object_get_prototype(sp_obj);
        ch_n: int = 0;
        while jsv_is_object_cell(ch_p) and jsv_to_table_id(ch_p) > 0 and ch_n < 16 {
            if is_fn_val(js_object_get_own_accessor_getter(ch_p, key)) {
                return True;
            }
            if is_fn_val(js_object_get_own_accessor_setter(ch_p, key)) {
                return True;
            }
            ch_p = js_object_get_prototype(ch_p);
            ch_n = ch_n + 1;
        }
        return False;
    }

    def _op_del_prop(frame: CallFrame, ins: Instruction, st: ExecState) -> None {
        dp_key: int = _ins_cached_key_arg2(frame, ins);
        dp_obj: JSValue = self._pop();
        # `delete base.prop` first evaluates the MemberExpression, whose base must be
        # object-coercible: `delete null.x` / `delete undefined.x` throws TypeError
        # (ES §13.5.1.2 → GetValue → RequireObjectCoercible on the base).
        if jsv_is_null(dp_obj) or jsv_is_undefined(dp_obj) {
            exc_dpn: JSValue = make_type_error(
                "Cannot convert undefined or null to object"
            );
            if not self._unwind_in_frame(frame, exc_dpn) {
                self.had_exception = True;
                self.pending_exc = exc_dpn;
                st.running = False;
            }
            return;
        }
        dp_result: bool = True;
        # Module Namespace Exotic [[Delete]] (§10.4.6.9):
        # Symbol keys → OrdinaryDelete; string in exports → false (TypeError in strict);
        # string not in exports → true.
        # Strict flag is in arg3 (arg2 caches the property key id, like GET_PROP).
        dp_strict: int = ins.arg3;
        if js_is_module_namespace(dp_obj) {
            if dp_key >= SYMBOL_KEY_BASE {
                dp_result = js_object_delete(dp_obj, dp_key);
            } elif js_object_has_own(dp_obj, dp_key) {
                dp_result = False;
            } else {
                dp_result = True;
            }
            if not dp_result and dp_strict == 1 {
                exc_dp_ns: JSValue = make_type_error(
                    "Cannot delete property '"
                        + str_from_id(dp_key)
                        + "' of [object Module]"
                );
                if not self._unwind_in_frame(frame, exc_dp_ns) {
                    self.had_exception = True;
                    self.pending_exc = exc_dp_ns;
                    st.running = False;
                }
            } else {
                self._push(js_boolean(dp_result));
            }
            return;
        }
        # Function values: `name` / `length` / `prototype` and any fn_props entry live
        # on the closure, not a JSObject cell.  Handle their deletion here (name/length
        # are configurable → deletable; prototype of a non-arrow is non-configurable).
        if is_fn_val(dp_obj) {
            dp_fidx: int = get_fn_idx(dp_obj);
            if dp_fidx >= 0 and dp_fidx < len(self.realm.closures) {
                dp_cl: JSClosure = self.realm.closures[dp_fidx];
                if dp_key == WK_NAME {
                    dp_cl.name_removed = True;
                    self._push(js_true());
                    return;
                }
                if dp_key == WK_LENGTH {
                    dp_cl.length_removed = True;
                    self._push(js_true());
                    return;
                }
                if dp_key == WK_PROTOTYPE {
                    # Ordinary function prototype is non-configurable; arrows have none.
                    self._push(js_boolean(jsv_is_undefined(dp_cl.prototype_obj)));
                    return;
                }
                if jsv_is_object_cell(dp_cl.fn_props)
                    and js_object_has_own(dp_cl.fn_props, dp_key) {
                    self._push(js_boolean(js_object_delete(dp_cl.fn_props, dp_key)));
                    return;
                }
            }
            self._push(js_true());
            return;
        }
        if is_native_val(dp_obj) {
            # Configurable name/length tombstones + props-store keys (R3b).
            dp_result = native_delete_own(dp_obj, dp_key);
            if not dp_result and dp_strict == 1 {
                exc_dp_nat: JSValue = make_type_error(
                    "Cannot delete property '" + str_from_id(dp_key) + "'"
                );
                if not self._unwind_in_frame(frame, exc_dp_nat) {
                    self.had_exception = True;
                    self.pending_exc = exc_dp_nat;
                    st.running = False;
                }
            } else {
                self._push(js_boolean(dp_result));
            }
        } elif jsv_is_object_cell(dp_obj) and jsv_to_table_id(dp_obj) > 0 {
            dp_exc_unwound: bool = False;
            if js_is_proxy(dp_obj) {
                dp_result = proxy_trap_delete(self, dp_obj, dp_key);
                if vm_has_native_exc() {
                    exc_dp: JSValue = vm_take_native_exc();
                    if self._unwind_in_frame(frame, exc_dp) {
                        dp_exc_unwound = True;
                    } else {
                        self.had_exception = True;
                        self.pending_exc = exc_dp;
                        st.running = False;
                    }
                    dp_result = False;
                }
            } else {
                dp_result = js_object_delete(dp_obj, dp_key);
            }
            if dp_result
                and jsv_is_object_cell(_REQUIRE_CACHE_OBJ)
                and jsv_is_object_cell(dp_obj) {
                if jsv_to_table_id(dp_obj) == jsv_to_table_id(_REQUIRE_CACHE_OBJ) {
                    module_cache_delete(str_from_id(dp_key));
                }
            }
            if not dp_exc_unwound {
                if not dp_result and dp_strict == 1 {
                    exc_dp_st: JSValue = make_type_error(
                        "Cannot delete property '" + str_from_id(dp_key) + "'"
                    );
                    if not self._unwind_in_frame(frame, exc_dp_st) {
                        self.had_exception = True;
                        self.pending_exc = exc_dp_st;
                        st.running = False;
                    }
                } else {
                    self._push(js_boolean(dp_result));
                }
            }
        } else {
            self._push(js_true());
        }
    }

    def _op_get_index(frame: CallFrame, ins: Instruction, st: ExecState) -> None {
        gi_idx: JSValue = self._pop();
        gi_obj: JSValue = self._pop();
        if jsv_is_null(gi_obj) or jsv_is_undefined(gi_obj) {
            gi_type_name: str = "null";
            if jsv_is_undefined(gi_obj) {
                gi_type_name = "undefined";
            }
            exc_gi: JSValue = make_type_error(
                "Cannot read properties of " + gi_type_name
            );
            if not self._unwind_in_frame(frame, exc_gi) {
                self.had_exception = True;
                self.pending_exc = exc_gi;
                st.running = False;
            }
            return;
        }
        # ── Dense-elements fast path (dense_elements_impl_plan Phase 2) ────────
        # int32 index into a dense/holey array: in-range non-hole is a pure
        # vector load (own data always wins). Hole / out-of-range is undefined
        # WITHOUT the prototype walk while the no-index-props-on-protos protector
        # holds. Everything else (incl. Proxies/TypedArrays/namespaces — their
        # elems_kind is NONE) falls through to the general path unchanged.
        if jsv_is_int32(gi_idx) and jsv_is_object_cell(gi_obj) {
            gi_di: int = jsv_to_int32(gi_idx);
            gi_dtid: int = jsv_to_table_id(gi_obj);
            if gi_di >= 0
                and gi_dtid > 0
                and js_object_binary_kind_id(gi_dtid) == BINARY_KIND_TYPED_ARRAY {
                # TypedArray/Buffer indexed read: a non-negative int32 index into
                # an integer-kind (1..7) view goes straight to the allocation- and
                # reference-free element load, bypassing ToPropertyKey and the
                # property machinery. Integer-indexed reads never see the
                # prototype chain (own exotic own-property), so this is spec-exact;
                # BigInt / float kinds get the hole and take the general path.
                # (A view has no dense elements, so the branch below never applied.)
                gi_tv: JSValue = binary_ta_int_get(gi_obj, gi_di);
                if not jsv_is_hole(gi_tv) {
                    self._push(gi_tv);
                    return;
                }
            } elif gi_di >= 0 and gi_dtid > 0 {
                gi_draw: JSObject = js_object_table_get(gi_dtid);
                if gi_draw.elems_kind != ELEMS_NONE {
                    if gi_di < len(gi_draw.elems_ro()) {
                        gi_dv: JSValue = gi_draw.elems_ro()[gi_di];
                        if not jsv_is_hole(gi_dv) {
                            self._push(gi_dv);
                            return;
                        }
                    }
                    if idx_protector_ok() {
                        self._push(js_undefined());
                        return;
                    }
                }
            }
        }
        # ES §13.3.3 ToPropertyKey: an OBJECT computed key (non-symbol) is coerced to a
        # string via its own toString/valueOf, not the "[object Object]" default.
        if jsv_is_object_cell(gi_idx) and not jsv_is_symbol(gi_idx) {
            gi_idx = self._to_primitive_string(gi_idx);
            if self.had_exception {
                exc_gic: JSValue = self.pending_exc;
                self.had_exception = False;
                self.pending_exc = js_undefined();
                if not self._unwind_in_frame(frame, exc_gic) {
                    self.had_exception = True;
                    self.pending_exc = exc_gic;
                    st.running = False;
                }
                return;
            }
        }
        if is_fn_val(gi_obj) {
            # Function values: own fn_props accessors (JS or native getters, e.g. the
            # `get [Symbol.species]` defined on a plain-function constructor such as
            # Uint8Array) must be invoked exactly as the identifier (GET_PROP) path
            # does; _fn_prop alone read the accessor slot as data → undefined.
            gi_fn_res: JSValue = self._get_prop_accessor(
                gi_obj, jsval_to_prop_key(gi_idx)
            );
            if vm_has_native_exc() {
                exc_gi_fn: JSValue = vm_take_native_exc();
                if not self._unwind_in_frame(frame, exc_gi_fn) {
                    self.had_exception = True;
                    self.pending_exc = exc_gi_fn;
                    st.running = False;
                }
                return;
            }
            if self.had_exception {
                exc_gi_fh: JSValue = self.pending_exc;
                self.had_exception = False;
                self.pending_exc = js_undefined();
                if not self._unwind_in_frame(frame, exc_gi_fh) {
                    self.had_exception = True;
                    self.pending_exc = exc_gi_fh;
                    st.running = False;
                }
                return;
            }
            self._push(gi_fn_res);
        } elif is_native_val(gi_obj) {
            # Native builtins — name/length/props via _native_prop (R3a computed access).
            self._push(_native_prop(gi_obj, jsval_to_prop_key(gi_idx)));
        } elif jsv_is_string_cell(gi_obj) {
            # ── String bracket indexing: str[i] → single-character string ──
            gi_char_idx: int = -1;
            if jsv_is_int32(gi_idx) {
                gi_char_idx = jsv_to_int32(gi_idx);
            } elif jsv_is_double(gi_idx) {
                gi_fi: float = jsv_to_double(gi_idx);
                if gi_fi >= 0.0 {
                    gi_char_idx = int(gi_fi);
                }
            }
            if gi_char_idx >= 0 {
                gi_sid: int = jsv_to_table_id(gi_obj);
                if str_cell_ascii(gi_sid) == 1 {
                    # Byte-clean cell (ASCII, no NUL sentinel): 1 byte == 1 unit.
                    gi_s: str = str_from_id(gi_sid);
                    if gi_char_idx < len(gi_s) {
                        gi_ch: str = str_char_at(gi_s, gi_char_idx);
                        self._push(js_str(gi_ch));
                    } else {
                        self._push(js_undefined());
                    }
                } else {
                    # Index by UTF-16 code unit exactly like charAt. The byte-wise
                    # str_char_at read here was off by (bytes − units): vite's module
                    # code carries a real U+0000 (the "\0commonjsHelpers.js" import
                    # id, a 4-byte sentinel internally), so rollup's
                    # `code.original[this.end - 1] !== ';'` read 3 bytes early and
                    # appended a second ';' after most statements (1811 ';;' in a
                    # react bundle vs node's 8 → esbuild "Unexpected else").
                    gi_u: int = js_string_unit_at_cell(gi_sid, gi_char_idx);
                    if gi_u < 0 {
                        self._push(js_undefined());
                    } else {
                        self._push(js_str(js_string_unit_str(gi_u)));
                    }
                }
            } elif jsv_is_symbol(gi_idx) {
                # Handle Symbol keys on strings (e.g. str[Symbol.iterator])
                if jsv_to_table_id(gi_idx) == SYMBOL_ITERATOR {
                    self._push(
                        js_native_singleton(
                            "[Symbol.iterator]", 0, NATIVE_KIND_STR_ITER
                        )
                    );
                } else {
                    self._push(js_undefined());
                }
            } elif jsv_is_string_cell(gi_idx) {
                # Computed property access like str["length"] / str["split"].
                gi_sk: str = str_from_id(jsv_to_table_id(gi_idx));
                if gi_sk == "length" {
                    gi_s2: str = str_from_id(jsv_to_table_id(gi_obj));
                    self._push(js_int(js_string_utf16_len(gi_s2)));
                } else {
                    # Route through String.prototype so computed access agrees with
                    # identifier access (`"x"["slice"]` === `"x".slice`).
                    self._push(self._string_proto_get(str_intern(gi_sk)));
                }
            } else {
                self._push(js_undefined());
            }
        } elif jsv_is_int32(gi_obj) or jsv_is_double(gi_obj) {
            # Computed member access on a primitive Number behaves as though boxed (ES
            # §9.1.1.1): mirror the identifier (GET_PROP) path so `(5)["toString"]` ===
            # `(5).toString` (test262 property-accessors S11.2.1). Non-object index → key id.
            gi_nk: int = jsval_to_prop_key(gi_idx);
            if gi_nk == WK_TOFIXED {
                self._push(js_native_singleton("toFixed", 1, NATIVE_KIND_NUM_TOFIXED));
            } elif gi_nk == WK_TOPRECISION {
                self._push(
                    js_native_singleton("toPrecision", 1, NATIVE_KIND_NUM_TOPRECISION)
                );
            } elif gi_nk == WK_TOEXPONENTIAL {
                self._push(
                    js_native_singleton(
                        "toExponential", 1, NATIVE_KIND_NUM_TOEXPONENTIAL
                    )
                );
            } elif gi_nk == WK_TOSTRING {
                self._push(
                    js_native_singleton("toString", 1, NATIVE_KIND_NUM_TOSTRING)
                );
            } elif gi_nk == WK_VALUEOF {
                self._push(js_native_singleton("valueOf", 0, NATIVE_KIND_NUM_VALUEOF));
            } else {
                gi_np: JSValue = js_number_get_proto();
                if jsv_is_object_cell(gi_np) and jsv_to_table_id(gi_np) > 0 {
                    self._push(self._get_prop_accessor_recv(gi_np, gi_nk, gi_obj));
                } else {
                    self._push(js_undefined());
                }
            }
        } elif jsv_is_bool(gi_obj) {
            gi_bk: int = jsval_to_prop_key(gi_idx);
            if gi_bk == WK_TOSTRING {
                self._push(
                    js_native_singleton("toString", 0, NATIVE_KIND_BOOL_TOSTRING)
                );
            } elif gi_bk == WK_VALUEOF {
                self._push(js_native_singleton("valueOf", 0, NATIVE_KIND_BOOL_VALUEOF));
            } elif gi_bk == WK_CONSTRUCTOR {
                self._push(js_object_get(self.global_this, WK_BOOLEAN));
            } else {
                gi_bp: JSValue = js_boolean_get_proto();
                if jsv_is_object_cell(gi_bp) and jsv_to_table_id(gi_bp) > 0 {
                    self._push(self._get_prop_accessor_recv(gi_bp, gi_bk, gi_obj));
                } else {
                    self._push(js_undefined());
                }
            }
        } else {
            # ES §13.3.3 ToPropertyKey: an object computed key is coerced via ToPrimitive
            # (may throw / divert control); _to_property_key sets _coerce_diverted then.
            gi_pkey: int = self._to_property_key(gi_idx, frame, st);
            if self._coerce_diverted {
                return;
            }
            # R14: use _get_prop_accessor so both JS and native getters are invoked
            # (e.g. get Array [ @@species ]). Previously only is_fn_val getters ran.
            gi_result: JSValue = self._get_prop_accessor(gi_obj, gi_pkey);
            if vm_has_native_exc() {
                exc_gi_p: JSValue = vm_take_native_exc();
                if not self._unwind_in_frame(frame, exc_gi_p) {
                    self.had_exception = True;
                    self.pending_exc = exc_gi_p;
                    st.running = False;
                }
                return;
            }
            if self.had_exception {
                exc_gi_h: JSValue = self.pending_exc;
                self.had_exception = False;
                self.pending_exc = js_undefined();
                if not self._unwind_in_frame(frame, exc_gi_h) {
                    self.had_exception = True;
                    self.pending_exc = exc_gi_h;
                    st.running = False;
                }
                return;
            }
            # Class static inheritance through a plain-function heritage (WK_SUPER),
            # mirroring the identifier path: `MyU8[Symbol.species]` for
            # `class MyU8 extends Uint8Array` must reach Uint8Array's getter.
            if jsv_is_undefined(gi_result)
                and jsv_is_object_cell(gi_obj)
                and jsv_to_table_id(gi_obj) > 0
                and (
                    js_object_table_get(jsv_to_table_id(gi_obj)).cell_flags
                    & FLAG_IS_CLASS
                )
                    != 0 {
                gi_result = self._class_super_static_lookup(gi_obj, gi_pkey);
                if vm_has_native_exc() {
                    exc_gi_cs: JSValue = vm_take_native_exc();
                    if not self._unwind_in_frame(frame, exc_gi_cs) {
                        self.had_exception = True;
                        self.pending_exc = exc_gi_cs;
                        st.running = False;
                    }
                    return;
                }
            }
            # Fallback: if the key is Symbol.iterator and result is undefined,
            # return the native iterator factory for arrays or strings.
            # (Arrays/strings are created with null-prototype so arr_proto's
            #  Symbol.iterator property is not reachable via the chain.)
            if jsv_is_undefined(gi_result) and jsv_is_symbol(gi_idx) {
                if jsv_to_table_id(gi_idx) == SYMBOL_ITERATOR {
                    if jsv_is_object_cell(gi_obj) and js_is_array(gi_obj) {
                        gi_result = self._get_prop_accessor(gi_obj, WK_VALUES);
                    } elif jsv_is_string_cell(gi_obj) {
                        gi_result = js_native_singleton(
                            "[Symbol.iterator]", 0, NATIVE_KIND_STR_ITER
                        );
                    } elif jsv_is_object_cell(gi_obj) and js_is_map(gi_obj) {
                        gi_result = self._get_prop_accessor(gi_obj, WK_ENTRIES);
                    } elif jsv_is_object_cell(gi_obj) and js_is_set(gi_obj) {
                        gi_result = self._get_prop_accessor(gi_obj, WK_VALUES);
                    } elif jsv_is_object_cell(gi_obj) and js_is_generator(gi_obj) {
                        gi_result = js_native_singleton(
                            "[Symbol.iterator]", 0, NATIVE_KIND_GENERATOR_SYMBOL_ITER
                        );
                    }
                }
                if vm_has_native_exc() {
                    exc_gi_it: JSValue = vm_take_native_exc();
                    if not self._unwind_in_frame(frame, exc_gi_it) {
                        self.had_exception = True;
                        self.pending_exc = exc_gi_it;
                        st.running = False;
                    }
                    return;
                }
            }
            self._push(gi_result);
        }
    }

    """`super.x` read (ES §13.3.7).  Stack: [superBase, receiver].  Read the
    property off superBase, but a getter runs with this=receiver (the method's
    `this`), not superBase."""
    def _op_super_get_prop(frame: CallFrame, ins: Instruction, st: ExecState) -> None {
        sgp_recv: JSValue = self._pop();
        sgp_base: JSValue = self._pop();
        sgp_key: int = _ins_cached_key_arg2(frame, ins);
        if jsv_is_null(sgp_base) or jsv_is_undefined(sgp_base) {
            exc_sgp: JSValue = make_type_error(
                "Cannot read properties of null or undefined (super)"
            );
            if not self._unwind_in_frame(frame, exc_sgp) {
                self.had_exception = True;
                self.pending_exc = exc_sgp;
                st.running = False;
            }
            return;
        }
        sgp_val: JSValue = self._get_prop_accessor_recv(sgp_base, sgp_key, sgp_recv);
        if vm_has_native_exc() {
            # a JS getter's throw is re-raised on the native channel
            sgp_nexc: JSValue = vm_take_native_exc();
            if not self._unwind_in_frame(frame, sgp_nexc) {
                self.had_exception = True;
                self.pending_exc = sgp_nexc;
                st.running = False;
            }
            return;
        }
        if self.had_exception {
            sgp_exc2: JSValue = self.pending_exc;
            self.had_exception = False;
            self.pending_exc = js_undefined();
            if not self._unwind_in_frame(frame, sgp_exc2) {
                self.had_exception = True;
                self.pending_exc = sgp_exc2;
                st.running = False;
            }
            return;
        }
        self._push(sgp_val);
    }

    """`super[expr]` read.  Stack: [superBase, key, receiver]."""
    def _op_super_get_index(frame: CallFrame, ins: Instruction, st: ExecState) -> None {
        sgi_recv: JSValue = self._pop();
        sgi_key_v: JSValue = self._pop();
        sgi_base: JSValue = self._pop();
        if jsv_is_null(sgi_base) or jsv_is_undefined(sgi_base) {
            exc_sgi: JSValue = make_type_error(
                "Cannot read properties of null or undefined (super)"
            );
            if not self._unwind_in_frame(frame, exc_sgi) {
                self.had_exception = True;
                self.pending_exc = exc_sgi;
                st.running = False;
            }
            return;
        }
        sgi_key: int = self._to_property_key(sgi_key_v, frame, st);
        if self._coerce_diverted {
            return;
        }
        sgi_val: JSValue = self._get_prop_accessor_recv(sgi_base, sgi_key, sgi_recv);
        if vm_has_native_exc() {
            sgi_nexc: JSValue = vm_take_native_exc();
            if not self._unwind_in_frame(frame, sgi_nexc) {
                self.had_exception = True;
                self.pending_exc = sgi_nexc;
                st.running = False;
            }
            return;
        }
        if self.had_exception {
            sgi_exc2: JSValue = self.pending_exc;
            self.had_exception = False;
            self.pending_exc = js_undefined();
            if not self._unwind_in_frame(frame, sgi_exc2) {
                self.had_exception = True;
                self.pending_exc = sgi_exc2;
                st.running = False;
            }
            return;
        }
        self._push(sgi_val);
    }

    """`super.x = val` / `super[k] = val` (ES §13.3.7.1 [[Set]] with receiver).
    A setter found on the super base's chain runs with this=receiver; a getter-only
    accessor is a no-op (strict TypeError); otherwise the property is created/updated
    on the RECEIVER (the current `this`), honouring non-writability."""
    def _super_set(
        base: JSValue,
        key: int,
        val: JSValue,
        receiver: JSValue,
        frame: CallFrame,
        st: ExecState
    ) -> None {
        # ES §13.3.7 / §6.2.5.6 PutValue → ToObject(superBase), where superBase =
        # [[HomeObject]].[[GetPrototypeOf]](). A null super base is a TypeError — e.g.
        # `Object.setPrototypeOf(C, null)` then `super.x = v` / `super[k] = v` in a
        # static method (test262 target-super-*-reference-null). LOAD_SUPER_PROTO pushes
        # `undefined` for an extends-less method (no super_class); recover the real base
        # as GetPrototypeOf(receiver) (the class object for a static method) and throw
        # only when that is null — leaving every other case byte-for-byte unchanged.
        if jsv_is_undefined(base) and jsv_is_object_cell(receiver) {
            ss_recv_proto: JSValue = js_object_get_prototype(receiver);
            if jsv_is_null(ss_recv_proto) or jsv_is_undefined(ss_recv_proto) {
                ss_np_te: JSValue = make_type_error(
                    "Cannot convert undefined or null to object"
                );
                if not self._unwind_in_frame(frame, ss_np_te) {
                    self.had_exception = True;
                    self.pending_exc = ss_np_te;
                    st.running = False;
                }
                return;
            }
        }
        ss_setter: JSValue = js_undefined();
        if jsv_is_object_cell(base) and jsv_to_table_id(base) > 0 {
            ss_setter = js_object_lookup_setter(base, key);
        }
        if not jsv_is_undefined(ss_setter) {
            if is_fn_val(ss_setter) {
                ss_cl: JSClosure = self.realm.closures[get_fn_idx(ss_setter)];
                self.run_cl(ss_cl, ss_setter, receiver, [val]);
            } elif is_native_val(ss_setter) {
                _vm_call_native_proxy_aware(
                    self, self.realm, get_native_kind(ss_setter), receiver, [val]
                );
            }
            if self.had_exception {
                ss_exc: JSValue = self.pending_exc;
                self.had_exception = False;
                self.pending_exc = js_undefined();
                if not self._unwind_in_frame(frame, ss_exc) {
                    self.had_exception = True;
                    self.pending_exc = ss_exc;
                    st.running = False;
                }
            }
            return;
        }
        # A getter-only accessor on the chain → assignment is a no-op (strict throws).
        if jsv_is_object_cell(base) and jsv_to_table_id(base) > 0 {
            ss_getter: JSValue = js_object_lookup_getter(base, key);
            if not jsv_is_undefined(ss_getter) {
                if frame.func.is_strict {
                    ss_te: JSValue = make_type_error(
                        "Cannot set property which has only a getter"
                    );
                    if not self._unwind_in_frame(frame, ss_te) {
                        self.had_exception = True;
                        self.pending_exc = ss_te;
                        st.running = False;
                    }
                }
                return;
            }
        }
        # OrdinarySetWithOwnDescriptor on a missing/own data property: first
        # ? Receiver.[[GetOwnProperty]](P).  Module-namespace TDZ bindings throw
        # ReferenceError here (super-access-to-tdz-binding); initialized exports
        # still reject the write (non-writable / exotic [[DefineOwnProperty]]).
        if jsv_is_object_cell(receiver) and jsv_to_table_id(receiver) > 0 {
            if js_is_module_namespace(receiver) {
                ss_key_v: JSValue = _vm_key_id_to_jsvalue(key);
                _ = _vm_module_namespace_gopd(self, receiver, ss_key_v);
                if vm_has_native_exc() {
                    ss_nexc: JSValue = vm_take_native_exc();
                    if not self._unwind_in_frame(frame, ss_nexc) {
                        self.had_exception = True;
                        self.pending_exc = ss_nexc;
                        st.running = False;
                    }
                    return;
                }
                if self.had_exception {
                    ss_hexc: JSValue = self.pending_exc;
                    self.had_exception = False;
                    self.pending_exc = js_undefined();
                    if not self._unwind_in_frame(frame, ss_hexc) {
                        self.had_exception = True;
                        self.pending_exc = ss_hexc;
                        st.running = False;
                    }
                    return;
                }
                if frame.func.is_strict {
                    ss_te_ns: JSValue = make_type_error(
                        "Cannot assign to read only property '"
                            + str_from_id(key)
                            + "' of object '[object Module]'"
                    );
                    if not self._unwind_in_frame(frame, ss_te_ns) {
                        self.had_exception = True;
                        self.pending_exc = ss_te_ns;
                        st.running = False;
                    }
                }
                return;
            }
            # Ordinary data write onto the RECEIVER (this).  js_object_set respects a
            # non-writable / frozen target by leaving it unchanged; surface the strict
            # TypeError to match `'use strict'` semantics.
            ss_ok: bool = _vm_object_set_vop(self, receiver, key, val, receiver);
            if not ss_ok and frame.func.is_strict {
                ss_te2: JSValue = make_type_error(
                    "Cannot assign to read only property"
                );
                if not self._unwind_in_frame(frame, ss_te2) {
                    self.had_exception = True;
                    self.pending_exc = ss_te2;
                    st.running = False;
                }
            }
        }
    }

    def _op_super_set_prop(frame: CallFrame, ins: Instruction, st: ExecState) -> None {
        ssp_recv: JSValue = self._pop();
        ssp_base: JSValue = self._pop();
        ssp_val: JSValue = self._pop();
        ssp_key: int = _ins_cached_key_arg2(frame, ins);
        # _super_set unwinds a strict read-only / getter-only TypeError into `frame` (jumping
        # to a catch handler or clearing st.running). Skip pushing the value in that case —
        # otherwise the extra push corrupts the catch handler's operand stack (test262
        # super/prop-*-ref-strict, where `super.y=9` on a frozen receiver is caught).
        ssp_ip0: int = frame.ip;
        self._super_set(ssp_base, ssp_key, ssp_val, ssp_recv, frame, st);
        if self.had_exception
            or vm_has_native_exc()
            or frame.ip != ssp_ip0
            or not st.running {
            return;
        }
        self._push(ssp_val);
    }

    def _op_super_set_index(frame: CallFrame, ins: Instruction, st: ExecState) -> None {
        ssi_recv: JSValue = self._pop();
        ssi_key_v: JSValue = self._pop();
        ssi_base: JSValue = self._pop();
        ssi_val: JSValue = self._pop();
        ssi_key: int = self._to_property_key(ssi_key_v, frame, st);
        if self._coerce_diverted {
            return;
        }
        ssi_ip0: int = frame.ip;
        self._super_set(ssi_base, ssi_key, ssi_val, ssi_recv, frame, st);
        if self.had_exception
            or vm_has_native_exc()
            or frame.ip != ssi_ip0
            or not st.running {
            return;
        }
        self._push(ssi_val);
    }

    def _op_set_index(frame: CallFrame, ins: Instruction, st: ExecState) -> None {
        si_val: JSValue = self._pop();
        si_idx: JSValue = self._pop();
        si_obj: JSValue = self._pop();
        # arg3 == 1: computed object-literal data property `{[k]: v}` or a class
        # computed field `this[k] = v` (§13.2.5.5 / §15.7.10) — define an OWN property
        # via CreateDataProperty, not [[Set]].  ToPropertyKey coerces the key first
        # (may divert to a valueOf/Symbol.toPrimitive frame).  A class value reads as
        # both is_fn_val and an object cell; CreateDataProperty on the cell writes the
        # store getOwnPropertyDescriptor reads, giving correct {w:T,e:T,c:T} flags
        # (the fn_props [[Set]] path preserved a stale non-enumerable descriptor for
        # keys like `constructor`).
        if ins.arg3 == 1
            and jsv_is_object_cell(si_obj)
            and jsv_to_table_id(si_obj) > 0 {
            si_do_key: int = self._to_property_key(si_idx, frame, st);
            if self._coerce_diverted {
                return;
            }
            # Concise-method [[HomeObject]] wiring (B13): a COMPUTED-key object-literal
            # method (`{ ['a'](){ super.m() } }`) defines the fn here via SET_INDEX, so its
            # home_object must be set to this object — mirroring the non-computed SET_PROP
            # path — else `super` resolves against nothing (test262
            # computed-property-names/object/method/super). Guarded by is_method so a plain
            # computed data property `{[k]: fn}` or a class computed field is unaffected.
            if is_fn_val(si_val) {
                si_hm_idx: int = get_fn_idx(si_val);
                if si_hm_idx >= 0 and si_hm_idx < len(self.realm.closures) {
                    si_hm_cl: JSClosure = self.realm.closures[si_hm_idx];
                    if si_hm_cl.func.is_method
                        and jsv_is_undefined(si_hm_cl.home_object) {
                        si_hm_cl.home_object = si_obj;
                    }
                }
            }
            _ = js_object_create_data_property_or_throw(si_obj, si_do_key, si_val);
            self._push(si_val);
            return;
        }
        # ES §6.2.5.6 PutValue → RequireObjectCoercible: `null[k] = v` / `undefined[k] = v`
        # is a TypeError.  (Object computed-key ToPrimitive coercion is handled by
        # _to_property_key in the ordinary-object branch below.)
        if jsv_is_null(si_obj) or jsv_is_undefined(si_obj) {
            si_nb_tn: str = "null";
            if jsv_is_undefined(si_obj) {
                si_nb_tn = "undefined";
            }
            si_nb_exc: JSValue = make_type_error(
                "Cannot set properties of " + si_nb_tn
            );
            if not self._unwind_in_frame(frame, si_nb_exc) {
                self.had_exception = True;
                self.pending_exc = si_nb_exc;
                st.running = False;
            }
            return;
        }
        # ── Dense-elements fast path (dense_elements_impl_plan Phase 2) ────────
        # In-range non-hole overwrite: own writable data element wins over
        # everything — always safe. Append at the exact dense end additionally
        # needs the no-index-props-on-protos protector (no inherited setter /
        # readonly index can exist), extensibility, and the array length-write
        # permission; length then grows exactly as the slow path would.
        if jsv_is_int32(si_idx) and jsv_is_object_cell(si_obj) {
            si_di: int = jsv_to_int32(si_idx);
            si_dtid: int = jsv_to_table_id(si_obj);
            if si_di >= 0
                and si_dtid > 0
                and js_object_binary_kind_id(si_dtid) == BINARY_KIND_TYPED_ARRAY {
                # TypedArray/Buffer indexed write (mirror of GET_INDEX). Only when
                # the value is ALREADY a Number — a non-number RHS needs observable
                # ToNumber (valueOf/@@toPrimitive), so it takes _ta_set_index below.
                # Integer kinds 1..7 only (BigInt via the slow path); ToNumber of a
                # number is the identity, so this is spec-exact.
                if jsv_is_int32(si_val) or jsv_is_double(si_val) {
                    si_tfn: float = 0.0;
                    if jsv_is_int32(si_val) {
                        si_tfn = float(jsv_to_int32(si_val));
                    } else {
                        si_tfn = jsv_to_double(si_val);
                    }
                    if binary_ta_int_set(si_obj, si_di, si_tfn) {
                        self._push(si_val);
                        return;
                    }
                }
            } elif si_di >= 0 and si_dtid > 0 {
                si_draw: JSObject = js_object_table_get(si_dtid);
                if si_draw.elems_kind != ELEMS_NONE {
                    if si_di < len(si_draw.elems_ro())
                        and not jsv_is_hole(si_draw.elems_ro()[si_di]) {
                        si_draw.elems_rw()[si_di] = si_val;
                        self._push(si_val);
                        return;
                    }
                    if si_di == len(si_draw.elems_ro())
                        and idx_protector_ok()
                        and si_draw.is_ext()
                        and si_draw.mode == MAP_MODE_SHAPE {
                        # Length bookkeeping without descriptor materialization:
                        # dense arrays keep `length` as a shape-slot data prop, so
                        # reads/writes are packed-attr checks + slot ops. Below the
                        # stored length (trailing-holes region) no length write is
                        # needed; at/above it the length must be writable to grow.
                        si_dpk: int = shape_lookup(si_draw.shape_id, WK_LENGTH);
                        if si_dpk >= 0 and (si_dpk & SHAPE_ATTR_ACCESSOR) == 0 {
                            si_dlen_v: JSValue = si_draw.slots[si_dpk // 16];
                            if jsv_is_int32(si_dlen_v) {
                                si_dcur: int = jsv_to_int32(si_dlen_v);
                                if si_di < si_dcur {
                                    si_draw.elems_rw().append(si_val);
                                    self._push(si_val);
                                    return;
                                }
                                if (si_dpk & PROP_WRITABLE) != 0 {
                                    si_draw.elems_rw().append(si_val);
                                    si_draw.slots[si_dpk // 16] = js_int(si_di + 1);
                                    self._push(si_val);
                                    return;
                                }
                            }
                        }
                    }
                }
            }
        }
        # Module Namespace Exotic [[Set]] always returns false → TypeError in strict
        # only (covers computed keys: `ns[sym] = v`, `ns[Symbol.toStringTag] = v`).
        if js_is_module_namespace(si_obj) {
            if frame.func.is_strict or ins.arg2 == 1 {
                si_ns_exc: JSValue = make_type_error(
                    "Cannot assign to read only property of object '[object Module]'"
                );
                if not self._unwind_in_frame(frame, si_ns_exc) {
                    self.had_exception = True;
                    self.pending_exc = si_ns_exc;
                    st.running = False;
                }
                return;
            }
            self._push(si_val);
            return;
        }
        if is_fn_val(si_obj) {
            # Function values — store on backing object.  Mirror the static SET_PROP
            # path: `name`/`length` are non-writable, `prototype` writes the closure's
            # prototype_obj.  Without this, a computed write `fn["name"] = x` bypassed
            # the read-only guard and shadowed the intrinsic (broke verifyProperty).
            si_fn_idx: int = get_fn_idx(si_obj);
            if si_fn_idx < len(self.realm.closures) {
                si_cl: JSClosure = self.realm.closures[si_fn_idx];
                si_fn_key: int = jsval_to_prop_key(si_idx);
                si_fn_readonly: bool = (si_fn_key == WK_NAME or si_fn_key == WK_LENGTH)
                    and not js_object_has_own(si_cl.fn_props, si_fn_key);
                if si_fn_key == WK_PROTOTYPE {
                    # Non-writable `prototype` (downgraded via defineProperty) rejects a
                    # computed assignment too: no-op sloppy, TypeError strict (ES §10.2.4).
                    if si_cl.prototype_writable {
                        si_cl.prototype_obj = si_val;
                    } elif frame.func.is_strict or ins.arg2 == 1 {
                        si_proto_ro_exc: JSValue = make_type_error(
                            "Cannot assign to read only property 'prototype' of function"
                        );
                        if not self._unwind_in_frame(frame, si_proto_ro_exc) {
                            self.had_exception = True;
                            self.pending_exc = si_proto_ro_exc;
                            st.running = False;
                        }
                        return;
                    }
                } elif not si_fn_readonly {
                    js_object_set(si_cl.fn_props, si_fn_key, si_val);
                }
            }
        } elif is_native_val(si_obj) {
            # Native builtins: name/length non-writable; other keys → props store (R3).
            si_pkey_n: int = jsval_to_prop_key(si_idx);
            if si_pkey_n != WK_NAME and si_pkey_n != WK_LENGTH {
                si_np: JSValue = native_props_ensure(si_obj);
                if jsv_is_object_cell(si_np) {
                    js_object_set(si_np, si_pkey_n, si_val);
                }
            }
        } else {
            # ES §13.3.3 ToPropertyKey coercion (object key → primitive; may divert).
            si_pkey: int = self._to_property_key(si_idx, frame, st);
            if self._coerce_diverted {
                return;
            }
            if self._ta_is_instance(si_obj) {
                si_ta_key: tuple[bool, int] = self._ta_key_index(si_pkey);
                if si_ta_key[0] {
                    _ = self._ta_set_index(si_obj, si_ta_key[1], si_val);
                    if vm_has_native_exc() {
                        exc_si_ta: JSValue = vm_take_native_exc();
                        if not self._unwind_in_frame(frame, exc_si_ta) {
                            self.had_exception = True;
                            self.pending_exc = exc_si_ta;
                            st.running = False;
                        }
                        return;
                    }
                    self._push(si_val);
                    return;
                }
            }
            # resolve array-index and reject growth when length is non-writable.
            si_num_idx: int = -1;
            si_is_arr: bool = js_is_array(si_obj);
            if si_is_arr {
                if jsv_is_int32(si_idx) {
                    si_iv: int = jsv_to_int32(si_idx);
                    if si_iv >= 0 {
                        si_num_idx = si_iv;
                    }
                } elif jsv_is_double(si_idx) {
                    si_fi: float = jsv_to_double(si_idx);
                    if si_fi >= 0.0
                        and si_fi == float(int(si_fi))
                        and si_fi < 4294967295.0 {
                        si_num_idx = int(si_fi);
                    }
                } else {
                    si_num_idx = _array_index_key_numeric(si_pkey);
                }
                if si_num_idx >= 0
                    and not _array_index_write_allowed(si_obj, si_num_idx) {
                    si_strict: bool = False;
                    if len(self.frames) > 0 {
                        si_strict = self.frames[len(self.frames) - 1].func.is_strict;
                    }
                    if si_strict {
                        exc_si_ro: JSValue = make_type_error(
                            "Cannot assign to read only property"
                        );
                        if not self._unwind_in_frame(frame, exc_si_ro) {
                            self.had_exception = True;
                            self.pending_exc = exc_si_ro;
                            st.running = False;
                        }
                        return;
                    }
                    self._push(si_val);
                    return;
                }
            }
            # process.env coercion: values assigned to env must be strings (Node parity).
            si_val_store: JSValue = si_val;
            if jsv_is_object_cell(si_obj)
                and js_object_has_own(si_obj, _KEY_IS_ENV_OBJ) {
                si_val_store = js_str_heap(jsval_to_str(si_val));  # G1.5: env value coercion
            }
            # OrdinarySet with the primitive/object as receiver (§10.1.9.2): invokes a
            # setter, discards a getter-only assignment in sloppy mode, and returns
            # False when the set should fail. The receiver-aware form threads setter
            # exceptions and the strict-mode throw-on-failure (si_set_ok is consumed below).
            si_set_ok: bool = self._set_prop_accessor_recv(
                si_obj, si_pkey, si_val_store, si_obj
            );
            if self.had_exception {
                si_acc_exc: JSValue = self.pending_exc;
                self.had_exception = False;
                self.pending_exc = js_undefined();
                if not self._unwind_in_frame(frame, si_acc_exc) {
                    self.had_exception = True;
                    self.pending_exc = si_acc_exc;
                    st.running = False;
                }
                return;
            }
            if vm_has_native_exc() {
                si_ne_exc: JSValue = vm_take_native_exc();
                if not self._unwind_in_frame(frame, si_ne_exc) {
                    self.had_exception = True;
                    self.pending_exc = si_ne_exc;
                    st.running = False;
                }
                return;
            }
            si_strict_set: bool = False;
            if len(self.frames) > 0 {
                si_strict_set = self.frames[len(self.frames) - 1].func.is_strict;
            }
            if not si_set_ok and si_strict_set {
                return;
            }
            # when setting an array element at index >= length, extend length.
            if si_is_arr and si_num_idx >= 0 and si_set_ok {
                _array_grow_length_if_needed(si_obj, si_num_idx);
            }
        }
        # ECMAScript: assignment expression result is the assigned value.
        self._push(si_val);
    }

    """TO_PROPERTY_KEY — coerce TOS to a property key exactly once (ES §7.1.19).
    Emitted by the compiler for a computed member key that is read then written
    (`base[prop] op= v`, `base[prop]++`) so `prop`'s ToPrimitive runs a single time.
    Replaces TOS with the resolved primitive key (a Symbol JSValue or an interned
    String JSValue); the following GET_INDEX/SET_INDEX re-coerce is then a no-op."""
    def _op_to_property_key(frame: CallFrame, ins: Instruction, st: ExecState) -> None {
        tpk_v: JSValue = self._pop();
        # Canonical array indices stay int32: every downstream consumer
        # (GET_INDEX/SET_INDEX/HAS_PROP/DEL/SUPER_*) coerces via
        # jsval_to_prop_key, which interns str(i) — the observable result is
        # identical — while the dense-elements fast paths keep their integer
        # form instead of paying a string mint + re-parse per access. No
        # observable coercion applies to a number primitive (ToPropertyKey on
        # a Number runs no user code), so skipping _to_property_key is safe.
        if jsv_is_int32(tpk_v) and jsv_to_int32(tpk_v) >= 0 {
            self._push(tpk_v);
            return;
        }
        tpk_id: int = self._to_property_key(tpk_v, frame, st);
        if self._coerce_diverted {
            return;
        }
        self._push(_vm_key_id_to_jsvalue(tpk_id));
    }

    def _op_has_prop(frame: CallFrame, ins: Instruction, st: ExecState) {
        hp_k: JSValue = self._pop();
        hp_o: JSValue = self._pop();
        hp_pk: int = jsval_to_prop_key(hp_k);
        if js_is_proxy(hp_o) {
            hp_h: bool = proxy_trap_has(self, hp_o, hp_pk);
            hp_exc_unwound: bool = False;
            if vm_has_native_exc() {
                exc_hp: JSValue = vm_take_native_exc();
                if self._unwind_in_frame(frame, exc_hp) {
                    hp_exc_unwound = True;
                } else {
                    self.had_exception = True;
                    self.pending_exc = exc_hp;
                    st.running = False;
                }
            }
            if not hp_exc_unwound {
                self._push(js_boolean(hp_h));
            }
        } else {
            self._push(js_boolean(self.obs_has(hp_o, hp_pk)));
        }
    }

    # Returns True when `src` still uses its *default* @@iterator (so the array /
    # Map / Set fast paths in _op_get_iter are safe). Returns False when user code
    # has overridden Symbol.iterator — via a proto/own accessor (poisoned getter)
    # or by replacing the data value with a non-default function — so the generic
    # custom-iterator branch must run instead (and observe any throw).
    # Does NOT invoke any getter (cheap; the generic branch does the actual call).
    def _has_default_iter(src: JSValue) -> bool {
        if not jsv_is_object_cell(src) {
            return True;
        }
        # An array whose only own named property is `length` (the plain-array
        # shape) has no own @@iterator, so Array.prototype's slot decides —
        # cached while Array.prototype keeps the shape and @@iterator value
        # it had when the default was last confirmed (any redefinition moves
        # one or the other).
        if _HDI_ARR_SHAPE > 0
            and js_object_ic_shape(src) == _HDI_ARR_SHAPE
            and js_is_array(src) {
            hdi_ap0: JSValue = js_array_get_proto();
            if jsv_is_object_cell(hdi_ap0)
                and js_object_ic_shape(hdi_ap0) == _HDI_AP_SHAPE
                and js_object_slot_at_id(jsv_to_table_id(hdi_ap0), _HDI_AP_SLOT)
                    == _HDI_AP_FN {
                return True;
            }
        }
        hdi_key: int = SYMBOL_KEY_BASE + SYMBOL_ITERATOR;
        # An @@iterator accessor on the source itself (a poisoned getter) is always
        # an override — route to the generic branch so its getter runs and can throw.
        if not jsv_is_undefined(js_object_lookup_getter(src, hdi_key)) {
            return False;
        }
        # An OWN @@iterator that is any callable (`o[Symbol.iterator]=fn`) is an
        # override too. Use spec_is_callable, not is_fn_val: a GENERATOR / async
        # function value is callable but is NOT is_fn_val, so a generator override
        # (`arr[Symbol.iterator]=function*(){}`) slipped through and the array fast
        # path ignored it (test262 dstr/*-iter-val-array-prototype).
        if js_object_has_own(src, hdi_key) {
            hdi_own: JSValue = js_object_get(src, hdi_key);
            if spec_is_callable(hdi_own) {
                return False;
            }
        }
        # Arrays are created null-proto (perf), so their @@iterator isn't reachable
        # via the normal chain — the fast path normally just *assumes* the default.
        # But user code can `delete`/replace `Array.prototype[Symbol.iterator]`; honour
        # that by consulting the live Array.prototype slot. If it's been removed
        # (deleted) or replaced with an accessor / non-default value, divert to the
        # generic branch (which then either calls the override or throws "not
        # iterable" when the slot is gone).
        if js_is_array(src) {
            ap: JSValue = js_array_get_proto();
            if jsv_is_object_cell(ap) {
                if not jsv_is_undefined(js_object_lookup_getter(ap, hdi_key)) {
                    return False;
                }
                if not js_object_has_own(ap, hdi_key) {
                    return False;
                }
                ap_it: JSValue = js_object_get(ap, hdi_key);
                if not is_native_val(ap_it) {
                    return False;
                }
                # R15: default @@iterator is Array.prototype.values (NATIVE_KIND_ARRAY_VALUES).
                if get_native_kind(ap_it) != NATIVE_KIND_ARRAY_VALUES {
                    return False;
                }
                # Default confirmed: remember where it lives (see the cache above).
                hdi_aps: int = js_object_ic_shape(ap);
                if hdi_aps >= 0 {
                    hdi_pk: int = shape_lookup(hdi_aps, hdi_key);
                    if hdi_pk >= 0 and (hdi_pk & SHAPE_ATTR_ACCESSOR) == 0 {
                        _HDI_AP_SHAPE = hdi_aps;
                        _HDI_AP_SLOT = hdi_pk // 16;
                        _HDI_AP_FN = ap_it;
                    }
                }
                if _HDI_ARR_SHAPE < 0 {
                    _HDI_ARR_SHAPE = js_object_ic_shape(js_array_create([]));
                }
            }
        }
        return True;
    }

    def _op_get_iter(frame: CallFrame, ins: Instruction, st: ExecState) -> None {
        # Build an iterator object: { __I: source_array, __J: int(0) }
        gi_src: JSValue = self._pop();
        if jsv_is_null(gi_src) or jsv_is_undefined(gi_src) {
            if ins.arg == 1 {
                # for...in null/undefined: zero iterations (no TypeError)
                gi_empty: JSValue = js_object_create_null();
                js_object_set(gi_empty, WK_I, js_array_create([]));
                js_object_set(gi_empty, WK_J, js_int(0));
                self._push(gi_empty);
                return;
            }
            gi_tn: str = "null";
            if jsv_is_undefined(gi_src) {
                gi_tn = "undefined";
            }
            exc_gi: JSValue = make_type_error(gi_tn + " is not iterable");
            if not self._unwind_in_frame(frame, exc_gi) {
                self.had_exception = True;
                self.pending_exc = exc_gi;
                st.running = False;
            }
            return;
        }
        # Fast paths (array/string/Map/Set/generator) assume the *default* iterator.
        # If user code has overridden `Symbol.iterator` (own property, or replaced /
        # poisoned the prototype's accessor), honour it via the generic custom-iterator
        # branch below so the override (and any throw it raises) is observed.
        # for...in (arg == 1) never consults Symbol.iterator, so it keeps its fast path.
        gi_use_fast: bool = ins.arg == 1 or self._has_default_iter(gi_src);
        src_arr: JSValue = js_undefined();
        if gi_use_fast and jsv_is_object_cell(gi_src) and js_is_array(gi_src) {
            if ins.arg == 1 {
                # for...in key mode: enumerable own keys in spec order (indices, strings).
                gi_kid_list: list[int] = object_enumerable_own_key_ids_ordered(gi_src);
                gi_kidxs: list[JSValue] = [];
                for gi_kid in gi_kid_list {
                    if gi_kid >= SYMBOL_KEY_BASE {
                        continue;
                    }
                    # Not "" and not a "__"-prefixed engine key (a bare "__" is
                    # an ordinary key: the old test needed more than two chars).
                    if not str_id_is_empty_or_dunder(gi_kid)
                        or str_from_id(gi_kid) == "__" {
                        gi_kidxs.append(jsv_from_string_id(gi_kid));
                    }
                }
                src_arr = js_array_create(gi_kidxs);
            } else {
                # for...of value mode: iterate array elements directly
                src_arr = gi_src;
            }
        } elif jsv_is_string_cell(gi_src) {
            # String — iterate Unicode code points (ES StringIterator / AdvanceStringIndex unicode)
            gi_s: str = str_from_id(jsv_to_table_id(gi_src));
            gi_chars: list[JSValue] = [];
            gi_scalars: list[int] = utf16_units_to_scalars(js_string_utf16_units(gi_s));
            for gi_cp in gi_scalars {
                gi_chars.append(
                    jsv_from_string_id(str_intern(utf8_encode_scalar(gi_cp)))
                );
            }
            src_arr = js_array_create(gi_chars);
        } elif gi_use_fast and jsv_is_object_cell(gi_src) and js_is_map(gi_src) {
            # Live Map iterator (entries) — wrap with WK_CUSTOM so ITER_NEXT calls .next().
            gi_map_live: JSValue = js_make_map_iterator(
                gi_src, MAP_SET_ITER_KIND_ENTRY
            );
            gi_map_wrap: JSValue = js_object_create_null();
            js_object_set(gi_map_wrap, WK_I, js_array_create([]));
            js_object_set(gi_map_wrap, WK_J, js_int(0));
            js_object_set(gi_map_wrap, WK_CUSTOM, gi_map_live);
            self._push(gi_map_wrap);
            src_arr = js_undefined();
        } elif gi_use_fast and jsv_is_object_cell(gi_src) and js_is_set(gi_src) {
            # Live Set iterator (values) — wrap with WK_CUSTOM.
            gi_set_live: JSValue = js_make_set_iterator(
                gi_src, MAP_SET_ITER_KIND_VALUE
            );
            gi_set_wrap: JSValue = js_object_create_null();
            js_object_set(gi_set_wrap, WK_I, js_array_create([]));
            js_object_set(gi_set_wrap, WK_J, js_int(0));
            js_object_set(gi_set_wrap, WK_CUSTOM, gi_set_live);
            self._push(gi_set_wrap);
            src_arr = js_undefined();
        } elif gi_use_fast
            and jsv_is_object_cell(gi_src)
            and js_object_has_own(gi_src, _KEY_IS_ARGUMENTS) {
            # `arguments` exotic object with the default @@iterator: iterate its indexed
            # values (0..length-1) into a plain `{__I,__J}` iterator, like an array.
            if ins.arg == 1 {
                # for...in key mode: enumerable own keys (mapped indices + generic props).
                gi_arg_kids: list[int] = object_enumerable_own_key_ids_ordered(gi_src);
                gi_arg_keys: list[JSValue] = [];
                for gi_akid in gi_arg_kids {
                    if gi_akid >= SYMBOL_KEY_BASE {
                        continue;
                    }
                    gi_aks: str = str_from_id(gi_akid);
                    if gi_aks != ""
                        and not (
                            len(gi_aks) > 2 and str_substr(gi_aks, 0, 2) == "__"
                        ) {
                        gi_arg_keys.append(jsv_from_string_id(gi_akid));
                    }
                }
                src_arr = js_array_create(gi_arg_keys);
            } else {
                # for..of value mode: build a *live* iterator over the arguments object
                # rather than snapshotting values. For a *mapped* arguments object the
                # indexed slots alias the formal parameters, so mutating a parameter mid-
                # loop must be reflected in subsequent iterations (ES §10.4.4, test
                # for-of/arguments-mapped-aliasing). Store the arguments object itself in
                # __I and flag the iterator so ITER_NEXT reads arguments[idx] live.
                gi_args_iter: JSValue = js_object_create_null();
                js_object_set(gi_args_iter, WK_I, gi_src);
                js_object_set(gi_args_iter, WK_J, js_int(0));
                js_object_set(gi_args_iter, _KEY_IS_ARGUMENTS, js_true());
                self._push(gi_args_iter);
                src_arr = js_undefined();  # signal: already pushed
            }
        } elif jsv_is_object_cell(gi_src) and js_is_generator(gi_src) {
            # Generator: wrap with __GEN so ITER_NEXT can drive it
            gi_gen_wrap: JSValue = js_object_create_null();
            js_object_set(gi_gen_wrap, WK_I, js_array_create([]));
            js_object_set(gi_gen_wrap, WK_J, js_int(0));
            js_object_set(gi_gen_wrap, WK_GEN, gi_src);
            self._push(gi_gen_wrap);
            src_arr = js_undefined();  # signal: already pushed
        } elif jsv_is_object_cell(gi_src) {
            # for...in (arg == 1) must NEVER consult Symbol.iterator (ES EnumerateObjectProperties).
            # Objects like %TypedArray%.prototype install @@iterator (= values) which would throw
            # "incompatible receiver" if invoked with `this` = the prototype during for-in.
            if ins.arg == 1 {
                # for...in: iterate enumerable string keys (exclude symbol keys).
                # Must include enumerable accessors (Object.keys / for-in parity).
                # EnumerateObjectProperties obtains attributes via [[GetOwnProperty]]
                # (module-namespace TDZ bindings throw ReferenceError here).
                gi_keys: list[JSValue] = [];
                gi_seen: set[int] = set();
                gi_cur: JSValue = gi_src;
                gi_depth: int = 0;
                while jsv_is_object_cell(gi_cur) and gi_depth < 1000 {
                    gi_kids: list[int] = [];
                    if js_is_proxy(gi_cur) {
                        gi_kids = _vm_enumerable_own_key_ids_ordered(self, gi_cur);
                    } else {
                        gi_kids = object_enumerable_own_key_ids_ordered(gi_cur);
                    }
                    gi_ki: int = 0;
                    gi_kn: int = len(gi_kids);
                    gi_is_ns: bool = js_is_module_namespace(gi_cur);
                    while gi_ki < gi_kn {
                        gi_kid: int = gi_kids[gi_ki];
                        # Skip symbol-keyed, hidden array marker, already-seen keys
                        if gi_kid < SYMBOL_KEY_BASE
                            and gi_kid != _KEY_IS_ARRAY
                            and not (gi_kid in gi_seen) {
                            # Skip internal engine markers (double-underscore prefix;
                            # the per-id key class, no text needed for other keys)
                            if not str_id_is_empty_or_dunder(gi_kid)
                                or str_from_id(gi_kid) == "__" {
                                if gi_is_ns {
                                    gi_desc: JSValue = _vm_module_namespace_gopd(
                                        self, gi_cur, jsv_from_string_id(gi_kid)
                                    );
                                    if self.had_exception or vm_has_native_exc() {
                                        gi_ns_exc: JSValue = self.pending_exc;
                                        if vm_has_native_exc() {
                                            gi_ns_exc = vm_take_native_exc();
                                        }
                                        self.had_exception = False;
                                        self.pending_exc = js_undefined();
                                        if not self._unwind_in_frame(
                                            frame, gi_ns_exc
                                        ) {
                                            self.had_exception = True;
                                            self.pending_exc = gi_ns_exc;
                                            st.running = False;
                                        }
                                        return;
                                    }
                                    if jsv_is_undefined(gi_desc) {
                                        gi_ki = gi_ki + 1;
                                        continue;
                                    }
                                    gi_ev: JSValue = js_object_get(
                                        gi_desc, str_intern("enumerable")
                                    );
                                    if not jsv_coerce_to_bool(gi_ev) {
                                        gi_ki = gi_ki + 1;
                                        continue;
                                    }
                                }
                                gi_keys.append(jsv_from_string_id(gi_kid));
                                gi_seen.add(gi_kid);
                            }
                        }
                        gi_ki = gi_ki + 1;
                    }
                    # ES EnumerateObjectProperties: a key already seen on a NEARER object shadows
                    # the same key on a prototype — REGARDLESS of enumerability. So after collecting
                    # this level's enumerable keys, mark ALL of its own keys (incl. non-enumerable)
                    # as seen, so a proto's enumerable key with the same name is skipped (test262
                    # for-in/order-enumerable-shadowed: own non-enumerable `p2` hides proto `p2`).
                    # (Nothing to shadow when there is no next level — a
                    # null-prototype dictionary, the common for-in receiver.)
                    if js_is_proxy(gi_cur) {
                        gi_cur = _vm_proxy_get_prototype_of(self, gi_cur);
                        if vm_has_native_exc() {
                            gi_cur = js_null();
                        }
                    } else {
                        gi_next: JSValue = js_object_get_prototype(gi_cur);
                        if jsv_is_object_cell(gi_next) {
                            for gi_all_kid in js_object_own_key_ids_ordered(gi_cur) {
                                if gi_all_kid < SYMBOL_KEY_BASE {
                                    gi_seen.add(gi_all_kid);
                                }
                            }
                        }
                        gi_cur = gi_next;
                    }
                    gi_depth = gi_depth + 1;
                }
                src_arr = js_array_create(gi_keys);
            } else {
                # for...of / GetIterator: Check for custom Symbol.iterator method.
                # Use the accessor-aware getter so a poisoned `Symbol.iterator` getter
                # (`Object.defineProperty(o, Symbol.iterator, {get(){throw}})`) actually
                # runs and its throw is observed (ES GetIterator → GetMethod).
                gi_sym_iter_key: int = SYMBOL_KEY_BASE + SYMBOL_ITERATOR;
                gi_sym_fn: JSValue = self._get_prop_accessor(gi_src, gi_sym_iter_key);
                if vm_has_native_exc() {
                    # The @@iterator getter threw a native error — propagate.
                    gi_ge_nexc: JSValue = vm_take_native_exc();
                    if not self._unwind_in_frame(frame, gi_ge_nexc) {
                        self.had_exception = True;
                        self.pending_exc = gi_ge_nexc;
                        st.running = False;
                    }
                    return;
                } elif self.had_exception {
                    # The @@iterator getter threw — propagate (don't continue with garbage).
                    gi_ge_exc: JSValue = self.pending_exc;
                    self.had_exception = False;
                    self.pending_exc = js_undefined();
                    if not self._unwind_in_frame(frame, gi_ge_exc) {
                        self.had_exception = True;
                        self.pending_exc = gi_ge_exc;
                        st.running = False;
                    }
                    return;
                }
                if is_fn_val(gi_sym_fn) {
                    # Call obj[Symbol.iterator]() to get the iterator object. Use
                    # _invoke_callable_value (not run_cl): a GENERATOR @@iterator must return a
                    # fresh generator OBJECT without executing its body — run_cl runs the body
                    # to completion, yielding an empty iteration (test262
                    # dstr/*-iter-val-array-prototype). _invoke_callable_value builds the
                    # generator object for is_generator closures.
                    gi_user_iter: JSValue = self._invoke_callable_value(
                        gi_sym_fn, gi_src, []
                    );
                    if self.had_exception {
                        # The @@iterator call threw — propagate it.
                        gi_ce_exc: JSValue = self.pending_exc;
                        self.had_exception = False;
                        self.pending_exc = js_undefined();
                        if not self._unwind_in_frame(frame, gi_ce_exc) {
                            self.had_exception = True;
                            self.pending_exc = gi_ce_exc;
                            st.running = False;
                        }
                        return;
                    }
                    # If @@iterator returned a GENERATOR object (the common case:
                    # `[Symbol.iterator]=function*(){…}`), drive it via the WK_GEN generator
                    # machinery — a generator's `.next()` needs VM-reentry resumption, which the
                    # plain WK_CUSTOM `.next()` call path does not perform (it observed zero
                    # iterations). test262 dstr/*-iter-val-array-prototype.
                    gi_iter_wrap: JSValue = js_object_create_null();
                    js_object_set(gi_iter_wrap, WK_I, js_array_create([]));
                    js_object_set(gi_iter_wrap, WK_J, js_int(0));
                    if jsv_is_object_cell(gi_user_iter)
                        and js_is_generator(gi_user_iter) {
                        js_object_set(gi_iter_wrap, WK_GEN, gi_user_iter);
                    } else {
                        # Wrap with __CUSTOM flag so ITER_NEXT delegates to user .next()
                        js_object_set(gi_iter_wrap, WK_CUSTOM, gi_user_iter);
                        # ES §7.4.1 GetIterator step 5: read `next` ONCE now (observably, accessor-
                        # aware) and cache it — ITER_NEXT must NOT re-read it each iteration (test262
                        # for-of/iterator-next-reference). A throwing `next` getter propagates here.
                        self._iter_cache_next(frame, st, gi_iter_wrap, gi_user_iter);
                        if self.had_exception or vm_has_native_exc() {
                            gi_nx_exc: JSValue = self.pending_exc;
                            if vm_has_native_exc() {
                                gi_nx_exc = vm_take_native_exc();
                            }
                            self.had_exception = False;
                            self.pending_exc = js_undefined();
                            if not self._unwind_in_frame(frame, gi_nx_exc) {
                                self.had_exception = True;
                                self.pending_exc = gi_nx_exc;
                                st.running = False;
                            }
                            return;
                        }
                    }
                    self._push(gi_iter_wrap);
                    src_arr = js_undefined();  # signal: we already pushed, skip standard push
                } elif is_native_val(gi_sym_fn) {
                    # Native Symbol.iterator (e.g. RegExp matchAll iterator).
                    # Call it with this_val = gi_src to get the iterator object.
                    gi_nat_iter: JSValue = _vm_call_native_proxy_aware(
                        self, self.realm, get_native_kind(gi_sym_fn), gi_src, []
                    );
                    if vm_has_native_exc() {
                        gi_ne_nexc: JSValue = vm_take_native_exc();
                        if not self._unwind_in_frame(frame, gi_ne_nexc) {
                            self.had_exception = True;
                            self.pending_exc = gi_ne_nexc;
                            st.running = False;
                        }
                        return;
                    } elif self.had_exception {
                        gi_ne_exc: JSValue = self.pending_exc;
                        self.had_exception = False;
                        self.pending_exc = js_undefined();
                        if not self._unwind_in_frame(frame, gi_ne_exc) {
                            self.had_exception = True;
                            self.pending_exc = gi_ne_exc;
                            st.running = False;
                        }
                        return;
                    }
                    # Wrap with __CUSTOM so ITER_NEXT delegates to the iterator's .next()
                    # (or __GEN when the native @@iterator returned a generator object).
                    gi_nat_wrap: JSValue = js_object_create_null();
                    js_object_set(gi_nat_wrap, WK_I, js_array_create([]));
                    js_object_set(gi_nat_wrap, WK_J, js_int(0));
                    if jsv_is_object_cell(gi_nat_iter)
                        and js_is_generator(gi_nat_iter) {
                        js_object_set(gi_nat_wrap, WK_GEN, gi_nat_iter);
                    } else {
                        js_object_set(gi_nat_wrap, WK_CUSTOM, gi_nat_iter);
                    }
                    self._push(gi_nat_wrap);
                    src_arr = js_undefined();  # signal: we already pushed, skip standard push
                } elif js_object_has_own(gi_src, WK_I)
                    and js_object_has_own(gi_src, WK_J) {
                    # Object is already an internal {__I,__J} iterator (e.g. from arr.values())
                    self._push(gi_src);
                    src_arr = js_undefined();  # signal: already pushed
                } else {
                    # for...of: check if object has a .next() method (iterator without @@iterator)
                    gi_next_fn: JSValue = js_object_get(gi_src, WK_NEXT);
                    if is_fn_val(gi_next_fn) or is_native_val(gi_next_fn) {
                        # Treat as user iterator (lenient iterator protocol)
                        gi_lax_wrap: JSValue = js_object_create_null();
                        js_object_set(gi_lax_wrap, WK_I, js_array_create([]));
                        js_object_set(gi_lax_wrap, WK_J, js_int(0));
                        js_object_set(gi_lax_wrap, WK_CUSTOM, gi_src);
                        self._push(gi_lax_wrap);
                        src_arr = js_undefined();
                    } else {
                        # for...of: object is not iterable (no @@iterator) — throw TypeError
                        if not self._unwind_in_frame(
                            frame, make_type_error("object is not iterable")
                        ) {
                            self.had_exception = True;
                            self.pending_exc = make_type_error(
                                "object is not iterable"
                            );
                            st.running = False;
                        }
                        src_arr = js_undefined();
                    }
                }
            }
        } else {
            # Non-object, non-string primitive (number / boolean / symbol / bigint).
            # for...of and array destructuring (arg == 0) call GetIterator, which looks
            # up @@iterator on the boxed primitive — number/boolean/symbol/bigint have
            # none → TypeError (ES §7.4.1). `[] = 1`, `[,] = true`, `[a] = Symbol()`.
            # for...in (arg == 1) over a primitive iterates zero own enumerable keys.
            if ins.arg == 0 {
                gi_prim_exc: JSValue = make_type_error("value is not iterable");
                if not self._unwind_in_frame(frame, gi_prim_exc) {
                    self.had_exception = True;
                    self.pending_exc = gi_prim_exc;
                    st.running = False;
                }
                src_arr = js_undefined();  # signal: handled (nothing to push)
            } else {
                src_arr = js_array_create([]);
            }
        }
        # Build standard iterator {__I, __J} — skip if custom iterator already pushed
        if not jsv_is_undefined(src_arr) {
            if _ITER_STD_SHAPE > 0 and _ITER_STD_I == 0 and _ITER_STD_J == 1 {
                # Born at the learned {__I, __J} shape: no two property adds.
                self._push(
                    js_object_new_shaped2(-1, _ITER_STD_SHAPE, src_arr, js_int(0))
                );
            } else {
                gi_iter: JSValue = js_object_create_null();
                js_object_set(gi_iter, WK_I, src_arr);
                js_object_set(gi_iter, WK_J, js_int(0));
                if _ITER_STD_SHAPE < 0 {
                    _iter_std_learn(gi_iter);
                }
                self._push(gi_iter);
            }
        }
    }

    # RequireObjectCoercible(TOS) — ES §7.2.1. Throws TypeError if the value on
    # top of the stack is null or undefined; otherwise leaves it untouched.
    # Used to guard object-pattern destructuring of `null`/`undefined`
    # (e.g. `var {a} = null;`, `function f({}){} f(undefined)`).
    def _op_require_coercible(frame: CallFrame, ins: Instruction, st: ExecState) {
        rc_src: JSValue = self._peek();
        if jsv_is_null(rc_src) or jsv_is_undefined(rc_src) {
            rc_tn: str = "null";
            if jsv_is_undefined(rc_src) {
                rc_tn = "undefined";
            }
            rc_exc: JSValue = make_type_error(
                "Cannot destructure '" + rc_tn + "' as it is " + rc_tn + "."
            );
            if not self._unwind_in_frame(frame, rc_exc) {
                self.had_exception = True;
                self.pending_exc = rc_exc;
                st.running = False;
            }
        }
    }

    """Given a mangled private key id (`__priv_#name@<sid>`), return the interned id of
    its per-instance brand marker (`__brand@<sid>`), or -1 if the key carries no
    scope suffix (a legacy bare `__priv_#name`)."""
    def _priv_brand_key_for(key: int) -> int {
        ks: str = str_from_id(key);
        kn: int = len(ks);
        ai: int = 0;
        while ai < kn {
            if ks[ai] == "@" {
                return str_intern("__brand" + ks[ai:kn]);
            }
            ai = ai + 1;
        }
        return -1;
    }

    """The class SCOPE id (`@<sid>`) embedded in a mangled private key `__priv_#name@<sid>`,
    or -1 if the key carries no numeric scope suffix (a legacy bare `__priv_#name`)."""
    def _priv_key_sid(key: int) -> int {
        pks_s: str = str_from_id(key);
        pks_n: int = len(pks_s);
        pks_i: int = 0;
        while pks_i < pks_n {
            if pks_s[pks_i] == "@" {
                pks_suf: str = pks_s[pks_i + 1:pks_n];
                if len(pks_suf) == 0 {
                    return -1;
                }
                pks_j: int = 0;
                while pks_j < len(pks_suf) {
                    if pks_suf[pks_j] < "0" or pks_suf[pks_j] > "9" {
                        return -1;
                    }
                    pks_j = pks_j + 1;
                }
                return int(pks_suf);
            }
            pks_i = pks_i + 1;
        }
        return -1;
    }

    def _has_private_brand(
        pobj: JSValue, key: int, acc_brand: JSValue, acc_sid: int
    ) -> bool {
        if not jsv_is_object_cell(pobj) {
            return False;
        }
        # (1) Reachability (legacy presence): is this private member reachable on pobj?
        # A private FIELD is an OWN data property; a private METHOD/ACCESSOR lives on the
        # prototype and requires the per-instance brand marker (`__brand@<sid>`, installed at
        # field-init → after super() for a derived class), so `this.#m()` before super()
        # throws (ES §13.15.5 / §15.7.11).
        hpb_present: bool = False;
        if js_object_has_own(pobj, key) {
            hpb_present = True;
        } else {
            pb_is_method: bool = js_object_has(pobj, key);
            pb_is_accessor: bool = (
                not jsv_is_undefined(js_object_lookup_getter(pobj, key))
            )
                or (not jsv_is_undefined(js_object_lookup_setter(pobj, key)));
            if pb_is_method or pb_is_accessor {
                pb_brand: int = self._priv_brand_key_for(key);
                if pb_brand >= 0 {
                    hpb_present = js_object_has_own(pobj, pb_brand);
                } else {
                    hpb_present = True;  # legacy bare key → reachability only
                }
            }
        }
        if not hpb_present {
            return False;
        }
        # (2) Per-EVALUATION brand check (ES §6.2.12 / §15.7): the object must carry the SAME
        # per-evaluation brand as the accessing method — an object created by a DIFFERENT
        # evaluation of the same class source is rejected. Skipped (lenient) when the
        # accessing method carries no brand (acc_brand==0 → non-class caller / legacy), the
        # key has no scope suffix (legacy bare key), or pobj lacks the brand marker entirely
        # (never newly reject an object the legacy path accepted).
        if acc_brand == js_int(0) {
            return True;
        }
        # Enforce the per-eval brand ONLY when the private being accessed is the accessing
        # class's OWN — i.e. the key's scope id matches the accessing closure's class sid.
        # An OUTER class's private accessed from a NESTED class (different sid) carries the
        # nested class's brand, not this private name's, so the value-compare would spuriously
        # reject it; fall back to lenient presence there (ES §6.2.12 lexical PrivateEnvironment).
        hpb_key_sid: int = self._priv_key_sid(key);
        if hpb_key_sid < 0 or hpb_key_sid != acc_sid {
            return True;
        }
        hpb_bkey: int = self._priv_brand_key_for(key);
        if hpb_bkey < 0 {
            return True;
        }
        if not js_object_has_own(pobj, hpb_bkey) {
            return True;
        }
        hpb_ov: JSValue = js_object_get(pobj, hpb_bkey);
        return hpb_ov == acc_brand;
    }

    def _op_check_private(frame: CallFrame, ins: Instruction, st: ExecState) -> None {
        # Private brand check (ES §13.15.5 — PrivateFieldGet / PrivateMethodOrAccessorGet /
        # PrivateSet).
        # arg   = interned mangled private key (`__priv_#name`)
        # arg2  = 0 → GET guard: peek object; TypeError if it lacks the brand, or the
        #             member is a setter-only accessor (no getter)
        #         1 → membership test for `#name in obj`: pop object, push boolean
        #         2 → SET guard: peek object; TypeError if it lacks the brand, or the
        #             member is a getter-only accessor (no setter) or a private method
        # Cache intern id in arg3 (arg2 is the private-access mode).
        cp_key: int = ins.arg3;
        if cp_key == 0 {
            cp_key = str_intern(frame.func.constants.get(ins.arg));
            cp_pip: int = frame.ip - 1;
            if cp_pip >= 0 and cp_pip < len(frame.func.code) {
                cp_old: Instruction = frame.func.code[cp_pip];
                cp_old.arg3 = cp_key;
                cp_old.ic_epoch = 0;
            }
        }
        cp_mode: int = ins.arg2;
        # The accessing closure's per-eval brand AND the class scope-id it belongs to
        # (inherited by nested functions/arrows). The sid gates the value-compare so an
        # outer class's private accessed from a nested class isn't spuriously rejected.
        cp_acc_brand: JSValue = js_int(0);
        cp_acc_sid: int = 0;
        # Home realm of the accessing method: a brand-check TypeError it throws must be
        # constructed from THIS realm's %TypeError% (cross-realm test262 brand-check tests).
        cp_home_realm: int = 0;
        if is_fn_val(frame.self_fn) {
            cp_acc_cl: JSClosure = self.realm.closures[get_fn_idx(frame.self_fn)];
            cp_acc_brand = cp_acc_cl.class_brand;
            cp_acc_sid = cp_acc_cl.class_brand_sid;
            cp_home_realm = cp_acc_cl.home_realm_id;
        }
        if cp_mode == 1 {
            cp_obj_in: JSValue = self._pop();
            cp_has_in: bool = self._has_private_brand(
                cp_obj_in, cp_key, cp_acc_brand, cp_acc_sid
            );
            self._push(js_boolean(cp_has_in));
            return;
        }
        cp_obj: JSValue = self._peek();
        cp_present: bool = self._has_private_brand(
            cp_obj, cp_key, cp_acc_brand, cp_acc_sid
        );
        cp_name: str = frame.func.constants.get(ins.arg);
        if len(cp_name) > 7 and cp_name[0:7] == "__priv_" {
            cp_name = cp_name[7:];
        }
        # Strip the per-class scope suffix `@<id>` so the message shows the raw `#name`
        # (an identifier can't contain `@`, so the first one delimits the suffix).
        cp_ai: int = 0;
        cp_nlen: int = len(cp_name);
        while cp_ai < cp_nlen {
            if cp_name[cp_ai] == "@" {
                cp_name = cp_name[0:cp_ai];
                break;
            }
            cp_ai = cp_ai + 1;
        }
        cp_err: str = "";
        if not cp_present {
            cp_err = "Cannot "
                + ("write" if cp_mode == 2 else "read")
                + " private member "
                + cp_name
                + " from an object whose class did not declare it";
        } elif jsv_is_object_cell(cp_obj) {
            cp_getter: JSValue = js_object_lookup_getter(cp_obj, cp_key);
            cp_setter: JSValue = js_object_lookup_setter(cp_obj, cp_key);
            cp_is_accessor: bool = (not jsv_is_undefined(cp_getter))
                or (not jsv_is_undefined(cp_setter));
            if cp_mode == 2 {
                # PrivateSet: accessor must have a setter; a private method is not
                # a valid assignment target either.
                if cp_is_accessor {
                    if jsv_is_undefined(cp_setter) {
                        cp_err = "Cannot write private member "
                            + cp_name
                            + " to an accessor without a setter";
                    }
                } else {
                    cp_pv: JSValue = js_object_get(cp_obj, cp_key);
                    if is_fn_val(cp_pv) or is_native_val(cp_pv) {
                        # Private method (installed as a function on the prototype) —
                        # methods are read-only brand entries.
                        cp_err = "Cannot write private member "
                            + cp_name
                            + " — it is a method";
                    }
                }
            } else {
                # PrivateGet: a setter-only accessor has no getter.
                if cp_is_accessor and jsv_is_undefined(cp_getter) {
                    cp_err = "Cannot read private member "
                        + cp_name
                        + " from an accessor without a getter";
                }
            }
        }
        if cp_err != "" {
            cp_exc: JSValue = _make_type_error_in_realm(cp_home_realm, cp_err);
            if not self._unwind_in_frame(frame, cp_exc) {
                self.had_exception = True;
                self.pending_exc = cp_exc;
                st.running = False;
            }
        }
    }

    """If a pending exception exists (VM had_exception OR the native-exception
    channel), unwind it into `frame` and return True — the caller must `return`.
    Used by ITER_NEXT so a throwing user `.next()` / `value` getter propagates
    instead of being swallowed (which loops the for-of forever → OOM)."""
    def _iter_next_unwind_if_exc(frame: CallFrame, st: ExecState) -> bool {
        ine_exc: JSValue = js_undefined();
        if vm_has_native_exc() {
            ine_exc = vm_take_native_exc();
        } elif self.had_exception {
            ine_exc = self.pending_exc;
            self.had_exception = False;
            self.pending_exc = js_undefined();
        } else {
            return False;
        }
        if not self._unwind_in_frame(frame, ine_exc) {
            self.had_exception = True;
            self.pending_exc = ine_exc;
            st.running = False;
        }
        return True;
    }

    """ES §7.4.1 GetIterator: read `iterator.next` ONCE (observably, accessor-aware) and
    cache it on the internal wrapper under WK_ITER_NEXT_FN so ITER_NEXT reuses it every step
    instead of re-reading (test262 for-of/iterator-next-reference)."""
    def _iter_cache_next(
        frame: CallFrame, st: ExecState, wrap: JSValue, user_iter: JSValue
    ) -> None {
        icn_next: JSValue = self.obs_get(user_iter, WK_NEXT, user_iter);
        if self.had_exception or vm_has_native_exc() {
            return;
        }
        js_object_set(wrap, WK_ITER_NEXT_FN, icn_next);
    }

    def _op_iter_next(frame: CallFrame, ins: Instruction, st: ExecState) -> None {
        # Peek (do NOT pop) iterator from TOS.
        # Push value + true if more; push false if done.
        in_iter: JSValue = self._peek();
        # ── Standard array iterator, by shape ────────────────────
        # An object of the standard iterator's shape has exactly {__I, __J}, so
        # the generator / custom / arguments probes below would all miss: read
        # and bump the slots directly (same js_array_len / js_array_get steps as
        # the standard path at the end). This was ~7 property operations per
        # for-of step over an array.
        if _ITER_STD_SHAPE > 0 and js_object_ic_shape(in_iter) == _ITER_STD_SHAPE {
            fi_id: int = jsv_to_table_id(in_iter);
            fi_j: JSValue = js_object_slot_at_id(fi_id, _ITER_STD_J);
            if jsv_is_int32(fi_j) {
                fi_idx: int = jsv_to_int32(fi_j);
                if fi_idx < js_array_len(js_object_slot_at_id(fi_id, _ITER_STD_I)) {
                    fi_val: JSValue = js_array_get(
                        js_object_slot_at_id(fi_id, _ITER_STD_I), fi_idx
                    );
                    js_object_slot_set_at_id(fi_id, _ITER_STD_J, js_int(fi_idx + 1));
                    self._push(fi_val);
                    self._push(js_true());
                } else {
                    self._push(js_false());
                }
                return;
            }
        }
        # ── Generator iterator ────────────────────────────────────
        in_gen: JSValue = js_object_get(in_iter, WK_GEN);
        if jsv_is_object_cell(in_gen) and js_is_generator(in_gen) {
            in_gen_res: JSValue = self.run_generator(
                in_gen, js_undefined(), False, False
            );
            if self.had_exception or vm_has_native_exc() {
                # ES §7.4.5 IteratorStep: an abrupt completion (throw) from the generator's next()
                # PROPAGATES out of the for-of — it must not be swallowed as "done" (test262
                # for-of/generator-next-error: `function*(){ throw … }` iterated → the throw
                # escapes with 0 iterations).
                in_gen_exc: JSValue = self.pending_exc;
                if vm_has_native_exc() {
                    in_gen_exc = vm_take_native_exc();
                }
                self.had_exception = False;
                self.pending_exc = js_undefined();
                if not self._unwind_in_frame(frame, in_gen_exc) {
                    self.had_exception = True;
                    self.pending_exc = in_gen_exc;
                    st.running = False;
                }
                return;
            } else {
                in_gen_done_v: JSValue = js_object_get(in_gen_res, WK_DONE);
                if jsv_to_bool(in_gen_done_v) {
                    self._push(js_false());
                } else {
                    in_gen_val: JSValue = js_object_get(in_gen_res, WK_VALUE);
                    self._push(in_gen_val);
                    self._push(js_true());
                }
            }
        } else {
            # ── Custom user iterator ──────────────────────────────────
            in_custom: JSValue = js_object_get(in_iter, WK_CUSTOM);
            if jsv_is_object_cell(in_custom) {
                # ES §7.4.1: use the `next` method CACHED at GetIterator (WK_ITER_NEXT_FN on the
                # wrapper) so it is not re-read each iteration (test262 iterator-next-reference). Fall
                # back to reading it off the iterator for lax paths that did not cache.
                in_next_fn: JSValue = js_object_get(in_iter, WK_ITER_NEXT_FN);
                if jsv_is_undefined(in_next_fn) {
                    in_next_fn = js_object_get(in_custom, WK_NEXT);
                }
                # Built-in Map/Set iterator driven by the built-in next: step it without
                # building a {value, done} object per element.
                if is_native_val(in_next_fn)
                    and get_native_kind(in_next_fn) == NATIVE_KIND_MAP_SET_ITER_NEXT {
                    in_ms_v: JSValue = jsv_hole();
                    in_ms_ok: bool = True;
                    if js_is_set_iterator(in_custom) {
                        in_ms_v = js_set_iterator_step(in_custom);
                    } elif js_is_map_iterator(in_custom) {
                        in_ms_v = js_map_iterator_step(in_custom);
                    } else {
                        in_ms_ok = False;
                    }
                    if in_ms_ok {
                        if jsv_is_hole(in_ms_v) {
                            self._push(js_false());
                        } else {
                            self._push(in_ms_v);
                            self._push(js_true());
                        }
                        return;
                    }
                }
                in_result: JSValue = js_undefined();
                if is_fn_val(in_next_fn) {
                    in_next_cl: JSClosure = self.realm.closures[get_fn_idx(in_next_fn)];
                    in_result = self.run(
                        in_next_cl.func, in_custom, [], in_next_cl.free_vals, in_next_fn
                    );
                } elif is_native_val(in_next_fn) {
                    in_result = _vm_call_native_proxy_aware(
                        self, self.realm, get_native_kind(in_next_fn), in_custom, []
                    );
                }
                # A throwing .next() must propagate (ES §7.4.8) — otherwise the for-of loop
                # spins forever (the getter/next keeps throwing each step). Unwind into the
                # frame; leaving the exception unhandled would loop → OOM.
                if self._iter_next_unwind_if_exc(frame, st) {
                    return;
                }
                # ES §7.4.8 IteratorNext step 3: if the result of next() is NOT an Object, throw a
                # TypeError (test262 for-of/iterator-next-result-type). Only when next() was actually
                # callable and returned a primitive (true/1/"x") or null — a non-callable next leaves
                # in_result undefined and is treated as done below (legacy behavior).
                if (is_fn_val(in_next_fn) or is_native_val(in_next_fn))
                    and not (
                        jsv_is_any_object(in_result)
                        or is_fn_val(in_result)
                        or is_native_val(in_result)
                        or js_is_proxy(in_result)
                    ) {
                    exc_inr: JSValue = make_type_error(
                        "Iterator result is not an object"
                    );
                    if not self._unwind_in_frame(frame, exc_inr) {
                        self.had_exception = True;
                        self.pending_exc = exc_inr;
                        st.running = False;
                    }
                    return;
                }
                if not jsv_is_undefined(in_result) {
                    # ES §7.4.3 IteratorComplete: read `done` accessor/proxy-aware (obs_get) — a `done`
                    # getter must run and a Proxy result must trap — then ToBoolean it (an object like
                    # `done:{}` is truthy → 0 iterations). js_object_get skipped accessors, so a `done`
                    # getter was missed and the loop over-ran (test262 iterator-next-result-done-attr).
                    in_done_v: JSValue = self.obs_get(in_result, WK_DONE, in_result);
                    if self._iter_next_unwind_if_exc(frame, st) {
                        return;
                    }
                    if jsv_coerce_to_bool(in_done_v) {
                        self._push(js_false());
                    } else {
                        # §7.4.4 IteratorValue: read `value` accessor/proxy-aware; a throwing getter
                        # propagates (js_object_get ignored accessors → throw lost, loop spun forever).
                        in_val_v: JSValue = self.obs_get(
                            in_result, WK_VALUE, in_result
                        );
                        if self._iter_next_unwind_if_exc(frame, st) {
                            return;
                        }
                        self._push(in_val_v);
                        self._push(js_true());
                    }
                } else {
                    self._push(js_false());
                }
            } else {
                # ── Standard internal iterator {__I, __J} ────────────
                in_src: JSValue = js_object_get(in_iter, WK_I);
                in_idx_v: JSValue = js_object_get(in_iter, WK_J);
                in_idx: int = 0;
                if jsv_is_int32(in_idx_v) {
                    in_idx = jsv_to_int32(in_idx_v);
                } elif jsv_is_double(in_idx_v) {
                    in_idx = int(jsv_to_double(in_idx_v));
                }
                # A *live* arguments iterator: __I holds the arguments object (not an array)
                # and each step reads arguments[idx] / arguments.length live so mapped-
                # parameter mutations are observed (ES §10.4.4).
                if js_object_has_own(in_iter, _KEY_IS_ARGUMENTS) {
                    in_alen_v: JSValue = js_object_get(in_src, WK_LENGTH);
                    in_alen: int = 0;
                    if jsv_is_int32(in_alen_v) {
                        in_alen = jsv_to_int32(in_alen_v);
                    } elif jsv_is_double(in_alen_v) {
                        in_alen = int(jsv_to_double(in_alen_v));
                    }
                    if in_idx < in_alen {
                        in_aval: JSValue = js_object_get(
                            in_src, str_intern_index(in_idx)
                        );
                        js_object_set(in_iter, WK_J, js_int(in_idx + 1));
                        self._push(in_aval);
                        self._push(js_true());
                    } else {
                        self._push(js_false());
                    }
                } else {
                    in_len: int = js_array_len(in_src);
                    if in_idx < in_len {
                        in_val: JSValue = js_array_get(in_src, in_idx);
                        # Advance index on iterator object
                        js_object_set(in_iter, WK_J, js_int(in_idx + 1));
                        self._push(in_val);
                        self._push(js_true());
                    } else {
                        self._push(js_false());
                    }
                }
            }
        }  # end else (non-generator iterator)

        # ── Arithmetic ────────────────────────────────────────────────
    }

    def _op_add(frame: CallFrame, ins: Instruction, st: ExecState) -> None {
        b_a: JSValue = self._pop();
        a_a: JSValue = self._pop();
        # ToPrimitive with hint "default" for `+` (then ToString/ToNumber).  A callable
        # (function) is not an object cell but is still a non-primitive that needs
        # ToPrimitive → Function.prototype.toString (so `"" + fn` is the source text).
        if jsv_is_object_cell(a_a) or is_fn_val(a_a) or is_native_val(a_a) {
            a_a = self._to_primitive_default(a_a);
            # ToPrimitive may abort via self.had_exception (VM throw) OR the native-exc
            # channel (a getter/valueOf/toString running through the native builtin
            # bridge). Both must stop before the RHS operand's ToPrimitive runs — else
            # `thrower + counter` (LHS @@toPrimitive getter throws) still evaluates the
            # RHS getter (test262 get-symbol-to-prim-err: callCount must stay 0).
            if self.had_exception or vm_has_native_exc() {
                exc_add_a: JSValue = vm_take_native_exc()
                    if vm_has_native_exc()
                    else self.pending_exc;
                self.had_exception = False;
                self.pending_exc = js_undefined();
                if not self._unwind_in_frame(frame, exc_add_a) {
                    self.had_exception = True;
                    self.pending_exc = exc_add_a;
                    st.running = False;
                }
                return;
            }
        }
        if jsv_is_object_cell(b_a) or is_fn_val(b_a) or is_native_val(b_a) {
            b_a = self._to_primitive_default(b_a);
            if self.had_exception or vm_has_native_exc() {
                exc_add_b: JSValue = vm_take_native_exc()
                    if vm_has_native_exc()
                    else self.pending_exc;
                self.had_exception = False;
                self.pending_exc = js_undefined();
                if not self._unwind_in_frame(frame, exc_add_b) {
                    self.had_exception = True;
                    self.pending_exc = exc_add_b;
                    st.running = False;
                }
                return;
            }
        }
        # ES §13.15.3 ApplyStringOrNumericBinaryOperator: after both operands are
        # primitives, a Symbol operand always throws — either the other operand is a
        # String and ToString(Symbol) throws (§7.1.17), or ToNumeric(Symbol) throws
        # (§7.1.4). Handle here so js_add / js_to_num don't silently coerce it.
        if jsv_is_symbol(a_a) or jsv_is_symbol(b_a) {
            exc_sym_add: JSValue = make_type_error(
                "Cannot convert a Symbol value to a "
                    + (
                        "string"
                            if (jsv_is_string_cell(a_a) or jsv_is_string_cell(b_a))
                            else "number"
                    )
            );
            if not self._unwind_in_frame(frame, exc_sym_add) {
                self.had_exception = True;
                self.pending_exc = exc_sym_add;
                st.running = False;
            }
            return;
        }
        if jsv_is_string_cell(a_a) or jsv_is_string_cell(b_a) {
            self._push(js_add(a_a, b_a));
            return;
        }
        if jsv_is_bigint_cell(a_a) or jsv_is_bigint_cell(b_a) {
            # ES §13.15.3 ApplyStringOrNumericBinaryOperator for `+`:
            # if EITHER is a String → string concatenation; else both must be BigInt or
            # both Number — mixing BigInt with a Number is a TypeError.  (A String operand
            # with a BigInt is fine — it concatenates.)
            if jsv_is_string_cell(a_a) or jsv_is_string_cell(b_a) {
                self._push(js_add(a_a, b_a));
                return;
            }
            # `++x` on a BigInt compiles to ADD with a Number `1` unit and arg2==1; coerce
            # that integer unit to BigInt so it stays BigInt arithmetic (ES §13.4).  An
            # explicit `bigint + number` (arg2==0) stays a mix → TypeError below.
            a_ab: JSValue = a_a;
            b_ab: JSValue = b_a;
            if ins.arg2 == 1 {
                a_ab = self._coerce_bigint_unit(a_a, b_a);
                b_ab = self._coerce_bigint_unit(b_a, a_a);
            }
            if jsv_is_bigint_cell(a_ab) and jsv_is_bigint_cell(b_ab) {
                # Arbitrary-precision BigInt addition when both are decimal bignats.
                if _bigint_both_decimal(a_ab, b_ab) {
                    self._push(
                        _bigint_to_jsv(
                            bn_add(_bigint_from_jsv(a_ab), _bigint_from_jsv(b_ab))
                        )
                    );
                } else {
                    self._push(
                        js_bigint_from_num(
                            jsv_to_bigint_num(a_ab) + jsv_to_bigint_num(b_ab)
                        )
                    );
                }
            } else {
                # exactly one side BigInt, other is Number/other → TypeError
                exc_bi_add: JSValue = make_type_error(
                    "Cannot mix BigInt and other types, use explicit conversions"
                );
                if not self._unwind_in_frame(frame, exc_bi_add) {
                    self.had_exception = True;
                    self.pending_exc = exc_bi_add;
                    st.running = False;
                }
            }
        } else {
            self._push(js_add(a_a, b_a));
        }
    }

    """True if `v` is a non-primitive operand that needs ToPrimitive(number)
    before an arithmetic/bitwise/relational operator: an object, or a callable
    (function / native), both of which js_to_num would otherwise misread as 0."""
    def _needs_num_coerce(v: JSValue) -> bool {
        return jsv_is_object_cell(v) or is_fn_val(v) or is_native_val(v);
    }

    """ToPrimitive(v, hint "number") for an object operand of an arithmetic /
    bitwise / relational operator (ES §7.1.1): run [Symbol.toPrimitive]("number")
    if present, else OrdinaryToPrimitive in number order (valueOf, then toString).
    Non-objects pass through unchanged.  A thrown valueOf/toString/Symbol.toPrimitive
    is unwound into `frame`; on an unhandled throw `st.running` is cleared and the
    original object is returned (the caller bails out via the had_exception check).
    This is what makes `obj / 2`, `obj * 2`, `obj < 3`, `obj | 0`, … observe a
    user-defined `valueOf` instead of coercing the object straight to 0/NaN."""
    def _to_number_primitive(v: JSValue, frame: CallFrame, st: ExecState) -> JSValue {
        self._coerce_diverted = False;
        # A callable (function / native) has no numeric primitive: OrdinaryToPrimitive(number)
        # runs valueOf (returns the callable — not primitive) then toString → the function's
        # SOURCE STRING. Return that string (NOT NaN): a relational operator with two string
        # primitives does a String<String compare (`{} < function(){…}`), and arithmetic still
        # ToNumbers the string to NaN downstream — so the string is correct for both.
        if is_fn_val(v) or is_native_val(v) {
            fn_src: JSValue = _vm_call_native_proxy_aware(
                self, self.realm, NATIVE_KIND_FN_TOSTRING, v, []
            );
            if self._propagate_coerce_exc(frame, st) {
                return v;
            }
            if jsv_is_string_cell(fn_src) {
                return fn_src;
            }
            return js_nan();
        }
        if not jsv_is_object_cell(v) {
            return v;
        }
        # Array: OrdinaryToPrimitive falls through valueOf (returns the array) to
        # Array.prototype.toString → comma-joined elements.  `[3]` → "3" → 3,
        # `[]` → "" → 0, `[1,2]` → "1,2" → NaN.  Mirror _to_primitive_default so the
        # native toString runs with the right receiver.
        if js_is_array(v) {
            return js_Array_toString(v);
        }
        tp_fn: JSValue = js_object_get(v, SYMBOL_KEY_BASE + SYMBOL_TO_PRIMITIVE);
        if not jsv_is_undefined(tp_fn) and is_fn_val(tp_fn) {
            tp_cl: JSClosure = self.realm.closures[get_fn_idx(tp_fn)];
            tp_res: JSValue = self.run_cl(tp_cl, tp_fn, v, [js_str("number")]);
            if self._propagate_coerce_exc(frame, st) {
                return v;
            }
            return tp_res;
        }
        # OrdinaryToPrimitive(number): valueOf, then toString.  Use run_cl (not
        # vm_call_js_fn) for JS closures: vm_call_js_fn swallows a thrown exception
        # by reporting it as an unhandled callback error, whereas run_cl leaves
        # had_exception set so _propagate_coerce_exc can route it into `frame`.
        vo_fn: JSValue = self._get_prop_accessor(v, WK_VALUEOF);
        if not jsv_is_undefined(vo_fn) and is_fn_val(vo_fn) {
            vo_res: JSValue = self.run_cl(
                self.realm.closures[get_fn_idx(vo_fn)], vo_fn, v, []
            );
            if self._propagate_coerce_exc(frame, st) {
                return v;
            }
            if not jsv_is_object_cell(vo_res) {
                return vo_res;
            }
        } elif not jsv_is_undefined(vo_fn) and is_native_val(vo_fn) {
            vo_nat: JSValue = _vm_call_native_proxy_aware(
                self, self.realm, get_native_kind(vo_fn), v, []
            );
            if self._propagate_coerce_exc(frame, st) {
                return v;
            }
            if not jsv_is_object_cell(vo_nat) {
                return vo_nat;
            }
        }
        ts_fn: JSValue = self._get_prop_accessor(v, WK_TOSTRING);
        if not jsv_is_undefined(ts_fn) and is_fn_val(ts_fn) {
            ts_res: JSValue = self.run_cl(
                self.realm.closures[get_fn_idx(ts_fn)], ts_fn, v, []
            );
            if self._propagate_coerce_exc(frame, st) {
                return v;
            }
            if not jsv_is_object_cell(ts_res) {
                return ts_res;
            }
        } elif not jsv_is_undefined(ts_fn) and is_native_val(ts_fn) {
            ts_nat: JSValue = _vm_call_native_proxy_aware(
                self, self.realm, get_native_kind(ts_fn), v, []
            );
            if self._propagate_coerce_exc(frame, st) {
                return v;
            }
            if not jsv_is_object_cell(ts_nat) {
                return ts_nat;
            }
        }
        # Neither yielded a primitive → TypeError (Cannot convert object to primitive).
        self._coerce_diverted = True;
        tperr: JSValue = make_type_error("Cannot convert object to primitive value");
        if not self._unwind_in_frame(frame, tperr) {
            self.had_exception = True;
            self.pending_exc = tperr;
            st.running = False;
        }
        return v;
    }

    """ToNumeric(v) Symbol guard for the numeric binary operators (§7.1.4).
    ToNumeric of a Symbol throws a TypeError. Because ToNumeric(lval) fully
    completes — including this throw — before ToNumeric(rval) begins, each
    operator must run this immediately after coercing an operand to a primitive,
    interleaved between the two operands (not batched at the end). Otherwise a
    Symbol lhs would still trigger the rhs's valueOf (test262
    <op>/order-of-evaluation: trace must be "123", not "1234"). Sets
    `_coerce_diverted` and unwinds into `frame` when it throws; returns True then
    so the caller stops. A non-Symbol primitive returns False (continue)."""
    def _tonumeric_symbol_guard(v: JSValue, frame: CallFrame, st: ExecState) -> bool {
        if not jsv_is_symbol(v) {
            return False;
        }
        self._coerce_diverted = True;
        sym_err: JSValue = make_type_error("Cannot convert a Symbol value to a number");
        if not self._unwind_in_frame(frame, sym_err) {
            self.had_exception = True;
            self.pending_exc = sym_err;
            st.running = False;
        }
        return True;
    }

    """ECMAScript ToPropertyKey (§7.1.19) — coerce a computed-key JSValue to an
    interned property-key id, running JS coercion where required.

      key = ToPrimitive(argument, hint String)
      if key is a Symbol → the key is that Symbol; else → ToString(key).

    Unlike the pure `jsval_to_prop_key`, this runs `Symbol.toPrimitive("string")`
    / `toString` / `valueOf` for object keys and routes a thrown coercion error (or
    the not-a-primitive TypeError) into `frame`'s handlers.  On divert it sets
    `_coerce_diverted`; callers must check it and stop (do not use the return value).
    Fast path: non-object, non-symbol keys skip all of this."""
    def _to_property_key(v: JSValue, frame: CallFrame, st: ExecState) -> int {
        self._coerce_diverted = False;
        if jsv_is_symbol(v) {
            return SYMBOL_KEY_BASE + jsv_to_table_id(v);
        }
        # Callable (function) key → ToString via Function.prototype.toString (source
        # text), so `{ [function(){}]: 1 }` keys on the source string and both
        # `o[fn]` and `o[String(fn)]` resolve to the same property (ES §13.2.5).
        if is_fn_val(v) or is_native_val(v) {
            fpk_s: JSValue = self._fn_to_string_value(v);
            return str_intern(jsval_to_str(fpk_s));
        }
        # An interned string's id IS its property key (heap strings, ids at or
        # above HEAP_STRING_BASE, are re-interned through their text).
        if jsv_is_string_cell(v)
            and jsv_to_table_id(v) > 0
            and jsv_to_table_id(v) < HEAP_STRING_BASE {
            return jsv_to_table_id(v);
        }
        if not jsv_is_object_cell(v) {
            return str_intern(jsval_to_str(v));
        }
        # Object key → ToPrimitive(string).  Array short-circuits to its toString
        # (comma join) like the number path, but the *result* is still ToString'd.
        prim: JSValue = js_undefined();
        got_prim: bool = False;
        if js_is_array(v) {
            prim = js_Array_toString(v);
            got_prim = True;
        } else {
            # GetMethod(@@toPrimitive) via the accessor path so a getter fires
            # (spec Get(input, @@toPrimitive)). A present-but-not-callable value
            # (and not undefined/null) is a TypeError — must NOT fall through to
            # OrdinaryToPrimitive (test262 class computed-name-toprimitive-returns-
            # noncallable/nonobject; object accessor-name-computed variants).
            tp_fn: JSValue = self._get_prop_accessor(
                v, SYMBOL_KEY_BASE + SYMBOL_TO_PRIMITIVE
            );
            if self._propagate_coerce_exc(frame, st) {
                return 0;
            }
            if not jsv_is_undefined(tp_fn) and not jsv_is_null(tp_fn) {
                if is_fn_val(tp_fn) or is_native_val(tp_fn) or js_is_proxy(tp_fn) {
                    tp_res: JSValue = _vm_invoke_callback(
                        self, tp_fn, v, [js_str("string")]
                    );
                    if self._propagate_coerce_exc(frame, st) {
                        return 0;
                    }
                    # Symbol.toPrimitive that returns an object is a TypeError (handled below).
                    prim = tp_res;
                    got_prim = True;
                } else {
                    # @@toPrimitive present but not callable → TypeError (§7.3.10 step 3).
                    self._coerce_diverted = True;
                    tp_nc_err: JSValue = make_type_error(
                        "Cannot convert object to primitive value"
                    );
                    if not self._unwind_in_frame(frame, tp_nc_err) {
                        self.had_exception = True;
                        self.pending_exc = tp_nc_err;
                        st.running = False;
                    }
                    return 0;
                }
            }
        }
        # OrdinaryToPrimitive(string): toString, then valueOf.  `called_ord` records
        # whether a *callable* method actually ran (vs. being absent/unreachable) — an
        # object result from a method that ran is a real TypeError, whereas no callable
        # method at all falls back to the `[object …]` representation.
        called_ord: bool = False;
        if not got_prim {
            ts_fn: JSValue = self._get_prop_accessor(v, WK_TOSTRING);
            if not jsv_is_undefined(ts_fn) and is_fn_val(ts_fn) {
                called_ord = True;
                ts_res: JSValue = self.run_cl(
                    self.realm.closures[get_fn_idx(ts_fn)], ts_fn, v, []
                );
                if self._propagate_coerce_exc(frame, st) {
                    return 0;
                }
                if not jsv_is_object_cell(ts_res) {
                    prim = ts_res;
                    got_prim = True;
                }
            } elif not jsv_is_undefined(ts_fn) and is_native_val(ts_fn) {
                called_ord = True;
                ts_nat: JSValue = _vm_call_native_proxy_aware(
                    self, self.realm, get_native_kind(ts_fn), v, []
                );
                if self._propagate_coerce_exc(frame, st) {
                    return 0;
                }
                if not jsv_is_object_cell(ts_nat) {
                    prim = ts_nat;
                    got_prim = True;
                }
            }
        }
        if not got_prim {
            vo_fn: JSValue = self._get_prop_accessor(v, WK_VALUEOF);
            if not jsv_is_undefined(vo_fn) and is_fn_val(vo_fn) {
                called_ord = True;
                vo_res: JSValue = self.run_cl(
                    self.realm.closures[get_fn_idx(vo_fn)], vo_fn, v, []
                );
                if self._propagate_coerce_exc(frame, st) {
                    return 0;
                }
                if not jsv_is_object_cell(vo_res) {
                    prim = vo_res;
                    got_prim = True;
                }
            } elif not jsv_is_undefined(vo_fn) and is_native_val(vo_fn) {
                called_ord = True;
                vo_nat: JSValue = _vm_call_native_proxy_aware(
                    self, self.realm, get_native_kind(vo_fn), v, []
                );
                if self._propagate_coerce_exc(frame, st) {
                    return 0;
                }
                if not jsv_is_object_cell(vo_nat) {
                    prim = vo_nat;
                    got_prim = True;
                }
            }
        }
        # Neither a primitive: throw TypeError when a coercion method actually ran and
        # returned an object (Symbol.toPrimitive, or a callable toString/valueOf) —
        # spec §7.1.1.  Otherwise (no reachable method, e.g. an exotic whose proto
        # chain isn't visible to _get_prop_accessor) fall back to the object's string
        # representation, matching the pure `jsval_to_str` this replaced.
        if not got_prim {
            # A coercion method ran and returned an object → TypeError (§7.1.1). Also
            # throw when NO callable toString/valueOf was reachable AND the object has a
            # null [[Prototype]] — `Object.create(null)` genuinely has no method, so
            # OrdinaryToPrimitive throws (test262 object/accessor-name-computed-err-to-
            # prop-key). Only the "exotic whose proto isn't visible to _get_prop_accessor"
            # case keeps the legacy string fallback.
            tpk_np: bool = False;
            if not called_ord and jsv_is_object_cell(v) and jsv_to_table_id(v) > 0 {
                tpk_proto: JSValue = js_object_get_prototype(v);
                if jsv_is_null(tpk_proto) or jsv_is_undefined(tpk_proto) {
                    tpk_np = True;
                }
            }
            if called_ord or tpk_np {
                self._coerce_diverted = True;
                tperr: JSValue = make_type_error(
                    "Cannot convert object to primitive value"
                );
                if not self._unwind_in_frame(frame, tperr) {
                    self.had_exception = True;
                    self.pending_exc = tperr;
                    st.running = False;
                }
                return 0;
            }
            return str_intern(jsval_to_str(v));
        }
        # Symbol.toPrimitive returned an object (its result was recorded as got_prim).
        if jsv_is_object_cell(prim) {
            self._coerce_diverted = True;
            tperr2: JSValue = make_type_error(
                "Cannot convert object to primitive value"
            );
            if not self._unwind_in_frame(frame, tperr2) {
                self.had_exception = True;
                self.pending_exc = tperr2;
                st.running = False;
            }
            return 0;
        }
        # ToPropertyKey: a Symbol primitive stays a Symbol key; anything else → ToString.
        if jsv_is_symbol(prim) {
            return SYMBOL_KEY_BASE + jsv_to_table_id(prim);
        }
        return str_intern(jsval_to_str(prim));
    }

    """Route a pending native/VM exception raised during operand coercion into the
    current frame's handlers.  Returns True if an exception is now pending (the
    caller must stop), False otherwise."""
    def _propagate_coerce_exc(frame: CallFrame, st: ExecState) -> bool {
        # A NATIVE-channel throw (a native valueOf / toString / @@toPrimitive raising via
        # vm_throw_native — e.g. Symbol.prototype.valueOf on `Object(Symbol())`) must be
        # folded into the current frame too, else it escapes the surrounding JS try/catch
        # uncaught (test262 bitwise-*/bigint-errors: `Object(Symbol('1')) & 0n`).
        if vm_has_native_exc() {
            exc_n: JSValue = vm_take_native_exc();
            self._coerce_diverted = True;
            if not self._unwind_in_frame(frame, exc_n) {
                self.had_exception = True;
                self.pending_exc = exc_n;
                st.running = False;
            }
            return True;
        }
        if not self.had_exception {
            return False;
        }
        exc: JSValue = self.pending_exc;
        self.had_exception = False;
        self.pending_exc = js_undefined();
        # Route into a catch handler if one exists; otherwise re-raise as pending.
        # Either way control has *diverted* away from the current operator — the
        # caller must stop and NOT push an arithmetic result (that would clobber the
        # exception the handler is about to read from the stack).  _coerce_diverted
        # records this; the operator checks it after each coercion call.
        self._coerce_diverted = True;
        if not self._unwind_in_frame(frame, exc) {
            self.had_exception = True;
            self.pending_exc = exc;
            st.running = False;
        }
        return True;
    }

    def _op_sub(frame: CallFrame, ins: Instruction, st: ExecState) -> None {
        b_s: JSValue = self._pop();
        a_s: JSValue = self._pop();
        a_s = self._to_number_primitive(a_s, frame, st);
        if self._coerce_diverted {
            return;
        }
        if self._tonumeric_symbol_guard(a_s, frame, st) {
            return;
        }
        b_s = self._to_number_primitive(b_s, frame, st);
        if self._coerce_diverted {
            return;
        }
        if self._tonumeric_symbol_guard(b_s, frame, st) {
            return;
        }
        if jsv_is_bigint_cell(a_s) or jsv_is_bigint_cell(b_s) {
            # `--x` on a BigInt compiles to SUB with a Number `1` unit and arg2==1; coerce
            # that integer unit to BigInt so it stays BigInt arithmetic (ES §13.4 update
            # unit matches the operand type).  Explicit `bigint - number` (arg2==0) must
            # NOT coerce — it stays a mix (→ float here / TypeError in strict engines).
            a_sb: JSValue = a_s;
            b_sb: JSValue = b_s;
            if ins.arg2 == 1 {
                a_sb = self._coerce_bigint_unit(a_s, b_s);
                b_sb = self._coerce_bigint_unit(b_s, a_s);
            }
            if jsv_is_bigint_cell(a_sb) and jsv_is_bigint_cell(b_sb) {
                if _bigint_both_decimal(a_sb, b_sb) {
                    self._push(
                        _bigint_to_jsv(
                            bn_sub(_bigint_from_jsv(a_sb), _bigint_from_jsv(b_sb))
                        )
                    );
                } else {
                    self._push(
                        js_bigint_from_num(
                            jsv_to_bigint_num(a_sb) - jsv_to_bigint_num(b_sb)
                        )
                    );
                }
                return;
            }
            # Genuinely mixed BigInt/Number (ES §13.15.3) → TypeError.
            self._raise_exc(
                frame,
                st,
                make_type_error(
                    "Cannot mix BigInt and other types, use explicit conversions"
                )
            );
        } else {
            # Int32-int32 fast path with overflow check (same rationale as js_add).
            if jsv_is_int32(a_s) and jsv_is_int32(b_s) {
                ia_s: int = jsv_to_int32(a_s);
                ib_s: int = jsv_to_int32(b_s);
                diff_s: int = ia_s - ib_s;
                if diff_s >= -2147483648 and diff_s <= 2147483647 {
                    self._push(js_int(diff_s));
                    return;
                }
            }
            self._push(float_to_jsval(js_to_num(a_s) - js_to_num(b_s)));
        }
    }

    """
    Update-operator unit coercion: when `other` is a BigInt and `v` is an
    integer-valued Number (the `1` unit emitted by ++/-- and compound `+= 1`),
    return v as a decimal BigInt so BigInt ± BigInt arbitrary-precision applies.
    Non-integer Numbers or a non-BigInt `other` are returned unchanged.
    """
    def _coerce_bigint_unit(v: JSValue, other: JSValue) -> JSValue {
        if not jsv_is_bigint_cell(other) {
            return v;
        }
        if jsv_is_bigint_cell(v) {
            return v;
        }
        uv_f: float = 0.0;
        if jsv_is_int32(v) {
            uv_f = float(jsv_to_int32(v));
        } elif jsv_is_double(v) {
            uv_f = jsv_to_double(v);
        } else {
            return v;
        }
        if uv_f != uv_f {
            return v;
        }
        ui: int = int(uv_f);
        if float(ui) != uv_f {
            return v;
        }
        return jsv_from_cell_kind(str_intern_index(ui), JS_CELL_KIND_BIGINT);
    }

    def _op_mul(frame: CallFrame, ins: Instruction, st: ExecState) -> None {
        b_m: JSValue = self._pop();
        a_m: JSValue = self._pop();
        a_m = self._to_number_primitive(a_m, frame, st);
        if self._coerce_diverted {
            return;
        }
        if self._tonumeric_symbol_guard(a_m, frame, st) {
            return;
        }
        b_m = self._to_number_primitive(b_m, frame, st);
        if self._coerce_diverted {
            return;
        }
        if self._tonumeric_symbol_guard(b_m, frame, st) {
            return;
        }
        if jsv_is_bigint_cell(a_m) or jsv_is_bigint_cell(b_m) {
            # Arbitrary-precision BigInt * BigInt when both are decimal bignats.
            if jsv_is_bigint_cell(a_m) and jsv_is_bigint_cell(b_m) {
                a_bi_str: str = _bigint_str_of(a_m);
                b_bi_str: str = _bigint_str_of(b_m);
                if _bigint_is_decimal_str(a_bi_str)
                    and _bigint_is_decimal_str(b_bi_str) {
                    self._push(
                        _bigint_to_jsv(
                            bn_mul(
                                bn_parse_decimal(a_bi_str), bn_parse_decimal(b_bi_str)
                            )
                        )
                    );
                } else {
                    self._push(
                        js_bigint_from_num(
                            jsv_to_bigint_num(a_m) * jsv_to_bigint_num(b_m)
                        )
                    );
                }
                return;
            }
            # Genuinely mixed BigInt/Number (ES §13.15.3) → TypeError.
            self._raise_exc(
                frame,
                st,
                make_type_error(
                    "Cannot mix BigInt and other types, use explicit conversions"
                )
            );
        } else {
            # Int32*int32 fast path with overflow check (same rationale as js_add).
            if jsv_is_int32(a_m) and jsv_is_int32(b_m) {
                ia_m: int = jsv_to_int32(a_m);
                ib_m: int = jsv_to_int32(b_m);
                prod_m: int = ia_m * ib_m;
                if prod_m >= -2147483648 and prod_m <= 2147483647 {
                    self._push(js_int(prod_m));
                    return;
                }
            }
            self._push(float_to_jsval(js_to_num(a_m) * js_to_num(b_m)));
        }
    }

    def _op_div(frame: CallFrame, ins: Instruction, st: ExecState) -> None {
        b_d: JSValue = self._pop();
        a_d: JSValue = self._pop();
        a_d = self._to_number_primitive(a_d, frame, st);
        if self._coerce_diverted {
            return;
        }
        if self._tonumeric_symbol_guard(a_d, frame, st) {
            return;
        }
        b_d = self._to_number_primitive(b_d, frame, st);
        if self._coerce_diverted {
            return;
        }
        if self._tonumeric_symbol_guard(b_d, frame, st) {
            return;
        }
        if jsv_is_bigint_cell(a_d)
            and jsv_is_bigint_cell(b_d)
            and _bigint_both_decimal(a_d, b_d) {
            bd_s: str = _bigint_str_of(b_d);
            if bd_s == "0" or bd_s == "-0" {
                self._raise_exc(frame, st, make_range_error("Division by zero"));
                return;
            }
            q_s: str = _bigint_divmod_decimal(_bigint_str_of(a_d), bd_s);
            self._push(jsv_from_cell_kind(str_intern(q_s), JS_CELL_KIND_BIGINT));
            return;
        }
        if jsv_is_bigint_cell(a_d) or jsv_is_bigint_cell(b_d) {
            # A BigInt operand that did not take the both-decimal path above is a genuine
            # mix with a Number (ES §13.15.3) → TypeError (never ToNumber(BigInt)).
            self._raise_exc(
                frame,
                st,
                make_type_error(
                    "Cannot mix BigInt and other types, use explicit conversions"
                )
            );
            return;
        }
        nd: float = js_to_num(b_d);
        na_pre: float = js_to_num(a_d);
        # ECMAScript §6.1.6.1.5 step 1: if either operand is NaN, the result is NaN.
        # This must precede the ±0 divisor rules below, else e.g. NaN / 0 → Infinity.
        if not (na_pre == na_pre) or not (nd == nd) {
            self._push(js_nan());
            return;
        }
        if nd == 0.0 {
            # ECMAScript §6.1.6.1.5: dividend / ±0
            #   any/0 sign rule: result is ∞ with sign = sign(dividend) XOR sign(divisor)
            na_d: float = na_pre;
            if na_d == 0.0 {
                self._push(js_nan());
            } else {
                # Detect -0 divisor via bit pattern (sign bit set = negative zero)
                neg_div: bool = __float_bits(nd) < 0;
                # na_d < 0.0 XOR neg_div → produce -Infinity
                if (na_d < 0.0) != neg_div {
                    self._push(js_neg_infinity());
                } else {
                    self._push(js_infinity());
                }
            }
        } else {
            self._push(float_to_jsval(js_to_num(a_d) / nd));
        }
    }

    def _op_mod(frame: CallFrame, ins: Instruction, st: ExecState) -> None {
        b_mod: JSValue = self._pop();
        a_mod: JSValue = self._pop();
        a_mod = self._to_number_primitive(a_mod, frame, st);
        if self._coerce_diverted {
            return;
        }
        if self._tonumeric_symbol_guard(a_mod, frame, st) {
            return;
        }
        b_mod = self._to_number_primitive(b_mod, frame, st);
        if self._coerce_diverted {
            return;
        }
        if self._tonumeric_symbol_guard(b_mod, frame, st) {
            return;
        }
        if jsv_is_bigint_cell(a_mod)
            and jsv_is_bigint_cell(b_mod)
            and _bigint_both_decimal(a_mod, b_mod) {
            bd_mod_s: str = _bigint_str_of(b_mod);
            if bd_mod_s == "0" or bd_mod_s == "-0" {
                self._raise_exc(frame, st, make_range_error("Division by zero"));
                return;
            }
            _bigint_divmod_decimal(_bigint_str_of(a_mod), bd_mod_s);
            self._push(
                jsv_from_cell_kind(str_intern(_BIGINT_DIV_REM_STR), JS_CELL_KIND_BIGINT)
            );
            return;
        }
        if jsv_is_bigint_cell(a_mod) or jsv_is_bigint_cell(b_mod) {
            # Genuinely mixed BigInt/Number (ES §13.15.3) → TypeError.
            self._raise_exc(
                frame,
                st,
                make_type_error(
                    "Cannot mix BigInt and other types, use explicit conversions"
                )
            );
            return;
        }
        nb_mod: float = js_to_num(b_mod);
        na_mod: float = js_to_num(a_mod);
        inf_m: float = MATH_INF;
        # ECMAScript §6.1.6.1.6 (Number::remainder):
        #   NaN operand, infinite dividend, or zero divisor → NaN
        if not (na_mod == na_mod)
            or not (nb_mod == nb_mod)
            or na_mod == inf_m
            or na_mod == -inf_m
            or nb_mod == 0.0 {
            self._push(js_nan());
        }
        #   infinite divisor (dividend finite) → dividend unchanged
        elif nb_mod == inf_m or nb_mod == -inf_m {
            self._push(float_to_jsval(na_mod));
        } else {
            # §6.1.6.1.6 — truncating remainder: libm fmod (exact; the old
            # n - float(int(n / d)) * d overflowed int64 for a huge quotient).
            r_mod: float = fmod(na_mod, nb_mod);
            # §6.1.6.1.6: when the remainder is zero it takes the SIGN OF THE DIVIDEND
            # (`-1 % -1` → -0, not +0). Float subtraction yields +0 here, so restore
            # the dividend's sign explicitly (test262 mod-whitespace).
            if r_mod == 0.0 and __float_bits(na_mod) < 0 {
                # js_number keeps the -0 sign bit that float_to_jsval would drop
                # (it maps -0.0 → js_int(0)).
                self._push(js_number(-0.0));
            } else {
                self._push(float_to_jsval(r_mod));
            }
        }
    }

    """Throw `exc` into `frame`: unwind to the nearest catch, else make it the
    pending exception and stop the frame. Use instead of a bare `vm_throw_native`
    (which leaves the exception on the native channel WITHOUT unwinding — _exec does
    not re-check it, so the VM keeps running and underflows the stack)."""
    def _raise_exc(frame: CallFrame, st: ExecState, exc: JSValue) {
        if not self._unwind_in_frame(frame, exc) {
            self.had_exception = True;
            self.pending_exc = exc;
            st.running = False;
        }
    }

    def _op_pow(frame: CallFrame, ins: Instruction, st: ExecState) -> None {
        b_pw: JSValue = self._pop();
        a_pw: JSValue = self._pop();
        a_pw = self._to_number_primitive(a_pw, frame, st);
        if self._coerce_diverted {
            return;
        }
        if self._tonumeric_symbol_guard(a_pw, frame, st) {
            return;
        }
        b_pw = self._to_number_primitive(b_pw, frame, st);
        if self._coerce_diverted {
            return;
        }
        if self._tonumeric_symbol_guard(b_pw, frame, st) {
            return;
        }
        # ECMAScript §6.1.6.2.5 / §13.6: BigInt**BigInt; mixed Number/BigInt → TypeError.
        # Never fall through to ToNumber on a BigInt operand (hangs Number(2n**53n) etc.).
        if jsv_is_bigint_cell(a_pw) or jsv_is_bigint_cell(b_pw) {
            if not jsv_is_bigint_cell(a_pw) or not jsv_is_bigint_cell(b_pw) {
                self._raise_exc(
                    frame,
                    st,
                    make_type_error(
                        "Cannot mix BigInt and other types, use explicit conversions"
                    )
                );
                return;
            }
            exp_s: str = str_from_id(jsv_to_table_id(b_pw));
            if len(exp_s) > 0 and exp_s[0] == "-" {
                self._raise_exc(
                    frame, st, make_range_error("Exponent must be non-negative")
                );
                return;
            }
            if not _bigint_is_decimal_str(exp_s) or len(exp_s) > 5 {
                self._raise_exc(
                    frame, st, make_range_error("BigInt exponent out of range")
                );
                return;
            }
            exp_i: int = int(exp_s);
            # Fail-fast: unbounded BigInt** can OOM/hang under CI mem-limit.
            if exp_i < 0 or exp_i > 10000 {
                self._raise_exc(
                    frame, st, make_range_error("BigInt exponent out of range")
                );
                return;
            }
            base_s: str = str_from_id(jsv_to_table_id(a_pw));
            if not _bigint_is_decimal_str(base_s) {
                self._raise_exc(frame, st, make_type_error("Invalid BigInt"));
                return;
            }
            self._push(
                jsv_from_cell_kind(
                    str_intern(_bigint_str_pow(base_s, exp_i)), JS_CELL_KIND_BIGINT
                )
            );
            return;
        }
        self._push(
            float_to_jsval(_number_exponentiate(js_to_num(a_pw), js_to_num(b_pw)))
        );
    }

    def _op_neg(frame: CallFrame, ins: Instruction, st: ExecState) -> None {
        a_ng: JSValue = self._pop();
        if self._needs_num_coerce(a_ng) {
            a_ng = self._to_number_primitive(a_ng, frame, st);
            if self._coerce_diverted {
                return;
            }
        }
        if jsv_is_bigint_cell(a_ng) {
            if _bigint_is_decimal_str(_bigint_str_of(a_ng)) {
                self._push(_bigint_to_jsv(bn_neg(_bigint_from_jsv(a_ng))));
                return;
            }
            self._push(js_bigint_from_num(-jsv_to_bigint_num(a_ng)));
        } else {
            ng_d: float = -js_to_num(a_ng);
            # ECMAScript §6.1.6.1.1: unary - on +0 → -0.
            # float_to_jsval would map -0.0 to js_int(0), losing the sign bit.
            # Detect -0.0 via its IEEE 754 bit pattern (sign bit set, magnitude 0).
            if ng_d == 0.0 and __float_bits(ng_d) < 0 {
                self._push(js_number(ng_d));
            } else {
                self._push(float_to_jsval(ng_d));
            }
        }
    }

    def _op_to_number(frame: CallFrame, ins: Instruction, st: ExecState) -> None {
        a_tn: JSValue = self._pop();
        # Unary `+` / explicit ToNumber (ES §7.1.4): coerce object/callable operands
        # through the shared ToPrimitive(number) helper, so `+obj` runs valueOf /
        # Symbol.toPrimitive and `+fn` yields NaN, with throws propagated to the frame.
        if self._needs_num_coerce(a_tn) {
            a_tn = self._to_number_primitive(a_tn, frame, st);
            if self._coerce_diverted {
                return;
            }
        }
        self._push(float_to_jsval(js_to_num(a_tn)));
    }

    def _op_to_string(frame: CallFrame, ins: Instruction, st: ExecState) -> None {
        a_ts: JSValue = self._pop();
        # ECMAScript template/string coercion: ToPrimitive with hint "string",
        # then ToString on the resulting primitive.
        if jsv_is_object_cell(a_ts) {
            a_ts = self._to_primitive_string(a_ts);
            if self.had_exception {
                exc_ts: JSValue = self.pending_exc;
                self.had_exception = False;
                self.pending_exc = js_undefined();
                if not self._unwind_in_frame(frame, exc_ts) {
                    self.had_exception = True;
                    self.pending_exc = exc_ts;
                    st.running = False;
                }
                return;
            }
        }
        self._push(js_str_heap(jsval_to_str(a_ts)));  # G1.5: TO_STRING coercion result is a transient value

        # ── Bitwise ───────────────────────────────────────────────────
        # All bitwise ops apply ECMAScript ToInt32 to produce a signed
        # 32-bit result, matching the spec (USHR uses ToUint32 instead).
    }

    """`a op b` (op 0=AND,1=OR,2=XOR) when at least one operand is a BigInt (ES
    §6.1.6.2.x / §13.15.3): both BigInt → BigInt result; mixed → TypeError. Assumes
    the coercion/Symbol guard already ran."""
    def _bigint_bitwise_binop_push(
        frame: CallFrame, st: ExecState, a: JSValue, b: JSValue, op: int
    ) {
        if jsv_is_bigint_cell(a) and jsv_is_bigint_cell(b) {
            r: str = _bigint_bit_binop(_bigint_str_of(a), _bigint_str_of(b), op);
            self._push(jsv_from_cell_kind(str_intern(r), JS_CELL_KIND_BIGINT));
        } else {
            self._raise_exc(
                frame,
                st,
                make_type_error(
                    "Cannot mix BigInt and other types, use explicit conversions"
                )
            );
        }
    }

    def _op_band(frame: CallFrame, ins: Instruction, st: ExecState) -> None {
        b_ba: JSValue = self._pop();
        a_ba: JSValue = self._pop();
        a_ba = self._to_number_primitive(a_ba, frame, st);
        if self._coerce_diverted {
            return;
        }
        if self._tonumeric_symbol_guard(a_ba, frame, st) {
            return;
        }
        b_ba = self._to_number_primitive(b_ba, frame, st);
        if self._coerce_diverted {
            return;
        }
        if self._tonumeric_symbol_guard(b_ba, frame, st) {
            return;
        }
        if jsv_is_bigint_cell(a_ba) or jsv_is_bigint_cell(b_ba) {
            self._bigint_bitwise_binop_push(frame, st, a_ba, b_ba, 0);
            return;
        }
        self._push(js_int(to_int32(int(js_to_num(a_ba)) & int(js_to_num(b_ba)))));
    }

    def _op_bor(frame: CallFrame, ins: Instruction, st: ExecState) -> None {
        b_bo: JSValue = self._pop();
        a_bo: JSValue = self._pop();
        a_bo = self._to_number_primitive(a_bo, frame, st);
        if self._coerce_diverted {
            return;
        }
        if self._tonumeric_symbol_guard(a_bo, frame, st) {
            return;
        }
        b_bo = self._to_number_primitive(b_bo, frame, st);
        if self._coerce_diverted {
            return;
        }
        if self._tonumeric_symbol_guard(b_bo, frame, st) {
            return;
        }
        if jsv_is_bigint_cell(a_bo) or jsv_is_bigint_cell(b_bo) {
            self._bigint_bitwise_binop_push(frame, st, a_bo, b_bo, 1);
            return;
        }
        self._push(js_int(to_int32(int(js_to_num(a_bo)) | int(js_to_num(b_bo)))));
    }

    def _op_bxor(frame: CallFrame, ins: Instruction, st: ExecState) -> None {
        b_bx: JSValue = self._pop();
        a_bx: JSValue = self._pop();
        a_bx = self._to_number_primitive(a_bx, frame, st);
        if self._coerce_diverted {
            return;
        }
        if self._tonumeric_symbol_guard(a_bx, frame, st) {
            return;
        }
        b_bx = self._to_number_primitive(b_bx, frame, st);
        if self._coerce_diverted {
            return;
        }
        if self._tonumeric_symbol_guard(b_bx, frame, st) {
            return;
        }
        if jsv_is_bigint_cell(a_bx) or jsv_is_bigint_cell(b_bx) {
            self._bigint_bitwise_binop_push(frame, st, a_bx, b_bx, 2);
            return;
        }
        self._push(js_int(to_int32(int(js_to_num(a_bx)) ^ int(js_to_num(b_bx)))));
    }

    def _op_bnot(frame: CallFrame, ins: Instruction, st: ExecState) -> None {
        a_bn: JSValue = self._pop();
        if self._needs_num_coerce(a_bn) {
            a_bn = self._to_number_primitive(a_bn, frame, st);
            if self._coerce_diverted {
                return;
            }
        }
        if jsv_is_bigint_cell(a_bn) {
            rbn: str = _bigint_bit_not(_bigint_str_of(a_bn));
            self._push(jsv_from_cell_kind(str_intern(rbn), JS_CELL_KIND_BIGINT));
            return;
        }
        self._push(js_int(to_int32(~int(js_to_num(a_bn)))));
    }

    """`a << b` / `a >> b` when a BigInt is involved (`is_left` selects `<<`).
    Both BigInt → BigInt result (`a << -n == a >> n`); mixed → TypeError. A huge shift
    that would grow the value without bound → RangeError; a huge right shift collapses
    to 0 (or -1 for a negative operand)."""
    def _bigint_shift_push(
        frame: CallFrame, st: ExecState, a: JSValue, b: JSValue, is_left: bool
    ) -> None {
        if not (jsv_is_bigint_cell(a) and jsv_is_bigint_cell(b)) {
            self._raise_exc(
                frame,
                st,
                make_type_error(
                    "Cannot mix BigInt and other types, use explicit conversions"
                )
            );
            return;
        }
        a_dec: str = _bigint_str_of(a);
        sh: str = _bigint_str_of(b);
        sneg: bool = len(sh) > 0 and sh[0:1] == "-";
        smag: str = sh[1:] if sneg else sh;
        do_left: bool = is_left;
        if sneg {
            do_left = not do_left;
        }
        # Guard pathological shift magnitudes (avoid OOM / runaway loops).
        if len(smag) > 7 {
            if do_left and not (a_dec == "0") {
                self._raise_exc(
                    frame, st, make_range_error("Maximum BigInt size exceeded")
                );
                return;
            }
            coll: str = "-1" if (len(a_dec) > 0 and a_dec[0:1] == "-") else "0";
            self._push(jsv_from_cell_kind(str_intern(coll), JS_CELL_KIND_BIGINT));
            return;
        }
        n: int = int(smag) if len(smag) > 0 else 0;
        if do_left and n > 1000000 {
            self._raise_exc(
                frame, st, make_range_error("Maximum BigInt size exceeded")
            );
            return;
        }
        rsh: str = _bigint_shl_dec(a_dec, n) if do_left else _bigint_shr_dec(a_dec, n);
        self._push(jsv_from_cell_kind(str_intern(rsh), JS_CELL_KIND_BIGINT));
    }

    def _op_shl(frame: CallFrame, ins: Instruction, st: ExecState) -> None {
        b_sl: JSValue = self._pop();
        a_sl: JSValue = self._pop();
        a_sl = self._to_number_primitive(a_sl, frame, st);
        if self._coerce_diverted {
            return;
        }
        if self._tonumeric_symbol_guard(a_sl, frame, st) {
            return;
        }
        b_sl = self._to_number_primitive(b_sl, frame, st);
        if self._coerce_diverted {
            return;
        }
        if self._tonumeric_symbol_guard(b_sl, frame, st) {
            return;
        }
        if jsv_is_bigint_cell(a_sl) or jsv_is_bigint_cell(b_sl) {
            self._bigint_shift_push(frame, st, a_sl, b_sl, True);
            return;
        }
        self._push(
            js_int(to_int32(int(js_to_num(a_sl)) << (int(js_to_num(b_sl)) & 31)))
        );
    }

    def _op_shr(frame: CallFrame, ins: Instruction, st: ExecState) -> None {
        b_sr: JSValue = self._pop();
        a_sr: JSValue = self._pop();
        a_sr = self._to_number_primitive(a_sr, frame, st);
        if self._coerce_diverted {
            return;
        }
        if self._tonumeric_symbol_guard(a_sr, frame, st) {
            return;
        }
        b_sr = self._to_number_primitive(b_sr, frame, st);
        if self._coerce_diverted {
            return;
        }
        if self._tonumeric_symbol_guard(b_sr, frame, st) {
            return;
        }
        if jsv_is_bigint_cell(a_sr) or jsv_is_bigint_cell(b_sr) {
            self._bigint_shift_push(frame, st, a_sr, b_sr, False);
            return;
        }
        # Apply ToInt32 to left operand so Python arithmetic >> sign-extends correctly
        a_sr_i32: int = to_int32(int(js_to_num(a_sr)));
        self._push(js_int(a_sr_i32 >> (int(js_to_num(b_sr)) & 31)));
    }

    def _op_ushr(frame: CallFrame, ins: Instruction, st: ExecState) -> None {
        b_us: JSValue = self._pop();
        a_us: JSValue = self._pop();
        a_us = self._to_number_primitive(a_us, frame, st);
        if self._coerce_diverted {
            return;
        }
        if self._tonumeric_symbol_guard(a_us, frame, st) {
            return;
        }
        b_us = self._to_number_primitive(b_us, frame, st);
        if self._coerce_diverted {
            return;
        }
        if self._tonumeric_symbol_guard(b_us, frame, st) {
            return;
        }
        if jsv_is_bigint_cell(a_us) or jsv_is_bigint_cell(b_us) {
            # ES §6.1.6.2.9: BigInt::unsignedRightShift is always a TypeError (no infinite
            # two's-complement notion of an *unsigned* value). Mixed operands also throw.
            self._raise_exc(
                frame,
                st,
                make_type_error("BigInts have no unsigned right shift, use >> instead")
            );
            return;
        }
        v_us: int = int(js_to_num(a_us)) & 4294967295;
        r_us: int = v_us >> (int(js_to_num(b_us)) & 31);
        # Result is always in [0, 2^32-1]. Values >= 2^31 cannot be
        # represented as a signed int32 without sign-extension, so
        # emit as float64 to match ECMAScript §13.9.2.
        if r_us > 2147483647 {
            self._push(js_number(float(r_us)));
        } else {
            self._push(js_int(r_us));
        }

        # ── Comparison ────────────────────────────────────────────────
    }

    def _op_eq(frame: CallFrame, ins: Instruction, st: ExecState) -> None {
        b_eq: JSValue = self._pop();
        a_eq: JSValue = self._pop();
        eq_res: bool = self._abstract_equal(a_eq, b_eq);
        # ES §7.2.14: ToPrimitive on an operand may run a @@toPrimitive/valueOf/toString that
        # THROWS (e.g. a throwing @@toPrimitive getter). _abstract_equal sets had_exception but
        # returns a plain bool, so unwind here instead of pushing a bogus result
        # (test262 equals/get-symbol-to-prim-err).
        if self._eq_propagate_exc(frame, st) {
            return;
        }
        self._push(js_boolean(eq_res));
    }

    def _op_neq(frame: CallFrame, ins: Instruction, st: ExecState) -> None {
        b_ne: JSValue = self._pop();
        a_ne: JSValue = self._pop();
        neq_res: bool = self._abstract_equal(a_ne, b_ne);
        if self._eq_propagate_exc(frame, st) {
            return;
        }
        self._push(js_boolean(not neq_res));
    }

    """Unwind a pending exception left by _abstract_equal's ToPrimitive into `frame`.
    Returns True if there was one (caller must return without pushing a result)."""
    def _eq_propagate_exc(frame: CallFrame, st: ExecState) -> bool {
        if not (self.had_exception or vm_has_native_exc()) {
            return False;
        }
        eqe_exc: JSValue = vm_take_native_exc()
            if vm_has_native_exc()
            else self.pending_exc;
        self.had_exception = False;
        self.pending_exc = js_undefined();
        if not self._unwind_in_frame(frame, eqe_exc) {
            self.had_exception = True;
            self.pending_exc = eqe_exc;
            st.running = False;
        }
        return True;
    }

    def _op_strict_eq(frame: CallFrame, ins: Instruction, st: ExecState) -> None {
        b_se: JSValue = self._pop();
        a_se: JSValue = self._pop();
        if jsv_is_bigint_cell(a_se) and jsv_is_bigint_cell(b_se) {
            self._push(js_boolean(js_bigint_cells_equal(a_se, b_se)));
            return;
        }
        self._push(js_boolean(self._vm_strict_eq(a_se, b_se)));
    }

    def _op_strict_neq(frame: CallFrame, ins: Instruction, st: ExecState) -> None {
        b_sn: JSValue = self._pop();
        a_sn: JSValue = self._pop();
        if jsv_is_bigint_cell(a_sn) and jsv_is_bigint_cell(b_sn) {
            self._push(js_boolean(not js_bigint_cells_equal(a_sn, b_sn)));
            return;
        }
        self._push(js_boolean(not self._vm_strict_eq(a_sn, b_sn)));
    }

    """Strict equality with heap-string awareness.

    Interned strings compare by id (fast, handled inside js_strict_equal), but
    two computed (heap) strings with equal content have different ids, so string
    operands are compared by content here. Only differing ids reach the content
    compare; equal ids short-circuit."""
    def _vm_strict_eq(a: JSValue, b: JSValue) -> bool {
        if jsv_is_string_cell(a) and jsv_is_string_cell(b) {
            aid: int = jsv_to_table_id(a);
            bid: int = jsv_to_table_id(b);
            if aid == bid {
                return True;
            }
            # Two interned strings are equal only when their ids are (interning
            # maps equal text to one id); only a heap string needs the text.
            if aid < HEAP_STRING_BASE and bid < HEAP_STRING_BASE {
                return False;
            }
            return str_from_id(aid) == str_from_id(bid);
        }
        return js_strict_equal(a, b);
    }

    """Relational operator core (ES §7.2.13 / §13.10). `mode`: 0=`<`, 1=`>`, 2=`<=`,
    3=`>=`. ToPrimitive(number) each object operand, reject a Symbol operand (unless it's
    a pure String<String compare) with a TypeError, then use the 3-state IsLessThan so an
    incomparable pair (NaN, or String-not-a-BigInt) yields false for every operator."""
    def _op_relational(
        frame: CallFrame, st: ExecState, a: JSValue, b: JSValue, mode: int
    ) -> None {
        if self._needs_num_coerce(a) or self._needs_num_coerce(b) {
            a = self._to_number_primitive(a, frame, st);
            if self._coerce_diverted {
                return;
            }
            b = self._to_number_primitive(b, frame, st);
            if self._coerce_diverted {
                return;
            }
        }
        both_str: bool = jsv_is_string_cell(a) and jsv_is_string_cell(b);
        if not both_str and (jsv_is_symbol(a) or jsv_is_symbol(b)) {
            self._raise_exc(
                frame, st, make_type_error("Cannot convert a Symbol value to a number")
            );
            return;
        }
        if mode == 0 {
            self._push(js_boolean(_js_lt3(a, b) == 1));
        } elif mode == 1 {  # a <  b
            self._push(js_boolean(_js_lt3(b, a) == 1));
        } elif mode == 2 {  # a >  b
            self._push(js_boolean(_js_lt3(b, a) == 0));
        } else {  # a <= b  (¬(b<a), comparable)
            self._push(js_boolean(_js_lt3(a, b) == 0));
        }  # a >= b  (¬(a<b), comparable)
    }

    def _op_lt(frame: CallFrame, ins: Instruction, st: ExecState) {
        b_lt: JSValue = self._pop();
        a_lt: JSValue = self._pop();
        self._op_relational(frame, st, a_lt, b_lt, 0);
    }

    def _op_lte(frame: CallFrame, ins: Instruction, st: ExecState) {
        b_le: JSValue = self._pop();
        a_le: JSValue = self._pop();
        self._op_relational(frame, st, a_le, b_le, 2);
    }

    def _op_gt(frame: CallFrame, ins: Instruction, st: ExecState) {
        b_gt: JSValue = self._pop();
        a_gt: JSValue = self._pop();
        self._op_relational(frame, st, a_gt, b_gt, 1);
    }

    def _op_gte(frame: CallFrame, ins: Instruction, st: ExecState) {
        b_ge: JSValue = self._pop();
        a_ge: JSValue = self._pop();
        self._op_relational(frame, st, a_ge, b_ge, 3);
    }

    def _op_instanceof(frame: CallFrame, ins: Instruction, st: ExecState) {
        right_io: JSValue = self._pop();
        left_io: JSValue = self._pop();
        # Fast path: built-in constructors store type via markers on instances,
        # making prototype-chain walk unnecessary. Handles Array/Map/Set/Date/
        # WeakMap/WeakSet/Promise created with js_callable_create (KEY_CTOR_KIND)
        # or js_native_val (is_native_val).
        inst_handled: bool = False;
        inst_ck: int = -1;
        if is_native_val(right_io) {
            inst_ck = get_native_kind(right_io);
        } elif jsv_is_object_cell(right_io)
            and jsv_to_table_id(right_io) > 0
            and js_object_has_own(right_io, KEY_CTOR_KIND) {
            inst_ck = jsv_to_int32(js_object_get(right_io, KEY_CTOR_KIND));
        }
        if inst_ck == NATIVE_KIND_ARRAY {
            self._push(js_boolean(js_is_array(left_io)));
            inst_handled = True;
        } elif inst_ck == NATIVE_KIND_MAP {
            self._push(js_boolean(js_is_map(left_io)));
            inst_handled = True;
        } elif inst_ck == NATIVE_KIND_SET {
            self._push(js_boolean(js_is_set(left_io)));
            inst_handled = True;
        } elif inst_ck == NATIVE_KIND_WEAKMAP {
            self._push(js_boolean(js_is_weakmap(left_io)));
            inst_handled = True;
        } elif inst_ck == NATIVE_KIND_WEAKSET {
            self._push(js_boolean(js_is_weakset(left_io)));
            inst_handled = True;
        } elif inst_ck == NATIVE_KIND_DATE {
            self._push(js_boolean(js_is_date(left_io)));
            inst_handled = True;
        } elif inst_ck == NATIVE_KIND_PROMISE {
            self._push(js_boolean(js_is_promise(left_io)));
            inst_handled = True;
        } elif inst_ck == NATIVE_KIND_ERROR {
            err_tgt_e: JSValue = get_error_proto();
            err_cur_e: JSValue = js_object_get_prototype(left_io);
            err_found_e: bool = False;
            err_d_e: int = 0;
            while err_d_e < 100 and not err_found_e {
                if not jsv_is_object_cell(err_cur_e) {
                    err_d_e = 100;
                } elif jsv_to_table_id(err_cur_e) == jsv_to_table_id(err_tgt_e) {
                    err_found_e = True;
                } else {
                    err_cur_e = js_object_get_prototype(err_cur_e);
                }
                err_d_e = err_d_e + 1;
            }
            self._push(js_boolean(err_found_e));
            inst_handled = True;
        } elif inst_ck == NATIVE_KIND_TYPE_ERROR {
            err_tgt_te: JSValue = get_type_error_proto();
            err_cur_te: JSValue = js_object_get_prototype(left_io);
            err_found_te: bool = False;
            err_d_te: int = 0;
            while err_d_te < 100 and not err_found_te {
                if not jsv_is_object_cell(err_cur_te) {
                    err_d_te = 100;
                } elif jsv_to_table_id(err_cur_te) == jsv_to_table_id(err_tgt_te) {
                    err_found_te = True;
                } else {
                    err_cur_te = js_object_get_prototype(err_cur_te);
                }
                err_d_te = err_d_te + 1;
            }
            self._push(js_boolean(err_found_te));
            inst_handled = True;
        } elif inst_ck == NATIVE_KIND_REFERENCE_ERROR {
            err_tgt_re: JSValue = get_reference_error_proto();
            err_cur_re: JSValue = js_object_get_prototype(left_io);
            err_found_re: bool = False;
            err_d_re: int = 0;
            while err_d_re < 100 and not err_found_re {
                if not jsv_is_object_cell(err_cur_re) {
                    err_d_re = 100;
                } elif jsv_to_table_id(err_cur_re) == jsv_to_table_id(err_tgt_re) {
                    err_found_re = True;
                } else {
                    err_cur_re = js_object_get_prototype(err_cur_re);
                }
                err_d_re = err_d_re + 1;
            }
            self._push(js_boolean(err_found_re));
            inst_handled = True;
        } elif inst_ck == NATIVE_KIND_SYNTAX_ERROR {
            err_tgt_se: JSValue = get_syntax_error_proto();
            err_cur_se: JSValue = js_object_get_prototype(left_io);
            err_found_se: bool = False;
            err_d_se: int = 0;
            while err_d_se < 100 and not err_found_se {
                if not jsv_is_object_cell(err_cur_se) {
                    err_d_se = 100;
                } elif jsv_to_table_id(err_cur_se) == jsv_to_table_id(err_tgt_se) {
                    err_found_se = True;
                } else {
                    err_cur_se = js_object_get_prototype(err_cur_se);
                }
                err_d_se = err_d_se + 1;
            }
            self._push(js_boolean(err_found_se));
            inst_handled = True;
        } elif inst_ck == NATIVE_KIND_RANGE_ERROR {
            err_tgt_rge: JSValue = get_range_error_proto();
            err_cur_rge: JSValue = js_object_get_prototype(left_io);
            err_found_rge: bool = False;
            err_d_rge: int = 0;
            while err_d_rge < 100 and not err_found_rge {
                if not jsv_is_object_cell(err_cur_rge) {
                    err_d_rge = 100;
                } elif jsv_to_table_id(err_cur_rge) == jsv_to_table_id(err_tgt_rge) {
                    err_found_rge = True;
                } else {
                    err_cur_rge = js_object_get_prototype(err_cur_rge);
                }
                err_d_rge = err_d_rge + 1;
            }
            self._push(js_boolean(err_found_rge));
            inst_handled = True;
        } elif inst_ck == NATIVE_KIND_URI_ERROR {
            err_tgt_urie: JSValue = get_uri_error_proto();
            err_cur_urie: JSValue = js_object_get_prototype(left_io);
            err_found_urie: bool = False;
            err_d_urie: int = 0;
            while err_d_urie < 100 and not err_found_urie {
                if not jsv_is_object_cell(err_cur_urie) {
                    err_d_urie = 100;
                } elif jsv_to_table_id(err_cur_urie) == jsv_to_table_id(err_tgt_urie) {
                    err_found_urie = True;
                } else {
                    err_cur_urie = js_object_get_prototype(err_cur_urie);
                }
                err_d_urie = err_d_urie + 1;
            }
            self._push(js_boolean(err_found_urie));
            inst_handled = True;
        }
        if not inst_handled {
            io_ip_before: int = frame.ip;
            io_result: JSValue = self._eval_instanceof_general(
                frame, left_io, right_io
            );
            if self.had_exception {
                st.running = False;
            } elif frame.ip == io_ip_before {
                # No exception and no unwind jump — normal result.
                self._push(io_result);
            }
            # frame.ip changed → _unwind_in_frame caught the error and pushed
            # the exception value; do not push io_result.
        }
    }

    def _op_in(frame: CallFrame, ins: Instruction, st: ExecState) -> None {
        b_in: JSValue = self._pop();
        a_in: JSValue = self._pop();
        in_pk: int = jsval_to_prop_key(a_in);
        # ES §13.10.2 RelationalExpression `in`: the RHS must be an Object, else TypeError
        # (`"x" in 1` / `#f in null` throw). A Proxy is an object; functions/natives are too.
        if not (
            js_is_proxy(b_in)
            or jsv_is_any_object(b_in)
            or is_fn_val(b_in)
            or is_native_val(b_in)
        ) {
            exc_in_obj: JSValue = make_type_error(
                "Cannot use 'in' operator to search in " + jsv_coerce_to_str(b_in)
            );
            if not self._unwind_in_frame(frame, exc_in_obj) {
                self.had_exception = True;
                self.pending_exc = exc_in_obj;
                st.running = False;
            }
            return;
        }
        if js_is_proxy(b_in) {
            in_h: bool = proxy_trap_has(self, b_in, in_pk);
            in_exc_unwound: bool = False;
            if vm_has_native_exc() {
                exc_in: JSValue = vm_take_native_exc();
                if self._unwind_in_frame(frame, exc_in) {
                    in_exc_unwound = True;
                } else {
                    self.had_exception = True;
                    self.pending_exc = exc_in;
                    st.running = False;
                }
            }
            if not in_exc_unwound {
                self._push(js_boolean(in_h));
            }
        } else {
            self._push(js_boolean(self.obs_has(b_in, in_pk)));
        }

        # ── Logic ─────────────────────────────────────────────────────
    }

    def _op_not(frame: CallFrame, ins: Instruction, st: ExecState) {
        a_no: JSValue = self._pop();
        self._push(js_boolean(not jsv_coerce_to_bool(a_no)));
    }

    """typeof of an object cell — _op_typeof's object branches: the class /
    native-constructor / resolve-reject markers and callable Proxies are
    "function", a Proxy without [[Call]] "object", else js_typeof."""
    def _typeof_obj_cell(a: JSValue) -> str {
        to_id: int = jsv_to_table_id(a);
        if to_id > 0 and js_object_has_own(a, KEY_CTOR_KIND) {
            return "function";
        }
        if to_id >= 0 and js_object_has_own(a, WK_IS_CLASS) {
            return "function";
        }
        if to_id > 0 and js_is_resolve_fn(a) {
            return "function";
        }
        if to_id > 0 and js_is_reject_fn(a) {
            return "function";
        }
        if js_is_proxy(a) {
            if js_proxy_is_callable(a) {
                return "function";
            }
            return "object";
        }
        return js_typeof(a);
    }

    def _op_typeof(frame: CallFrame, ins: Instruction, st: ExecState) {
        a_ty: JSValue = self._pop();
        ty_r: str = "";
        if is_fn_val(a_ty) {
            ty_r = "function";
        } elif is_native_val(a_ty) {
            ty_r = "function";
        } elif jsv_is_object_cell(a_ty)
            and jsv_to_table_id(a_ty) > 0
            and js_object_has_own(a_ty, KEY_CTOR_KIND) {
            ty_r = "function";
        } elif jsv_is_object_cell(a_ty)
            and jsv_to_table_id(a_ty) >= 0
            and js_object_has_own(a_ty, WK_IS_CLASS) {
            ty_r = "function";
        }
        # The resolve/reject pair handed to a Promise executor are marker objects the
        # CALL handlers intercept, not fn cells — but §27.2.1.3 makes them ordinary
        # functions, and JS-level code (Promise combinators, user capability shims)
        # legitimately gates on `typeof resolve === "function"` before calling them.
        elif jsv_is_object_cell(a_ty)
            and jsv_to_table_id(a_ty) > 0
            and js_is_resolve_fn(a_ty) {
            ty_r = "function";
        } elif jsv_is_object_cell(a_ty)
            and jsv_to_table_id(a_ty) > 0
            and js_is_reject_fn(a_ty) {
            ty_r = "function";
        } elif js_is_proxy(a_ty) {
            # typeof Proxy is "function" iff [[Call]] was present at ProxyCreate, even
            # after revocation (ES §7.1.14 / §9.5 / test262 create-target-is-revoked-function-proxy).
            # js_proxy_is_callable captures callability at creation, so a revoked
            # callable proxy still reports "function" (a target-callable check would not).
            if js_proxy_is_callable(a_ty) {
                ty_r = "function";
            } else {
                ty_r = "object";
            }
        } else {
            ty_r = js_typeof(a_ty);
        }
        self._push(_vm_typeof_str(ty_r));
    }

    def _op_void(frame: CallFrame, ins: Instruction, st: ExecState) {
        self._pop();
        self._push(js_undefined());
    }

    def _op_delete(frame: CallFrame, ins: Instruction, st: ExecState) -> None {
        # Computed delete: delete obj[expr]
        # Stack on entry: [..., obj, key]
        di_key: JSValue = self._pop();
        di_obj: JSValue = self._pop();
        # RequireObjectCoercible on the base: `delete null[x]` / `delete undefined[x]`
        # throws TypeError (ES §13.5.1.2), mirroring the dot-delete path.
        if jsv_is_null(di_obj) or jsv_is_undefined(di_obj) {
            exc_din: JSValue = make_type_error(
                "Cannot convert undefined or null to object"
            );
            if not self._unwind_in_frame(frame, exc_din) {
                self.had_exception = True;
                self.pending_exc = exc_din;
                st.running = False;
            }
            return;
        }
        di_result: bool = True;
        if is_native_val(di_obj) {
            # Configurable name/length tombstones + props-store keys (R3b).
            di_pk_n: int = jsval_to_prop_key(di_key);
            di_result = native_delete_own(di_obj, di_pk_n);
            if not di_result and ins.arg2 == 1 {
                di_key_str_n: str = jsval_to_str(di_key);
                exc_di_nat: JSValue = make_type_error(
                    "Cannot delete property '" + di_key_str_n + "'"
                );
                if not self._unwind_in_frame(frame, exc_di_nat) {
                    self.had_exception = True;
                    self.pending_exc = exc_di_nat;
                    st.running = False;
                }
            } else {
                self._push(js_boolean(di_result));
            }
        } elif is_fn_val(di_obj) {
            di_pk_fn: int = jsval_to_prop_key(di_key);
            di_fn_idx: int = get_fn_idx(di_obj);
            if di_pk_fn == WK_NAME or di_pk_fn == WK_LENGTH {
                if di_fn_idx >= 0 and di_fn_idx < len(self.realm.closures) {
                    di_fn_cl: JSClosure = self.realm.closures[di_fn_idx];
                    if di_pk_fn == WK_NAME {
                        di_fn_cl.name_removed = True;
                    } else {
                        di_fn_cl.length_removed = True;
                    }
                    di_result = True;
                } else {
                    di_result = False;
                }
            } elif di_fn_idx >= 0 and di_fn_idx < len(self.realm.closures) {
                di_fn_fp: JSValue = self.realm.closures[di_fn_idx].fn_props;
                if jsv_is_object_cell(di_fn_fp) and jsv_to_table_id(di_fn_fp) > 0 {
                    di_result = js_object_delete(di_fn_fp, di_pk_fn);
                } else {
                    di_result = True;
                }
            } else {
                di_result = True;
            }
            if not di_result and ins.arg2 == 1 {
                di_key_str_fn: str = jsval_to_str(di_key);
                exc_di_fn: JSValue = make_type_error(
                    "Cannot delete property '" + di_key_str_fn + "'"
                );
                if not self._unwind_in_frame(frame, exc_di_fn) {
                    self.had_exception = True;
                    self.pending_exc = exc_di_fn;
                    st.running = False;
                }
            } else {
                self._push(js_boolean(di_result));
            }
        } elif jsv_is_object_cell(di_obj) and jsv_to_table_id(di_obj) > 0 {
            di_pk: int = jsval_to_prop_key(di_key);
            di_exc_unwound: bool = False;
            if js_is_proxy(di_obj) {
                di_result = proxy_trap_delete(self, di_obj, di_pk);
                if vm_has_native_exc() {
                    exc_di: JSValue = vm_take_native_exc();
                    if self._unwind_in_frame(frame, exc_di) {
                        di_exc_unwound = True;
                    } else {
                        self.had_exception = True;
                        self.pending_exc = exc_di;
                        st.running = False;
                    }
                    di_result = False;
                }
            } else {
                # TypedArray exotic [[Delete]] + string exotic + ordinary — via obs_delete.
                di_result = self.obs_delete(di_obj, di_pk);
                if vm_has_native_exc() {
                    exc_di_ta: JSValue = vm_take_native_exc();
                    if self._unwind_in_frame(frame, exc_di_ta) {
                        di_exc_unwound = True;
                    } else {
                        self.had_exception = True;
                        self.pending_exc = exc_di_ta;
                        st.running = False;
                    }
                    di_result = False;
                }
            }
            if di_result
                and jsv_is_object_cell(_REQUIRE_CACHE_OBJ)
                and jsv_is_object_cell(di_obj) {
                if jsv_to_table_id(di_obj) == jsv_to_table_id(_REQUIRE_CACHE_OBJ)
                    and jsv_is_string_cell(di_key) {
                    module_cache_delete(str_from_id(jsv_to_table_id(di_key)));
                }
            }
            if not di_exc_unwound {
                if not di_result and ins.arg2 == 1 {
                    di_key_str: str = jsval_to_str(di_key);
                    exc_di_st: JSValue = make_type_error(
                        "Cannot delete property '" + di_key_str + "'"
                    );
                    if not self._unwind_in_frame(frame, exc_di_st) {
                        self.had_exception = True;
                        self.pending_exc = exc_di_st;
                        st.running = False;
                    }
                } else {
                    self._push(js_boolean(di_result));
                }
            }
        } else {
            self._push(js_true());
        }

        # ── Control ───────────────────────────────────────────────────
    }

    """`delete <Identifier>` for a bare global name (ES §13.5.1.2 → §9.1.1.4.5
    DeleteBinding on the global environment).  Result: false if `name` is a
    non-configurable own property of globalThis (built-ins like NaN / Math.E, or a
    var-declared global); otherwise delete it (from globalThis and the user-global
    map) and return true, or true when unresolvable.  The compiler only emits this
    for names it could not prove are local/var bindings (those get LOAD_FALSE)."""
    def _op_del_name(frame: CallFrame, ins: Instruction, st: ExecState) -> None {
        dn_name: str = frame.func.constants.get(ins.arg);
        dn_key: int = str_intern(dn_name);
        dn_result: bool = True;
        # `delete name` inside a `with` block resolves against the object environment
        # record first (ES §13.5.1.2 → §9.1.1.2.5 DeleteBinding): if a with-object on
        # the scope chain binds the name (honouring @@unscopables), delete from THAT
        # object, not from the global environment.
        dn_wobj: JSValue = self._with_resolve(frame, dn_name);
        if jsv_is_object_cell(dn_wobj) {
            self._push(js_boolean(js_object_delete(dn_wobj, dn_key)));
            return;
        }
        # Sandbox code deletes from the sandbox only — the host globals map is
        # not part of a contextified global environment.
        dn_ctx: JSValue = self._frame_ctx_global(frame);
        if dn_ctx != 0 {
            if js_object_has_own(dn_ctx, dn_key) {
                self._push(js_boolean(js_object_delete(dn_ctx, dn_key)));
            } else {
                self._push(js_true());
            }
            return;
        }
        gthis: JSValue = self.global_this;
        if jsv_is_object_cell(gthis)
            and jsv_to_table_id(gthis) > 0
            and js_object_has_own(gthis, dn_key) {
            # js_object_delete respects [[Configurable]]: false stays, else removed.
            dn_result = js_object_delete(gthis, dn_key);
            if dn_result and dn_name in self.globals {
                del self.globals[dn_name];
                self.gw_epoch = self.gw_epoch + 1;
            }
        } elif dn_name in self.globals {
            # A plain global-map binding (no descriptor) is configurable → deletable.
            del self.globals[dn_name];
            self.gw_epoch = self.gw_epoch + 1;
            dn_result = True;
        } else {
            # Unresolvable reference → delete evaluates to true.
            dn_result = True;
        }
        self._push(js_boolean(dn_result));
    }

    def _op_jump(frame: CallFrame, ins: Instruction, st: ExecState) {
        frame.ip = ins.arg;
    }

    def _op_jump_if_true(frame: CallFrame, ins: Instruction, st: ExecState) {
        cjt: JSValue = self._pop();
        if jsv_coerce_to_bool(cjt) {
            frame.ip = ins.arg;
        }
    }

    def _op_jump_if_false(frame: CallFrame, ins: Instruction, st: ExecState) {
        cjf: JSValue = self._pop();
        if not jsv_coerce_to_bool(cjf) {
            frame.ip = ins.arg;
        }
    }

    def _op_jump_if_null(frame: CallFrame, ins: Instruction, st: ExecState) {
        vjn: JSValue = self._peek();
        if jsv_is_null(vjn) {
            frame.ip = ins.arg;
        }
    }

    def _op_jump_if_undefined(frame: CallFrame, ins: Instruction, st: ExecState) {
        vju: JSValue = self._peek();
        if jsv_is_undefined(vju) {
            frame.ip = ins.arg;
        }

        # ── Functions ─────────────────────────────────────────────────
    }

    """TAIL_CALL — a call in tail position (ES §15.10.3). For a plain JS-function callee,
    stage the call into the VM tail channel and stop this frame's loop so run()'s trampoline
    re-enters the callee in the SAME native frame (O(1) stack for tail recursion). Any other
    callee (native/generator/async/bound/proxy/non-callable, incl. a real %eval%) is NOT a
    proper tail call here — fall back to the ordinary CALL semantics."""
    def _op_tail_call(frame: CallFrame, ins: Instruction, st: ExecState) -> None {
        tc_n: int = ins.arg;
        # Peek the callee (it sits just below the tc_n argument slots). Do NOT expand spreads
        # yet — the fallback re-runs _op_call which expects the raw pre-expansion layout.
        tc_callee_idx: int = len(self.stack) - 1 - tc_n;
        tc_eligible: bool = False;
        if tc_callee_idx >= 0 {
            tc_callee_peek: JSValue = self.stack[tc_callee_idx];
            if is_fn_val(tc_callee_peek) {
                tc_cl: JSClosure = self.realm.closures[get_fn_idx(tc_callee_peek)];
                # Only an ORDINARY JS function is a trampoline-eligible tail callee: napi,
                # bound, generator, and async functions have bespoke call setup handled by
                # _op_call and are left to it.
                if tc_cl.napi_cb_ptr == 0
                    and not tc_cl.func.is_bound
                    and not tc_cl.func.is_generator
                    and not tc_cl.func.is_async {
                    tc_eligible = True;
                }
            }
        }
        if st.inline_depth > 0 {
            # The native tail-call trampoline lives in run() - from an INLINE
            # frame it would discard the wrong native level. Instead the inline
            # frame is replaced in this loop: its callee and arguments move down
            # to its stack base, it goes back to the pool, and the callee is
            # entered inline in its place — the frame count stays flat, and the
            # callee's result lands where this frame's would have. A callee that
            # cannot run inline (or a spread / `with` / try / `using` context)
            # gets an ordinary CALL (it runs natively; its own tail calls then
            # use run()'s trampoline, so depth stays bounded).
            if tc_eligible
                and (ins.arg3 & 8) == 0
                and len(frame.with_objs) == 0
                and len(frame.catch_stack) == 0
                and len(frame.dispose_stack) == 0
                and not frame.discard_ret
                and not jsv_is_hole(
                    self._inline_this(
                        self.realm.closures[get_fn_idx(self.stack[tc_callee_idx])],
                        self.stack[tc_callee_idx],
                        js_undefined(),
                        st
                    )
                ) {
                self._inline_tail_pop(tc_callee_idx, tc_n, st);
                tc_ci: int = len(self.stack) - 1 - tc_n;
                if not self._inline_call_from_stack(
                    self.realm.closures[get_fn_idx(self.stack[tc_ci])],
                    self.stack[tc_ci],
                    js_undefined(),
                    tc_n,
                    1,
                    st
                ) {
                    # (Eligibility was checked above; kept as a plain call.)
                    self._op_call(self.frames[len(self.frames) - 1], ins, st);
                    st.frame_switched = True;
                }
                return;
            }
            tc_eligible = False;
        }
        if not tc_eligible {
            # Not a proper tail call — behave exactly like CALL (same operands).
            self._op_call(frame, ins, st);
            return;
        }
        # Pop args (reverse) then callee, expand spreads — mirrors _op_call.
        tc_args: list[JSValue] = [];
        tc_ai: int = 0;
        while tc_ai < tc_n {
            tc_args.append(self._pop());
            tc_ai = tc_ai + 1;
        }
        tc_ai = 0;
        tc_hi: int = tc_n - 1;
        while tc_ai < tc_hi {
            tc_sw: JSValue = tc_args[tc_ai];
            tc_args[tc_ai] = tc_args[tc_hi];
            tc_args[tc_hi] = tc_sw;
            tc_ai = tc_ai + 1;
            tc_hi = tc_hi - 1;
        }
        if (ins.arg3 & 8) != 0 {
            tc_args = _expand_spreads(tc_args);
        }
        tc_callee: JSValue = self._pop();
        # With-object `this` for an unqualified tail call `f()` inside `with` (mirrors _op_call).
        tc_this: JSValue = js_undefined();
        if ins.arg2 > 0 and len(frame.with_objs) > 0 {
            tc_wn: str = frame.func.constants.get(ins.arg2 - 1);
            tc_wb: JSValue = self._with_resolve_range(
                frame, tc_wn, 0, len(frame.with_objs)
            );
            if vm_has_native_exc() {
                exc_tcw: JSValue = vm_take_native_exc();
                if not self._unwind_in_frame(frame, exc_tcw) {
                    self.had_exception = True;
                    self.pending_exc = exc_tcw;
                    st.running = False;
                }
                return;
            }
            if jsv_is_object_cell(tc_wb) {
                tc_this = tc_wb;
            }
        }
        # Stage the tail call and stop the loop — run()'s trampoline takes over.
        self._tail_closure = tc_callee;
        self._tail_this = tc_this;
        self._tail_args = tc_args;
        st.tail_pending = True;
        st.running = False;
    }

    def _op_call(frame: CallFrame, ins: Instruction, st: ExecState) -> None {
        nc_call: int = ins.arg;
        # Plain JS→JS call: a closure callee that is not NAPI / bound / generator /
        # async, no spread, no `with` this-binding — exactly the calls the general
        # path below hands to _inline_call with an undefined `this`. Inline it from
        # the operand stack without building an argument list (one allocation and
        # N appends + pops per call); anything else falls through untouched.
        if (ins.arg3 & 8) == 0 and len(frame.with_objs) == 0 {
            fc_sl: int = len(self.stack) - nc_call - 1;
            if fc_sl >= 0 {
                fc_callee: JSValue = self.stack[fc_sl];
                if not js_is_proxy(fc_callee)
                    and not jsv_is_htmldda(fc_callee)
                    and not is_native_val(fc_callee)
                    and is_fn_val(fc_callee) {
                    # The closure goes in as a borrowed list element (no local, so
                    # no retain/release); NAPI / bound / generator / async callees
                    # are rejected inside.
                    if self._reg_ready(
                        self.realm.closures[get_fn_idx(fc_callee)].func
                    ) {
                        if self._reg_call_from_stack(
                            self.realm.closures[get_fn_idx(fc_callee)],
                            fc_callee,
                            js_undefined(),
                            nc_call,
                            1,
                            frame,
                            st
                        ) {
                            return;
                        }
                    }
                    if self._inline_call_from_stack(
                        self.realm.closures[get_fn_idx(fc_callee)],
                        fc_callee,
                        js_undefined(),
                        nc_call,
                        1,
                        st
                    ) {
                        return;
                    }
                }
            }
        }
        # Single-allocation arg marshalling + gated spread expansion
        # (call_path_impl_plan Phase 1): pop into ONE list, reverse in place
        # (the old tmp+reverse-copy cost a second allocation + N appends per
        # call), and only scan for spreads when the compiler flagged one
        # (arg3 bit 3) — the unconditional scan did a has_own probe per
        # object argument per call.
        args_c: list[JSValue] = [];
        ac: int = 0;
        while ac < nc_call {
            args_c.append(self._pop());
            ac = ac + 1;
        }
        ac = 0;
        tmp_c_hi: int = nc_call - 1;
        while ac < tmp_c_hi {
            tmp_c_sw: JSValue = args_c[ac];
            args_c[ac] = args_c[tmp_c_hi];
            args_c[tmp_c_hi] = tmp_c_sw;
            ac = ac + 1;
            tmp_c_hi = tmp_c_hi - 1;
        }
        if (ins.arg3 & 8) != 0 {
            args_c = _expand_spreads(args_c);
        }
        callee: JSValue = self._pop();
        if js_is_proxy(callee) {
            res_pxy_call: JSValue = self._proxy_trap_apply(
                callee, js_undefined(), args_c
            );
            if vm_has_native_exc() {
                exc_pxc: JSValue = vm_take_native_exc();
                if not self._unwind_in_frame(frame, exc_pxc) {
                    self.had_exception = True;
                    self.pending_exc = exc_pxc;
                    st.running = False;
                }
            } elif self.had_exception {
                exc_pxc2: JSValue = self.pending_exc;
                self.had_exception = False;
                self.pending_exc = js_undefined();
                if not self._unwind_in_frame(frame, exc_pxc2) {
                    self.had_exception = True;
                    self.pending_exc = exc_pxc2;
                    st.running = False;
                }
            } else {
                self._push(res_pxy_call);
            }
        } elif jsv_is_htmldda(callee) {
            self._push(js_null());
        } elif is_native_val(callee) {
            # Must precede is_fn_val: native vals also have as_ptr < 0.
            kind_c: int = get_native_kind(callee);
            # Root the popped args for the native's duration (see _op_call_method).
            while len(frame.native_roots) > 0 {
                del frame.native_roots[len(frame.native_roots) - 1];
            }
            for nr_c in args_c {
                frame.native_roots.append(nr_c);
            }
            frame.rare = True;
            if kind_c == NATIVE_KIND_FUNCTION {
                # new Function(params..., body) — dynamic compile
                res_dyn: JSValue = _impl_js_Function(args_c);
                if not self._check_native_exc(frame, res_dyn) {
                    st.running = False;
                }
            } elif kind_c == NATIVE_KIND_REQUIRE
                or kind_c == NATIVE_KIND_BOUND_REQUIRE {
                # require(specifier) — module loading (needs VM access)
                req_spec: str = "";
                if len(args_c) > 0 and jsv_is_string_cell(args_c[0]) {
                    req_spec = str_from_id(jsv_to_table_id(args_c[0]));
                }
                saved_rp: str = "";
                if kind_c == NATIVE_KIND_BOUND_REQUIRE {
                    bid_c: int = require_native_bind_id(callee);
                    saved_rp = self.require_parent_override;
                    self.require_parent_override = require_bind_parent(bid_c);
                }
                # require()/createRequire() always use CJS semantics — never wrap
                # the result as an ESM namespace (even when called from an ESM module
                # currently being linked via static import).  Also clear
                # dynamic_import_active: a require() issued while an import() chain
                # is loading (e.g. createRequire inside a dynamically-imported
                # module) must not be promoted to esm-js semantics.
                saved_esm_req: int = self.require_is_esm;
                saved_dia_req: int = self.dynamic_import_active;
                self.require_is_esm = 0;
                self.dynamic_import_active = 0;
                self.sync_require_esm = self.sync_require_esm + 1;
                res_req: JSValue = self._require_module(req_spec);
                self.sync_require_esm = self.sync_require_esm - 1;
                self.require_is_esm = saved_esm_req;
                self.dynamic_import_active = saved_dia_req;
                if kind_c == NATIVE_KIND_BOUND_REQUIRE {
                    self.require_parent_override = saved_rp;
                }
                if self.had_exception {
                    exc_req: JSValue = self.pending_exc;
                    self.had_exception = False;
                    self.pending_exc = js_undefined();
                    if not self._unwind_in_frame(frame, exc_req) {
                        self.had_exception = True;
                        self.pending_exc = exc_req;
                        st.running = False;
                    }
                } else {
                    self._push(res_req);
                }
            } elif kind_c == NATIVE_KIND_REQUIRE_RESOLVE
                or kind_c == NATIVE_KIND_BOUND_REQUIRE_RESOLVE {
                # require.resolve(specifier) — resolve path without loading
                rr_spec2: str = "";
                if len(args_c) > 0 and jsv_is_string_cell(args_c[0]) {
                    rr_spec2 = str_from_id(jsv_to_table_id(args_c[0]));
                }
                saved_rp2: str = "";
                if kind_c == NATIVE_KIND_BOUND_REQUIRE_RESOLVE {
                    bid_r: int = require_native_bind_id(callee);
                    saved_rp2 = self.require_parent_override;
                    self.require_parent_override = require_bind_parent(bid_r);
                }
                pf_rr: str = _get_parent_file(self);
                # require.resolve is ALWAYS CJS resolution ("require" exports condition),
                # even when called from a module that is itself being evaluated under
                # import() — the ambient require_is_esm flag must not leak in. (Vite:
                # createRequire(...).resolve('rollup') inside its dynamically-imported
                # bundle picked rollup's "import" entry dist/es/rollup.js, so its
                # `resolve(entry, '../../package.json')` landed on the nonexistent
                # dist/package.json instead of the package root.)
                rerr_rr: JSValue = module_resolve_error(
                    rr_spec2, self.script_dir, pf_rr, 0
                );
                rr_result2: JSValue = js_undefined();
                if not jsv_is_undefined(rerr_rr) {
                    self.had_exception = True;
                    self.pending_exc = rerr_rr;
                } else {
                    rr_result2 = js_str(
                        module_resolve(rr_spec2, self.script_dir, pf_rr, 0)
                    );
                }
                if kind_c == NATIVE_KIND_BOUND_REQUIRE_RESOLVE {
                    self.require_parent_override = saved_rp2;
                }
                if self.had_exception {
                    exc_rr2: JSValue = self.pending_exc;
                    self.had_exception = False;
                    self.pending_exc = js_undefined();
                    if not self._unwind_in_frame(frame, exc_rr2) {
                        self.had_exception = True;
                        self.pending_exc = exc_rr2;
                        st.running = False;
                    }
                } else {
                    self._push(rr_result2);
                }
            } elif kind_c == NATIVE_KIND_REQUIRE_RESOLVE_PATHS {
                _handle_require_resolve_paths(self, args_c);
            } elif kind_c == NATIVE_KIND_MODULE_SYNC_BUILTIN_ESM {
                self._sync_builtin_esm_exports();
                self._push(js_undefined());
            } elif kind_c == NATIVE_KIND_MODULE_CREATE_REQUIRE {
                if not _handle_module_create_require(self, args_c, frame) {
                    st.running = False;
                }
            } elif kind_c == NATIVE_KIND_MODULE_COMPILE
                or kind_c == NATIVE_KIND_MODULE_EXT_JS
                or kind_c == NATIVE_KIND_MODULE_EXT_JSON
                or kind_c == NATIVE_KIND_MODULE_EXT_NODE {
                if not _handle_module_cjs_native(
                    self, kind_c, js_undefined(), args_c, frame
                ) {
                    st.running = False;
                }
            } elif kind_c == NATIVE_KIND_VM_CREATE_CONTEXT
                or kind_c == NATIVE_KIND_VM_IS_CONTEXT
                or kind_c == NATIVE_KIND_VM_RUN_IN_CONTEXT {
                if not _handle_vm_context_native(self, kind_c, args_c, frame) {
                    st.running = False;
                }
            } elif kind_c == NATIVE_KIND_VM_RUN_IN_THIS_CONTEXT {
                ritic_code: str = "";
                if len(args_c) > 0 and jsv_is_string_cell(args_c[0]) {
                    ritic_code = str_from_id(jsv_to_table_id(args_c[0]));
                }
                if len(args_c) > 1 and jsv_is_string_cell(args_c[1]) {
                    self.pending_ctx_filename = str_from_id(jsv_to_table_id(args_c[1]));
                }
                res_ritic: JSValue = self.run_in_this_context(ritic_code);
                self.pending_ctx_filename = "";
                if not self._check_native_exc(frame, res_ritic) {
                    st.running = False;
                }
            } elif kind_c == NATIVE_KIND_EVAL {
                if len(args_c) >= 1 and jsv_is_string_cell(args_c[0]) {
                    eval_src_c: str = str_from_id(jsv_to_table_id(args_c[0]));
                    # arg3 bit 4 = *direct* eval (bare `eval(...)`) → inherit caller
                    # scope/strict/super; otherwise indirect → inherit nothing.
                    # bits 1/2 = param-eval mode (B7).
                    eval_direct_c: bool = (ins.arg3 & 4) != 0;
                    eval_pmode_c: int = ins.arg3 & 3;
                    # eval called from sandbox code stays inside that sandbox — the
                    # host globals must not become reachable through `eval`.
                    self.pending_ctx_global = self._frame_ctx_global(frame);
                    # Cross-realm: an INDIRECT eval obtained from a foreign realm's global
                    # (`realm.global.eval`) evaluates its code IN THAT REALM (ES §19.2.1.1
                    # PerformEval / GetThisEnvironment), so code it creates belongs to that
                    # realm. Stamp the source realm so a brand-check TypeError uses the right
                    # %TypeError%. Direct eval inherits the caller's realm (the current one).
                    if not eval_direct_c {
                        self.pending_eval_source_realm = _home_realm_id_of_val(callee);
                    }
                    res_eval_c: JSValue = self.run_in_this_context_ex2(
                        eval_src_c, eval_direct_c, eval_pmode_c
                    );
                    self.pending_eval_source_realm = 0;
                    if not self._check_native_exc(frame, res_eval_c) {
                        st.running = False;
                    }
                } elif len(args_c) >= 1 {
                    self._push(args_c[0]);
                } else {
                    self._push(js_undefined());
                }
            } elif kind_c == NATIVE_KIND_STRING {
                # String(v) — ToPrimitive on Object args so toString() is called.
                sc_args: list[JSValue] = [];
                sc_i: int = 0;
                while sc_i < len(args_c) {
                    sc_v: JSValue = args_c[sc_i];
                    if jsv_is_object_cell(sc_v) {
                        sc_args.append(self._to_primitive_string(sc_v));
                    } else {
                        sc_args.append(sc_v);
                    }
                    sc_i = sc_i + 1;
                }
                res_sc: JSValue = _vm_call_native_proxy_aware(
                    self, self.realm, kind_c, js_undefined(), sc_args
                );
                if not self._check_native_exc(frame, res_sc) {
                    st.running = False;
                }
            } elif kind_c == NATIVE_KIND_MAP
                or kind_c == NATIVE_KIND_SET
                or kind_c == NATIVE_KIND_WEAKMAP
                or kind_c == NATIVE_KIND_WEAKSET {
                coll_nm_c: str = "Map";
                if kind_c == NATIVE_KIND_SET {
                    coll_nm_c = "Set";
                } elif kind_c == NATIVE_KIND_WEAKMAP {
                    coll_nm_c = "WeakMap";
                } elif kind_c == NATIVE_KIND_WEAKSET {
                    coll_nm_c = "WeakSet";
                }
                exc_coll_c: JSValue = make_type_error(
                    "Class constructor "
                        + coll_nm_c
                        + " cannot be invoked without 'new'"
                );
                if not self._unwind_in_frame(frame, exc_coll_c) {
                    self.had_exception = True;
                    self.pending_exc = exc_coll_c;
                    st.running = False;
                }
            } else {
                res_nat_c: JSValue = _vm_call_native_proxy_aware(
                    self, self.realm, kind_c, js_undefined(), args_c
                );
                if not self._check_native_exc(frame, res_nat_c) {
                    st.running = False;
                }
            }
        } elif jsv_is_object_cell(callee)
            and jsv_to_table_id(callee) > 0
            and js_object_has_own(callee, KEY_CTOR_KIND) {
            # Callable JSObject: constructor or static-method wrapper.
            ck_c: JSValue = js_object_get(callee, KEY_CTOR_KIND);
            ck_c_kind: int = jsv_to_int32(ck_c);
            if ck_c_kind == NATIVE_KIND_FUNCTION {
                # Function(params..., body) — dynamic compile (same path as native)
                res_ck_fn_c: JSValue = _impl_js_Function(args_c);
                if not self._check_native_exc(frame, res_ck_fn_c) {
                    st.running = False;
                }
            } elif ck_c_kind == NATIVE_KIND_STRING {
                # String(v) — ToPrimitive on Object args so toString() is called.
                ck_sc_args: list[JSValue] = [];
                ck_sc_i: int = 0;
                while ck_sc_i < len(args_c) {
                    ck_sc_v: JSValue = args_c[ck_sc_i];
                    if jsv_is_object_cell(ck_sc_v) {
                        ck_sc_args.append(self._to_primitive_string(ck_sc_v));
                    } else {
                        ck_sc_args.append(ck_sc_v);
                    }
                    ck_sc_i = ck_sc_i + 1;
                }
                res_ck_sc: JSValue = _vm_call_native_proxy_aware(
                    self, self.realm, ck_c_kind, js_undefined(), ck_sc_args
                );
                if not self._check_native_exc(frame, res_ck_sc) {
                    st.running = False;
                }
            } elif ck_c_kind == NATIVE_KIND_MAP
                or ck_c_kind == NATIVE_KIND_SET
                or ck_c_kind == NATIVE_KIND_WEAKMAP
                or ck_c_kind == NATIVE_KIND_WEAKSET {
                coll_nm_ck: str = "Map";
                if ck_c_kind == NATIVE_KIND_SET {
                    coll_nm_ck = "Set";
                } elif ck_c_kind == NATIVE_KIND_WEAKMAP {
                    coll_nm_ck = "WeakMap";
                } elif ck_c_kind == NATIVE_KIND_WEAKSET {
                    coll_nm_ck = "WeakSet";
                }
                exc_coll_ck: JSValue = make_type_error(
                    "Class constructor "
                        + coll_nm_ck
                        + " cannot be invoked without 'new'"
                );
                if not self._unwind_in_frame(frame, exc_coll_ck) {
                    self.had_exception = True;
                    self.pending_exc = exc_coll_ck;
                    st.running = False;
                }
            } elif ck_c_kind == NATIVE_KIND_EVAL {
                # A foreign realm's object-backed `eval` called as `e(src)` (e is a var). Always
                # INDIRECT — but code it creates belongs to the eval's source realm so a private
                # brand-check TypeError uses that realm's %TypeError% (cross-realm brand-check).
                # Route through the normal indirect-eval path (run_in_this_context_ex2), NOT
                # _vm_call_native_proxy_aware, whose eval entry mis-reads the source.
                if len(args_c) >= 1 and jsv_is_string_cell(args_c[0]) {
                    ev_ck_src: str = str_from_id(jsv_to_table_id(args_c[0]));
                    # ES §19.2.1.1: a foreign realm's indirect eval runs GLOBAL code in THAT
                    # realm — its top-level `var`/global writes bind in the foreign realm's global
                    # object, NOT the caller's (eval-realm-indirect). Route via the ctx-global
                    # channel; pending_ctx_realm_only keeps ordinary global-code semantics.
                    ev_ck_rid: int = _home_realm_id_of_val(callee);
                    self.pending_eval_source_realm = ev_ck_rid;
                    if ev_ck_rid != 0 and realm_is_registered(ev_ck_rid) {
                        self.pending_ctx_global = realm_lookup(ev_ck_rid).global_this;
                        self.pending_ctx_realm_only = True;
                    } else {
                        self.pending_ctx_global = self._frame_ctx_global(frame);
                    }
                    res_ev_ck: JSValue = self.run_in_this_context_ex2(
                        ev_ck_src, False, 0
                    );
                    self.pending_eval_source_realm = 0;
                    self.pending_ctx_realm_only = False;
                    if not self._check_native_exc(frame, res_ev_ck) {
                        st.running = False;
                    }
                } elif len(args_c) >= 1 {
                    self._push(args_c[0]);
                } else {
                    self._push(js_undefined());
                }
            } else {
                res_ck_c: JSValue = _vm_call_native_proxy_aware(
                    self, self.realm, ck_c_kind, js_undefined(), args_c
                );
                if not self._check_native_exc(frame, res_ck_c) {
                    st.running = False;
                }
            }
        } elif jsv_is_object_cell(callee)
            and jsv_to_table_id(callee) > 0
            and js_is_resolve_fn(callee) {
            val_res: JSValue = js_undefined();
            if len(args_c) > 0 {
                val_res = args_c[0];
            }
            p_ref_res: JSValue = js_object_get(callee, _KEY_PROMISE_REF);
            if js_is_promise(p_ref_res) {
                self._promise_resolve_value(p_ref_res, val_res);
            }
            self._push(js_undefined());
        } elif jsv_is_object_cell(callee)
            and jsv_to_table_id(callee) > 0
            and js_is_reject_fn(callee) {
            reason_rej: JSValue = js_undefined();
            if len(args_c) > 0 {
                reason_rej = args_c[0];
            }
            p_ref_rej: JSValue = js_object_get(callee, _KEY_PROMISE_REF);
            if js_is_promise(p_ref_rej) {
                self._promise_settle_and_drain(p_ref_rej, PROMISE_REJECTED, reason_rej);
            }
            self._push(js_undefined());
        } elif jsv_is_object_cell(callee)
            and jsv_to_table_id(callee) > 0
            and js_is_promise_all_resolve_elem(callee) {
            val_pa: JSValue = js_undefined();
            if len(args_c) > 0 {
                val_pa = args_c[0];
            }
            _vm_promise_all_resolve_call(self, callee, val_pa);
            self._push(js_undefined());
        } elif jsv_is_object_cell(callee)
            and jsv_to_table_id(callee) > 0
            and js_is_promise_all_reject_elem(callee) {
            reason_pa: JSValue = js_undefined();
            if len(args_c) > 0 {
                reason_pa = args_c[0];
            }
            _vm_promise_all_reject_call(self, callee, reason_pa);
            self._push(js_undefined());
        } elif jsv_is_object_cell(callee)
            and jsv_to_table_id(callee) > 0
            and (
                js_is_promise_allsettled_resolve_elem(callee)
                or js_is_promise_allsettled_reject_elem(callee)
                or js_is_promise_any_reject_elem(callee)
            ) {
            val_as: JSValue = js_undefined();
            if len(args_c) > 0 {
                val_as = args_c[0];
            }
            _vm_promise_combinator_elem_call(self, callee, val_as);
            self._push(js_undefined());
        } elif is_fn_val(callee) {
            cl_c: JSClosure = self.realm.closures[get_fn_idx(callee)];
            # ES §13.3.6.1 / §9.1: an unqualified call `f()` whose callee name resolves through
            # a `with` object passes that object as the `this` value (its WithBaseObject), not
            # undefined (with-base-obj). Compute it from the callee name (arg2 = name idx + 1)
            # against the active with-scope chain; js_undefined() when the name is not with-bound.
            call_this_c: JSValue = js_undefined();
            if ins.arg2 > 0 and len(frame.with_objs) > 0 {
                cwn_c: str = frame.func.constants.get(ins.arg2 - 1);
                cwb_c: JSValue = self._with_resolve_range(
                    frame, cwn_c, 0, len(frame.with_objs)
                );
                if vm_has_native_exc() {
                    exc_cwb: JSValue = vm_take_native_exc();
                    if not self._unwind_in_frame(frame, exc_cwb) {
                        self.had_exception = True;
                        self.pending_exc = exc_cwb;
                        st.running = False;
                    }
                    return;
                }
                if jsv_is_object_cell(cwb_c) {
                    call_this_c = cwb_c;
                }
            }
            # N4: NAPI native callback — dispatch to C without running the Jac interpreter
            if cl_c.napi_cb_ptr != 0 {
                args_int_c: list[int] = [];
                for a_nc in args_c {
                    args_int_c.append(a_nc);
                }
                napi_ret_c: int = _vm_invoke_napi_cb(
                    self,
                    cl_c.napi_cb_ptr,
                    cl_c.napi_cb_data,
                    self.global_this,
                    args_int_c,
                    0
                );
                # N6: propagate any NAPI-thrown exception into the VM
                if _napi_get_had_exception() {
                    exc_napi_c: JSValue = _napi_consume_exception();
                    if not self._unwind_in_frame(frame, exc_napi_c) {
                        self.had_exception = True;
                        self.pending_exc = exc_napi_c;
                        st.running = False;
                    }
                } else {
                    self._push(napi_ret_c);
                }
            } elif cl_c.func.is_bound {
                # Bound function: free_vals[0]=original fn, lexical_this=bound_this
                # Unwrap the entire binding chain (bound-of-bound):
                # inner-most bind determines the final this (first bind wins per spec).
                orig_fn_c: JSValue = js_undefined();
                if len(cl_c.free_vals) > 0 {
                    orig_fn_c = cl_c.free_vals[0];
                }
                bind_this_c: JSValue = cl_c.lexical_this;
                full_args_c: list[JSValue] = [];
                bfi_c: int = 1;
                while bfi_c < len(cl_c.free_vals) {
                    full_args_c.append(cl_c.free_vals[bfi_c]);
                    bfi_c = bfi_c + 1;
                }
                for ba_c in args_c {
                    full_args_c.append(ba_c);
                }
                # Recursively unwrap any further bound layers
                while is_fn_val(orig_fn_c) {
                    cl_inner_c: JSClosure = self.realm.closures[get_fn_idx(orig_fn_c)];
                    if not cl_inner_c.func.is_bound {
                        break;
                    }
                    # Inner bind: its lexical_this overrides (inner == "first" bind)
                    bind_this_c = cl_inner_c.lexical_this;
                    inner_partial_c: list[JSValue] = [];
                    ipi_c: int = 1;
                    while ipi_c < len(cl_inner_c.free_vals) {
                        inner_partial_c.append(cl_inner_c.free_vals[ipi_c]);
                        ipi_c = ipi_c + 1;
                    }
                    new_full_c: list[JSValue] = [];
                    for ip_c in inner_partial_c {
                        new_full_c.append(ip_c);
                    }
                    for fa_c in full_args_c {
                        new_full_c.append(fa_c);
                    }
                    full_args_c = new_full_c;
                    orig_fn_c = js_undefined();
                    if len(cl_inner_c.free_vals) > 0 {
                        orig_fn_c = cl_inner_c.free_vals[0];
                    }
                }
                if is_fn_val(orig_fn_c) {
                    # Route through _invoke_callable_value (not raw run_cl) so an ASYNC target
                    # still returns its Promise and a GENERATOR target yields a generator object
                    # (ES §27.7 / §27.5) — run_cl would run their bodies synchronously, so a
                    # bound async method/function returned the raw body value (test262
                    # class/async-method/returns-async-*: `c.method.bind(c)(1).then(...)`).
                    res_bd: JSValue = self._invoke_callable_value(
                        orig_fn_c, bind_this_c, full_args_c
                    );
                    if self.had_exception {
                        exc_bd: JSValue = self.pending_exc;
                        self.had_exception = False;
                        self.pending_exc = js_undefined();
                        if not self._unwind_in_frame(frame, exc_bd) {
                            self.had_exception = True;
                            self.pending_exc = exc_bd;
                            st.running = False;
                        }
                    } else {
                        self._push(res_bd);
                    }
                } elif is_native_val(orig_fn_c) {
                    kind_bd: int = get_native_kind(orig_fn_c);
                    if kind_bd == NATIVE_KIND_FN_CALL
                        or kind_bd == NATIVE_KIND_FN_APPLY
                        or kind_bd == NATIVE_KIND_FN_BIND {
                        # Bound meta-function (e.g. Function.prototype.call.bind(fn)):
                        # re-dispatch onto the target through _invoke_callable_value.
                        res_bd_meta: JSValue = self._invoke_callable_value(
                            orig_fn_c, bind_this_c, full_args_c
                        );
                        if self.had_exception {
                            exc_bd_meta: JSValue = self.pending_exc;
                            self.had_exception = False;
                            self.pending_exc = js_undefined();
                            if not self._unwind_in_frame(frame, exc_bd_meta) {
                                self.had_exception = True;
                                self.pending_exc = exc_bd_meta;
                                st.running = False;
                            }
                        } else {
                            self._push(res_bd_meta);
                        }
                    } else {
                        res_bd_n: JSValue = _vm_call_native_proxy_aware(
                            self, self.realm, kind_bd, bind_this_c, full_args_c
                        );
                        if not self._check_native_exc(frame, res_bd_n) {
                            st.running = False;
                        }
                    }
                } else {
                    # Target is an object-cell callable — a built-in constructor object
                    # (Number/String/Boolean/…, tagged KEY_CTOR_KIND), a user class, or
                    # a Proxy. _vm_invoke_callback runs [[Call]] for all of these (the
                    # same helper Reflect.apply uses); was silently pushing undefined.
                    res_bd_o: JSValue = _vm_invoke_callback(
                        self, orig_fn_c, bind_this_c, full_args_c
                    );
                    if self.had_exception {
                        exc_bd_o: JSValue = self.pending_exc;
                        self.had_exception = False;
                        self.pending_exc = js_undefined();
                        if not self._unwind_in_frame(frame, exc_bd_o) {
                            self.had_exception = True;
                            self.pending_exc = exc_bd_o;
                            st.running = False;
                        }
                    } elif vm_has_native_exc() {
                        if not self._check_native_exc(frame, res_bd_o) {
                            st.running = False;
                        }
                    } else {
                        self._push(res_bd_o);
                    }
                }
            } else {
                # Generator function: create a generator object, don't run body
                if cl_c.func.is_generator {
                    # Build initial locals (all undefined)
                    gen_locals: list[JSValue] = [];
                    gli: int = 0;
                    while gli < cl_c.func.num_locals {
                        gen_locals.append(js_undefined());
                        gli = gli + 1;
                    }
                    # Bind arguments to parameter slots
                    ga: int = 0;
                    while ga < len(cl_c.func.params) and ga < len(args_c) {
                        gen_locals[cl_c.func.param_base + ga] = args_c[ga];
                        ga = ga + 1;
                    }
                    # Collect the rest parameter into its (last) param slot — the
                    # ordinary run() path does this too; without it a destructured
                    # rest (`function* f(...[a]) {}`) sees `undefined` and the eager
                    # prologue's destructuring throws "undefined is not iterable".
                    if cl_c.func.has_rest and len(cl_c.func.params) > 0 {
                        grest_slot: int = cl_c.func.param_base + len(cl_c.func.params)
                            - 1;
                        grest_start: int = len(cl_c.func.params) - 1;
                        grest_items: list[JSValue] = [];
                        gri: int = grest_start;
                        while gri < len(args_c) {
                            grest_items.append(args_c[gri]);
                            gri = gri + 1;
                        }
                        gen_locals[grest_slot] = js_array_create(grest_items);
                    }
                    # Self-ref slot (slot 0 for named generators)
                    if cl_c.func.param_base > 0 {
                        gen_locals[0] = callee;
                    }
                    # Populate the implicit `arguments` object (generators bypass run()).
                    if cl_c.func.arguments_slot >= 0 {
                        gen_locals[cl_c.func.arguments_slot] = self._build_arguments(
                            args_c, callee, cl_c.func, gen_locals
                        );
                    }
                    # B5: eagerly run the parameter-binding prologue so a throwing
                    # default value / destructured parameter surfaces at call time.
                    gen_start_ip_c: int = 0;
                    gen_prologue_ok_c: bool = True;
                    if cl_c.func.gen_prologue_end_ip >= 0 {
                        gen_start_ip_c = cl_c.func.gen_prologue_end_ip;
                        gen_prologue_ok_c = self._run_gen_prologue(
                            cl_c.func,
                            gen_locals,
                            cl_c.free_vals,
                            js_undefined(),
                            callee,
                            cl_c.func.gen_prologue_end_ip
                        );
                    }
                    if not gen_prologue_ok_c {
                        # A throwing default/destructured parameter throws *synchronously*
                        # at the call site for both sync and async generators (the
                        # generator object is never created) — ES §27.x AsyncGeneratorStart
                        # / GeneratorStart run FunctionDeclarationInstantiation eagerly.
                        gp_exc_c: JSValue = self.pending_exc;
                        self.had_exception = False;
                        self.pending_exc = js_undefined();
                        if not self._unwind_in_frame(frame, gp_exc_c) {
                            self.had_exception = True;
                            self.pending_exc = gp_exc_c;
                            st.running = False;
                        }
                    } else {
                        gen_obj_c: JSValue = js_generator_create(
                            cl_c.func,
                            gen_locals,
                            cl_c.free_vals,
                            js_undefined(),
                            cl_c.func.is_async,
                            gen_start_ip_c,
                            callee,
                            cl_c.module_fns
                        );
                        # ES §27.5 / §27.3: the returned generator's [[Prototype]] is the
                        # generator function's `.prototype` object (which chains to
                        # %GeneratorPrototype%), so `Object.getPrototypeOf(g()) === g.prototype`
                        # and `g() instanceof g` hold.  Per OrdinaryCreateFromConstructor,
                        # if `.prototype` is not an object (e.g. `g.prototype = null`),
                        # fall back to the intrinsic %GeneratorPrototype%.  next/throw/return
                        # are still resolved by the js_is_generator special-case in GET_PROP.
                        gc_proto: JSValue = cl_c.prototype_obj;
                        if not (
                            jsv_is_object_cell(gc_proto)
                            and jsv_to_table_id(gc_proto) > 0
                        ) {
                            gc_proto = js_generator_get_proto();
                            if cl_c.func.is_async {
                                gc_proto = js_async_generator_get_proto();
                            }
                        }
                        if jsv_is_object_cell(gc_proto)
                            and jsv_to_table_id(gc_proto) > 0 {
                            js_object_set_prototype(gen_obj_c, gc_proto);
                        }
                        self._push(gen_obj_c);
                    }
                } else {
                    if cl_c.func.is_async {
                        # Pre-create the outer async promise and save/restore
                        # _cur_async_promise so nested AWAIT saves the right one.
                        old_cap_c: JSValue = self._cur_async_promise;
                        new_cap_c: JSValue = js_promise_create();
                        _gtr_c: int = len(self.realm.gc_temp_roots);
                        self.realm.gc_temp_roots.append(new_cap_c);
                        self._cur_async_promise = new_cap_c;
                        res_c: JSValue = self.run_cl(cl_c, callee, call_this_c, args_c);
                        self._cur_async_promise = old_cap_c;
                        _gtr_c_n: int = len(self.realm.gc_temp_roots);
                        while _gtr_c_n > _gtr_c {
                            _gtr_c_n = _gtr_c_n - 1;
                            del self.realm.gc_temp_roots[_gtr_c_n];
                        }
                        if self.vm_awaiting {
                            # AWAIT suspended the body — new_cap_c stays pending
                            self.vm_awaiting = False;
                            self._push(new_cap_c);
                        } elif self.had_exception {
                            exc_async: JSValue = self.pending_exc;
                            self.had_exception = False;
                            self.pending_exc = js_undefined();
                            self._promise_settle_and_drain(
                                new_cap_c, PROMISE_REJECTED, exc_async
                            );
                            self._push(new_cap_c);
                        } else {
                            if js_is_promise(res_c) {
                                st_rc: int = js_promise_get_state(res_c);
                                if st_rc != PROMISE_PENDING {
                                    self._promise_settle_and_drain(
                                        new_cap_c, st_rc, js_promise_get_value(res_c)
                                    );
                                } else {
                                    js_promise_add_reaction(
                                        res_c, js_undefined(), js_undefined(), new_cap_c
                                    );
                                }
                            } else {
                                self._promise_settle_and_drain(
                                    new_cap_c, PROMISE_FULFILLED, res_c
                                );
                            }
                            self._push(new_cap_c);
                        }
                    } else {
                        if self._reg_ready(cl_c.func)
                            and self._reg_call_from_list(
                                cl_c, callee, call_this_c, args_c, frame, st
                            ) {
                            return;
                        }
                        if self._inline_call(cl_c, callee, call_this_c, args_c, st) {
                            return;
                        }
                        res_c: JSValue = self.run_cl(cl_c, callee, call_this_c, args_c);
                        if self.had_exception {
                            exc_c: JSValue = self.pending_exc;
                            self.had_exception = False;
                            self.pending_exc = js_undefined();
                            if not self._unwind_in_frame(frame, exc_c) {
                                self.had_exception = True;
                                self.pending_exc = exc_c;
                                st.running = False;
                            }
                        } else {
                            self._push(res_c);
                        }
                    }
                }
            }
        } else {
            # Throw TypeError: value is not a function
            _nf_callee_name: str = "";
            if ins.arg2 > 0 {
                _nf_callee_name = frame.func.constants.get(ins.arg2 - 1);
            }  # arg2 = idx+1
            _nf_base: str = "";
            if _nf_callee_name != "" {
                _nf_base = _nf_callee_name;
            } else {
                _nf_base = _not_fn_desc(callee);
            }
            _nf_msg: str = _nf_base + " is not a function";
            exc_nf: JSValue = make_type_error(_nf_msg);
            if not self._unwind_in_frame(frame, exc_nf) {
                self.had_exception = True;
                self.pending_exc = exc_nf;
                st.running = False;
            }
        }
    }

    """
    Run an async function body via an indirect invoke (`.call`/`.apply`/Reflect)
    and return its Promise (ES §27.7 AsyncFunctionStart) — mirrors the CALL opcode's
    async wrapping so these paths don't leak the raw body value instead of a Promise.
    """
    def _invoke_async_via_reflect(
        cl_arg: JSClosure, fn: JSValue, this_val: JSValue, args: list[JSValue]
    ) -> JSValue {
        iar_old_cap: JSValue = self._cur_async_promise;
        iar_new_p: JSValue = js_promise_create();
        iar_gtr: int = len(self.realm.gc_temp_roots);
        self.realm.gc_temp_roots.append(iar_new_p);
        self._cur_async_promise = iar_new_p;
        iar_res: JSValue = self.run_cl(cl_arg, fn, this_val, args);
        self._cur_async_promise = iar_old_cap;
        iar_gtr_n: int = len(self.realm.gc_temp_roots);
        while iar_gtr_n > iar_gtr {
            iar_gtr_n = iar_gtr_n - 1;
            del self.realm.gc_temp_roots[iar_gtr_n];
        }
        if self.vm_awaiting {
            self.vm_awaiting = False;
        } elif self.had_exception {
            iar_exc: JSValue = self.pending_exc;
            self.had_exception = False;
            self.pending_exc = js_undefined();
            self._promise_settle_and_drain(iar_new_p, PROMISE_REJECTED, iar_exc);
        } else {
            if js_is_promise(iar_res) {
                iar_st: int = js_promise_get_state(iar_res);
                if iar_st != PROMISE_PENDING {
                    self._promise_settle_and_drain(
                        iar_new_p, iar_st, js_promise_get_value(iar_res)
                    );
                } else {
                    js_promise_add_reaction(
                        iar_res, js_undefined(), js_undefined(), iar_new_p
                    );
                }
            } else {
                self._promise_settle_and_drain(iar_new_p, PROMISE_FULFILLED, iar_res);
            }
        }
        return iar_new_p;
    }

    """
    Invoke a callable value `fn` with the given `this` and `args`, returning the
    result. Handles JS closures, bound functions (unwrapping the bind chain), and
    native functions — including the meta-kinds Function.prototype.call / .apply /
    .bind, which re-dispatch onto their target. Exceptions are surfaced via
    self.had_exception / self.pending_exc; the caller is responsible for unwinding.

    Used by the bound-function call path so that e.g.
    `Function.prototype.call.bind(fn)` (a bound native meta-function) actually
    invokes `fn`, rather than falling through to call_native and returning
    undefined.
    """
    def _invoke_callable_value(
        fn: JSValue, this_val: JSValue, args: list[JSValue]
    ) -> JSValue {
        if jsv_is_htmldda(fn) {
            return js_null();
        }
        if is_fn_val(fn) {
            icv_cl: JSClosure = self.realm.closures[get_fn_idx(fn)];
            if icv_cl.func.is_bound {
                # Unwrap one bind layer here; recurse for nested binds.
                icv_real_fn: JSValue = js_undefined();
                if len(icv_cl.free_vals) > 0 {
                    icv_real_fn = icv_cl.free_vals[0];
                }
                icv_real_this: JSValue = icv_cl.lexical_this;
                icv_full: list[JSValue] = [];
                icv_pi: int = 1;
                while icv_pi < len(icv_cl.free_vals) {
                    icv_full.append(icv_cl.free_vals[icv_pi]);
                    icv_pi = icv_pi + 1;
                }
                for ar_v in args {
                    icv_full.append(ar_v);
                }
                return self._invoke_callable_value(
                    icv_real_fn, icv_real_this, icv_full
                );
            }
            # Plain closure: sloppy-mode null/undefined this → globalThis.
            icv_eff_this: JSValue = this_val;
            if not icv_cl.is_arrow and not icv_cl.func.is_strict {
                if jsv_is_null(icv_eff_this) or jsv_is_undefined(icv_eff_this) {
                    icv_eff_this = self._sloppy_this_for(icv_cl.func);
                }
            }
            # An ASYNC function invoked via .call/.apply/Reflect must still return its
            # Promise (ES §27.7): wrap the body run like the CALL opcode does, not
            # return the raw body value.
            if icv_cl.func.is_async and not icv_cl.func.is_generator {
                return self._invoke_async_via_reflect(icv_cl, fn, icv_eff_this, args);
            }
            # Generator functions: create a generator object (do not run the body).
            # Required for Reflect.apply / Proxy [[Call]] forwarding (trap-is-undefined).
            if icv_cl.func.is_generator {
                gen_locals_icv: list[JSValue] = [];
                gli_icv: int = 0;
                while gli_icv < icv_cl.func.num_locals {
                    gen_locals_icv.append(js_undefined());
                    gli_icv = gli_icv + 1;
                }
                ga_icv: int = 0;
                while ga_icv < len(icv_cl.func.params) and ga_icv < len(args) {
                    gen_locals_icv[icv_cl.func.param_base + ga_icv] = args[ga_icv];
                    ga_icv = ga_icv + 1;
                }
                if icv_cl.func.has_rest and len(icv_cl.func.params) > 0 {
                    grest_slot_icv: int = icv_cl.func.param_base
                        + len(icv_cl.func.params)
                        - 1;
                    grest_start_icv: int = len(icv_cl.func.params) - 1;
                    grest_items_icv: list[JSValue] = [];
                    gri_icv: int = grest_start_icv;
                    while gri_icv < len(args) {
                        grest_items_icv.append(args[gri_icv]);
                        gri_icv = gri_icv + 1;
                    }
                    gen_locals_icv[grest_slot_icv] = js_array_create(grest_items_icv);
                }
                if icv_cl.func.param_base > 0 {
                    gen_locals_icv[0] = fn;
                }
                if icv_cl.func.arguments_slot >= 0 {
                    gen_locals_icv[icv_cl.func.arguments_slot] = self._build_arguments(
                        args, fn, icv_cl.func, gen_locals_icv
                    );
                }
                gen_start_ip_icv: int = 0;
                if icv_cl.func.gen_prologue_end_ip >= 0 {
                    gen_start_ip_icv = icv_cl.func.gen_prologue_end_ip;
                    gen_prologue_ok_icv: bool = self._run_gen_prologue(
                        icv_cl.func,
                        gen_locals_icv,
                        icv_cl.free_vals,
                        icv_eff_this,
                        fn,
                        icv_cl.func.gen_prologue_end_ip
                    );
                    if not gen_prologue_ok_icv {
                        return js_undefined();
                    }
                }
                gen_obj_icv: JSValue = js_generator_create(
                    icv_cl.func,
                    gen_locals_icv,
                    icv_cl.free_vals,
                    icv_eff_this,
                    icv_cl.func.is_async,
                    gen_start_ip_icv,
                    fn,
                    icv_cl.module_fns
                );
                gc_proto_icv: JSValue = icv_cl.prototype_obj;
                if not (
                    jsv_is_object_cell(gc_proto_icv)
                    and jsv_to_table_id(gc_proto_icv) > 0
                ) {
                    gc_proto_icv = js_generator_get_proto();
                    if icv_cl.func.is_async {
                        gc_proto_icv = js_async_generator_get_proto();
                    }
                }
                if jsv_is_object_cell(gc_proto_icv)
                    and jsv_to_table_id(gc_proto_icv) > 0 {
                    js_object_set_prototype(gen_obj_icv, gc_proto_icv);
                }
                return gen_obj_icv;
            }
            return self.run_cl(icv_cl, fn, icv_eff_this, args);
        }
        if js_is_proxy(fn) {
            res_pxy_icv: JSValue = self._proxy_trap_apply(fn, this_val, args);
            if vm_has_native_exc() {
                self.had_exception = True;
                self.pending_exc = vm_take_native_exc();
                return js_undefined();
            }
            return res_pxy_icv;
        }
        if is_native_val(fn) {
            icv_kind: int = get_native_kind(fn);
            if icv_kind == NATIVE_KIND_FN_CALL {
                # fn.call(thisArg, ...rest) → invoke `this_val` with rest.
                icv_t: JSValue = js_undefined();
                if len(args) > 0 {
                    icv_t = args[0];
                }
                icv_rest: list[JSValue] = [];
                icv_ri: int = 1;
                while icv_ri < len(args) {
                    icv_rest.append(args[icv_ri]);
                    icv_ri = icv_ri + 1;
                }
                return self._invoke_callable_value(this_val, icv_t, icv_rest);
            }
            if icv_kind == NATIVE_KIND_FN_APPLY {
                # fn.apply(thisArg, argsArray) → invoke `this_val`.
                icv_at: JSValue = js_undefined();
                if len(args) > 0 {
                    icv_at = args[0];
                }
                icv_aargs: list[JSValue] = [];
                if len(args) > 1 {
                    icv_arr: JSValue = args[1];
                    if jsv_is_object_cell(icv_arr) {
                        icv_lv: JSValue = js_object_get(icv_arr, WK_LENGTH);
                        icv_n: int = 0;
                        if jsv_is_int32(icv_lv) {
                            icv_n = jsv_to_int32(icv_lv);
                        } elif jsv_is_double(icv_lv) {
                            icv_n = int(jsv_to_double(icv_lv));
                        }
                        icv_ai: int = 0;
                        while icv_ai < icv_n {
                            icv_aargs.append(
                                js_object_get(icv_arr, str_intern_index(icv_ai))
                            );
                            icv_ai = icv_ai + 1;
                        }
                    }
                }
                return self._invoke_callable_value(this_val, icv_at, icv_aargs);
            }
            if icv_kind == NATIVE_KIND_FN_BIND {
                # fn.bind(thisArg, ...partials) → new bound function over `this_val`.
                icv_bt: JSValue = js_undefined();
                if len(args) > 0 {
                    icv_bt = args[0];
                }
                icv_partials: list[JSValue] = [];
                icv_pi: int = 1;
                while icv_pi < len(args) {
                    icv_partials.append(args[icv_pi]);
                    icv_pi = icv_pi + 1;
                }
                return self._make_bound_fn(this_val, icv_bt, icv_partials);
            }
            return _vm_call_native_proxy_aware(
                self, self.realm, icv_kind, this_val, args
            );
        }
        if jsv_is_object_cell(fn)
            and jsv_to_table_id(fn) >= 0
            and js_object_has_own(fn, WK_IS_CLASS) {
            icv_ctor: JSValue = js_object_get(fn, WK_CTOR);
            if is_fn_val(icv_ctor) {
                icv_cctor: JSClosure = self.realm.closures[get_fn_idx(icv_ctor)];
                return self.run_cl(icv_cctor, icv_ctor, this_val, args);
            }
        }
        # Callable JSObject constructors (Number, String, …) — KEY_CTOR_KIND.
        if jsv_is_object_cell(fn)
            and jsv_to_table_id(fn) > 0
            and js_object_has_own(fn, KEY_CTOR_KIND) {
            icv_ck: int = jsv_to_int32(js_object_get(fn, KEY_CTOR_KIND));
            return _vm_call_native_proxy_aware(
                self, self.realm, icv_ck, this_val, args
            );
        }
        if not self.had_exception {
            self.had_exception = True;
            self.pending_exc = make_type_error(_not_fn_desc(fn) + " is not a function");
        }
        return js_undefined();
    }

    """
    Construct a bound-function closure over `target` with the given bound `this`
    and partial args. Mirrors the NATIVE_KIND_FN_BIND path; used by
    _invoke_callable_value so a bound `Function.prototype.bind` works.
    """
    def _make_bound_fn(
        target: JSValue, bound_this: JSValue, partials: list[JSValue]
    ) -> JSValue {
        if not self._value_is_callable(target) {
            self.had_exception = True;
            self.pending_exc = make_type_error(
                _not_fn_desc(target) + " is not a function"
            );
            return js_undefined();
        }
        # Name/length are taken from the *immediate* Target (before unwrap).
        # Nested binds still flatten [[BoundThis]]/[[BoundArgs]] onto the
        # underlying callable for [[Call]] / [[Construct]].
        mbf_name_len_target: JSValue = target;
        mbf_name_v: JSValue = self._bound_get_target_prop(mbf_name_len_target, WK_NAME);
        if self.had_exception or vm_has_native_exc() {
            if vm_has_native_exc() {
                self.had_exception = True;
                self.pending_exc = vm_take_native_exc();
            }
            return js_undefined();
        }
        mbf_name: str = "";
        if jsv_is_string_cell(mbf_name_v) {
            mbf_name = str_from_id(jsv_to_table_id(mbf_name_v));
        }
        # Length uses the *caller-supplied* partials only (not yet-merged nested
        # bound args) against Get(Target,"length") of the immediate Target.
        mbf_caller_partials: int = len(partials);
        mbf_L: float = 0.0;
        mbf_has_len: bool = False;
        if is_fn_val(mbf_name_len_target) or is_native_val(mbf_name_len_target) {
            mbf_has_len = self._fn_has_own_key(mbf_name_len_target, WK_LENGTH);
        } elif jsv_is_object_cell(mbf_name_len_target) {
            mbf_has_len = js_object_has_own(mbf_name_len_target, WK_LENGTH);
        }
        if mbf_has_len {
            mbf_len_v: JSValue = self._bound_get_target_prop(
                mbf_name_len_target, WK_LENGTH
            );
            if self.had_exception or vm_has_native_exc() {
                if vm_has_native_exc() {
                    self.had_exception = True;
                    self.pending_exc = vm_take_native_exc();
                }
                return js_undefined();
            }
            if jsv_is_number(mbf_len_v) {
                mbf_ld: float = jsv_to_double(mbf_len_v);
                if mbf_ld == MATH_INF {
                    mbf_L = MATH_INF;
                } elif mbf_ld == (0.0 - MATH_INF) {
                    mbf_L = 0.0;
                } else {
                    mbf_ti_f: float = _to_integer_or_infinity(mbf_len_v);
                    if vm_has_native_exc() {
                        self.had_exception = True;
                        self.pending_exc = vm_take_native_exc();
                        return js_undefined();
                    }
                    mbf_L = mbf_ti_f - float(mbf_caller_partials);
                    if mbf_L < 0.0 {
                        mbf_L = 0.0;
                    }
                }
            }
        }
        mbf_target: JSValue = target;
        mbf_this: JSValue = bound_this;
        mbf_merged: list[JSValue] = [];
        for p_mbf in partials {
            mbf_merged.append(p_mbf);
        }
        while is_fn_val(mbf_target) {
            mbf_cl: JSClosure = self.realm.closures[get_fn_idx(mbf_target)];
            if not mbf_cl.func.is_bound {
                break;
            }
            mbf_inner: list[JSValue] = [];
            mbf_ii: int = 1;
            while mbf_ii < len(mbf_cl.free_vals) {
                mbf_inner.append(mbf_cl.free_vals[mbf_ii]);
                mbf_ii = mbf_ii + 1;
            }
            mbf_new: list[JSValue] = [];
            for iv_mbf in mbf_inner {
                mbf_new.append(iv_mbf);
            }
            for mv_mbf in mbf_merged {
                mbf_new.append(mv_mbf);
            }
            mbf_merged = mbf_new;
            mbf_this = mbf_cl.lexical_this;
            mbf_target = js_undefined();
            if len(mbf_cl.free_vals) > 0 {
                mbf_target = mbf_cl.free_vals[0];
            }
        }
        mbf_fv: list[JSValue] = [mbf_target];
        for mp_v in mbf_merged {
            mbf_fv.append(mp_v);
        }
        mbf_bound_name: str = "bound " + mbf_name;
        mbf_stub: CompiledFunction = make_compiled_fn(mbf_bound_name, "<bind>");
        # Keep expected_arg_count in int32 range for call-path arity hints;
        # the authoritative length lives on fn_props (may be > 2^31-1 or ∞).
        mbf_rlen: int = 0;
        if mbf_L == mbf_L and mbf_L != MATH_INF and mbf_L < 2147483647.0 {
            mbf_rlen = int(mbf_L);
        }
        mbf_stub.expected_arg_count = mbf_rlen;
        mbf_stub.is_bound = True;
        # ES §20.2.3.2: bound functions do not have a `prototype` property.
        mbf_bound: JSClosure = make_closure(mbf_stub, mbf_fv, mbf_this, js_undefined());
        # Own name/length: {writable:false, enumerable:false, configurable:true}.
        mbf_len_js: JSValue = js_number(mbf_L);
        if mbf_L == MATH_INF {
            mbf_len_js = js_infinity();
        }
        js_object_define_property(
            mbf_bound.fn_props,
            WK_NAME,
            JSProperty(
                key=WK_NAME,
                value=jsv_from_string_id(str_intern(mbf_bound_name)),
                writable=False,
                enumerable=False,
                configurable=True,
                deleted=False
            )
        );
        js_object_define_property(
            mbf_bound.fn_props,
            WK_LENGTH,
            JSProperty(
                key=WK_LENGTH,
                value=mbf_len_js,
                writable=False,
                enumerable=False,
                configurable=True,
                deleted=False
            )
        );
        mbf_val: JSValue = js_fn_val(vm_register_closure(self.realm, mbf_bound));  # G0.5: reuse freed slot
        # ES §20.2.3.2 steps 4–7: name/length come from the *immediate* Target
        # (the value passed to bind, pre chain-unwrap) and this call's partials.
        self._bind_set_name_length(mbf_val, target, len(partials));
        return mbf_val;
    }

    """
    Install the `length` and `name` own data properties on a freshly-created
    bound function per ES §20.2.3.2 steps 4–7. Both are non-writable,
    non-enumerable, configurable; stored in fn_props so they override the
    synthesized descriptors and remain redefinable.

      length: max(ToIntegerOrInfinity(Get(Target,"length")) - argCount, 0),
              but only if Target has an own "length"; else 0. +∞ passes through.
      name:   "bound " + (Target.name as a String, "" if not a string).
    """
    def _bind_set_name_length(
        bound_val: JSValue, target: JSValue, arg_count: int
    ) -> None {
        b_idx: int = get_fn_idx(bound_val);
        if b_idx < 0 or b_idx >= len(self.realm.closures) {
            return;
        }
        b_fp: JSValue = self.realm.closures[b_idx].fn_props;

        # ── length (§20.2.3.2 steps 5–7) ──────────────────────────────────
        len_num: float = 0.0;
        has_len: bool = False;
        tlen_v: JSValue = js_undefined();
        if is_fn_val(target) {
            if self._fn_has_own_key(target, WK_LENGTH) {
                has_len = True;
                tlen_v = _fn_prop(target, WK_LENGTH);
            }
        } elif is_native_val(target) {
            has_len = True;
            tlen_v = _native_prop(target, WK_LENGTH);
        } elif jsv_is_object_cell(target) and jsv_to_table_id(target) > 0 {
            if js_object_has_own(target, WK_LENGTH) {
                has_len = True;
                tlen_v = self._get_prop_accessor(target, WK_LENGTH);
            }
        }
        if has_len and (jsv_is_int32(tlen_v) or jsv_is_double(tlen_v)) {
            len_num = _to_integer_or_infinity(tlen_v) - float(arg_count);
            if len_num < 0.0 {
                len_num = 0.0;
            }
        }
        self._def_bound_own_prop(b_fp, WK_LENGTH, js_number(len_num));

        # ── name (§20.2.3.2 step 8) ───────────────────────────────────────
        tname: str = "";
        tname_v: JSValue = js_undefined();
        if is_fn_val(target) {
            tname_v = _fn_prop(target, WK_NAME);
        } elif is_native_val(target) {
            tname_v = _native_prop(target, WK_NAME);
        } elif jsv_is_object_cell(target) and jsv_to_table_id(target) > 0 {
            tname_v = self._get_prop_accessor(target, WK_NAME);
        }
        if jsv_is_string_cell(tname_v) {
            tname = str_from_id(jsv_to_table_id(tname_v));
        }
        self._def_bound_own_prop(
            b_fp, WK_NAME, jsv_from_string_id(str_intern("bound " + tname))
        );
    }

    """Define a { value, writable:F, enumerable:F, configurable:T } data
    property in a bound function's fn_props store (§20.2.3.2 uses SetFunction*
    which produce configurable, non-writable, non-enumerable data props)."""
    def _def_bound_own_prop(fp: JSValue, key: int, value: JSValue) {
        d: JSValue = js_object_create_null();
        js_object_set(d, str_intern("value"), value);
        js_object_set(d, str_intern("writable"), js_boolean(False));
        js_object_set(d, str_intern("enumerable"), js_boolean(False));
        js_object_set(d, str_intern("configurable"), js_boolean(True));
        _vm_call_native_proxy_aware(
            self,
            self.realm,
            NATIVE_KIND_OBJ_DEFINE_PROPERTY,
            js_undefined(),
            [fp, jsv_from_string_id(key), d]
        );
    }

    """Unwind an abrupt completion raised while CreateListFromArrayLike reads the
    argArray for Function.prototype.apply (a throwing length/index getter)."""
    def _ap_unwind_getter(frame: CallFrame, st: ExecState) -> None {
        exc_apg: JSValue = js_undefined();
        if vm_has_native_exc() {
            exc_apg = vm_take_native_exc();
        } elif self.had_exception {
            exc_apg = self.pending_exc;
            self.had_exception = False;
            self.pending_exc = js_undefined();
        } else {
            return;
        }
        if not self._unwind_in_frame(frame, exc_apg) {
            self.had_exception = True;
            self.pending_exc = exc_apg;
            st.running = False;
        }
    }

    """Get(Target, P) for bind — functions consult fn_props accessors + _fn_prop;
    callables that are ordinary objects use OrdinaryGet."""
    def _bound_get_target_prop(target: JSValue, key: int) -> JSValue {
        if is_fn_val(target) {
            bgp_idx: int = get_fn_idx(target);
            if bgp_idx >= 0 and bgp_idx < len(self.realm.closures) {
                bgp_fp: JSValue = self.realm.closures[bgp_idx].fn_props;
                if jsv_is_object_cell(bgp_fp) {
                    bgp_get: JSValue = js_object_get_own_accessor_getter(bgp_fp, key);
                    if not jsv_is_undefined(bgp_get) {
                        return self._get_prop_accessor_recv(bgp_fp, key, target);
                    }
                    if js_object_has_own_accessor(bgp_fp, key) {
                        return js_undefined();
                    }
                    if js_object_has_own(bgp_fp, key) {
                        return js_object_get(bgp_fp, key);
                    }
                }
            }
            return _fn_prop(target, key);
        }
        if is_native_val(target) {
            return _fn_prop(target, key);
        }
        if jsv_is_object_cell(target) {
            return self._get_prop_accessor(target, key);
        }
        return js_undefined();
    }

    def _arr_throw_callback_type_error(
        frame: CallFrame, st: ExecState, args: list[JSValue]
    ) {
        exc_cb: JSValue = js_undefined();
        if len(args) > 0 and not jsv_is_undefined(args[0]) {
            exc_cb = make_type_error(_not_fn_desc(args[0]) + " is not a function");
        } else {
            exc_cb = make_type_error("undefined is not a function");
        }
        if not self._unwind_in_frame(frame, exc_cb) {
            self.had_exception = True;
            self.pending_exc = exc_cb;
            st.running = False;
        }
    }

    """Unwind a native/VM exception from an array callback method and pop obs VM."""
    def _arr_cb_unwind(frame: CallFrame, st: ExecState, exc: JSValue) {
        _pop_native_obs_vm();
        if not self._unwind_in_frame(frame, exc) {
            self.had_exception = True;
            self.pending_exc = exc;
            st.running = False;
        }
    }

    """
    Shared prologue for Array callback methods (R1/R2).
    Spec order: ToObject → LengthOfArrayLike → IsCallable → thisArg.
    Returns [O, fn, thisArg, lengthNum] on success, or [] after unwinding.
    this_arg_idx < 0 means no thisArg (reduce/reduceRight).
    lengthNum is a JS number (float64) so lengths up to 2^53-1 are exact.
    """
    def _arr_cb_prologue(
        receiver: JSValue,
        args: list[JSValue],
        this_arg_idx: int,
        frame: CallFrame,
        st: ExecState
    ) -> list[JSValue] {
        o: JSValue = _vm_array_to_object(receiver);
        if vm_has_native_exc() {
            self._arr_cb_unwind(frame, st, vm_take_native_exc());
            return [];
        }
        n_len: int = _length_of(o);
        if vm_has_native_exc() {
            self._arr_cb_unwind(frame, st, vm_take_native_exc());
            return [];
        }
        if len(args) == 0 or not self._value_is_callable(args[0]) {
            _pop_native_obs_vm();
            self._arr_throw_callback_type_error(frame, st, args);
            return [];
        }
        fn: JSValue = args[0];
        this_arg: JSValue = js_undefined();
        if this_arg_idx >= 0 and len(args) > this_arg_idx {
            this_arg = args[this_arg_idx];
        }
        return [o, fn, this_arg, js_number(float(n_len))];
    }

    """
    Sparse-array fast-forward: given the current logical index `i` in an Array
    callback loop over object `o` (length `n`), return the next index to visit.

    When `o` is a plain data-only array (no accessors/proxy) AND the global
    no-inherited-index protector is intact, holes are guaranteed to answer
    HasProperty=false with no prototype walk — so the loop may jump straight to
    the next PRESENT own index instead of probing every integer up to `n`
    (turning O(length) into O(present) for `a[999999]=x`). Otherwise returns `i`
    unchanged so the caller probes that exact index via the general obs path.

    Re-checked every iteration: if the callback installs an accessor or a Proxy
    trap mid-loop, eligibility drops and we fall back to per-index probing.
    """
    def _arr_cb_fast_next(o: JSValue, i: int, n: int) -> int {
        if not idx_protector_ok() {
            return i;
        }
        # ONLY a genuine Array exotic object stores its indices in the dense elems
        # range or the sparse property map — the two places
        # js_object_next_present_index_ge looks. A String object (exotic indexed
        # chars), a TypedArray, an `arguments` object, or a plain array-LIKE object
        # used as the receiver (Array.prototype.filter.call("abc", …)) keep their
        # indices elsewhere, so the present-index scan would wrongly skip them all.
        # Restrict to real arrays; every other receiver takes the general per-index
        # obs path (correct, and those are rarely million-slot-sparse).
        if not js_is_array(o) {
            return i;
        }
        if not js_object_array_is_dataonly_fast(o) {
            return i;
        }
        return js_object_next_present_index_ge(o, i, n);
    }

    def _arr_dispatch_callback_method(
        kind: int,
        receiver: JSValue,
        args: list[JSValue],
        frame: CallFrame,
        st: ExecState
    ) -> None {
        # Root this native call's in-flight values for the duration: these
        # loops re-enter the VM per element, and receiver/callback (and any
        # result array registered below) live only in jac locals — a GC in
        # the callback otherwise sweeps them while live. Reset per call.
        while len(frame.native_roots) > 0 {
            del frame.native_roots[len(frame.native_roots) - 1];
        }
        frame.native_roots.append(receiver);
        frame.rare = True;
        for nr_a in args {
            frame.native_roots.append(nr_a);
        }
        frame.rare = True;
        # Observable Get/Has require an active obs VM for accessors/proxies.
        _push_native_obs_vm(self);
        if kind == NATIVE_KIND_ARRAY_FOREACH {
            prep_fe: list[JSValue] = self._arr_cb_prologue(
                receiver, args, 1, frame, st
            );
            if len(prep_fe) == 0 {
                return;
            }
            o_fe: JSValue = prep_fe[0];
            fn_fe: JSValue = prep_fe[1];
            ta_fe: JSValue = prep_fe[2];
            n_fe: int = int(jsv_to_double(prep_fe[3]));
            i_fe: int = 0;
            while i_fe < n_fe {
                i_fe = self._arr_cb_fast_next(o_fe, i_fe, n_fe);
                if i_fe >= n_fe {
                    break;
                }
                # A dense array's own element: no key, HasProperty or Get.
                v_fe: JSValue = js_object_dense_elem(o_fe, i_fe);
                k_fe: int = 0;
                dh_fe: bool = not jsv_is_hole(v_fe);
                if not dh_fe {
                    k_fe = str_intern_index(i_fe);
                    dh_fe = self.obs_has(o_fe, k_fe);
                }
                if dh_fe {
                    if vm_has_native_exc() {
                        self._arr_cb_unwind(frame, st, vm_take_native_exc());
                        return;
                    }
                    if jsv_is_hole(v_fe) {
                        v_fe = self.obs_get(o_fe, k_fe, o_fe);
                    }
                    if vm_has_native_exc() {
                        self._arr_cb_unwind(frame, st, vm_take_native_exc());
                        return;
                    }
                    _vm_invoke_callback(self, fn_fe, ta_fe, [v_fe, js_int(i_fe), o_fe]);
                    if self.had_exception {
                        exc_fe: JSValue = self.pending_exc;
                        self.had_exception = False;
                        self.pending_exc = js_undefined();
                        self._arr_cb_unwind(frame, st, exc_fe);
                        return;
                    }
                } else {
                    if vm_has_native_exc() {
                        self._arr_cb_unwind(frame, st, vm_take_native_exc());
                        return;
                    }
                }
                i_fe = i_fe + 1;
            }
            _pop_native_obs_vm();
            self._push(js_undefined());
        } elif kind == NATIVE_KIND_ARRAY_MAP {
            # §23.1.3.19 — ArraySpeciesCreate before loop; CreateDataPropertyOrThrow.
            prep_am: list[JSValue] = self._arr_cb_prologue(
                receiver, args, 1, frame, st
            );
            if len(prep_am) == 0 {
                return;
            }
            o_am: JSValue = prep_am[0];
            fn_am: JSValue = prep_am[1];
            ta_am: JSValue = prep_am[2];
            n_am: int = int(jsv_to_double(prep_am[3]));
            a_am: JSValue = _vm_array_species_create(self, o_am, n_am);
            if vm_has_native_exc() {
                self._arr_cb_unwind(frame, st, vm_take_native_exc());
                return;
            }
            frame.native_roots.append(a_am);  # result lives only here during callback re-entry
            frame.rare = True;
            i_am: int = 0;
            while i_am < n_am {
                i_am = self._arr_cb_fast_next(o_am, i_am, n_am);
                if i_am >= n_am {
                    break;
                }
                # A dense array's own element: no key, HasProperty or Get.
                v_am: JSValue = js_object_dense_elem(o_am, i_am);
                k_am: int = 0;
                dh_am: bool = not jsv_is_hole(v_am);
                if not dh_am {
                    k_am = str_intern_index(i_am);
                    dh_am = self.obs_has(o_am, k_am);
                }
                if dh_am {
                    if vm_has_native_exc() {
                        self._arr_cb_unwind(frame, st, vm_take_native_exc());
                        return;
                    }
                    if jsv_is_hole(v_am) {
                        v_am = self.obs_get(o_am, k_am, o_am);
                    }
                    if vm_has_native_exc() {
                        self._arr_cb_unwind(frame, st, vm_take_native_exc());
                        return;
                    }
                    r_am: JSValue = _vm_invoke_callback(
                        self, fn_am, ta_am, [v_am, js_int(i_am), o_am]
                    );
                    if self.had_exception {
                        exc_am: JSValue = self.pending_exc;
                        self.had_exception = False;
                        self.pending_exc = js_undefined();
                        self._arr_cb_unwind(frame, st, exc_am);
                        return;
                    }
                    if not js_object_dense_put(a_am, i_am, r_am)
                        and not _vm_create_data_property_or_throw(
                            self, a_am, i_am, r_am
                        ) {
                        self._arr_cb_unwind(frame, st, vm_take_native_exc());
                        return;
                    }
                } else {
                    if vm_has_native_exc() {
                        self._arr_cb_unwind(frame, st, vm_take_native_exc());
                        return;
                    }
                }
                i_am = i_am + 1;
            }
            _pop_native_obs_vm();
            self._push(a_am);
        } elif kind == NATIVE_KIND_ARRAY_FILTER {
            # §23.1.3.8 — ArraySpeciesCreate(O, 0); CreateDataPropertyOrThrow with `to`.
            prep_af: list[JSValue] = self._arr_cb_prologue(
                receiver, args, 1, frame, st
            );
            if len(prep_af) == 0 {
                return;
            }
            o_af: JSValue = prep_af[0];
            fn_af: JSValue = prep_af[1];
            ta_af: JSValue = prep_af[2];
            n_af: int = int(jsv_to_double(prep_af[3]));
            a_af: JSValue = _vm_array_species_create(self, o_af, 0);
            if vm_has_native_exc() {
                self._arr_cb_unwind(frame, st, vm_take_native_exc());
                return;
            }
            frame.native_roots.append(a_af);  # result lives only here during callback re-entry
            frame.rare = True;
            i_af: int = 0;
            to_af: int = 0;
            while i_af < n_af {
                i_af = self._arr_cb_fast_next(o_af, i_af, n_af);
                if i_af >= n_af {
                    break;
                }
                # A dense array's own element: no key, HasProperty or Get.
                v_af: JSValue = js_object_dense_elem(o_af, i_af);
                k_af: int = 0;
                dh_af: bool = not jsv_is_hole(v_af);
                if not dh_af {
                    k_af = str_intern_index(i_af);
                    dh_af = self.obs_has(o_af, k_af);
                }
                if dh_af {
                    if vm_has_native_exc() {
                        self._arr_cb_unwind(frame, st, vm_take_native_exc());
                        return;
                    }
                    if jsv_is_hole(v_af) {
                        v_af = self.obs_get(o_af, k_af, o_af);
                    }
                    if vm_has_native_exc() {
                        self._arr_cb_unwind(frame, st, vm_take_native_exc());
                        return;
                    }
                    r_af: JSValue = _vm_invoke_callback(
                        self, fn_af, ta_af, [v_af, js_int(i_af), o_af]
                    );
                    if self.had_exception {
                        exc_af: JSValue = self.pending_exc;
                        self.had_exception = False;
                        self.pending_exc = js_undefined();
                        self._arr_cb_unwind(frame, st, exc_af);
