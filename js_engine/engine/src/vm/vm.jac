                        }
                    }
                } elif op == 81 {
                    # SETFIELD obj, val, orig
                    a = (w >> 8) & 65535;
                    b = (w >> 24) & 65535;
                    c = (w >> 40) & 8388607;
                    va = regs[lb + (a & 32767)];
                    vb = regs[lb + (b & 32767)];
                    if (a & 32768) != 0 and js_is_tdz(va) {
                        self._reg_tdz_throw(frame, st, a & 32767, c);
                    } elif (b & 32768) != 0 and js_is_tdz(vb) {
                        self._reg_tdz_throw(frame, st, b & 32767, c);
                    } elif _vm_set_ic_ok(code[c])
                        and js_object_ic_set_hit(
                            va, code[c].ic_obj, code[c].ic_ver // 16, vb
                        ) {} elif _vm_set_probe(code[c], va, vb) {} elif self._reg_setfield_slow(
                        frame, st, w, c, va, vb, pc
                    )
                        == 1 {
                        # a plain-JS setter entered in-loop (result dropped)
                        frame = self.frames[len(self.frames) - 1];
                        rc = frame.func.rcode;
                        code = frame.func.code;
                        if frame.locals is not regs {
                            regs = frame.locals;
                        }
                        n_rc = len(rc);
                        lb = frame.lb;
                        pc = 0;
                    }
                } elif op == 90 or op == 91 {
                    # CALL dst, callee, argc [args...] / CALLM dst, fn, argc [this, args...]
                    a = (w >> 8) & 65535;
                    b = (w >> 24) & 65535;
                    c = (w >> 40) & 8388607;
                    xi = pc;
                    yi = pc + c;
                    br = -1;
                    if op == 91 {
                        br = rc[pc];
                        xi = pc + 1;
                        yi = pc + 1 + c;
                    }
                    va = regs[lb + (b & 32767)];
                    if (b & 32768) != 0 and js_is_tdz(va) {
                        self._reg_tdz_throw(
                            frame, st, b & 32767, frame.func.rorig[pc - 1]
                        );
                        pc = yi;
                    } elif br >= 0
                        and (br & 32768) != 0
                        and js_is_tdz(regs[lb + (br & 32767)]) {
                        self._reg_tdz_throw(
                            frame, st, br & 32767, frame.func.rorig[pc - 1]
                        );
                        pc = yi;
                    } else {
                        vb = js_undefined();
                        if br >= 0 {
                            vb = regs[lb + (br & 32767)];
                            br = br & 32767;
                        }
                        cr = 0;
                        if (code[frame.func.rorig[pc - 1]].arg3 & 8) == 0
                            and len(frame.with_objs) == 0
                            and is_fn_val(va)
                            and not is_native_val(va)
                            and not js_is_proxy(va)
                            and not jsv_is_htmldda(va) {
                            cr = self._reg_call_enter(
                                frame,
                                st,
                                va,
                                vb,
                                a,
                                xi,
                                c,
                                frame.func.rorig[pc - 1],
                                yi
                            );
                        } elif br >= 0
                            and is_native_val(va)
                            and get_native_kind(va) == NATIVE_KIND_FN_CALL
                            and (code[frame.func.rorig[pc - 1]].arg3 & 8) == 0
                            and len(frame.with_objs) == 0
                            and is_fn_val(vb)
                            and not is_native_val(vb) {
                            # fn.call(t, args...) on a closure: enter fn with this = t
                            cr = self._reg_fn_call_enter(
                                frame, st, vb, a, xi, c, frame.func.rorig[pc - 1], yi
                            );
                        }
                        if cr == 1 {
                            frame = self.frames[len(self.frames) - 1];
                            rc = frame.func.rcode;
                            code = frame.func.code;
                            if frame.locals is not regs {
                                regs = frame.locals;
                            }
                            n_rc = len(rc);
                            lb = frame.lb;
                            pc = 0;
                        } elif cr == 0 {
                            # (a plain CALL of a native passes this = undefined:
                            # the receiver-free modes 2 / 3 / 5 accept it)
                            if is_native_val(va)
                                and (code[frame.func.rorig[pc - 1]].arg3 & 8) == 0
                                and self._reg_native_fast_call(
                                    frame,
                                    st,
                                    a,
                                    va,
                                    vb,
                                    xi,
                                    c,
                                    frame.func.rorig[pc - 1]
                                ) {} else {
                                self._reg_bridge_call(
                                    frame,
                                    st,
                                    frame.func.rorig[pc - 1],
                                    a,
                                    b & 32767,
                                    br,
                                    xi,
                                    c
                                );
                            }
                            pc = yi;
                        } else {
                            pc = yi;
                        }
                    }
                } elif op == 92 or op == 93 {
                    # RETURN r / RETUNDEF
                    vr = js_undefined();
                    ok = True;
                    if op == 92 {
                        a = (w >> 8) & 65535;
                        if (a & 32768) != 0 and js_is_tdz(regs[lb + (a & 32767)]) {
                            self._reg_tdz_throw(
                                frame, st, a & 32767, frame.func.rorig[pc - 1]
                            );
                            ok = False;
                        } else {
                            vr = regs[lb + (a & 32767)];
                        }
                    }
                    if ok and self._reg_return(frame, st, vr, pc) {
                        frame = self.frames[len(self.frames) - 1];
                        rc = frame.func.rcode;
                        code = frame.func.code;
                        if frame.locals is not regs {
                            regs = frame.locals;
                        }
                        n_rc = len(rc);
                        lb = frame.lb;
                        pc = frame.rpc;
                    }
                } elif op == 82 {
                    # GETINDEX dst, obj, idx
                    b = (w >> 24) & 65535;
                    c = (w >> 40) & 8388607;
                    va = regs[lb + (b & 32767)];
                    vb = regs[lb + (c & 32767)];
                    vr = jsv_hole();
                    if jsv_is_int32(vb) and jsv_to_int32(vb) >= 0 {
                        vr = js_object_dense_elem(va, jsv_to_int32(vb));
                        if jsv_is_hole(vr) {
                            vr = binary_ta_int_get(va, jsv_to_int32(vb));
                        }
                    }
                    if not jsv_is_hole(vr) {
                        regs[lb + ((w >> 8) & 65535)] = vr;
                    } else {
                        self._reg_getindex_slow(frame, st, w, va, vb, pc);
                    }
                } elif op == 83 {
                    # SETINDEX obj, idx, val
                    a = (w >> 8) & 65535;
                    b = (w >> 24) & 65535;
                    c = (w >> 40) & 8388607;
                    va = regs[lb + (a & 32767)];
                    vb = regs[lb + (b & 32767)];
                    vr = regs[lb + (c & 32767)];
                    if (a & 32768) != 0 and js_is_tdz(va) {
                        self._reg_tdz_throw(
                            frame, st, a & 32767, frame.func.rorig[pc - 1]
                        );
                    } elif (b & 32768) != 0 and js_is_tdz(vb) {
                        self._reg_tdz_throw(
                            frame, st, b & 32767, frame.func.rorig[pc - 1]
                        );
                    } elif (c & 32768) != 0 and js_is_tdz(vr) {
                        self._reg_tdz_throw(
                            frame, st, c & 32767, frame.func.rorig[pc - 1]
                        );
                    } elif code[frame.func.rorig[pc - 1]].arg3 != 1
                        and self._reg_set_index_fast(va, vb, vr) {} elif code[
                        frame.func.rorig[pc - 1]
                    ].arg3
                        != 1
                        and self._reg_set_index_key(va, vb, vr) {} elif code[
                        frame.func.rorig[pc - 1]
                    ].arg3
                        == 1
                        and self._reg_set_index_define(va, vb, vr) {} else {
                        self._reg_bridge(
                            frame,
                            st,
                            frame.func.rorig[pc - 1],
                            3,
                            va,
                            vb,
                            vr,
                            frame.func.num_locals - 1,
                            1
                        );
                    }
                } elif op == 85 {
                    # NEWARRAY base, n
                    self._reg_op_newarray(frame, w);
                } elif op == 95 or op == 96 or op == 97 {
                    # YIELD / AWAIT / YIELDSTAR dst, src, orig: the handler
                    # suspends the frame (st.running = False; run_generator /
                    # the await reaction save it with rpc = the next word and
                    # resume it through _exec_any, the sent or settled value
                    # going into dst — _reg_resume_value) or, for an await of
                    # an already-settled promise, pushes the value, which lands
                    # in dst like any bridged result.
                    b = (w >> 24) & 65535;
                    va = regs[lb + (b & 32767)];
                    if (b & 32768) != 0 and js_is_tdz(va) {
                        self._reg_tdz_throw(frame, st, b & 32767, (w >> 40) & 8388607);
                    } else {
                        frame.rpc = pc;
                        self._reg_bridge(
                            frame,
                            st,
                            (w >> 40) & 8388607,
                            1,
                            va,
                            0,
                            0,
                            (w >> 8) & 65535,
                            1
                        );
                    }
                } elif op == 88 {
                    # ITERNEXTVAL dst, iter, orig
                    self._reg_op_iternextval(frame, st, w);
                } elif op == 86 {
                    # GETITER dst, src, orig
                    self._reg_op_getiter(frame, st, w);
                } elif op == 87 {
                    # NEW dst, ctor, argc [args...] (see _reg_op_new)
                    if self._reg_op_new(frame, st, w, pc) == 1 {
                        frame = self.frames[len(self.frames) - 1];
                        rc = frame.func.rcode;
                        code = frame.func.code;
                        if frame.locals is not regs {
                            regs = frame.locals;
                        }
                        n_rc = len(rc);
                        lb = frame.lb;
                        pc = 0;
                    } else {
                        pc = pc + ((w >> 40) & 8388607);
                    }
                } elif op == 94 {
                    # TAILCALL dst, callee, argc [args] (see _reg_op_tailcall)
                    if self._reg_op_tailcall(frame, st, w, pc) == 1 {
                        frame = self.frames[len(self.frames) - 1];
                        rc = frame.func.rcode;
                        code = frame.func.code;
                        if frame.locals is not regs {
                            regs = frame.locals;
                        }
                        n_rc = len(rc);
                        lb = frame.lb;
                        pc = 0;
                    } else {
                        pc = pc + ((w >> 40) & 8388607);
                    }
                } else {
                    print("[VM FATAL] unknown register opcode " + str(op));
                    st.running = False;
                }
            } else {
                if op == 120 {
                    # STK base, npop|npush<<12, orig
                    b = (w >> 24) & 65535;
                    if code[(w >> 40) & 8388607].opcode == Opcode.SUPER_CALL
                        and self._reg_super_enter(frame, st, w, pc) == 1 {
                        frame = self.frames[len(self.frames) - 1];
                        rc = frame.func.rcode;
                        code = frame.func.code;
                        if frame.locals is not regs {
                            regs = frame.locals;
                        }
                        n_rc = len(rc);
                        lb = frame.lb;
                        pc = 0;
                    } elif not self._reg_stk_fast(frame, st, w) {
                        self._reg_bridge_range(
                            frame,
                            st,
                            (w >> 40) & 8388607,
                            (w >> 8) & 65535,
                            b & 4095,
                            b >> 12
                        );
                    }
                } elif op == 110 {
                    # ITERNEXT dst, iter -> done target
                    b = (w >> 24) & 65535;
                    va = regs[lb + (b)];
                    cr = -1;
                    if _ITER_STD_SHAPE > 0
                        and js_object_ic_shape(va) == _ITER_STD_SHAPE {
                        xi = jsv_to_table_id(va);
                        vb = js_object_slot_at_id(xi, _ITER_STD_J);
                        if jsv_is_int32(vb) {
                            yi = jsv_to_int32(vb);
                            if yi
                                < js_array_len(js_object_slot_at_id(xi, _ITER_STD_I)) {
                                regs[lb + ((w >> 8) & 65535)] = js_array_get(
                                    js_object_slot_at_id(xi, _ITER_STD_I), yi
                                );
                                js_object_slot_set_at_id(
                                    xi, _ITER_STD_J, js_int(yi + 1)
                                );
                                cr = 1;
                            } else {
                                cr = 0;
                            }
                        }
                    }
                    if cr < 0 {
                        cr = self._reg_iternext_slow(
                            frame, st, (w >> 8) & 65535, b, frame.func.rorig[pc - 1]
                        );
                    }
                    if cr == 0 {
                        pc = (w >> 40) & 8388607;
                    }
                } elif op == 100 or op == 102 {
                    # PUSHCATCH / PUSHFINALLY -> handler register pc
                    frame.catch_stack.append((w >> 40) & 8388607);
                    frame.rare = True;
                    frame.catch_with_depths.append(len(frame.with_objs));
                    frame.rare = True;
                    frame.catch_dispose_depths.append(len(frame.dispose_stack));
                    frame.rare = True;
                } elif op == 101 or op == 103 {
                    # POPCATCH / POPFINALLY
                    xi = len(frame.catch_stack);
                    if xi > 0 {
                        del frame.catch_stack[xi - 1];
                    }
                    xi = len(frame.catch_with_depths);
                    if xi > 0 {
                        del frame.catch_with_depths[xi - 1];
                    }
                    xi = len(frame.catch_dispose_depths);
                    if xi > 0 {
                        del frame.catch_dispose_depths[xi - 1];
                    }
                } elif op == 104 {
                    # LANDING dst: the exception _unwind_in_frame pushed
                    if len(self.stack) > frame.stack_base {
                        regs[lb + ((w >> 8) & 65535)] = self.stack.pop();
                    } else {
                        regs[lb + ((w >> 8) & 65535)] = js_undefined();
                    }
                    while len(self.stack) > frame.stack_base {
                        self.stack.pop();
                    }
                } elif op == 105 {
                    # THROW r
                    a = (w >> 8) & 65535;
                    if (a & 32768) != 0 and js_is_tdz(regs[lb + (a & 32767)]) {
                        self._reg_tdz_throw(
                            frame, st, a & 32767, frame.func.rorig[pc - 1]
                        );
                    } else {
                        self._reg_throw(
                            frame, st, regs[lb + (a & 32767)], frame.func.rorig[pc - 1]
                        );
                    }
                } elif op == 106 {
                    # FINENTER slot, src
                    if self._gen_ret_pending {
                        regs[lb + ((w >> 8) & 65535)] = js_undefined();
                    } else {
                        regs[lb + ((w >> 8) & 65535)] = regs[lb + ((w >> 24) & 65535)];
                    }
                } elif op == 107 {
                    # FINRETHROW slot
                    if self._gen_ret_pending {
                        st.running = False;
                    } else {
                        self._reg_throw(
                            frame,
                            st,
                            regs[lb + ((w >> 8) & 65535)],
                            frame.func.rorig[pc - 1]
                        );
                    }
                } else {
                    print("[VM FATAL] unknown register opcode " + str(op));
                    st.running = False;
                }
            }
        }
        # Uncaught in this frame with in-loop callers below: pop them and
        # retry their handlers (same protocol as _exec); on a catch, back
        # into the loop in the catching frame.
        if (not st.running) and self.had_exception and st.inline_depth > 0 {
            frame = self._exec_unwind_inline(st);
            self.reg_unwound = False;
            if st.running {
                frame.rpc = frame.ip;
                return self._exec_reg_resume(frame, st);
            }
        }
        return st.ret;
    }

    def _proxy_trap_get(p: JSValue, key: int, receiver: JSValue) -> JSValue {
        return proxy_trap_get(self, p, key, receiver);
    }

    def _proxy_trap_set(p: JSValue, key: int, val: JSValue, receiver: JSValue) -> bool {
        return proxy_trap_set(self, p, key, val, receiver);
    }

    def _proxy_trap_apply(
        p: JSValue, this_arg: JSValue, args: list[JSValue]
    ) -> JSValue {
        return proxy_trap_apply(self, p, this_arg, args);
    }

    def _proxy_trap_construct(
        p: JSValue, args: list[JSValue], new_target: JSValue
    ) -> JSValue {
        return proxy_trap_construct(self, p, args, new_target);
    }
}

# The globalThis JSObject — LOAD_GLOBAL fallback

# ── Exception / control-flow state ──

# outer Promise for the currently-executing async call
# One-shot channel: construct entry sites set this immediately before run_cl/run;
# run() consumes it into CallFrame.new_target and resets to undefined.

# set when operand ToPrimitive threw/diverted control
# Set while a generator's forced-return (.return()) is unwinding into a
# destructuring IteratorClose catch region: ITER_CLOSE_THRW then closes the
# inner iterator and completes the generator with a return (not a throw).

# ── Suspension state machines (generator / yield* / async) ──
# True when YIELD suspends execution
# True when YIELD_STAR suspends (delegate pending)
# True when AWAIT suspends the frame
# Re-entrancy guard for _drain_stream_pending

# ── Module / ESM / require resolution state ──
# Directory of the currently executing script (for require() resolution)
# Root directory of the engine (for loading JS builtins)
# Bound parent file for createRequire()
# 1 when resolving for import() / static import
# 1 while Opcode.DYNAMIC_IMPORT is resolving
# 1 for .mjs / ESM entry — reject CJS pseudo-globals
# absolute path of the program's entry script (el_run)
# per-module exports global during ESM load
# Depth counter: >0 while evaluating ESM under CJS require()/createRequire().
# Top-level await under this mode throws ERR_REQUIRE_ASYNC_MODULE instead of
# parking the frame (Node 22+ require(esm) sync evaluation).

# Paths for ERR_REQUIRE_ASYNC_MODULE "From … / Requiring …" suffixes.

# 1 while resolving a source-phase import (`import source x from` / import.source).

# 1 while resolving a deferred-evaluation import (`import defer * as` / import.defer).

# ASTs parsed by _esm_ensure_export_meta for a module not yet loaded (a re-export
# target), keyed by path, with the source they were parsed from. _require_module
# takes the entry instead of parsing the same file again. Capped at
# ESM_META_AST_CACHE_MAX so a target that never loads cannot pin many ASTs.

# ── Direct-eval / cross-realm scope inheritance ──
# Direct-eval scope inheritance (ES §19.2.1.1): for each active direct eval,
# the number of caller frames live at eval entry (the boundary below the
# eval's own frame). eval'd code resolves bare names that miss
# globals/globalThis against those caller frames' locals/free-vars, innermost
# first (so a top-level `function assert(){}`, stored as a <main> local, is
# visible inside eval even when eval is called from a nested function).
# A stack to support nested eval.

# B13: the caller method/ctor closure whose [[HomeObject]] / super_class a direct
# eval inherits, so `super.x` inside the eval'd code resolves. js_undefined when
# the eval is not in a super context. A stack to support nested eval.

# handle for native observable property access
# env ID passed as napi_env to the C shim

# ── yield* delegation state (ES §14.4.14) ──
# inner .return()/.throw() step requires ReturnCompletion(value) out of the outer generator
# raw inner iterator-result object to surface on a non-done step (0 == none)

# ── Constructor / new.target channels (one-shot, consumed by run) ──
# NewTarget passed to the next `run`/`run_cl` frame: set by a construct site
# (_op_new / super() / Reflect.construct) immediately before the call, consumed
# once by `run` (then reset), so ordinary calls see undefined.  0 == undefined.

# True when the next constructed frame is a DERIVED constructor whose `this` is
# uninitialized until super() (consumed once by `run`).

# One-shot: the class object whose constructor is about to run, seeded before a class
# constructor `run_cl` and consumed once by `run` into frame.ctor_class. super() reads
# frame.ctor_class to run the DERIVED class's own fields (ES §15.7 InitializeInstance-
# Fields uses the active function object's class, not new.target). 0 = not a ctor frame.

# The realm id of source currently being compiled+run via a FOREIGN realm's eval /
# Function (0 = default realm). Held for the duration of that eval run (NOT one-shot):
# every top-level closure MAKE_FUNCTION creates during the run is stamped with it, so a
# cross-realm brand-check TypeError uses the right realm's %TypeError%. Saved/restored
# around nested evals.

# One-shot: home realm id of a foreign realm's eval about to run (consumed by
# run_in_this_context_ex2 into _pending_source_realm_id for the run's duration).

# ── Tail-call channel (staged by TAIL_CALL, consumed by run()'s trampoline) ──
# Set together with st.tail_pending; cleared by run() when it re-enters the callee.
# the callee closure JSValue (is_fn_val)
# this-arg for the tail call
# already-spread-expanded argument list
# One-shot: pending_ctx_global is a foreign REALM's global (a cross-realm indirect eval),
# NOT a Node vm.runInContext sandbox. The eval is ordinary global code: keep the normal
# indirect-eval scope boundary (1) and do NOT stamp ctx_global onto EVERY nested closure
# (sandbox behavior mis-scopes generic global code). Only top_fn.ctx_global is set, so the
# eval's top-level var/global writes bind in the foreign realm's global object.

# One-shot channel consumed by run_in_this_context_ex2: the contextified sandbox
# that becomes the global object of the code about to be compiled (vm.runInContext),
# and the script name to attribute it to. 0 / "" mean "ordinary global code".

# Persistent global lexical environment (let/const/class from $262.evalScript /
# successive ScriptEvaluations). Checked before self.globals in LOAD_GLOBAL.

# Bare global reads come from self.globals, a copy of the global object's
# properties. Writes made through the object (`globalThis.fetch = f`,
# Object.defineProperty, delete) are recorded by the object layer and applied
# before the next bare read (_sync_globals_from_object); this is the epoch seen.

# Names bound only in self.globals (module / eval top-level, STORE_MODULE_GLOBAL
# arg2 == 0): a same-named property written on the global object leaves them be.

# One-shot: direct eval inherits the caller's `this` (ES §19.2.1.1). When set,
# `eval()` uses this value instead of globalThis / undefined. Cleared on consume.

# Import-attributes `type` for the in-flight dynamic/static import ("json" / "text" / "").

# Monotonic per-EVALUATION class-brand allocator (ES §15.7: each class evaluation mints
# fresh PrivateNames). MAKE_CLASS takes the next value as the class's brand. 0 reserved =
# "no brand".

# Frame pool (call_path_impl_plan Phase 2): recycled plain-sync
# CallFrames. Eligibility (both acquire and release): not generator,
# not async (their frames are captured for resumption), and no
# arguments object (a mapped arguments object aliases the locals
# list beyond the call). Released only on NORMAL completion, cap 64.
# A pooled frame retains its last refs until reuse (bounded, benign).

# Generator resume frames (V4.18): run_generator's frame for one step,
# reused across steps (not while suspended in an AWAIT); cap 16.

# run_generator "raw" step (V4.18): set by a for-of caller right before
# the call (consumed on entry); a raw-capable exit returns the bare value
# with gen_raw_hit = True and gen_raw_done, no {value, done} object.

# Register ISA: set by _unwind_in_frame when it installs a handler in a
# register frame (frame.ip is then the handler's register pc); the
# register loop consumes it at the end of the dispatch that caused it.

# The register file (V3.1): window frames live in regs[0 .. rtop), the
# innermost at the top; a window is pushed on entry and popped on return
# (or when an exception pops the frame).

# Bumped after every write to / delete from `globals`: LOAD_GLOBAL sites
# cache (value, gw_epoch) in their Instruction (ic_obj, ic_ver, holder 1).

# The `module` global as of cur_mod_epoch (= gw_epoch when read): the
# in-loop call paths' same-module test without a dict lookup per call.

# _reg_call_enter_cl list mode (argpc == -1): the arguments (V4.11)

# the `exports` global, read once per gw_epoch (V4.22, run_cl)

# ExecStates of finished _exec_reg runs, reused (V4.22)

# _reg_call_enter with argc == -1: the one argument (a setter's value).
# ── Proxy trap dispatch (must live in vm.na.jac — needs vm_call_js_fn) ─────────

glob _PROXY_TRAP_VM: VM;

def:pub proxy_vm_bind_for_traps(vm: VM) {
    _PROXY_TRAP_VM = vm;
}

def _vm_proxy_trap_callable(v: JSValue) -> bool {
    if is_native_val(v) {
        return True;
    }
    if is_fn_val(v) {
        return True;
    }
    if jsv_is_object_cell(v)
        and jsv_to_table_id(v) > 0
        and js_object_has_own(v, KEY_CTOR_KIND) {
        return True;
    }
    return False;
}

"""
GetMethod-style trap lookup on a Proxy handler (§10.5).
Must use [[Get]] so a Proxy handler's `get` trap is observed (e.g. test262
property-traps-order-with-species logs trap names via `get(t, pk)`).
"""
def _vm_proxy_handler_get(vm: VM, handler: JSValue, trap_name: str) -> JSValue {
    # Null/undefined handler (revoked Proxy cleared handler) → TypeError.
    if jsv_is_null(handler) or jsv_is_undefined(handler) {
        _vm_proxy_throw(
            vm, "Cannot perform '" + trap_name + "' on a proxy with a null handler"
        );
        return js_undefined();
    }
    tk: int = str_intern(trap_name);
    if js_is_proxy(handler) {
        return proxy_trap_get(vm, handler, tk, handler);
    }
    getter_fn: JSValue = js_object_lookup_getter(handler, tk);
    if not jsv_is_undefined(getter_fn) {
        if is_fn_val(getter_fn) {
            return vm_call_js_fn_observable(vm, getter_fn, handler, []);
        }
        if is_native_val(getter_fn) {
            return _vm_call_native_proxy_aware(
                vm, vm.realm, get_native_kind(getter_fn), handler, [], getter_fn
            );
        }
    }
    return js_object_get(handler, tk);
}

"""TypeError.prototype for the Realm of the current execution context (Proxy *-realm.js)."""
def _vm_proxy_type_error_proto_current(vm: VM) -> JSValue {
    gv: JSValue = vm.realm.global_this;
    if jsv_is_object_cell(gv) {
        te_ctor: JSValue = js_object_get(gv, str_intern("TypeError"));
        if jsv_is_object_cell(te_ctor) {
            te_proto: JSValue = js_object_get(te_ctor, str_intern("prototype"));
            if jsv_is_object_cell(te_proto) {
                return te_proto;
            }
        }
    }
    return get_type_error_proto();
}

def _vm_proxy_throw(vm: VM, message: str) {
    vm_throw_native(
        create_error("TypeError", message, _vm_proxy_type_error_proto_current(vm))
    );
}

def _vm_proxy_throw_type_error(vm: VM, handler: JSValue, message: str) {
    _ = handler;
    _vm_proxy_throw(vm, message);
}

"""GetFunctionRealm: unwrap callable Proxy targets recursively (test262 get-fn-realm*.js)."""
def _vm_proxy_unwrap_for_function_realm(vm: VM, v: JSValue) -> JSValue {
    cur: JSValue = v;
    while js_is_proxy(cur) {
        if js_proxy_is_revoked(cur) {
            _vm_proxy_throw(
                vm, "Cannot perform 'get' on a proxy that has been revoked"
            );
            return cur;
        }
        cur = js_proxy_target(cur);
    }
    return cur;
}

def _vm_receiver_obs_gopd(vm: VM, receiver: JSValue, key_v: JSValue) -> bool {
    if js_is_proxy(receiver) {
        _ = proxy_trap_get_own_property_descriptor(vm, receiver, key_v);
        if vm_has_native_exc() {
            return False;
        }
    } else {
        _ = _vm_get_own_property_descriptor(vm, receiver, key_v);
        if vm_has_native_exc() {
            return False;
        }
    }
    return True;
}

"""
Module Namespace Exotic [[GetOwnProperty]] (§10.4.6.1):
always a data descriptor from [[Get]], or throw on uninitialized bindings.
"""
def _vm_module_namespace_gopd(vm: VM, ns: JSValue, key_v: JSValue) -> JSValue {
    kid: int = vm.obs_to_property_key(key_v);
    if vm_has_native_exc() {
        return js_undefined();
    }
    # Symbols → OrdinaryGetOwnProperty (@@toStringTag etc.).
    if kid >= SYMBOL_KEY_BASE {
        return js_Object_getOwnPropertyDescriptor(ns, key_v);
    }
    ks: str = str_from_id(kid);
    if ks == "__DEFER_PENDING" or ks == "__DEFER_PATH" {
        return js_undefined();
    }
    if not js_object_has_own(ns, kid) and not js_object_has_own_accessor(ns, kid) {
        return js_undefined();
    }
    # [[Get]] (throws ReferenceError for TDZ export bindings).
    val: JSValue = vm._get_prop_accessor_recv(ns, kid, ns);
    if vm.had_exception {
        exc_ng: JSValue = vm.pending_exc;
        vm.had_exception = False;
        vm.pending_exc = js_undefined();
        vm_throw_native(exc_ng);
        return js_undefined();
    }
    if vm_has_native_exc() {
        return js_undefined();
    }
    desc: JSValue = js_object_new_ordinary();
    js_object_set(desc, str_intern("value"), val);
    js_object_set(desc, str_intern("writable"), js_true());
    js_object_set(desc, str_intern("enumerable"), js_true());
    js_object_set(desc, str_intern("configurable"), js_false());
    return desc;
}

"""GetOwnProperty with module-namespace exotic semantics."""
def _vm_get_own_property_descriptor(
    vm: VM, target: JSValue, key_v: JSValue
) -> JSValue {
    if js_is_module_namespace(target) {
        return _vm_module_namespace_gopd(vm, target, key_v);
    }
    return js_Object_getOwnPropertyDescriptor(target, key_v);
}

def _vm_proxy_has_trap(vm: VM, handler: JSValue, trap_name: str) -> bool {
    trap_fn: JSValue = _vm_proxy_handler_get(vm, handler, trap_name);
    # Leave any abrupt completion pending; callers must check vm_has_native_exc().
    if vm_has_native_exc() {
        return False;
    }
    if jsv_is_undefined(trap_fn) or jsv_is_null(trap_fn) {
        return False;
    }
    if not _vm_proxy_trap_callable(trap_fn) {
        _vm_proxy_throw_type_error(
            vm, handler, "Proxy " + trap_name + " trap is not callable"
        );
        return False;
    }
    return True;
}

def _vm_proxy_call_trap(
    vm: VM, handler: JSValue, trap_name: str, args: list[JSValue]
) -> JSValue {
    trap_fn: JSValue = _vm_proxy_handler_get(vm, handler, trap_name);
    if vm_has_native_exc() {
        return js_undefined();
    }
    if jsv_is_undefined(trap_fn) or jsv_is_null(trap_fn) {
        return js_undefined();
    }
    if not _vm_proxy_trap_callable(trap_fn) {
        _vm_proxy_throw_type_error(
            vm, handler, "Proxy " + trap_name + " trap is not callable"
        );
        return js_undefined();
    }
    # Propagate trap throws via native exception channel.
    return vm_call_js_fn_observable(vm, trap_fn, handler, args);
}

def _vm_proxy_proto_same(a: JSValue, b: JSValue) -> bool {
    if jsv_is_null(a) and jsv_is_null(b) {
        return True;
    }
    if jsv_is_null(a) or jsv_is_null(b) {
        return False;
    }
    if jsv_is_object_cell(a) and jsv_is_object_cell(b) {
        return jsv_to_table_id(a) == jsv_to_table_id(b);
    }
    return False;
}

def _vm_proxy_validate_proto(v: JSValue) -> bool {
    if jsv_is_null(v) {
        return True;
    }
    return jsv_is_object_cell(v);
}

def _vm_same_value(a: JSValue, b: JSValue) -> bool {
    a_zero: bool = False;
    if jsv_is_int32(a) {
        a_zero = jsv_to_int32(a) == 0;
    } elif jsv_is_double(a) {
        a_zero = jsv_to_double(a) == 0.0;
    }
    b_zero: bool = False;
    if jsv_is_int32(b) {
        b_zero = jsv_to_int32(b) == 0;
    } elif jsv_is_double(b) {
        b_zero = jsv_to_double(b) == 0.0;
    }
    if a_zero and b_zero {
        a_neg: bool = False;
        if jsv_is_double(a) {
            a_neg = str(jsv_to_double(a)).startswith("-");
        }
        b_neg: bool = False;
        if jsv_is_double(b) {
            b_neg = str(jsv_to_double(b)).startswith("-");
        }
        return a_neg == b_neg;
    }
    if jsv_is_double(a) and jsv_is_double(b) {
        a_nan: bool = not (jsv_to_double(a) == jsv_to_double(a));
        b_nan: bool = not (jsv_to_double(b) == jsv_to_double(b));
        if a_nan and b_nan {
            return True;
        }
        if a_nan or b_nan {
            return False;
        }
        return jsv_to_double(a) == jsv_to_double(b);
    }
    if jsv_is_bigint_cell(a) and jsv_is_bigint_cell(b) {
        return js_bigint_cells_equal(a, b);
    }
    return js_strict_equal(a, b);
}

def _vm_proxy_check_get_invariant(
    vm: VM, target: JSValue, key: int, trap_result: JSValue
) -> bool {
    desc: JSProperty = js_object_get_own_property_descriptor(target, key);
    if desc.deleted {
        return True;
    }
    if desc.configurable {
        return True;
    }
    # Use has_own_accessor so getter:undefined / setter-only still count as accessors
    # (get_own_accessor_getter returns undefined for [[Get]]=undefined).
    if js_object_has_own_accessor(target, key) {
        own_getter: JSValue = js_object_get_own_accessor_getter(target, key);
        # ES §10.5.8 [[Get]] step 13.b: non-configurable accessor without [[Get]]
        # must report undefined from the trap.
        if jsv_is_undefined(own_getter) and not jsv_is_undefined(trap_result) {
            _vm_proxy_throw(
                vm,
                "Proxy get trap returned non-undefined for non-configurable accessor without getter"
            );
            return False;
        }
        return True;
    }
    if not desc.writable {
        if not _vm_same_value(trap_result, desc.value) {
            _vm_proxy_throw(
                vm,
                "Proxy get trap returned value inconsistent with non-writable, non-configurable property"
            );
            return False;
        }
    }
    return True;
}

def _vm_key_id_to_jsvalue(key: int) -> JSValue {
    if key >= SYMBOL_KEY_BASE {
        return jsv_from_symbol_id(key - SYMBOL_KEY_BASE);
    }
    return jsv_from_string_id(key);
}

# A Module Namespace stores its exports as non-configurable/non-writable own data
# properties on a marked object, so [[HasProperty]] / [[DefineOwnProperty]] flow
# through the ordinary own-property + define-invariant paths once _defer_ns_maybe_eval
# has forced evaluation.

def _vm_proxy_set_invariant_error(key: int) -> str {
    key_label: str = str_from_id(key);
    if key >= SYMBOL_KEY_BASE {
        key_label = str_from_id(key);
    }
    return (
        "'set' on proxy: trap returned truish for property '"
        + key_label
        + "' which exists in the proxy target as a non-configurable and non-writable "
        + "data property with a different value"
    );
}

def _vm_proxy_check_set_invariant(
    vm: VM, target: JSValue, key: int, val: JSValue, trap_ok: bool
) -> bool {
    if not trap_ok {
        return True;
    }
    desc: JSProperty = js_object_get_own_property_descriptor(target, key);
    if desc.deleted {
        if not js_object_is_extensible(target) {
            _vm_proxy_throw(
                vm,
                "'set' on proxy: trap returned truish for property on non-extensible target"
            );
            return False;
        }
        return True;
    }
    if not desc.configurable {
        # Prefer has_own_accessor so get:undefined / set:undefined still count.
        if js_object_has_own_accessor(target, key) {
            own_setter: JSValue = js_object_get_own_accessor_setter(target, key);
            if jsv_is_undefined(own_setter) {
                _vm_proxy_throw(
                    vm,
                    "'set' on proxy: trap returned truish for non-configurable accessor without setter"
                );
                return False;
            }
        } elif not desc.writable {
            if not _vm_same_value(val, desc.value) {
                _vm_proxy_throw(vm, _vm_proxy_set_invariant_error(key));
                return False;
            }
        }
    }
    return True;
}

def _vm_is_array_index_key_id(kid: int) -> bool {
    if kid >= SYMBOL_KEY_BASE {
        return False;
    }
    # Cached per key id (it scanned the text with a substring per digit).
    return str_id_is_array_index(kid);
}

def _vm_array_index_sort_key(kid: int) -> int {
    s: str = str_from_id(kid);
    np: int = 0;
    pi: int = 0;
    sn: int = len(s);
    # Byte-wise digit test: the previous `ch: str = str_substr(...)` per digit
    # parked an owned 1-byte str in a named local that is never released — two
    # leaked allocations per array-index property get (Array.prototype.join over
    # 800 elements retained 100KB per call).
    while pi < sn {
        cc: int = ord(s[pi]);
        if cc >= 48 and cc <= 57 {
            np = np * 10 + (cc - 48);
        }
        pi = pi + 1;
    }
    return np;
}

def _vm_sort_string_keys_by_codepoint(keys: list[int]) -> list[int] {
    n: int = len(keys);
    if n <= 1 {
        return keys;
    }
    strs: list[str] = [];
    ki: int = 0;
    while ki < n {
        strs.append(str_from_id(keys[ki]));
        ki = ki + 1;
    }
    i: int = 0;
    while i < n - 1 {
        j: int = i + 1;
        while j < n {
            if strs[j] < strs[i] {
                tmp_k: int = keys[i];
                keys[i] = keys[j];
                keys[j] = tmp_k;
                tmp_s: str = strs[i];
                strs[i] = strs[j];
                strs[j] = tmp_s;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return keys;
}

def _vm_sort_own_key_ids(
    keys: list[int], codepoint_strings: bool = False
) -> list[int] {
    indices: list[int] = [];
    strings: list[int] = [];
    symbols: list[int] = [];
    for kid in keys {
        # Filter engine-internal marker keys that must never be spec-visible:
        # negative ids, and _KEY_IS_ARRAY / other markers in [BUILTIN_BASE, SYMBOL_KEY_BASE).
        # Empty-string keys are real (str_intern("")) and must remain visible —
        # markers no longer collide with "" (_KEY_IS_ARRAY is 1000001).
        if kid < 0 {
            continue;
        }
        if kid >= BUILTIN_BASE and kid < SYMBOL_KEY_BASE {
            continue;
        }
        if kid >= SYMBOL_KEY_BASE {
            symbols.append(kid);
        } elif _vm_is_array_index_key_id(kid) {
            indices.append(kid);
        } else {
            strings.append(kid);
        }
    }
    ii: int = 0;
    while ii < len(indices) {
        ij: int = ii + 1;
        while ij < len(indices) {
            if _vm_array_index_sort_key(indices[ij])
                < _vm_array_index_sort_key(indices[ii]) {
                tmp: int = indices[ii];
                indices[ii] = indices[ij];
                indices[ij] = tmp;
            }
            ij = ij + 1;
        }
        ii = ii + 1;
    }
    if codepoint_strings {
        strings = _vm_sort_string_keys_by_codepoint(strings);
    }
    out: list[int] = [];
    for kid in indices {
        out.append(kid);
    }
    for kid in strings {
        out.append(kid);
    }
    for kid in symbols {
        out.append(kid);
    }
    return out;
}

def _vm_create_list_from_array_like(vm: VM, arr: JSValue) -> list[JSValue] {
    # §7.3.18 CreateListFromArrayLike: read length + elements via [[Get]] (so
    # array-like proxies / getters are honoured — a direct js_array_len/js_array_get
    # scan would not). Trap-key validation lives in _vm_keys_from_trap_array, which
    # calls this.
    out: list[JSValue] = [];
    if not jsv_is_any_object(arr) {
        _vm_proxy_throw(vm, "CreateListFromArrayLike called on non-object");
        return out;
    }
    len_v: JSValue = _vm_get_for_list(vm, arr, WK_LENGTH);
    if vm_has_native_exc() {
        return out;
    }
    if vm.had_exception {
        return out;
    }
    n: int = 0;
    f: float = _to_integer_or_infinity(len_v);
    if vm_has_native_exc() {
        return out;
    }
    if f > 0.0 {
        max_len: float = 9007199254740991.0;
        if f > max_len {
            f = max_len;
        }
        n = int(f);
    }
    ki: int = 0;
    while ki < n {
        k: int = str_intern_index(ki);
        el: JSValue = _vm_get_for_list(vm, arr, k);
        if vm_has_native_exc() {
            return out;
        }
        if vm.had_exception {
            return out;
        }
        out.append(el);
        ki = ki + 1;
    }
    return out;
}

def _vm_keys_from_trap_array(vm: VM, arr: JSValue) -> list[int] {
    out: list[int] = [];
    if not jsv_is_object_cell(arr) {
        _vm_proxy_throw(vm, "Proxy ownKeys trap must return an object");
        return out;
    }
    elems: list[JSValue] = _vm_create_list_from_array_like(vm, arr);
    if vm_has_native_exc() or vm.had_exception {
        return out;
    }
    for el in elems {
        if not jsv_is_string_cell(el) and not jsv_is_symbol(el) {
            _vm_proxy_throw(
                vm, "Proxy ownKeys trap result must contain only string and symbol keys"
            );
            return out;
        }
        kid: int = jsval_to_prop_key(el);
        for seen in out {
            if seen == kid {
                _vm_proxy_throw(vm, "Proxy ownKeys trap result contains duplicate key");
                return out;
            }
        }
        out.append(kid);
    }
    return out;
}

def _vm_key_in_list(key: int, keys: list[int]) -> bool {
    for k in keys {
        if k == key {
            return True;
        }
    }
    return False;
}

def _vm_dedupe_key_ids(keys: list[int]) -> list[int] {
    out: list[int] = [];
    for kid in keys {
        if not _vm_key_in_list(kid, out) {
            out.append(kid);
        }
    }
    return out;
}

def _vm_proxy_target_own_key_ids(vm: VM, target: JSValue) -> list[int] {
    if js_is_proxy(target) {
        return proxy_trap_own_keys_list(vm, target);
    }
    if vm._ta_is_instance(target) {
        return vm._ta_own_keys(target, False);
    }
    if is_fn_val(target) {
        out_fk: list[int] = [];
        if vm._fn_has_own_key(target, WK_LENGTH) {
            out_fk.append(WK_LENGTH);
        }
        if vm._fn_has_own_key(target, WK_NAME) {
            out_fk.append(WK_NAME);
        }
        if vm._fn_has_own_key(target, WK_PROTOTYPE) {
            out_fk.append(WK_PROTOTYPE);
        }
        fi_fk: int = get_fn_idx(target);
        if fi_fk >= 0 and fi_fk < len(vm.realm.closures) {
            for fk_f in js_object_all_keys(vm.realm.closures[fi_fk].fn_props) {
                if fk_f != WK_LENGTH
                    and fk_f != WK_NAME
                    and fk_f != WK_PROTOTYPE
                    and not _vm_fn_prop_key_hidden(fk_f) {
                    out_fk.append(fk_f);
                }
            }
        }
        return out_fk;
    }
    if is_native_val(target) {
        out_nk: list[int] = [];
        if not native_key_removed(target, WK_LENGTH) {
            out_nk.append(WK_LENGTH);
        }
        if not native_key_removed(target, WK_NAME) {
            out_nk.append(WK_NAME);
        }
        np_fk: JSValue = native_props_get(target);
        if jsv_is_object_cell(np_fk) {
            for nk_f in js_object_all_keys(np_fk) {
                if nk_f >= 0 and nk_f != WK_LENGTH and nk_f != WK_NAME {
                    out_nk.append(nk_f);
                }
            }
        }
        return out_nk;
    }
    keys: list[int] = _vm_sort_own_key_ids(js_object_all_keys(target));
    if is_string_object(target) {
        prim_s: JSValue = string_value_of(target);
        s_s: str = str_from_id(jsv_to_table_id(prim_s));
        n_s: int = js_string_utf16_len(s_s);
        si: int = 0;
        while si < n_s {
            sk: int = str_intern_index(si);
            if not _vm_key_in_list(sk, keys) {
                keys.append(sk);
            }
            si = si + 1;
        }
        keys = _vm_sort_own_key_ids(keys);
    }
    return keys;
}

def _vm_proxy_target_own_nonconfigurable(vm: VM, target: JSValue, tk: int) -> bool {
    key_v: JSValue = _vm_key_id_to_jsvalue(tk);
    if js_is_proxy(target) {
        gopd_p: JSValue = proxy_trap_get_own_property_descriptor(vm, target, key_v);
        if vm_has_native_exc() or jsv_is_undefined(gopd_p) {
            return False;
        }
        ck_p: int = str_intern("configurable");
        if js_object_has_own(gopd_p, ck_p) {
            return not jsv_coerce_to_bool(js_object_get(gopd_p, ck_p));
        }
        return False;
    }
    if is_fn_val(target) or is_native_val(target) {
        gopd_f: JSValue = vm._fn_own_descriptor(target, key_v);
        if jsv_is_undefined(gopd_f) {
            return False;
        }
        ck_f: int = str_intern("configurable");
        if js_object_has_own(gopd_f, ck_f) {
            return not jsv_coerce_to_bool(js_object_get(gopd_f, ck_f));
        }
        return False;
    }
    if is_string_object(target) and js_string_exotic_has_index(target, tk) {
        return True;
    }
    desc_p: JSProperty = js_object_get_own_property_descriptor(target, tk);
    if desc_p.deleted {
        return False;
    }
    return not desc_p.configurable;
}

def _vm_proxy_validate_own_keys(vm: VM, target: JSValue, trap_keys: list[int]) -> bool {
    target_keys: list[int] = _vm_proxy_target_own_key_ids(vm, target);
    if vm_has_native_exc() {
        return False;
    }
    target_keys = _vm_dedupe_key_ids(target_keys);
    for tk in target_keys {
        if _vm_proxy_target_own_nonconfigurable(vm, target, tk) {
            if vm_has_native_exc() {
                return False;
            }
            if not _vm_key_in_list(tk, trap_keys) {
                _vm_proxy_throw(
                    vm, "Proxy ownKeys trap failed to include non-configurable property"
                );
                return False;
            }
        }
    }
    if not js_object_is_extensible(target) {
        if len(trap_keys) != len(target_keys) {
            _vm_proxy_throw(vm, "Proxy ownKeys trap did not return all keys");
            return False;
        }
        for tk in target_keys {
            if not _vm_key_in_list(tk, trap_keys) {
                _vm_proxy_throw(vm, "Proxy ownKeys trap did not return all keys");
                return False;
            }
        }
    }
    return True;
}

def _vm_proxy_desc_has_own(desc: JSValue, key: int) -> bool {
    return jsv_is_object_cell(desc) and js_object_has_own(desc, key);
}

def _vm_proxy_is_compatible_descriptor(
    desc: JSValue, current: JSProperty, target: JSValue, kid: int
) -> bool {
    if current.deleted {
        return True;
    }
    if not jsv_is_object_cell(desc) {
        return False;
    }
    gk: int = str_intern("get");
    sk: int = str_intern("set");
    vk: int = str_intern("value");
    wk: int = str_intern("writable");
    ek: int = str_intern("enumerable");
    ck: int = str_intern("configurable");
    has_get: bool = _vm_proxy_desc_has_own(desc, gk);
    has_set: bool = _vm_proxy_desc_has_own(desc, sk);
    has_val: bool = _vm_proxy_desc_has_own(desc, vk);
    has_w: bool = _vm_proxy_desc_has_own(desc, wk);
    is_acc: bool = has_get or has_set;
    is_data: bool = has_val or has_w;
    cur_acc: bool = (
        not jsv_is_undefined(js_object_get_own_accessor_getter(target, kid))
        or not jsv_is_undefined(js_object_get_own_accessor_setter(target, kid))
    );
    if not current.configurable {
        if _vm_proxy_desc_has_own(desc, ck)
            and jsv_coerce_to_bool(js_object_get(desc, ck)) {
            return False;
        }
        if _vm_proxy_desc_has_own(desc, ek) {
            if jsv_coerce_to_bool(js_object_get(desc, ek)) != current.enumerable {
                return False;
            }
        }
        if cur_acc {
            if is_data and not is_acc {
                return False;
            }
            if has_get {
                cur_g: JSValue = js_object_get_own_accessor_getter(target, kid);
                if not _vm_same_value(js_object_get(desc, gk), cur_g) {
                    return False;
                }
            }
            if has_set {
                cur_s: JSValue = js_object_get_own_accessor_setter(target, kid);
                if not _vm_same_value(js_object_get(desc, sk), cur_s) {
                    return False;
                }
            }
        } else {
            if is_acc {
                return False;
            }
            if not current.writable {
                if has_w and jsv_coerce_to_bool(js_object_get(desc, wk)) {
                    return False;
                }
                if has_val {
                    if not _vm_same_value(js_object_get(desc, vk), current.value) {
                        return False;
                    }
                }
            } else {
                # §10.5.6 [[DefineOwnProperty]] step 16.c: a proxy must not report
                # success for a Desc that makes a non-configurable *writable* target
                # non-writable — the writability of a non-configurable property is
                # an invariant the proxy cannot observably flip (stricter than
                # OrdinaryDefine, which permits writable T→F here).
                if has_w and not jsv_coerce_to_bool(js_object_get(desc, wk)) {
                    return False;
                }
            }
        }
    }
    return True;
}

def _vm_proxy_validate_gopd(
    vm: VM, target: JSValue, key: int, trap_desc: JSValue
) -> bool {
    if not jsv_is_undefined(trap_desc) and not jsv_is_object_cell(trap_desc) {
        _vm_proxy_throw(
            vm, "Proxy getOwnPropertyDescriptor trap must return an object or undefined"
        );
        return False;
    }
    target_desc: JSProperty = js_object_get_own_property_descriptor(target, key);
    if jsv_is_undefined(trap_desc) {
        # ES §10.5.5 [[GetOwnProperty]] steps 10.a–d: undefined is only legal when
        # the target property is absent, or present+configurable on an extensible target.
        if target_desc.deleted {
            return True;
        }
        if not target_desc.configurable {
            _vm_proxy_throw(
                vm,
                "Proxy getOwnPropertyDescriptor trap returned undefined for non-configurable property"
            );
            return False;
        }
        if not js_object_is_extensible(target) {
            _vm_proxy_throw(
                vm,
                "Proxy getOwnPropertyDescriptor trap returned undefined for property on non-extensible target"
            );
            return False;
        }
        return True;
    }
    # Spec [[GetOwnProperty]]: trap returned a descriptor but target has no own
    # property — inventing one on a non-extensible target is a TypeError.
    if target_desc.deleted {
        if not js_object_is_extensible(target) {
            _vm_proxy_throw(
                vm,
                "Proxy getOwnPropertyDescriptor trap cannot invent a property on a non-extensible target"
            );
            return False;
        }
        # Non-configurable result for a missing target property is also forbidden.
        ck_miss: int = str_intern("configurable");
        if jsv_is_object_cell(trap_desc) and js_object_has_own(trap_desc, ck_miss) {
            if not jsv_coerce_to_bool(js_object_get(trap_desc, ck_miss)) {
                _vm_proxy_throw(
                    vm,
                    "Proxy getOwnPropertyDescriptor trap reported non-configurable descriptor for missing property"
                );
                return False;
            }
        }
        return True;
    }
    if not jsv_is_object_cell(trap_desc) {
        return True;
    }
    ck: int = str_intern("configurable");
    trap_cfg: bool = True;
    if js_object_has_own(trap_desc, ck) {
        trap_cfg = jsv_coerce_to_bool(js_object_get(trap_desc, ck));
    }
    # ES §10.5.5 step 22: non-configurable result requires non-configurable targetDesc.
    if not trap_cfg and target_desc.configurable {
        _vm_proxy_throw(
            vm,
            "Proxy getOwnPropertyDescriptor trap reported non-configurable descriptor for configurable property"
        );
        return False;
    }
    if not target_desc.configurable and trap_cfg {
        _vm_proxy_throw(
            vm, "Proxy getOwnPropertyDescriptor trap returned incompatible descriptor"
        );
        return False;
    }
    if not target_desc.configurable {
        wk: int = str_intern("writable");
        ek: int = str_intern("enumerable");
        vk: int = str_intern("value");
        gk: int = str_intern("get");
        sk: int = str_intern("set");
        cur_acc: bool = (
            not jsv_is_undefined(js_object_get_own_accessor_getter(target, key))
            or not jsv_is_undefined(js_object_get_own_accessor_setter(target, key))
        );
        if js_object_has_own(trap_desc, wk) {
            if jsv_coerce_to_bool(js_object_get(trap_desc, wk))
                != target_desc.writable {
                _vm_proxy_throw(
                    vm,
                    "Proxy getOwnPropertyDescriptor trap returned incompatible descriptor"
                );
                return False;
            }
        }
        if js_object_has_own(trap_desc, ek) {
            if jsv_coerce_to_bool(js_object_get(trap_desc, ek))
                != target_desc.enumerable {
                _vm_proxy_throw(
                    vm,
                    "Proxy getOwnPropertyDescriptor trap returned incompatible descriptor"
                );
                return False;
            }
        }
        if cur_acc {
            if js_object_has_own(trap_desc, gk) {
                cur_g: JSValue = js_object_get_own_accessor_getter(target, key);
                if not _vm_same_value(js_object_get(trap_desc, gk), cur_g) {
                    _vm_proxy_throw(
                        vm,
                        "Proxy getOwnPropertyDescriptor trap returned incompatible descriptor"
                    );
                    return False;
                }
            }
            if js_object_has_own(trap_desc, sk) {
                cur_s: JSValue = js_object_get_own_accessor_setter(target, key);
                if not _vm_same_value(js_object_get(trap_desc, sk), cur_s) {
                    _vm_proxy_throw(
                        vm,
                        "Proxy getOwnPropertyDescriptor trap returned incompatible descriptor"
                    );
                    return False;
                }
            }
        } elif not target_desc.writable and js_object_has_own(trap_desc, vk) {
            trap_val: JSValue = js_object_get(trap_desc, vk);
            if not _vm_same_value(trap_val, target_desc.value) {
                _vm_proxy_throw(
                    vm,
                    "Proxy getOwnPropertyDescriptor trap returned incompatible descriptor"
                );
                return False;
            }
        }
    }
    return True;
}

def _vm_own_keys_to_js_array(key_ids: list[int]) -> JSValue {
    items: list[JSValue] = [];
    for kid in key_ids {
        if kid < 0 {
            continue;
        }
        # Engine marker keys (BUILTIN_BASE..SYMBOL_KEY_BASE) are not interned
        # strings — emitting them surfaces a spurious empty key.
        if kid >= BUILTIN_BASE and kid < SYMBOL_KEY_BASE {
            continue;
        }
        if kid >= SYMBOL_KEY_BASE {
            items.append(jsv_from_symbol_id(kid - SYMBOL_KEY_BASE));
        } else {
            items.append(jsv_from_string_id(kid));
        }
    }
    return js_array_create(items);
}

def:pub proxy_trap_get(vm: VM, p: JSValue, key: int, receiver: JSValue) -> JSValue {
    if js_proxy_is_revoked(p) {
        _vm_proxy_throw(vm, "Cannot perform 'get' on a proxy that has been revoked");
        return js_undefined();
    }
    target: JSValue = js_proxy_target(p);
    handler: JSValue = js_proxy_handler(p);
    key_v: JSValue = _vm_key_id_to_jsvalue(key);
    if _vm_proxy_has_trap(vm, handler, "get") {
        res: JSValue = _vm_proxy_call_trap(
            vm, handler, "get", [target, key_v, receiver]
        );
        if vm_has_native_exc() {
            return js_undefined();
        }
        if not _vm_proxy_check_get_invariant(vm, target, key, res) {
            return js_undefined();
        }
        return res;
    }
    if vm_has_native_exc() {
        return js_undefined();
    }
    # Null/undefined/missing trap: forward [[Get]] to the target (may itself be a Proxy).
    if js_is_proxy(target) {
        return proxy_trap_get(vm, target, key, receiver);
    }
    return _vm_object_get_vop(vm, target, key, receiver);
}

def:pub proxy_trap_has(vm: VM, p: JSValue, key: int) -> bool {
    if js_proxy_is_revoked(p) {
        _vm_proxy_throw(vm, "Cannot perform 'has' on a proxy that has been revoked");
        return False;
    }
    target: JSValue = js_proxy_target(p);
    handler: JSValue = js_proxy_handler(p);
    key_v: JSValue = _vm_key_id_to_jsvalue(key);
    if _vm_proxy_has_trap(vm, handler, "has") {
        tr_v: JSValue = _vm_proxy_call_trap(vm, handler, "has", [target, key_v]);
        if vm_has_native_exc() {
            return False;
        }
        trap_res: bool = jsv_coerce_to_bool(tr_v);
        desc: JSProperty = js_object_get_own_property_descriptor(target, key);
        if trap_res {
            if desc.deleted and not js_object_is_extensible(target) {
                _vm_proxy_throw(
                    vm,
                    "Proxy 'has' trap returned true for property absent on non-extensible target"
                );
                return False;
            }
        } elif not desc.deleted {
            # ES §10.5.7 [[HasProperty]]: false is forbidden for non-configurable
            # own properties and for any own property of a non-extensible target.
            if not desc.configurable {
                _vm_proxy_throw(
                    vm, "Proxy 'has' trap returned false for non-configurable property"
                );
                return False;
            }
            if not js_object_is_extensible(target) {
                _vm_proxy_throw(
                    vm,
                    "Proxy 'has' trap returned false for property present on non-extensible target"
                );
                return False;
            }
        }
        return trap_res;
    }
    if vm_has_native_exc() {
        return False;
    }
    if js_is_proxy(target) {
        return proxy_trap_has(vm, target, key);
    }
    return vm.obs_has(target, key);
}

def:pub proxy_trap_delete(vm: VM, p: JSValue, key: int) -> bool {
    if js_proxy_is_revoked(p) {
        _vm_proxy_throw(
            vm, "Cannot perform 'deleteProperty' on a proxy that has been revoked"
        );
        return False;
    }
    target: JSValue = js_proxy_target(p);
    handler: JSValue = js_proxy_handler(p);
    key_v: JSValue = _vm_key_id_to_jsvalue(key);
    if _vm_proxy_has_trap(vm, handler, "deleteProperty") {
        tr_v: JSValue = _vm_proxy_call_trap(
            vm, handler, "deleteProperty", [target, key_v]
        );
        if vm_has_native_exc() {
            return False;
        }
        trap_ok: bool = jsv_coerce_to_bool(tr_v);
        desc: JSProperty = js_object_get_own_property_descriptor(target, key);
        if trap_ok {
            # ES §10.5.10: absent targetDesc → return true (no extensible check).
            # Present + non-configurable → TypeError; present + non-extensible → TypeError.
            if not desc.deleted {
                if not desc.configurable {
                    _vm_proxy_throw(
                        vm,
                        "Proxy 'deleteProperty' trap returned true for non-configurable property"
                    );
                    return False;
                }
                if not js_object_is_extensible(target) {
                    _vm_proxy_throw(
                        vm,
                        "Proxy 'deleteProperty' trap returned true for configurable property on non-extensible target"
                    );
                    return False;
                }
            }
        }
        return trap_ok;
    }
    if js_is_proxy(target) {
        return proxy_trap_delete(vm, target, key);
    }
    # Forward [[Delete]] through observable path (String/TA/fn intrinsics).
    return vm.obs_delete(target, key);
}

def:pub proxy_trap_set(
    vm: VM, p: JSValue, key: int, val: JSValue, receiver: JSValue
) -> bool {
    if js_proxy_is_revoked(p) {
        _vm_proxy_throw(vm, "Cannot perform 'set' on a proxy that has been revoked");
        return False;
    }
    target: JSValue = js_proxy_target(p);
    handler: JSValue = js_proxy_handler(p);
    key_v: JSValue = _vm_key_id_to_jsvalue(key);
    if _vm_proxy_has_trap(vm, handler, "set") {
        tr_v: JSValue = _vm_proxy_call_trap(
            vm, handler, "set", [target, key_v, val, receiver]
        );
        if vm_has_native_exc() {
            return False;
        }
        trap_ok: bool = jsv_coerce_to_bool(tr_v);
        if not _vm_proxy_check_set_invariant(vm, target, key, val, trap_ok) {
            return False;
        }
        return trap_ok;
    }
    if vm_has_native_exc() {
        return False;
    }
    if js_is_proxy(target) {
        return proxy_trap_set(vm, target, key, val, receiver);
    }
    # Default [[Set]]: target.[[Set]](P, V, Receiver). When Receiver differs from
    # target, OrdinarySetWithOwnDescriptor uses Receiver.[[GetOwnProperty]] then
    # Receiver.[[DefineOwnProperty]] (test262 property-traps-order-with-species).
    if jsv_is_object_cell(receiver)
        and not (
            jsv_is_object_cell(target)
            and jsv_to_table_id(receiver) == jsv_to_table_id(target)
        ) {
        own_desc: JSProperty = js_object_get_own_property_descriptor(target, key);
        if not own_desc.deleted {
            own_getter: JSValue = js_object_get_own_accessor_getter(target, key);
            own_setter: JSValue = js_object_get_own_accessor_setter(target, key);
            is_accessor: bool = (not jsv_is_undefined(own_getter))
                or (not jsv_is_undefined(own_setter));
            if not is_accessor {
                if not own_desc.writable {
                    return False;
                }
                if not _vm_receiver_obs_gopd(vm, receiver, key_v) {
                    return False;
                }
                desc_obj: JSValue = js_object_create_null();
                js_object_set(desc_obj, WK_VALUE, val);
                js_object_set(desc_obj, str_intern("writable"), js_boolean(True));
                js_object_set(
                    desc_obj, str_intern("enumerable"), js_boolean(own_desc.enumerable)
                );
                js_object_set(
                    desc_obj,
                    str_intern("configurable"),
                    js_boolean(own_desc.configurable)
                );
                if js_is_proxy(receiver) {
                    return proxy_trap_define_property(vm, receiver, key_v, desc_obj);
                }
                return js_Reflect_defineProperty(receiver, key_v, desc_obj);
            }
        } else {
            # No own property on target: CreateDataProperty(Receiver, P, V).
            if not _vm_receiver_obs_gopd(vm, receiver, key_v) {
                return False;
            }
            desc_new: JSValue = js_object_create_null();
            js_object_set(desc_new, WK_VALUE, val);
            js_object_set(desc_new, str_intern("writable"), js_boolean(True));
            js_object_set(desc_new, str_intern("enumerable"), js_boolean(True));
            js_object_set(desc_new, str_intern("configurable"), js_boolean(True));
            if js_is_proxy(receiver) {
                return proxy_trap_define_property(vm, receiver, key_v, desc_new);
            }
            return js_Reflect_defineProperty(receiver, key_v, desc_new);
        }
    }
    return vm.obs_set(target, key, val, receiver);
}

"""
OrdinarySet when Receiver differs from target: Receiver.[[GetOwnProperty]] then
Receiver.[[DefineOwnProperty]] (ES §10.1.9.2 / test262 property-traps-order-with-species).
Returns True/False when handled; when False and not handled, caller continues on target.
"""
def _vm_ordinary_set_differing_receiver(
    vm: VM, target: JSValue, key: int, val: JSValue, receiver: JSValue
) -> bool {
    if not jsv_is_object_cell(receiver) {
        return False;
    }
    if jsv_is_object_cell(target)
        and jsv_to_table_id(receiver) == jsv_to_table_id(target) {
        return False;
    }
    own_desc: JSProperty = js_object_get_own_property_descriptor(target, key);
    if not own_desc.deleted {
        own_getter: JSValue = js_object_get_own_accessor_getter(target, key);
        own_setter: JSValue = js_object_get_own_accessor_setter(target, key);
        is_accessor: bool = (not jsv_is_undefined(own_getter))
            or (not jsv_is_undefined(own_setter));
        if not is_accessor {
            if not own_desc.writable {
                return False;
            }
            key_v: JSValue = _vm_key_id_to_jsvalue(key);
            if not _vm_receiver_obs_gopd(vm, receiver, key_v) {
                return False;
            }
            desc_obj: JSValue = js_object_create_null();
            js_object_set(desc_obj, WK_VALUE, val);
            js_object_set(desc_obj, str_intern("writable"), js_boolean(True));
            js_object_set(
                desc_obj, str_intern("enumerable"), js_boolean(own_desc.enumerable)
            );
            js_object_set(
                desc_obj, str_intern("configurable"), js_boolean(own_desc.configurable)
            );
            if js_is_proxy(receiver) {
                return proxy_trap_define_property(vm, receiver, key_v, desc_obj);
            }
            return js_Reflect_defineProperty(receiver, key_v, desc_obj);
        }
        # Accessor own descriptor: OrdinarySetWithOwnDescriptor calls [[Set]] on Receiver.
        if jsv_is_undefined(own_setter) {
            return False;
        }
        if is_fn_val(own_setter) {
            set_cl: JSClosure = vm.realm.closures[get_fn_idx(own_setter)];
            _ = vm.run_cl(set_cl, own_setter, receiver, [val]);
            if vm.had_exception or vm_has_native_exc() {
                return False;
            }
            return True;
        }
        if is_native_val(own_setter) {
            _ = _vm_call_native_proxy_aware(
                vm, vm.realm, get_native_kind(own_setter), receiver, [val]
            );
            if vm_has_native_exc() {
                return False;
            }
            return True;
        }
        return False;
    } else {
        key_v2: JSValue = _vm_key_id_to_jsvalue(key);
        if not _vm_receiver_obs_gopd(vm, receiver, key_v2) {
            return False;
        }
        desc_new: JSValue = js_object_create_null();
        js_object_set(desc_new, WK_VALUE, val);
        js_object_set(desc_new, str_intern("writable"), js_boolean(True));
        js_object_set(desc_new, str_intern("enumerable"), js_boolean(True));
        js_object_set(desc_new, str_intern("configurable"), js_boolean(True));
        if js_is_proxy(receiver) {
            return proxy_trap_define_property(vm, receiver, key_v2, desc_new);
        }
        return js_Reflect_defineProperty(receiver, key_v2, desc_new);
    }
    return False;
}

def:pub proxy_trap_define_property(
    vm: VM, p: JSValue, key: JSValue, descriptor: JSValue
) -> bool {
    if js_proxy_is_revoked(p) {
        _vm_proxy_throw(
            vm, "Cannot perform 'defineProperty' on a proxy that has been revoked"
        );
        return False;
    }
    target: JSValue = js_proxy_target(p);
    handler: JSValue = js_proxy_handler(p);
    kid: int = jsval_to_prop_key(key);
    if _vm_proxy_has_trap(vm, handler, "defineProperty") {
        tr_v: JSValue = _vm_proxy_call_trap(
            vm, handler, "defineProperty", [target, key, descriptor]
        );
        if vm_has_native_exc() {
            return False;
        }
        trap_ok: bool = jsv_coerce_to_bool(tr_v);
        if not trap_ok {
            return False;
        }
        desc: JSProperty = js_object_get_own_property_descriptor(target, kid);
        # Proxy [[DefineOwnProperty]] invariant: success with [[Configurable]]:false
        # requires the target own desc to already exist and be non-configurable.
        ck_inv: int = str_intern("configurable");
        if jsv_is_object_cell(descriptor) and js_object_has_own(descriptor, ck_inv) {
            if not jsv_coerce_to_bool(js_object_get(descriptor, ck_inv)) {
                if desc.deleted or desc.configurable {
                    _vm_proxy_throw(
                        vm,
                        "Proxy defineProperty trap reported non-configurable descriptor for configurable or missing property"
                    );
                    return False;
                }
            }
        }
        if desc.deleted {
            if not js_object_is_extensible(target) {
                _vm_proxy_throw(
                    vm,
                    "Proxy defineProperty trap cannot add property to non-extensible target"
                );
                return False;
            }
        } elif not _vm_proxy_is_compatible_descriptor(descriptor, desc, target, kid) {
            _vm_proxy_throw(
                vm,
                "Proxy defineProperty trap returned incompatible descriptor for non-configurable property"
            );
            return False;
        }
        return True;
    }
    if vm_has_native_exc() {
        return False;
    }
    # Null/undefined/missing trap: forward [[DefineOwnProperty]] to the target.
    if js_is_proxy(target) {
        return proxy_trap_define_property(vm, target, key, descriptor);
    }
    if is_fn_val(target) or is_native_val(target) {
        return jsv_coerce_to_bool(
            _vm_function_define_property(vm, target, key, descriptor, False)
        );
    }
    return js_Reflect_defineProperty(target, key, descriptor);
}

def:pub proxy_trap_prevent_extensions(vm: VM, p: JSValue) -> bool {
    if js_proxy_is_revoked(p) {
        _vm_proxy_throw(
            vm, "Cannot perform 'preventExtensions' on a proxy that has been revoked"
        );
        return False;
    }
    target: JSValue = js_proxy_target(p);
    handler: JSValue = js_proxy_handler(p);
    if _vm_proxy_has_trap(vm, handler, "preventExtensions") {
        tr_v: JSValue = _vm_proxy_call_trap(vm, handler, "preventExtensions", [target]);
        if vm_has_native_exc() {
            return False;
        }
        if not jsv_coerce_to_bool(tr_v) {
            return False;
        }
        # Trap true ⇒ target must already be non-extensible (Proxy-aware IsExtensible).
        target_ext: bool = False;
        if js_is_proxy(target) {
            target_ext = proxy_trap_is_extensible(vm, target);
            if vm_has_native_exc() {
                return False;
            }
        } else {
            target_ext = js_object_is_extensible(target);
        }
        if target_ext {
            _vm_proxy_throw(
                vm,
                "Proxy preventExtensions trap returned true but target is still extensible"
            );
            return False;
        }
        return True;
    }
    # Missing trap → target.[[PreventExtensions]] (nested Proxy forward).
    if js_is_proxy(target) {
        return proxy_trap_prevent_extensions(vm, target);
    }
    js_object_prevent_extensions(target);
    return True;
}

def:pub proxy_trap_is_extensible(vm: VM, p: JSValue) -> bool {
    if js_proxy_is_revoked(p) {
        _vm_proxy_throw(
            vm, "Cannot perform 'isExtensible' on a proxy that has been revoked"
        );
        return False;
    }
    target: JSValue = js_proxy_target(p);
    handler: JSValue = js_proxy_handler(p);
    # actual = target.[[IsExtensible]] (Proxy-aware).
    actual: bool = False;
    if js_is_proxy(target) {
        actual = proxy_trap_is_extensible(vm, target);
        if vm_has_native_exc() {
            return False;
        }
    } else {
        actual = js_object_is_extensible(target);
    }
    if _vm_proxy_has_trap(vm, handler, "isExtensible") {
        tr_v: JSValue = _vm_proxy_call_trap(vm, handler, "isExtensible", [target]);
        if vm_has_native_exc() {
            return False;
        }
        trap_res: bool = jsv_coerce_to_bool(tr_v);
        if trap_res != actual {
            _vm_proxy_throw(
                vm, "Proxy isExtensible trap result inconsistent with target"
            );
            return False;
        }
        return trap_res;
    }
    return actual;
}

def:pub proxy_trap_own_keys_list(vm: VM, p: JSValue) -> list[int] {
    if js_proxy_is_revoked(p) {
        _vm_proxy_throw(
            vm, "Cannot perform 'ownKeys' on a proxy that has been revoked"
        );
        return [];
    }
    target: JSValue = js_proxy_target(p);
    handler: JSValue = js_proxy_handler(p);
    if _vm_proxy_has_trap(vm, handler, "ownKeys") {
        tr_v: JSValue = _vm_proxy_call_trap(vm, handler, "ownKeys", [target]);
        if vm_has_native_exc() {
            return [];
        }
        trap_keys: list[int] = _vm_keys_from_trap_array(vm, tr_v);
        if not _vm_proxy_validate_own_keys(vm, target, trap_keys) {
            return [];
        }
        return trap_keys;
    }
    if js_is_proxy(target) {
        return proxy_trap_own_keys_list(vm, target);
    }
    if js_is_array(target) {
        return _vm_sort_own_key_ids(js_array_own_key_ids(target));
    }
    if is_string_object(target) {
        return _vm_sort_own_key_ids(js_string_own_key_ids(target));
    }
    if vm._ta_is_instance(target) {
        return vm._ta_own_keys(target, False);
    }
    return _vm_sort_own_key_ids(js_object_all_keys(target));
}

def:pub proxy_trap_get_own_property_descriptor(
    vm: VM, p: JSValue, key: JSValue
) -> JSValue {
    if js_proxy_is_revoked(p) {
        _vm_proxy_throw(
            vm,
            "Cannot perform 'getOwnPropertyDescriptor' on a proxy that has been revoked"
        );
        return js_undefined();
    }
    target: JSValue = js_proxy_target(p);
    handler: JSValue = js_proxy_handler(p);
    kid: int = jsval_to_prop_key(key);
    if _vm_proxy_has_trap(vm, handler, "getOwnPropertyDescriptor") {
        res: JSValue = _vm_proxy_call_trap(
            vm, handler, "getOwnPropertyDescriptor", [target, key]
        );
        if vm_has_native_exc() {
            return js_undefined();
        }
        if not _vm_proxy_validate_gopd(vm, target, kid, res) {
            return js_undefined();
        }
        return res;
    }
    if vm_has_native_exc() {
        return js_undefined();
    }
    if js_is_proxy(target) {
        return proxy_trap_get_own_property_descriptor(vm, target, key);
    }
    if js_is_array(target) {
        return js_Object_getOwnPropertyDescriptor(target, key);
    }
    if is_string_object(target) and js_string_exotic_has_index(target, kid) {
        desc_str_e: JSValue = js_object_new_ordinary();
        js_object_set(
            desc_str_e, str_intern("value"), js_string_exotic_get_index(target, kid)
        );
        js_object_set(desc_str_e, str_intern("writable"), js_false());
        js_object_set(desc_str_e, str_intern("enumerable"), js_true());
        js_object_set(desc_str_e, str_intern("configurable"), js_false());
        return desc_str_e;
    }
    if vm._ta_is_instance(target) {
        return vm._ta_own_descriptor(target, kid);
    }
    if is_fn_val(target) or is_native_val(target) {
        return vm._fn_own_descriptor(target, key);
    }
    return js_Object_getOwnPropertyDescriptor(target, key);
}

def:pub proxy_trap_apply(
    vm: VM, p: JSValue, this_arg: JSValue, args: list[JSValue]
) -> JSValue {
    if js_proxy_is_revoked(p) {
        _vm_proxy_throw(vm, "Cannot perform 'apply' on a proxy that has been revoked");
        return js_undefined();
    }
    target: JSValue = js_proxy_target(p);
    handler: JSValue = js_proxy_handler(p);
    args_arr: JSValue = js_array_create(args);
    if _vm_proxy_has_trap(vm, handler, "apply") {
        res: JSValue = _vm_proxy_call_trap(
            vm, handler, "apply", [target, this_arg, args_arr]
        );
        if vm_has_native_exc() {
            return js_undefined();
        }
        return res;
    }
    if js_is_proxy(target) {
        return proxy_trap_apply(vm, target, this_arg, args);
    }
    if jsv_is_htmldda(target) {
        return js_null();
    }
    # Use bound-unwrapping callable invoke (not bare vm_call_js_fn) so nested
    # Proxy → bound Function targets actually run their bound body.
    if is_fn_val(target) or is_native_val(target) or js_is_proxy(target) {
        res_apply: JSValue = vm._invoke_callable_value(target, this_arg, args);
        if vm.had_exception {
            exc_apply: JSValue = vm.pending_exc;
            vm.had_exception = False;
            vm.pending_exc = js_undefined();
            vm_throw_native(exc_apply);
            return js_undefined();
        }
        if vm_has_native_exc() {
            return js_undefined();
        }
        return res_apply;
    }
    if jsv_is_object_cell(target)
        and jsv_to_table_id(target) > 0
        and js_object_has_own(target, KEY_CTOR_KIND) {
        ck: JSValue = js_object_get(target, KEY_CTOR_KIND);
        if jsv_is_int32(ck) {
            return _vm_call_native_proxy_aware(
                vm, vm.realm, jsv_to_int32(ck), this_arg, args
            );
        }
    }
    _vm_proxy_throw(vm, "Proxy apply: target is not callable");
    return js_undefined();
}

def:pub proxy_trap_construct(
    vm: VM, p: JSValue, args: list[JSValue], new_target: JSValue
) -> JSValue {
    if js_proxy_is_revoked(p) {
        _vm_proxy_throw(
            vm, "Cannot perform 'construct' on a proxy that has been revoked"
        );
        return js_undefined();
    }
    target: JSValue = js_proxy_target(p);
    # ProxyCreate snapshots IsConstructor(target) into proxy_constructible.
    # Revoked proxies still consult the snapshot (do not re-walk the target).
    if not js_proxy_is_constructible(p) {
        _vm_proxy_throw(vm, " is not a constructor");
        return js_undefined();
    }
    handler: JSValue = js_proxy_handler(p);
    args_arr: JSValue = js_array_create(args);
    if _vm_proxy_has_trap(vm, handler, "construct") {
        # Spec: trap(target, argumentsList, newTarget)
        res: JSValue = _vm_proxy_call_trap(
            vm, handler, "construct", [target, args_arr, new_target]
        );
        if vm_has_native_exc() {
            return js_undefined();
        }
        if not jsv_is_object_cell(res) {
            _vm_proxy_throw(vm, "Proxy construct trap returned non-object");
            return js_undefined();
        }
        return res;
    }
    # No trap: Construct(target, argumentsList, newTarget)
    return _vm_construct(vm, target, args, new_target);
}

def _vm_proxy_key_is_enumerable(vm: VM, p: JSValue, kid: int) -> bool {
    key_v: JSValue = _vm_key_id_to_jsvalue(kid);
    gopd: JSValue = proxy_trap_get_own_property_descriptor(vm, p, key_v);
    if vm_has_native_exc() or jsv_is_undefined(gopd) or jsv_is_null(gopd) {
        return False;
    }
    return jsv_coerce_to_bool(js_object_get(gopd, str_intern("enumerable")));
}

def _vm_proxy_enumerable_keys(vm: VM, p: JSValue) -> JSValue {
    key_ids: list[int] = proxy_trap_own_keys_list(vm, p);
    if vm_has_native_exc() {
        return js_array_create([]);
    }
    items: list[JSValue] = [];
    for kid in key_ids {
        if kid >= SYMBOL_KEY_BASE {
            continue;
        }
        if _vm_proxy_key_is_enumerable(vm, p, kid) {
            items.append(jsv_from_string_id(kid));
        }
    }
    return js_array_create(items);
}

"""Drop engine-internal sentinel keys (__jacModule, __notCtor) and any non-string
key ids from a function/native property-store key list, so they never surface via
Object.keys/values/entries/getOwnPropertyNames. Mirrors the filter in
_fn_own_prop_names."""
glob _FPK_STATIC_FIELDS: int = -1;
glob _FPK_BRAND_CUR: int = -1,
     _FPK_BRANDSID_CUR: int = -1;

"""True for engine-internal keys a function/class object carries in fn_props that
must never appear in any own-key listing (keys / getOwnPropertyNames /
Reflect.ownKeys / assign / spread). Mirrors js_object_own_key_ids_ordered's
filter for ordinary objects."""
def _vm_fn_prop_key_hidden(kid: int) -> bool {
    if kid < 0 {
        return True;
    }
    if kid == WK_JAC_MODULE or kid == WK_NOT_CTOR {
        return True;
    }
    # User-class internal marker slots (computed-property-names/class/static/method-*):
    # __CLASS_NAME__, __CTOR__, __IS_CLASS__, __SUPER__.
    if kid == WK_CLASS_NAME
        or kid == WK_CTOR
        or kid == WK_IS_CLASS
        or kid == WK_SUPER {
        return True;
    }
    # Class bookkeeping — the static/instance field lists and the private brand
    # stamps. `class K { static a = 1 }` listed "__STATIC_FIELDS__" in Object.keys(K),
    # getOwnPropertyNames, Reflect.ownKeys and `{ ...K }`.
    if _FPK_STATIC_FIELDS < 0 {
        _FPK_STATIC_FIELDS = str_intern("__STATIC_FIELDS__");
        _FPK_BRAND_CUR = str_intern("__brand@cur");
        _FPK_BRANDSID_CUR = str_intern("__brandsid@cur");
    }
    if kid == _FPK_STATIC_FIELDS or kid == WK_FIELDS {
        return True;
    }
    if kid == _FPK_BRAND_CUR or kid == _FPK_BRANDSID_CUR {
        return True;
    }
    if kid < BUILTIN_BASE {
        # Cheap "__" byte test first: this runs per key of every Object.keys /
        # spread, so an ordinary key must not pay for a substring.
        fpk_s: str = str_from_id(kid);
        if len(fpk_s) >= 8
            and ord(fpk_s[0]) == 95
            and ord(fpk_s[1]) == 95
            and str_substr(fpk_s, 0, 8) == "__brand@" {
            return True;
        }
    }
    return False;
}

"""Drop engine-internal keys (see _vm_fn_prop_key_hidden) from an ordinary
object's raw own-key list. Class objects are ordinary object cells that carry
their field lists as enumerable own properties, so Object.keys(K) / `{ ...K }`
listed "__STATIC_FIELDS__" / "__FIELDS__". Negative marker ids pass through for
the callers that already skip them."""
def _vm_filter_obj_internal_keys(key_ids: list[int]) -> list[int] {
    out: list[int] = [];
    for kid in key_ids {
        if kid > 0 and _vm_fn_prop_key_hidden(kid) {
            continue;
        }
        out.append(kid);
    }
    return out;
}

def _vm_filter_fn_prop_keys(key_ids: list[int]) -> list[int] {
    out: list[int] = [];
    for kid in key_ids {
        if kid <= 0 or _vm_fn_prop_key_hidden(kid) {
            continue;
        }
        out.append(kid);
    }
    return out;
}

"""All own string/symbol key IDs (not pre-filtered by enumerable) in spec order."""
def _vm_all_own_key_ids_ordered(vm: VM, jsobj: JSValue) -> list[int] {
    # [[OwnPropertyKeys]] on a deferred namespace triggers evaluation.
    vm._defer_ns_maybe_eval(jsobj, 0, True);
    if vm.had_exception {
        exc_ok: JSValue = vm.pending_exc;
        vm.had_exception = False;
        vm.pending_exc = js_undefined();
        vm_throw_native(exc_ok);
        return [];
    }
    if js_is_proxy(jsobj) {
        key_ids: list[int] = proxy_trap_own_keys_list(vm, jsobj);
        if vm_has_native_exc() {
            return [];
        }
        out_p: list[int] = [];
        for kid in key_ids {
            if kid < 0 or kid == _KEY_IS_ARRAY {
                continue;
            }
            out_p.append(kid);
        }
        return out_p;
    }
    if vm._ta_is_instance(jsobj) {
        return vm._ta_own_keys(jsobj, False);
    }
    if is_fn_val(jsobj) {
        fidx_e: int = get_fn_idx(jsobj);
        if fidx_e >= 0 and fidx_e < len(vm.realm.closures) {
            return _vm_sort_own_key_ids(
                _vm_filter_fn_prop_keys(
                    js_object_all_keys(vm.realm.closures[fidx_e].fn_props)
                )
            );
        }
        return [];
    }
    if is_native_val(jsobj) {
        nprops_e: JSValue = native_props_get(jsobj);
        if jsv_is_object_cell(nprops_e) {
            return _vm_sort_own_key_ids(
                _vm_filter_fn_prop_keys(js_object_all_keys(nprops_e))
            );
        }
        return [];
    }
    # Module namespaces: string export names are code-point sorted (§10.4.6.10).
    return _vm_sort_own_key_ids(
        _vm_filter_obj_internal_keys(js_object_all_keys(jsobj)),
        js_is_module_namespace(jsobj)
    );
}

"""True if own property kid is currently enumerable (re-check during EnumerableOwnProperties)."""
def _vm_own_key_is_enumerable_now(vm: VM, jsobj: JSValue, kid: int) -> bool {
    if js_is_proxy(jsobj) {
        return _vm_proxy_key_is_enumerable(vm, jsobj, kid);
    }
    if vm._ta_is_instance(jsobj) {
        desc_ta: JSValue = vm._ta_own_descriptor(jsobj, kid);
        if jsv_is_undefined(desc_ta) {
            return False;
        }
        return jsv_coerce_to_bool(js_object_get(desc_ta, str_intern("enumerable")));
    }
    # Function/native values are not object cells: their own keys live in fn_props /
    # the native props store, so js_object_get_own_property_descriptor(fn, kid) would
    # report deleted. Consult _fn_own_descriptor, which knows how to resolve them
    # (intrinsics name/length/prototype are non-enumerable; user fn_props keys carry
    # their real flags). Without this, Object.keys/values/entries on any function
    # dropped every user-assigned enumerable property (e.g. `foo.x = 1`).
    if is_fn_val(jsobj) or is_native_val(jsobj) {
        desc_fn: JSValue = vm._fn_own_descriptor(jsobj, _vm_key_id_to_jsvalue(kid));
        if jsv_is_undefined(desc_fn) {
            return False;
        }
        return jsv_coerce_to_bool(js_object_get(desc_fn, str_intern("enumerable")));
    }
    prop: JSProperty = js_object_get_own_property_descriptor(jsobj, kid);
    if prop.deleted or prop.key == 0 {
        return False;
    }
    return prop.enumerable;
}

"""Object.keys — EnumerableOwnProperties kind=key (§20.1.2.17 / §7.3.23)."""
def _vm_object_keys(vm: VM, jsobj: JSValue) -> JSValue {
    if jsv_is_null(jsobj) or jsv_is_undefined(jsobj) {
        vm_throw_native(make_type_error("Cannot convert undefined or null to object"));
        return js_undefined();
    }
    boxed: JSValue = jsobj;
    if jsv_is_string_cell(jsobj) {
        boxed = js_String_new([jsobj]);
        raw_k: str = str_from_id(jsv_to_table_id(jsobj));
        ki: int = 0;
        while ki < len(raw_k) {
            js_object_set(
                boxed, str_intern_index(ki), js_str(str_substr(raw_k, ki, ki + 1))
            );
            ki = ki + 1;
        }
    } elif not jsv_is_any_object(jsobj) {
        # Other primitives box to objects with no enumerable own keys.
        return js_array_create([]);
    }
    # Snapshot [[OwnPropertyKeys]]; re-check enumerable (Proxy observability).
    key_ids: list[int] = _vm_all_own_key_ids_ordered(vm, boxed);
    if vm_has_native_exc() {
        return js_undefined();
    }
    items: list[JSValue] = [];
    for kid in key_ids {
        if kid >= SYMBOL_KEY_BASE {
            continue;
        }
        # Module namespace: EnumerableOwnProperties must call [[GetOwnProperty]],
        # which throws ReferenceError for uninitialized export bindings.
        if js_is_module_namespace(boxed) {
            desc_k: JSValue = _vm_module_namespace_gopd(
                vm, boxed, jsv_from_string_id(kid)
            );
            if vm_has_native_exc() {
                return js_undefined();
            }
            if jsv_is_undefined(desc_k) {
                continue;
            }
            ev_k: JSValue = js_object_get(desc_k, str_intern("enumerable"));
            if not jsv_coerce_to_bool(ev_k) {
                continue;
            }
            items.append(jsv_from_string_id(kid));
            continue;
        }
        if not _vm_own_key_is_enumerable_now(vm, boxed, kid) {
            continue;
        }
        if vm_has_native_exc() {
            return js_undefined();
        }
        items.append(jsv_from_string_id(kid));
    }
    return js_array_create(items);
}

"""Object.values — EnumerableOwnProperties kind=value (§20.1.2.22 / §7.3.23)."""
def _vm_object_values(vm: VM, jsobj: JSValue) -> JSValue {
    if jsv_is_null(jsobj) or jsv_is_undefined(jsobj) {
        vm_throw_native(make_type_error("Cannot convert undefined or null to object"));
        return js_undefined();
    }
    boxed: JSValue = jsobj;
    if jsv_is_string_cell(jsobj) {
        boxed = js_String_new([jsobj]);
        raw_v: str = str_from_id(jsv_to_table_id(jsobj));
        vi: int = 0;
        while vi < len(raw_v) {
            js_object_set(
                boxed, str_intern_index(vi), js_str(str_substr(raw_v, vi, vi + 1))
            );
            vi = vi + 1;
        }
    } elif not jsv_is_any_object(jsobj) {
        return js_array_create([]);
    }
    # Snapshot [[OwnPropertyKeys]] first; re-check enumerable before each Get.
    key_ids: list[int] = _vm_all_own_key_ids_ordered(vm, boxed);
    if vm_has_native_exc() {
        return js_undefined();
    }
    items: list[JSValue] = [];
    for kid in key_ids {
        if kid >= SYMBOL_KEY_BASE {
            continue;
        }
        if not _vm_own_key_is_enumerable_now(vm, boxed, kid) {
            continue;
        }
        if vm_has_native_exc() {
            return js_undefined();
        }
        val_v: JSValue = _vm_object_get_vop_prop(vm, boxed, kid, boxed);
        if vm_has_native_exc() or vm.had_exception {
            return js_undefined();
        }
        items.append(val_v);
    }
    return js_array_create(items);
}

"""Object.entries — EnumerableOwnProperties kind=key+value (§20.1.2.5 / §7.3.23)."""
def _vm_object_entries(vm: VM, jsobj: JSValue) -> JSValue {
    if jsv_is_null(jsobj) or jsv_is_undefined(jsobj) {
        vm_throw_native(make_type_error("Cannot convert undefined or null to object"));
        return js_undefined();
    }
    boxed: JSValue = jsobj;
    if jsv_is_string_cell(jsobj) {
        boxed = js_String_new([jsobj]);
        raw_e: str = str_from_id(jsv_to_table_id(jsobj));
        ei: int = 0;
        while ei < len(raw_e) {
            js_object_set(
                boxed, str_intern_index(ei), js_str(str_substr(raw_e, ei, ei + 1))
            );
            ei = ei + 1;
        }
    } elif not jsv_is_any_object(jsobj) {
        return js_array_create([]);
    }
    key_ids: list[int] = _vm_all_own_key_ids_ordered(vm, boxed);
    if vm_has_native_exc() {
        return js_undefined();
    }
    pairs: list[JSValue] = [];
    for kid in key_ids {
        if kid >= SYMBOL_KEY_BASE {
            continue;
        }
        if not _vm_own_key_is_enumerable_now(vm, boxed, kid) {
            continue;
        }
        if vm_has_native_exc() {
            return js_undefined();
        }
        val_e: JSValue = _vm_object_get_vop_prop(vm, boxed, kid, boxed);
        if vm_has_native_exc() or vm.had_exception {
            return js_undefined();
        }
        pair: JSValue = js_array_create([jsv_from_string_id(kid), val_e]);
        pairs.append(pair);
    }
    return js_array_create(pairs);
}

"""
Object.getOwnPropertyDescriptors — ES §20.1.2.10 / GetOwnPropertyKeys + GOPD.
Uses Proxy ownKeys order and trap getOwnPropertyDescriptor invariants.
"""
def _vm_get_own_property_descriptors(vm: VM, jsobj: JSValue) -> JSValue {
    boxed: JSValue = _to_object_or_throw(jsobj);
    if vm_has_native_exc() {
        return js_undefined();
    }
    out: JSValue = js_object_create_null();
    if is_string_object(boxed) {
        prim_g: JSValue = string_value_of(boxed);
        s_g: str = str_from_id(jsv_to_table_id(prim_g));
        n_g: int = js_string_utf16_len(s_g);
        gi: int = 0;
        while gi < n_g {
            gkid: int = str_intern_index(gi);
            gdesc: JSValue = js_Object_getOwnPropertyDescriptor(
                boxed, jsv_from_string_id(gkid)
            );
            if not jsv_is_undefined(gdesc) {
                js_object_set(out, gkid, gdesc);
            }
            gi = gi + 1;
        }
    }
    key_ids: list[int] = _vm_all_own_key_ids_ordered(vm, boxed);
    if vm_has_native_exc() {
        return js_undefined();
    }
    for kid in key_ids {
        if kid == _KEY_IS_ARRAY {
            continue;
        }
        if is_string_object(boxed) and js_string_exotic_has_index(boxed, kid) {
            continue;
        }
        key_v: JSValue = _vm_key_id_to_jsvalue(kid);
        desc: JSValue = js_undefined();
        if js_is_proxy(boxed) {
            desc = proxy_trap_get_own_property_descriptor(vm, boxed, key_v);
            if vm_has_native_exc() {
                return js_undefined();
            }
        } elif is_fn_val(boxed) or is_native_val(boxed) {
            desc = vm._fn_own_descriptor(boxed, key_v);
        } else {
            desc = js_Object_getOwnPropertyDescriptor(boxed, key_v);
        }
        if not jsv_is_undefined(desc) {
            js_object_set(out, kid, desc);
        }
    }
    return out;
}

"""Canonical observable [[Get]] — delegates to VM.obs_get (single implementation)."""
def _vm_object_get_vop(
    vm: VM, target_obj: JSValue, key: int, receiver: JSValue
) -> JSValue {
    return vm.obs_get(target_obj, key, receiver);
}

"""Like `_vm_object_get_vop` but a throwing JS getter propagates (sets
had_exception/pending_exc via run_cl) instead of being swallowed and reported.
Used by CopyDataProperties / OBJECT_SPREAD, where a getter's abrupt completion
must abort the copy and unwind (ES §14.3.3.1, §7.3.25)."""
def _vm_object_get_vop_prop(
    vm: VM, target_obj: JSValue, key: int, receiver: JSValue
) -> JSValue {
    if js_is_proxy(target_obj) {
        return proxy_trap_get(vm, target_obj, key, receiver);
    }
    if not is_fn_val(target_obj) and not is_native_val(target_obj) {
        getter_p: JSValue = js_object_lookup_getter(target_obj, key);
        if not jsv_is_undefined(getter_p) and is_fn_val(getter_p) {
            gp_idx: int = get_fn_idx(getter_p);
            if gp_idx < len(vm.realm.closures) {
                return vm.run_cl(vm.realm.closures[gp_idx], getter_p, receiver, []);
            }
        }
    }
    return _vm_object_get_vop(vm, target_obj, key, receiver);
}

"""Canonical observable [[Set]] — delegates to VM.obs_set (single implementation
of OrdinarySet: proxy, fn_val, string-exotic, accessor-without-setter, array
length exotic, inherited non-writable data checks)."""
def _vm_object_set_vop(
    vm: VM, target: JSValue, key: int, val: JSValue, receiver: JSValue
) -> bool {
    return vm.obs_set(target, key, val, receiver);
}

def _vm_enumerable_own_key_ids_ordered(vm: VM, jsobj: JSValue) -> list[int] {
    if js_is_proxy(jsobj) {
        key_ids: list[int] = proxy_trap_own_keys_list(vm, jsobj);
        if vm_has_native_exc() {
            return [];
        }
        # EnumerableOwnPropertyNames (kind=key): string keys only, preserve
        # Proxy ownKeys order, skip non-enumerable / absent descriptors.
        out_p: list[int] = [];
        for kid in key_ids {
            if kid < 0 or kid == _KEY_IS_ARRAY {
                continue;
            }
            if kid >= SYMBOL_KEY_BASE {
                continue;
            }
            if kid >= BUILTIN_BASE and kid < SYMBOL_KEY_BASE {
                continue;
            }
            if not _vm_proxy_key_is_enumerable(vm, jsobj, kid) {
                continue;
            }
            out_p.append(kid);
        }
        return out_p;
    }
    if vm._ta_is_instance(jsobj) {
        return vm._ta_own_keys(jsobj, True);
    }
    if is_fn_val(jsobj) {
        fidx_e: int = get_fn_idx(jsobj);
        if fidx_e >= 0 and fidx_e < len(vm.realm.closures) {
            return _vm_filter_fn_prop_keys(
                object_enumerable_own_key_ids_ordered(
                    vm.realm.closures[fidx_e].fn_props
                )
            );
        }
        return [];
    }
    if is_native_val(jsobj) {
        nprops_e: JSValue = native_props_get(jsobj);
        if jsv_is_object_cell(nprops_e) {
            return object_enumerable_own_key_ids_ordered(nprops_e);
        }
        return [];
    }
    return object_enumerable_own_key_ids_ordered(jsobj);
}

def _vm_copy_data_properties(vm: VM, target: JSValue, source: JSValue) -> None {
    if not jsv_is_any_object(source) {
        return;
    }
    key_ids: list[int] = _vm_all_own_key_ids_ordered(vm, source);
    if vm_has_native_exc() {
        return;
    }
    for kid in key_ids {
        if kid < 0 or kid == _KEY_IS_ARRAY {
            continue;
        }
        if not _vm_own_key_is_enumerable_now(vm, source, kid) {
            continue;
        }
        if vm_has_native_exc() {
            return;
        }
        prop_val: JSValue = _vm_object_get_vop_prop(vm, source, kid, source);
        if vm_has_native_exc() or vm.had_exception {
            return;
        }
        if js_is_array(target) {
            aidx: int = _array_index_key_numeric(kid);
            if aidx >= 0 {
                if not _create_data_property_or_throw(target, aidx, prop_val) {
                    if not vm_has_native_exc() and not vm.had_exception {
                        vm_throw_native(make_type_error("Cannot create property"));
                    }
                    return;
                }
            } else {
                set_ok: bool = _vm_object_set_vop(vm, target, kid, prop_val, target);
                if vm_has_native_exc() or vm.had_exception {
                    return;
                }
                if not set_ok {
                    vm_throw_native(
                        make_type_error("Cannot assign to read only property")
                    );
                    return;
                }
            }
        } else {
            # CreateDataProperty (Throw=true): array indices handled above; ordinary Set for others.
            set_ok: bool = _vm_object_set_vop(vm, target, kid, prop_val, target);
            if vm_has_native_exc() or vm.had_exception {
                return;
            }
            if not set_ok {
                vm_throw_native(make_type_error("Cannot assign to read only property"));
                return;
            }
        }
    }
}

def _vm_integrity_own_keys(vm: VM, target_i: JSValue) -> list[int] {
    if js_is_proxy(target_i) {
        return proxy_trap_own_keys_list(vm, target_i);
    }
    if vm._ta_is_instance(target_i) {
        return vm._ta_own_keys(target_i, False);
    }
    if is_fn_val(target_i) {
        out_f: list[int] = [];
        if vm._fn_has_own_key(target_i, WK_LENGTH) {
            out_f.append(WK_LENGTH);
        }
        if vm._fn_has_own_key(target_i, WK_NAME) {
            out_f.append(WK_NAME);
        }
        if vm._fn_has_own_key(target_i, WK_PROTOTYPE) {
            out_f.append(WK_PROTOTYPE);
        }
        fi_f: int = get_fn_idx(target_i);
        if fi_f >= 0 and fi_f < len(vm.realm.closures) {
            for fk_f in js_object_all_keys(vm.realm.closures[fi_f].fn_props) {
                if fk_f != WK_LENGTH
                    and fk_f != WK_NAME
                    and fk_f != WK_PROTOTYPE
                    and not _vm_fn_prop_key_hidden(fk_f) {
                    out_f.append(fk_f);
                }
            }
        }
        return out_f;
    }
    if is_native_val(target_i) {
        out_n: list[int] = [];
        if not native_key_removed(target_i, WK_LENGTH) {
            out_n.append(WK_LENGTH);
        }
        if not native_key_removed(target_i, WK_NAME) {
            out_n.append(WK_NAME);
        }
        np_n: JSValue = native_props_get(target_i);
        if jsv_is_object_cell(np_n) {
            for nk_n in js_object_all_keys(np_n) {
                if nk_n >= 0 and nk_n != WK_LENGTH and nk_n != WK_NAME {
                    out_n.append(nk_n);
                }
            }
        }
        return out_n;
    }
    return _vm_sort_own_key_ids(js_object_all_keys(target_i));
}

"""SetIntegrityLevel / TestIntegrityLevel (§7.3.15–16), including Proxies."""
def _vm_object_integrity(
    vm: VM, target_i: JSValue, frozen: bool, set_level: bool
) -> bool {
    if not jsv_is_any_object(target_i) {
        return True;
    }
    if set_level {
        # Function intrinsics are synthesized rather than stored in fn_props.
        # Materialize their complete descriptors before making that backing store
        # non-extensible so subsequent DefineProperty steps update existing keys.
        if is_fn_val(target_i) {
            for ik_f in [WK_LENGTH, WK_NAME, WK_PROTOTYPE] {
                if vm._fn_has_own_key(target_i, ik_f) {
                    ikv_f: JSValue = jsv_from_string_id(ik_f);
                    idesc_f: JSValue = vm._fn_own_descriptor(target_i, ikv_f);
                    _ = _vm_function_define_property(
                        vm, target_i, ikv_f, idesc_f, False
                    );
                }
            }
        } elif is_native_val(target_i) {
            for ik_n in [WK_LENGTH, WK_NAME] {
                if not native_key_removed(target_i, ik_n) {
                    ikv_n: JSValue = jsv_from_string_id(ik_n);
                    idesc_n: JSValue = vm._fn_own_descriptor(target_i, ikv_n);
                    _ = _vm_native_define_property(target_i, ikv_n, idesc_n, False);
                }
            }
        }
        prevented: bool = False;
        if js_is_proxy(target_i) {
            prevented = proxy_trap_prevent_extensions(vm, target_i);
        } elif is_fn_val(target_i) {
            fi_p: int = get_fn_idx(target_i);
            prevented = fi_p >= 0
                and fi_p < len(vm.realm.closures)
                and js_object_prevent_extensions(vm.realm.closures[fi_p].fn_props) == 0;
        } elif is_native_val(target_i) {
            prevented = js_object_prevent_extensions(native_props_ensure(target_i))
                == 0;
        } elif vm._ta_is_instance(target_i) {
            prevented = vm._ta_prevent_extensions(target_i);
        } else {
            prevented = js_object_prevent_extensions(target_i) == 0;
        }
        if vm_has_native_exc() or not prevented {
            return False;
        }
    } else {
        extensible_i: bool = False;
        if js_is_proxy(target_i) {
            extensible_i = proxy_trap_is_extensible(vm, target_i);
        } elif is_fn_val(target_i) {
            fi_i: int = get_fn_idx(target_i);
            if fi_i >= 0 and fi_i < len(vm.realm.closures) {
                extensible_i = js_object_is_extensible(
                    vm.realm.closures[fi_i].fn_props
                );
            }
        } elif is_native_val(target_i) {
            np_i: JSValue = native_props_get(target_i);
            extensible_i = not jsv_is_object_cell(np_i)
                or js_object_is_extensible(np_i);
        } else {
            extensible_i = js_object_is_extensible(target_i);
        }
        if vm_has_native_exc() or extensible_i {
            return False;
        }
    }
    keys_i: list[int] = _vm_integrity_own_keys(vm, target_i);
    if vm_has_native_exc() {
        return False;
    }
    for kid_i in keys_i {
        if kid_i < 0 {
            continue;
        }
        key_i: JSValue = _vm_key_id_to_jsvalue(kid_i);
        desc_i: JSValue = js_undefined();
        if js_is_proxy(target_i) {
            desc_i = proxy_trap_get_own_property_descriptor(vm, target_i, key_i);
        } elif vm._ta_is_instance(target_i) {
            desc_i = vm._ta_own_descriptor(target_i, kid_i);
        } elif is_fn_val(target_i) or is_native_val(target_i) {
            desc_i = vm._fn_own_descriptor(target_i, key_i);
        } else {
            desc_i = js_Object_getOwnPropertyDescriptor(target_i, key_i);
        }
        if vm_has_native_exc() {
            return False;
        }
        if jsv_is_undefined(desc_i) {
            continue;
        }
        conf_i: bool = jsv_coerce_to_bool(
            js_object_get(desc_i, str_intern("configurable"))
        );
        has_w_i: bool = js_object_has_own(desc_i, str_intern("writable"));
        write_i: bool = has_w_i
            and jsv_coerce_to_bool(js_object_get(desc_i, str_intern("writable")));
        if not set_level {
            if conf_i or (frozen and write_i) {
                return False;
            }
            continue;
        }
        level_desc_i: JSValue = js_object_new_ordinary();
        js_object_set(level_desc_i, str_intern("configurable"), js_false());
        if frozen and has_w_i {
            js_object_set(level_desc_i, str_intern("writable"), js_false());
        }
        ok_i: bool = False;
        if js_is_proxy(target_i) {
            ok_i = proxy_trap_define_property(vm, target_i, key_i, level_desc_i);
        } elif vm._ta_is_instance(target_i) and vm._ta_key_index(kid_i)[0] {
            # Integer-indexed elements reject SetIntegrityLevel's descriptor
            # tightening, so non-empty TypedArrays cannot be sealed or frozen.
            ok_i = False;
        } elif is_fn_val(target_i) {
            ok_i = jsv_coerce_to_bool(
                _vm_function_define_property(vm, target_i, key_i, level_desc_i, False)
            );
        } elif is_native_val(target_i) {
            ok_i = jsv_coerce_to_bool(
                _vm_native_define_property(target_i, key_i, level_desc_i, False)
            );
        } else {
            # SetIntegrityLevel uses a generic {configurable:false} (and optionally
            # writable:false when freezing data).  That must succeed on accessors —
            # ValidateAndApply preserves [[Get]]/[[Set]]/[[Enumerable]].
            ok_i = js_Reflect_defineProperty(target_i, key_i, level_desc_i);
            if (
                not ok_i
                and not vm_has_native_exc()
                and not has_w_i
                and jsv_is_object_cell(target_i)
            ) {
                kid_sil: int = jsval_to_prop_key(key_i);
                if js_object_has_own_accessor(target_i, kid_sil) {
                    js_object_set_accessor_configurable(target_i, kid_sil, False);
                    ok_i = True;
                }
            }
        }
        if vm_has_native_exc() or not ok_i {
            return False;
        }
    }
    return True;
}

def _vm_is_bound_fn(bound_cl: JSClosure) -> bool {
    return bound_cl.func.is_bound;
}

"""Perform ONE step of ES §14.4.14 `yield *` delegation for a non-generator
(external / internal array) iterator wrapper `in_iter`.

`mode`: 0 = normal (call `next`), 1 = throw (call `throw`), 2 = return (call
`return`).  `send_val` is `received.[[Value]]` — always passed as the single
argument, even on the first normal step (where it is `undefined`).

Returns the inner iterator-result on a normal step.  Signals via VM flags:
  * throw with no `throw` method → IteratorClose + pending TypeError; returns undef.
  * return with no `return` method, or `return` yielding `{done:true}` → sets
    vm.ys_return_out and returns `{value, done:true}` for a ReturnCompletion.
  * a non-done step stashes the RAW inner result in vm.ys_yield_result (its
    `value` is NOT read — GeneratorYield surfaces it verbatim).
Get/call errors and non-object results are left pending in vm.had_exception.

Method-call, target resolution, and result normalization are inlined (rather than
split into separate top-level defs) to limit new function count in vm.na.jac.
`is_async`: when True (async generator yield*), Await the `.next()` result
before IteratorComplete/IteratorValue (ES §15.5.5)."""
def _vm_iter_next_delegate_mode(
    vm: VM, in_iter: JSValue, send_val: JSValue, mode: int, is_async: bool
) -> JSValue {
    vm.ys_return_out = False;
    vm.ys_yield_result = js_undefined();
    in_target: JSValue = in_iter;
    in_custom0: JSValue = js_object_get(in_iter, WK_CUSTOM);
    if jsv_is_object_cell(in_custom0) {
        in_target = in_custom0;
    }

    if mode == 1 {
        in_throw_fn: JSValue = js_undefined();
        if jsv_is_object_cell(in_target) {
            in_throw_fn = vm._get_prop_accessor(in_target, WK_THROW);
            if vm_has_native_exc() {
                vm.had_exception = True;
                vm.pending_exc = vm_take_native_exc();
            }
            if vm.had_exception {
                return js_undefined();
            }
        }
        if is_fn_val(in_throw_fn) or is_native_val(in_throw_fn) {
            in_tr: JSValue = js_undefined();
            if is_fn_val(in_throw_fn) {
                in_tr = vm.run_cl(
                    vm.realm.closures[get_fn_idx(in_throw_fn)],
                    in_throw_fn,
                    in_target,
                    [send_val]
                );
            } else {
                in_tr = _vm_call_native_proxy_aware(
                    vm, vm.realm, get_native_kind(in_throw_fn), in_target, [send_val]
                );
            }
            if vm.had_exception {
                return js_undefined();
            }
            # ES §14.4.14 async yield*: Await(innerResult) before the object check, so a
            # thenable/promise from an async iterator's throw() is assimilated
            # (async-gen-yield-star-async-throw).
            if is_async {
                in_tr = _vm_ys_await_result(vm, in_tr);
                if vm.had_exception {
                    return js_undefined();
                }
            }
            if not jsv_is_object_cell(in_tr) {
                vm.had_exception = True;
                vm.pending_exc = make_type_error(
                    "iterator.throw() returned a non-object value"
                );
                return js_undefined();
            }
            # `{done:true}` from `throw` continues the outer generator normally with
            # the value (not a ReturnCompletion).
            return _vm_ys_normalize(vm, in_tr);
        }
        # No `throw` method: IteratorClose(iterator, normal) then throw TypeError.
        _vm_iterator_close(vm, in_iter);
        vm.had_exception = True;
        vm.pending_exc = make_type_error(
            "The iterator does not provide a 'throw' method"
        );
        return js_undefined();
    }

    if mode == 2 {
        in_ret_fn: JSValue = js_undefined();
        if jsv_is_object_cell(in_target) {
            in_ret_fn = vm._get_prop_accessor(in_target, WK_RETURN);
            if vm_has_native_exc() {
                vm.had_exception = True;
                vm.pending_exc = vm_take_native_exc();
            }
            if vm.had_exception {
                return js_undefined();
            }
        }
        if is_fn_val(in_ret_fn) or is_native_val(in_ret_fn) {
            in_rr: JSValue = js_undefined();
            if is_fn_val(in_ret_fn) {
                in_rr = vm.run_cl(
                    vm.realm.closures[get_fn_idx(in_ret_fn)],
                    in_ret_fn,
                    in_target,
                    [send_val]
                );
            } else {
                in_rr = _vm_call_native_proxy_aware(
                    vm, vm.realm, get_native_kind(in_ret_fn), in_target, [send_val]
                );
            }
            if vm.had_exception {
                return js_undefined();
            }
            # ES §14.4.14 async yield*: Await(innerReturnResult) before the object check,
            # so a thenable/promise from an async iterator's return() is assimilated
            # (async-gen-yield-star-async-return).
            if is_async {
                in_rr = _vm_ys_await_result(vm, in_rr);
                if vm.had_exception {
                    return js_undefined();
                }
            }
            if not jsv_is_object_cell(in_rr) {
                vm.had_exception = True;
                vm.pending_exc = make_type_error(
                    "iterator.return() returned a non-object value"
                );
                return js_undefined();
            }
            in_rr_norm: JSValue = _vm_ys_normalize(vm, in_rr);
            if vm.had_exception {
                return js_undefined();
            }
            if jsv_to_bool(js_object_get(in_rr_norm, WK_DONE)) {
                vm.ys_return_out = True;  # ReturnCompletion(innerResult.[[Value]])
            }
            return in_rr_norm;
        }
        # No `return` method → return Completion(received): outer returns received.
        vm.ys_return_out = True;
        return js_iter_result(send_val, True);
    }

    # mode 0: normal — Call(iteratorRecord.[[NextMethod]], iterator, «received»).
    # [[NextMethod]] was cached at GetIterator time (one observable Get of "next");
    # subsequent steps must NOT Get again (async-gen-yield-star-async-next).
    in_gen0: JSValue = js_object_get(in_iter, WK_GEN);
    if jsv_is_object_cell(in_gen0) and js_is_generator(in_gen0) {
        return vm.run_generator(in_gen0, send_val, False, False);
    }
    in_custom: JSValue = js_object_get(in_iter, WK_CUSTOM);
    if jsv_is_object_cell(in_custom) {
        # Prefer the `.next` method cached on the wrapper at GetIterator time (read
        # once — §7.4.1 step 5). Only re-read via getter if it was not cached (older
        # wrappers), so a `get next` accessor fires exactly once per iteration setup.
        in_next_fn: JSValue = js_object_get(in_iter, WK_NEXT);
        if not is_fn_val(in_next_fn) and not is_native_val(in_next_fn) {
            # Legacy wrappers without a cached nextMethod — fall back to Get.
            in_next_fn = vm._get_prop_accessor(in_custom, WK_NEXT);
            if vm_has_native_exc() {
                vm.had_exception = True;
                vm.pending_exc = vm_take_native_exc();
            }
            if vm.had_exception {
                return js_undefined();
            }
        }
        if is_fn_val(in_next_fn) or is_native_val(in_next_fn) {
            in_result: JSValue = js_undefined();
            if is_fn_val(in_next_fn) {
                in_result = vm.run_cl(
                    vm.realm.closures[get_fn_idx(in_next_fn)],
                    in_next_fn,
                    in_custom,
                    [send_val]
                );
            } else {
                in_result = _vm_call_native_proxy_aware(
                    vm, vm.realm, get_native_kind(in_next_fn), in_custom, [send_val]
                );
            }
            if vm.had_exception {
                return js_undefined();
            }
            if is_async {
                in_result = _vm_ys_await_result(vm, in_result);
                if vm.had_exception {
                    return js_undefined();
                }
            }
            if not jsv_is_object_cell(in_result) {
                vm.had_exception = True;
                vm.pending_exc = make_type_error(
                    "iterator.next() returned a non-object value"
                );
                return js_undefined();
            }
            return _vm_ys_normalize(vm, in_result);
        }
        return js_iter_result(js_undefined(), True);
    }
    in_src0: JSValue = js_object_get(in_iter, WK_I);
    in_idx_v0: JSValue = js_object_get(in_iter, WK_J);
    in_idx0: int = 0;
    if jsv_is_int32(in_idx_v0) {
        in_idx0 = jsv_to_int32(in_idx_v0);
    } elif jsv_is_double(in_idx_v0) {
        in_idx0 = int(jsv_to_double(in_idx_v0));
    }
    in_len0: int = js_array_len(in_src0);
    if in_idx0 < in_len0 {
        in_val0: JSValue = js_array_get(in_src0, in_idx0);
        js_object_set(in_iter, WK_J, js_int(in_idx0 + 1));
        return js_iter_result(in_val0, False);
    }
    return js_iter_result(js_undefined(), True);
}

"""Normalize a `yield *` inner iterator-result per ES §14.4.14 / §7.4.6–7:
IteratorComplete (Get done) then IteratorValue (Get value) — in that order —
then return `{value, done}`.  Non-done results are also stashed in
`vm.ys_yield_result` for the outer generator to surface.  Getter errors
propagate via had_exception."""
def _vm_ys_normalize(vm: VM, res: JSValue) -> JSValue {
    vm.ys_yield_result = js_undefined();
    # _get_prop_accessor routes a throwing done/value getter onto the NATIVE
    # exception channel — fold it back into had_exception so the checks fire.
    ni_done: JSValue = vm._get_prop_accessor(res, WK_DONE);
    if vm_has_native_exc() {
        vm.had_exception = True;
        vm.pending_exc = vm_take_native_exc();
    }
    if vm.had_exception {
        return js_undefined();
    }
    # ES §14.4.14 (yield* delegation): when the inner result is NOT done, the
    # delegating generator yields the *result object itself* WITHOUT reading its
    # `.value` — `.value` is observed only once, on completion (done:true), as the
    # yield* completion value. Reading it eagerly here fires a `value` getter one
    # iteration early (star-rhs-iter-*-res-done-no-value).
    if not jsv_coerce_to_bool(ni_done) {
        vm.ys_yield_result = res;
        return res;
    }
    ni_val: JSValue = vm._get_prop_accessor(res, WK_VALUE);
    if vm_has_native_exc() {
        vm.had_exception = True;
        vm.pending_exc = vm_take_native_exc();
    }
    if vm.had_exception {
        return js_undefined();
    }
    return js_iter_result(ni_val, True);
}

"""Await a `yield*` async-iterator `.next()` result (Promise or thenable).
When `then` calls resolve/reject synchronously (common in test262 fixtures),
returns the fulfilled iterator-result object.  Pending promises are returned
unchanged so the caller can suspend."""
def _vm_ys_await_result(vm: VM, res: JSValue) -> JSValue {
    if js_is_promise(res) {
        ys_pst: int = js_promise_get_state(res);
        if ys_pst == PROMISE_FULFILLED {
            return js_promise_get_value(res);
        }
        if ys_pst == PROMISE_REJECTED {
            vm.had_exception = True;
            vm.pending_exc = js_promise_get_value(res);
            return js_undefined();
        }
        return res;
    }
    if not jsv_is_object_cell(res) or jsv_to_table_id(res) <= 0 {
        return res;
    }
    ys_then: JSValue = vm._get_prop_accessor(res, WK_THEN);
    if vm_has_native_exc() {
        vm.had_exception = True;
        vm.pending_exc = vm_take_native_exc();
    }
    if vm.had_exception {
        return js_undefined();
    }
    if not vm._value_is_callable(ys_then) {
        return res;
    }
    # Call then(resolve, reject) on a fresh capability — sync thenables settle
    # immediately (async-gen-yield-star-async-next).
    ys_p: JSValue = js_promise_create();
    ys_res_fn: JSValue = js_make_resolve_fn(ys_p);
    ys_rej_fn: JSValue = js_make_reject_fn(ys_p);
    vm._invoke_callable_value(ys_then, res, [ys_res_fn, ys_rej_fn]);
    if vm.had_exception {
        return js_undefined();
    }
    ys_pst2: int = js_promise_get_state(ys_p);
    if ys_pst2 == PROMISE_FULFILLED {
        return js_promise_get_value(ys_p);
    }
    if ys_pst2 == PROMISE_REJECTED {
        vm.had_exception = True;
        vm.pending_exc = js_promise_get_value(ys_p);
        return js_undefined();
    }
    return ys_p;
}

def _vm_iter_next_delegate(vm: VM, in_iter: JSValue) -> JSValue {
    in_gen: JSValue = js_object_get(in_iter, WK_GEN);
    if jsv_is_object_cell(in_gen) and js_is_generator(in_gen) {
        return vm.run_generator(in_gen, js_undefined(), False, False);
    }
    in_custom: JSValue = js_object_get(in_iter, WK_CUSTOM);
    if jsv_is_object_cell(in_custom) {
        # Prefer IteratorRecord.[[NextMethod]] cached at GetIterator time.
        in_next_fn: JSValue = js_object_get(in_iter, WK_NEXT);
        if not is_fn_val(in_next_fn) and not is_native_val(in_next_fn) {
            in_next_fn = vm._get_prop_accessor(in_custom, WK_NEXT);
            if vm_has_native_exc() {
                vm.had_exception = True;
                vm.pending_exc = vm_take_native_exc();
            }
            if vm.had_exception {
                return js_undefined();
            }
        }
        in_result: JSValue = js_undefined();
        if is_fn_val(in_next_fn) {
            in_next_cl: JSClosure = vm.realm.closures[get_fn_idx(in_next_fn)];
            in_result = vm.run(
                in_next_cl.func, in_custom, [], in_next_cl.free_vals, in_next_fn
            );
        } elif is_native_val(in_next_fn) {
            in_result = _vm_call_native_proxy_aware(
                vm, vm.realm, get_native_kind(in_next_fn), in_custom, []
            );
        }
        if vm.had_exception {
            return js_undefined();
        }
        if jsv_is_object_cell(in_result) {
            return in_result;
        }
        return js_iter_result(js_undefined(), True);
    }
    in_src: JSValue = js_object_get(in_iter, WK_I);
    in_idx_v: JSValue = js_object_get(in_iter, WK_J);
    in_idx: int = 0;
    if jsv_is_int32(in_idx_v) {
        in_idx = jsv_to_int32(in_idx_v);
    } elif jsv_is_double(in_idx_v) {
        in_idx = int(jsv_to_double(in_idx_v));
    }
    in_len: int = js_array_len(in_src);
    if in_idx < in_len {
        in_val: JSValue = js_array_get(in_src, in_idx);
        js_object_set(in_iter, WK_J, js_int(in_idx + 1));
        return js_iter_result(in_val, False);
    }
    return js_iter_result(js_undefined(), True);
}

def _vm_wrap_custom_iter(vm: VM, user_iter: JSValue) -> JSValue {
    if not jsv_is_object_cell(user_iter) {
        vm.had_exception = True;
        vm.pending_exc = make_type_error("object is not iterable");
        return js_undefined();
    }
    # GetIterator step 5: GetV(iterator, "next") once and cache as
    # IteratorRecord.[[NextMethod]] (WK_NEXT on the wrapper).  Subsequent
    # IteratorNext steps Call the cached method — they must not Get again.
    ui_next: JSValue = vm._get_prop_accessor(user_iter, WK_NEXT);
    if vm_has_native_exc() {
        vm.had_exception = True;
        vm.pending_exc = vm_take_native_exc();
    }
    if vm.had_exception {
        return js_undefined();
    }
    if not is_fn_val(ui_next) and not is_native_val(ui_next) {
        vm.had_exception = True;
        vm.pending_exc = make_type_error("object is not iterable");
        return js_undefined();
    }
    gi_iter_wrap: JSValue = js_object_create_null();
    js_object_set(gi_iter_wrap, WK_I, js_array_create([]));
    js_object_set(gi_iter_wrap, WK_J, js_int(0));
    js_object_set(gi_iter_wrap, WK_CUSTOM, user_iter);
    # Cache the `.next` method read here (GetIterator reads it ONCE — §7.4.1 step 5 /
    # CreateAsyncFromSyncIterator [[NextMethod]]). The delegate driver CALLS this cached
    # method rather than re-reading `.next` each step, so a `get next` accessor fires
    # exactly once (test262 yield-star-sync-next log ordering).
    js_object_set(gi_iter_wrap, WK_NEXT, ui_next);
    return gi_iter_wrap;
}

def _vm_materialize_delegate_iter(vm: VM, src: JSValue, is_async: bool) -> JSValue {
    # ES §14.4.14 (yield* runtime): an ASYNC generator delegates via
    # GetIterator(src, async) — consult @@asyncIterator FIRST. If it is present but
    # not callable, that is a TypeError with NO fallback to @@iterator (the sync
    # getter must not run). Only when @@asyncIterator is *undefined* do we fall back
    # to @@iterator, wrapped as an async-from-sync iterator (handled below by the
    # existing sync path returning a _vm_wrap_custom_iter, which the async resume
    # loop drives). A sync generator's yield* skips all of this.
    if is_async and jsv_is_object_cell(src) and jsv_to_table_id(src) > 0 {
        da_async_key: int = SYMBOL_KEY_BASE + SYMBOL_ASYNC_ITERATOR;
        da_async_fn: JSValue = vm._get_prop_accessor(src, da_async_key);
        if vm_has_native_exc() {
            vm.had_exception = True;
            vm.pending_exc = vm_take_native_exc();
        }
        if vm.had_exception {
            return js_undefined();
        }
        if is_fn_val(da_async_fn) {
            da_cl: JSClosure = vm.realm.closures[get_fn_idx(da_async_fn)];
            da_iter: JSValue = vm.run_cl(da_cl, da_async_fn, src, []);
            if vm.had_exception {
                return js_undefined();
            }
            if js_is_async_generator(da_iter) {
                return da_iter;
            }
            return _vm_wrap_custom_iter(vm, da_iter);
        } elif is_native_val(da_async_fn) {
            da_niter: JSValue = _vm_call_native_proxy_aware(
                vm, vm.realm, get_native_kind(da_async_fn), src, []
            );
            if vm.had_exception {
                return js_undefined();
            }
            return _vm_wrap_custom_iter(vm, da_niter);
        } elif not jsv_is_undefined(da_async_fn)
            and not jsv_is_null(da_async_fn)
            and not js_is_proxy(da_async_fn) {
            # @@asyncIterator present but NOT callable → TypeError, no sync fallback.
            # ES §7.3.10 GetMethod: BOTH undefined and NULL are treated as "no method"
            # (fall through to @@iterator) — only a non-callable non-nullish value throws
            # (test262 yield-star-sync-*: obj's @@asyncIterator getter returns null).
            vm.had_exception = True;
            vm.pending_exc = make_type_error("object is not async iterable");
            return js_undefined();
        } elif js_is_proxy(da_async_fn) {
            da_px_iter: JSValue = _vm_invoke_callback(vm, da_async_fn, src, []);
            if vm.had_exception {
                return js_undefined();
            }
            if js_is_async_generator(da_px_iter) {
                return da_px_iter;
            }
            return _vm_wrap_custom_iter(vm, da_px_iter);
        }
        # @@asyncIterator undefined/null → fall through to the sync @@iterator path below
        # (its result is wrapped as a custom iterator the async loop can drive).
    }
    if js_is_generator(src) {
        return src;
    }
    if jsv_is_null(src) or jsv_is_undefined(src) {
        gi_tn: str = "null";
        if jsv_is_undefined(src) {
            gi_tn = "undefined";
        }
        vm.had_exception = True;
        vm.pending_exc = make_type_error(gi_tn + " is not iterable");
        return js_undefined();
    }
    if jsv_is_object_cell(src)
        and js_object_has_own(src, WK_I)
        and js_object_has_own(src, WK_J) {
        return src;
    }
    if jsv_is_object_cell(src) and js_is_map(src) {
        mi: JSValue = js_object_create_null();
        js_object_set(mi, WK_I, js_map_iter_entries(src));
        js_object_set(mi, WK_J, js_int(0));
        # async `yield*` over a SYNC iterable is an async-from-sync iterator: each yielded
        # value must be Await'ed (ES §27.1.4.4), so a yielded rejected promise rejects the
        # delegating async generator (test262 yield-promise-reject-next-yield-star-sync-*).
        if is_async {
            js_object_set(mi, WK_FROM_SYNC, js_true());
        }
        return mi;
    }
    if jsv_is_object_cell(src) and js_is_set(src) {
        si: JSValue = js_object_create_null();
        js_object_set(si, WK_I, js_set_iter_items(src));
        js_object_set(si, WK_J, js_int(0));
        if is_async {
            js_object_set(si, WK_FROM_SYNC, js_true());
        }
        return si;
    }
    if jsv_is_object_cell(src) and js_is_array(src) {
        ai: JSValue = js_make_iterator(src);
        if is_async and jsv_is_object_cell(ai) {
            js_object_set(ai, WK_FROM_SYNC, js_true());
        }
        return ai;
    }
    if jsv_is_string_cell(src) {
        sti: JSValue = js_make_iterator(src);
        if is_async and jsv_is_object_cell(sti) {
            js_object_set(sti, WK_FROM_SYNC, js_true());
        }
        return sti;
    }
    if jsv_is_object_cell(src) {
        gi_sym_iter_key: int = SYMBOL_KEY_BASE + SYMBOL_ITERATOR;
        # GetMethod(src, @@iterator) — accessor-aware so a poisoned `Symbol.iterator`
        # getter throws and propagates (ES §7.4.1), not swallowed into a generic
        # "not iterable" TypeError.
        gi_sym_fn: JSValue = vm._get_prop_accessor(src, gi_sym_iter_key);
        if vm_has_native_exc() {
            vm.had_exception = True;
            vm.pending_exc = vm_take_native_exc();
        }
        if vm.had_exception {
            return js_undefined();
        }
        if is_fn_val(gi_sym_fn) {
            gi_sym_cl: JSClosure = vm.realm.closures[get_fn_idx(gi_sym_fn)];
            gi_user_iter: JSValue = vm.run_cl(gi_sym_cl, gi_sym_fn, src, []);
            if vm.had_exception {
                return js_undefined();
            }
            gi_wr1: JSValue = _vm_wrap_custom_iter(vm, gi_user_iter);
            if is_async and jsv_is_object_cell(gi_wr1) {
                js_object_set(gi_wr1, WK_FROM_SYNC, js_true());
            }
            return gi_wr1;
        } elif is_native_val(gi_sym_fn) {
            gi_nat_iter: JSValue = _vm_call_native_proxy_aware(
                vm, vm.realm, get_native_kind(gi_sym_fn), src, []
            );
            if vm.had_exception {
                return js_undefined();
            }
            gi_wr2: JSValue = _vm_wrap_custom_iter(vm, gi_nat_iter);
            if is_async and jsv_is_object_cell(gi_wr2) {
                js_object_set(gi_wr2, WK_FROM_SYNC, js_true());
            }
            return gi_wr2;
        }
        gi_next_fn: JSValue = vm._get_prop_accessor(src, WK_NEXT);
        if vm_has_native_exc() {
            vm.had_exception = True;
            vm.pending_exc = vm_take_native_exc();
        }
        if vm.had_exception {
            return js_undefined();
        }
        if is_fn_val(gi_next_fn) or is_native_val(gi_next_fn) {
            return _vm_wrap_custom_iter(vm, src);
        }
        vm.had_exception = True;
        vm.pending_exc = make_type_error("object is not iterable");
        return js_undefined();
    }
    vm.had_exception = True;
    vm.pending_exc = make_type_error("object is not iterable");
    return js_undefined();
}

def _vm_collect_iterable_items(vm: VM, src: JSValue) -> list[JSValue] {
    items: list[JSValue] = [];
    if js_is_generator(src) {
        gen_done: bool = False;
        while not gen_done {
            step_g: JSValue = vm.run_generator(src, js_undefined(), False, False);
            if vm.had_exception {
                break;
            }
            if jsv_to_bool(js_object_get(step_g, WK_DONE)) {
                gen_done = True;
            } else {
                items.append(js_object_get(step_g, WK_VALUE));
            }
        }
        vm.had_exception = False;
        vm.pending_exc = js_undefined();
        return items;
    }
    if js_is_array(src) {
        an: int = js_array_len(src);
        ai: int = 0;
        while ai < an {
            items.append(js_array_get(src, ai));
            ai = ai + 1;
        }
        return items;
    }
    if jsv_is_string_cell(src) {
        ss: str = str_from_id(jsv_to_table_id(src));
        ci: int = 0;
        while ci < len(ss) {
            items.append(jsv_from_string_id(str_intern(str_substr(ss, ci, ci + 1))));
            ci = ci + 1;
        }
        return items;
    }
    if jsv_is_object_cell(src) {
        sym_key: int = SYMBOL_KEY_BASE + SYMBOL_ITERATOR;
        sym_fn: JSValue = js_object_get(src, sym_key);
        if is_fn_val(sym_fn) or is_native_val(sym_fn) {
            it: JSValue = _vm_materialize_delegate_iter(vm, src, False);
            while True {
                step: JSValue = _vm_iter_next_delegate(vm, it);
                if vm.had_exception {
                    break;
                }
                done_v: JSValue = js_object_get(step, WK_DONE);
                if vm.had_exception {
                    break;
                }
                if jsv_to_bool(done_v) {
                    break;
                }
                val: JSValue = js_object_get(step, WK_VALUE);
                if vm.had_exception {
                    break;
                }
                items.append(val);
            }
            return items;
        }
        lv: JSValue = js_object_get(src, KEY_LENGTH);
        ln: int = 0;
        if jsv_is_int32(lv) {
            ln = jsv_to_int32(lv);
        }
        if jsv_is_double(lv) {
            ln = int(jsv_to_double(lv));
        }
        oi: int = 0;
        while oi < ln {
            items.append(js_object_get(src, str_intern_index(oi)));
            oi = oi + 1;
        }
    }
    return items;
}

def _vm_iterator_close(vm: VM, iterator: JSValue) {
    # Preserve any in-flight abrupt completion (IfAbruptCloseIterator): return()'s
    # own throw/TypeError must not replace the original error (ES §7.4.6 / §7.4.11).
    ic_saved_had: bool = vm.had_exception;
    ic_saved_exc: JSValue = vm.pending_exc;
    ic_saved_nat: bool = vm_has_native_exc();
    ic_saved_nat_exc: JSValue = js_undefined();
    if ic_saved_nat {
        ic_saved_nat_exc = vm_take_native_exc();
    }
    vm.had_exception = False;
    vm.pending_exc = js_undefined();

    if jsv_is_object_cell(iterator) {
        in_gen: JSValue = js_object_get(iterator, WK_GEN);
        if jsv_is_object_cell(in_gen) and js_is_generator(in_gen) {
            gst: JSGeneratorState = js_get_generator_state(in_gen);
            if not gst.done and gst.saved_ip > 0 {
                vm.run_generator(in_gen, js_undefined(), False, True);
            } else {
                gst.done = True;
                js_set_generator_state(in_gen, gst);
            }
        } else {
            in_custom: JSValue = js_object_get(iterator, WK_CUSTOM);
            if jsv_is_object_cell(in_custom) {
                _vm_iterator_close(vm, in_custom);
            } else {
                ret_fn: JSValue = js_object_get(iterator, str_intern("return"));
                if jsv_is_undefined(ret_fn) or jsv_is_null(ret_fn) {
                    ret_fn = vm.obs_get(iterator, str_intern("return"), iterator);
                }
                if jsv_is_undefined(ret_fn) or jsv_is_null(ret_fn) {
                    # GetMethod: no return method — nothing to call.
                } elif vm._value_is_callable(ret_fn) {
                    # Use invoke path so return() actually runs (vm_call_js_fn
                    # swallows throws as "callback exceptions").
                    _ = _vm_invoke_callback(vm, ret_fn, iterator, []);
                }
            }
        }
    }
    # Discard any completion produced by return() / generator return.
    vm.had_exception = False;
    vm.pending_exc = js_undefined();
    if vm_has_native_exc() {
        _ = vm_take_native_exc();
    }

    vm.had_exception = ic_saved_had;
    vm.pending_exc = ic_saved_exc;
    if ic_saved_nat {
        vm_throw_native(ic_saved_nat_exc);
    }
}

"""
Spec-complete IteratorClose (ES §7.4.11) for destructuring, done-aware.

`iter_rec` is the iterator-record wrapper as built by GET_ITER (carries
WK_ITERDONE, and WK_GEN / WK_CUSTOM pointing at the real iterator).  `abrupt`
is True when the surrounding destructuring is being unwound because an element
target threw — in that case any error from `return()` (a throw, or a non-object
return value) is swallowed and the *original* completion (already pending) wins.

Returns a JSValue: js_undefined() if the close produced no error to surface,
otherwise a TypeError / the error thrown by `return()` that the caller must
raise (only possible for a normal completion, i.e. abrupt == False).
"""
def _vm_iterator_close_dstr(vm: VM, iter_rec: JSValue, abrupt: bool) -> JSValue {
    if not jsv_is_object_cell(iter_rec) {
        return js_undefined();
    }
    # §7.4.11 is only invoked when iteratorRecord.[[done]] is false.  If the
    # iterator was already exhausted (next() returned done:true, or a rest
    # element consumed it), do nothing.
    id_done: JSValue = js_object_get(iter_rec, WK_ITERDONE);
    if jsv_coerce_to_bool(id_done) {
        return js_undefined();
    }

    # Resolve the object that actually holds the user `return` method.  GET_ITER
    # wraps generator/custom iterators, storing the real iterator under WK_GEN /
    # WK_CUSTOM; a plain array-backed record is its own iterator.
    ic_gen: JSValue = js_object_get(iter_rec, WK_GEN);
    if jsv_is_object_cell(ic_gen) and js_is_generator(ic_gen) {
        # A generator's IteratorClose runs its `return()` internally.  It cannot
        # surface a catchable error here; fall back to the plain closer.
        _vm_iterator_close(vm, iter_rec);
        return js_undefined();
    }
    ic_target: JSValue = iter_rec;
    ic_custom: JSValue = js_object_get(iter_rec, WK_CUSTOM);
    if jsv_is_object_cell(ic_custom) {
        ic_target = ic_custom;
    }
    # for-await-of (§14.7.5.7 AsyncIteratorClose): GET_ASYNC_ITER stores the real async
    # iterator under WK_ASYNC_ITER (not WK_CUSTOM). Reach it so `return` is found there.
    ic_async: JSValue = js_object_get(iter_rec, WK_ASYNC_ITER);
    if jsv_is_object_cell(ic_async) {
        ic_target = ic_async;
    }

    # §7.4.11 step 3 → §7.3.10 GetMethod → §7.3.2 GetV: reading `return` is an
    # OBSERVABLE [[Get]], so a `return` accessor getter must run (and may throw). Use
    # obs_get, not the raw js_object_get, which skipped accessors entirely (test262
    # target-assign-throws-iterator-return-get-throws / default-expr-...).
    ic_ret: JSValue = vm.obs_get(ic_target, str_intern("return"), ic_target);
    if vm_has_native_exc() {
        ic_get_exc: JSValue = vm_take_native_exc();
        # §7.4.11 step 5: on an abrupt (throw) completion, discard the error from
        # GetMethod and keep the original completion; on normal completion, propagate.
        if abrupt {
            return js_undefined();
        }
        return ic_get_exc;
    }
    # GetMethod: undefined/null return → nothing to do (completion unchanged).
    if jsv_is_undefined(ic_ret) or jsv_is_null(ic_ret) {
        return js_undefined();
    }
    # GetMethod step 4: a non-undefined, non-callable `return` is a TypeError. Use the full
    # IsCallable (native / object-backed callable / bound), not just is_fn_val (test262
    # for-await-of/iterator-close-non-throw-get-method-non-callable: `return: Symbol()`).
    if not vm._value_is_callable(ic_ret) {
        if abrupt {
            return js_undefined();
        }
        return make_type_error("iterator return is not a function");
    }
    # A native/object-backed callable `return` is invoked via the general callable path;
    # only a plain JS-closure return uses run_cl directly below.
    if not is_fn_val(ic_ret) {
        ic_nat_res: JSValue = vm._invoke_callable_value(ic_ret, ic_target, []);
        if vm.had_exception or vm_has_native_exc() {
            ic_nat_exc: JSValue = vm.pending_exc;
            if vm_has_native_exc() {
                ic_nat_exc = vm_take_native_exc();
            }
            vm.had_exception = False;
            vm.pending_exc = js_undefined();
            if abrupt {
                return js_undefined();
            }
            return ic_nat_exc;
        }
        # §7.4.11 step 8: non-object return() result → TypeError (normal completion only).
        if not jsv_is_any_object(ic_nat_res) {
            if abrupt {
                return js_undefined();
            }
            return make_type_error("iterator return result is not an object");
        }
        return js_undefined();
    }

    ic_result: JSValue = vm.run_cl(
        vm.realm.closures[get_fn_idx(ic_ret)], ic_ret, ic_target, []
    );
    if vm.had_exception {
        ic_thrown: JSValue = vm.pending_exc;
        vm.had_exception = False;
        vm.pending_exc = js_undefined();
        # §7.4.11 step 6: on abrupt completion, discard return()'s own throw and
        # keep the original exception.  On normal completion, propagate it.
        if abrupt {
            return js_undefined();
        }
        return ic_thrown;
    }
    # §7.4.11 step 8: if return() returned a non-object, throw TypeError — but
    # only on a normal completion (abrupt keeps the original error).
    if not abrupt and not jsv_is_object_cell(ic_result) {
        return make_type_error("iterator return result is not an object");
    }
    return js_undefined();
}

def _vm_object_fromEntries(vm: VM, iterable: JSValue) -> JSValue {
    result: JSValue = js_object_create(js_object_get_ordinary_proto());
    if jsv_is_null(iterable) or jsv_is_undefined(iterable) {
        vm_throw_native(
            make_type_error("Object.fromEntries requires an iterable object")
        );
        return result;
    }
    if not jsv_is_object_cell(iterable) and not jsv_is_any_object(iterable) {
        vm_throw_native(
            make_type_error("Object.fromEntries requires an iterable object")
        );
        return result;
    }
    if js_is_map(iterable) {
        fe_map_arr: JSValue = js_map_iter_entries(iterable);
        fe_map_n: int = js_array_len(fe_map_arr);
        fe_map_i: int = 0;
        while fe_map_i < fe_map_n {
            fe_pair: JSValue = js_array_get(fe_map_arr, fe_map_i);
            if jsv_is_object_cell(fe_pair) and js_array_len(fe_pair) >= 2 {
                fe_mk: JSValue = js_array_get(fe_pair, 0);
                fe_mv: JSValue = js_array_get(fe_pair, 1);
                js_object_set(result, jsval_to_prop_key(fe_mk), fe_mv);
            }
            fe_map_i = fe_map_i + 1;
        }
        return result;
    }
    if js_is_array(iterable) {
        fe_n: int = js_array_len(iterable);
        fe_i: int = 0;
        while fe_i < fe_n {
            pair: JSValue = js_array_get(iterable, fe_i);
            if not jsv_is_object_cell(pair) {
                vm_throw_native(
                    make_type_error("Iterator value is not an entry object")
                );
                return result;
            }
            # Spec: always Get(entry, "0") / Get(entry, "1") — String objects are
            # not arrays; js_array_get would yield undefined keys.
            fk: JSValue = _vm_object_get_vop_prop(vm, pair, str_intern("0"), pair);
            if vm_has_native_exc() or vm.had_exception {
                return result;
            }
            fv: JSValue = _vm_object_get_vop_prop(vm, pair, str_intern("1"), pair);
            if vm_has_native_exc() or vm.had_exception {
                return result;
            }
            set_ok_a: int = js_object_set(result, vm.obs_to_property_key(fk), fv);
            if vm_has_native_exc() {
                return result;
            }
            if set_ok_a != 0 {
                vm_throw_native(make_type_error("Cannot add property"));
                return result;
            }
            fe_i = fe_i + 1;
        }
        return result;
    }
    iter_key: int = SYMBOL_KEY_BASE + SYMBOL_ITERATOR;
    iter_factory: JSValue = js_object_get(iterable, iter_key);
    if jsv_is_undefined(iter_factory) {
        iter_factory = js_object_lookup_getter(iterable, iter_key);
    }
    if jsv_is_undefined(iter_factory)
        or not (is_fn_val(iter_factory) or is_native_val(iter_factory)) {
        vm_throw_native(make_type_error("object is not iterable"));
        return result;
    }
    iterator: JSValue = js_undefined();
    if is_fn_val(iter_factory) {
        fe_ifn: int = get_fn_idx(iter_factory);
        if fe_ifn < len(vm.realm.closures) {
            iterator = vm.run_cl(vm.realm.closures[fe_ifn], iter_factory, iterable, []);
        }
    } else {
        iterator = _vm_call_native_proxy_aware(
            vm, vm.realm, get_native_kind(iter_factory), iterable, []
        );
    }
    if vm_has_native_exc() or vm.had_exception {
        return result;
    }
    if not jsv_is_object_cell(iterator) {
        vm_throw_native(
            make_type_error("Result of the Symbol.iterator method is not an object")
        );
        return result;
    }
    next_fn: JSValue = js_object_get(iterator, str_intern("next"));
    fe_done: bool = False;
    while not fe_done {
        step: JSValue = js_undefined();
        if is_fn_val(next_fn) {
            fe_nfn: int = get_fn_idx(next_fn);
            if fe_nfn < len(vm.realm.closures) {
                step = vm.run_cl(vm.realm.closures[fe_nfn], next_fn, iterator, []);
            }
        } elif is_native_val(next_fn) {
            step = _vm_call_native_proxy_aware(
                vm, vm.realm, get_native_kind(next_fn), iterator, []
            );
        } else {
            # Uncallable next: do NOT IteratorClose (iterator-not-closed-for-uncallable-next).
            vm_throw_native(make_type_error("Iterator result has no next method"));
            return result;
        }
        # Abrupt from next(): do NOT IteratorClose (iterator-not-closed-for-throwing-next).
        if vm_has_native_exc() or vm.had_exception {
            return result;
        }
        if not jsv_is_object_cell(step) {
            # Non-object IteratorResult: do NOT IteratorClose.
            vm_throw_native(make_type_error("Iterator result is not an object"));
            return result;
        }
        done_v: JSValue = _vm_object_get_vop_prop(vm, step, str_intern("done"), step);
        # Abrupt from Get(done): do NOT IteratorClose.
        if vm_has_native_exc() or vm.had_exception {
            return result;
        }
        if jsv_coerce_to_bool(done_v) {
            fe_done = True;
        } else {
            iter_entry: JSValue = _vm_object_get_vop_prop(
                vm, step, str_intern("value"), step
            );
            if vm_has_native_exc() or vm.had_exception {
                _vm_iterator_close(vm, iterator);
                return result;
            }
            if not jsv_is_object_cell(iter_entry) {
                _vm_iterator_close(vm, iterator);
                vm_throw_native(
                    make_type_error("Iterator value is not an entry object")
                );
                return result;
            }
            # Spec order: Get(entry, "0"), Get(entry, "1"), then ToPropertyKey(key).
            ek: JSValue = _vm_object_get_vop_prop(
                vm, iter_entry, str_intern("0"), iter_entry
            );
            if vm_has_native_exc() or vm.had_exception {
                _vm_iterator_close(vm, iterator);
                return result;
            }
            ev: JSValue = _vm_object_get_vop_prop(
                vm, iter_entry, str_intern("1"), iter_entry
            );
            if vm_has_native_exc() or vm.had_exception {
                _vm_iterator_close(vm, iterator);
                return result;
            }
            pk: int = vm.obs_to_property_key(ek);
            if vm_has_native_exc() or vm.had_exception {
                _vm_iterator_close(vm, iterator);
                return result;
            }
            set_ok: int = js_object_set(result, pk, ev);
            if set_ok != 0 {
                _vm_iterator_close(vm, iterator);
                vm_throw_native(make_type_error("Cannot add property"));
                return result;
            }
        }
    }
    return result;
}

def _vm_object_assign(vm: VM, target: JSValue, sources: list[JSValue]) -> JSValue {
    # ToObject(target) — Symbol/BigInt must become proper wrapper objects (§20.1.2.1).
    tgt: JSValue = _to_object_or_throw(target);
    if vm_has_native_exc() {
        return js_undefined();
    }
    for src in sources {
        if jsv_is_null(src) or jsv_is_undefined(src) {
            continue;
        }
        boxed: JSValue = src;
        if not jsv_is_any_object(boxed) {
            if jsv_is_string_cell(boxed) {
                boxed = js_String_new([boxed]);
                raw_as: str = str_from_id(jsv_to_table_id(src));
                idx_as: int = 0;
                while idx_as < len(raw_as) {
                    js_object_set(
                        boxed,
                        str_intern_index(idx_as),
                        js_str(str_substr(raw_as, idx_as, idx_as + 1))
                    );
                    idx_as = idx_as + 1;
                }
            } else {
                boxed = _to_object_or_throw(src);
                if vm_has_native_exc() {
                    return tgt;
                }
            }
        }
        _vm_copy_data_properties(vm, tgt, boxed);
        if vm_has_native_exc() or vm.had_exception {
            return tgt;
        }
    }
    return tgt;
}

"""ToPropertyDescriptor using observable HasProperty/Get operations."""
def _vm_observable_property_descriptor(vm: VM, descriptor: JSValue) -> JSValue {
    if not jsv_is_any_object(descriptor) {
        vm_throw_native(make_type_error("Property description must be an object"));
        return js_undefined();
    }
    normalized: JSValue = js_object_create_null();
    descriptor_keys: list[int] = [
        str_intern("enumerable"),
        str_intern("configurable"),
        WK_VALUE,
        str_intern("writable"),
        WK_GET,
        WK_SET
    ];
    for descriptor_key in descriptor_keys {
        if vm.obs_has(descriptor, descriptor_key) {
            descriptor_value: JSValue = vm.obs_get(
                descriptor, descriptor_key, descriptor
            );
            if vm_has_native_exc() {
                return js_undefined();
            }
            js_object_set(normalized, descriptor_key, descriptor_value);
        }
        if vm_has_native_exc() {
            return js_undefined();
        }
    }
    return normalized;
}

def _vm_reflect_get(vm: VM, args: list[JSValue]) -> JSValue {
    if len(args) < 1 {
        vm_throw_native(make_type_error("Reflect.get called on non-object"));
        return js_undefined();
    }
    target: JSValue = args[0];
    if not jsv_is_any_object(target) {
        vm_throw_native(make_type_error("Reflect.get called on non-object"));
        return js_undefined();
    }
    key: JSValue = js_undefined();
    if len(args) >= 2 {
        key = args[1];
    }
    receiver: JSValue = target;
    if len(args) >= 3 {
        receiver = args[2];
    }
    kid: int = vm.obs_to_property_key(key);
    if vm_has_native_exc() {
        return js_undefined();
    }
    if js_is_proxy(target) {
        return proxy_trap_get(vm, target, kid, receiver);
    }
    if vm._ta_is_instance(target) {
        ta_key_rg: tuple[bool, int] = vm._ta_key_index(kid);
        if ta_key_rg[0] {
            return vm._ta_get_index(target, ta_key_rg[1]);
        }
    }
    # Module namespace / deferred: use the shared OrdinaryGet path (TDZ + live getters).
    if js_is_module_namespace(target) {
        rg_val: JSValue = vm._get_prop_accessor_recv(target, kid, receiver);
        if vm.had_exception {
            rg_exc: JSValue = vm.pending_exc;
            vm.had_exception = False;
            vm.pending_exc = js_undefined();
            vm_throw_native(rg_exc);
            return js_undefined();
        }
        return rg_val;
    }
    # Deferred namespace: [[Get]] triggers evaluation for non-symbol / non-"then".
    vm._defer_ns_maybe_eval(target, kid, False);
    if vm.had_exception or vm_has_native_exc() {
        return js_undefined();
    }
    getter_fn: JSValue = js_object_lookup_getter(target, kid);
    if not jsv_is_undefined(getter_fn) {
        if is_fn_val(getter_fn) {
            return vm_call_js_fn_observable(vm, getter_fn, receiver, []);
        }
        if is_native_val(getter_fn) {
            return _vm_call_native_proxy_aware(
                vm, vm.realm, get_native_kind(getter_fn), receiver, [], getter_fn
            );
        }
    }
    if is_fn_val(target) {
        return _fn_prop(target, kid);
    }
    if is_native_val(target) {
        return _native_prop(target, kid);
    }
    return js_object_get(target, kid);
}

def _vm_reflect_set(vm: VM, args: list[JSValue]) -> JSValue {
    if len(args) < 1 {
        vm_throw_native(make_type_error("Reflect.set called on non-object"));
        return js_false();
    }
    target: JSValue = args[0];
    if not jsv_is_any_object(target) {
        vm_throw_native(make_type_error("Reflect.set called on non-object"));
        return js_false();
    }
    if js_is_module_namespace(target) {
        return js_false();
    }
    key: JSValue = js_undefined();
    if len(args) >= 2 {
        key = args[1];
    }
    val: JSValue = js_undefined();
    if len(args) >= 3 {
        val = args[2];
    }
    receiver: JSValue = target;
    if len(args) >= 4 {
        receiver = args[3];
    }
    kid: int = vm.obs_to_property_key(key);
    if vm_has_native_exc() {
        return js_false();
    }
    # Module Namespace Exotic [[Set]] (ES §10.4.6.9) — always fails.
    if js_is_module_namespace(target) {
        return js_false();
    }
    if js_is_proxy(target) {
        ok_p: bool = proxy_trap_set(vm, target, kid, val, receiver);
        return js_boolean(ok_p);
    }
    if vm._ta_is_instance(target) {
        ta_key_rs: tuple[bool, int] = vm._ta_key_index(kid);
        if ta_key_rs[0] {
            return js_boolean(
                vm._ta_set_with_receiver(target, kid, ta_key_rs[1], val, receiver)
            );
        }
    }
    setter_fn: JSValue = js_object_lookup_setter(target, kid);
    getter_rs: JSValue = js_object_lookup_getter(target, kid);
    if not jsv_is_undefined(setter_fn) {
        if is_fn_val(setter_fn) {
            vm_call_js_fn_observable(vm, setter_fn, receiver, [val]);
            if vm_has_native_exc() {
                return js_true();
            }
            return js_true();
        }
        if is_native_val(setter_fn) {
            _vm_call_native_proxy_aware(
                vm, vm.realm, get_native_kind(setter_fn), receiver, [val]
            );
            return js_true();
        }
    } elif not jsv_is_undefined(getter_rs) {
        # OrdinarySetWithOwnDescriptor: accessor with [[Get]] but no [[Set]] → false.
        return js_false();
    }
    # Array exotic [[Set]] for "length" and array-index keys.
    if js_is_array(target) and kid == WK_LENGTH {
        len_desc_rs: JSProperty = js_object_get_own_property_descriptor(
            target, WK_LENGTH
        );
        if len_desc_rs.key != 0 and not len_desc_rs.writable {
            return js_false();
        }
        _push_native_obs_vm(vm);
        rc_rs: int = js_array_set_length_via_set(target, val);
        _pop_native_obs_vm();
        if vm_has_native_exc() {
            return js_false();
        }
        return js_boolean(rc_rs == 0);
    }
    if js_is_array(target) {
        idx_rs: int = _array_index_key_numeric(kid);
        if idx_rs >= 0 {
            if not _array_index_write_allowed(target, idx_rs) {
                return js_false();
            }
            ok_rs: bool = js_object_set(target, kid, val) == 0;
            if ok_rs {
                _array_grow_length_if_needed(target, idx_rs);
            }
            return js_boolean(ok_rs);
        }
    }
    # OrdinarySetWithOwnDescriptor 5.b: Type(Receiver) is not Object → false
    # (must not mutate Target when Reflect.set is given a primitive receiver).
    if not jsv_is_any_object(receiver) {
        return js_false();
    }
    if jsv_is_object_cell(receiver)
        and not (
            jsv_is_object_cell(target)
            and jsv_to_table_id(receiver) == jsv_to_table_id(target)
        ) {
        ok_dr: bool = _vm_ordinary_set_differing_receiver(
            vm, target, kid, val, receiver
        );
        if vm_has_native_exc() {
            return js_false();
        }
        return js_boolean(ok_dr);
    }
    return js_boolean(js_object_set(target, kid, val) == 0);
}

"""Reflect.deleteProperty(target, key) — §28.1.4 with full ToPropertyKey."""
def _vm_reflect_delete_property(vm: VM, args: list[JSValue]) -> JSValue {
    if len(args) < 1 {
        vm_throw_native(make_type_error("Reflect.deleteProperty called on non-object"));
        return js_false();
    }
    target: JSValue = args[0];
    if not jsv_is_any_object(target) {
        vm_throw_native(make_type_error("Reflect.deleteProperty called on non-object"));
        return js_false();
    }
    key: JSValue = js_undefined();
    if len(args) >= 2 {
        key = args[1];
    }
    kid: int = vm.obs_to_property_key(key);
    if vm_has_native_exc() {
        return js_false();
    }
    if js_is_module_namespace(target) {
        if kid >= SYMBOL_KEY_BASE {
            return js_boolean(js_object_delete(target, kid));
        }
        if js_object_has_own(target, kid) {
            return js_false();
        }
        return js_true();
    }
    if js_is_proxy(target) {
        return js_boolean(proxy_trap_delete(vm, target, kid));
    }
    return js_boolean(js_object_delete_observable(target, kid));
}

"""Get(O, P) for CreateListFromArrayLike — observes accessors and Proxy traps."""
def _vm_get_for_list(vm: VM, o: JSValue, kid: int) -> JSValue {
    if js_is_proxy(o) {
        return proxy_trap_get(vm, o, kid, o);
    }
    # Function values: user-defined accessors live on fn_props (Object.defineProperty).
    if is_fn_val(o) {
        fn_idx_gl: int = get_fn_idx(o);
        if fn_idx_gl >= 0 and fn_idx_gl < len(vm.realm.closures) {
            fp_gl: JSValue = vm.realm.closures[fn_idx_gl].fn_props;
            if jsv_is_object_cell(fp_gl) {
                getter_fp: JSValue = js_object_lookup_getter(fp_gl, kid);
                if not jsv_is_undefined(getter_fp) {
                    if is_fn_val(getter_fp) {
                        return vm_call_js_fn_observable(vm, getter_fp, o, []);
                    }
                    if is_native_val(getter_fp) {
                        return _vm_call_native_proxy_aware(
                            vm, vm.realm, get_native_kind(getter_fp), o, [], getter_fp
                        );
                    }
                }
                # Prefer own data property on fn_props over intrinsic length/name.
                if js_object_has_own(fp_gl, kid) {
                    return js_object_get(fp_gl, kid);
                }
            }
        }
        return _fn_prop(o, kid);
    }
    getter_fn: JSValue = js_object_lookup_getter(o, kid);
    if not jsv_is_undefined(getter_fn) {
        if is_fn_val(getter_fn) {
            return vm_call_js_fn_observable(vm, getter_fn, o, []);
        }
        if is_native_val(getter_fn) {
            return _vm_call_native_proxy_aware(
                vm, vm.realm, get_native_kind(getter_fn), o, [], getter_fn
            );
        }
    }
    return js_object_get(o, kid);
}

"""NATIVE_KIND_* of a builtin constructor value, or -1 if it is not one.

Builtin constructors reach JS in two shapes — an opaque native value, and a
callable JSObject carrying KEY_CTOR_KIND — so both have to be probed."""
def _vm_ctor_kind_of(v: JSValue) -> int {
    if is_native_val(v) {
        return get_native_kind(v);
    }
    if jsv_is_object_cell(v)
        and jsv_to_table_id(v) > 0
        and js_object_has_own(v, KEY_CTOR_KIND) {
        ckv: JSValue = js_object_get(v, KEY_CTOR_KIND);
        if jsv_is_int32(ckv) {
            return jsv_to_int32(ckv);
        }
    }
    return -1;
}

"""
Reflect.construct(target, argumentsList, newTarget?) — §28.1.2.
"""
def _vm_reflect_construct(vm: VM, args: list[JSValue]) -> JSValue {
    target: JSValue = js_undefined();
    if len(args) > 0 {
        target = args[0];
    }
    if not _vm_is_constructor(vm, target) {
        vm_throw_native(make_type_error("Reflect.construct called on non-constructor"));
        return js_undefined();
    }
    # CreateListFromArrayLike(argumentsList)
    arg_list: list[JSValue] = [];
    if len(args) > 1 {
        arr_rc: JSValue = args[1];
        if not jsv_is_any_object(arr_rc) {
            vm_throw_native(
                make_type_error("CreateListFromArrayLike called on non-object")
            );
            return js_undefined();
        }
        len_rc_v: JSValue = _vm_get_for_list(vm, arr_rc, WK_LENGTH);
        if vm_has_native_exc() {
            return js_undefined();
        }
        if vm.had_exception {
            return js_undefined();
        }
        n_rc: int = 0;
        f_rc: float = _to_integer_or_infinity(len_rc_v);
        if vm_has_native_exc() {
            return js_undefined();
        }
        if f_rc > 0.0 {
            max_len_rc: float = 9007199254740991.0;
            if f_rc > max_len_rc {
                f_rc = max_len_rc;
            }
            n_rc = int(f_rc);
        }
        ai_rc: int = 0;
        while ai_rc < n_rc {
            k_rc: int = str_intern_index(ai_rc);
            elem_rc: JSValue = _vm_get_for_list(vm, arr_rc, k_rc);
            if vm_has_native_exc() {
                return js_undefined();
            }
            if vm.had_exception {
                return js_undefined();
            }
            arg_list.append(elem_rc);
            ai_rc = ai_rc + 1;
        }
    } else {
        vm_throw_native(
            make_type_error("CreateListFromArrayLike called on non-object")
        );
        return js_undefined();
    }
    new_target: JSValue = target;
    if len(args) > 2 {
        new_target = args[2];
    }
    if not _vm_is_constructor(vm, new_target) {
        vm_throw_native(
            make_type_error("Reflect.construct: newTarget is not a constructor")
        );
        return js_undefined();
    }
    # Reflect.construct(%Promise%, args, newTarget): _vm_construct routes native
    # kinds through the dispatch table, whose NATIVE_KIND_PROMISE entry is the
    # *no-new* form and throws. `new Promise` and `class X extends Promise` do
    # not come through here — they are handled by the NEW opcode and SUPER_CALL
    # respectively — so this is the only path that needs the explicit
    # construct-with-newTarget behaviour (§27.2.3.1, incl. reading
    # newTarget.prototype so a throwing getter propagates).
    if _vm_ctor_kind_of(target) == NATIVE_KIND_PROMISE {
        return _vm_construct_promise_native(vm, arg_list, new_target);
    }
    return _vm_construct(vm, target, arg_list, new_target);
}

"""
Reflect.apply(target, thisArgument, argumentsList) — §28.1.1.
"""
def _vm_reflect_apply(vm: VM, args: list[JSValue]) -> JSValue {
    target: JSValue = js_undefined();
    if len(args) > 0 {
        target = args[0];
    }
    if not vm._value_is_callable(target) {
        vm_throw_native(make_type_error("Reflect.apply called on non-function"));
        return js_undefined();
    }
    this_arg: JSValue = js_undefined();
    if len(args) > 1 {
        this_arg = args[1];
    }
    # CreateListFromArrayLike(argumentsList) — LengthOfArrayLike via ToLength.
    arg_list: list[JSValue] = [];
    if len(args) > 2 {
        arr_ra: JSValue = args[2];
        if not jsv_is_any_object(arr_ra) {
            vm_throw_native(
                make_type_error("CreateListFromArrayLike called on non-object")
            );
            return js_undefined();
        }
        len_ra_v: JSValue = _vm_get_for_list(vm, arr_ra, WK_LENGTH);
        if vm_has_native_exc() {
            return js_undefined();
        }
        if vm.had_exception {
            return js_undefined();
        }
        n_ra: int = 0;
        f_ra: float = _to_integer_or_infinity(len_ra_v);
        if vm_has_native_exc() {
            return js_undefined();
        }
        if f_ra > 0.0 {
            max_len_ra: float = 9007199254740991.0;
            if f_ra > max_len_ra {
                f_ra = max_len_ra;
            }
            n_ra = int(f_ra);
        }
        ai_ra: int = 0;
        while ai_ra < n_ra {
            k_ra: int = str_intern_index(ai_ra);
            elem_ra: JSValue = _vm_get_for_list(vm, arr_ra, k_ra);
            if vm_has_native_exc() {
                return js_undefined();
            }
            if vm.had_exception {
                return js_undefined();
            }
            arg_list.append(elem_ra);
            ai_ra = ai_ra + 1;
        }
    } else {
        vm_throw_native(
            make_type_error("CreateListFromArrayLike called on non-object")
        );
        return js_undefined();
    }
    return _vm_invoke_callback(vm, target, this_arg, arg_list);
}

def _vm_proxy_get_prototype_of(vm: VM, p: JSValue) -> JSValue {
    if js_proxy_is_revoked(p) {
        vm_throw_native(
            make_type_error(
                "Cannot perform 'getPrototypeOf' on a proxy that has been revoked"
            )
        );
        return js_undefined();
    }
    target: JSValue = js_proxy_target(p);
    handler: JSValue = js_proxy_handler(p);
    result: JSValue = js_undefined();
    if _vm_proxy_has_trap(vm, handler, "getPrototypeOf") {
        result = _vm_proxy_call_trap(vm, handler, "getPrototypeOf", [target]);
        if vm_has_native_exc() {
            return js_undefined();
        }
    } else {
        if js_is_proxy(target) {
            result = _vm_proxy_get_prototype_of(vm, target);
        } else {
            result = js_object_get_prototype(target);
        }
    }
    if not _vm_proxy_validate_proto(result) {
        vm_throw_native(
            make_type_error("'getPrototypeOf' on proxy: trap returned invalid value")
        );
        return js_undefined();
    }
    # IsExtensible(target) — Proxy-aware (nested Proxy targets).
    target_ext: bool = False;
    if js_is_proxy(target) {
        target_ext = proxy_trap_is_extensible(vm, target);
        if vm_has_native_exc() {
            return js_undefined();
        }
    } else {
        target_ext = js_object_is_extensible(target);
    }
    if not target_ext {
        actual: JSValue = js_undefined();
        if js_is_proxy(target) {
            actual = _vm_proxy_get_prototype_of(vm, target);
        } else {
            actual = js_object_get_prototype(target);
        }
        if not _vm_proxy_proto_same(result, actual) {
            vm_throw_native(
                make_type_error("Proxy 'getPrototypeOf' trap violated invariant")
            );
            return js_undefined();
        }
    }
    return result;
}

def _vm_proxy_set_prototype_of(vm: VM, p: JSValue, proto: JSValue) -> bool {
    if js_proxy_is_revoked(p) {
        vm_throw_native(
            make_type_error(
                "Cannot perform 'setPrototypeOf' on a proxy that has been revoked"
            )
        );
        return False;
    }
    target: JSValue = js_proxy_target(p);
    handler: JSValue = js_proxy_handler(p);
    has_trap: bool = _vm_proxy_has_trap(vm, handler, "setPrototypeOf");
    if has_trap {
        tr_v: JSValue = _vm_proxy_call_trap(
            vm, handler, "setPrototypeOf", [target, proto]
        );
        if vm_has_native_exc() {
            return False;
        }
        if not jsv_coerce_to_bool(tr_v) {
            return False;
        }
        # IsExtensible(target) — Proxy-aware (§10.5.2): recurse into a proxy target
        # rather than reading its raw extensible flag.
        extensible_t: bool = False;
        if js_is_proxy(target) {
            extensible_t = proxy_trap_is_extensible(vm, target);
            if vm_has_native_exc() {
                return False;
            }
        } else {
            extensible_t = js_object_is_extensible(target);
        }
        # Trap true + extensible → return true without target.[[SetPrototypeOf]].
        if extensible_t {
            return True;
        }
        current: JSValue = js_undefined();
        if js_is_proxy(target) {
            current = _vm_proxy_get_prototype_of(vm, target);
        } else {
            current = js_object_get_prototype(target);
        }
        if not _vm_proxy_proto_same(proto, current) {
            vm_throw_native(
                make_type_error(
                    "Proxy 'setPrototypeOf' trap returned true for incompatible prototype"
                )
            );
            return False;
        }
        return True;
    }
    # Missing trap → target.[[SetPrototypeOf]] (nested Proxy forward).
    if js_is_proxy(target) {
        return _vm_proxy_set_prototype_of(vm, target, proto);
    }
    return js_object_set_prototype(target, proto) == 0;
}

def:pub js_proxy_get_prototype_of_pub(p: JSValue) -> JSValue {
    return _vm_proxy_get_prototype_of(_PROXY_TRAP_VM, p);
}

def:pub js_proxy_set_prototype_of_pub(p: JSValue, proto: JSValue) -> bool {
    return _vm_proxy_set_prototype_of(_PROXY_TRAP_VM, p, proto);
}

"""True when `v` may be invoked as a JSON hook (reviver / toJSON / replacer)."""
def _vm_json_hook_callable(v: JSValue) -> bool {
    if jsv_is_undefined(v) or jsv_is_null(v) {
        return False;
    }
    if is_fn_val(v) {
        return True;
    }
    if is_native_val(v) {
        return True;
    }
    return _strf_is_function_value(v);
}

def _vm_json_hook_call(
    vm: VM, fn: JSValue, this_val: JSValue, args: list[JSValue]
) -> JSValue {
    if is_native_val(fn) {
        res_n: JSValue = _vm_call_native_proxy_aware(
            vm, vm.realm, get_native_kind(fn), this_val, args
        );
        if vm.had_exception or vm_has_native_exc() {
            return js_undefined();
        }
        return res_n;
    }
    if is_fn_val(fn) {
        fn_idx: int = get_fn_idx(fn);
        if fn_idx >= len(vm.realm.closures) {
            return js_undefined();
        }
        cl: JSClosure = vm.realm.closures[fn_idx];
        res_f: JSValue = vm.run_cl(cl, fn, this_val, args);
        return res_f;
    }
    if jsv_is_object_cell(fn) and _strf_is_function_value(fn) {
        res_o: JSValue = vm_call_js_fn(vm, fn, this_val, args);
        if vm.had_exception {
            return js_undefined();
        }
        return res_o;
    }
    return js_undefined();
}

def _vm_json_reviver_internalize(
    vm: VM, holder: JSValue, name: str, reviver_fn: JSValue, source_holder: JSValue
) -> JSValue {
    name_key: int = str_intern(name);
    value: JSValue = js_object_get(holder, name_key);
    source_node: JSValue = js_undefined();
    if jsv_is_object_cell(source_holder) {
        source_node = js_object_get(source_holder, name_key);
    }

    if jsv_is_object_cell(value) {
        marker_v: JSValue = js_object_get(value, _KEY_IS_ARRAY);
        is_arr: bool = jsv_is_bool(marker_v) and jsv_to_bool(marker_v);
        # Child source nodes live under the container source node (object/array).
        child_src_holder: JSValue = source_node
            if jsv_is_object_cell(source_node)
            else js_undefined();
        if is_arr {
            len_v: JSValue = js_object_get(value, KEY_LENGTH);
            n_el: int = 0;
            if jsv_is_int32(len_v) {
                n_el = jsv_to_int32(len_v);
            } elif jsv_is_double(len_v) {
                n_el = int(jsv_to_double(len_v));
            }
            i_el: int = 0;
            while i_el < n_el {
                idx_s: str = str(i_el);
                child: JSValue = _vm_json_reviver_internalize(
                    vm, value, idx_s, reviver_fn, child_src_holder
                );
                idx_key: int = str_intern(idx_s);
                if jsv_is_undefined(child) {
                    js_object_set(value, idx_key, js_null());
                } else {
                    js_object_set(value, idx_key, child);
                }
                i_el = i_el + 1;
            }
        } else {
            keys: list[int] = js_object_keys(value);
            ki: int = 0;
            while ki < len(keys) {
                prop_key: int = keys[ki];
                ki = ki + 1;
                prop_s: str = str_from_id(prop_key);
                if prop_s == "" {
                    continue;
                }
                child_o: JSValue = _vm_json_reviver_internalize(
                    vm, value, prop_s, reviver_fn, child_src_holder
                );
                if jsv_is_undefined(child_o) {
                    js_object_delete(value, prop_key);
                } else {
                    js_object_set(value, prop_key, child_o);
                }
            }
        }
    }

    # json-parse-with-source: always pass a context object. Primitive literals
    # get an own `source` data property; arrays/objects get an empty context.
    context: JSValue = js_object_new_ordinary();
    if jsv_is_string_cell(source_node) and not jsv_is_object_cell(value) {
        js_object_set(context, str_intern("source"), source_node);
    }

    key_arg: JSValue = jsv_from_string_id(name_key);
    hook_res: JSValue = _vm_json_hook_call(
        vm, reviver_fn, holder, [key_arg, value, context]
    );
    if vm.had_exception or vm_has_native_exc() {
        return js_undefined();
    }
    return hook_res;
}

def _vm_json_apply_reviver(vm: VM, root_val: JSValue, reviver_fn: JSValue) -> JSValue {
    holder: JSValue = js_object_create_null();
    root_key: int = str_intern("");
    js_object_set(holder, root_key, root_val);
    # Parallel source tree from json_parse_core (primitive literal spans).
    src_holder: JSValue = js_object_create_null();
    js_object_set(src_holder, root_key, _JSON_LAST_SOURCE_ROOT);
    # Both holders (and through them the whole parsed tree) live only in jac
    # locals while the reviver re-enters the VM — root them for the walk.
    if len(vm.frames) > 0 {
        vm.frames[len(vm.frames) - 1].native_roots.append(holder);
        vm.frames[len(vm.frames) - 1].rare = True;
        vm.frames[len(vm.frames) - 1].native_roots.append(src_holder);
        vm.frames[len(vm.frames) - 1].rare = True;
    }
    _vm_json_reviver_internalize(vm, holder, "", reviver_fn, src_holder);
    if vm.had_exception {
        vm_throw_native(vm.pending_exc);
        vm.had_exception = False;
        vm.pending_exc = js_undefined();
        return js_undefined();
    }
    if vm_has_native_exc() {
        return js_undefined();
    }
    return js_object_get(holder, root_key);
}

def _vm_json_parse_with_hooks(vm: VM, args: list[JSValue]) -> JSValue {
    result_v: JSValue = json_parse_core(args);
    if vm.had_exception {
        return js_undefined();
    }
    if len(args) > 1 and _vm_json_hook_callable(args[1]) {
        result_v = _vm_json_apply_reviver(vm, result_v, args[1]);
    }
    return result_v;
}

"""Maximum nesting depth for JSON stringify pre-pass (matches json.na.jac JSON_MAX_DEPTH)."""
glob _VM_JSON_MAX_DEPTH: int = 512;

"""True when `holder` is a JS Array object."""
def _vm_json_holder_is_array(holder: JSValue) -> bool {
    if not jsv_is_object_cell(holder) {
        return False;
    }
    marker_v: JSValue = js_object_get(holder, _KEY_IS_ARRAY);
    return jsv_is_bool(marker_v) and jsv_to_bool(marker_v);
}

"""Materialize a Proxy into a plain object/array for JSON.stringify.
Uses [[OwnPropertyKeys]] + enumerable [[GetOwnProperty]] + [[Get]] so exotic
ownKeys/getOwnPropertyDescriptor/get traps are honoured (SerializeJSONObject /
SerializeJSONArray via EnumerableOwnPropertyNames)."""
def _vm_json_materialize_proxy(vm: VM, p: JSValue) -> JSValue {
    if not js_is_proxy(p) {
        return p;
    }
    if js_proxy_is_revoked(p) {
        vm_throw_native(
            make_type_error("Cannot perform 'IsArray' on a proxy that has been revoked")
        );
        return js_undefined();
    }
    is_arr: bool = js_is_array_spec(p);
    if vm_has_native_exc() {
        return js_undefined();
    }
    if is_arr {
        len_v: JSValue = proxy_trap_get(vm, p, KEY_LENGTH, p);
        if vm_has_native_exc() {
            return js_undefined();
        }
        n_el: int = 0;
        if jsv_is_int32(len_v) {
            n_el = jsv_to_int32(len_v);
        } elif jsv_is_double(len_v) {
            n_el = int(jsv_to_double(len_v));
        }
        if n_el < 0 {
            n_el = 0;
        }
        out_a: JSValue = js_array_create([]);
        js_object_set(out_a, KEY_LENGTH, js_int(n_el));
        i_el: int = 0;
        while i_el < n_el {
            kid: int = str_intern_index(i_el);
            elem: JSValue = proxy_trap_get(vm, p, kid, p);
            if vm_has_native_exc() {
                return js_undefined();
            }
            js_object_set(out_a, kid, elem);
            i_el = i_el + 1;
        }
        return out_a;
    }
    out_o: JSValue = js_object_create_null();
    key_ids: list[int] = proxy_trap_own_keys_list(vm, p);
    if vm_has_native_exc() {
        return js_undefined();
    }
    for kid in key_ids {
        if kid < 0 or kid >= SYMBOL_KEY_BASE {
            continue;
        }
        if not _vm_proxy_key_is_enumerable(vm, p, kid) {
            if vm_has_native_exc() {
                return js_undefined();
            }
            continue;
        }
        if vm_has_native_exc() {
            return js_undefined();
        }
        val: JSValue = proxy_trap_get(vm, p, kid, p);
        if vm_has_native_exc() {
            return js_undefined();
        }
        js_object_set(out_o, kid, val);
    }
    return out_o;
}

"""Coerce a replacer-array element to a property-name string, or "" if not String/Number."""
def _vm_json_whitelist_key(elem: JSValue) -> str {
    if jsv_is_string_cell(elem) {
        return str_from_id(jsv_to_table_id(elem));
    }
    if jsv_is_int32(elem) {
        return str(jsv_to_int32(elem));
    }
    if jsv_is_double(elem) {
        d: float = jsv_to_double(elem);
        if d == int(d) and d >= -9007199254740991.0 and d <= 9007199254740991.0 {
            return str(int(d));
        }
        return str(d);
    }
    if jsv_is_object_cell(elem) {
        if is_string_object(elem) {
            return str_from_id(jsv_to_table_id(string_value_of(elem)));
        }
        if is_number_object(elem) {
            prim_n: JSValue = number_value_of(elem);
            if jsv_is_int32(prim_n) {
                return str(jsv_to_int32(prim_n));
            }
            if jsv_is_double(prim_n) {
                dn: float = jsv_to_double(prim_n);
                if dn == int(dn)
                    and dn >= -9007199254740991.0
                    and dn <= 9007199254740991.0 {
                    return str(int(dn));
                }
                return str(dn);
            }
        }
    }
    return "";
}

"""Build an ordered, de-duplicated property whitelist from a replacer array."""
def _vm_json_build_whitelist(replacer_arr: JSValue) -> list[str] {
    out: list[str] = [];
    len_v: JSValue = js_object_get(replacer_arr, KEY_LENGTH);
    n_el: int = 0;
    if jsv_is_int32(len_v) {
        n_el = jsv_to_int32(len_v);
    } elif jsv_is_double(len_v) {
        n_el = int(jsv_to_double(len_v));
    }
    i_el: int = 0;
    while i_el < n_el {
        elem: JSValue = js_object_get(replacer_arr, str_intern_index(i_el));
        key_s: str = _vm_json_whitelist_key(elem);
        if key_s != "" {
            seen: bool = False;
            si: int = 0;
            while si < len(out) {
                if out[si] == key_s {
                    seen = True;
                    break;
                }
                si = si + 1;
            }
            if not seen {
                out.append(key_s);
            }
        }
        i_el = i_el + 1;
    }
    return out;
}

# Set by _vm_json_prep right before it returns: whether the value it returns
# differs from what holder[key] holds (the caller then builds a shadow).
glob _JSON_PREP_CHANGED: bool = False;

"""JSON.stringify's observable pass (V4.19): SerializeJSONProperty's Get,
toJSON, replacer and Proxy steps (§25.5.2.2) for holder[key] and, through
SerializeJSONObject / SerializeJSONArray, everything below it — without
writing into the caller's objects. Returns the value the native serializer
must see at holder[key]: the value itself when nothing below it changed,
else a fresh copy (array, or null-prototype object with the same keys in the
same order) holding the transformed values. Values produced here (hook
results, getter results, copies) are appended to `roots` (the calling
frame's native_roots) so a collection during a later hook keeps them.
Leaves _JSON_PREP_CHANGED = (result is not holder[key]'s stored value)."""
def _vm_json_prep(
    vm: VM,
    holder: JSValue,
    name_key: int,
    replacer_fn: JSValue,
    whitelist: list[str],
    has_whitelist: bool,
    visited: set[int],
    depth: int,
    roots: list[JSValue]
) -> JSValue {
    jp_raw: JSValue = js_object_get(holder, name_key);
    v: JSValue = jp_raw;
    # An own data property of an ordinary shape-mode holder: its stored value
    # is [[Get]]'s result. Accessors, undefined (a hole or a missing key: the
    # prototype chain decides), exotic / dict-mode holders and a broken
    # array-index protector take the full accessor-aware [[Get]].
    if js_object_ic_shape(holder) < 0
        or jsv_is_undefined(jp_raw)
        or not idx_protector_ok()
        or js_object_has_own_accessor(holder, name_key) {
        v = vm._get_prop_accessor(holder, name_key);
        if vm.had_exception or vm_has_native_exc() {
            _JSON_PREP_CHANGED = False;
            return js_undefined();
        }
    }
    jp_hooked: bool = not (v == jp_raw);
    if jsv_is_object_cell(v) {
        tojson_fn: JSValue = js_object_get(v, WK_TOJSON);
        if jsv_is_undefined(tojson_fn) and js_is_date(v) {
            v = js_Date_toJSON(v);
            jp_hooked = True;
        } elif _vm_json_hook_callable(tojson_fn) {
            v = _vm_json_hook_call(vm, tojson_fn, v, [jsv_from_string_id(name_key)]);
            if vm.had_exception or vm_has_native_exc() {
                _JSON_PREP_CHANGED = False;
                return js_undefined();
            }
            jp_hooked = True;
        }
    }
    if _vm_json_hook_callable(replacer_fn) {
        v = _vm_json_hook_call(
            vm, replacer_fn, holder, [jsv_from_string_id(name_key), v]
        );
        if vm.had_exception or vm_has_native_exc() {
            _JSON_PREP_CHANGED = False;
            return js_undefined();
        }
        jp_hooked = True;
    }
    if jp_hooked and (jsv_is_object_cell(v) or jsv_is_string_cell(v)) {
        roots.append(v);
    }
    if not jsv_is_object_cell(v) {
        _JSON_PREP_CHANGED = not (v == jp_raw);
        return v;
    }
    # Proxies: expand via OwnKeys/Get into a fresh plain object/array.
    if js_is_proxy(v) {
        v = _vm_json_materialize_proxy(vm, v);
        if vm.had_exception or vm_has_native_exc() {
            _JSON_PREP_CHANGED = False;
            return js_undefined();
        }
        if jsv_is_object_cell(v) {
            roots.append(v);
        }
        if not jsv_is_object_cell(v) {
            _JSON_PREP_CHANGED = True;
            return v;
        }
    }
    # Values the serializer does not descend into: functions and classes
    # (omitted), boxed primitives (unboxed), typed arrays (their elements).
    if not js_is_array(v)
        and (
            _strf_is_function_value(v)
            or is_string_object(v)
            or is_number_object(v)
            or is_boolean_object(v)
            or binary_is_typed_array(v)
        ) {
        _JSON_PREP_CHANGED = not (v == jp_raw);
        return v;
    }
    ptr: int = jsv_to_table_id(v);
    if ptr in visited {
        vm_throw_native(make_type_error("Converting circular structure to JSON"));
        _JSON_PREP_CHANGED = False;
        return js_undefined();
    }
    if depth > _VM_JSON_MAX_DEPTH {
        _JSON_PREP_CHANGED = not (v == jp_raw);
        return v;
    }
    visited.add(ptr);
    is_arr: bool = js_is_array_spec(v);
    if vm_has_native_exc() {
        visited.discard(ptr);
        _JSON_PREP_CHANGED = False;
        return js_undefined();
    }
    if is_arr {
        len_v: JSValue = js_object_get(v, KEY_LENGTH);
        n_el: int = 0;
        if jsv_is_int32(len_v) {
            n_el = jsv_to_int32(len_v);
        } elif jsv_is_double(len_v) {
            n_el = int(jsv_to_double(len_v));
        }
        ja_kids: list[JSValue] = [];
        ja_ch: bool = False;
        i_el: int = 0;
        while i_el < n_el {
            ja_c: JSValue = _vm_json_prep(
                vm,
                v,
                str_intern_index(i_el),
                replacer_fn,
                whitelist,
                has_whitelist,
                visited,
                depth + 1,
                roots
            );
            if vm.had_exception or vm_has_native_exc() {
                visited.discard(ptr);
                _JSON_PREP_CHANGED = False;
                return js_undefined();
            }
            if _JSON_PREP_CHANGED and not ja_ch {
                # first change: the copy takes the earlier (unchanged) elements
                ja_ch = True;
                ja_j: int = 0;
                while ja_j < i_el {
                    ja_kids.append(js_object_get(v, str_intern_index(ja_j)));
                    ja_j = ja_j + 1;
                }
            }
            if ja_ch {
                ja_kids.append(ja_c);
            }
            i_el = i_el + 1;
        }
        if ja_ch {
            v = js_array_create(ja_kids);
            roots.append(v);
        }
    } elif has_whitelist {
        jw_sh: JSValue = js_object_create_null();
        roots.append(jw_sh);
        wi: int = 0;
        while wi < len(whitelist) {
            prop_key: int = str_intern(whitelist[wi]);
            wi = wi + 1;
            if js_object_has_own(v, prop_key) {
                # the getter runs once: its value is what the copy holds
                child_o: JSValue = vm._get_prop_accessor(v, prop_key);
                if vm.had_exception or vm_has_native_exc() {
                    visited.discard(ptr);
                    _JSON_PREP_CHANGED = False;
                    return js_undefined();
                }
                js_object_set(jw_sh, prop_key, child_o);
                jw_c: JSValue = _vm_json_prep(
                    vm,
                    jw_sh,
                    prop_key,
                    replacer_fn,
                    whitelist,
                    has_whitelist,
                    visited,
                    depth + 1,
                    roots
                );
                if vm.had_exception or vm_has_native_exc() {
                    visited.discard(ptr);
                    _JSON_PREP_CHANGED = False;
                    return js_undefined();
                }
                js_object_set(jw_sh, prop_key, jw_c);
            }
        }
        v = jw_sh;
    } else {
        keys: list[int] = js_object_keys(v);
        jo_keys: list[int] = [];
        jo_vals: list[JSValue] = [];
        jo_ch: bool = False;
        ki: int = 0;
        while ki < len(keys) {
            prop_key2: int = keys[ki];
            ki = ki + 1;
            if str_from_id(prop_key2) == "" {
                continue;
            }
            jo_c: JSValue = _vm_json_prep(
                vm,
                v,
                prop_key2,
                replacer_fn,
                whitelist,
                has_whitelist,
                visited,
                depth + 1,
                roots
            );
            if vm.had_exception or vm_has_native_exc() {
                visited.discard(ptr);
                _JSON_PREP_CHANGED = False;
                return js_undefined();
            }
            if _JSON_PREP_CHANGED and not jo_ch {
                jo_ch = True;
                jo_j: int = 0;
                while jo_j < ki - 1 {
                    if str_from_id(keys[jo_j]) != "" {
                        jo_keys.append(keys[jo_j]);
                        jo_vals.append(js_object_get(v, keys[jo_j]));
                    }
                    jo_j = jo_j + 1;
                }
            }
            if jo_ch {
                jo_keys.append(prop_key2);
                jo_vals.append(jo_c);
            }
        }
        if jo_ch {
            jo_sh: JSValue = js_object_create_null();
            roots.append(jo_sh);
            jo_k: int = 0;
            while jo_k < len(jo_keys) {
                js_object_set(jo_sh, jo_keys[jo_k], jo_vals[jo_k]);
                jo_k = jo_k + 1;
            }
            v = jo_sh;
        }
    }
    visited.discard(ptr);
    _JSON_PREP_CHANGED = not (v == jp_raw);
    return v;
}

def _vm_json_stringify_with_hooks(vm: VM, args: list[JSValue]) -> JSValue {
    if len(args) == 0 {
        return json_stringify_core(args);
    }
    val_v: JSValue = args[0];

    replacer_fn: JSValue = js_undefined();
    whitelist: list[str] = [];
    has_whitelist: bool = False;
    if len(args) > 1 {
        rep_v: JSValue = args[1];
        if _vm_json_hook_callable(rep_v) {
            replacer_fn = rep_v;
        } elif jsv_is_object_cell(rep_v) {
            # IsArray(replacer) follows a Proxy chain — a Proxy whose target is an Array is
            # a valid replacer array (replacer-array-proxy), not just an object carrying the
            # _KEY_IS_ARRAY marker. Materialize a proxy so its length/elements read cleanly.
            rep_is_arr: bool = js_is_array_spec(rep_v);
            if vm_has_native_exc() {
                return js_undefined();
            }
            if rep_is_arr {
                wl_src: JSValue = rep_v;
                if js_is_proxy(rep_v) {
                    wl_src = _vm_json_materialize_proxy(vm, rep_v);
                    if vm.had_exception or vm_has_native_exc() {
                        return js_undefined();
                    }
                }
                whitelist = _vm_json_build_whitelist(wl_src);
                has_whitelist = True;
            }
        }
    }

    # ES §25.5.2 steps 5–7: unbox Number/String exotic `space` via observable
    # ToNumber / ToString so poisoned valueOf/toString throw.
    space_arg: JSValue = args[2] if len(args) > 2 else js_undefined();
    if jsv_is_object_cell(space_arg) {
        if is_number_object(space_arg) {
            space_num: float = vm.obs_to_number(space_arg);
            if vm_has_native_exc() {
                return js_undefined();
            }
            space_arg = js_number(space_num);
        } elif is_string_object(space_arg) {
            space_prim: JSValue = vm.obs_to_primitive(space_arg, 1);
            if vm_has_native_exc() {
                return js_undefined();
            }
            if jsv_is_string_cell(space_prim) {
                space_arg = space_prim;
            } else {
                # ToString of the primitive result
                space_arg = jsv_from_string_id(
                    str_intern(js_coerce_to_string(space_prim))
                );
            }
        }
    }

    root_holder: JSValue = js_object_create_null();
    # The holder and every value _vm_json_prep produces exist only in jac
    # locals while toJSON / the replacer / getters re-enter the VM: they are
    # rooted in the calling frame's native_roots for the call (trimmed back
    # at the end).
    if len(vm.frames) == 0 {
        return json_stringify_core(args);
    }
    js_roots: list[JSValue] = vm.frames[len(vm.frames) - 1].native_roots;
    vm.frames[len(vm.frames) - 1].rare = True;
    js_roots_n: int = len(js_roots);
    js_roots.append(root_holder);
    root_key: int = str_intern("");
    js_object_set(root_holder, root_key, val_v);
    visited_sv: set[int] = set();
    transformed: JSValue = _vm_json_prep(
        vm,
        root_holder,
        root_key,
        replacer_fn,
        whitelist,
        has_whitelist,
        visited_sv,
        0,
        js_roots
    );
    if vm.had_exception {
        while len(js_roots) > js_roots_n {
            js_roots.pop();
        }
        vm_throw_native(vm.pending_exc);
        vm.had_exception = False;
        vm.pending_exc = js_undefined();
        return js_undefined();
    }
    if vm_has_native_exc() {
        while len(js_roots) > js_roots_n {
            js_roots.pop();
        }
        return js_undefined();
    }
    new_args: list[JSValue] = [transformed];
    if len(args) > 1 {
        new_args.append(args[1]);
    } else {
        new_args.append(js_undefined());
    }
    new_args.append(space_arg);
    js_res: JSValue = json_stringify_core(new_args);
    while len(js_roots) > js_roots_n {
        js_roots.pop();
    }
    return js_res;
}

"""ToObject boxing for array methods (primitives → Boolean/Number/String objects)."""
def _vm_array_to_object(this_val: JSValue) -> JSValue {
    if jsv_is_null(this_val) or jsv_is_undefined(this_val) {
        vm_throw_native(make_type_error("Array method called on null or undefined"));
        return js_undefined();
    }
    if jsv_is_any_object(this_val) {
        return this_val;
    }
    if jsv_is_bool(this_val) {
        return js_Boolean_new([this_val]);
    }
    if jsv_is_int32(this_val) or jsv_is_double(this_val) {
        return js_Number_new([this_val]);
    }
    if jsv_is_string_cell(this_val) {
        return js_String_new([this_val]);
    }
    return this_val;
}

"""
Invoke any callable as a callback for Array methods.
Normalizes all abrupt completions onto vm.had_exception / vm.pending_exc.
Uses `_invoke_callable_value` so generator / async-generator GetMethod results
become iterator objects (not a run_cl of the generator body).
"""
def _vm_invoke_callback(
    vm: VM, fn: JSValue, this_arg: JSValue, args: list[JSValue]
) -> JSValue {
    if is_fn_val(fn) {
        return vm._invoke_callable_value(fn, this_arg, args);
    }
    if js_is_proxy(fn) {
        res_p: JSValue = proxy_trap_apply(vm, fn, this_arg, args);
        if vm_has_native_exc() {
            exc_p: JSValue = vm_take_native_exc();
            vm.had_exception = True;
            vm.pending_exc = exc_p;
            return js_undefined();
        }
        if vm.had_exception {
            return js_undefined();
        }
        return res_p;
    }
    if is_native_val(fn) {
        res_n: JSValue = _vm_call_native_proxy_aware(
            vm, vm.realm, get_native_kind(fn), this_arg, args
        );
        if vm_has_native_exc() {
            exc_n: JSValue = vm_take_native_exc();
            vm.had_exception = True;
            vm.pending_exc = exc_n;
            return js_undefined();
        }
        return res_n;
    }
    if jsv_is_object_cell(fn)
        and jsv_to_table_id(fn) > 0
        and js_object_has_own(fn, KEY_CTOR_KIND) {
        ck: JSValue = js_object_get(fn, KEY_CTOR_KIND);
        if jsv_is_int32(ck) {
            res_c: JSValue = _vm_call_native_proxy_aware(
                vm, vm.realm, jsv_to_int32(ck), this_arg, args
            );
            if vm_has_native_exc() {
                exc_c: JSValue = vm_take_native_exc();
                vm.had_exception = True;
                vm.pending_exc = exc_c;
                return js_undefined();
            }
            return res_c;
        }
    }
    if jsv_is_object_cell(fn)
        and jsv_to_table_id(fn) > 0
        and js_object_has_own(fn, WK_IS_CLASS) {
        vm.had_exception = True;
        vm.pending_exc = make_type_error(
            "Class constructor cannot be invoked without 'new'"
        );
        return js_undefined();
    }
    vm.had_exception = True;
    vm.pending_exc = make_type_error("is not a function");
    return js_undefined();
}

"""
IsArray(argument) — §7.2.2, abrupt-aware for revoked Proxies.
Delegates to the shared js_is_array_spec (R14).
"""
def _vm_is_array(v: JSValue) -> bool {
    return js_is_array_spec(v);
}

"""
Object.defineProperty / Reflect.defineProperty on a native builtin (R3).

Redirects onto the lazy props store and clears name/length tombstones so a
subsequent defineProperty can restore a deleted configurable intrinsic.
`as_object` True → Object.defineProperty (returns the native); False → Reflect
(returns boolean).
"""
def _vm_native_define_property(
    nat_v: JSValue, key_v: JSValue, desc: JSValue, as_object: bool
) -> JSValue {
    props: JSValue = native_props_ensure(nat_v);
    if not jsv_is_object_cell(props) {
        if as_object {
            return nat_v;
        }
        return js_boolean(False);
    }
    kid: int = jsval_to_prop_key(key_v);
    if kid == WK_NAME or kid == WK_LENGTH {
        native_clear_key_removed(nat_v, kid);
    }
    if as_object {
        js_Object_defineProperty(props, key_v, desc);
        if vm_has_native_exc() {
            return nat_v;
        }
        return nat_v;
    }
    ok: bool = js_Reflect_defineProperty(props, key_v, desc);
    return js_boolean(ok);
}

"""Object.defineProperty / Reflect.defineProperty on a JS closure."""
def _vm_function_define_property(
    vm: VM, fn_v: JSValue, key_v: JSValue, desc: JSValue, as_object: bool
) -> JSValue {
    fn_idx: int = get_fn_idx(fn_v);
    if fn_idx < 0 or fn_idx >= len(vm.realm.closures) {
        if as_object {
            return fn_v;
        }
        return js_boolean(False);
    }
    fn_cl: JSClosure = vm.realm.closures[fn_idx];
    kid: int = jsval_to_prop_key(key_v);
    if kid == WK_PROTOTYPE {
        if not jsv_is_object_cell(desc) {
            if as_object {
                return fn_v;
            }
            return js_boolean(False);
        }
        rec: PropertyDescriptorRecord = spec_to_property_descriptor(desc);
        if vm_has_native_exc() or rec.is_invalid {
            if as_object {
                return fn_v;
            }
            return js_boolean(False);
        }
        cur_proto: JSValue = _fn_prop(fn_v, WK_PROTOTYPE);
        current_exists: bool = not jsv_is_undefined(cur_proto);
        # `prototype` is { writable:<prototype_writable>, enumerable:false,
        # configurable:false }; ValidateAndApply enforces the non-configurable data
        # rules (writable may only downgrade true→false, value fixed once non-writable).
        current: PropertyDescriptorRecord = PropertyDescriptorRecord(
            has_value=True,
            has_writable=True,
            has_enumerable=True,
            has_configurable=True,
            value=cur_proto,
            writable=fn_cl.prototype_writable,
            enumerable=False,
            configurable=False,
            is_accessor=False
        );
        applied_pair: tuple[bool, PropertyDescriptorRecord] = spec_validate_and_apply_descriptor(
            True, rec, current, current_exists
        );
        if not applied_pair[0] {
            if as_object {
                return fn_v;
            }
            return js_boolean(False);
        }
        applied: PropertyDescriptorRecord = applied_pair[1];
        if applied.is_accessor {
            if as_object {
                return fn_v;
            }
            return js_boolean(False);
        }
        if applied.has_value {
            fn_cl.prototype_obj = applied.value;
        }
        if applied.has_writable {
            fn_cl.prototype_writable = applied.writable;
        }
        if as_object {
            return fn_v;
        }
        return js_boolean(True);
    }
    # name/length are synthesized {w:F,e:F,c:T} until materialised on fn_props.
    # Seed that intrinsic first so OrdinaryDefineOwnProperty sees current
    # configurable:true and omitted descriptor fields preserve it (ES §10.1.6.3).
    if (kid == WK_NAME or kid == WK_LENGTH) and jsv_is_object_cell(fn_cl.fn_props) {
        fn_removed: bool = False;
        if kid == WK_NAME and fn_cl.name_removed {
            fn_removed = True;
        }
        if kid == WK_LENGTH and fn_cl.length_removed {
            fn_removed = True;
        }
        if not fn_removed
            and not js_object_has_own(fn_cl.fn_props, kid)
            and not js_object_has_own_accessor(fn_cl.fn_props, kid) {
            js_object_define_property(
                fn_cl.fn_props,
                kid,
                JSProperty(
                    key=kid,
                    value=_fn_prop(fn_v, kid),
                    writable=False,
                    enumerable=False,
                    configurable=True,
                    deleted=False
                )
            );
        }
        if kid == WK_NAME {
            fn_cl.name_removed = False;
        }
        if kid == WK_LENGTH {
            fn_cl.length_removed = False;
        }
    }
    if as_object {
        js_Object_defineProperty(fn_cl.fn_props, key_v, desc);
        return fn_v;
    }
    return js_boolean(js_Reflect_defineProperty(fn_cl.fn_props, key_v, desc));
}

"""
IsConstructor(argument) — §7.2.4.
True for non-arrow JS functions, classes, and constructable natives (Array, etc.).
"""
def _vm_is_constructor(vm: VM, v: JSValue) -> bool {
    if is_fn_val(v) {
        fn_idx: int = get_fn_idx(v);
        if fn_idx < 0 or fn_idx >= len(vm.realm.closures) {
            return False;
        }
        cl: JSClosure = vm.realm.closures[fn_idx];
        if cl.is_arrow {
            return False;
        }
        # A JS-implemented builtin that must not be constructable (§20.1.3:
        # built-in functions that are not identified as constructors have no
        # [[Construct]]). Ordinary function syntax makes these constructors by
        # default, so builtins_stubs.js opts out explicitly via this marker —
        # e.g. the Promise combinators, which Reflect.construct must reject.
        if js_object_has_own(cl.fn_props, WK_NOT_CTOR) {
            return False;
        }
        # Class / object methods and accessors are not constructors (§7.2.4 /
        # §10.2.2 — concise methods have no [[Construct]]).
        if cl.func.is_method {
            return False;
        }
        # Builtin / JS-layer methods marked via __jacMarkNonConstructor.
        if cl.is_non_constructor {
            return False;
        }
        if cl.func.is_generator or cl.func.is_async {
            return False;
        }
        # Bound functions: IsConstructor(F) iff IsConstructor(targetFunction).
        if cl.func.is_bound {
            if len(cl.free_vals) == 0 {
                return False;
            }
            return _vm_is_constructor(vm, cl.free_vals[0]);
        }
        return True;
    }
    if jsv_is_object_cell(v) and jsv_to_table_id(v) > 0 {
        if js_object_has_own(v, WK_IS_CLASS) {
            return True;
        }
        if js_object_has_own(v, KEY_CTOR_KIND) {
            ck: JSValue = js_object_get(v, KEY_CTOR_KIND);
            if jsv_is_int32(ck) {
                return native_kind_is_constructible(jsv_to_int32(ck));
            }
        }
    }
    if is_native_val(v) {
        return native_kind_is_constructible(get_native_kind(v));
    }
    if js_is_proxy(v) {
        # Use the ProxyCreate snapshot so revoked Proxies retain constructibility
        # for typeof/[[Construct]] gating without re-walking a cleared target.
        return js_proxy_is_constructible(v);
    }
    return False;
}

"""
Construct(ctor, args, newTarget) — internal [[Construct]] for ArraySpeciesCreate,
Reflect.construct, bound-function unwrap, and Proxy construct fallback.
Handles Proxy, JS functions, classes, bound functions, and native constructors.
Propagates abrupt completions via vm_throw_native / vm.had_exception.
"""
def _vm_construct(
    vm: VM, ctor: JSValue, args: list[JSValue], new_target: JSValue
) -> JSValue {
    if js_is_proxy(ctor) {
        return vm._proxy_trap_construct(ctor, args, new_target);
    }
    if is_fn_val(ctor) {
        cl: JSClosure = vm.realm.closures[get_fn_idx(ctor)];
        if cl.is_arrow {
            vm_throw_native(make_type_error("Arrow function is not a constructor"));
            return js_undefined();
        }
        if js_object_has_own(cl.fn_props, WK_NOT_CTOR) {
            vm_throw_native(make_type_error(cl.func.name + " is not a constructor"));
            return js_undefined();
        }
        # Bound function [[Construct]] (§10.4.1.2)
        if cl.func.is_bound {
            target_bd: JSValue = ctor;
            if len(cl.free_vals) > 0 {
                target_bd = cl.free_vals[0];
            }
            full_args_bd: list[JSValue] = [];
            bfi: int = 1;
            while bfi < len(cl.free_vals) {
                full_args_bd.append(cl.free_vals[bfi]);
                bfi = bfi + 1;
            }
            for a_bd in args {
                full_args_bd.append(a_bd);
            }
            # If SameValue(newTarget, F), newTarget becomes targetFunction.
            nt_bd: JSValue = new_target;
            if js_strict_equal(new_target, ctor) {
                nt_bd = target_bd;
            }
            return _vm_construct(vm, target_bd, full_args_bd, nt_bd);
        }
        # GetPrototypeFromConstructor(newTarget, "%Object.prototype%") — §9.2.2.
        proto_src: JSValue = ctor;
        if not js_strict_equal(new_target, ctor) {
            proto_src = new_target;
        }
        proto_obj: JSValue = _vm_get_prototype_from_constructor(vm, proto_src, False);
        if vm_has_native_exc() {
            return js_undefined();
        }
        new_obj: JSValue = js_object_create(proto_obj);
        vm.pending_new_target = new_target;
        if _DBG_NEW_ON {
            _dbg_vc1: str = "[DBG_NEW] _vm_construct fn-val name='"
                + cl.func.name
                + "' bytecode_len="
                + str(len(cl.func.code))
                + " nargs="
                + str(len(args))
                + "\n";
            write(2, _dbg_vc1, len(_dbg_vc1));
        }
        cr: JSValue = vm.run_cl(cl, ctor, new_obj, args);
        if vm.had_exception {
            exc_c: JSValue = vm.pending_exc;
            vm.had_exception = False;
            vm.pending_exc = js_undefined();
            vm_throw_native(exc_c);
            return js_undefined();
        }
        if jsv_is_any_object(cr) {
            return cr;
        }
        return new_obj;
    }
    if jsv_is_object_cell(ctor)
        and jsv_to_table_id(ctor) >= 0
        and js_object_has_own(ctor, WK_IS_CLASS) {
        # Instance [[Prototype]] comes from newTarget.prototype when provided.
        cls_proto: JSValue = js_object_get(ctor, WK_PROTOTYPE);
        if not js_strict_equal(new_target, ctor) {
            if jsv_is_object_cell(new_target)
                and jsv_to_table_id(new_target) >= 0
                and js_object_has_own(new_target, WK_IS_CLASS) {
                cls_proto = js_object_get(new_target, WK_PROTOTYPE);
            } elif is_fn_val(new_target) {
                nt_cl2: JSClosure = vm.realm.closures[get_fn_idx(new_target)];
                if not jsv_is_undefined(nt_cl2.prototype_obj)
                    and not jsv_is_null(nt_cl2.prototype_obj) {
                    cls_proto = nt_cl2.prototype_obj;
                }
            }
        }
        new_obj_cls: JSValue = js_object_create(cls_proto);
        ctor_fn: JSValue = js_object_get(ctor, WK_CTOR);
        if _DBG_NEW_ON {
            _dbg_vc2: str = "[DBG_NEW] _vm_construct WK_IS_CLASS ctor_fn_is_fnval="
                + str(is_fn_val(ctor_fn))
                + " has_super="
                + str(js_object_has_own(ctor, WK_SUPER))
                + "\n";
            write(2, _dbg_vc2, len(_dbg_vc2));
        }
        if is_fn_val(ctor_fn) {
            cl_cls: JSClosure = vm.realm.closures[get_fn_idx(ctor_fn)];
            vm.pending_new_target = new_target;
            cr_cls: JSValue = vm.run_cl(cl_cls, ctor_fn, new_obj_cls, args);
            if vm.had_exception {
                exc_cls: JSValue = vm.pending_exc;
                vm.had_exception = False;
                vm.pending_exc = js_undefined();
                vm_throw_native(exc_cls);
                return js_undefined();
            }
            if jsv_is_any_object(cr_cls) {
                return cr_cls;
            }
        } elif js_object_has_own(ctor, WK_SUPER) {
            # Default derived class (no explicit constructor): call the super
            # constructor with new.target = the leaf class (same as `_op_new`).
            cls_super_vc: JSValue = js_object_get(ctor, WK_SUPER);
            if is_fn_val(cls_super_vc) {
                cl_sup_vc: JSClosure = vm.realm.closures[get_fn_idx(cls_super_vc)];
                vm.pending_new_target = new_target;
                cr_sup_vc: JSValue = vm.run_cl(
                    cl_sup_vc, cls_super_vc, new_obj_cls, args
                );
                if vm.had_exception {
                    exc_sup_vc: JSValue = vm.pending_exc;
                    vm.had_exception = False;
                    vm.pending_exc = js_undefined();
                    vm_throw_native(exc_sup_vc);
                    return js_undefined();
                }
                if jsv_is_any_object(cr_sup_vc) {
                    return cr_sup_vc;
                }
            } elif _is_array_native_super(cls_super_vc) {
                js_array_init_exotic_from_args(new_obj_cls, args);
                if vm_has_native_exc() {
                    return js_undefined();
                }
            } elif jsv_is_object_cell(cls_super_vc)
                and jsv_to_table_id(cls_super_vc) > 0
                and js_object_has_own(cls_super_vc, KEY_CTOR_KIND) {
                nk_sup_vc: int = jsv_to_int32(
                    js_object_get(cls_super_vc, KEY_CTOR_KIND)
                );
                _vm_call_native_proxy_aware(vm, vm.realm, nk_sup_vc, new_obj_cls, args);
                if vm_has_native_exc() {
                    return js_undefined();
                }
            } elif is_native_val(cls_super_vc) {
                nk_nat_vc: int = get_native_kind(cls_super_vc);
                err_nat_vc: JSValue = _vm_call_native_proxy_aware(
                    vm, vm.realm, nk_nat_vc, new_obj_cls, args
                );
                if vm_has_native_exc() {
                    return js_undefined();
                }
                if jsv_is_object_cell(err_nat_vc)
                    and jsv_to_table_id(err_nat_vc) > 0
                    and err_nat_vc != new_obj_cls {
                    ek_vc: list[int] = js_object_all_keys(err_nat_vc);
                    eki_vc: int = 0;
                    while eki_vc < len(ek_vc) {
                        epd_vc: JSProperty = js_object_get_own_property_descriptor(
                            err_nat_vc, ek_vc[eki_vc]
                        );
                        if not epd_vc.deleted {
                            js_object_define_property(
                                new_obj_cls, ek_vc[eki_vc], epd_vc
                            );
                        }
                        eki_vc = eki_vc + 1;
                    }
                }
            } elif jsv_is_object_cell(cls_super_vc)
                and jsv_to_table_id(cls_super_vc) >= 0 {
                inh_ctor_vc: JSValue = js_object_get(cls_super_vc, WK_CTOR);
                if is_fn_val(inh_ctor_vc) {
                    cl_inh_vc: JSClosure = vm.realm.closures[get_fn_idx(inh_ctor_vc)];
                    vm.pending_new_target = new_target;
                    cr_inh_vc: JSValue = vm.run_cl(
                        cl_inh_vc, inh_ctor_vc, new_obj_cls, args
                    );
                    if vm.had_exception {
                        exc_inh_vc: JSValue = vm.pending_exc;
                        vm.had_exception = False;
                        vm.pending_exc = js_undefined();
                        vm_throw_native(exc_inh_vc);
                        return js_undefined();
                    }
                    if jsv_is_any_object(cr_inh_vc) {
                        return cr_inh_vc;
                    }
                }
            }
        }
        return new_obj_cls;
    }
    if jsv_is_object_cell(ctor)
        and jsv_to_table_id(ctor) > 0
        and js_object_has_own(ctor, KEY_CTOR_KIND) {
        ck: JSValue = js_object_get(ctor, KEY_CTOR_KIND);
        if not jsv_is_int32(ck) {
            vm_throw_native(make_type_error("Constructor is not a constructor"));
            return js_undefined();
        }
        kind: int = jsv_to_int32(ck);
        if kind == NATIVE_KIND_SYMBOL {
            vm_throw_native(make_type_error("Symbol is not a constructor"));
            return js_undefined();
        }
        if kind == NATIVE_KIND_BIGINT {
            if not jsv_is_undefined(new_target) {
                vm_throw_native(make_type_error("BigInt is not a constructor"));
                return js_undefined();
            }
        }
        if kind == NATIVE_KIND_ARRAY {
            if not js_strict_equal(new_target, ctor) {
                proto_arr: JSValue = _vm_get_prototype_from_constructor(
                    vm, new_target, True
                );
                if vm_has_native_exc() {
                    return js_undefined();
                }
                if jsv_is_any_object(proto_arr) {
                    arr_nc: JSValue = js_object_create(proto_arr);
                    js_array_init_exotic_from_args(arr_nc, args);
                    if vm_has_native_exc() {
                        return js_undefined();
                    }
                    return arr_nc;
                }
            }
            return js_Array(args);
        }
        if kind == NATIVE_KIND_MAP
            or kind == NATIVE_KIND_SET
            or kind == NATIVE_KIND_WEAKMAP
            or kind == NATIVE_KIND_WEAKSET {
            return _vm_construct_collection(vm, kind, ctor, args, new_target);
        }
        if _vm_is_temporal_ctor_kind(kind) {
            return _vm_construct_temporal_native(vm, kind, ctor, args, new_target);
        }
        if kind == NATIVE_KIND_DATE {
            # Reflect.construct(Date, args, newTarget) / species — build the time
            # value observably, then set [[Prototype]] from
            # GetPrototypeFromConstructor(newTarget) (§21.4.2.1 / §9.1.13).
            date_kn: JSValue = _vm_date_construct_obs(vm, args);
            if vm_has_native_exc() {
                return js_undefined();
            }
            proto_kn: JSValue = _vm_get_collection_proto_from_constructor(
                vm, new_target, "Date"
            );
            if vm_has_native_exc() {
                return js_undefined();
            }
            if jsv_is_object_cell(proto_kn) and jsv_is_object_cell(date_kn) {
                js_object_set_prototype(date_kn, proto_kn);
            }
            return date_kn;
        }
        if kind == NATIVE_KIND_REGEXP {
            # `new RegExp(...)` / Reflect.construct / `class X extends RegExp` —
            # NewTarget is defined, so build a fresh RegExp (no pattern pass-
            # through) then set [[Prototype]] from GetPrototypeFromConstructor
            # (§22.2.3.1 / §9.1.13). A throwing newTarget.prototype getter
            # propagates via the observable read inside the helper.
            re_kn: JSValue = js_RegExp_ctor_nt(args, False);
            if vm_has_native_exc() {
                return js_undefined();
            }
            if not js_strict_equal(new_target, ctor) and jsv_is_any_object(re_kn) {
                re_proto_kn: JSValue = _vm_get_collection_proto_from_constructor(
                    vm, new_target, "RegExp"
                );
                if vm_has_native_exc() {
                    return js_undefined();
                }
                if jsv_is_any_object(re_proto_kn) {
                    js_object_set_prototype(re_kn, re_proto_kn);
                }
            }
            return re_kn;
        }
        res_n: JSValue = _vm_call_native_proxy_aware(
            vm, vm.realm, kind, js_undefined(), args
        );
        if vm_has_native_exc() {
            return js_undefined();
        }
        return res_n;
    }
    if is_native_val(ctor) {
        kind_n: int = get_native_kind(ctor);
        if kind_n == NATIVE_KIND_ARRAY {
            if not js_strict_equal(new_target, ctor) {
                proto_arr2: JSValue = _vm_get_prototype_from_constructor(
                    vm, new_target, True
                );
                if vm_has_native_exc() {
                    return js_undefined();
                }
                if jsv_is_any_object(proto_arr2) {
                    arr_n2: JSValue = js_object_create(proto_arr2);
                    js_array_init_exotic_from_args(arr_n2, args);
                    if vm_has_native_exc() {
                        return js_undefined();
                    }
                    return arr_n2;
                }
            }
            return js_Array(args);
        }
        if kind_n == NATIVE_KIND_MAP
            or kind_n == NATIVE_KIND_SET
            or kind_n == NATIVE_KIND_WEAKMAP
            or kind_n == NATIVE_KIND_WEAKSET {
            return _vm_construct_collection(vm, kind_n, ctor, args, new_target);
        }
        if _vm_is_temporal_ctor_kind(kind_n) {
            return _vm_construct_temporal_native(vm, kind_n, ctor, args, new_target);
        }
        # NATIVE_KIND_DATE is not reached here: the Date constructor is a
        # KEY_CTOR_KIND object-cell, handled in the object-ctor branch above.
        if kind_n == NATIVE_KIND_BIGINT {
            if not jsv_is_undefined(new_target) {
                vm_throw_native(make_type_error("BigInt is not a constructor"));
                return js_undefined();
            }
        }
        res_nv: JSValue = _vm_call_native_proxy_aware(
            vm, vm.realm, kind_n, js_undefined(), args
        );
        if vm_has_native_exc() {
            return js_undefined();
        }
        return res_nv;
    }
    vm_throw_native(make_type_error("Constructor is not a constructor"));
    return js_undefined();
}

"""Bridge vm.had_exception onto the native side-channel. Returns True if an exception was present."""
def _vm_bridge_vm_exc(vm: VM) -> bool {
    if not vm.had_exception {
        return False;
    }
    exc_b: JSValue = vm.pending_exc;
    vm.had_exception = False;
    vm.pending_exc = js_undefined();
    vm_throw_native(exc_b);
    return True;
}

"""
IteratorClose(iterator) then rethrow `exc`, discarding any secondary error from .return().
ECMAScript §7.4.11 — an already-abrupt completion wins over IteratorClose's own outcome.
"""
def _vm_iter_close_rethrow(vm: VM, iterator: JSValue, exc: JSValue) {
    _vm_iterator_close(vm, iterator);
    vm.had_exception = False;
    vm.pending_exc = js_undefined();
    if vm_has_native_exc() {
        drop_ic: JSValue = vm_take_native_exc();
    }
    vm_throw_native(exc);
}

"""
Capture an exception from either the VM state or the native side-channel.
Returns (had_exc, exc). Clears both channels when an exception is present.
"""
def _vm_capture_any_exc(vm: VM) -> list[JSValue] {
    if vm.had_exception {
        exc_c: JSValue = vm.pending_exc;
        vm.had_exception = False;
        vm.pending_exc = js_undefined();
        return [js_boolean(True), exc_c];
    }
    if vm_has_native_exc() {
        return [js_boolean(True), vm_take_native_exc()];
    }
    return [js_boolean(False), js_undefined()];
}

"""
CreateDataPropertyOrThrow(O, ToString(idx), val) — proxy-aware.
Ordinary objects use `_create_data_property_or_throw`; Proxies route through
`proxy_trap_define_property` so defineProperty traps (and their throws) are observed.
"""
def _vm_create_data_property_or_throw(
    vm: VM, o: JSValue, idx: int, val: JSValue
) -> bool {
    if _vm_cdp_dense(o, idx, val) {
        return True;
    }
    if js_is_proxy(o) {
        key_v: JSValue = jsv_from_string_id(str_intern_index(idx));
        desc_obj: JSValue = js_object_create_null();
        js_object_set(desc_obj, WK_VALUE, val);
        js_object_set(desc_obj, str_intern("writable"), js_boolean(True));
        js_object_set(desc_obj, str_intern("enumerable"), js_boolean(True));
        js_object_set(desc_obj, str_intern("configurable"), js_boolean(True));
        ok_p: bool = proxy_trap_define_property(vm, o, key_v, desc_obj);
        if vm_has_native_exc() {
            return False;
        }
        if _vm_bridge_vm_exc(vm) {
            return False;
        }
        if not ok_p {
            vm_throw_native(make_type_error("Cannot create property"));
            return False;
        }
        return True;
    }
    return _create_data_property_or_throw(o, idx, val);
}

"""
Normalize a raw iterator object into a form `_vm_iter_next_delegate` can drive:
  - generators → {WK_GEN: gen} wrapper
  - built-in {WK_I, WK_J} shells → as-is
  - custom iterators with own .next → {WK_CUSTOM: iter} wrapper
"""
def _vm_normalize_iterator(vm: VM, raw_iter: JSValue) -> JSValue {
    if js_is_generator(raw_iter) {
        gen_wrap: JSValue = js_object_create_null();
        js_object_set(gen_wrap, WK_I, js_array_create([]));
        js_object_set(gen_wrap, WK_J, js_int(0));
        js_object_set(gen_wrap, WK_GEN, raw_iter);
        return gen_wrap;
    }
    if jsv_is_object_cell(raw_iter)
        and js_object_has_own(raw_iter, WK_I)
        and js_object_has_own(raw_iter, WK_J) {
        return raw_iter;
    }
    return _vm_wrap_custom_iter(vm, raw_iter);
}

"""
Array.of(...items) — §23.1.2.3.
IsConstructor(this) ? Construct(this, «len») : ArrayCreate(len), then
CreateDataPropertyOrThrow for each argument and Set(A, "length", len, true).
"""
def _vm_array_of(vm: VM, this_val: JSValue, args: list[JSValue]) -> JSValue {
    len_: int = len(args);
    a: JSValue = js_undefined();
    if _vm_is_constructor(vm, this_val) {
        a = _vm_construct(vm, this_val, [js_number(float(len_))], this_val);
        if vm_has_native_exc() {
            return js_undefined();
        }
    } else {
        if not _array_create_len_ok(len_) {
            return js_undefined();
        }
        a = js_array_create_with_length(len_);
    }
    k: int = 0;
    while k < len_ {
        if not _vm_create_data_property_or_throw(vm, a, k, args[k]) {
            return js_undefined();
        }
        k = k + 1;
    }
    if not _set_named_or_throw(a, KEY_LENGTH, js_number(float(len_))) {
        return js_undefined();
    }
    return a;
}

"""
Array.from(items [, mapfn [, thisArg]]) — §23.1.2.1.
Full iterator protocol (GetMethod(@@iterator), IteratorStep, IteratorClose),
mapFn/thisArg, and Construct(this) / ArrayCreate for subclassing.
External contract: native side-channel (vm_has_native_exc).
"""
def _vm_array_from(vm: VM, this_val: JSValue, args: list[JSValue]) -> JSValue {
    # Root this call's arguments across the per-element VM re-entries — this
    # native is dispatched outside _arr_dispatch_callback_method, so nothing
    # else roots them (same in-flight-value class as map's result array).
    if len(vm.frames) > 0 {
        for afr_a in args {
            vm.frames[len(vm.frames) - 1].native_roots.append(afr_a);
        }
        vm.frames[len(vm.frames) - 1].rare = True;
    }
    # 1. Resolve mapfn / thisArg (spec steps 2–3, before touching items).
    mapping: bool = False;
    mapfn: JSValue = js_undefined();
    t_arg: JSValue = js_undefined();
    if len(args) >= 2 and not jsv_is_undefined(args[1]) {
        mapfn = args[1];
        if not vm._value_is_callable(mapfn) {
            vm_throw_native(
                make_type_error(_not_fn_desc(mapfn) + " is not a function")
            );
            return js_undefined();
        }
        mapping = True;
        if len(args) > 2 {
            t_arg = args[2];
        }
    }

    # 2. items — null/undefined → TypeError (ToObject / GetMethod).
    items: JSValue = js_undefined();
    if len(args) > 0 {
        items = args[0];
    }
    if jsv_is_null(items) or jsv_is_undefined(items) {
        afrom_tn: str = "null";
        if jsv_is_undefined(items) {
            afrom_tn = "undefined";
        }
        vm_throw_native(make_type_error("Cannot convert " + afrom_tn + " to object"));
        return js_undefined();
    }

    # 3. GetMethod(items, @@iterator) — strings and generators are always iterable
    # (their @@iterator/.next are synthesized on GET_PROP, not own data props).
    using_iterator: bool = False;
    iter_method: JSValue = js_undefined();
    is_string_items: bool = jsv_is_string_cell(items);
    is_gen_items: bool = jsv_is_object_cell(items) and js_is_generator(items);
    if is_string_items or is_gen_items {
        using_iterator = True;
    } elif not jsv_is_bool(items)
        and not jsv_is_int32(items)
        and not jsv_is_double(items)
        and not jsv_is_symbol(items)
        and not jsv_is_bigint_cell(items) {
        # Object-like (ordinary objects, arrays, functions, proxies, natives).
        sym_iter_key: int = SYMBOL_KEY_BASE + SYMBOL_ITERATOR;
        iter_method = vm.obs_get(items, sym_iter_key, items);
        if vm_has_native_exc() {
            return js_undefined();
        }
        if jsv_is_null(iter_method) or jsv_is_undefined(iter_method) {
            using_iterator = False;
        } elif not vm._value_is_callable(iter_method) {
            vm_throw_native(
                make_type_error(_not_fn_desc(iter_method) + " is not a function")
            );
            return js_undefined();
        } else {
            using_iterator = True;
        }
    }

    max_safe: int = 9007199254740991;
    k_len_key: int = KEY_LENGTH;

    if using_iterator {
        # 4a. Construct result BEFORE obtaining the iterator (iter-cstm-ctor-err.js).
        a_it: JSValue = js_undefined();
        if _vm_is_constructor(vm, this_val) {
            a_it = _vm_construct(vm, this_val, [], this_val);
            if vm_has_native_exc() {
                return js_undefined();
            }
        } else {
            a_it = js_array_create_with_length(0);
        }
        # Root the result across per-element iterator/.next()/mapFn VM re-entries
        # (same native-in-flight-value class as map's result array).
        if len(vm.frames) > 0 {
            vm.frames[len(vm.frames) - 1].native_roots.append(a_it);
            vm.frames[len(vm.frames) - 1].rare = True;
        }

        # Obtain iterator and normalize to a form _vm_iter_next_delegate understands.
        iterator: JSValue = js_undefined();
        if is_string_items {
            iterator = _vm_materialize_delegate_iter(vm, items, False);
            if _vm_bridge_vm_exc(vm) {
                return js_undefined();
            }
            if vm_has_native_exc() {
                return js_undefined();
            }
        } elif is_gen_items {
            # Generator items: wrap with WK_GEN (mirrors _op_get_iter).
            gen_wrap_items: JSValue = js_object_create_null();
            js_object_set(gen_wrap_items, WK_I, js_array_create([]));
            js_object_set(gen_wrap_items, WK_J, js_int(0));
            js_object_set(gen_wrap_items, WK_GEN, items);
            iterator = gen_wrap_items;
        } else {
            raw_iter: JSValue = _vm_invoke_callback(vm, iter_method, items, []);
            if _vm_bridge_vm_exc(vm) {
                return js_undefined();
            }
            if vm_has_native_exc() {
                return js_undefined();
            }
            iterator = _vm_normalize_iterator(vm, raw_iter);
            if _vm_bridge_vm_exc(vm) {
                return js_undefined();
            }
            if vm_has_native_exc() {
                return js_undefined();
            }
        }
        # The iterator wrapper (gen_wrap state object / normalized iterator) is
        # ALSO an in-flight jac local across the per-element re-entries — a GC
        # during mapFn swept it and killed the iteration state mid-loop.
        if len(vm.frames) > 0 {
            vm.frames[len(vm.frames) - 1].native_roots.append(iterator);
            vm.frames[len(vm.frames) - 1].rare = True;
        }

        k_it: int = 0;
        while True {
            # IteratorStep — abrupt does NOT close (iter-adv-err.js).
            step: JSValue = _vm_iter_next_delegate(vm, iterator);
            cap_step: list[JSValue] = _vm_capture_any_exc(vm);
            if jsv_to_bool(cap_step[0]) {
                vm_throw_native(cap_step[1]);
                return js_undefined();
            }

            # IteratorComplete — abrupt does NOT close.
            done_v: JSValue = vm.obs_get(step, WK_DONE, step);
            if vm_has_native_exc() {
                return js_undefined();
            }
            if jsv_coerce_to_bool(done_v) {
                if not _set_named_or_throw(a_it, k_len_key, js_number(float(k_it))) {
                    return js_undefined();
                }
                return a_it;
            }

            # IteratorValue — abrupt does NOT close (iter-get-iter-val-err.js).
            next_value: JSValue = vm.obs_get(step, WK_VALUE, step);
            if vm_has_native_exc() {
                return js_undefined();
            }

            mapped: JSValue = next_value;
            if mapping {
                # Call(mapfn, T, «nextValue, k») — abrupt → IteratorClose (iter-map-fn-err.js).
                mapped = _vm_invoke_callback(
                    vm, mapfn, t_arg, [next_value, js_number(float(k_it))]
                );
                cap_map: list[JSValue] = _vm_capture_any_exc(vm);
                if jsv_to_bool(cap_map[0]) {
                    _vm_iter_close_rethrow(vm, iterator, cap_map[1]);
                    return js_undefined();
                }
            }

            # CreateDataPropertyOrThrow — abrupt → IteratorClose (iter-set-elem-prop-err.js).
            if not _vm_create_data_property_or_throw(vm, a_it, k_it, mapped) {
                cap_def: list[JSValue] = _vm_capture_any_exc(vm);
                if jsv_to_bool(cap_def[0]) {
                    _vm_iter_close_rethrow(vm, iterator, cap_def[1]);
                }
                return js_undefined();
            }

            k_it = k_it + 1;
            # Overflow guard — IteratorClose then TypeError.
            if k_it >= max_safe {
                _vm_iter_close_rethrow(
                    vm, iterator, make_type_error("Array length exceeds 2^53 - 1")
                );
                return js_undefined();
            }
        }
    }

    # 4b. Array-like path.
    array_like: JSValue = _vm_array_to_object(items);
    if vm_has_native_exc() {
        return js_undefined();
    }
    len_al: int = _length_of(array_like);
    if vm_has_native_exc() {
        return js_undefined();
    }

    a_al: JSValue = js_undefined();
    if _vm_is_constructor(vm, this_val) {
        a_al = _vm_construct(vm, this_val, [js_number(float(len_al))], this_val);
        if vm_has_native_exc() {
            return js_undefined();
        }
    } else {
        if not _array_create_len_ok(len_al) {
            return js_undefined();
        }
        a_al = js_array_create_with_length(len_al);
    }
    # Root the result (and the ToObject wrapper of a primitive `items`) across
    # the per-element obs_get / mapFn VM re-entries — same in-flight-value class
    # as the iterator branch above and map's result array. Unrooted, a GC that
    # fires inside the mapper (e.g. `Array.from({length: n}, () => transform(...))`
    # with esbuild's request encoding allocating enough to trip the trigger)
    # swept the half-built array and the promises already stored in it, so
    # Promise.all over it never settled (vite:esbuild-transpile renderChunk
    # "never settled" under --gc; deterministic repro: fromgc.mjs `from`).
    if len(vm.frames) > 0 {
        vm.frames[len(vm.frames) - 1].native_roots.append(a_al);
        vm.frames[len(vm.frames) - 1].rare = True;
        vm.frames[len(vm.frames) - 1].native_roots.append(array_like);
        vm.frames[len(vm.frames) - 1].rare = True;
    }

    k_al: int = 0;
    while True {
        len_al = _length_of(array_like);
        if vm_has_native_exc() {
            return js_undefined();
        }
        if k_al >= len_al {
            break;
        }
        pk_al: int = str_intern_index(k_al);
        k_value: JSValue = vm.obs_get(array_like, pk_al, array_like);
        if vm_has_native_exc() {
            return js_undefined();
        }
        mapped_al: JSValue = k_value;
        if mapping {
            mapped_al = _vm_invoke_callback(
                vm, mapfn, t_arg, [k_value, js_number(float(k_al))]
            );
            if _vm_bridge_vm_exc(vm) {
                return js_undefined();
            }
            if vm_has_native_exc() {
                return js_undefined();
            }
        }
        if not _vm_create_data_property_or_throw(vm, a_al, k_al, mapped_al) {
            return js_undefined();
        }
        k_al = k_al + 1;
    }
    if not _set_named_or_throw(a_al, k_len_key, js_number(float(k_al))) {
        return js_undefined();
    }
    return a_al;
}

"""Settle a pending fromAsync promise after IteratorClose (sync or awaited async return)."""
def _vm_from_async_settle_reject(vm: VM, result_p: JSValue, reason: JSValue) {
    if js_is_promise(result_p) and js_promise_get_state(result_p) == PROMISE_PENDING {
        vm._promise_settle_and_drain(result_p, PROMISE_REJECTED, reason);
    }
}

"""
AsyncIteratorClose for fromAsync abrupt paths — await return() when it yields a Promise.
Returns True when rejection is deferred until the close Promise settles.
"""
def _vm_from_async_async_iterator_close(
    vm: VM, result_p: JSValue, iter_r: JSValue, reason: JSValue
) -> bool {
    js_object_set(result_p, _KEY_FROM_ASYNC_REJECT_REASON, reason);
    ret_fn: JSValue = vm.obs_get(iter_r, WK_RETURN, iter_r);
    if vm_has_native_exc() {
        _ = vm_take_native_exc();
        return False;
    }
    if jsv_is_undefined(ret_fn)
        or jsv_is_null(ret_fn)
        or not vm._value_is_callable(ret_fn) {
        return False;
    }
    ret_res: JSValue = _vm_invoke_callback(vm, ret_fn, iter_r, []);
    if _vm_bridge_vm_exc(vm) {
        if vm.had_exception {
            vm.had_exception = False;
            vm.pending_exc = js_undefined();
        }
        if vm_has_native_exc() {
            _ = vm_take_native_exc();
        }
        return False;
    }
    if vm_has_native_exc() {
        _ = vm_take_native_exc();
        return False;
    }
    if not js_is_promise(ret_res) {
        js_object_delete(result_p, _KEY_FROM_ASYNC_ITER);
        js_object_delete(result_p, _KEY_FROM_ASYNC_NEXT);
        _vm_from_async_settle_reject(vm, result_p, reason);
        return True;
    }
    on_close: JSValue = js_object_create_null();
    js_object_set(on_close, _KEY_FROM_ASYNC_CLOSE_AWAIT, js_true());
    js_object_set(on_close, _KEY_FROM_ASYNC_RESULT, result_p);
    pst_c: int = js_promise_get_state(ret_res);
    if pst_c == PROMISE_PENDING {
        js_promise_add_reaction(ret_res, on_close, on_close, js_undefined());
    } else {
        scheduler_push_reaction(
            vm.realm,
            on_close,
            on_close,
            pst_c,
            js_promise_get_value(ret_res),
            js_undefined()
        );
    }
    return True;
}

"""Complete fromAsync reject after AsyncIteratorClose (discard close outcome)."""
def _vm_from_async_finish_reject_close(vm: VM, result_p: JSValue) -> None {
    if not js_is_promise(result_p)
        or js_promise_get_state(result_p) != PROMISE_PENDING {
        return;
    }
    reason: JSValue = js_object_get(result_p, _KEY_FROM_ASYNC_REJECT_REASON);
    js_object_delete(result_p, _KEY_FROM_ASYNC_REJECT_REASON);
    js_object_delete(result_p, _KEY_FROM_ASYNC_ITER);
    js_object_delete(result_p, _KEY_FROM_ASYNC_NEXT);
    _vm_from_async_settle_reject(vm, result_p, reason);
}

"""Reject a pending fromAsync result promise (IteratorClose when an iterator is bound)."""
def _vm_from_async_reject(vm: VM, result_p: JSValue, reason: JSValue) -> None {
    if js_is_promise(result_p) and js_promise_get_state(result_p) == PROMISE_PENDING {
        iter_r: JSValue = js_object_get(result_p, _KEY_FROM_ASYNC_ITER);
        if jsv_is_object_cell(iter_r) and jsv_to_table_id(iter_r) > 0 {
            # Prefer AsyncIteratorClose (awaits return() Promise). Falls back to
            # sync IteratorClose so sync-iterator return() still runs when the
            # async close path finds no callable return / swallows GetMethod.
            deferred: bool = _vm_from_async_async_iterator_close(
                vm, result_p, iter_r, reason
            );
            if deferred {
                return;
            }
            if vm.had_exception {
                vm.had_exception = False;
                vm.pending_exc = js_undefined();
            }
            if vm_has_native_exc() {
                _ = vm_take_native_exc();
            }
            # Sync IteratorClose — ensures return() is invoked for plain objects
            # (mapfn-async-throws-close-sync-iterator).
            _vm_iterator_close(vm, iter_r);
            if vm.had_exception {
                vm.had_exception = False;
                vm.pending_exc = js_undefined();
            }
            if vm_has_native_exc() {
                _ = vm_take_native_exc();
            }
            js_object_delete(result_p, _KEY_FROM_ASYNC_ITER);
            js_object_delete(result_p, _KEY_FROM_ASYNC_NEXT);
        }
        _vm_from_async_settle_reject(vm, result_p, reason);
    }
}

"""Fulfill a pending fromAsync result promise."""
def _vm_from_async_fulfill(vm: VM, result_p: JSValue, arr: JSValue) {
    if js_is_promise(result_p) and js_promise_get_state(result_p) == PROMISE_PENDING {
        vm._promise_settle_and_drain(result_p, PROMISE_FULFILLED, arr);
    }
}

"""
Bind an IteratorRecord for fromAsync: wrap generators for the delegate path and
cache [[NextMethod]] once (ES §7.4.1 / CreateAsyncFromSyncIterator).
Returns False if the promise was already rejected.
"""
def _vm_from_async_bind_iterator(vm: VM, result_p: JSValue, raw_iter: JSValue) -> bool {
    if not jsv_is_object_cell(raw_iter) or jsv_to_table_id(raw_iter) <= 0 {
        js_promise_settle(
            result_p,
            PROMISE_REJECTED,
            make_type_error("Iterator result .next method is not callable")
        );
        return False;
    }
    # Generators / async generators synthesize .next on GET_PROP only — wrap so
    # `_vm_iter_next_delegate` drives them via run_generator (never re-Get next).
    if js_is_generator(raw_iter) {
        gen_wrap: JSValue = js_object_create_null();
        js_object_set(gen_wrap, WK_I, js_array_create([]));
        js_object_set(gen_wrap, WK_J, js_int(0));
        js_object_set(gen_wrap, WK_GEN, raw_iter);
        js_object_set(result_p, _KEY_FROM_ASYNC_ITER, gen_wrap);
        return True;
    }
    # Already a VM iterator record (WK_CUSTOM / WK_I shell) — drive via delegate.
    if (
        js_object_has_own(raw_iter, WK_CUSTOM)
        or js_object_has_own(raw_iter, WK_GEN)
        or (js_object_has_own(raw_iter, WK_I) and js_object_has_own(raw_iter, WK_J))
    ) {
        js_object_set(result_p, _KEY_FROM_ASYNC_ITER, raw_iter);
        return True;
    }
    # Cache [[NextMethod]] = Get(iterator, "next") exactly once.
    next_fn: JSValue = vm.obs_get(raw_iter, WK_NEXT, raw_iter);
    if vm_has_native_exc() {
        if vm.had_exception {
            exc_bn: JSValue = vm.pending_exc;
            vm.had_exception = False;
            vm.pending_exc = js_undefined();
            js_promise_settle(result_p, PROMISE_REJECTED, exc_bn);
        }
        return False;
    }
    if not vm._value_is_callable(next_fn) {
        js_promise_settle(
            result_p,
            PROMISE_REJECTED,
            make_type_error("Iterator result .next method is not callable")
        );
        return False;
    }
    js_object_set(result_p, _KEY_FROM_ASYNC_ITER, raw_iter);
    js_object_set(result_p, _KEY_FROM_ASYNC_NEXT, next_fn);
    return True;
}

"""Process one async-iterator step result {value, done}."""
def _vm_from_async_iter_advance(vm: VM, result_p: JSValue, step_obj: JSValue) -> None {
    if not js_is_promise(result_p)
        or js_promise_get_state(result_p) != PROMISE_PENDING {
        return;
    }
    out_a: JSValue = js_object_get(result_p, _KEY_FROM_ASYNC_OUT);
    idx: int = jsv_to_int32(js_object_get(result_p, _KEY_FROM_ASYNC_IDX));
    iter: JSValue = js_object_get(result_p, _KEY_FROM_ASYNC_ITER);
    # Async-generator / CreateAsyncFromSyncIterator may surface an extra Promise
    # layer around {value,done}. Await it — never treat a Promise as an iter result
    # (done=undefined → infinite store loop / OOM hang).
    if js_is_promise(step_obj) {
        on_cont: JSValue = js_object_create_null();
        js_object_set(on_cont, _KEY_FROM_ASYNC_CONTINUE, js_true());
        js_object_set(on_cont, _KEY_FROM_ASYNC_RESULT, result_p);
        pst_s: int = js_promise_get_state(step_obj);
        if pst_s == PROMISE_PENDING {
            js_promise_add_reaction(step_obj, on_cont, on_cont, js_undefined());
            return;
        }
        if pst_s == PROMISE_REJECTED {
            _vm_from_async_reject(vm, result_p, js_promise_get_value(step_obj));
            return;
        }
        scheduler_push_reaction(
            vm.realm,
            on_cont,
            on_cont,
            PROMISE_FULFILLED,
            js_promise_get_value(step_obj),
            js_undefined()
        );
        return;
    }
    if not jsv_is_object_cell(step_obj) {
        _vm_from_async_reject(
            vm, result_p, make_type_error("Iterator result must be an object")
        );
        return;
    }
    done_v: JSValue = vm.obs_get(step_obj, WK_DONE, step_obj);
    if vm_has_native_exc() {
        if vm.had_exception {
            exc_d: JSValue = vm.pending_exc;
            vm.had_exception = False;
            vm.pending_exc = js_undefined();
            _vm_from_async_reject(vm, result_p, exc_d);
        }
        return;
    }
    if jsv_coerce_to_bool(done_v) {
        if not _set_named_or_throw(out_a, KEY_LENGTH, js_number(float(idx))) {
            return;
        }
        _vm_from_async_fulfill(vm, result_p, out_a);
        return;
    }
    next_val: JSValue = vm.obs_get(step_obj, WK_VALUE, step_obj);
    if vm_has_native_exc() {
        if vm.had_exception {
            exc_v: JSValue = vm.pending_exc;
            vm.had_exception = False;
            vm.pending_exc = js_undefined();
            _vm_from_async_reject(vm, result_p, exc_v);
        }
        return;
    }
    _vm_from_async_store_awaited(vm, result_p, out_a, idx, iter, next_val);
}

"""Build a fromAsync Await reaction marker (AWAIT_ELEM or AWAIT_MAPPED)."""
def _vm_from_async_make_await_reaction(
    result_p: JSValue, idx: int, iter: JSValue, mapped: bool
) -> JSValue {
    on_f: JSValue = js_object_create_null();
    if mapped {
        js_object_set(on_f, _KEY_FROM_ASYNC_AWAIT_MAPPED, js_true());
    } else {
        js_object_set(on_f, _KEY_FROM_ASYNC_AWAIT_ELEM, js_true());
    }
    js_object_set(on_f, _KEY_FROM_ASYNC_RESULT, result_p);
    js_object_set(on_f, _KEY_FROM_ASYNC_ELEM_IDX, js_int(idx));
    js_object_set(on_f, _KEY_FROM_ASYNC_ITER, iter);
    return on_f;
}

"""
Await(value) for fromAsync — PromiseResolve + PerformPromiseThen cadence.
Never sync-unwraps fulfilled promises (one Await ≡ one reaction job).
Thenables are adopted by calling [[Then]] exactly once — do not also
PromiseResolve the same thenable (that would double-call `then`).
"""
def _vm_from_async_await_value(
    vm: VM, result_p: JSValue, idx: int, iter: JSValue, val: JSValue, mapped: bool
) -> None {
    on_f: JSValue = _vm_from_async_make_await_reaction(result_p, idx, iter, mapped);
    if js_is_promise(val) {
        pst: int = js_promise_get_state(val);
        if pst == PROMISE_REJECTED {
            # Await adopts the rejection — mark handled so async mapfn throws do not
            # surface as a second unhandled rejection beside fromAsync's result.
            promise_unmark_unhandled(val);
            # Reject via microtask (Await / Promise.then cadence), not sync.
            scheduler_push_reaction(
                vm.realm,
                on_f,
                on_f,
                PROMISE_REJECTED,
                js_promise_get_value(val),
                js_undefined()
            );
            return;
        }
        if pst == PROMISE_PENDING {
            js_promise_add_reaction(val, on_f, on_f, js_undefined());
            return;
        }
        # Already fulfilled — enqueue only (never continue synchronously with
        # the unwrapped value; that would skip the Await job and can double-drive
        # a subsequent thenable Await when combined with mapfn).
        scheduler_push_reaction(
            vm.realm,
            on_f,
            on_f,
            PROMISE_FULFILLED,
            js_promise_get_value(val),
            js_undefined()
        );
        return;
    }
    # Thenable adoption: Get(val, "then") and Call once (Promise Resolve Functions).
    # Important: do NOT Promise.resolve(thenable) first — that would Call then
    # a second time when combined with this adoption (awaits-once tests).
    if jsv_is_object_cell(val) and jsv_to_table_id(val) > 0 {
        then_fn: JSValue = vm.obs_get(val, WK_THEN, val);
        cap_th: list[JSValue] = _vm_capture_any_exc(vm);
        if jsv_to_bool(cap_th[0]) {
            _vm_from_async_reject(vm, result_p, cap_th[1]);
            return;
        }
        if vm._value_is_callable(then_fn) {
            bridge: JSValue = js_promise_create();
            js_promise_add_reaction(bridge, on_f, on_f, js_undefined());
            resolve_fn: JSValue = js_make_resolve_fn(bridge);
            reject_fn: JSValue = js_make_reject_fn(bridge);
            _vm_invoke_callback(vm, then_fn, val, [resolve_fn, reject_fn]);
            cap_call: list[JSValue] = _vm_capture_any_exc(vm);
            if jsv_to_bool(cap_call[0]) {
                if js_promise_get_state(bridge) == PROMISE_PENDING {
                    vm._promise_settle_and_drain(bridge, PROMISE_REJECTED, cap_call[1]);
                }
            }
            return;
        }
    }
    # Non-thenable: PromiseResolve → fulfilled promise, then enqueue Await job.
    scheduler_push_reaction(
        vm.realm, on_f, on_f, PROMISE_FULFILLED, val, js_undefined()
    );
}

"""Store one completed element and advance the fromAsync walk."""
def _vm_from_async_finish_store(
    vm: VM, result_p: JSValue, out_a: JSValue, idx: int, iter: JSValue, val: JSValue
) -> None {
    if not _vm_create_data_property_or_throw(vm, out_a, idx, val) {
        cap_sa: list[JSValue] = _vm_capture_any_exc(vm);
        if jsv_to_bool(cap_sa[0]) {
            _vm_from_async_reject(vm, result_p, cap_sa[1]);
        }
        return;
    }
    # Array-like path: length was snapshotted once (spec LengthOfArrayLike).
    if js_object_has_own(result_p, _KEY_FROM_ASYNC_SOURCE)
        and not js_object_has_own(result_p, _KEY_FROM_ASYNC_ITER) {
        src_al: JSValue = js_object_get(result_p, _KEY_FROM_ASYNC_SOURCE);
        n_src: int = 0;
        len_v: JSValue = js_object_get(result_p, _KEY_FROM_ASYNC_LEN);
        if jsv_is_int32(len_v) {
            n_src = jsv_to_int32(len_v);
        } elif jsv_is_double(len_v) {
            n_src = int(jsv_to_double(len_v));
        }
        _vm_from_async_await_index(vm, result_p, src_al, idx + 1, n_src);
        return;
    }
    js_object_set(result_p, _KEY_FROM_ASYNC_IDX, js_int(idx + 1));
    _vm_from_async_iter_next(vm, result_p);
}

"""
After input Await (or async-iter skip): optional mapfn, then Await(mapped) or store.
Abrupt mapfn → IteratorClose via reject.
"""
def _vm_from_async_after_input(
    vm: VM, result_p: JSValue, out_a: JSValue, idx: int, iter: JSValue, val: JSValue
) -> None {
    map_fn: JSValue = js_object_get(result_p, _KEY_FROM_ASYNC_MAPFN);
    if not jsv_is_undefined(map_fn) {
        map_this: JSValue = js_object_get(result_p, _KEY_FROM_ASYNC_MAP_THIS);
        mapped: JSValue = _vm_invoke_callback(vm, map_fn, map_this, [val, js_int(idx)]);
        if _vm_bridge_vm_exc(vm) {
            cap_map: list[JSValue] = _vm_capture_any_exc(vm);
            if jsv_to_bool(cap_map[0]) {
                _vm_from_async_reject(vm, result_p, cap_map[1]);
            }
            return;
        }
        cap_map: list[JSValue] = _vm_capture_any_exc(vm);
        if jsv_to_bool(cap_map[0]) {
            _vm_from_async_reject(vm, result_p, cap_map[1]);
            return;
        }
        _vm_from_async_await_value(vm, result_p, idx, iter, mapped, True);
        return;
    }
    _vm_from_async_finish_store(vm, result_p, out_a, idx, iter, val);
}

"""
Await a mapped value then store (AWAIT_MAPPED reaction entry / legacy name).
Value is already Await-resolved — do not Await again.
"""
def _vm_from_async_store_mapped(
    vm: VM, result_p: JSValue, out_a: JSValue, idx: int, iter: JSValue, val: JSValue
) {
    _vm_from_async_finish_store(vm, result_p, out_a, idx, iter, val);
}

"""
Process one source value: Await input unless @@asyncIterator mode, then map/store.
"""
def _vm_from_async_store_awaited(
    vm: VM, result_p: JSValue, out_a: JSValue, idx: int, iter: JSValue, val: JSValue
) -> None {
    # @@asyncIterator path: input values are not Await'ed (test262 does-not-await-input).
    if js_object_has_own(result_p, _KEY_FROM_ASYNC_ASYNC_MODE) {
        _vm_from_async_after_input(vm, result_p, out_a, idx, iter, val);
        return;
    }
    _vm_from_async_await_value(vm, result_p, idx, iter, val, False);
}

"""Call iterator [[NextMethod]] (cached) / delegate and schedule continuation."""
def _vm_from_async_iter_next(vm: VM, result_p: JSValue) -> None {
    if not js_is_promise(result_p)
        or js_promise_get_state(result_p) != PROMISE_PENDING {
        return;
    }
    iter: JSValue = js_object_get(result_p, _KEY_FROM_ASYNC_ITER);
    step_res: JSValue = js_undefined();
    use_delegate: bool = (
        jsv_is_object_cell(iter)
        and (
            js_object_has_own(iter, WK_CUSTOM)
            or js_object_has_own(iter, WK_GEN)
            or js_object_has_own(iter, WK_I)
        )
    );
    if js_object_has_own(result_p, _KEY_FROM_ASYNC_NEXT) {
        next_fn: JSValue = js_object_get(result_p, _KEY_FROM_ASYNC_NEXT);
        if not vm._value_is_callable(next_fn) {
            _vm_from_async_reject(
                vm,
                result_p,
                make_type_error("Iterator result .next method is not callable")
            );
            return;
        }
        step_res = _vm_invoke_callback(vm, next_fn, iter, []);
        if _vm_bridge_vm_exc(vm) {
            if vm.had_exception {
                exc_c: JSValue = vm.pending_exc;
                vm.had_exception = False;
                vm.pending_exc = js_undefined();
                _vm_from_async_reject(vm, result_p, exc_c);
            } elif vm_has_native_exc() {
                _vm_from_async_reject(vm, result_p, vm_take_native_exc());
            }
            return;
        }
    } elif use_delegate {
        step_res = _vm_iter_next_delegate(vm, iter);
        if vm.had_exception {
            exc_d: JSValue = vm.pending_exc;
            vm.had_exception = False;
            vm.pending_exc = js_undefined();
            _vm_from_async_reject(vm, result_p, exc_d);
            return;
        }
        if vm_has_native_exc() {
            _vm_from_async_reject(vm, result_p, vm_take_native_exc());
            return;
        }
    } else {
        _vm_from_async_reject(
            vm,
            result_p,
            make_type_error("Iterator result .next method is not callable")
        );
        return;
    }
    # Await(IteratorStep(...)): always continue via a promise job so sync
    # iterators (CreateAsyncFromSyncIterator / Array @@iterator) yield to the
    # microtask queue between steps — live length mutations are observable.
    on_cont: JSValue = js_object_create_null();
    js_object_set(on_cont, _KEY_FROM_ASYNC_CONTINUE, js_true());
    js_object_set(on_cont, _KEY_FROM_ASYNC_RESULT, result_p);
    if js_is_promise(step_res) {
        sst: int = js_promise_get_state(step_res);
        if sst == PROMISE_PENDING {
            js_promise_add_reaction(step_res, on_cont, on_cont, js_undefined());
            return;
        }
        if sst == PROMISE_REJECTED {
            _vm_from_async_reject(vm, result_p, js_promise_get_value(step_res));
            return;
        }
        # Already fulfilled — still enqueue (Await never continues synchronously).
        scheduler_push_reaction(
            vm.realm,
            on_cont,
            on_cont,
            PROMISE_FULFILLED,
            js_promise_get_value(step_res),
            js_undefined()
        );
        return;
    }
    scheduler_push_reaction(
        vm.realm, on_cont, on_cont, PROMISE_FULFILLED, step_res, js_undefined()
    );
}

"""Sequentially await/sync-resolve array-like elements into out_a (snapshotted length)."""
def _vm_from_async_await_index(
    vm: VM, result_p: JSValue, items: JSValue, i: int, n: int
) -> None {
    if not js_is_promise(result_p)
        or js_promise_get_state(result_p) != PROMISE_PENDING {
        return;
    }
    if i >= n {
        out_a: JSValue = js_object_get(result_p, _KEY_FROM_ASYNC_OUT);
        if not _set_named_or_throw(out_a, KEY_LENGTH, js_number(float(i))) {
            return;
        }
        _vm_from_async_fulfill(vm, result_p, out_a);
        return;
    }
    out_a: JSValue = js_object_get(result_p, _KEY_FROM_ASYNC_OUT);
    pk: int = str_intern_index(i);
    # Use vm.obs_get — reactions run without native-obs stack; get_observable
    # would skip accessors (arraylike-promise / propertyBagObserver).
    elem: JSValue = vm.obs_get(items, pk, items);
    if vm_has_native_exc() or vm.had_exception {
        cap_gi: list[JSValue] = _vm_capture_any_exc(vm);
        if jsv_to_bool(cap_gi[0]) {
            _vm_from_async_reject(vm, result_p, cap_gi[1]);
        }
        return;
    }
    _vm_from_async_store_awaited(vm, result_p, out_a, i, items, elem);
}

"""
Array.fromAsync(asyncItems [, mapfn [, thisArg]]) — §23.1.2.1.
Returns a Promise; rejects on abrupt completions.
Arrays use the sync @@iterator path (live length / IteratorClose), not a frozen
indexed snapshot. IteratorRecord [[NextMethod]] is cached once via bind.
"""
def _vm_array_from_async(vm: VM, this_val: JSValue, args: list[JSValue]) -> JSValue {
    result_p: JSValue = js_promise_create();
    items: JSValue = js_undefined();
    if len(args) > 0 {
        items = args[0];
    }
    if jsv_is_null(items) or jsv_is_undefined(items) {
        tn_fa: str = "undefined";
        if jsv_is_null(items) {
            tn_fa = "null";
        }
        js_promise_settle(
            result_p,
            PROMISE_REJECTED,
            make_type_error("Cannot convert " + tn_fa + " to object")
        );
        return result_p;
    }
    # §23.1.3.1: ToObject(asyncItems) — primitives box to Number/Boolean/Symbol/
    # BigInt. mapfn/thisArg validation + stashing happens just below (shared).
    if not jsv_is_any_object(items) {
        items = _to_object_or_throw(items);
        cap_to: list[JSValue] = _vm_capture_any_exc(vm);
        if jsv_to_bool(cap_to[0]) {
            js_promise_settle(result_p, PROMISE_REJECTED, cap_to[1]);
            return result_p;
        }
    }
    map_fn: JSValue = js_undefined();
    map_this: JSValue = js_undefined();
    if len(args) >= 2 {
        map_fn = args[1];
        if not jsv_is_undefined(map_fn) and not vm._value_is_callable(map_fn) {
            js_promise_settle(
                result_p,
                PROMISE_REJECTED,
                make_type_error("Array.fromAsync mapFn must be callable")
            );
            return result_p;
        }
    }
    if len(args) >= 3 {
        map_this = args[2];
    }
    js_object_set(result_p, _KEY_FROM_ASYNC_THIS, this_val);
    js_object_set(result_p, _KEY_FROM_ASYNC_MAPFN, map_fn);
    js_object_set(result_p, _KEY_FROM_ASYNC_MAP_THIS, map_this);

    async_key: int = SYMBOL_KEY_BASE + SYMBOL_ASYNC_ITERATOR;
    async_fn: JSValue = js_undefined();
    if jsv_is_object_cell(items) {
        async_fn = vm.obs_get(items, async_key, items);
        if vm_has_native_exc() {
            if vm.had_exception {
                exc_g: JSValue = vm.pending_exc;
                vm.had_exception = False;
                vm.pending_exc = js_undefined();
                js_promise_settle(result_p, PROMISE_REJECTED, exc_g);
            }
            return result_p;
        }
    }
    # §23.1.3.1 GetMethod: undefined/null → no method; a present-but-non-callable
    # @@asyncIterator is a TypeError (not a silent fall-through to sync-iterable).
    if (
        not jsv_is_undefined(async_fn)
        and not jsv_is_null(async_fn)
        and not vm._value_is_callable(async_fn)
    ) {
        js_promise_settle(
            result_p,
            PROMISE_REJECTED,
            make_type_error("Property `Symbol.asyncIterator` is not callable")
        );
        return result_p;
    }
    if vm._value_is_callable(async_fn) {
        raw_iter: JSValue = _vm_invoke_callback(vm, async_fn, items, []);
        if _vm_bridge_vm_exc(vm) or vm_has_native_exc() {
            if vm.had_exception {
                exc_i: JSValue = vm.pending_exc;
                vm.had_exception = False;
                vm.pending_exc = js_undefined();
                js_promise_settle(result_p, PROMISE_REJECTED, exc_i);
            } elif vm_has_native_exc() {
                js_promise_settle(result_p, PROMISE_REJECTED, vm_take_native_exc());
            }
            return result_p;
        }
        out_it: JSValue = js_undefined();
        if _vm_is_constructor(vm, this_val) {
            out_it = _vm_construct(vm, this_val, [], this_val);
        } else {
            out_it = js_array_create_with_length(0);
        }
        if vm_has_native_exc() {
            js_promise_settle(result_p, PROMISE_REJECTED, vm_take_native_exc());
            return result_p;
        }
        js_object_set(result_p, _KEY_FROM_ASYNC_OUT, out_it);
        js_object_set(result_p, _KEY_FROM_ASYNC_IDX, js_int(0));
        # @@asyncIterator: do not Await yielded input values.
        js_object_set(result_p, _KEY_FROM_ASYNC_ASYNC_MODE, js_true());
        if not _vm_from_async_bind_iterator(vm, result_p, raw_iter) {
            return result_p;
        }
        _vm_from_async_iter_next(vm, result_p);
        return result_p;
    }

    # Sync @@iterator — CreateAsyncFromSyncIterator walk (§23.1.3.1): each element
    # is awaited then mapped, rather than eagerly materialized via Array.from
    # (which would map unawaited values and let a sync mapfn throw escape).
    sync_iter: JSValue = js_undefined();
    if jsv_is_string_cell(items) {
        sync_iter = _vm_materialize_delegate_iter(vm, items, False);
        if vm.had_exception {
            exc_str: JSValue = vm.pending_exc;
            vm.had_exception = False;
            vm.pending_exc = js_undefined();
            js_promise_settle(result_p, PROMISE_REJECTED, exc_str);
            return result_p;
        }
        if vm_has_native_exc() {
            return result_p;
        }
    } elif jsv_is_object_cell(items) and js_is_generator(items) {
        sync_iter = items;
    } elif jsv_is_object_cell(items) {
        sym_iter_key: int = SYMBOL_KEY_BASE + SYMBOL_ITERATOR;
        sync_iter_fn: JSValue = vm.obs_get(items, sym_iter_key, items);
        if vm_has_native_exc() {
            if vm.had_exception {
                exc_gi: JSValue = vm.pending_exc;
                vm.had_exception = False;
                vm.pending_exc = js_undefined();
                js_promise_settle(result_p, PROMISE_REJECTED, exc_gi);
            }
            return result_p;
        }
        # GetMethod: nullish → fall through to array-like; else non-callable → TypeError.
        if (
            not jsv_is_undefined(sync_iter_fn)
            and not jsv_is_null(sync_iter_fn)
            and not vm._value_is_callable(sync_iter_fn)
        ) {
            js_promise_settle(
                result_p,
                PROMISE_REJECTED,
                make_type_error("Property `Symbol.iterator` is not callable")
            );
            return result_p;
        }
        if vm._value_is_callable(sync_iter_fn) {
            raw_sync: JSValue = _vm_invoke_callback(vm, sync_iter_fn, items, []);
            if _vm_bridge_vm_exc(vm) or vm_has_native_exc() {
                if vm.had_exception {
                    exc_si: JSValue = vm.pending_exc;
                    vm.had_exception = False;
                    vm.pending_exc = js_undefined();
                    js_promise_settle(result_p, PROMISE_REJECTED, exc_si);
                }
                return result_p;
            }
            # Prefer binding the raw sync iterator (cache its [[NextMethod]]).
            # Only normalize into a WK_* shell when the raw object is already one.
            if (
                js_is_generator(raw_sync)
                or (
                    jsv_is_object_cell(raw_sync)
                    and (
                        js_object_has_own(raw_sync, WK_CUSTOM)
                        or (
                            js_object_has_own(raw_sync, WK_I)
                            and js_object_has_own(raw_sync, WK_J)
                        )
                    )
                )
            ) {
                sync_iter = _vm_normalize_iterator(vm, raw_sync);
                if _vm_bridge_vm_exc(vm) or vm_has_native_exc() {
                    if vm.had_exception {
                        exc_ni: JSValue = vm.pending_exc;
                        vm.had_exception = False;
                        vm.pending_exc = js_undefined();
                        js_promise_settle(result_p, PROMISE_REJECTED, exc_ni);
                    }
                    return result_p;
                }
            } else {
                sync_iter = raw_sync;
            }
        }
    }
    if jsv_is_object_cell(sync_iter) and jsv_to_table_id(sync_iter) > 0 {
        out_sync: JSValue = js_undefined();
        if _vm_is_constructor(vm, this_val) {
            out_sync = _vm_construct(vm, this_val, [], this_val);
        } else {
            out_sync = js_array_create_with_length(0);
        }
        if vm_has_native_exc() {
            return result_p;
        }
        js_object_set(result_p, _KEY_FROM_ASYNC_OUT, out_sync);
        js_object_set(result_p, _KEY_FROM_ASYNC_IDX, js_int(0));
        if not _vm_from_async_bind_iterator(vm, result_p, sync_iter) {
            return result_p;
        }
        _vm_from_async_iter_next(vm, result_p);
        return result_p;
    }
    # Array-like fallback (§23.1.3.1): LengthOfArrayLike once, then Await each
    # element. Spec order: len → Construct/ArrayCreate(len) → indexed Get/Await
    # loop. obs_get for length so accessors throw into the promise, not sync.
    use_ctor_al: bool = _vm_is_constructor(vm, this_val);
    len_key_al: int = KEY_LENGTH;
    lv_al: JSValue = vm.obs_get(items, len_key_al, items);
    cap_len: list[JSValue] = _vm_capture_any_exc(vm);
    if jsv_to_bool(cap_len[0]) {
        vm._promise_settle_and_drain(result_p, PROMISE_REJECTED, cap_len[1]);
        return result_p;
    }
    # ToIntegerOrInfinity as float first — check ArrayCreate limit before int cast
    # so lengths like 2^32 are not silently truncated.
    f_al: float = _to_integer_or_infinity(lv_al);
    cap_toi: list[JSValue] = _vm_capture_any_exc(vm);
    if jsv_to_bool(cap_toi[0]) {
        vm._promise_settle_and_drain(result_p, PROMISE_REJECTED, cap_toi[1]);
        return result_p;
    }
    if not use_ctor_al and f_al > 4294967295.0 {
        # ArrayCreate(len): RangeError for len > 2^32-1 (asyncitems-arraylike-too-long).
        vm._promise_settle_and_drain(
            result_p, PROMISE_REJECTED, make_range_error("Invalid array length")
        );
        return result_p;
    }
    n_al: int = 0;
    if f_al > 0.0 {
        max_len_al: float = 9007199254740991.0;
        if f_al > max_len_al {
            f_al = max_len_al;
        }
        n_al = int(f_al);
    }
    out_al: JSValue = js_undefined();
    if use_ctor_al {
        out_al = _vm_construct(vm, this_val, [], this_val);
    } else {
        out_al = js_array_create_with_length(0);
    }
    cap_out: list[JSValue] = _vm_capture_any_exc(vm);
    if jsv_to_bool(cap_out[0]) {
        vm._promise_settle_and_drain(result_p, PROMISE_REJECTED, cap_out[1]);
        return result_p;
    }
    js_object_set(result_p, _KEY_FROM_ASYNC_OUT, out_al);
    js_object_set(result_p, _KEY_FROM_ASYNC_SOURCE, items);
    js_object_set(result_p, _KEY_FROM_ASYNC_LEN, js_number(float(n_al)));
    _vm_from_async_await_index(vm, result_p, items, 0, n_al);
    return result_p;
}

"""CreateDataProperty(array, idx, val) on a dense, extensible, shape-mode Array
(V4.16): a present element is overwritten (dense elements are default-attribute
data), the next index appended — `length` grown when idx reaches it and is
writable. What js_object_define_property's dense branch plus
_array_grow_length_if_needed do, without the descriptor reads. False →
the generic path (nothing done)."""
def _vm_cdp_dense(o: JSValue, idx: int, val: JSValue) -> bool {
    if idx < 0 or not jsv_is_object_cell(o) or not js_is_array(o) {
        return False;
    }
    cd_id: int = jsv_to_table_id(o);
    if cd_id <= 0 or js_object_elems_kind_id(cd_id) == ELEMS_NONE {
        return False;
    }
    cd_o: JSObject = js_object_table_get(cd_id);
    # a prototype array keeps the full path (proto epoch, index protector)
    if (cd_o.cell_flags & FLAG_IS_PROTO) != 0 {
        return False;
    }
    cd_n: int = len(cd_o.elems_ro());
    if idx < cd_n {
        if jsv_is_hole(cd_o.elems_ro()[idx]) {
            return False;
        }
        cd_o.elems_rw()[idx] = val;
        return True;
    }
    if idx != cd_n or not cd_o.is_ext() or cd_o.mode != MAP_MODE_SHAPE {
        return False;
    }
    cd_pk: int = shape_lookup(cd_o.shape_id, KEY_LENGTH);
    if cd_pk < 0 or (cd_pk & SHAPE_ATTR_ACCESSOR) != 0 {
        return False;
    }
    cd_lv: JSValue = cd_o.slots[cd_pk // 16];
    if not jsv_is_int32(cd_lv) {
        return False;
    }
    if idx < jsv_to_int32(cd_lv) {
        cd_o.elems_rw().append(val);
        return True;
    }
    if (cd_pk & PROP_WRITABLE) == 0 or idx >= 2147483647 {
        return False;
    }
    cd_o.elems_rw().append(val);
    cd_o.slots[cd_pk // 16] = js_int(idx + 1);
    return True;
}

"""ArraySpeciesCreate is ArrayCreate for `original` (V4.16): an Array with
%Array.prototype% as [[Prototype]], no own `constructor`, whose inherited
`constructor` is still the realm's %Array% (an own data property of
%Array.prototype%) and whose %Array%[@@species] is still the intrinsic
getter (it returns `this`). Lookups only — no getter runs."""
def _vm_array_species_is_default(vm: VM, original: JSValue) -> bool {
    if not jsv_is_object_cell(original)
        or not js_is_array(original)
        or js_is_proxy(original) {
        return False;
    }
    sd_id: int = jsv_to_table_id(original);
    sd_ap: JSValue = js_array_get_proto();
    if sd_id <= 0 or not jsv_is_object_cell(sd_ap) {
        return False;
    }
    if js_object_proto_idx_id(sd_id) != jsv_to_table_id(sd_ap) {
        return False;
    }
    if js_object_has_own(original, WK_CONSTRUCTOR) {
        return False;
    }
    sd_ctor: JSValue = js_object_table_get(jsv_to_table_id(sd_ap)).get_own_data_or_hole(
        WK_CONSTRUCTOR
    );
    if jsv_is_hole(sd_ctor) or not (sd_ctor == vm.realm.intrinsics.array_ctor) {
        return False;
    }
    if js_object_has_own_accessor(sd_ap, WK_CONSTRUCTOR) {
        return False;
    }
    if not jsv_is_object_cell(sd_ctor) {
        return False;
    }
    sd_sg: JSValue = js_object_get_own_accessor_getter(
        sd_ctor, SYMBOL_KEY_BASE + SYMBOL_SPECIES
    );
    return is_native_val(sd_sg)
        and get_native_kind(sd_sg) == NATIVE_KIND_ARRAY_SPECIES_GET;
}

"""
ArraySpeciesCreate(originalArray, length) — §23.1.2.5.
Includes cross-realm demotion of foreign %Array% (R13 / $262.createRealm).
"""
def _vm_array_species_create(vm: VM, original: JSValue, length: int) -> JSValue {
    len_: int = length;
    if len_ < 0 {
        len_ = 0;
    }
    is_arr: bool = _vm_is_array(original);
    if vm_has_native_exc() {
        return js_undefined();
    }
    if not is_arr or _vm_array_species_is_default(vm, original) {
        if not _array_create_len_ok(len_) {
            return js_undefined();
        }
        return js_array_create_with_length(len_);
    }
    c_val: JSValue = vm.obs_get(original, str_intern("constructor"), original);
    if vm_has_native_exc() {
        return js_undefined();
    }
    # §9.4.2.3 step 5-6: cross-realm demotion before @@species
    if _vm_is_constructor(vm, c_val) {
        realm_c: Realm = _vm_get_function_realm(vm, c_val);
        if realm_c.realm_id != vm.realm.realm_id {
            if js_strict_equal(c_val, realm_c.intrinsics.array_ctor) {
                c_val = js_undefined();
            }
        }
    }
    if not jsv_is_undefined(c_val) {
        if jsv_is_object_cell(c_val)
            or is_fn_val(c_val)
            or is_native_val(c_val)
            or js_is_proxy(c_val) {
            sp_key: int = SYMBOL_KEY_BASE + SYMBOL_SPECIES;
            c_val = vm.obs_get(c_val, sp_key, c_val);
            if vm_has_native_exc() {
                return js_undefined();
            }
            if jsv_is_null(c_val) {
                c_val = js_undefined();
            }
        }
    }
    if jsv_is_undefined(c_val) {
        if not _array_create_len_ok(len_) {
            return js_undefined();
        }
        return js_array_create_with_length(len_);
    }
    if not _vm_is_constructor(vm, c_val) {
        vm_throw_native(make_type_error("Symbol.species is not a constructor"));
        return js_undefined();
    }
    if not _array_create_len_ok(len_) {
        return js_undefined();
    }
    return _vm_construct(vm, c_val, [js_int(len_)], c_val);
}

"""IsConcatSpreadable(O) — §23.1.3.1.1."""
def _vm_is_concat_spreadable(vm: VM, o: JSValue) -> bool {
    # Type(O) is not Object → false (primitives, null, undefined).
    if jsv_is_null(o) or jsv_is_undefined(o) {
        return False;
    }
    if jsv_is_bool(o) or jsv_is_int32(o) or jsv_is_double(o) {
        return False;
    }
    if jsv_is_string_cell(o) or jsv_is_symbol(o) {
        return False;
    }
    cs_key: int = SYMBOL_KEY_BASE + SYMBOL_ISOONCATSPREADABLE;
    cs_v: JSValue = vm.obs_get(o, cs_key, o);
    if vm_has_native_exc() {
        return False;
    }
    if not jsv_is_undefined(cs_v) {
        return jsv_coerce_to_bool(cs_v);
    }
    return _vm_is_array(o);
}

"""Array.prototype.concat — §23.1.3.1 (VM-threaded for ArraySpeciesCreate)."""
def _vm_array_concat(vm: VM, this_val: JSValue, items: list[JSValue]) -> JSValue {
    o: JSValue = _vm_array_to_object(this_val);
    if vm_has_native_exc() {
        return js_undefined();
    }
    a: JSValue = _vm_array_species_create(vm, o, 0);
    # Result lives only here while @@isConcatSpreadable / element getters re-enter.
    if len(vm.frames) > 0 {
        vm.frames[len(vm.frames) - 1].native_roots.append(a);
    }
    vm.frames[len(vm.frames) - 1].rare = True;
    if vm_has_native_exc() {
        return js_undefined();
    }
    n: int = 0;
    max_safe: int = 9007199254740991;
    all_items: list[JSValue] = [o] + items;
    for e in all_items {
        spreadable: bool = _vm_is_concat_spreadable(vm, e);
        if vm_has_native_exc() {
            return js_undefined();
        }
        if spreadable {
            e_len: int = _length_of(e);
            if vm_has_native_exc() {
                return js_undefined();
            }
            # Fail fast on absurd spread lengths (typed-array / array-like) before
            # attempting a multi-billion-element copy loop.
            if e_len > 4294967295 or n + e_len > max_safe {
                vm_throw_native(make_type_error("Array length exceeds 2^53 - 1"));
                return js_undefined();
            }
            k: int = 0;
            while k < e_len {
                cc_d: JSValue = js_object_dense_elem(e, k);
                if not jsv_is_hole(cc_d) {
                    if not _vm_create_data_property_or_throw(vm, a, n, cc_d) {
                        return js_undefined();
                    }
                    n = n + 1;
                    k = k + 1;
                    continue;
                }
                pk: int = str_intern_index(k);
                if js_object_has_observable(e, pk) {
                    if vm_has_native_exc() {
                        return js_undefined();
                    }
                    ev: JSValue = js_object_get_observable(e, pk, e);
                    if vm_has_native_exc() {
                        return js_undefined();
                    }
                    if not _vm_create_data_property_or_throw(vm, a, n, ev) {
                        return js_undefined();
                    }
                } else {
                    if vm_has_native_exc() {
                        return js_undefined();
                    }
                }
                n = n + 1;
                k = k + 1;
            }
        } else {
            if n + 1 > max_safe {
                vm_throw_native(make_type_error("Array length exceeds 2^53 - 1"));
                return js_undefined();
            }
            if not _vm_create_data_property_or_throw(vm, a, n, e) {
                return js_undefined();
            }
            n = n + 1;
        }
    }
    # Set(A, "length", n, true)
    ok_len: bool = js_object_set_observable(a, KEY_LENGTH, js_int(n), a);
    if vm_has_native_exc() {
        return js_undefined();
    }
    if not ok_len {
        vm_throw_native(make_type_error("Cannot assign to property"));
        return js_undefined();
    }
    return a;
}

"""Array.prototype.slice — §23.1.3.27 (VM-threaded for ArraySpeciesCreate)."""
def _vm_array_slice(
    vm: VM, this_val: JSValue, start_v: JSValue, end_v: JSValue
) -> JSValue {
    o: JSValue = _vm_array_to_object(this_val);
    if vm_has_native_exc() {
        return js_undefined();
    }
    len_: int = _length_of(o);
    if vm_has_native_exc() {
        return js_undefined();
    }
    k: int = _clamp_float(_to_integer_or_infinity(start_v), len_);
    if vm_has_native_exc() {
        return js_undefined();
    }
    final: int = len_;
    if not jsv_is_undefined(end_v) {
        final = _clamp_float(_to_integer_or_infinity(end_v), len_);
        if vm_has_native_exc() {
            return js_undefined();
        }
    }
    count: int = final - k;
    if count < 0 {
        count = 0;
    }
    a: JSValue = _vm_array_species_create(vm, o, count);
    if vm_has_native_exc() {
        return js_undefined();
    }
    n: int = 0;
    while k < final {
        # a present dense element (V4.16): HasProperty true, Get = the element
        sl_d: JSValue = js_object_dense_elem(o, k);
        if not jsv_is_hole(sl_d) {
            if not _vm_create_data_property_or_throw(vm, a, n, sl_d) {
                return js_undefined();
            }
            k = k + 1;
            n = n + 1;
            continue;
        }
        pk: int = str_intern_index(k);
        if js_object_has_observable(o, pk) {
            if vm_has_native_exc() {
                return js_undefined();
            }
            kv: JSValue = js_object_get_observable(o, pk, o);
            if vm_has_native_exc() {
                return js_undefined();
            }
            if not _vm_create_data_property_or_throw(vm, a, n, kv) {
                return js_undefined();
            }
        } else {
            if vm_has_native_exc() {
                return js_undefined();
            }
        }
        k = k + 1;
        n = n + 1;
    }
    ok_len: bool = js_object_set_observable(a, KEY_LENGTH, js_int(n), a);
    if vm_has_native_exc() {
        return js_undefined();
    }
    if not ok_len {
        vm_throw_native(make_type_error("Cannot assign to property"));
        return js_undefined();
    }
    return a;
}

"""Set(O, \"length\", n, true) — throw if rejected (RangeError for invalid array length)."""
def _vm_set_length_or_throw(o: JSValue, n: int) -> bool {
    if js_is_array(o) {
        rc: int = js_array_set_length_via_set(o, js_array_len_value(n));
        if vm_has_native_exc() {
            return False;
        }
        if rc != 0 {
            if not vm_has_native_exc() {
                vm_throw_native(
                    make_type_error("Cannot assign to read only property 'length'")
                );
            }
            return False;
        }
        return True;
    }
    ok: bool = js_object_set_observable(o, KEY_LENGTH, js_array_len_value(n), o);
    if vm_has_native_exc() {
        return False;
    }
    if not ok {
        vm_throw_native(make_type_error("Cannot assign to property"));
        return False;
    }
    return True;
}

"""
FlattenIntoArray(target, source, sourceLen, start, depth [, mapper, thisArg])
— ECMAScript §23.1.3.13.1.
Returns the next target index, or -1 on abrupt completion (exception set).
mapper = undefined means no mapperFunction (flat / recursive calls).
depth uses a large int for +Infinity (practical nesting bound).
"""
def _vm_flatten_into_array(
    vm: VM,
    target: JSValue,
    source: JSValue,
    source_len: int,
    start: int,
    depth: int,
    mapper: JSValue,
    this_arg: JSValue
) -> int {
    target_index: int = start;
    source_index: int = 0;
    max_safe: int = 9007199254740991;
    while source_index < source_len {
        pk: int = str_intern_index(source_index);
        exists: bool = js_object_has_observable(source, pk);
        if vm_has_native_exc() {
            return -1;
        }
        if exists {
            element: JSValue = js_object_get_observable(source, pk, source);
            if vm_has_native_exc() {
                return -1;
            }
            if not jsv_is_undefined(mapper) {
                element = _vm_invoke_callback(
                    vm, mapper, this_arg, [element, js_int(source_index), source]
                );
                if vm.had_exception {
                    return -1;
                }
                if vm_has_native_exc() {
                    return -1;
                }
            }
            should_flatten: bool = False;
            if depth > 0 {
                should_flatten = _vm_is_array(element);
                if vm_has_native_exc() {
                    return -1;
                }
            }
            if should_flatten {
                elem_len: int = _length_of(element);
                if vm_has_native_exc() {
                    return -1;
                }
                next_depth: int = depth - 1;
                target_index = _vm_flatten_into_array(
                    vm,
                    target,
                    element,
                    elem_len,
                    target_index,
                    next_depth,
                    js_undefined(),
                    js_undefined()
                );
                if target_index < 0 {
                    return -1;
                }
            } else {
                if target_index >= max_safe {
                    vm_throw_native(make_type_error("Array length exceeds 2^53 - 1"));
                    return -1;
                }
                if not _vm_create_data_property_or_throw(
                    vm, target, target_index, element
                ) {
                    return -1;
                }
                target_index = target_index + 1;
            }
        }
        source_index = source_index + 1;
    }
    return target_index;
}

"""Array.prototype.flat(depth?) — §23.1.3.9 (VM-threaded for species)."""
def _vm_array_flat(vm: VM, this_val: JSValue, depth_v: JSValue) -> JSValue {
    o: JSValue = _vm_array_to_object(this_val);
    if vm_has_native_exc() {
        return js_undefined();
    }
    source_len: int = _length_of(o);
    if vm_has_native_exc() {
        return js_undefined();
    }
    depth_num: int = 1;
    if not jsv_is_undefined(depth_v) {
        depth_f: float = _to_integer_or_infinity(depth_v);
        if vm_has_native_exc() {
            return js_undefined();
        }
        if depth_f < 0.0 {
            depth_num = 0;
        } elif depth_f == MATH_INF {
            # Practical stand-in for +Infinity (spec: Infinity - 1 = Infinity).
            depth_num = 1073741824;
        } else {
            depth_num = int(depth_f);
        }
    }
    a: JSValue = _vm_array_species_create(vm, o, 0);
    if vm_has_native_exc() {
        return js_undefined();
    }
    _ = _vm_flatten_into_array(
        vm, a, o, source_len, 0, depth_num, js_undefined(), js_undefined()
    );
    if vm_has_native_exc() {
        return js_undefined();
    }
    if vm.had_exception {
        exc_fl: JSValue = vm.pending_exc;
        vm.had_exception = False;
        vm.pending_exc = js_undefined();
        vm_throw_native(exc_fl);
        return js_undefined();
    }
    return a;
}

"""Array.prototype.splice — §23.1.3.31 (VM-threaded for species + observables)."""
def _vm_array_splice(
    vm: VM,
    this_val: JSValue,
    start_v: JSValue,
    dc_v: JSValue,
    items: list[JSValue],
    start_present: bool,
    dc_provided: bool
) -> JSValue {
    o: JSValue = _vm_array_to_object(this_val);
    if vm_has_native_exc() {
        return js_undefined();
    }
    len_: int = _length_of(o);
    if vm_has_native_exc() {
        return js_undefined();
    }
    relative_start: float = _to_integer_or_infinity(start_v);
    if vm_has_native_exc() {
        return js_undefined();
    }
    actual_start: int = _clamp_float(relative_start, len_);
    insert_count: int = len(items);
    actual_delete_count: int = 0;
    if not start_present {
        actual_delete_count = 0;
    } elif not dc_provided {
        actual_delete_count = len_ - actual_start;
    } else {
        dc_f: float = _to_integer_or_infinity(dc_v);
        if vm_has_native_exc() {
            return js_undefined();
        }
        if dc_f < 0.0 {
            actual_delete_count = 0;
        } else {
            actual_delete_count = int(dc_f);
            max_dc: int = len_ - actual_start;
            if actual_delete_count > max_dc {
                actual_delete_count = max_dc;
            }
        }
    }
    max_safe: int = 9007199254740991;
    if len_ - actual_delete_count + insert_count > max_safe {
        vm_throw_native(make_type_error("Array length exceeds 2^53 - 1"));
        return js_undefined();
    }
    a: JSValue = _vm_array_species_create(vm, o, actual_delete_count);
    if vm_has_native_exc() {
        return js_undefined();
    }
    k: int = 0;
    while k < actual_delete_count {
        from_key: int = str_intern(str(actual_start + k));
        if js_object_has_observable(o, from_key) {
            if vm_has_native_exc() {
                return js_undefined();
            }
            from_val: JSValue = js_object_get_observable(o, from_key, o);
            if vm_has_native_exc() {
                return js_undefined();
            }
            if not _vm_create_data_property_or_throw(vm, a, k, from_val) {
                return js_undefined();
            }
        } else {
            if vm_has_native_exc() {
                return js_undefined();
            }
        }
        k = k + 1;
    }
    ok_alen: bool = js_object_set_observable(
        a, KEY_LENGTH, js_array_len_value(actual_delete_count), a
    );
    if vm_has_native_exc() {
        return js_undefined();
    }
    if not ok_alen {
        vm_throw_native(make_type_error("Cannot assign to property"));
        return js_undefined();
    }
    item_count: int = insert_count;
    if item_count < actual_delete_count {
        k = actual_start;
        while k < (len_ - actual_delete_count) {
            from_k: int = str_intern(str(k + actual_delete_count));
            to_idx: int = k + item_count;
            to_k: int = str_intern_index(to_idx);
            if js_object_has_observable(o, from_k) {
                if vm_has_native_exc() {
                    return js_undefined();
                }
                from_val2: JSValue = js_object_get_observable(o, from_k, o);
                if vm_has_native_exc() {
                    return js_undefined();
                }
                if not _set_or_throw(o, to_idx, from_val2) {
                    return js_undefined();
                }
            } else {
                if vm_has_native_exc() {
                    return js_undefined();
                }
                if not _delete_or_throw(o, to_k) {
                    return js_undefined();
                }
            }
            k = k + 1;
        }
        k = len_;
        while k > (len_ - actual_delete_count + item_count) {
            if not _delete_or_throw(o, str_intern(str(k - 1))) {
                return js_undefined();
            }
            k = k - 1;
        }
    } elif item_count > actual_delete_count {
        k = len_ - actual_delete_count;
        while k > actual_start {
            from_k2: int = str_intern(str(k + actual_delete_count - 1));
            to_idx2: int = k + item_count - 1;
            to_k2: int = str_intern_index(to_idx2);
            if js_object_has_observable(o, from_k2) {
                if vm_has_native_exc() {
                    return js_undefined();
                }
                from_val3: JSValue = js_object_get_observable(o, from_k2, o);
                if vm_has_native_exc() {
                    return js_undefined();
                }
                if not _set_or_throw(o, to_idx2, from_val3) {
                    return js_undefined();
                }
            } else {
                if vm_has_native_exc() {
                    return js_undefined();
                }
                if not _delete_or_throw(o, to_k2) {
                    return js_undefined();
                }
            }
            k = k - 1;
        }
    }
    k = actual_start;
    for e_item in items {
        if not _set_or_throw(o, k, e_item) {
            return js_undefined();
        }
        k = k + 1;
    }
    new_len: int = len_ - actual_delete_count + item_count;
    if not _vm_set_length_or_throw(o, new_len) {
        return js_undefined();
    }
    return a;
}

"""Array.prototype.push(...items) — §23.1.3.23 (VM-threaded throw semantics)."""
def _vm_array_push(vm: VM, this_val: JSValue, items: list[JSValue]) -> JSValue {
    o: JSValue = _vm_array_to_object(this_val);
    if vm_has_native_exc() {
        return js_undefined();
    }
    # Dense fast arm — same conditions as the SET_INDEX append arm; appends at
    # length == dense end are pure list appends + one length-slot write.
    # NOTE: valid under an active obs scope too — obs interception exists to
    # route accessor/proxy hits through the VM, and both are structurally
    # impossible here (ordinary dense array, own data element / pure append).
    if jsv_is_object_cell(o) and idx_protector_ok() {
        vp_id: int = jsv_to_table_id(o);
        if vp_id > 0 {
            vp_raw: JSObject = js_object_table_get(vp_id);
            if vp_raw.elems_kind != ELEMS_NONE
                and vp_raw.is_ext()
                and vp_raw.mode == MAP_MODE_SHAPE {
                vp_pk: int = shape_lookup(vp_raw.shape_id, WK_LENGTH);
                if vp_pk >= 0
                    and (vp_pk & SHAPE_ATTR_ACCESSOR) == 0
                    and (vp_pk & 1) != 0 {
                    vp_lv: JSValue = vp_raw.slots[vp_pk // 16];
                    if jsv_is_int32(vp_lv)
                        and jsv_to_int32(vp_lv) == len(vp_raw.elems_ro()) {
                        for vp_itm in items {
                            vp_raw.elems_rw().append(vp_itm);
                        }
                        vp_raw.slots[vp_pk // 16] = js_array_len_value(
                            len(vp_raw.elems_ro())
                        );
                        return js_array_len_value(len(vp_raw.elems_ro()));
                    }
                }
            }
        }
    }
    len_: int = _length_of(o);
    if vm_has_native_exc() {
        return js_undefined();
    }
    arg_count: int = len(items);
    max_safe: int = 9007199254740991;
    if len_ + arg_count > max_safe {
        vm_throw_native(make_type_error("Array length exceeds 2^53 - 1"));
        return js_undefined();
    }
    n: int = len_;
    for itm in items {
        if not _set_or_throw(o, n, itm) {
            return js_undefined();
        }
        n = n + 1;
    }
    if not _vm_set_length_or_throw(o, n) {
        return js_undefined();
    }
    return js_array_len_value(n);
}

"""Array.prototype.pop() — §23.1.3.22 (VM-threaded throw semantics)."""
def _vm_array_pop(vm: VM, this_val: JSValue) -> JSValue {
    o: JSValue = _vm_array_to_object(this_val);
    if vm_has_native_exc() {
        return js_undefined();
    }
    len_: int = _length_of(o);
    if vm_has_native_exc() {
        return js_undefined();
    }
    if len_ == 0 {
        if not _vm_set_length_or_throw(o, 0) {
            return js_undefined();
        }
        return js_undefined();
    }
    new_len: int = len_ - 1;
    element: JSValue = js_object_get_observable(o, str_intern_index(new_len), o);
    if vm_has_native_exc() {
        return js_undefined();
    }
    if not _delete_or_throw(o, str_intern_index(new_len)) {
        return js_undefined();
    }
    if not _vm_set_length_or_throw(o, new_len) {
        return js_undefined();
    }
    return element;
}

"""Array.prototype.shift() — §23.1.3.25 (VM-threaded throw semantics)."""
def _vm_array_shift(vm: VM, this_val: JSValue) -> JSValue {
    o: JSValue = _vm_array_to_object(this_val);
    if vm_has_native_exc() {
        return js_undefined();
    }
    len_: int = _length_of(o);
    if vm_has_native_exc() {
        return js_undefined();
    }
    if len_ == 0 {
        if not _vm_set_length_or_throw(o, 0) {
            return js_undefined();
        }
        return js_undefined();
    }
    first: JSValue = js_object_get_observable(o, str_intern("0"), o);
    if vm_has_native_exc() {
        return js_undefined();
    }
    k: int = 1;
    while k < len_ {
        from_key: int = str_intern_index(k);
        to_idx: int = k - 1;
        to_key: int = str_intern_index(to_idx);
        if js_object_has_observable(o, from_key) {
            if vm_has_native_exc() {
                return js_undefined();
            }
            from_val: JSValue = js_object_get_observable(o, from_key, o);
            if vm_has_native_exc() {
                return js_undefined();
            }
            if not _set_or_throw(o, to_idx, from_val) {
                return js_undefined();
            }
        } else {
            if vm_has_native_exc() {
                return js_undefined();
            }
            if not _delete_or_throw(o, to_key) {
                return js_undefined();
            }
        }
        k = k + 1;
    }
    if not _delete_or_throw(o, str_intern(str(len_ - 1))) {
        return js_undefined();
    }
    if not _vm_set_length_or_throw(o, len_ - 1) {
        return js_undefined();
    }
    return first;
}

"""Array.prototype.unshift(...items) — §23.1.3.32 (VM-threaded throw semantics)."""
def _vm_array_unshift(vm: VM, this_val: JSValue, items: list[JSValue]) -> JSValue {
    o: JSValue = _vm_array_to_object(this_val);
    if vm_has_native_exc() {
        return js_undefined();
    }
    len_: int = _length_of(o);
    if vm_has_native_exc() {
        return js_undefined();
    }
    arg_count: int = len(items);
    max_safe: int = 9007199254740991;
    if arg_count > 0 {
        if len_ + arg_count > max_safe {
            vm_throw_native(make_type_error("Array length exceeds 2^53 - 1"));
            return js_undefined();
        }
        k: int = len_;
        while k > 0 {
            from_key: int = str_intern(str(k - 1));
            to_idx: int = k + arg_count - 1;
            to_key: int = str_intern_index(to_idx);
            if js_object_has_observable(o, from_key) {
                if vm_has_native_exc() {
                    return js_undefined();
                }
                from_val: JSValue = js_object_get_observable(o, from_key, o);
                if vm_has_native_exc() {
                    return js_undefined();
                }
                if not _set_or_throw(o, to_idx, from_val) {
                    return js_undefined();
                }
            } else {
                if vm_has_native_exc() {
                    return js_undefined();
                }
                if not _delete_or_throw(o, to_key) {
                    return js_undefined();
                }
            }
            k = k - 1;
        }
        j: int = 0;
        for itm in items {
            if not _set_or_throw(o, j, itm) {
                return js_undefined();
            }
            j = j + 1;
        }
    }
    new_len: int = len_ + arg_count;
    if not _vm_set_length_or_throw(o, new_len) {
        return js_undefined();
    }
    return js_array_len_value(new_len);
}

"""Array.prototype.reverse() — §23.1.3.24 (VM-threaded throw semantics)."""
def _vm_array_reverse(vm: VM, this_val: JSValue) -> JSValue {
    o: JSValue = _vm_array_to_object(this_val);
    if vm_has_native_exc() {
        return js_undefined();
    }
    len_: int = _length_of(o);
    if vm_has_native_exc() {
        return js_undefined();
    }
    middle: int = len_ // 2;
    lower: int = 0;
    while lower != middle {
        upper: int = len_ - lower - 1;
        lower_key: int = str_intern_index(lower);
        upper_key: int = str_intern_index(upper);
        # Spec order: Has/Get lower, then Has/Get upper (Get may mutate).
        lower_exists: bool = js_object_has_observable(o, lower_key);
        if vm_has_native_exc() {
            return js_undefined();
        }
        lower_val: JSValue = js_undefined();
        if lower_exists {
            lower_val = js_object_get_observable(o, lower_key, o);
            if vm_has_native_exc() {
                return js_undefined();
            }
        }
        upper_exists: bool = js_object_has_observable(o, upper_key);
        if vm_has_native_exc() {
            return js_undefined();
        }
        upper_val: JSValue = js_undefined();
        if upper_exists {
            upper_val = js_object_get_observable(o, upper_key, o);
            if vm_has_native_exc() {
                return js_undefined();
            }
        }
        if lower_exists and upper_exists {
            if not _set_or_throw(o, lower, upper_val) {
                return js_undefined();
            }
            if not _set_or_throw(o, upper, lower_val) {
                return js_undefined();
            }
        } elif not lower_exists and upper_exists {
            if not _set_or_throw(o, lower, upper_val) {
                return js_undefined();
            }
            if not _delete_or_throw(o, upper_key) {
                return js_undefined();
            }
        } elif lower_exists and not upper_exists {
            if not _delete_or_throw(o, lower_key) {
                return js_undefined();
            }
            if not _set_or_throw(o, upper, lower_val) {
                return js_undefined();
            }
        }
        # else: neither exists — no action
        lower = lower + 1;
    }
    return o;
}

"""
ToString(v) with full observable ToPrimitive("string") — invokes object
toString / valueOf / Symbol.toPrimitive. Used by default sort, join, and
toLocaleString (R17). Propagates abrupt completions via vm_throw_native.
"""
def _vm_to_string_observable(vm: VM, v: JSValue) -> str {
    # ToString(Symbol) throws a TypeError (§7.1.17 / §22.2.3.5 note) — a Symbol
    # primitive never coerces to a string implicitly.
    if jsv_is_symbol(v) {
        vm_throw_native(make_type_error("Cannot convert a Symbol value to a string"));
        return "";
    }
    if jsv_is_object_cell(v) or is_fn_val(v) or is_native_val(v) or js_is_proxy(v) {
        prim: JSValue = vm._to_primitive_string(v);
        if vm.had_exception {
            exc_ts: JSValue = vm.pending_exc;
            vm.had_exception = False;
            vm.pending_exc = js_undefined();
            vm_throw_native(exc_ts);
            return "";
        }
        if vm_has_native_exc() {
            return "";
        }
        # ToPrimitive may yield a Symbol (@@toPrimitive/valueOf returning a Symbol);
        # ToString of that Symbol still throws (§7.1.17).
        if jsv_is_symbol(prim) {
            vm_throw_native(
                make_type_error("Cannot convert a Symbol value to a string")
            );
            return "";
        }
        return jsval_to_str(prim);
    }
    return jsval_to_str(v);
}

"""
GetV(receiver, key) — box primitives only for the property lookup; the returned
function is later called with the original (possibly primitive) receiver as this
(ECMAScript Invoke / GetV). R17.
"""
def _vm_lookup_method(vm: VM, receiver: JSValue, key: int) -> JSValue {
    lookup_target: JSValue = receiver;
    if not jsv_is_any_object(receiver) {
        lookup_target = _vm_array_to_object(receiver);
        if vm_has_native_exc() {
            return js_undefined();
        }
    }
    return js_object_get_observable(lookup_target, key, receiver);
}

"""Bridge vm.had_exception from _vm_invoke_callback into the native exc channel."""
def _vm_bridge_invoke_exc(vm: VM) -> bool {
    if vm.had_exception {
        exc_bi: JSValue = vm.pending_exc;
        vm.had_exception = False;
        vm.pending_exc = js_undefined();
        vm_throw_native(exc_bi);
        return True;
    }
    return False;
}

"""
Array.prototype.join(separator?) — §23.1.3.15.
Observable ToString on separator and each non-null/undefined element (R17).
"""
def _vm_array_join(vm: VM, this_val: JSValue, sep_v: JSValue) -> JSValue {
    o: JSValue = _vm_array_to_object(this_val);
    if vm_has_native_exc() {
        return js_undefined();
    }
    n: int = _length_of(o);
    if vm_has_native_exc() {
        return js_undefined();
    }
    sep: str = ",";
    if not jsv_is_undefined(sep_v) {
        sep = _vm_to_string_observable(vm, sep_v);
        if vm_has_native_exc() {
            return js_undefined();
        }
    }
    # Pieces are collected and joined once (was `s = s + piece`: O(n²) copying,
    # a leaked intermediate per element, and the result interned forever —
    # rollup joins MB-sized chunk sources).
    parts_j: list[str] = [];
    # Dense fast path: read the element store directly instead of minting an
    # index key string per element (str(i) + intern + parse); a hole or any
    # non-dense receiver falls back to the observable [[Get]] below.
    raw_j: JSObject = js_object_table_get(jsv_to_table_id(o));  # o is ToObject(this)
    dense_j: bool = raw_j.elems_kind != ELEMS_NONE;
    i: int = 0;
    while i < n {
        if i > 0 {
            parts_j.append(sep);
        }
        elem: JSValue = jsv_hole();
        if dense_j and i < len(raw_j.elems_ro()) {
            elem = raw_j.elems_ro()[i];
        }
        if jsv_is_hole(elem) {
            elem = js_object_get_observable(o, str_intern_index(i), o);
            if vm_has_native_exc() {
                return js_undefined();
            }
        }
        if not (jsv_is_null(elem) or jsv_is_undefined(elem)) {
            parts_j.append(_vm_to_string_observable(vm, elem));
            if vm_has_native_exc() {
                return js_undefined();
            }
        }
        i = i + 1;
    }
    return jsv_from_string_id(str_heap("".join(parts_j)));
}

"""
Array.prototype.toString() — §23.1.3.39.
ToObject → Get(array, "join") → Call(join, array) if callable, else
%Object.prototype.toString%(array). R17.
"""
def _vm_array_toString(vm: VM, this_val: JSValue) -> JSValue {
    o: JSValue = _vm_array_to_object(this_val);
    if vm_has_native_exc() {
        return js_undefined();
    }
    func: JSValue = js_object_get_observable(o, WK_JOIN, o);
    if vm_has_native_exc() {
        return js_undefined();
    }
    if vm._value_is_callable(func) {
        res_ts: JSValue = _vm_invoke_callback(vm, func, o, []);
        if _vm_bridge_invoke_exc(vm) {
            return js_undefined();
        }
        return res_ts;
    }
    return _vm_call_native_proxy_aware(
        vm, vm.realm, NATIVE_KIND_OBJ_PROTO_TOSTRING, o, []
    );
}

"""
Object.prototype.toLocaleString() — §20.1.3.5.
Return ? Invoke(this, "toString"). R17 prerequisite for Array.toLocaleString.
"""
def _vm_object_proto_tolocalestring(vm: VM, this_val: JSValue) -> JSValue {
    func: JSValue = _vm_lookup_method(vm, this_val, WK_TOSTRING);
    if vm_has_native_exc() {
        return js_undefined();
    }
    if not vm._value_is_callable(func) {
        vm_throw_native(make_type_error("toString is not a function"));
        return js_undefined();
    }
    res_otls: JSValue = _vm_invoke_callback(vm, func, this_val, []);
    if _vm_bridge_invoke_exc(vm) {
        return js_undefined();
    }
    return res_otls;
}

"""
Array.prototype.toLocaleString() — §23.1.3.31.
Skip null/undefined elements; Invoke(element, "toLocaleString") with GetV
semantics (box for lookup, original receiver as this). R17.
"""
def _vm_array_toLocaleString(vm: VM, this_val: JSValue) -> JSValue {
    o: JSValue = _vm_array_to_object(this_val);
    if vm_has_native_exc() {
        return js_undefined();
    }
    n: int = _length_of(o);
    if vm_has_native_exc() {
        return js_undefined();
    }
    sep: str = ",";
    parts_l: list[str] = [];
    i: int = 0;
    while i < n {
        if i > 0 {
            parts_l.append(sep);
        }
        elem: JSValue = js_object_get_observable(o, str_intern_index(i), o);
        if vm_has_native_exc() {
            return js_undefined();
        }
        if not (jsv_is_null(elem) or jsv_is_undefined(elem)) {
            func: JSValue = _vm_lookup_method(vm, elem, WK_TOLOCALESTRING);
            if vm_has_native_exc() {
                return js_undefined();
            }
            if not vm._value_is_callable(func) {
                vm_throw_native(make_type_error("toLocaleString is not a function"));
                return js_undefined();
            }
            r: JSValue = _vm_invoke_callback(vm, func, elem, []);
            if _vm_bridge_invoke_exc(vm) {
                return js_undefined();
            }
            parts_l.append(_vm_to_string_observable(vm, r));
            if vm_has_native_exc() {
                return js_undefined();
            }
        }
        i = i + 1;
    }
    return jsv_from_string_id(str_heap("".join(parts_l)));
}

"""
Array.prototype.keys / values / entries — §23.1.3.14 / .37 / .6.
ToObject(this) then CreateArrayIterator(O, kind). R15.
"""
def _vm_array_create_iterator(vm: VM, this_val: JSValue, kind: int) -> JSValue {
    o: JSValue = _vm_array_to_object(this_val);
    if vm_has_native_exc() {
        return js_undefined();
    }
    return js_make_array_iterator(o, kind);
}

"""
%ArrayIteratorPrototype%.next — §23.1.5.2.1.
Mutation-reflecting LengthOfArrayLike / Get each step; permanently closes
[[IteratedArrayLike]] on first exhaustion. R15.
"""
def _vm_array_iterator_next(vm: VM, this_val: JSValue) -> JSValue {
    if not _ai_is_instance(this_val) {
        vm_throw_native(
            make_type_error(
                "%ArrayIteratorPrototype%.next called on incompatible receiver"
            )
        );
        return js_undefined();
    }
    a: JSValue = _ai_get_target(this_val);
    if jsv_is_undefined(a) {
        return js_iter_result(js_undefined(), True);
    }
    idx: int = _ai_get_index(this_val);
    len_a: int = _length_of(a);
    if vm_has_native_exc() {
        return js_undefined();
    }
    if idx >= len_a {
        _ai_set_target(this_val, js_undefined());
        return js_iter_result(js_undefined(), True);
    }
    _ai_set_index(this_val, idx + 1);
    kind: int = _ai_get_kind(this_val);
    if kind == ARRAY_ITER_KIND_KEY {
        return js_iter_result(js_int(idx), False);
    }
    # A dense own element needs no key: the generic read interned the index's
    # decimal text for every element of every for-of / spread over an array.
    elem: JSValue = js_object_dense_elem(a, idx);
    if jsv_is_hole(elem) {
        elem = binary_ta_int_get(a, idx);
    }
    if jsv_is_hole(elem) {
        elem = js_object_get_observable(a, str_intern_index(idx), a);
        if vm_has_native_exc() {
            return js_undefined();
        }
    }
    if kind == ARRAY_ITER_KIND_VALUE {
        return js_iter_result(elem, False);
    }
    return js_iter_result(js_array_create([js_int(idx), elem]), False);
}

"""Stable bottom-up merge sort of `vals` by the parallel string keys
`keys`, ascending (the left run wins ties)."""
def _vm_sort_by_keys(keys: list[str], vals: list[JSValue]) -> None {
    sk_n: int = len(keys);
    if sk_n < 2 {
        return;
    }
    sk_tk: list[str] = [];
    sk_tv: list[JSValue] = [];
    sk_i: int = 0;
    while sk_i < sk_n {
        sk_tk.append(keys[sk_i]);
        sk_tv.append(vals[sk_i]);
        sk_i = sk_i + 1;
    }
    sk_w: int = 1;
    while sk_w < sk_n {
        sk_lo: int = 0;
        while sk_lo < sk_n {
            sk_mid: int = sk_lo + sk_w;
            if sk_mid > sk_n {
                sk_mid = sk_n;
            }
            sk_hi: int = sk_lo + sk_w + sk_w;
            if sk_hi > sk_n {
                sk_hi = sk_n;
            }
            sk_a: int = sk_lo;
            sk_b: int = sk_mid;
            sk_k: int = sk_lo;
            while sk_a < sk_mid and sk_b < sk_hi {
                if keys[sk_b] < keys[sk_a] {
                    sk_tk[sk_k] = keys[sk_b];
                    sk_tv[sk_k] = vals[sk_b];
                    sk_b = sk_b + 1;
                } else {
                    sk_tk[sk_k] = keys[sk_a];
                    sk_tv[sk_k] = vals[sk_a];
                    sk_a = sk_a + 1;
                }
                sk_k = sk_k + 1;
            }
            while sk_a < sk_mid {
                sk_tk[sk_k] = keys[sk_a];
                sk_tv[sk_k] = vals[sk_a];
                sk_a = sk_a + 1;
                sk_k = sk_k + 1;
            }
            while sk_b < sk_hi {
                sk_tk[sk_k] = keys[sk_b];
                sk_tv[sk_k] = vals[sk_b];
                sk_b = sk_b + 1;
                sk_k = sk_k + 1;
            }
            sk_lo = sk_hi;
        }
        sk_i = 0;
        while sk_i < sk_n {
            keys[sk_i] = sk_tk[sk_i];
            vals[sk_i] = sk_tv[sk_i];
            sk_i = sk_i + 1;
        }
        sk_w = sk_w + sk_w;
    }
}

"""Stable bottom-up merge sort of `vals` by the JS comparefn `cmp_fn`
(closure `cl`): an element of the right run goes first only when
comparefn(right, left) < 0 (NaN counts as 0). False when the comparator
threw (vm.had_exception set, `vals` partially merged)."""
def _vm_sort_with_cmp(
    vm: VM, cl: JSClosure, cmp_fn: JSValue, vals: list[JSValue]
) -> bool {
    sc_n: int = len(vals);
    if sc_n < 2 {
        return True;
    }
    sc_tv: list[JSValue] = [];
    sc_i: int = 0;
    while sc_i < sc_n {
        sc_tv.append(vals[sc_i]);
        sc_i = sc_i + 1;
    }
    sc_w: int = 1;
    while sc_w < sc_n {
        sc_lo: int = 0;
        while sc_lo < sc_n {
            sc_mid: int = sc_lo + sc_w;
            if sc_mid > sc_n {
                sc_mid = sc_n;
            }
            sc_hi: int = sc_lo + sc_w + sc_w;
            if sc_hi > sc_n {
                sc_hi = sc_n;
            }
            sc_a: int = sc_lo;
            sc_b: int = sc_mid;
            sc_k: int = sc_lo;
            while sc_a < sc_mid and sc_b < sc_hi {
                sc_res: JSValue = vm.run_cl(
                    cl, cmp_fn, js_undefined(), [vals[sc_b], vals[sc_a]]
                );
                if vm.had_exception {
                    return False;
                }
                sc_c: float = js_to_num(sc_res);
                if sc_c == sc_c and sc_c < 0.0 {
                    sc_tv[sc_k] = vals[sc_b];
                    sc_b = sc_b + 1;
                } else {
                    sc_tv[sc_k] = vals[sc_a];
                    sc_a = sc_a + 1;
                }
                sc_k = sc_k + 1;
            }
            while sc_a < sc_mid {
                sc_tv[sc_k] = vals[sc_a];
                sc_a = sc_a + 1;
                sc_k = sc_k + 1;
            }
            while sc_b < sc_hi {
                sc_tv[sc_k] = vals[sc_b];
                sc_b = sc_b + 1;
                sc_k = sc_k + 1;
            }
            sc_lo = sc_hi;
        }
        sc_i = 0;
        while sc_i < sc_n {
            vals[sc_i] = sc_tv[sc_i];
            sc_i = sc_i + 1;
        }
        sc_w = sc_w + sc_w;
    }
    return True;
}

"""SortIndexedProperties' element collection (§23.1.3.30.1 steps 3-4):
the present elements 0..len-1 of `o`, dense own elements read directly,
anything else through the observable HasProperty / Get (re-reading the
length after each, as user code may have run). Empty with the native
exception set when a read threw."""
def _vm_sort_collect(o: JSValue) -> list[JSValue] {
    cl_n: int = _length_of(o);
    cl_items: list[JSValue] = [];
    if vm_has_native_exc() {
        return cl_items;
    }
    cl_i: int = 0;
    while cl_i < cl_n {
        cl_dv: JSValue = js_object_dense_elem(o, cl_i);
        if not jsv_is_hole(cl_dv) {
            cl_items.append(cl_dv);
            cl_i = cl_i + 1;
            continue;
        }
        cl_k: int = str_intern_index(cl_i);
        if js_object_has_observable(o, cl_k) {
            if vm_has_native_exc() {
                return [];
            }
            cl_items.append(js_object_get_observable(o, cl_k, o));
            if vm_has_native_exc() {
                return [];
            }
        } else {
            if vm_has_native_exc() {
                return [];
            }
        }
        cl_i = cl_i + 1;
        cl_n = _length_of(o);
        if vm_has_native_exc() {
            return [];
        }
    }
    return cl_items;
}

"""Default SortCompare: undefineds last, else lexicographic ToString."""
def _vm_list_sort_default(vm: VM, items: list[JSValue]) -> list[JSValue] {
    defined: list[JSValue] = [];
    undefs: list[JSValue] = [];
    for v in items {
        if jsv_is_undefined(v) {
            undefs.append(js_undefined());
        } else {
            defined.append(v);
        }
    }
    dn: int = len(defined);
    # Precompute ToString keys so identical elements each invoke toString (bug_596_1).
    keys: list[str] = [];
    ki: int = 0;
    while ki < dn {
        keys.append(_vm_to_string_observable(vm, defined[ki]));
        if vm_has_native_exc() {
            return [];
        }
        ki = ki + 1;
    }
    _vm_sort_by_keys(keys, defined);
    return defined + undefs;
}

"""SortIndexedProperties with default SortCompare — §23.1.3.30.1."""
def _vm_array_sort_default(vm: VM, this_val: JSValue) -> JSValue {
    o: JSValue = _vm_array_to_object(this_val);
    if vm_has_native_exc() {
        return js_undefined();
    }
    items: list[JSValue] = _vm_sort_collect(o);
    if vm_has_native_exc() {
        return js_undefined();
    }
    n: int = _length_of(o);
    if vm_has_native_exc() {
        return js_undefined();
    }
    sorted_items: list[JSValue] = _vm_list_sort_default(vm, items);
    if vm_has_native_exc() {
        return js_undefined();
    }
    item_count: int = len(sorted_items);
    j: int = 0;
    while j < item_count {
        if not _set_or_throw(o, j, sorted_items[j]) {
            return js_undefined();
        }
        j = j + 1;
    }
    while j < n {
        if not _delete_or_throw(o, str_intern_index(j)) {
            return js_undefined();
        }
        j = j + 1;
    }
    return o;
}

"""
SortIndexedProperties with a JS comparefn — §23.1.3.30.1.
Collect present elements, sort via comparefn, Set back, Delete trailing.
"""
def _vm_array_sort_with_comparefn(
    vm: VM, this_val: JSValue, cmp_fn: JSValue
) -> JSValue {
    o: JSValue = _vm_array_to_object(this_val);
    if vm_has_native_exc() {
        return js_undefined();
    }
    items: list[JSValue] = _vm_sort_collect(o);
    if vm_has_native_exc() {
        return js_undefined();
    }
    n: int = _length_of(o);
    if vm_has_native_exc() {
        return js_undefined();
    }
    # Partition undefineds last (CompareArrayElements steps 1-4), then comparefn.
    defined: list[JSValue] = [];
    undefs: list[JSValue] = [];
    for v in items {
        if jsv_is_undefined(v) {
            undefs.append(js_undefined());
        } else {
            defined.append(v);
        }
    }
    cl: JSClosure = vm.realm.closures[get_fn_idx(cmp_fn)];
    if not _vm_sort_with_cmp(vm, cl, cmp_fn, defined) {
        exc_s: JSValue = vm.pending_exc;
        vm.had_exception = False;
        vm.pending_exc = js_undefined();
        vm_throw_native(exc_s);
        return js_undefined();
    }
    sorted_items: list[JSValue] = defined + undefs;
    item_count: int = len(sorted_items);
    j: int = 0;
    while j < item_count {
        if not _set_or_throw(o, j, sorted_items[j]) {
            return js_undefined();
        }
        j = j + 1;
    }
    while j < n {
        if not _delete_or_throw(o, str_intern_index(j)) {
            return js_undefined();
        }
        j = j + 1;
    }
    return o;
}

"""Array.prototype.toSorted with a JS comparefn — dense copy, then sort."""
def _vm_array_tosorted_with_comparefn(
    vm: VM, this_val: JSValue, cmp_fn: JSValue
) -> JSValue {
    ats_this: JSValue = this_val;
    if jsv_is_null(ats_this) or jsv_is_undefined(ats_this) {
        vm_throw_native(make_type_error("Array method called on null or undefined"));
        return js_undefined();
    }
    if not jsv_is_any_object(ats_this) {
        if jsv_is_bool(ats_this) {
            ats_this = js_Boolean_new([ats_this]);
        } elif jsv_is_int32(ats_this) or jsv_is_double(ats_this) {
            ats_this = js_Number_new([ats_this]);
        } elif jsv_is_string_cell(ats_this) {
            ats_this = js_String_new([ats_this]);
        }
    }
    ats_cl: JSClosure = vm.realm.closures[get_fn_idx(cmp_fn)];
    ats_n: int = js_array_len(ats_this);
    if vm_has_native_exc() {
        return js_undefined();
    }
    if ats_n > 4294967295 {
        vm_throw_native(make_range_error("Invalid array length"));
        return js_undefined();
    }
    ats_items: list[JSValue] = [];
    ats_k: int = 0;
    while ats_k < ats_n {
        ats_items.append(js_array_get(ats_this, ats_k));
        if vm_has_native_exc() {
            return js_undefined();
        }
        ats_k = ats_k + 1;
    }
    ats_i: int = 1;
    while ats_i < ats_n {
        ats_key: JSValue = ats_items[ats_i];
        ats_j: int = ats_i - 1;
        ats_inner_ok: bool = True;
        while ats_j >= 0 and ats_inner_ok {
            ats_cmp: JSValue = vm.run_cl(
                ats_cl, cmp_fn, js_undefined(), [ats_items[ats_j], ats_key]
            );
            if vm.had_exception {
                exc_ats: JSValue = vm.pending_exc;
                vm.had_exception = False;
                vm.pending_exc = js_undefined();
                vm_throw_native(exc_ats);
                return js_undefined();
            }
            if js_to_num(ats_cmp) > 0.0 {
                ats_items[ats_j + 1] = ats_items[ats_j];
                ats_j = ats_j - 1;
            } else {
                ats_inner_ok = False;
            }
        }
        ats_items[ats_j + 1] = ats_key;
        ats_i = ats_i + 1;
    }
    return js_array_create(ats_items);
}

# Promise.all combinator hidden state (matches dispatch.na.jac sentinel keys).
glob _PA_COUNTER: int = 1001001,
     _PA_VALS: int = 1001002,
     _PA_REJECT_ALL: int = 1001006;

def _vm_promise_all_finalize(vm: VM, result_p: JSValue) {
    arr: JSValue = js_object_get(result_p, _PA_VALS);
    n: int = js_array_len(arr);
    out: list[JSValue] = [];
    i: int = 0;
    while i < n {
        out.append(js_array_get(arr, i));
        i = i + 1;
    }
    vm._promise_settle_and_drain(result_p, PROMISE_FULFILLED, js_array_create(out));
}

def _vm_promise_all_resolve_call(vm: VM, fn: JSValue, value: JSValue) -> None {
    result_p: JSValue = js_object_get(fn, _KEY_PROMISE_COMB_RESULT);
    if not js_is_promise(result_p)
        or js_promise_get_state(result_p) != PROMISE_PENDING {
        return;
    }
    idx: int = jsv_to_int32(js_object_get(fn, _KEY_PROMISE_COMB_INDEX));
    arr: JSValue = js_object_get(result_p, _PA_VALS);
    js_array_set(arr, idx, value);
    cnt_v: JSValue = js_object_get(result_p, _PA_COUNTER);
    new_cnt: int = jsv_to_int32(cnt_v) - 1;
    js_object_set(result_p, _PA_COUNTER, js_int(new_cnt));
    if new_cnt <= 0 {
        _vm_promise_all_finalize(vm, result_p);
    }
}

def _vm_promise_all_reject_call(vm: VM, fn: JSValue, reason: JSValue) {
    result_p: JSValue = js_object_get(fn, _KEY_PROMISE_COMB_RESULT);
    if js_is_promise(result_p) and js_promise_get_state(result_p) == PROMISE_PENDING {
        vm._promise_settle_and_drain(result_p, PROMISE_REJECTED, reason);
    }
}

def _vm_promise_combinator_elem_call(vm: VM, fn: JSValue, value: JSValue) -> None {
    if js_is_promise_allsettled_resolve_elem(fn)
        or js_is_promise_allsettled_reject_elem(fn) {
        return;
    }
    if js_is_promise_any_reject_elem(fn) {
        return;
    }
}

def _vm_promise_invoke_thenable(
    vm: VM, thenable_val: JSValue, resolve_fn: JSValue, reject_fn: JSValue
) -> bool {
    if not jsv_is_object_cell(thenable_val) or jsv_to_table_id(thenable_val) <= 0 {
        return False;
    }
    then_fn: JSValue = vm.obs_get(thenable_val, WK_THEN, thenable_val);
    cap: list[JSValue] = _vm_capture_any_exc(vm);
    if jsv_to_bool(cap[0]) {
        _vm_promise_all_reject_call(vm, reject_fn, cap[1]);
        return True;
    }
    if not vm._value_is_callable(then_fn) {
        return False;
    }
    _vm_invoke_callback(vm, then_fn, thenable_val, [resolve_fn, reject_fn]);
    cap2: list[JSValue] = _vm_capture_any_exc(vm);
    if jsv_to_bool(cap2[0]) {
        _vm_promise_all_reject_call(vm, reject_fn, cap2[1]);
    }
    return True;
}

"""
Expose Promise combinator element functions to non-Promise thenables via .then.
Does not settle the result — dispatch still owns allSettled/any settling.
Used so resolve/reject element functions are real non-constructor callables
(test262 *element-function-nonconstructor*).
"""
def _vm_promise_expose_thenable_elems(vm: VM, args: list[JSValue], kind: int) -> None {
    iter_v: JSValue = js_undefined();
    if len(args) > 0 {
        iter_v = args[0];
    }
    if not js_is_array(iter_v) {
        return;
    }
    n: int = js_array_len(iter_v);
    # Dummy result promise only to hang element-function slots on.
    dummy: JSValue = js_promise_create();
    i: int = 0;
    while i < n {
        el: JSValue = js_array_get(iter_v, i);
        if not js_is_promise(el)
            and jsv_is_object_cell(el)
            and jsv_to_table_id(el) > 0 {
            resolve_elem: JSValue = js_undefined();
            reject_elem: JSValue = js_undefined();
            if kind == NATIVE_KIND_PROMISE_ALLSETTLED {
                resolve_elem = js_make_promise_allsettled_resolve_elem(dummy, i);
                reject_elem = js_make_promise_allsettled_reject_elem(dummy, i);
            } else {
                # Promise.any — reject element is the nonconstructor under test.
                resolve_elem = js_make_promise_all_resolve_elem(dummy, i);
                reject_elem = js_make_promise_any_reject_elem(dummy, i);
            }
            then_fn: JSValue = vm.obs_get(el, WK_THEN, el);
            cap: list[JSValue] = _vm_capture_any_exc(vm);
            if not jsv_to_bool(cap[0]) and vm._value_is_callable(then_fn) {
                _vm_invoke_callback(vm, then_fn, el, [resolve_elem, reject_elem]);
                _ = _vm_capture_any_exc(vm);
            }
        }
        i = i + 1;
    }
}

def _vm_promise_all(vm: VM, args: list[JSValue]) -> JSValue {
    iter_all: JSValue = js_undefined();
    if len(args) > 0 {
        iter_all = args[0];
    }
    result_all: JSValue = js_promise_create();
    if not js_is_array(iter_all) {
        js_promise_settle(result_all, PROMISE_FULFILLED, js_array_create([]));
        return result_all;
    }
    n_all: int = js_array_len(iter_all);
    if n_all == 0 {
        js_promise_settle(result_all, PROMISE_FULFILLED, js_array_create([]));
        return result_all;
    }
    vals_all: list[JSValue] = [];
    vi_all: int = 0;
    while vi_all < n_all {
        vals_all.append(js_undefined());
        vi_all = vi_all + 1;
    }
    results_arr: JSValue = js_array_create(vals_all);
    js_object_set(result_all, _PA_COUNTER, js_int(n_all));
    js_object_set(result_all, _PA_VALS, results_arr);
    i_all: int = 0;
    while i_all < n_all {
        if js_promise_get_state(result_all) != PROMISE_PENDING {
            return result_all;
        }
        p_i: JSValue = js_array_get(iter_all, i_all);
        resolve_elem: JSValue = js_make_promise_all_resolve_elem(result_all, i_all);
        reject_elem: JSValue = js_make_promise_all_reject_elem(result_all);
        # Promises first (also thenables) — thenable adoption is for non-Promise objects.
        if js_is_promise(p_i) {
            s_i: int = js_promise_get_state(p_i);
            if s_i == PROMISE_REJECTED {
                promise_unmark_unhandled(p_i);
                vm._promise_settle_and_drain(
                    result_all, PROMISE_REJECTED, js_promise_get_value(p_i)
                );
                return result_all;
            } elif s_i == PROMISE_FULFILLED {
                _vm_promise_all_resolve_call(
                    vm, resolve_elem, js_promise_get_value(p_i)
                );
            } else {
                js_promise_add_reaction(p_i, resolve_elem, reject_elem, js_undefined());
            }
        } elif _vm_promise_invoke_thenable(vm, p_i, resolve_elem, reject_elem) {
            # Non-promise thenable: adopted via .then(resolveElem, rejectElem).
            i_all = i_all + 1;
            continue;
        } else {
            _vm_promise_all_resolve_call(vm, resolve_elem, p_i);
        }
        i_all = i_all + 1;
    }
    return result_all;
}

def _vm_promise_allsettled(vm: VM, args: list[JSValue]) -> JSValue {
    iter_as: JSValue = js_undefined();
    if len(args) > 0 {
        iter_as = args[0];
    }
    result_as: JSValue = js_promise_create();
    if not js_is_array(iter_as) {
        js_promise_settle(result_as, PROMISE_FULFILLED, js_array_create([]));
        return result_as;
    }
    n_as: int = js_array_len(iter_as);
    i_as: int = 0;
    while i_as < n_as {
        p_as: JSValue = js_array_get(iter_as, i_as);
        resolve_elem: JSValue = js_make_promise_allsettled_resolve_elem(
            result_as, i_as
        );
        reject_elem: JSValue = js_make_promise_allsettled_reject_elem(result_as, i_as);
        _vm_promise_invoke_thenable(vm, p_as, resolve_elem, reject_elem);
        i_as = i_as + 1;
    }
    js_promise_settle(result_as, PROMISE_FULFILLED, js_array_create([]));
    return result_as;
}

def _vm_promise_any(vm: VM, args: list[JSValue]) -> JSValue {
    iter_any: JSValue = js_undefined();
    if len(args) > 0 {
        iter_any = args[0];
    }
    result_any: JSValue = js_promise_create();
    if not js_is_array(iter_any) or js_array_len(iter_any) == 0 {
        js_promise_settle(result_any, PROMISE_REJECTED, js_undefined());
        return result_any;
    }
    p0: JSValue = js_array_get(iter_any, 0);
    resolve_elem: JSValue = js_make_promise_all_resolve_elem(result_any, 0);
    reject_elem: JSValue = js_make_promise_any_reject_elem(result_any, 0);
    _vm_promise_invoke_thenable(vm, p0, resolve_elem, reject_elem);
    js_promise_settle(result_any, PROMISE_REJECTED, js_undefined());
    return result_any;
}

"""Build a Date time-value object (new Date(...) semantics) with the observable
native context active, so argument ToPrimitive/ToNumber runs user valueOf /
toString / @@toPrimitive and abrupt completions propagate via vm_has_native_exc."""
def _vm_date_construct_obs(vm: VM, args: list[JSValue]) -> JSValue {
    _push_native_obs_vm(vm);
    r: JSValue = js_Date_construct(args);
    _pop_native_obs_vm();
    return r;
}


# ── Fast path for the common case ────────────────────────────────────────────
# 72 native kinds need the special handling below (proxy-aware
# Object/Reflect statics, bind/apply plumbing, promise combinators, …). Every
# other native call used to walk up to 95 `if kind == …` compares before
# reaching call_native. One dict probe decides.
glob _NSK_READY: bool = False,
     _NATIVE_SPECIAL_KINDS: dict[int, bool] = {},
     _NATIVE_FAST_KIND: list[int] = [],
     _REG_COLL_CTORS: list[JSValue] = [0, 0, 0],
     _NF_ARGS: list[JSValue] = [],
     _REG_TAIL_ARGS: list[JSValue] = [];

# CALL_METHOD fast path for builtins that cannot run JS when every argument is a
# simple primitive (no valueOf/toString/getter/callback can be reached): indexed
# by native kind, 1 = needs a string-primitive receiver, 2 = receiver ignored;
# 3 = never runs JS for any receiver or arguments (Map / Set methods check the
# receiver themselves and never coerce or call); 4 = Array.prototype.push, on
# an ordinary array while no prototype has index accessors (a plain append or
# an ordinary [[Set]]).
# Such a call cannot re-enter the VM, so no collection can run during it (GC
# only runs at dispatch-loop safepoints) and its arguments need no rooting, and
# these natives never keep their argument list, so one scratch list is reused.

# The Map / Set constructor objects of the main realm (V4.11; 0 = not seen yet).

# R_TAILCALL: the arguments copied out of the frame being replaced.
def _nf_init {
    nf_max: int = 0;
    nf_str: list[int] = [
        NATIVE_KIND_STR_AT,
        NATIVE_KIND_STR_CHARAT,
        NATIVE_KIND_STR_CHARCODEAT,
        NATIVE_KIND_STR_CODEPOINTAT,
        NATIVE_KIND_STR_ENDSWITH,
        NATIVE_KIND_STR_INCLUDES,
        NATIVE_KIND_STR_INDEXOF,
        NATIVE_KIND_STR_LASTINDEXOF,
        NATIVE_KIND_STR_PADEND,
        NATIVE_KIND_STR_PADSTART,
        NATIVE_KIND_STR_REPEAT,
        NATIVE_KIND_STR_SLICE,
        NATIVE_KIND_STR_STARTSWITH,
        NATIVE_KIND_STR_SUBSTR,
        NATIVE_KIND_STR_SUBSTRING,
        NATIVE_KIND_STR_TOLOWER,
        NATIVE_KIND_STR_TOUPPER,
        NATIVE_KIND_STR_TRIM,
        NATIVE_KIND_STR_TRIMEND,
        NATIVE_KIND_STR_TRIMSTART,
        NATIVE_KIND_STR_CONCAT,
        NATIVE_KIND_STR_TOSTRING
    ];
    nf_any: list[int] = [
        NATIVE_KIND_MATH_ABS,
        NATIVE_KIND_MATH_ACOS,
        NATIVE_KIND_MATH_ACOSH,
        NATIVE_KIND_MATH_ASIN,
        NATIVE_KIND_MATH_ASINH,
        NATIVE_KIND_MATH_ATAN,
        NATIVE_KIND_MATH_ATAN2,
        NATIVE_KIND_MATH_ATANH,
        NATIVE_KIND_MATH_CBRT,
        NATIVE_KIND_MATH_CEIL,
        NATIVE_KIND_MATH_CLZ32,
        NATIVE_KIND_MATH_COS,
        NATIVE_KIND_MATH_COSH,
        NATIVE_KIND_MATH_EXP,
        NATIVE_KIND_MATH_EXPM1,
        NATIVE_KIND_MATH_FLOOR,
        NATIVE_KIND_MATH_FROUND,
        NATIVE_KIND_MATH_HYPOT,
        NATIVE_KIND_MATH_IMUL,
        NATIVE_KIND_MATH_LOG,
        NATIVE_KIND_MATH_LOG10,
        NATIVE_KIND_MATH_LOG1P,
        NATIVE_KIND_MATH_LOG2,
        NATIVE_KIND_MATH_MAX,
        NATIVE_KIND_MATH_MIN,
        NATIVE_KIND_MATH_POW,
        NATIVE_KIND_MATH_RANDOM,
        NATIVE_KIND_MATH_ROUND,
        NATIVE_KIND_MATH_SIGN,
        NATIVE_KIND_MATH_SIN,
        NATIVE_KIND_MATH_SINH,
        NATIVE_KIND_MATH_SQRT,
        NATIVE_KIND_MATH_TAN,
        NATIVE_KIND_MATH_TANH,
        NATIVE_KIND_MATH_TRUNC,
        NATIVE_KIND_STR_FROMCHARCODE
    ];
    nf_pure: list[int] = [
        NATIVE_KIND_MAP_GET,
        NATIVE_KIND_MAP_SET_METHOD,
        NATIVE_KIND_MAP_HAS,
        NATIVE_KIND_MAP_DELETE,
        NATIVE_KIND_SET_ADD,
        NATIVE_KIND_SET_HAS,
        NATIVE_KIND_SET_DELETE,
        # IsArray (no trap, even on a Proxy), Date.now, Buffer byte access:
        # no coercion, no callback, no re-entry.
        NATIVE_KIND_ARRAY_ISARRAY,
        NATIVE_KIND_DATE_NOW,
        NATIVE_KIND_BUF_GET_BYTE,
        NATIVE_KIND_BUF_SET_BYTE
    ];
    # 6 = dispatch-table natives that may re-enter JS (a JS fallback, a
    # user-visible coercion): called with a fresh argument list, as the
    # shared _NF_ARGS could be refilled by a nested fast call.
    nf_reent: list[int] = [NATIVE_KIND_BUF_TOSTRING_METHOD];
    # 5 = pure with at most one argument: Object.create(proto) (a second,
    # descriptor-map argument reads properties, possibly through getters).
    nf_one: list[int] = [NATIVE_KIND_OBJ_STATIC_CREATE];
    for nk1 in nf_str {
        if nk1 > nf_max {
            nf_max = nk1;
        }
    }
    for nk2 in nf_any {
        if nk2 > nf_max {
            nf_max = nk2;
        }
    }
    for nk5 in nf_pure {
        if nk5 > nf_max {
            nf_max = nk5;
        }
    }
    for nk7 in nf_one {
        if nk7 > nf_max {
            nf_max = nk7;
        }
    }
    for nk9 in nf_reent {
        if nk9 > nf_max {
            nf_max = nk9;
        }
    }
    if NATIVE_KIND_ARRAY_PUSH > nf_max {
        nf_max = NATIVE_KIND_ARRAY_PUSH;
    }
    # 7 = any other dispatch-table native (the handlers' generic branch):
    # every kind up to the largest is mode 7 unless a handler names it.
    if nf_max < 1200 {
        nf_max = 1200;
    }
    _NATIVE_FAST_KIND = [];
    nf_i: int = 0;
    while nf_i <= nf_max {
        _NATIVE_FAST_KIND.append(7);
        nf_i = nf_i + 1;
    }
    # Kinds _op_call / _op_call_method special-case (generated from their
    # source, V4.5: any kind those handlers name must be listed here, or the
    # register loop would call it through the generic branch).
    nf_chain: list[int] = [
        NATIVE_KIND_ARRAY_TOLOCALESTRING,
        NATIVE_KIND_ARRAY_TOSORTED,
        NATIVE_KIND_BOUND_REQUIRE,
        NATIVE_KIND_BOUND_REQUIRE_RESOLVE,
        NATIVE_KIND_EVAL,
        NATIVE_KIND_FN_APPLY,
        NATIVE_KIND_FN_BIND,
        NATIVE_KIND_FN_CALL,
        NATIVE_KIND_FN_TOSTRING,
        NATIVE_KIND_FUNCTION,
        NATIVE_KIND_GENERATOR_NEXT,
        NATIVE_KIND_GENERATOR_RETURN,
        NATIVE_KIND_GENERATOR_SYMBOL_ITER,
        NATIVE_KIND_GENERATOR_THROW,
        NATIVE_KIND_ITER_NEXT,
        NATIVE_KIND_MAP,
        NATIVE_KIND_MAP_FOREACH,
        NATIVE_KIND_MODULE_COMPILE,
        NATIVE_KIND_MODULE_CREATE_REQUIRE,
        NATIVE_KIND_MODULE_EXT_JS,
        NATIVE_KIND_MODULE_EXT_JSON,
        NATIVE_KIND_MODULE_EXT_NODE,
        NATIVE_KIND_MODULE_SYNC_BUILTIN_ESM,
        NATIVE_KIND_PROMISE_CATCH,
        NATIVE_KIND_PROMISE_FINALLY,
        NATIVE_KIND_PROMISE_THEN,
        NATIVE_KIND_REGEXP_SYMBOL_MATCH,
        NATIVE_KIND_REGEXP_SYMBOL_REPLACE,
        NATIVE_KIND_REQUIRE,
        NATIVE_KIND_REQUIRE_RESOLVE,
        NATIVE_KIND_REQUIRE_RESOLVE_PATHS,
        NATIVE_KIND_SET,
        NATIVE_KIND_SET_FOREACH,
        NATIVE_KIND_STRING,
        NATIVE_KIND_STR_REPLACE,
        NATIVE_KIND_VM_CREATE_CONTEXT,
        NATIVE_KIND_VM_IS_CONTEXT,
        NATIVE_KIND_VM_RUN_IN_CONTEXT,
        NATIVE_KIND_VM_RUN_IN_THIS_CONTEXT,
        NATIVE_KIND_WEAKMAP,
        NATIVE_KIND_WEAKSET
    ];
    for nk11 in nf_chain {
        if nk11 >= 0 and nk11 <= nf_max {
            _NATIVE_FAST_KIND[nk11] = 0;
        }
    }
    nf_j: int = 0;
    while nf_j <= nf_max {
        if _is_arr_callback_kind(nf_j) {
            _NATIVE_FAST_KIND[nf_j] = 0;
        }
        nf_j = nf_j + 1;
    }
    for nk3 in nf_str {
        _NATIVE_FAST_KIND[nk3] = 1;
    }
    for nk4 in nf_any {
        _NATIVE_FAST_KIND[nk4] = 2;
    }
    for nk6 in nf_pure {
        _NATIVE_FAST_KIND[nk6] = 3;
    }
    for nk8 in nf_one {
        _NATIVE_FAST_KIND[nk8] = 5;
    }
    for nk10 in nf_reent {
        _NATIVE_FAST_KIND[nk10] = 6;
    }
    _NATIVE_FAST_KIND[NATIVE_KIND_ARRAY_PUSH] = 4;
}

"""A primitive whose ToNumber / ToString runs no JS: number, string, boolean,
undefined or null (not an object, function, symbol or BigInt)."""
def _vm_simple_prim(v: JSValue) -> bool {
    return jsv_is_int32(v)
        or jsv_is_double(v)
        or jsv_is_string_cell(v)
        or jsv_is_bool(v)
        or jsv_is_undefined(v)
        or jsv_is_null(v);
}

def _nsk_init -> None {
    if _NSK_READY {
        return;
    }
    _NATIVE_SPECIAL_KINDS[NATIVE_KIND_262_CREATE_REALM] = True;
    _NATIVE_SPECIAL_KINDS[NATIVE_KIND_262_EVAL_SCRIPT] = True;
    _NATIVE_SPECIAL_KINDS[NATIVE_KIND_ARRAY_CONCAT] = True;
    _NATIVE_SPECIAL_KINDS[NATIVE_KIND_ARRAY_ENTRIES] = True;
    _NATIVE_SPECIAL_KINDS[NATIVE_KIND_ARRAY_FLAT] = True;
    _NATIVE_SPECIAL_KINDS[NATIVE_KIND_ARRAY_FROM] = True;
    _NATIVE_SPECIAL_KINDS[NATIVE_KIND_ARRAY_FROM_ASYNC] = True;
    _NATIVE_SPECIAL_KINDS[NATIVE_KIND_ARRAY_ITER_NEXT] = True;
    _NATIVE_SPECIAL_KINDS[NATIVE_KIND_ARRAY_JOIN] = True;
    _NATIVE_SPECIAL_KINDS[NATIVE_KIND_ARRAY_KEYS] = True;
    _NATIVE_SPECIAL_KINDS[NATIVE_KIND_ARRAY_OF] = True;
    _NATIVE_SPECIAL_KINDS[NATIVE_KIND_ARRAY_POP] = True;
    _NATIVE_SPECIAL_KINDS[NATIVE_KIND_ARRAY_PUSH] = True;
    _NATIVE_SPECIAL_KINDS[NATIVE_KIND_ARRAY_REVERSE] = True;
    _NATIVE_SPECIAL_KINDS[NATIVE_KIND_ARRAY_SHIFT] = True;
    _NATIVE_SPECIAL_KINDS[NATIVE_KIND_ARRAY_SLICE] = True;
    _NATIVE_SPECIAL_KINDS[NATIVE_KIND_ARRAY_SORT] = True;
    _NATIVE_SPECIAL_KINDS[NATIVE_KIND_ARRAY_SPLICE] = True;
    _NATIVE_SPECIAL_KINDS[NATIVE_KIND_ARRAY_TOLOCALESTRING] = True;
    _NATIVE_SPECIAL_KINDS[NATIVE_KIND_ARRAY_TOREVERSED] = True;
    _NATIVE_SPECIAL_KINDS[NATIVE_KIND_ARRAY_TOSORTED] = True;
    _NATIVE_SPECIAL_KINDS[NATIVE_KIND_ARRAY_TOSTRING] = True;
    _NATIVE_SPECIAL_KINDS[NATIVE_KIND_ARRAY_UNSHIFT] = True;
    _NATIVE_SPECIAL_KINDS[NATIVE_KIND_ARRAY_VALUES] = True;
    _NATIVE_SPECIAL_KINDS[NATIVE_KIND_BIGINT] = True;
    _NATIVE_SPECIAL_KINDS[NATIVE_KIND_EVAL] = True;
    _NATIVE_SPECIAL_KINDS[NATIVE_KIND_FN_BIND] = True;
    _NATIVE_SPECIAL_KINDS[NATIVE_KIND_FN_HAS_INSTANCE] = True;
    _NATIVE_SPECIAL_KINDS[NATIVE_KIND_ITERATOR_RETURN_THIS] = True;
    _NATIVE_SPECIAL_KINDS[NATIVE_KIND_ITER_NEXT] = True;
    _NATIVE_SPECIAL_KINDS[NATIVE_KIND_JSON_PARSE] = True;
    _NATIVE_SPECIAL_KINDS[NATIVE_KIND_JSON_STRINGIFY] = True;
    _NATIVE_SPECIAL_KINDS[NATIVE_KIND_MAP_SET_ITER_NEXT] = True;
    _NATIVE_SPECIAL_KINDS[NATIVE_KIND_OBJ_DEFINE_PROPERTY] = True;
    _NATIVE_SPECIAL_KINDS[NATIVE_KIND_OBJ_GETOWNPD] = True;
    _NATIVE_SPECIAL_KINDS[NATIVE_KIND_OBJ_GETOWNPDS] = True;
    _NATIVE_SPECIAL_KINDS[NATIVE_KIND_OBJ_GET_PROTOTYPE_OF] = True;
