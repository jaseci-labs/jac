                + " is not a function";
            exc_mnf: JSValue = make_type_error(_mnf_msg);
            if not self._unwind_in_frame(frame, exc_mnf) {
                self.had_exception = True;
                self.pending_exc = exc_mnf;
                st.running = False;
            }
        }
    }

    def _op_new(frame: CallFrame, ins: Instruction, st: ExecState) -> None {
        nc_nw: int = ins.arg;
        # Single-allocation arg marshalling + gated spread expansion
        # (call_path_impl_plan Phase 1): pop into ONE list, reverse in place
        # (the old tmp+reverse-copy cost a second allocation + N appends per
        # call), and only scan for spreads when the compiler flagged one
        # (arg3 bit 3) — the unconditional scan did a has_own probe per
        # object argument per call.
        args_nw: list[JSValue] = [];
        anw: int = 0;
        while anw < nc_nw {
            args_nw.append(self._pop());
            anw = anw + 1;
        }
        anw = 0;
        tmp_nw_hi: int = nc_nw - 1;
        while anw < tmp_nw_hi {
            tmp_nw_sw: JSValue = args_nw[anw];
            args_nw[anw] = args_nw[tmp_nw_hi];
            args_nw[tmp_nw_hi] = tmp_nw_sw;
            anw = anw + 1;
            tmp_nw_hi = tmp_nw_hi - 1;
        }
        if (ins.arg3 & 8) != 0 {
            args_nw = _expand_spreads(args_nw);
        }
        ctor: JSValue = self._pop();
        if _DBG_NEW_ON {
            _dbg_ne_nm: str = "?";
            if is_fn_val(ctor) {
                _dbg_ne_nm = self.realm.closures[get_fn_idx(ctor)].func.name;
            }
            _dbg_ne: str = "[DBG_NEW_ENTRY] is_fn="
                + str(is_fn_val(ctor))
                + " is_proxy="
                + str(js_is_proxy(ctor))
                + " is_native="
                + str(is_native_val(ctor))
                + " is_objcell="
                + str(jsv_is_object_cell(ctor))
                + " name='"
                + _dbg_ne_nm
                + "'\n";
            write(2, _dbg_ne, len(_dbg_ne));
        }
        if js_is_proxy(ctor) {
            res_pxy_new: JSValue = self._proxy_trap_construct(ctor, args_nw, ctor);
            if vm_has_native_exc() {
                exc_pxn: JSValue = vm_take_native_exc();
                if not self._unwind_in_frame(frame, exc_pxn) {
                    self.had_exception = True;
                    self.pending_exc = exc_pxn;
                    st.running = False;
                }
            } elif self.had_exception {
                exc_pxn2: JSValue = self.pending_exc;
                self.had_exception = False;
                self.pending_exc = js_undefined();
                if not self._unwind_in_frame(frame, exc_pxn2) {
                    self.had_exception = True;
                    self.pending_exc = exc_pxn2;
                    st.running = False;
                }
            } else {
                self._push(res_pxy_new);
            }
        } elif is_native_val(ctor) {
            # non-constructor natives (prototype/static methods) must throw.
            if not _vm_is_constructor(self, ctor) {
                nw_nat_nm: str = get_native_name(ctor);
                if nw_nat_nm == "" {
                    nw_nat_nm = "Function";
                }
                exc_nat_nw: JSValue = make_type_error(
                    nw_nat_nm + " is not a constructor"
                );
                if not self._unwind_in_frame(frame, exc_nat_nw) {
                    self.had_exception = True;
                    self.pending_exc = exc_nat_nw;
                    st.running = False;
                }
            } else {
                kind_nw: int = get_native_kind(ctor);
                if kind_nw == NATIVE_KIND_FUNCTION {
                    # new Function(params..., body) — dynamic compile
                    res_fn_nw: JSValue = _impl_js_Function(args_nw);
                    _vm_copy_home_realm(ctor, res_fn_nw);
                    if not self._check_native_exc(frame, res_fn_nw) {
                        st.running = False;
                    }
                } elif kind_nw == NATIVE_KIND_PROMISE {
                    # new Promise(executor) — executor must be callable (§27.2.3.1).
                    exec_nw: JSValue = js_undefined();
                    if len(args_nw) > 0 {
                        exec_nw = args_nw[0];
                    }
                    if not self._value_is_callable(exec_nw) {
                        exc_pr: JSValue = make_type_error(
                            "Promise resolver is not a function"
                        );
                        if not self._unwind_in_frame(frame, exc_pr) {
                            self.had_exception = True;
                            self.pending_exc = exc_pr;
                            st.running = False;
                        }
                    } else {
                        new_p: JSValue = js_promise_create();
                        resolve_fn: JSValue = js_make_resolve_fn(new_p);
                        reject_fn: JSValue = js_make_reject_fn(new_p);
                        exec_nw_fn: JSValue = args_nw[0];
                        if is_fn_val(exec_nw_fn) {
                            exec_cl: JSClosure = self.realm.closures[
                                get_fn_idx(exec_nw_fn)
                            ];
                            _gtr_nw: int = len(self.realm.gc_temp_roots);
                            self.realm.gc_temp_roots.append(new_p);
                            self.run_cl(
                                exec_cl,
                                exec_nw_fn,
                                js_undefined(),
                                [resolve_fn, reject_fn]
                            );
                            _gtr_nw_n: int = len(self.realm.gc_temp_roots);
                            while _gtr_nw_n > _gtr_nw {
                                _gtr_nw_n = _gtr_nw_n - 1;
                                del self.realm.gc_temp_roots[_gtr_nw_n];
                            }
                            if self.had_exception {
                                exc_pe: JSValue = self.pending_exc;
                                self.had_exception = False;
                                self.pending_exc = js_undefined();
                                self._promise_settle_and_drain(
                                    new_p, PROMISE_REJECTED, exc_pe
                                );
                            }
                        } elif is_native_val(exec_nw_fn) {
                            _vm_call_native_proxy_aware(
                                self,
                                self.realm,
                                get_native_kind(exec_nw_fn),
                                js_undefined(),
                                [resolve_fn, reject_fn]
                            );
                            if vm_has_native_exc() {
                                exc_pn: JSValue = vm_take_native_exc();
                                self._promise_settle_and_drain(
                                    new_p, PROMISE_REJECTED, exc_pn
                                );
                            }
                        } elif jsv_is_object_cell(exec_nw_fn)
                            and jsv_to_table_id(exec_nw_fn) > 0
                            and js_object_has_own(exec_nw_fn, KEY_CTOR_KIND) {
                            ck_pe: JSValue = js_object_get(exec_nw_fn, KEY_CTOR_KIND);
                            if jsv_is_int32(ck_pe) {
                                _vm_call_native_proxy_aware(
                                    self,
                                    self.realm,
                                    jsv_to_int32(ck_pe),
                                    js_undefined(),
                                    [resolve_fn, reject_fn]
                                );
                                if vm_has_native_exc() {
                                    exc_pj: JSValue = vm_take_native_exc();
                                    self._promise_settle_and_drain(
                                        new_p, PROMISE_REJECTED, exc_pj
                                    );
                                }
                            }
                        }
                        self._push(new_p);
                    }
                } elif kind_nw == NATIVE_KIND_DATE {
                    # new Date(...) — §21.4.2.1 with NewTarget = Date. Build the time value,
                    # then set [[Prototype]] from GetPrototypeFromConstructor(NewTarget) so
                    # the instance is a Date whose methods resolve through Date.prototype.
                    date_nw: JSValue = _vm_date_construct_obs(self, args_nw);
                    if vm_has_native_exc() {
                        exc_dnw: JSValue = vm_take_native_exc();
                        if not self._unwind_in_frame(frame, exc_dnw) {
                            self.had_exception = True;
                            self.pending_exc = exc_dnw;
                            st.running = False;
                        }
                    } else {
                        proto_nw: JSValue = _vm_get_collection_proto_from_constructor(
                            self, ctor, "Date"
                        );
                        if vm_has_native_exc() {
                            exc_pnw2: JSValue = vm_take_native_exc();
                            if not self._unwind_in_frame(frame, exc_pnw2) {
                                self.had_exception = True;
                                self.pending_exc = exc_pnw2;
                                st.running = False;
                            }
                        } else {
                            if jsv_is_object_cell(proto_nw)
                                and jsv_is_object_cell(date_nw) {
                                js_object_set_prototype(date_nw, proto_nw);
                            }
                            self._push(date_nw);
                        }
                    }
                } else {
                    res_nat_nw: JSValue = _vm_call_native_proxy_aware(
                        self, self.realm, kind_nw, js_undefined(), args_nw
                    );
                    if not self._check_native_exc(frame, res_nat_nw) {
                        st.running = False;
                    }
                }
            }  # end IsConstructor-true branch for is_native_val
        } elif jsv_is_object_cell(ctor)
            and jsv_to_table_id(ctor) >= 0
            and js_object_has_own(ctor, WK_IS_CLASS) {
            # JS class instantiation
            cls_proto_nw: JSValue = js_object_get(ctor, WK_PROTOTYPE);
            new_obj_cls: JSValue = js_object_create(cls_proto_nw);
            nw_is_derived: bool = js_object_has_own(ctor, WK_SUPER);
            nw_ok: bool = False;
            # True when this derived class has an EXPLICIT constructor: its `super()` runs the
            # derived class's own instance fields (§13.3.7.1), so the post-ctor field-init block
            # below must NOT run them again. An IMPLICIT derived ctor has no super() opcode, so
            # its own fields are still initialized by that post-ctor block.
            nw_had_explicit_ctor: bool = False;
            # ── For BASE classes: run field inits BEFORE constructor ──
            nw_fields_ok: bool = True;
            if not nw_is_derived {
                nw_fields_b: JSValue = js_object_get(ctor, WK_FIELDS);
                if jsv_is_object_cell(nw_fields_b)
                    and jsv_to_table_id(nw_fields_b) >= 0 {
                    nw_flen_bv: JSValue = js_object_get(nw_fields_b, WK_LENGTH);
                    nw_flen_b: int = 0;
                    if jsv_is_int32(nw_flen_bv) {
                        nw_flen_b = jsv_to_int32(nw_flen_bv);
                    }
                    nw_fi_b: int = 0;
                    while nw_fi_b < nw_flen_b and nw_fields_ok {
                        nw_init_b: JSValue = js_object_get(
                            nw_fields_b, str_intern_index(nw_fi_b)
                        );
                        if not self._run_one_field_init(nw_init_b, new_obj_cls) {
                            # ES §10.2.1.3: a field initializer's abrupt completion
                            # abandons the remaining fields AND the constructor body.
                            # Clear the flag so the loop condition exits and every
                            # downstream ctor/super branch (all gated on nw_fields_ok)
                            # is skipped. Also capture a native-thrown exception.
                            nw_fields_ok = False;
                            nw_exc_b: JSValue = self.pending_exc;
                            if vm_has_native_exc() {
                                nw_exc_b = vm_take_native_exc();
                            }
                            self.had_exception = False;
                            self.pending_exc = js_undefined();
                            if not self._unwind_in_frame(frame, nw_exc_b) {
                                self.had_exception = True;
                                self.pending_exc = nw_exc_b;
                                st.running = False;
                            }
                        }
                        nw_fi_b = nw_fi_b + 1;
                    }
                }
            }
            # ── Run constructor ──
            ctor_fn_nw: JSValue = js_object_get(ctor, WK_CTOR);
            _dbg_cn2: JSValue = js_undefined();
            if _DBG_NEW_ON {
                _dbg_cn2 = js_object_get(ctor, WK_NAME);
            }
            # Find the REAL attachScopes Scope by BEHAVIOR not name: a WK_IS_CLASS ctor
            # whose body contains LOAD_GLOBAL(10) (Object.create) — the children/variables
            # Scope has none. Log every candidate; gate DBG_SCOPE detail on it.
            _dbg_is_scope: bool = False;
            if _DBG_NEW_ON and is_fn_val(ctor_fn_nw) {
                _dbg_isc_cl: JSClosure = self.realm.closures[get_fn_idx(ctor_fn_nw)];
                _dbg_cnm3: str = "?";
                if jsv_is_string_cell(_dbg_cn2) {
                    _dbg_cnm3 = str_from_id(jsv_to_table_id(_dbg_cn2));
                }
                _dbg_has_objcreate: bool = False;
                _dbg_scan: int = 0;
                while _dbg_scan < len(_dbg_isc_cl.func.code) {
                    if opcode_to_int(_dbg_isc_cl.func.code[_dbg_scan].opcode) == 10 {
                        _dbg_has_objcreate = True;
                    }
                    _dbg_scan = _dbg_scan + 1;
                }
                if _dbg_has_objcreate and _dbg_cnm3 == "Scope" {
                    _dbg_is_scope = True;
                    _dbg_cand: str = "[DBG_CAND] WK_IS_CLASS name='"
                        + _dbg_cnm3
                        + "' bclen="
                        + str(len(_dbg_isc_cl.func.code))
                        + " nparams="
                        + str(len(_dbg_isc_cl.func.params))
                        + " has_LOAD_GLOBAL=True\n";
                    write(2, _dbg_cand, len(_dbg_cand));
                }
            }
            if _dbg_is_scope {
                _dbg_s1: str = "[DBG_SCOPE] --- new Scope --- fields_ok="
                    + str(nw_fields_ok)
                    + " ctor_is_fnval="
                    + str(is_fn_val(ctor_fn_nw))
                    + " derived="
                    + str(nw_is_derived)
                    + " nargs="
                    + str(len(args_nw))
                    + "\n";
                write(2, _dbg_s1, len(_dbg_s1));
                if is_fn_val(ctor_fn_nw) {
                    _dbg_sc_cl: JSClosure = self.realm.closures[get_fn_idx(ctor_fn_nw)];
                    _dbg_s2: str = "[DBG_SCOPE] ctor bytecode_len="
                        + str(len(_dbg_sc_cl.func.code))
                        + " nparams="
                        + str(len(_dbg_sc_cl.func.params))
                        + " param_base="
                        + str(_dbg_sc_cl.func.param_base)
                        + " num_locals="
                        + str(_dbg_sc_cl.func.num_locals)
                        + " is_gen="
                        + str(_dbg_sc_cl.func.is_generator)
                        + "\n";
                    write(2, _dbg_s2, len(_dbg_s2));
                    _dbg_di: int = 0;
                    while _dbg_di < len(_dbg_sc_cl.func.code) and _dbg_di < 14 {
                        _dbg_op: Instruction = _dbg_sc_cl.func.code[_dbg_di];
                        _dbg_s3: str = "[DBG_SCOPE]   ["
                            + str(_dbg_di)
                            + "] op="
                            + str(opcode_to_int(_dbg_op.opcode))
                            + " arg="
                            + str(_dbg_op.arg)
                            + "\n";
                        write(2, _dbg_s3, len(_dbg_s3));
                        _dbg_di = _dbg_di + 1;
                    }
                }
            }
            if nw_fields_ok and is_fn_val(ctor_fn_nw) {
                nw_had_explicit_ctor = True;
                cl_cls: JSClosure = self.realm.closures[get_fn_idx(ctor_fn_nw)];
                # new.target = the class being constructed (ES §13.3.5.1); consumed by run.
                self._pending_new_target = ctor;
                self.pending_new_target = ctor;
                # A derived class's `this` is uninitialized until super() runs.
                if nw_is_derived {
                    self._pending_this_uninit = True;
                }
                # super() inside this ctor initializes THIS class's own fields (§15.7).
                self._pending_ctor_class = ctor;
                cr_cls: JSValue = self.run_cl(cl_cls, ctor_fn_nw, new_obj_cls, args_nw);
                if _dbg_is_scope {
                    _dbg_ntid: int = 0;
                    if jsv_is_object_cell(new_obj_cls) {
                        _dbg_ntid = jsv_to_table_id(new_obj_cls);
                    }
                    _dbg_raw: JSObject = self.realm.objects[
                        jsv_to_table_id(new_obj_cls)
                    ];
                    _dbg_children: JSValue = js_object_get(
                        new_obj_cls, str_intern("children")
                    );
                    _dbg_vars: JSValue = js_object_get(
                        new_obj_cls, str_intern("variables")
                    );
                    _dbg_parent: JSValue = js_object_get(
                        new_obj_cls, str_intern("parent")
                    );
                    _dbg_nt: str = "[DBG_SCOPE] after run_cl tid="
                        + str(_dbg_ntid)
                        + " mode="
                        + str(_dbg_raw.mode)
                        + " shape_id="
                        + str(_dbg_raw.shape_id)
                        + " nslots="
                        + str(len(_dbg_raw.slots))
                        + " children_undef="
                        + str(jsv_is_undefined(_dbg_children))
                        + " variables_undef="
                        + str(jsv_is_undefined(_dbg_vars))
                        + " parent_undef="
                        + str(jsv_is_undefined(_dbg_parent))
                        + "\n";
                    write(2, _dbg_nt, len(_dbg_nt));
                }
                if self.had_exception {
                    exc_cls: JSValue = self.pending_exc;
                    self.had_exception = False;
                    self.pending_exc = js_undefined();
                    if not self._unwind_in_frame(frame, exc_cls) {
                        self.had_exception = True;
                        self.pending_exc = exc_cls;
                        st.running = False;
                    }
                } else {
                    # ES §10.2.2 [[Construct]] step 13: if the constructor returns a value,
                    # it must be an Object; a DERIVED constructor that returns a NON-undefined,
                    # NON-object (a primitive: number/string/boolean/symbol/bigint/null) is a
                    # TypeError (test262 derived-class-return-override-with-*). A base ctor's
                    # primitive return is ignored (uses `this`).
                    if nw_is_derived
                        and not jsv_is_undefined(cr_cls)
                        and not jsv_is_any_object(cr_cls) {
                        exc_dro: JSValue = make_type_error(
                            "Derived constructors may only return object or undefined"
                        );
                        if not self._unwind_in_frame(frame, exc_dro) {
                            self.had_exception = True;
                            self.pending_exc = exc_dro;
                            st.running = False;
                        }
                        return;
                    }
                    if jsv_is_any_object(cr_cls) {
                        new_obj_cls = cr_cls;
                    }
                    # A derived class with its own constructor needs nothing more for a
                    # native super (Map, Set, Error, …): the constructor's super(…) went
                    # through SUPER_CALL, which ran the native constructor on `this` with
                    # the arguments super() received and checked its exception. Running it
                    # again here with the `new` arguments re-initialized the instance from
                    # the wrong values: `class D extends Map { constructor(f) { super(); } }`
                    # then iterated `f` (TypeError for `new D(() => …)`), and the exception
                    # was never checked, so it surfaced at some later instruction.
                    nw_ok = True;
                }
            } elif nw_fields_ok {
                # No explicit constructor — check inherited from super class
                cls_super_nw: JSValue = js_object_get(ctor, WK_SUPER);
                if _vm_ctor_kind_of(cls_super_nw) == NATIVE_KIND_PROMISE {
                    # `class X extends Promise {}` with no explicit constructor —
                    # the implicit ctor forwards its arguments to super(). Same slot
                    # problem as the SUPER_CALL branch: copying own properties does
                    # not make `this` a promise, so initialize in place and run the
                    # executor against it.
                    pexec_nw: JSValue = js_undefined();
                    if len(args_nw) > 0 {
                        pexec_nw = args_nw[0];
                    }
                    if not self._value_is_callable(pexec_nw) {
                        exc_pnw: JSValue = make_type_error(
                            "Promise resolver is not a function"
                        );
                        if not self._unwind_in_frame(frame, exc_pnw) {
                            self.had_exception = True;
                            self.pending_exc = exc_pnw;
                            st.running = False;
                        }
                    } else {
                        js_promise_init_in_place(new_obj_cls);
                        pres_nw: JSValue = js_make_resolve_fn(new_obj_cls);
                        prej_nw: JSValue = js_make_reject_fn(new_obj_cls);
                        _gtr_pnw: int = len(self.realm.gc_temp_roots);
                        self.realm.gc_temp_roots.append(new_obj_cls);
                        self._invoke_callable_value(
                            pexec_nw, js_undefined(), [pres_nw, prej_nw]
                        );
                        _gtr_pnw_n: int = len(self.realm.gc_temp_roots);
                        while _gtr_pnw_n > _gtr_pnw {
                            _gtr_pnw_n = _gtr_pnw_n - 1;
                            del self.realm.gc_temp_roots[_gtr_pnw_n];
                        }
                        if self.had_exception {
                            exc_pnwe: JSValue = self.pending_exc;
                            self.had_exception = False;
                            self.pending_exc = js_undefined();
                            self._promise_settle_and_drain(
                                new_obj_cls, PROMISE_REJECTED, exc_pnwe
                            );
                        }
                        nw_ok = True;
                    }
                } elif is_native_val(cls_super_nw) {
                    # Native super with no explicit constructor —
                    # call the native ctor and copy properties onto this
                    nk_nw: int = get_native_kind(cls_super_nw);
                    err_nw: JSValue = _vm_call_native_proxy_aware(
                        self, self.realm, nk_nw, new_obj_cls, args_nw
                    );
                    if jsv_is_object_cell(err_nw) and jsv_to_table_id(err_nw) > 0 {
                        # Copy each own property with its FULL descriptor:
                        # preserves the real {w,e,c} per key rather than forcing all to
                        # {w:T,e:F,c:T}. Error's message/stack are non-enumerable
                        # (§20.5.1.1) and propagate here so `class E extends Error {}`
                        # (no explicit ctor) keeps its message.
                        ek_nw: list[int] = js_object_all_keys(err_nw);
                        eki_nw: int = 0;
                        while eki_nw < len(ek_nw) {
                            epd_nw: JSProperty = js_object_get_own_property_descriptor(
                                err_nw, ek_nw[eki_nw]
                            );
                            if not epd_nw.deleted {
                                js_object_define_property(
                                    new_obj_cls, ek_nw[eki_nw], epd_nw
                                );
                            }
                            eki_nw = eki_nw + 1;
                        }
                    }
                    # Boolean/Number/String construct via the plain-call dispatch returns a
                    # bare primitive (not an object) — install it as the derived instance's
                    # [[…Data]] slot so valueOf / coercion read the wrapped primitive.
                    self._copy_primitive_wrapper_slot(err_nw, new_obj_cls);
                    nw_ok = True;
                } elif _is_array_native_super(cls_super_nw) {
                    js_array_init_exotic_from_args(new_obj_cls, args_nw);
                    if vm_has_native_exc() {
                        exc_arr_nw: JSValue = vm_take_native_exc();
                        if not self._unwind_in_frame(frame, exc_arr_nw) {
                            self.had_exception = True;
                            self.pending_exc = exc_arr_nw;
                            st.running = False;
                        }
                    } else {
                        nw_ok = True;
                    }
                } elif is_fn_val(cls_super_nw) {
                    # Default derived ctor with a plain-function super (e.g.
                    # `class MyU8 extends Uint8Array {}` — TypedArray ctors are JS
                    # functions from binary_types.js, not KEY_CTOR_KIND natives).
                    # Invoke the function as a constructor with the derived `this`
                    # and new.target = the leaf class (ES §13.3.5.1 / §15.7.14).
                    cl_fn_sup_nw: JSClosure = self.realm.closures[
                        get_fn_idx(cls_super_nw)
                    ];
                    self._pending_new_target = ctor;
                    self.pending_new_target = ctor;
                    cr_fn_sup_nw: JSValue = self.run_cl(
                        cl_fn_sup_nw, cls_super_nw, new_obj_cls, args_nw
                    );
                    if self.had_exception {
                        exc_fn_sup_nw: JSValue = self.pending_exc;
                        self.had_exception = False;
                        self.pending_exc = js_undefined();
                        if not self._unwind_in_frame(frame, exc_fn_sup_nw) {
                            self.had_exception = True;
                            self.pending_exc = exc_fn_sup_nw;
                            st.running = False;
                        }
                    } else {
                        # Base ctor returning an object replaces `this` (ES §10.2.2).
                        if jsv_is_any_object(cr_fn_sup_nw) {
                            new_obj_cls = cr_fn_sup_nw;
                        }
                        nw_ok = True;
                    }
                } elif jsv_is_object_cell(cls_super_nw)
                    and jsv_to_table_id(cls_super_nw) > 0
                    and js_object_has_own(cls_super_nw, KEY_CTOR_KIND)
                    and jsv_to_int32(js_object_get(cls_super_nw, KEY_CTOR_KIND))
