# Object rest's excluded names per "\x1f"-joined constant (V4.23).
glob _OS_EXCL_CACHE: dict[str, list[int]] = {},
     _OS_EXCL_NONE: list[int] = [];

"""The excluded keys of an object rest (its "\x1f"-joined names constant),
parsed once per constant."""
def _vm_spread_excluded(se_s: str) -> list[int] {
    if se_s in _OS_EXCL_CACHE {
        return _OS_EXCL_CACHE[se_s];
    }
    se_out: list[int] = [];
    se_start: int = 0;
    se_i: int = 0;
    se_n: int = len(se_s);
    while se_i <= se_n {
        if se_i == se_n or se_s[se_i] == "\x1f" {
            se_out.append(str_intern(se_s[se_start:se_i]));
            se_start = se_i + 1;
        }
        se_i = se_i + 1;
    }
    _OS_EXCL_CACHE[se_s] = se_out;
    return se_out;
}

def _vm_op_object_spread(vm: VM, frame: CallFrame, ins: Instruction, st: ExecState) {
    vm._op_object_spread(frame, ins, st);
}

def _vm_op_unpack_array(vm: VM, frame: CallFrame, ins: Instruction, st: ExecState) {
    vm._op_unpack_array(frame, ins, st);
}

def _vm_op_unpack_object(vm: VM, frame: CallFrame, ins: Instruction, st: ExecState) {
    vm._op_unpack_object(frame, ins, st);
}

def _vm_op_nop(vm: VM, frame: CallFrame, ins: Instruction, st: ExecState) {
    vm._op_nop(frame, ins, st);
}

# FILLER: the bytecode optimizer's length-preserving pad — a TRUE no-op
# (unlike NOP, which pushes the class-TDZ sentinel). Normally never
# executed (the optimizer retargets jumps past filler runs), but running
# one is legal: with JS_BCOPT=0 the compiler's cell-elision pads are
# still jump targets and must fall through harmlessly.
def _vm_op_filler(vm: VM, frame: CallFrame, ins: Instruction, st: ExecState) {}

# ── Megaop handlers (bytecode_optimizer_impl_plan Phase 2) ─────────────────
# QUICKENING contract (see op.jac): each megaop sits at the HEAD of its
# matched window with the ORIGINAL interior instructions still in place.
# Fast path = whole-window effect + skip; slow path = replicate the head
# load only and fall through into the originals. Delegated steps pass the
# ORIGINAL Instruction objects (frame.func.code[p0+k]) so arg/IC state and
# observable behavior are identical to the unfused sequence.

"""LOCAL_INC: postfix `i++`/`i--` statement. arg=slot, arg2=±1 delta."""
def _vm_op_local_inc(
    vm: VM, frame: CallFrame, ins: Instruction, st: ExecState
) -> None {
    li_v: JSValue = frame.locals[frame.lb + (ins.arg)];
    if jsv_is_int32(li_v) {
        li_r: int = jsv_to_int32(li_v) + ins.arg2;
        if li_r >= -2147483648 and li_r <= 2147483647 {
            frame.locals[frame.lb + (ins.arg)] = js_int(li_r);
        } else {
            frame.locals[frame.lb + (ins.arg)] = js_number(float(li_r));
        }
        frame.ip = frame.ip + 7;
        return;
    }
    # Non-int32 (double/BigInt/object): head op was a plain LOAD_LOCAL —
    # push and fall through to the original LC/SUB/DUP/LC/SUB/ST/POP tail.
    vm._push(li_v);
}

"""BR_CMP_LL: fused loop condition. arg=slot_a; arg2=slot_b|cmpop<<16|
checked_a<<20|checked_b<<21|jump_if_true<<22; arg3=branch target ip."""
def _vm_op_br_cmp_ll(
    vm: VM, frame: CallFrame, ins: Instruction, st: ExecState
) -> None {
    bc_a: JSValue = frame.locals[frame.lb + (ins.arg)];
    bc_b: JSValue = frame.locals[frame.lb + (ins.arg2 & 65535)];
    if (jsv_is_int32(bc_a) or jsv_is_double(bc_a))
        and (jsv_is_int32(bc_b) or jsv_is_double(bc_b)) {
        # Numeric fast path — no ToPrimitive possible, NaN compares false,
        # numeric === is float equality (-0 == 0 true). The TDZ sentinel is
        # not numeric, so checked slots in TDZ take the slow path and throw
        # exactly where the original LOAD_LOCAL_CHECKED would.
        bc_av: float = 0.0;
        bc_bv: float = 0.0;
        if jsv_is_int32(bc_a) {
            bc_av = float(jsv_to_int32(bc_a));
        } else {
            bc_av = jsv_to_double(bc_a);
        }
        if jsv_is_int32(bc_b) {
            bc_bv = float(jsv_to_int32(bc_b));
        } else {
            bc_bv = jsv_to_double(bc_b);
        }
        bc_op: int = (ins.arg2 >> 16) & 15;
        bc_res: bool = False;
        if bc_op == 0 {
            bc_res = bc_av < bc_bv;
        } elif bc_op == 1 {
            bc_res = bc_av <= bc_bv;
        } elif bc_op == 2 {
            bc_res = bc_av > bc_bv;
        } elif bc_op == 3 {
            bc_res = bc_av >= bc_bv;
        } else {
            bc_res = bc_av == bc_bv;
        }
        bc_take: bool = bc_res;
        if (ins.arg2 >> 22) & 1 == 0 {
            bc_take = not bc_res;
        }
        if bc_take {
            frame.ip = ins.arg3;
        } else {
            frame.ip = frame.ip + 3;
        }
        return;
    }
    # Slow path: replicate the head load (checked variant throws the same
    # ReferenceError as _op_load_local_checked) and fall through to the
    # original LL(_C) b / cmp / branch tail.
    if (ins.arg2 >> 20) & 1 == 1 and js_is_tdz(bc_a) {
        bc_name: str = "";
        if ins.arg < len(frame.func.locals) {
            bc_name = frame.func.locals[ins.arg];
        }
        exc_bc: JSValue = make_reference_error(
            "Cannot access '" + bc_name + "' before initialization"
        );
        if not vm._unwind_in_frame(frame, exc_bc) {
            vm.had_exception = True;
            vm.pending_exc = exc_bc;
            st.running = False;
        }
        return;
    }
    vm._push(bc_a);
}

"""GET_LL_INDEX: `obj[key]` from two locals. arg=slot_obj;
arg2=slot_key|checked_obj<<20. Delegates to the original GET_INDEX."""
def _vm_op_get_ll_index(
    vm: VM, frame: CallFrame, ins: Instruction, st: ExecState
) -> None {
    gl_p0: int = frame.ip - 1;
    gl_o: JSValue = frame.locals[frame.lb + (ins.arg)];
    if (ins.arg2 >> 20) & 1 == 1 and js_is_tdz(gl_o) {
        gl_name: str = "";
        if ins.arg < len(frame.func.locals) {
            gl_name = frame.func.locals[ins.arg];
        }
        exc_gl: JSValue = make_reference_error(
            "Cannot access '" + gl_name + "' before initialization"
        );
        if not vm._unwind_in_frame(frame, exc_gl) {
            vm.had_exception = True;
            vm.pending_exc = exc_gl;
            st.running = False;
        }
        return;
    }
    vm._push(gl_o);
    vm._push(frame.locals[frame.lb + (ins.arg2 & 65535)]);
    gl_gi: Instruction = frame.func.code[gl_p0 + 2];
    # ip = delegated position + 1 (see GET_LLC_PROP note).
    frame.ip = gl_p0 + 3;
    vm._op_get_index(frame, gl_gi, st);
}

"""GET_LLC_PROP: `local.key` — push the local (TDZ-checked per arg2 bit
20) and delegate to the ORIGINAL GET_PROP at head+1 (self-patching
kid-cache and shape-IC state live on that Instruction and keep working)."""
def _vm_op_get_llc_prop(
    vm: VM, frame: CallFrame, ins: Instruction, st: ExecState
) -> None {
    gcp_p0: int = frame.ip - 1;
    gcp_v: JSValue = frame.locals[frame.lb + (ins.arg)];
    if (ins.arg2 >> 20) & 1 == 1 and js_is_tdz(gcp_v) {
        gcp_name: str = "";
        if ins.arg < len(frame.func.locals) {
            gcp_name = frame.func.locals[ins.arg];
        }
        exc_gcp: JSValue = make_reference_error(
            "Cannot access '" + gcp_name + "' before initialization"
        );
        if not vm._unwind_in_frame(frame, exc_gcp) {
            vm.had_exception = True;
            vm.pending_exc = exc_gcp;
            st.running = False;
        }
        return;
    }
    vm._push(gcp_v);
    # Bind the delegated Instruction to a LOCAL before the call — passing
    # the list subscript directly as an argument hands the callee a COPY
    # under the native backend (the known list-subscript field-mutation
    # hazard), so _op_get_prop's self-patching kid-cache/shape-IC writes
    # landed on a temporary and every access IC-missed (prop benches
    # regressed 1.77× until this fix).
    gcp_gp: Instruction = frame.func.code[gcp_p0 + 1];
    # Set frame.ip as if the delegated instruction had been dispatched
    # normally (ip = its position + 1): the self-patch idiom writes to
    # frame.func.code[frame.ip - 1] (kid-cache, shape-IC fills), so with
    # the megaop's own ip the patches landed on the MEGAOP head — IC never
    # hit and the key re-interned per access (prop benches 1.77× slower
    # until this). On clean completion ip is already past the window.
    frame.ip = gcp_p0 + 2;
    vm._op_get_prop(frame, gcp_gp, st);
}

"""SET_THIS_PROP: the ctor `this.key = value;` statement — replicate
LOAD_THIS (this-TDZ throw included; _op_load_this reads no ins fields)
and SWAP, delegate to the ORIGINAL SET_PROP at head+2 (IC preserved),
replicate the POP."""
def _vm_op_set_this_prop(
    vm: VM, frame: CallFrame, ins: Instruction, st: ExecState
) -> None {
    stp_p0: int = frame.ip - 1;
    vm._op_load_this(frame, ins, st);
    if not (st.running and not vm.had_exception and frame.ip == stp_p0 + 1) {
        return;
    }
    if len(vm.stack) < frame.stack_base + 2 {
        # Degenerate stack (never produced by the matched emission): leave
        # `this` pushed and fall through to the original SWAP tail.
        return;
    }
    stp_n: int = len(vm.stack);
    stp_t: JSValue = vm.stack[stp_n - 1];
    vm.stack[stp_n - 1] = vm.stack[stp_n - 2];
    vm.stack[stp_n - 2] = stp_t;
    stp_sp: Instruction = frame.func.code[stp_p0 + 2];
    # ip = delegated position + 1 (see GET_LLC_PROP note): SET_PROP's arg3
    # key-cache and holder=2/3 shape-IC fills patch code[frame.ip - 1].
    frame.ip = stp_p0 + 3;
    vm._op_set_prop(frame, stp_sp, st);
    if not (st.running and not vm.had_exception and frame.ip == stp_p0 + 3) {
        return;
    }
    vm._pop();
    frame.ip = stp_p0 + 4;
}

"""PROP_INC: postfix `this.k++` / `local.k++` (see op.jac). Fast path: an
own writable int32 data property of a plain object, bumped in place by
js_object_own_int_add — no getter, setter, proxy trap or valueOf can run, so
the whole window's effect is that one write plus pushing the old value (not
for the statement and `+= c` forms; the int32 + int32 ADD of the latter
cannot concatenate). The key id is cached in ins.ic_obj (ic_holder = 1).
Slow path: replicate the head load and fall through to the originals."""
def _vm_op_prop_inc(vm: VM, frame: CallFrame, ins: Instruction, st: ExecState) -> None {
    pi_p0: int = frame.ip - 1;
    pi_recv: JSValue = js_undefined();
    pi_ok: bool = True;
    if (ins.arg3 & 2) != 0 {
        pi_recv = frame.locals[frame.lb + (ins.arg)];
    } elif frame.this_binding_cell != 0 or frame.this_uninitialized {
        pi_ok = False;
    } else {
        pi_recv = frame.this_val;
    }
    if pi_ok
        and jsv_is_object_cell(pi_recv)
        and not js_is_tdz(pi_recv)
        and not js_is_proxy(pi_recv) {
        if ins.ic_holder != 1 {
            ins.ic_obj = str_intern(
                frame.func.constants.get(frame.func.code[pi_p0 + 1].arg)
            );
            ins.ic_holder = 1;
        }
        pi_old: JSValue = js_object_own_int_add(pi_recv, ins.ic_obj, ins.arg2);
        if not jsv_is_hole(pi_old) {
            if (ins.arg3 & 8) != 0 {
                frame.ip = pi_p0 + 8;
            } elif (ins.arg3 & 1) != 0 {
                frame.ip = pi_p0 + 12;
            } else {
                vm.stack.append(pi_old);
                frame.ip = pi_p0 + 11;
            }
            return;
        }
    }
    # Slow path: the head op was LOAD_THIS (reads no ins fields) or a local
    # load (TDZ-checked per arg3 bit 2).
    if (ins.arg3 & 2) == 0 {
        vm._op_load_this(frame, ins, st);
        return;
    }
    if (ins.arg3 & 4) != 0 and js_is_tdz(pi_recv) {
        pi_name: str = "";
        if ins.arg < len(frame.func.locals) {
            pi_name = frame.func.locals[ins.arg];
        }
        exc_pi: JSValue = make_reference_error(
            "Cannot access '" + pi_name + "' before initialization"
        );
        if not vm._unwind_in_frame(frame, exc_pi) {
            vm.had_exception = True;
            vm.pending_exc = exc_pi;
            st.running = False;
        }
        return;
    }
    vm.stack.append(pi_recv);
}

"""SET_LL_PROP: the statement `localObj.key = localVal;` — push obj then
val (the SWAP's net effect), delegate to the ORIGINAL SET_PROP at head+3
(ip convention: see GET_LLC_PROP), replicate the POP."""
def _vm_op_set_ll_prop(
    vm: VM, frame: CallFrame, ins: Instruction, st: ExecState
) -> None {
    slp_p0: int = frame.ip - 1;
    slp_o: JSValue = frame.locals[frame.lb + (ins.arg2 & 65535)];
    if (ins.arg2 >> 20) & 1 == 1 and js_is_tdz(slp_o) {
        # Original throw point: after the (unobservable) value push; the
        # extra stack slot is trimmed identically by unwind either way.
        slp_name: str = "";
        slp_os: int = ins.arg2 & 65535;
        if slp_os < len(frame.func.locals) {
            slp_name = frame.func.locals[slp_os];
        }
        exc_slp: JSValue = make_reference_error(
            "Cannot access '" + slp_name + "' before initialization"
        );
        if not vm._unwind_in_frame(frame, exc_slp) {
            vm.had_exception = True;
            vm.pending_exc = exc_slp;
            st.running = False;
        }
        return;
    }
    vm._push(slp_o);
    vm._push(frame.locals[frame.lb + (ins.arg)]);
    slp_sp: Instruction = frame.func.code[slp_p0 + 3];
    frame.ip = slp_p0 + 4;
    vm._op_set_prop(frame, slp_sp, st);
    if not (st.running and not vm.had_exception and frame.ip == slp_p0 + 4) {
        return;
    }
    vm._pop();
    frame.ip = slp_p0 + 5;
}

"""SET_LL_INDEX: `obj[key] = val` from three locals. arg=slot_obj;
arg2=slot_key|checked_obj<<20; arg3=slot_val. Delegates each step to the
original instructions so coercion order/throw points are identical."""
def _vm_op_set_ll_index(
    vm: VM, frame: CallFrame, ins: Instruction, st: ExecState
) -> None {
    sl_p0: int = frame.ip - 1;
    sl_o: JSValue = frame.locals[frame.lb + (ins.arg)];
    if (ins.arg2 >> 20) & 1 == 1 and js_is_tdz(sl_o) {
        sl_name: str = "";
        if ins.arg < len(frame.func.locals) {
            sl_name = frame.func.locals[ins.arg];
        }
        exc_sl: JSValue = make_reference_error(
            "Cannot access '" + sl_name + "' before initialization"
        );
        if not vm._unwind_in_frame(frame, exc_sl) {
            vm.had_exception = True;
            vm.pending_exc = exc_sl;
            st.running = False;
        }
        return;
    }
    vm._push(sl_o);
    sl_rc: Instruction = frame.func.code[sl_p0 + 1];
    # Each delegation runs with ip = its position + 1 (see GET_LLC_PROP
    # note) so any self-patching lands on the right instruction and throw
    # ips match the unfused execution exactly.
    frame.ip = sl_p0 + 2;
    vm._op_require_coercible(frame, sl_rc, st);
    if not (st.running and not vm.had_exception and frame.ip == sl_p0 + 2) {
        return;
    }
    vm._push(frame.locals[frame.lb + (ins.arg2 & 65535)]);
    sl_tk: Instruction = frame.func.code[sl_p0 + 3];
    frame.ip = sl_p0 + 4;
    vm._op_to_property_key(frame, sl_tk, st);
    if not (st.running and not vm.had_exception and frame.ip == sl_p0 + 4) {
        return;
    }
    vm._push(frame.locals[frame.lb + (ins.arg3)]);
    sl_si: Instruction = frame.func.code[sl_p0 + 5];
    frame.ip = sl_p0 + 6;
    vm._op_set_index(frame, sl_si, st);
}


glob _OPCODE_TABLE:
         dict[Opcode, Callable[[VM, CallFrame, Instruction, ExecState], None]] = {},
     _OPCODE_TABLE_D: list[Callable[[VM, CallFrame, Instruction, ExecState], None]] = [],
     _OPCODE_TABLE_D_N: int = 0;

# Dense dispatch table (dispatch_impl_plan Phase 1): indexed by int(opcode).
# One bounds compare + array load replaces two dict probes per instruction.
# Size 160 leaves headroom past the current max opcode value (137) — a new
# opcode beyond that must grow it (the build loop asserts coverage loudly).
"""Run opcode `dop` through the dense table; False if it is out of range.
The handler local lives here, not in `_exec`'s loop body, where the native
compiler would release it on every dispatch (V0.2)."""
def _vm_dispatch_d(
    vm: VM, frame: CallFrame, ins: Instruction, st: ExecState, dop: int
) -> bool {
    if dop < 0 or dop >= _OPCODE_TABLE_D_N {
        return False;
    }
    # Called straight off the table: binding the handler to a local cost a
    # closure retain/release on every table-dispatched instruction.
    _OPCODE_TABLE_D[dop](vm, frame, ins, st);
    return True;
}

# JS_INLINE_CALLS=0 lever (call_path_impl_plan Phase 3): disables the
# same-loop inline call path (plain sync closure calls run in the SAME
# _exec loop instead of natively recursing run_cl->run->_exec).
glob _INLINE_CALLS_ON: int = 1,
     _REG_VERIFY: int = 0,
     _REG_STATS_ON: int = 0,
     _REG_BRIDGE_STATS: dict[int, int] = {};

# JS_REG_VERIFY=1: after every bridged stack handler the register loop
# checks that the handler left exactly the expected number of results on
# the operand stack (a wrong entry in regisa's stack-effect table shows up
# here instead of as silent register corruption).

# JS_REG_STATS=1: histogram of the stack opcodes the register loop bridged
# (which ops to give native register cases next), printed at exit.
def:pub vm_reg_stats_set(on: bool) {
    _REG_STATS_ON = 1 if on else 0;
}

def _reg_stat_bump(dop: int) {
    if dop in _REG_BRIDGE_STATS {
        _REG_BRIDGE_STATS[dop] = _REG_BRIDGE_STATS[dop] + 1;
    } else {
        _REG_BRIDGE_STATS[dop] = 1;
    }
}

# JS_REG_STATS=1: bridged ops by (opcode, kind of the first operand).
glob _REG_BRIDGE_KINDS: dict[int, int] = {},
     _REG_KIND_NAMES: list[str] = [
         "-",
         "nullish",
         "number",
         "string",
         "bool",
         "object",
         "closure",
         "native",
         "other"
     ],
     _REG_BRIDGE_NATIVES: dict[int, int] = {},
     _REG_NATIVE_NAMES: dict[int, str] = {},
     _REG_BRIDGE_GPKEYS: dict[str, int] = {},
     _REG_BRIDGE_FNS: dict[str, int] = {},
     _REG_BRIDGE_IDX: dict[str, int] = {};

# JS_REG_STATS=1: bridged GET_PROP sites by property name, bridged CALL /
# CALL_METHOD closures by function name.

# bridged GET_INDEX / SET_INDEX by receiver[key] kind, bridged NEW by reason
"""JS_REG_STATS: the kind of a bridged op's receiver."""
def _reg_stat_recv_kind(v: JSValue) -> str {
    if is_fn_val(v) {
        return "fn";
    }
    if is_native_val(v) {
        return "native";
    }
    if jsv_is_string_cell(v) {
        return "string";
    }
    if jsv_is_undefined(v) or jsv_is_null(v) {
        return "nullish";
    }
    if not jsv_is_object_cell(v) {
        return "prim";
    }
    if js_is_proxy(v) {
        return "proxy";
    }
    rk_id: int = jsv_to_table_id(v);
    if rk_id <= 0 {
        return "obj0";
    }
    if js_is_array(v) {
        return "array";
    }
    rk_cf: int = js_object_table_get(rk_id).cell_flags;
    if (rk_cf & FLAG_IS_CLASS) != 0 {
        return "class";
    }
    if (rk_cf & FLAG_MODULE_NS) != 0 {
        return "modns";
    }
    if (rk_cf & FLAG_IS_ARGUMENTS) != 0 {
        return "args";
    }
    if js_object_binary_kind_id(rk_id) != 0 {
        return "binary";
    }
    if js_object_brand(v) != 0 {
        return "brand" + str(js_object_brand(v));
    }
    if js_object_ic_shape(v) < 0 {
        return "dict";
    }
    return "plain";
}

def _reg_stat_key_kind(v: JSValue) -> str {
    if jsv_is_int32(v) {
        if jsv_to_int32(v) < 0 {
            return "negint";
        }
        return "int";
    }
    if jsv_is_double(v) {
        return "double";
    }
    if jsv_is_string_cell(v) {
        return "str";
    }
    if jsv_is_symbol(v) {
        return "sym";
    }
    return _reg_stat_recv_kind(v);
}

"""JS_REG_STATS: why a NEW took the handler (the register path's checks)."""
def _reg_stat_new_reason(v: JSValue) -> str {
    if is_native_val(v) {
        return "native " + get_native_name(v);
    }
    if is_fn_val(v) {
        return "function";
    }
    if jsv_is_object_cell(v)
        and jsv_to_table_id(v) > 0
        and (js_object_table_get(jsv_to_table_id(v)).cell_flags & FLAG_IS_CLASS) != 0 {
        nr_s: str = "class";
        if js_object_has_own(v, WK_SUPER) {
            nr_s = nr_s + " derived";
        }
        nr_f: JSValue = js_object_get(v, WK_FIELDS);
        if jsv_is_object_cell(nr_f) and jsv_to_table_id(nr_f) >= 0 {
            nr_fl: JSValue = js_object_get(nr_f, WK_LENGTH);
            if not jsv_is_int32(nr_fl) or jsv_to_int32(nr_fl) != 0 {
                nr_s = nr_s + " fields";
            }
        }
        if not is_fn_val(js_object_get(v, WK_CTOR)) {
            nr_s = nr_s + " default-ctor";
        }
        return nr_s;
    }
    if jsv_is_object_cell(v)
        and jsv_to_table_id(v) > 0
        and js_object_has_own(v, KEY_CTOR_KIND) {
        nr_ck: JSValue = js_object_get(v, KEY_CTOR_KIND);
        nr_nm: JSValue = js_object_get(v, WK_NAME);
        nr_ns: str = "?";
        if jsv_is_string_cell(nr_nm) {
            nr_ns = str_from_id(jsv_to_table_id(nr_nm));
        }
        if jsv_is_int32(nr_ck) {
            return "ctor-object " + nr_ns + " (kind " + str(jsv_to_int32(nr_ck)) + ")";
        }
    }
    return _reg_stat_recv_kind(v);
}

def _reg_stat_name(tab: dict[str, int], name: str) {
    if name in tab {
        tab[name] = tab[name] + 1;
    } else {
        tab[name] = 1;
    }
}

"""The keys of a name-count table, largest count first (top `limit`)."""
def _reg_stats_sorted_names(tab: dict[str, int], limit: int) -> list[str] {
    sn_keys: list[str] = [];
    for sn_k in tab {
        sn_keys.append(sn_k);
    }
    sn_i: int = 0;
    while sn_i < len(sn_keys) and sn_i < limit {
        sn_best: int = sn_i;
        sn_j: int = sn_i + 1;
        while sn_j < len(sn_keys) {
            if tab[sn_keys[sn_j]] > tab[sn_keys[sn_best]] {
                sn_best = sn_j;
            }
            sn_j = sn_j + 1;
        }
        sn_t: str = sn_keys[sn_i];
        sn_keys[sn_i] = sn_keys[sn_best];
        sn_keys[sn_best] = sn_t;
        sn_i = sn_i + 1;
    }
    return sn_keys;
}

def _reg_stat_kind(dop: int, v: JSValue) {
    if is_native_val(v) {
        rnk: int = get_native_kind(v);
        if rnk in _REG_BRIDGE_NATIVES {
            _REG_BRIDGE_NATIVES[rnk] = _REG_BRIDGE_NATIVES[rnk] + 1;
        } else {
            _REG_BRIDGE_NATIVES[rnk] = 1;
            _REG_NATIVE_NAMES[rnk] = get_native_name(v);
        }
    }
    rk: int = 8;
    if jsv_is_undefined(v) or jsv_is_null(v) {
        rk = 1;
    } elif jsv_is_int32(v) or jsv_is_double(v) {
        rk = 2;
    } elif jsv_is_string_cell(v) {
        rk = 3;
    } elif jsv_is_bool(v) {
        rk = 4;
    } elif is_fn_val(v) {
        rk = 6;
    } elif is_native_val(v) {
        rk = 7;
    } elif jsv_is_object_cell(v) {
        rk = 5;
    }
    rkey: int = dop * 16 + rk;
    if rkey in _REG_BRIDGE_KINDS {
        _REG_BRIDGE_KINDS[rkey] = _REG_BRIDGE_KINDS[rkey] + 1;
    } else {
        _REG_BRIDGE_KINDS[rkey] = 1;
    }
}

"""The keys of a count table, largest count first."""
def _reg_stats_sorted(tab: dict[int, int]) -> list[int] {
    ss_keys: list[int] = [];
    for ss_k in tab {
        ss_keys.append(ss_k);
    }
    ss_i: int = 0;
    while ss_i < len(ss_keys) {
        ss_best: int = ss_i;
        ss_j: int = ss_i + 1;
        while ss_j < len(ss_keys) {
            if tab[ss_keys[ss_j]] > tab[ss_keys[ss_best]] {
                ss_best = ss_j;
            }
            ss_j = ss_j + 1;
        }
        ss_t: int = ss_keys[ss_i];
        ss_keys[ss_i] = ss_keys[ss_best];
        ss_keys[ss_best] = ss_t;
        ss_i = ss_i + 1;
    }
    return ss_keys;
}

def:pub vm_reg_verify_set(on: bool) {
    _REG_VERIFY = 1 if on else 0;
}

# Diagnostics: inline-call entries this process (printed by
# vm_dump_pair_stats when JS_PAIR_STATS=1).
glob _INLINE_CALL_COUNT: int = 0,
     _INLINE_REJ: dict[int, int] = {};

"""Count one inline-call entry (JS_PAIR_STATS). A module-level def: the same
glob assignment inside a VM method updated a method-local copy, so the
printed total stayed 0."""
def _inline_count_bump {
    _INLINE_CALL_COUNT = _INLINE_CALL_COUNT + 1;
}

def _inline_rej(reason: int) -> None {
    if not _PAIR_STATS_ON {
        return;
    }
    if reason in _INLINE_REJ {
        _INLINE_REJ[reason] = _INLINE_REJ[reason] + 1;
    } else {
        _INLINE_REJ[reason] = 1;
    }
}

def:pub vm_inline_calls_enable(on: bool) {
    _INLINE_CALLS_ON = 1 if on else 0;
}

"""True unless JS_INLINE_CALLS=0 (read back by feature_gates_report)."""
def:pub vm_inline_calls_enabled -> bool {
    return _INLINE_CALLS_ON == 1;
}

def _vm_op_bad(vm: VM, frame: CallFrame, ins: Instruction, st: ExecState) {
    print("[VM FATAL] unknown opcode");
    st.running = False;
}

# Diagnostics: dynamic (op, next-op) pair histogram (JS_PAIR_STATS=1) — the
# data source for superinstruction candidate selection. Costs one glob-bool
# branch per instruction when off; dict updates per instruction when on.
glob _PAIR_STATS_ON: bool = False,
     _FN_PROF_ON: bool = False,
     _FN_PROF_EVERY: int = 997,
     _FN_PROF_CTR: list[int] = [997],
     _FN_PROF_FNS: dict[str, int] = {},
     _FN_PROF_LINES: dict[str, int] = {};

# JS_FN_PROF=1: sampling JS profiler. Every _FN_PROF_EVERY-th dispatch charges
# one sample to the running function and to its source line; the top entries
# print at exit (vm_dump_pair_stats). Counts bytecode dispatches, so time inside
# a native builtin shows as one sample for its call instruction.
def _fn_prof_sample(fn: CompiledFunction, line: int) {
    fpk: str = fn.name + "  (" + fn.file + ")";
    _FN_PROF_FNS[fpk] = _FN_PROF_FNS.get(fpk, 0) + 1;
    fpl: str = fn.file + ":" + str(line) + "  " + fn.name;
    _FN_PROF_LINES[fpl] = _FN_PROF_LINES.get(fpl, 0) + 1;
}

def _fn_prof_print_top(title: str, d: dict[str, int], k: int) {
    total: int = 0;
    for tk in d {
        total = total + d[tk];
    }
    print(
        "== "
            + title
            + " ("
            + str(total)
            + " samples, 1 per "
            + str(_FN_PROF_EVERY)
            + " dispatches) =="
    );
    taken: dict[str, int] = {};
    r: int = 0;
    while r < k {
        best: str = "";
        best_n: int = -1;
        for ck in d {
            if ck in taken {
                continue;
            }
            if d[ck] > best_n {
                best_n = d[ck];
                best = ck;
            }
        }
        if best_n < 0 {
            break;
        }
        taken[best] = 1;
        pct: int = (best_n * 1000) // (total if total > 0 else 1);
        print(str(best_n) + "  " + str(pct // 10) + "." + str(pct % 10) + "%  " + best);
        r = r + 1;
    }
}

glob _PAIR_STATS: dict[int, int] = {},
     _TRI_STATS: dict[int, int] = {},
     _TRI_PREV: list[int] = [-1];

# Trigram histogram (same gate). prev-op tracking crosses frame boundaries
# on CALL/RETURN — acceptable noise for a diagnostics mode.

# one-element box: rebinding a glob from a method creates a local; mutation
# through the list does not.
def:pub vm_dump_pair_stats -> None {
    if _REG_STATS_ON == 1 {
        rs_keys: list[int] = _reg_stats_sorted(_REG_BRIDGE_STATS);
        print("register loop: bridged stack ops by opcode");
        rs_i: int = 0;
        while rs_i < len(rs_keys) and rs_i < 40 {
            print(
                "  "
                    + opcode_name(opcode_from_int(rs_keys[rs_i]))
                    + " "
                    + str(_REG_BRIDGE_STATS[rs_keys[rs_i]])
            );
            rs_i = rs_i + 1;
        }
        rs_kkeys: list[int] = _reg_stats_sorted(_REG_BRIDGE_KINDS);
        print("register loop: bridged stack ops by opcode / first operand");
        rs_i = 0;
        while rs_i < len(rs_kkeys) and rs_i < 40 {
            print(
                "  "
                    + opcode_name(opcode_from_int(rs_kkeys[rs_i] // 16))
                    + "/"
                    + _REG_KIND_NAMES[rs_kkeys[rs_i] & 15]
                    + " "
                    + str(_REG_BRIDGE_KINDS[rs_kkeys[rs_i]])
            );
            rs_i = rs_i + 1;
        }
        print(
            "prototype epoch bumps: "
                + str(proto_epoch())
                + " (by GC sweep: "
                + str(proto_epoch_gc_bumps())
                + ")"
        );
        rs_gkeys: list[str] = _reg_stats_sorted_names(_REG_BRIDGE_GPKEYS, 40);
        print("register loop: bridged GET_PROP by property name @ receiver kind");
        rs_i = 0;
        while rs_i < len(rs_gkeys) and rs_i < 40 {
            print(
                "  " + rs_gkeys[rs_i] + " " + str(_REG_BRIDGE_GPKEYS[rs_gkeys[rs_i]])
            );
            rs_i = rs_i + 1;
        }
        rs_ikeys: list[str] = _reg_stats_sorted_names(_REG_BRIDGE_IDX, 30);
        print("register loop: bridged GET_INDEX / SET_INDEX / NEW by kind");
        rs_i = 0;
        while rs_i < len(rs_ikeys) and rs_i < 30 {
            print("  " + rs_ikeys[rs_i] + " " + str(_REG_BRIDGE_IDX[rs_ikeys[rs_i]]));
            rs_i = rs_i + 1;
        }
        rs_fkeys: list[str] = _reg_stats_sorted_names(_REG_BRIDGE_FNS, 30);
        print("register loop: bridged closure calls by function name");
        rs_i = 0;
        while rs_i < len(rs_fkeys) and rs_i < 30 {
            print("  " + rs_fkeys[rs_i] + " " + str(_REG_BRIDGE_FNS[rs_fkeys[rs_i]]));
            rs_i = rs_i + 1;
        }
        rs_nkeys: list[int] = _reg_stats_sorted(_REG_BRIDGE_NATIVES);
        print("register loop: bridged native callees by kind");
        rs_i = 0;
        while rs_i < len(rs_nkeys) and rs_i < 30 {
            print(
                "  "
                    + _REG_NATIVE_NAMES[rs_nkeys[rs_i]]
                    + " ("
                    + str(rs_nkeys[rs_i])
                    + ") "
                    + str(_REG_BRIDGE_NATIVES[rs_nkeys[rs_i]])
            );
            rs_i = rs_i + 1;
        }
    }
    if _FN_PROF_ON {
        _fn_prof_print_top("JS functions by dispatches", _FN_PROF_FNS, 40);
        _fn_prof_print_top("JS lines by dispatches", _FN_PROF_LINES, 40);
    }
    if _PAIR_STATS_ON {
        print("inline calls: " + str(_INLINE_CALL_COUNT));
        for irj in _INLINE_REJ {
            print("inline reject r" + str(irj) + ": " + str(_INLINE_REJ[irj]));
        }
    }
    if not _PAIR_STATS_ON {
        return;
    }
    ps_keys: list[int] = [];
    for ps_k in _PAIR_STATS {
        ps_keys.append(ps_k);
    }
    # selection-sort top 25 by count (diagnostics path; size is ~100s)
    ps_n: int = len(ps_keys);
    ps_i: int = 0;
    while ps_i < ps_n {
        ps_best: int = ps_i;
        ps_j: int = ps_i + 1;
        while ps_j < ps_n {
            if _PAIR_STATS[ps_keys[ps_j]] > _PAIR_STATS[ps_keys[ps_best]] {
                ps_best = ps_j;
            }
            ps_j = ps_j + 1;
        }
        ps_t: int = ps_keys[ps_i];
        ps_keys[ps_i] = ps_keys[ps_best];
        ps_keys[ps_best] = ps_t;
        ps_i = ps_i + 1;
        if ps_i >= 25 {
            break;
        }
    }
    # int→name via the populated dispatch dict (no int→Opcode cast exists)
    ps_names: dict[int, str] = {};
    for ps_ok in _OPCODE_TABLE {
        ps_names[int(ps_ok)] = opcode_name(ps_ok);
    }
    # trigrams first (reuses ps_names below via a second pass)
    print("== opcode pair histogram (top 25) ==");
    ps_p: int = 0;
    while ps_p < ps_n and ps_p < 25 {
        ps_key: int = ps_keys[ps_p];
        ps_a: str = str(ps_key // 256);
        ps_b: str = str(ps_key % 256);
        if (ps_key // 256) in ps_names {
            ps_a = ps_names[ps_key // 256];
        }
        if (ps_key % 256) in ps_names {
            ps_b = ps_names[ps_key % 256];
        }
        print(str(_PAIR_STATS[ps_key]) + "  " + ps_a + " -> " + ps_b);
        ps_p = ps_p + 1;
    }
    # trigram top 15
    tri_keys: list[int] = [];
    for tri_k in _TRI_STATS {
        tri_keys.append(tri_k);
    }
    tri_n: int = len(tri_keys);
    tri_i: int = 0;
    while tri_i < tri_n {
        tri_best: int = tri_i;
        tri_j: int = tri_i + 1;
        while tri_j < tri_n {
            if _TRI_STATS[tri_keys[tri_j]] > _TRI_STATS[tri_keys[tri_best]] {
                tri_best = tri_j;
            }
            tri_j = tri_j + 1;
        }
        tri_t: int = tri_keys[tri_i];
        tri_keys[tri_i] = tri_keys[tri_best];
        tri_keys[tri_best] = tri_t;
        tri_i = tri_i + 1;
        if tri_i >= 15 {
            break;
        }
    }
    print("== opcode trigram histogram (top 15) ==");
    tri_p: int = 0;
    while tri_p < tri_n and tri_p < 15 {
        tri_key: int = tri_keys[tri_p];
        tri_a: int = tri_key // 65536;
        tri_b: int = (tri_key // 256) % 256;
        tri_c: int = tri_key % 256;
        tri_sa: str = str(tri_a);
        tri_sb: str = str(tri_b);
        tri_sc: str = str(tri_c);
        if tri_a in ps_names {
            tri_sa = ps_names[tri_a];
        }
        if tri_b in ps_names {
            tri_sb = ps_names[tri_b];
        }
        if tri_c in ps_names {
            tri_sc = ps_names[tri_c];
        }
        print(
            str(_TRI_STATS[tri_key]) + "  " + tri_sa + " -> " + tri_sb + " -> " + tri_sc
        );
        tri_p = tri_p + 1;
    }
}

