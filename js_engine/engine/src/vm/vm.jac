    _OPCODE_TABLE[Opcode.GET_ASYNC_ITER] = _vm_op_get_async_iter;
    _OPCODE_TABLE[Opcode.ASYNC_ITER_NEXT] = _vm_op_async_iter_next;
    _OPCODE_TABLE[Opcode.THROW] = _vm_op_throw;
    _OPCODE_TABLE[Opcode.PUSH_CATCH] = _vm_op_push_catch;
    _OPCODE_TABLE[Opcode.POP_CATCH] = _vm_op_pop_catch;
    _OPCODE_TABLE[Opcode.PUSH_FINALLY] = _vm_op_push_finally;
    _OPCODE_TABLE[Opcode.POP_FINALLY] = _vm_op_pop_finally;
    _OPCODE_TABLE[Opcode.SPREAD] = _vm_op_spread;
    _OPCODE_TABLE[Opcode.ITER_NEXT_VAL] = _vm_op_iter_next_val;
    _OPCODE_TABLE[Opcode.REST_ARGS] = _vm_op_rest_args;
    _OPCODE_TABLE[Opcode.OBJECT_SPREAD] = _vm_op_object_spread;
    _OPCODE_TABLE[Opcode.UNPACK_ARRAY] = _vm_op_unpack_array;
    _OPCODE_TABLE[Opcode.UNPACK_OBJECT] = _vm_op_unpack_object;
    _OPCODE_TABLE[Opcode.NOP] = _vm_op_nop;
    _OPCODE_TABLE[Opcode.DEBUGGER] = _vm_op_nop;
    _OPCODE_TABLE[Opcode.TDZ_CLASS] = _vm_op_nop;
    _OPCODE_TABLE[Opcode.FILLER] = _vm_op_filler;
    _OPCODE_TABLE[Opcode.LOCAL_INC] = _vm_op_local_inc;
    _OPCODE_TABLE[Opcode.BR_CMP_LL] = _vm_op_br_cmp_ll;
    _OPCODE_TABLE[Opcode.GET_LL_INDEX] = _vm_op_get_ll_index;
    _OPCODE_TABLE[Opcode.SET_LL_INDEX] = _vm_op_set_ll_index;
    _OPCODE_TABLE[Opcode.GET_LLC_PROP] = _vm_op_get_llc_prop;
    _OPCODE_TABLE[Opcode.SET_THIS_PROP] = _vm_op_set_this_prop;
    _OPCODE_TABLE[Opcode.SET_LL_PROP] = _vm_op_set_ll_prop;
    _OPCODE_TABLE[Opcode.PROP_INC] = _vm_op_prop_inc;
    # Dense mirror. Duplicate-value detection is LOUD: the historic
    # duplicate-opcode incident silently overwrote a dict entry.
    _OPCODE_TABLE_D = [];
    dtd_i: int = 0;
    while dtd_i < 160 {
        _OPCODE_TABLE_D.append(_vm_op_bad);
        dtd_i = dtd_i + 1;
    }
    dtd_seen: dict[int, int] = {};
    for dtd_k in _OPCODE_TABLE {
        dtd_v: int = int(dtd_k);
        if dtd_v < 0 or dtd_v >= 160 {
            print("[VM FATAL] opcode value out of dense-table range: " + str(dtd_v));
        } else {
            if dtd_v in dtd_seen {
                print("[VM FATAL] duplicate opcode value: " + str(dtd_v));
            }
            dtd_seen[dtd_v] = 1;
            _OPCODE_TABLE_D[dtd_v] = _OPCODE_TABLE[dtd_k];
        }
    }
    _OPCODE_TABLE_D_N = len(_OPCODE_TABLE_D);
    init_observable_property_access();
    vm_wasm_init_host_bridge();
}
