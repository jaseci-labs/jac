            }
            return args[0];
        }
        return js_boolean(ok_ta_dp);
    }
    # JS closures keep user-defined properties in their fn_props object. Route
    # defineProperty there so accessor descriptors, including symbol keys such as
    # @@species, remain observable through function property access and reflection.
    if kind == NATIVE_KIND_OBJ_DEFINE_PROPERTY
        and len(args) >= 3
        and is_fn_val(args[0]) {
        return _vm_function_define_property(vm, args[0], args[1], args[2], True);
    }
    if kind == NATIVE_KIND_REFLECT_DEFINE_PROPERTY
        and len(args) >= 3
        and is_fn_val(args[0]) {
        return _vm_function_define_property(vm, args[0], args[1], args[2], False);
    }
    # R3: Object/Reflect.defineProperty on native builtins — redirect onto the
    # lazy props store and clear name/length tombstones on restore.
    if kind == NATIVE_KIND_OBJ_DEFINE_PROPERTY
        and len(args) >= 3
        and is_native_val(args[0]) {
        return _vm_native_define_property(args[0], args[1], args[2], True);
    }
    if kind == NATIVE_KIND_REFLECT_DEFINE_PROPERTY
        and len(args) >= 3
        and is_native_val(args[0]) {
        return _vm_native_define_property(args[0], args[1], args[2], False);
    }
    if kind == NATIVE_KIND_OBJ_PREVENT_EXTENSIONS and len(args) >= 1 {
        if js_is_proxy(args[0]) {
            pe_ok: bool = proxy_trap_prevent_extensions(vm, args[0]);
            if vm_has_native_exc() {
                return js_undefined();
            }
            if not pe_ok {
                vm_throw_native(
                    make_type_error("Object.preventExtensions returned false")
                );
                return js_undefined();
            }
            return args[0];
        }
        if vm._ta_is_instance(args[0]) {
            if not vm._ta_prevent_extensions(args[0]) and not vm_has_native_exc() {
                vm_throw_native(
                    make_type_error("Cannot prevent extensions on this TypedArray")
                );
            }
            return args[0];
        }
    }
    # Object.seal / Object.freeze on a Proxy — §7.3.15 SetIntegrityLevel: invoke
    # [[PreventExtensions]] (the proxy trap) and throw a TypeError if it reports
    # false. The native js_Object_seal/freeze operate on a plain property map and
    # never consult the trap, so a Proxy whose preventExtensions returns false
    # was sealed/frozen silently instead of throwing.
    if (kind == NATIVE_KIND_OBJ_STATIC_SEAL or kind == NATIVE_KIND_OBJ_STATIC_FREEZE)
        and len(args) >= 1
        and js_is_proxy(args[0]) {
        pe_ok: bool = proxy_trap_prevent_extensions(vm, args[0]);
        if vm_has_native_exc() {
            return js_undefined();
        }
        if not pe_ok {
            vm_throw_native(
                make_type_error("Cannot seal/freeze: object is not extensible")
            );
            return js_undefined();
        }
        # PreventExtensions succeeded; the trap has applied it to the target.
        # Property-level sealing of a Proxy would require per-key defineProperty
        # traps (§7.3.15 step 5); no current test exercises that path, and the
        # target's own properties are already handled by the trap's target
        # mutation, so return the proxy.
        return args[0];
    }
    if kind == NATIVE_KIND_OBJ_IS_EXTENSIBLE
        and len(args) >= 1
        and js_is_proxy(args[0]) {
        return js_boolean(proxy_trap_is_extensible(vm, args[0]));
    }
    # Reflect.has / deleteProperty / isExtensible / preventExtensions /
    # getOwnPropertyDescriptor must route through the proxy traps when the target
    # is a Proxy (ES §28.1), mirroring the Reflect.get/set/defineProperty paths
    # above.  The js_Reflect_* dispatch handlers are the *non-proxy* fallback only.
    if kind == NATIVE_KIND_REFLECT_HAS and len(args) >= 2 {
        pk_rh: int = vm.obs_to_property_key(args[1]);
        if vm_has_native_exc() {
            return js_false();
        }
        if js_is_proxy(args[0]) {
            return js_boolean(proxy_trap_has(vm, args[0], pk_rh));
        }
        # Typed-array + module-namespace instances have exotic [[HasProperty]].
        if vm._ta_is_instance(args[0]) or js_is_module_namespace(args[0]) {
            return js_boolean(vm.obs_has(args[0], pk_rh));
        }
        # Deferred namespace: [[HasProperty]] triggers evaluation (then fall through).
        vm._defer_ns_maybe_eval(args[0], pk_rh, False);
        if vm.had_exception {
            exc_rh: JSValue = vm.pending_exc;
            vm.had_exception = False;
            vm.pending_exc = js_undefined();
            vm_throw_native(exc_rh);
            return js_false();
        }
        if vm_has_native_exc() {
            return js_false();
        }
    }
    if kind == NATIVE_KIND_REFLECT_DELETE_PROPERTY
        and len(args) >= 2
        and js_is_proxy(args[0]) {
        # Handled above via _vm_reflect_delete_property; keep unreachable fallback.
        pk_rd: int = vm.obs_to_property_key(args[1]);
        if vm_has_native_exc() {
            return js_false();
        }
        return js_boolean(proxy_trap_delete(vm, args[0], pk_rd));
    }
    if kind == NATIVE_KIND_REFLECT_IS_EXTENSIBLE
        and len(args) >= 1
        and js_is_proxy(args[0]) {
        return js_boolean(proxy_trap_is_extensible(vm, args[0]));
    }
    if kind == NATIVE_KIND_REFLECT_PREVENT_EXTENSIONS and len(args) >= 1 {
        if js_is_proxy(args[0]) {
            return js_boolean(proxy_trap_prevent_extensions(vm, args[0]));
        }
        if vm._ta_is_instance(args[0]) {
            return js_boolean(vm._ta_prevent_extensions(args[0]));
        }
    }
    if kind == NATIVE_KIND_REFLECT_GET_OWN_PROPERTY_DESCRIPTOR
        and len(args) >= 2
        and js_is_proxy(args[0]) {
        return proxy_trap_get_own_property_descriptor(vm, args[0], args[1]);
    }
    if kind == NATIVE_KIND_JSON_PARSE {
        return _vm_json_parse_with_hooks(vm, args);
    }
    if kind == NATIVE_KIND_JSON_STRINGIFY {
        return _vm_json_stringify_with_hooks(vm, args);
    }
    if kind == NATIVE_KIND_PROCESS_GET_BUILTIN_MODULE {
        gbm: JSValue = process_get_builtin_module(args, vm.globals);
        if jsv_is_undefined(gbm) and len(args) >= 1 and jsv_is_string_cell(args[0]) {
            bare_gbm: str = _strip_node_prefix(str_from_id(jsv_to_table_id(args[0])));
            if vm._is_js_builtin(bare_gbm) {
                return vm._require_module(bare_gbm);
            }
        }
        return gbm;
    }
    # Promise.all: VM path with real non-constructor element functions + thenable
    # adoption (Promises checked before thenables — prior regression lesson).
    if kind == NATIVE_KIND_PROMISE_ALL {
        return _vm_promise_all(vm, args);
    }
    # allSettled / any: expose element functions to thenables, then use dispatch
    # settling (incomplete _vm_promise_allsettled/_any stubs must not run).
    if kind == NATIVE_KIND_PROMISE_ALLSETTLED or kind == NATIVE_KIND_PROMISE_ANY {
        _vm_promise_expose_thenable_elems(vm, args, kind);
    }
    _push_native_obs_vm(vm);
    obs_res: JSValue = call_native(realm, kind, this_val, args, native_fn);
    _pop_native_obs_vm();
    # Refine ProxyCreate constructible bit with authoritative IsConstructor.
    if kind == NATIVE_KIND_PROXY and js_is_proxy(obs_res) and len(args) >= 1 {
        js_proxy_set_constructible(obs_res, _vm_is_constructor(vm, args[0]));
    }
    return obs_res;
}

"""Create a fresh VM with empty globals and no loaded module."""
def:pub make_vm -> VM {
    return VM(
        realm=realm_new(),
        stack=[],
        frames=[],
        globals={},
        global_this=js_undefined(),
        module_fns=[],
        pending_exc=js_undefined(),
        had_exception=False,
        call_depth=0,
        yielded=False,
        yielded_star=False,
        vm_awaiting=False,
        _cur_async_promise=js_undefined()
    );
}

"""
Invoke a JS closure value (tag=Object, as_ptr<0) with the given args on a VM.

Used by the event loop (vm/event_loop.na.jac) and timers (vm/timers.na.jac)
to fire JS callbacks that were scheduled from C-level libuv callbacks.

  fn_val   — a JSValue with tag=Object, as_ptr<0 (a closure reference)
  this_val — the `this` binding (pass js_undefined() for timer callbacks)
  args     — positional argument list

Returns the callback's return value.

On a synchronous throw from a non-async callback: dispatch process
'uncaughtException' listeners if any; otherwise print and request process
exit (code 1), matching Node.js. Clears had_exception either way so the
event-loop tick can finish / stop cleanly.
"""
def:pub vm_call_js_fn(
    vm: VM, fn_val: JSValue, this_val: JSValue, args: list[JSValue]
) -> JSValue {
    if jsv_is_object_cell(fn_val)
        and jsv_to_table_id(fn_val) > 0
        and js_is_resolve_fn(fn_val) {
        val_res_cf: JSValue = js_undefined();
        if len(args) > 0 {
            val_res_cf = args[0];
        }
        p_ref_res_cf: JSValue = js_object_get(fn_val, _KEY_PROMISE_REF);
        if js_is_promise(p_ref_res_cf) {
            vm._promise_resolve_value(p_ref_res_cf, val_res_cf);
        }
        vm.had_exception = False;
        return js_undefined();
    }
    if jsv_is_object_cell(fn_val)
        and jsv_to_table_id(fn_val) > 0
        and js_is_reject_fn(fn_val) {
        reason_rej_cf: JSValue = js_undefined();
        if len(args) > 0 {
            reason_rej_cf = args[0];
        }
        p_ref_rej_cf: JSValue = js_object_get(fn_val, _KEY_PROMISE_REF);
        if js_is_promise(p_ref_rej_cf) {
            vm._promise_settle_and_drain(p_ref_rej_cf, PROMISE_REJECTED, reason_rej_cf);
        }
        vm.had_exception = False;
        return js_undefined();
    }
    if jsv_is_object_cell(fn_val)
        and jsv_to_table_id(fn_val) > 0
        and js_is_promise_all_resolve_elem(fn_val) {
        val_pa_cf: JSValue = js_undefined();
        if len(args) > 0 {
            val_pa_cf = args[0];
        }
        _vm_promise_all_resolve_call(vm, fn_val, val_pa_cf);
        vm.had_exception = False;
        return js_undefined();
    }
    if jsv_is_object_cell(fn_val)
        and jsv_to_table_id(fn_val) > 0
        and js_is_promise_all_reject_elem(fn_val) {
        reason_pa_cf: JSValue = js_undefined();
        if len(args) > 0 {
            reason_pa_cf = args[0];
        }
        _vm_promise_all_reject_call(vm, fn_val, reason_pa_cf);
        vm.had_exception = False;
        return js_undefined();
    }
    if not is_fn_val(fn_val) {
        return js_undefined();
    }
    fn_idx: int = get_fn_idx(fn_val);
    if fn_idx >= len(vm.realm.closures) {
        return js_undefined();
    }
    cl: JSClosure = vm.realm.closures[fn_idx];
    if cl.func.is_async {
        old_cap: JSValue = vm._cur_async_promise;
        new_p: JSValue = js_promise_create();
        vm._cur_async_promise = new_p;
        res_async: JSValue = vm.run_cl(cl, fn_val, this_val, args);
        vm._cur_async_promise = old_cap;
        if vm.vm_awaiting {
            vm.vm_awaiting = False;
        } elif vm.had_exception {
            exc_async: JSValue = vm.pending_exc;
            vm.had_exception = False;
            vm.pending_exc = js_undefined();
            vm._promise_settle_and_drain(new_p, PROMISE_REJECTED, exc_async);
        } else {
            if js_is_promise(res_async) {
                st_async: int = js_promise_get_state(res_async);
                if st_async != PROMISE_PENDING {
                    vm._promise_settle_and_drain(
                        new_p, st_async, js_promise_get_value(res_async)
                    );
                } else {
                    js_promise_add_reaction(
                        res_async, js_undefined(), js_undefined(), new_p
                    );
                }
            } else {
                vm._promise_settle_and_drain(new_p, PROMISE_FULFILLED, res_async);
            }
        }
        return new_p;
    }
    result: JSValue = vm.run_cl(cl, fn_val, this_val, args);
    if vm.had_exception {
        exc_cb: JSValue = vm.pending_exc;
        vm.had_exception = False;
        vm.pending_exc = js_undefined();
        _vm_handle_callback_uncaught(vm, exc_cb);
        return js_undefined();
    }
    return result;
}

"""True when `fn` is top-level code of the program's entry script (not a module
reached through import())."""
def:priv _vm_is_entry_module_frame(vm: VM, fn: CompiledFunction) -> bool {
    if vm.entry_file == "" {
        return True;
    }
    return fn.file == vm.entry_file;
}

"""A rejection from a dynamically imported module's top-level await, after its
import() promise already resolved. Not fatal (the importer may well handle it in
Node); shown on stderr only with JS_ENGINE_DEBUG_TLA set."""
def:priv _vm_note_orphan_module_rejection(exc: JSValue) {
    if getenv("JS_ENGINE_DEBUG_TLA") != None {
        print_unhandled_rejection(exc);
    }
}

"""Dispatch uncaughtException listeners, or print + exit if none (Node semantics)."""
def:priv _vm_handle_callback_uncaught(vm: VM, exc: JSValue) {
    _vm_dispatch_fatal(vm, exc, "uncaughtException", False);
}

"""An unhandled promise rejection that no 'unhandledRejection' listener took.
Node's default (`--unhandled-rejections=throw`) raises it as an uncaught
exception: 'uncaughtException' listeners receive (reason, "unhandledRejection");
with none, the error is printed to stderr and the process exits 1. bun does the
same. Called by el_tick after the microtask checkpoint."""
def:pub vm_handle_unhandled_rejection(vm: VM, reason: JSValue) {
    _vm_dispatch_fatal(vm, reason, "unhandledRejection", True);
}

def:priv _vm_print_fatal(exc: JSValue, is_rejection: bool) {
    if is_rejection {
        print_unhandled_rejection(exc);
    } else {
        print_uncaught(exc);
    }
}

def:priv _vm_dispatch_fatal(
    vm: VM, exc: JSValue, origin_name: str, is_rejection: bool
) -> None {
    # Nested throw while already handling uncaughtException → force-exit.
    if _HANDLING_UNCAUGHT {
        _vm_print_fatal(exc, is_rejection);
        realm_request_exit(vm.realm);
        vm.realm.pending_exit_code = 1;
        if vm.realm.timer_loop_ptr != 0 {
            uv_stop(vm.realm.timer_loop_ptr);
        }
        return;
    }

    listeners: list[int] = process_get_uncaught_listeners();
    once_flags: list[int] = process_get_uncaught_once();
    n_listeners: int = len(listeners);

    if n_listeners == 0 {
        # Default Node behavior: print and terminate.
        _vm_print_fatal(exc, is_rejection);
        realm_request_exit(vm.realm);
        vm.realm.pending_exit_code = 1;
        if vm.realm.timer_loop_ptr != 0 {
            uv_stop(vm.realm.timer_loop_ptr);
        }
        return;
    }

    # Snapshot so listeners may call process.on/off safely.
    snap_fns: list[int] = [];
    snap_once: list[int] = [];
    si: int = 0;
    while si < n_listeners {
        snap_fns.append(listeners[si]);
        snap_once.append(once_flags[si]);
        si = si + 1;
    }

    _HANDLING_UNCAUGHT = True;
    origin: JSValue = jsv_from_string_id(str_intern(origin_name));
    li: int = 0;
    remove_idxs: list[int] = [];
    while li < len(snap_fns) {
        lfn: JSValue = snap_fns[li];
        if is_fn_val(lfn) {
            lfn_idx: int = get_fn_idx(lfn);
            if lfn_idx < len(vm.realm.closures) {
                lcl: JSClosure = vm.realm.closures[lfn_idx];
                vm.run_cl(lcl, lfn, js_undefined(), [exc, origin]);
                if vm.had_exception {
                    # Listener itself threw — print and force-exit (Node).
                    nested: JSValue = vm.pending_exc;
                    vm.had_exception = False;
                    vm.pending_exc = js_undefined();
                    print_uncaught(nested);
                    realm_request_exit(vm.realm);
                    vm.realm.pending_exit_code = 1;
                    if vm.realm.timer_loop_ptr != 0 {
                        uv_stop(vm.realm.timer_loop_ptr);
                    }
                    _HANDLING_UNCAUGHT = False;
                    return;
                }
            }
        }
        if snap_once[li] == 1 {
            remove_idxs.append(li);
        }
        li = li + 1;
    }
    _HANDLING_UNCAUGHT = False;

    # Remove once-listeners from the live lists (reverse order).
    ri: int = len(remove_idxs) - 1;
    while ri >= 0 {
        ridx: int = remove_idxs[ri];
        if ridx < len(listeners) {
            del listeners[ridx];
            del once_flags[ridx];
        }
        ri = ri - 1;
    }
}

"""Call a JS function; returns 1 if the call threw, 0 otherwise. Clears had_exception."""
def:pub vm_call_js_fn_threw(
    vm: VM, fn_val: JSValue, this_val: JSValue, args: list[JSValue]
) -> int {
    if not is_fn_val(fn_val) {
        return 0;
    }
    fn_idx: int = get_fn_idx(fn_val);
    if fn_idx >= len(vm.realm.closures) {
        return 0;
    }
    cl: JSClosure = vm.realm.closures[fn_idx];
    vm.run_cl(cl, fn_val, this_val, args);
    threw: int = 0;
    if vm.had_exception {
        threw = 1;
    }
    vm.had_exception = False;
    return threw;
}

"""
Invoke a JS closure for observable [[Get]]/[[Set]]/accessor dispatch.
Unlike vm_call_js_fn, propagates throws via vm_throw_native for native callers.
"""
def:pub vm_call_js_fn_observable(
    vm: VM, fn_val: JSValue, this_val: JSValue, args: list[JSValue]
) -> JSValue {
    if not is_fn_val(fn_val) {
        return js_undefined();
    }
    fn_idx: int = get_fn_idx(fn_val);
    if fn_idx >= len(vm.realm.closures) {
        return js_undefined();
    }
    cl: JSClosure = vm.realm.closures[fn_idx];
    result: JSValue = vm.run_cl(cl, fn_val, this_val, args);
    if vm.had_exception {
        exc_obs: JSValue = vm.pending_exc;
        vm.had_exception = False;
        vm.pending_exc = js_undefined();
        vm_throw_native(exc_obs);
        return js_undefined();
    }
    return result;
}

"""Fire module.registerHooks resolve hooks for `specifier` (LIFO chain; Node
contract: each hook calls nextResolve or returns {shortCircuit:true}).
Returns 1 if a hook raised — vm.had_exception/vm.pending_exc carry the error.
Used by _require_module for require() resolutions and by el_run for the main
entry, which loads without require() but must still observe the hooks that
--require preloads registered before it (Node: hooks run for the main module)."""
def:pub vm_fire_register_hooks(vm: VM, specifier: str) -> int {
    if module_hooks_count() == 0 or module_hooks_running_get() != 0 {
        return 0;
    }
    module_hooks_running_set(1);
    hk_i: int = module_hooks_count() - 1;
    while hk_i >= 0 {
        hk_fn: JSValue = module_hooks_get(hk_i);
        if is_fn_val(hk_fn) or is_native_val(hk_fn) {
            module_hook_next_reset();
            hk_ctx: JSValue = js_object_create_null();
            js_object_set(hk_ctx, str_intern("parentURL"), js_undefined());
            js_object_set(hk_ctx, str_intern("conditions"), js_array_create([]));
            hk_next: JSValue = js_native_create(
                "nextResolve", 2, NATIVE_KIND_MODULE_HOOK_NEXT
            );
            hk_args: list[JSValue] = [js_str(specifier), hk_ctx, hk_next];
            hk_res: JSValue = js_undefined();
            if is_fn_val(hk_fn) {
                hk_fi: int = get_fn_idx(hk_fn);
                if hk_fi < len(vm.realm.closures) {
                    hk_res = vm.run_cl(
                        vm.realm.closures[hk_fi], hk_fn, js_undefined(), hk_args
                    );
                }
            } else {
                hk_res = _vm_call_native_proxy_aware(
                    vm, vm.realm, get_native_kind(hk_fn), js_undefined(), hk_args
                );
            }
            if vm_has_native_exc() {
                vm.had_exception = True;
                vm.pending_exc = vm_take_native_exc();
            }
            if vm.had_exception {
                module_hooks_running_set(0);
                return 1;
            }
            if module_hook_next_called() == 0 {
                hk_sc: JSValue = js_undefined();
                if jsv_is_object_cell(hk_res) {
                    hk_sc = js_object_get(hk_res, str_intern("shortCircuit"));
                }
                if not jsv_coerce_to_bool(hk_sc) {
                    module_hooks_running_set(0);
                    vm.had_exception = True;
                    vm.pending_exc = make_type_error(
                        "resolve hook for '"
                            + specifier
                            + "' must return { shortCircuit: true } or call nextResolve"
                    );
                    return 1;
                }
            }
        }
        hk_i = hk_i - 1;
    }
    module_hooks_running_set(0);
    return 0;
}

"""Bridge VM pending JS exception into native exception channel."""
def:pub vm_bridge_pending_exception(vm: VM) -> bool {
    if vm.had_exception {
        exc: JSValue = vm.pending_exc;
        vm.had_exception = False;
        vm.pending_exc = js_undefined();
        vm_throw_native(exc);
        return True;
    }
    return False;
}

glob _NATIVE_OBS_VM_STACK: list[VM] = [],
     _OBS_VM_BY_HANDLE: dict[int, VM] = {},
     _OBS_NEXT_HANDLE: int = 1,
     _OBS_REGISTRATION_DONE: bool = False,
     _NAPI_ACTIVE_VM: VM,
     _NAPI_VM_ACTIVE: bool = False;

def _vm_ensure_obs_handle(vm: VM) -> int {
    if vm.obs_handle == 0 {
        h: int = _OBS_NEXT_HANDLE;
        _OBS_NEXT_HANDLE = _OBS_NEXT_HANDLE + 1;
        vm.obs_handle = h;
        _OBS_VM_BY_HANDLE[h] = vm;
    }
    return vm.obs_handle;
}

def _push_native_obs_vm(vm: VM) {
    _NATIVE_OBS_VM_STACK.append(vm);
    vm_obs_set_active_handle(_vm_ensure_obs_handle(vm));
}

def _pop_native_obs_vm {
    if len(_NATIVE_OBS_VM_STACK) > 0 {
        del _NATIVE_OBS_VM_STACK[len(_NATIVE_OBS_VM_STACK) - 1];
    }
    if len(_NATIVE_OBS_VM_STACK) > 0 {
        prev: VM = _NATIVE_OBS_VM_STACK[len(_NATIVE_OBS_VM_STACK) - 1];
        vm_obs_set_active_handle(_vm_ensure_obs_handle(prev));
    } else {
        vm_obs_set_active_handle(0);
    }
}

"""Typed observable [[Get]] registered into vm_obs dispatch table."""
def _vm_obs_get_impl(jsobj: JSValue, key: int, receiver: JSValue) -> JSValue {
    if len(_NATIVE_OBS_VM_STACK) == 0 {
        return js_object_get(jsobj, key);
    }
    vm: VM = _NATIVE_OBS_VM_STACK[len(_NATIVE_OBS_VM_STACK) - 1];
    return vm.obs_get(jsobj, key, receiver);
}

"""Typed observable [[Set]] registered into vm_obs dispatch table."""
def _vm_obs_set_impl(
    jsobj: JSValue, key: int, val: JSValue, receiver: JSValue
) -> bool {
    # Module Namespace Exotic [[Set]] (ES §10.4.6.9): always fails.
    if js_is_module_namespace(jsobj) {
        return False;
    }
    if len(_NATIVE_OBS_VM_STACK) == 0 {
        return js_object_set(jsobj, key, val) == 0;
    }
    vm: VM = _NATIVE_OBS_VM_STACK[len(_NATIVE_OBS_VM_STACK) - 1];
    return vm.obs_set(jsobj, key, val, receiver);
}

"""Typed observable [[HasProperty]] registered into vm_obs dispatch table."""
def _vm_obs_has_impl(jsobj: JSValue, key: int) -> bool {
    if len(_NATIVE_OBS_VM_STACK) == 0 {
        return js_object_has(jsobj, key);
    }
    vm: VM = _NATIVE_OBS_VM_STACK[len(_NATIVE_OBS_VM_STACK) - 1];
    return vm.obs_has(jsobj, key);
}

"""Typed observable [[Delete]] registered into vm_obs dispatch table."""
def _vm_obs_delete_impl(jsobj: JSValue, key: int) -> bool {
    # Module Namespace Exotic [[Delete]] (ES §10.4.6.11): a symbol key deletes
    # normally; a string export cannot be deleted (False); a non-own key → True.
    if js_is_module_namespace(jsobj) {
        if key >= SYMBOL_KEY_BASE {
            return js_object_delete(jsobj, key);
        }
        if js_object_has_own(jsobj, key) {
            return False;
        }
        return True;
    }
    if len(_NATIVE_OBS_VM_STACK) == 0 {
        return js_object_delete(jsobj, key);
    }
    vm: VM = _NATIVE_OBS_VM_STACK[len(_NATIVE_OBS_VM_STACK) - 1];
    return vm.obs_delete(jsobj, key);
}

"""Typed observable ToNumber registered into vm_obs dispatch table."""
def _vm_obs_tonum_impl(v: JSValue) -> float {
    if len(_NATIVE_OBS_VM_STACK) == 0 {
        if jsv_is_object_cell(v) {
            return 0.0;
        }
        return js_to_num(v);
    }
    vm: VM = _NATIVE_OBS_VM_STACK[len(_NATIVE_OBS_VM_STACK) - 1];
    return vm.obs_to_number(v);
}

"""Typed observable ToString registered into vm_obs dispatch table."""
def _vm_obs_tostr_impl(v: JSValue) -> str {
    if len(_NATIVE_OBS_VM_STACK) == 0 {
        return jsval_to_str(v);
    }
    vm: VM = _NATIVE_OBS_VM_STACK[len(_NATIVE_OBS_VM_STACK) - 1];
    return _vm_to_string_observable(vm, v);
}

"""Typed observable ToPropertyKey registered into vm_obs dispatch table."""
def _vm_obs_tpk_impl(v: JSValue) -> int {
    if len(_NATIVE_OBS_VM_STACK) == 0 {
        return jsval_to_prop_key(v);
    }
    vm: VM = _NATIVE_OBS_VM_STACK[len(_NATIVE_OBS_VM_STACK) - 1];
    return vm.obs_to_property_key(v);
}

"""Typed observable ToPrimitive(value, hint) registered into vm_obs dispatch."""
def _vm_obs_toprim_impl(v: JSValue, hint: int) -> JSValue {
    if len(_NATIVE_OBS_VM_STACK) == 0 {
        return v;
    }
    vm: VM = _NATIVE_OBS_VM_STACK[len(_NATIVE_OBS_VM_STACK) - 1];
    return vm.obs_to_primitive(v, hint);
}

"""Typed Call(fn, this, args) registered into vm_obs dispatch — lets native
builtins re-enter JS (custom @@match/@@replace, function replaceValue)."""
def _vm_obs_call_impl(fn: JSValue, this_val: JSValue, args: list[JSValue]) -> JSValue {
    if len(_NATIVE_OBS_VM_STACK) == 0 {
        return js_undefined();
    }
    vm: VM = _NATIVE_OBS_VM_STACK[len(_NATIVE_OBS_VM_STACK) - 1];
    return vm.obs_call_any(fn, this_val, args);
}

def _vm_napi_obs_push {
    if _NAPI_VM_ACTIVE {
        _push_native_obs_vm(_NAPI_ACTIVE_VM);
    }
}

def _vm_napi_obs_pop {
    if _NAPI_VM_ACTIVE {
        _pop_native_obs_vm();
    }
}

"""Invoke a NAPI C callback with observable VM context for nested property ops."""
def _vm_invoke_napi_cb(
    vm: VM, cb_ptr: int, cb_data: int, this_val: int, args: list[int], new_target: int
) -> int {
    _NAPI_ACTIVE_VM = vm;
    _NAPI_VM_ACTIVE = True;
    _push_native_obs_vm(vm);
    ret: int = _napi_invoke_callback_from_vm(
        cb_ptr, cb_data, this_val, args, new_target
    );
    _pop_native_obs_vm();
    _NAPI_VM_ACTIVE = False;
    return ret;
}

# ── WASM host imports (JS→WASM callbacks) — VM re-entry bridge ────────────────
# Registered into ffi/wasmtime.jac's trampoline via wasm_register_host_call. The
# trampoline (a raw C callback fired by Wasmtime) marshals WASM args into the
# wasm_host_arg_* globals, then calls _wasm_host_call(import_index, nargs), which
# re-enters the VM to run the JS import fn and pushes results back. The JS import
# callbacks are registered per import index by the dispatch layer (into vm_obs).

"""Convert one WASM arg (by its recorded kind) into a JSValue: i32→Number,
i64→BigInt, f32/f64→Number."""
def _wasm_arg_to_jsval(i: int) -> JSValue {
    k: int = wasm_host_arg_kind(i);
    if k == WASMTIME_I64 {
        return js_bigint_from_decimal_str(wasm_i64_to_decimal(wasm_host_arg_int(i)));
    }
    if k == WASMTIME_I32 {
        return js_number(float(wasm_host_arg_int(i)));
    }
    # f32 / f64
    return js_number(wasm_host_arg_dbl(i));
}

"""Marshal one JS return value into a WASM result of the given kind, pushing it
via wasm_host_push_result. i64 results accept BigInt or Number; i32/f* accept
Number/BigInt coercions."""
def _wasm_push_jsval_result(want_kind: int, v: JSValue) -> None {
    if want_kind == WASMTIME_I64 {
        if jsv_is_bigint_cell(v) {
            dec: str = str_from_id(jsv_to_table_id(v));
            wasm_host_push_result(want_kind, wasm_i64_from_decimal(dec), 0.0);
        } elif jsv_is_int32(v) {
            wasm_host_push_result(want_kind, jsv_to_int32(v), 0.0);
        } elif jsv_is_double(v) {
            wasm_host_push_result(want_kind, int(jsv_to_double(v)), 0.0);
        } else {
            wasm_host_push_result(want_kind, 0, 0.0);
        }
        return;
    }
    if want_kind == WASMTIME_I32 {
        iv: int = 0;
        if jsv_is_int32(v) {
            iv = jsv_to_int32(v);
        } elif jsv_is_double(v) {
            iv = int(jsv_to_double(v));
        } elif jsv_is_bigint_cell(v) {
            iv = wasm_i64_from_decimal(str_from_id(jsv_to_table_id(v)));
        }
        wasm_host_push_result(want_kind, iv, 0.0);
        return;
    }
    # f32 / f64
    dv: float = 0.0;
    if jsv_is_double(v) {
        dv = jsv_to_double(v);
    } elif jsv_is_int32(v) {
        dv = float(jsv_to_int32(v));
    } elif jsv_is_bigint_cell(v) {
        dv = float(wasm_i64_from_decimal(str_from_id(jsv_to_table_id(v))));
    }
    wasm_host_push_result(want_kind, 0, dv);
}

"""Host-import bridge: run the JS import fn `import_index` with the marshalled
WASM args, then push its return into the host result globals. Returns 0 on
success, 1 if the JS fn threw (→ WASM trap), 2 if no VM is active."""
def _wasm_host_call(import_index: int, nargs: int) -> int {
    if len(_NATIVE_OBS_VM_STACK) == 0 {
        return 2;
    }
    vm: VM = _NATIVE_OBS_VM_STACK[len(_NATIVE_OBS_VM_STACK) - 1];
    if not vm_wasm_has_import_cb(import_index) {
        return 2;
    }
    fn: JSValue = vm_wasm_get_import_cb(import_index);

    js_args: list[JSValue] = [];
    i: int = 0;
    while i < nargs {
        js_args.append(_wasm_arg_to_jsval(i));
        i = i + 1;
    }

    ret: JSValue = _vm_invoke_callback(vm, fn, js_undefined(), js_args);
    if vm.had_exception {
        exc: JSValue = vm.pending_exc;
        vm.had_exception = False;
        vm.pending_exc = js_undefined();
        # Surface a readable message for the trap; the JS layer re-wraps traps as
        # RuntimeError. Best-effort string of the thrown value.
        wasm_set_host_throw(_wasm_exc_message(vm, exc));
        return 1;
    }

    wasm_host_reset_results();
    nres: int = wasm_host_result_kind_count(import_index);
    if nres == 0 {
        return 0;
    }
    if nres == 1 {
        _wasm_push_jsval_result(wasm_host_result_kind(import_index, 0), ret);
        return 0;
    }
    # Multi-value: JS fn should return an array of results.
    k: int = 0;
    while k < nres {
        elem: JSValue = js_undefined();
        if jsv_is_object_cell(ret) {
            elem = js_object_get(ret, str_intern_index(k));
        }
        _wasm_push_jsval_result(wasm_host_result_kind(import_index, k), elem);
        k = k + 1;
    }
    return 0;
}

"""Best-effort message string for a thrown JSValue (used for the trap message)."""
def _wasm_exc_message(vm: VM, exc: JSValue) -> str {
    if jsv_is_object_cell(exc) {
        m: JSValue = js_object_get(exc, str_intern("message"));
        if jsv_is_string_cell(m) {
            return str_from_id(jsv_to_table_id(m));
        }
    }
    if jsv_is_string_cell(exc) {
        return str_from_id(jsv_to_table_id(exc));
    }
    return "wasm host import threw";
}

"""Register the WASM host-call bridge into ffi/wasmtime.jac (idempotent)."""
def:pub vm_wasm_init_host_bridge -> None {
    if _WASM_HOST_BRIDGE_READY {
        return;
    }
    wasm_register_host_call(_wasm_host_call);
    _WASM_HOST_BRIDGE_READY = True;
}

glob _WASM_HOST_BRIDGE_READY: bool = False;

"""Push VM context for observable native property access (NAPI / external callers)."""
def:pub vm_push_native_obs_context(vm: VM) {
    _push_native_obs_vm(vm);
}

"""Pop VM context pushed by vm_push_native_obs_context."""
def:pub vm_pop_native_obs_context {
    _pop_native_obs_vm();
}

"""Initialize observable property access (idempotent no-op marker)."""
def:pub init_observable_property_access -> None {
    if _OBS_REGISTRATION_DONE {
        return;
    }
    js_object_register_obs_impl(
        _vm_obs_get_impl,
        _vm_obs_set_impl,
        _vm_obs_has_impl,
        _vm_obs_delete_impl,
        _vm_obs_tonum_impl,
        _vm_obs_tostr_impl,
        _vm_obs_tpk_impl,
        _vm_obs_toprim_impl,
        _vm_obs_call_impl
    );
    js_object_register_napi_obs_scope(_vm_napi_obs_push, _vm_napi_obs_pop);
    _OBS_REGISTRATION_DONE = True;
}

"""
Execute a single deferred promise reaction entry.

Called by the event loop when draining the scheduler's reaction queue.
Mirrors the inline reaction-execution logic in _promise_settle_and_drain
so that the chained promise (next_p) is settled correctly.

  on_f  — fulfillment handler (may be js_undefined)
  on_r  — rejection handler (may be js_undefined)
  state — PROMISE_FULFILLED or PROMISE_REJECTED
  value — resolution value / rejection reason
  next_p — chained promise to settle after the handler runs
"""
def:pub vm_exec_reaction(
    vm: VM, on_f: JSValue, on_r: JSValue, state: int, value: JSValue, next_p: JSValue
) -> None {
    if state == SCHED_REACT_MICROTASK {
        # §27.2.2.2 NewPromiseResolveThenableJob: call thenable.then(res, rej)
        # with the outer promise's capability functions, so it adopts the
        # thenable's state. `value` carries the promise being resolved. A throw
        # from `then` rejects that promise — unless it already settled, since
        # the capability functions are single-shot (§27.2.1.3).
        if jsv_is_object_cell(on_f)
            and jsv_to_table_id(on_f) > 0
            and js_object_has_own(on_f, _KEY_IS_THENABLE_JOB) {
            tj_promise: JSValue = value;
            tj_thenable: JSValue = js_object_get(on_f, _KEY_THENABLE_VALUE);
            tj_then: JSValue = js_object_get(on_f, _KEY_THENABLE_THEN);
            # The [[AlreadyResolved]] guard set when this job was queued exists
            # to swallow *executor* settle attempts made after resolve(thenable).
            # Now that the job is running, the thenable's own resolve/reject
            # must be able to settle the promise, so clear it first.
            if jsv_is_object_cell(tj_promise) and jsv_to_table_id(tj_promise) > 0 {
                js_object_delete(tj_promise, _KEY_PRESOLVED);
            }
            tj_res: JSValue = js_make_resolve_fn(tj_promise);
            tj_rej: JSValue = js_make_reject_fn(tj_promise);
            vm._invoke_callable_value(tj_then, tj_thenable, [tj_res, tj_rej]);
            if vm.had_exception {
                tj_exc: JSValue = vm.pending_exc;
                vm.had_exception = False;
                vm.pending_exc = js_undefined();
                # A throw from `then` rejects the promise — unless `then`
                # already resolved it (§27.2.2.2 step 2: the capability
                # functions are single-shot). Resolving with another thenable
                # leaves it PENDING with [[AlreadyResolved]] set, so the _raw
                # settle used here has to consult that flag explicitly.
                if js_is_promise(tj_promise)
                    and not js_object_has_own(tj_promise, _KEY_PRESOLVED) {
                    vm._promise_settle_and_drain_raw(
                        tj_promise, PROMISE_REJECTED, tj_exc
                    );
                }
            }
            return;
        }
        mt_args: list[JSValue] = [];
        if jsv_is_object_cell(value) and js_is_array(value) {
            mt_n: int = js_array_len(value);
            mt_i: int = 0;
            while mt_i < mt_n {
                mt_args.append(js_array_get(value, mt_i));
                mt_i = mt_i + 1;
            }
        }
        if is_fn_val(on_f) {
            vm_call_js_fn(vm, on_f, js_undefined(), mt_args);
        } elif is_native_val(on_f) {
            _vm_call_native_proxy_aware(
                vm, vm.realm, get_native_kind(on_f), js_undefined(), mt_args
            );
        }
        return;
    }
    if state == PROMISE_FULFILLED {
        if jsv_is_object_cell(on_f)
            and jsv_to_table_id(on_f) > 0
            and js_is_resolve_fn(on_f) {
            # Capability resolve passed to .then (assert.throwsAsync pattern).
            p_cap_f: JSValue = js_object_get(on_f, _KEY_PROMISE_REF);
            if js_is_promise(p_cap_f) {
                vm._promise_resolve_value(p_cap_f, value);
            }
            if js_is_promise(next_p) {
                vm._promise_settle_and_drain(next_p, PROMISE_FULFILLED, js_undefined());
            }
        } elif jsv_is_object_cell(on_f)
            and jsv_to_table_id(on_f) > 0
            and js_is_reject_fn(on_f) {
            p_cap_fr: JSValue = js_object_get(on_f, _KEY_PROMISE_REF);
            if js_is_promise(p_cap_fr) {
                vm._promise_settle_and_drain(p_cap_fr, PROMISE_REJECTED, value);
            }
            if js_is_promise(next_p) {
                vm._promise_settle_and_drain(next_p, PROMISE_FULFILLED, js_undefined());
            }
        } elif is_fn_val(on_f) {
            res_re: JSValue = vm._call_closure_async_aware(
                on_f, js_undefined(), [value]
            );
            if vm.had_exception {
                exc_re: JSValue = vm.pending_exc;
                vm.had_exception = False;
                vm.pending_exc = js_undefined();
                if js_is_promise(next_p) {
                    vm._promise_settle_and_drain(next_p, PROMISE_REJECTED, exc_re);
                }
            } elif js_is_promise(res_re) and res_re == next_p {
                # `p2 = p1.then(() => p2)` — the handler returned the very
                # promise it settles, so resolving it with itself is a chaining
                # cycle: TypeError per §27.2.1.3.2 step 6. Adopting it instead
                # registered a reaction on next_p for next_p, and it hung.
                vm._promise_settle_and_drain(
                    next_p,
                    PROMISE_REJECTED,
                    make_type_error("Chaining cycle detected for promise #<Promise>")
                );
            } elif js_is_promise(res_re) {
                # Resolve next_p *with* the returned promise rather than copying
                # its state: _promise_settle_and_drain performs the §27.2.1.3.2
                # `then` lookup, so an own `then` installed on a real promise is
                # honoured. Reading [[PromiseState]] directly bypassed the
                # override and adopted the wrong value.
                vm._promise_settle_and_drain(next_p, PROMISE_FULFILLED, res_re);
            } else {
                if js_is_promise(next_p) {
                    vm._promise_settle_and_drain(next_p, PROMISE_FULFILLED, res_re);
                }
            }
        } elif jsv_is_object_cell(on_f)
            and jsv_to_table_id(on_f) > 0
            and js_object_has_own(on_f, _KEY_IS_ASYNC_RESUME) {
            aw_ri_re: int = jsv_to_int32(js_object_get(on_f, _KEY_ASYNC_RESUME_IDX));
            if _VM_PD2 {
                _rr: str = "[PD2] EXEC async-resume idx=" + str(aw_ri_re) + "\n";
                write(2, _rr, len(_rr));
            }
            vm._resume_async_frame(aw_ri_re, value, False);
        } elif jsv_is_object_cell(on_f)
            and jsv_to_table_id(on_f) > 0
            and js_object_has_own(on_f, _KEY_IS_ASYNC_ITER_RESUME) {
            aw_ri_re2: int = jsv_to_int32(js_object_get(on_f, _KEY_ASYNC_RESUME_IDX));
            vm._resume_async_iter_frame(aw_ri_re2, value, False);
        } elif jsv_is_object_cell(on_f)
            and jsv_to_table_id(on_f) > 0
            and js_is_promise_all_resolve_elem(on_f) {
            _vm_promise_all_resolve_call(vm, on_f, value);
        } elif jsv_is_object_cell(on_f)
            and jsv_to_table_id(on_f) > 0
            and (
                js_is_promise_allsettled_resolve_elem(on_f)
                or js_is_promise_allsettled_reject_elem(on_f)
                or js_is_promise_any_reject_elem(on_f)
            ) {
            _vm_promise_combinator_elem_call(vm, on_f, value);
        } elif jsv_is_object_cell(on_f)
            and jsv_to_table_id(on_f) > 0
            and js_object_has_own(on_f, 1001003) {
            _pa_idx_re: int = jsv_to_int32(js_object_get(on_f, 1001004));
            _pa_res_re: JSValue = js_object_get(on_f, 1001005);
            if js_promise_get_state(_pa_res_re) == PROMISE_PENDING {
                _pa_arr_re: JSValue = js_object_get(_pa_res_re, 1001002);
                js_array_set(_pa_arr_re, _pa_idx_re, value);
                _pa_cv_re: JSValue = js_object_get(_pa_res_re, 1001001);
                _pa_new_re: int = jsv_to_int32(_pa_cv_re) - 1;
                js_object_set(_pa_res_re, 1001001, js_int(_pa_new_re));
                if _pa_new_re <= 0 {
                    _pa_n_re: int = js_array_len(_pa_arr_re);
                    _pa_fv_re: list[JSValue] = [];
                    _pa_i_re: int = 0;
                    while _pa_i_re < _pa_n_re {
                        _pa_fv_re.append(js_array_get(_pa_arr_re, _pa_i_re));
                        _pa_i_re = _pa_i_re + 1;
                    }
                    vm._promise_settle_and_drain(
                        _pa_res_re, PROMISE_FULFILLED, js_array_create(_pa_fv_re)
                    );
                }
            }
        } elif jsv_is_object_cell(on_f)
            and jsv_to_table_id(on_f) > 0
            and js_object_has_own(on_f, 1001010) {
            _pr_res_f: JSValue = js_object_get(on_f, 1001012);
            if js_promise_get_state(_pr_res_f) == PROMISE_PENDING {
                vm._promise_settle_and_drain(_pr_res_f, PROMISE_FULFILLED, value);
            }
        } elif jsv_is_object_cell(on_f)
            and jsv_to_table_id(on_f) > 0
            and js_object_has_own(on_f, _KEY_FROM_ASYNC_CONTINUE) {
            _fa_res_c: JSValue = js_object_get(on_f, _KEY_FROM_ASYNC_RESULT);
            _vm_from_async_iter_advance(vm, _fa_res_c, value);
        } elif jsv_is_object_cell(on_f)
            and jsv_to_table_id(on_f) > 0
            and js_object_has_own(on_f, _KEY_FROM_ASYNC_AWAIT_ELEM) {
            _fa_res_a: JSValue = js_object_get(on_f, _KEY_FROM_ASYNC_RESULT);
            _fa_out_a: JSValue = js_object_get(_fa_res_a, _KEY_FROM_ASYNC_OUT);
            _fa_idx_a: int = jsv_to_int32(
                js_object_get(on_f, _KEY_FROM_ASYNC_ELEM_IDX)
            );
            _fa_iter_a: JSValue = js_object_get(on_f, _KEY_FROM_ASYNC_ITER);
            # Input Await completed — map / store (do not Await the input again).
            _vm_from_async_after_input(
                vm, _fa_res_a, _fa_out_a, _fa_idx_a, _fa_iter_a, value
            );
        } elif jsv_is_object_cell(on_f)
            and jsv_to_table_id(on_f) > 0
            and js_object_has_own(on_f, _KEY_FROM_ASYNC_AWAIT_MAPPED) {
            _fa_res_m: JSValue = js_object_get(on_f, _KEY_FROM_ASYNC_RESULT);
            _fa_out_m: JSValue = js_object_get(_fa_res_m, _KEY_FROM_ASYNC_OUT);
            _fa_idx_m: int = jsv_to_int32(
                js_object_get(on_f, _KEY_FROM_ASYNC_ELEM_IDX)
            );
            _fa_iter_m: JSValue = js_object_get(on_f, _KEY_FROM_ASYNC_ITER);
            _vm_from_async_finish_store(
                vm, _fa_res_m, _fa_out_m, _fa_idx_m, _fa_iter_m, value
            );
        } elif jsv_is_object_cell(on_f)
            and jsv_to_table_id(on_f) > 0
            and js_object_has_own(on_f, _KEY_FROM_ASYNC_CLOSE_AWAIT) {
            # AsyncIteratorClose return() fulfilled — still reject with original reason.
            _fa_res_clf: JSValue = js_object_get(on_f, _KEY_FROM_ASYNC_RESULT);
            _vm_from_async_finish_reject_close(vm, _fa_res_clf);
            # A capability resolve/reject function used directly as a reaction
            # handler — `p.then(cap.resolve, cap.reject)`, which is how race/any
            # forward a settlement. Without this the marker fell into the final
            # else and was treated as "no handler", so the forwarded promise never
            # settled and the consumer hung.
        } elif jsv_is_object_cell(on_f)
            and jsv_to_table_id(on_f) > 0
            and js_is_resolve_fn(on_f) {
            _cap_p_f: JSValue = js_object_get(on_f, _KEY_PROMISE_REF);
            if js_is_promise(_cap_p_f) {
                vm._promise_settle_and_drain(_cap_p_f, PROMISE_FULFILLED, value);
            }
            if js_is_promise(next_p) {
                vm._promise_settle_and_drain(next_p, PROMISE_FULFILLED, js_undefined());
            }
        } elif jsv_is_object_cell(on_f)
            and jsv_to_table_id(on_f) > 0
            and js_is_reject_fn(on_f) {
            _cap_p_f2: JSValue = js_object_get(on_f, _KEY_PROMISE_REF);
            if js_is_promise(_cap_p_f2) {
                vm._promise_settle_and_drain(_cap_p_f2, PROMISE_REJECTED, value);
            }
            if js_is_promise(next_p) {
                vm._promise_settle_and_drain(next_p, PROMISE_FULFILLED, js_undefined());
            }
        } else {
            if js_is_promise(next_p) {
                vm._promise_settle_and_drain(next_p, PROMISE_FULFILLED, value);
            }
        }
    } else {
        if jsv_is_object_cell(on_r)
            and jsv_to_table_id(on_r) > 0
            and js_is_reject_fn(on_r) {
            # Capability reject passed to .then (assert.throwsAsync pattern).
            p_cap_r: JSValue = js_object_get(on_r, _KEY_PROMISE_REF);
            if js_is_promise(p_cap_r) {
                vm._promise_settle_and_drain(p_cap_r, PROMISE_REJECTED, value);
            }
            if js_is_promise(next_p) {
                vm._promise_settle_and_drain(next_p, PROMISE_FULFILLED, js_undefined());
            }
        } elif jsv_is_object_cell(on_r)
            and jsv_to_table_id(on_r) > 0
            and js_is_resolve_fn(on_r) {
            p_cap_rf: JSValue = js_object_get(on_r, _KEY_PROMISE_REF);
            if js_is_promise(p_cap_rf) {
                vm._promise_resolve_value(p_cap_rf, value);
            }
            if js_is_promise(next_p) {
                vm._promise_settle_and_drain(next_p, PROMISE_FULFILLED, js_undefined());
            }
        } elif is_fn_val(on_r) {
            res_re2: JSValue = vm._call_closure_async_aware(
                on_r, js_undefined(), [value]
            );
            if vm.had_exception {
                exc_re2: JSValue = vm.pending_exc;
                vm.had_exception = False;
                vm.pending_exc = js_undefined();
                if js_is_promise(next_p) {
                    vm._promise_settle_and_drain(next_p, PROMISE_REJECTED, exc_re2);
                }
            } elif js_is_promise(next_p) {
                # Promise Resolve Function semantics (§27.2.1.3.2): adopt thenables /
                # Promises returned from onRejected (incl. already-rejected results)
                # and reject on a self-resolution cycle. _promise_resolve_value
                # handles both the cycle check and thenable adoption.
                vm._promise_resolve_value(next_p, res_re2);
            }
        } elif jsv_is_object_cell(on_r)
            and jsv_to_table_id(on_r) > 0
            and js_object_has_own(on_r, _KEY_IS_ASYNC_REJECT) {
            aw_ri2_re: int = jsv_to_int32(js_object_get(on_r, _KEY_ASYNC_RESUME_IDX));
            vm._resume_async_frame(aw_ri2_re, value, True);
        } elif jsv_is_object_cell(on_r)
            and jsv_to_table_id(on_r) > 0
            and js_object_has_own(on_r, _KEY_IS_ASYNC_ITER_REJECT) {
            aw_ri2_re2: int = jsv_to_int32(js_object_get(on_r, _KEY_ASYNC_RESUME_IDX));
            vm._resume_async_iter_frame(aw_ri2_re2, value, True);
        } elif jsv_is_object_cell(on_r)
            and jsv_to_table_id(on_r) > 0
            and js_is_promise_all_reject_elem(on_r) {
            _vm_promise_all_reject_call(vm, on_r, value);
        } elif jsv_is_object_cell(on_r)
            and jsv_to_table_id(on_r) > 0
            and js_object_has_own(on_r, 1001006) {
            _pa_res_r_re: JSValue = js_object_get(on_r, 1001005);
            vm._promise_settle_and_drain(_pa_res_r_re, PROMISE_REJECTED, value);
        } elif jsv_is_object_cell(on_r)
            and jsv_to_table_id(on_r) > 0
            and js_object_has_own(on_r, 1001011) {
            _pr_res_r: JSValue = js_object_get(on_r, 1001012);
            if js_promise_get_state(_pr_res_r) == PROMISE_PENDING {
                vm._promise_settle_and_drain(_pr_res_r, PROMISE_REJECTED, value);
            }
        } elif jsv_is_object_cell(on_r)
            and jsv_to_table_id(on_r) > 0
            and js_object_has_own(on_r, _KEY_FROM_ASYNC_CONTINUE) {
            _fa_res_cr: JSValue = js_object_get(on_r, _KEY_FROM_ASYNC_RESULT);
            _vm_from_async_reject(vm, _fa_res_cr, value);
        } elif jsv_is_object_cell(on_r)
            and jsv_to_table_id(on_r) > 0
            and js_object_has_own(on_r, _KEY_FROM_ASYNC_AWAIT_ELEM) {
            _fa_res_ar: JSValue = js_object_get(on_r, _KEY_FROM_ASYNC_RESULT);
            _vm_from_async_reject(vm, _fa_res_ar, value);
        } elif jsv_is_object_cell(on_r)
            and jsv_to_table_id(on_r) > 0
            and js_object_has_own(on_r, _KEY_FROM_ASYNC_AWAIT_MAPPED) {
            _fa_res_mr: JSValue = js_object_get(on_r, _KEY_FROM_ASYNC_RESULT);
            _vm_from_async_reject(vm, _fa_res_mr, value);
        } elif jsv_is_object_cell(on_r)
            and jsv_to_table_id(on_r) > 0
            and js_object_has_own(on_r, _KEY_FROM_ASYNC_CLOSE_AWAIT) {
            _fa_res_clr: JSValue = js_object_get(on_r, _KEY_FROM_ASYNC_RESULT);
            _vm_from_async_finish_reject_close(vm, _fa_res_clr);
            # Mirror of the fulfil branch: a capability resolve/reject marker used
            # directly as the *rejection* handler — `p.then(onFul, cap.reject)`, how
            # all/race/any short-circuit a rejection into their result.
        } elif jsv_is_object_cell(on_r)
            and jsv_to_table_id(on_r) > 0
            and js_is_reject_fn(on_r) {
            _cap_p_r: JSValue = js_object_get(on_r, _KEY_PROMISE_REF);
            if js_is_promise(_cap_p_r) {
                vm._promise_settle_and_drain(_cap_p_r, PROMISE_REJECTED, value);
            }
            if js_is_promise(next_p) {
                vm._promise_settle_and_drain(next_p, PROMISE_FULFILLED, js_undefined());
            }
        } elif jsv_is_object_cell(on_r)
            and jsv_to_table_id(on_r) > 0
            and js_is_resolve_fn(on_r) {
            _cap_p_r2: JSValue = js_object_get(on_r, _KEY_PROMISE_REF);
            if js_is_promise(_cap_p_r2) {
                vm._promise_settle_and_drain(_cap_p_r2, PROMISE_FULFILLED, value);
            }
            if js_is_promise(next_p) {
                vm._promise_settle_and_drain(next_p, PROMISE_FULFILLED, js_undefined());
            }
        } else {
            if js_is_promise(next_p) {
                vm._promise_settle_and_drain(next_p, PROMISE_REJECTED, value);
            }
        }
    }
}

# ══════════════════════════════════════════════════════════════════════════════
# Function property helpers (module-level, used by GET_PROP handler)
# ══════════════════════════════════════════════════════════════════════════════

"""Return a property of a JS closure value (fn.name, fn.length, fn.prototype,
fn.call, fn.apply, fn.bind, fn.toString). ECMAScript §10.2."""
def _fn_prop(fn_v: JSValue, key: int) -> JSValue {
    k_name: int = WK_NAME;
    k_len: int = WK_LENGTH;
    k_proto: int = WK_PROTOTYPE;
    k_call: int = WK_CALL;
    k_apply: int = WK_APPLY;
    k_bind: int = WK_BIND;
    # k_tostr removed: toString is no longer synthesized here (falls through to
    # fn_props / %Function.prototype% so a user override is visible).
    idx: int = get_fn_idx(fn_v);
    if key == k_name {
        # `delete fn.name` removes the (configurable) name property entirely.
        if idx < len(_VM_REALM.closures) and _VM_REALM.closures[idx].name_removed {
            return js_undefined();
        }
        # An explicitly-assigned `name` own property (e.g. an anonymous function
        # exported as `export default function(){}`, whose name is "default" per
        # ES §16.2.3.7, or a SetFunctionName) overrides the inferred compiled name.
        if idx < len(_VM_REALM.closures) {
            nm_ov: JSValue = js_object_get(_VM_REALM.closures[idx].fn_props, k_name);
            if not jsv_is_undefined(nm_ov) {
                return nm_ov;
            }
            nm: str = _VM_REALM.closures[idx].func.name;
            return jsv_from_string_id(str_intern(nm));
        }
        return jsv_from_string_id(str_intern(""));
    } elif key == k_len {
        if idx < len(_VM_REALM.closures) and _VM_REALM.closures[idx].length_removed {
            return js_undefined();
        }
        if idx < len(_VM_REALM.closures) {
            user_len: JSValue = js_object_get(_VM_REALM.closures[idx].fn_props, k_len);
            if not jsv_is_undefined(user_len) {
                return user_len;
            }
            ar: int = _VM_REALM.closures[idx].func.expected_arg_count;
            return js_int(ar);
        }
        return js_int(0);
    } elif key == k_proto {
        # A function marked non-constructable has no `prototype` property at
        # all (§20.1.3) — the Promise combinators and the resolve/reject
        # element functions are checked for exactly this by test262 .
        if idx < len(_VM_REALM.closures)
            and js_object_has_own(_VM_REALM.closures[idx].fn_props, WK_NOT_CTOR) {
            return js_undefined();
        }
        if idx < len(_VM_REALM.closures) {
            # An explicitly-set own `prototype` on fn_props wins over the default
            # prototype_obj (honours `fn.prototype = x`).
            if js_object_has_own(_VM_REALM.closures[idx].fn_props, k_proto) {
                return js_object_get(_VM_REALM.closures[idx].fn_props, k_proto);
            }
            return _VM_REALM.closures[idx].prototype_obj;
        }
        return js_object_create_null();
    } elif key == k_call or key == k_apply or key == k_bind {
        # call/apply/bind are intrinsics inherited from Function.prototype, not own
        # properties. A user-assigned own property (`fn.call = x`, test262
        # S11.6.1_A2.2_T3 CHECK#3) shadows the intrinsic, so consult fn_props
        # first and only synthesize when no own value exists.
        if idx < len(_VM_REALM.closures)
            and js_object_has_own(_VM_REALM.closures[idx].fn_props, key) {
            return js_object_get(_VM_REALM.closures[idx].fn_props, key);
        }
        if key == k_call {
            return js_native_singleton("call", 1, NATIVE_KIND_FN_CALL);
        }
        if key == k_apply {
            return js_native_singleton("apply", 2, NATIVE_KIND_FN_APPLY);
        }
        return js_native_singleton("bind", 1, NATIVE_KIND_FN_BIND);
    }
    # Do NOT hardcode toString: a user override of Function.prototype.toString
    # (e.g. dynamic-import AssignmentExpression tests) must be visible via OrdinaryGet
    # → %Function.prototype%. Fall through to fn_props / the proto chain below so both
    # an own `fn.toString = …` and a %Function.prototype%.toString override resolve.
    # Fall through to user-defined properties on the closure's backing object
    if idx < len(_VM_REALM.closures) {
        user_prop: JSValue = js_object_get(_VM_REALM.closures[idx].fn_props, key);
        if not jsv_is_undefined(user_prop) {
            return user_prop;
        }
        # Accessor on fn_props (rare) — prefer get for getters.
        if js_object_has_own(_VM_REALM.closures[idx].fn_props, key) {
            return js_object_get(_VM_REALM.closures[idx].fn_props, key);
        }
    }
    # Custom [[Prototype]] (e.g. Object.setPrototypeOf(Uint8Array, TypedArray))
    # before falling through to %Function.prototype%.
    if idx < len(_VM_REALM.closures) {
        custom_proto: JSValue = _VM_REALM.closures[idx].object_proto;
        if is_fn_val(custom_proto) {
            return _fn_prop(custom_proto, key);
        }
        if jsv_is_object_cell(custom_proto) and jsv_to_table_id(custom_proto) > 0 {
            inherited: JSValue = js_object_get(custom_proto, key);
            if not jsv_is_undefined(inherited) {
                return inherited;
            }
            if js_object_has_own(custom_proto, key) {
                return inherited;
            }
            # Walk further via ordinary get if needed.
            parent_fp: JSValue = js_object_get_prototype(custom_proto);
            if is_fn_val(parent_fp) {
                return _fn_prop(parent_fp, key);
            }
            if jsv_is_object_cell(parent_fp) and jsv_to_table_id(parent_fp) > 0 {
                return js_object_get(parent_fp, key);
            }
        }
    }
    # Fall through to Function.prototype → Object.prototype so inherited methods
    # (hasOwnProperty, isPrototypeOf, propertyIsEnumerable, valueOf, …) resolve on
    # function values (B6). Function.prototype already carries call/apply/bind/
    # toString and chains to Object.prototype.
    fp_proto: JSValue = js_function_get_proto();
    if jsv_is_object_cell(fp_proto) and jsv_to_table_id(fp_proto) > 0 {
        return js_object_get(fp_proto, key);
    }
    return js_undefined();
}

"""True if a NATIVE_KIND_* value is one of the seven Error constructors.

Used by the super()/new paths to decide whether a native super (now a callable
JSObject carrying KEY_CTOR_KIND) should be constructed with error semantics
(call ctor, copy message/stack/name onto `this`) rather than the exotic-object
path used by Array/Map/etc."""
def _is_error_native_kind(nk: int) -> bool {
    return nk == NATIVE_KIND_ERROR
        or nk == NATIVE_KIND_TYPE_ERROR
        or nk == NATIVE_KIND_REFERENCE_ERROR
        or nk == NATIVE_KIND_SYNTAX_ERROR
        or nk == NATIVE_KIND_RANGE_ERROR
        or nk == NATIVE_KIND_URI_ERROR
        or nk == NATIVE_KIND_EVAL_ERROR;
}

"""True when super is the native Array constructor (callable JSObject with KEY_CTOR_KIND)."""
def _is_array_native_super(sup: JSValue) -> bool {
    if not jsv_is_object_cell(sup) or jsv_to_table_id(sup) <= 0 {
        return False;
    }
    if not js_object_has_own(sup, KEY_CTOR_KIND) {
        return False;
    }
    return jsv_to_int32(js_object_get(sup, KEY_CTOR_KIND)) == NATIVE_KIND_ARRAY;
}

"""GetFunctionRealm(v) — returns registered home realm or the active VM realm."""
def _vm_get_function_realm(vm: VM, v: JSValue) -> Realm {
    if js_is_proxy(v) {
        v = _vm_proxy_unwrap_for_function_realm(vm, v);
        if vm_has_native_exc() {
            return vm.realm;
        }
    }
    rid_v: JSValue = js_undefined();
    if jsv_is_object_cell(v) and js_object_has_own(v, KEY_HOME_REALM_ID) {
        rid_v = js_object_get(v, KEY_HOME_REALM_ID);
    } elif is_fn_val(v) {
        fn_idx_hr: int = get_fn_idx(v);
        if fn_idx_hr < len(vm.realm.closures) {
            rid_v = js_object_get(
                vm.realm.closures[fn_idx_hr].fn_props, KEY_HOME_REALM_ID
            );
        }
    }
    if jsv_is_int32(rid_v) {
        rid: int = jsv_to_int32(rid_v);
        if realm_is_registered(rid) {
            return realm_lookup(rid);
        }
    }
    return vm.realm;
}

"""Return the KEY_HOME_REALM_ID tag of a native/object function value, or 0 (default realm).
Used to route a cross-realm indirect `eval` to the realm it belongs to."""
def _home_realm_id_of_val(v: JSValue) -> int {
    rid_v: JSValue = js_undefined();
    if jsv_is_object_cell(v) and js_object_has_own(v, KEY_HOME_REALM_ID) {
        rid_v = js_object_get(v, KEY_HOME_REALM_ID);
    } elif is_fn_val(v) {
        fn_idx: int = get_fn_idx(v);
        if fn_idx < len(_VM_REALM.closures) {
            rid_v = js_object_get(
                _VM_REALM.closures[fn_idx].fn_props, KEY_HOME_REALM_ID
            );
        }
    }
    if jsv_is_int32(rid_v) {
        return jsv_to_int32(rid_v);
    }
    return 0;
}

"""Build a TypeError whose [[Prototype]] is the given realm's %TypeError.prototype% (ES:
errors thrown by a function use that function's realm intrinsics). Falls back to the default
%TypeError% when the realm has no distinct constructor (realm_id 0 or lookup miss), so this
is always safe to call with any realm id."""
def _make_type_error_in_realm(realm_id: int, message: str) -> JSValue {
    if realm_id != 0 and realm_is_registered(realm_id) {
        r: Realm = realm_lookup(realm_id);
        if jsv_is_object_cell(r.global_this) and jsv_to_table_id(r.global_this) > 0 {
            te_ctor: JSValue = js_object_get(r.global_this, str_intern("TypeError"));
            if jsv_is_object_cell(te_ctor) or is_native_val(te_ctor) {
                te_proto: JSValue = js_object_get(te_ctor, str_intern("prototype"));
                if jsv_is_object_cell(te_proto) and jsv_to_table_id(te_proto) > 0 {
                    return create_error("TypeError", message, te_proto);
                }
            }
        }
    }
    return make_type_error(message);
}

"""Copy KEY_HOME_REALM_ID from `from_obj` onto `to_obj` (for `new other.Function()`)."""
def _vm_copy_home_realm(from_obj: JSValue, to_obj: JSValue) -> None {
    rid: JSValue = js_undefined();
    if jsv_is_object_cell(from_obj)
        and js_object_has_own(from_obj, KEY_HOME_REALM_ID) {
        rid = js_object_get(from_obj, KEY_HOME_REALM_ID);
    } elif is_fn_val(from_obj) {
        fn_idx_fr: int = get_fn_idx(from_obj);
        if fn_idx_fr < len(_VM_REALM.closures) {
            rid = js_object_get(
                _VM_REALM.closures[fn_idx_fr].fn_props, KEY_HOME_REALM_ID
            );
        }
    }
    if not jsv_is_int32(rid) {
        return;
    }
    if jsv_is_object_cell(to_obj) {
        js_object_set(to_obj, KEY_HOME_REALM_ID, rid);
    } elif is_fn_val(to_obj) {
        fn_idx_to: int = get_fn_idx(to_obj);
        if fn_idx_to < len(_VM_REALM.closures) {
            js_object_set(
                _VM_REALM.closures[fn_idx_to].fn_props, KEY_HOME_REALM_ID, rid
            );
        }
    }
}

"""
GetPrototypeFromConstructor(constructor, intrinsicDefaultProto) — §9.1.14.
array_default=True → fallback realm.%Array.prototype%; else %Object.prototype%.
"""
def _vm_get_prototype_from_constructor(
    vm: VM, constructor: JSValue, array_default: bool
) -> JSValue {
    proto: JSValue = vm.obs_get(constructor, WK_PROTOTYPE, constructor);
    if vm_has_native_exc() {
        return js_undefined();
    }
    # A JS `prototype` getter that throws reports on vm.had_exception rather
    # than the native channel, so checking only the latter swallowed it and the
    # abrupt completion never propagated (test262 get-prototype-abrupt).
    # Re-raise on the native channel, which is what every caller drains.
    if vm.had_exception {
        exc_gpc: JSValue = vm.pending_exc;
        vm.had_exception = False;
        vm.pending_exc = js_undefined();
        vm_throw_native(exc_gpc);
        return js_undefined();
    }
    if jsv_is_any_object(proto) {
        return proto;
    }
    rt: Realm = _vm_get_function_realm(vm, constructor);
    if array_default {
        fb: JSValue = rt.intrinsics.array_proto;
        if jsv_is_any_object(fb) {
            return fb;
        }
    } else {
        fb: JSValue = rt.intrinsics.object_proto;
        if jsv_is_any_object(fb) {
            return fb;
        }
    }
    obj_ctor: JSValue = js_undefined();
    if "Object" in vm.globals {
        obj_ctor = vm.globals["Object"];
    }
    if jsv_is_object_cell(obj_ctor) {
        obj_fb: JSValue = js_object_get(obj_ctor, WK_PROTOTYPE);
        if jsv_is_any_object(obj_fb) {
            return obj_fb;
        }
    }
    return js_object_create_null();
}

"""GetPrototypeFromConstructor for Map/Set/Weak* — fallback is realm's %Map.prototype% etc."""
def _vm_get_collection_proto_from_constructor(
    vm: VM, new_target: JSValue, ctor_name: str
) -> JSValue {
    proto: JSValue = vm.obs_get(new_target, WK_PROTOTYPE, new_target);
    if vm_has_native_exc() {
        return js_undefined();
    }
    if jsv_is_any_object(proto) {
        return proto;
    }
    rt: Realm = _vm_get_function_realm(vm, new_target);
    gv: JSValue = rt.global_this;
    if not jsv_is_object_cell(gv) {
        return js_undefined();
    }
    coll_ctor: JSValue = js_object_get(gv, str_intern(ctor_name));
    if not jsv_is_object_cell(coll_ctor)
        and not is_native_val(coll_ctor)
        and not is_fn_val(coll_ctor) {
        return js_undefined();
    }
    fb: JSValue = vm.obs_get(coll_ctor, WK_PROTOTYPE, coll_ctor);
    if vm_has_native_exc() {
        return js_undefined();
    }
    if jsv_is_any_object(fb) {
        return fb;
    }
    return js_undefined();
}

"""OrdinaryCreateFromConstructor for Map/Set/WeakMap/WeakSet + optional iterable init."""
def _vm_construct_collection(
    vm: VM, kind: int, ctor: JSValue, args: list[JSValue], new_target: JSValue
) -> JSValue {
    ctor_name: str = "Map";
    if kind == NATIVE_KIND_SET {
        ctor_name = "Set";
    } elif kind == NATIVE_KIND_WEAKMAP {
        ctor_name = "WeakMap";
    } elif kind == NATIVE_KIND_WEAKSET {
        ctor_name = "WeakSet";
    }
    proto: JSValue = js_undefined();
    if js_strict_equal(new_target, ctor) {
        # Same newTarget — use the constructor's own .prototype when it is an object.
        proto = vm.obs_get(ctor, WK_PROTOTYPE, ctor);
        if vm_has_native_exc() {
            return js_undefined();
        }
        if not jsv_is_any_object(proto) {
            proto = js_undefined();
        }
    } else {
        proto = _vm_get_collection_proto_from_constructor(vm, new_target, ctor_name);
        if vm_has_native_exc() {
            return js_undefined();
        }
    }
    coll: JSValue = js_undefined();
    if kind == NATIVE_KIND_MAP {
        coll = js_map_create_with_proto(proto);
    } elif kind == NATIVE_KIND_SET {
        coll = js_set_create_with_proto(proto);
    } elif kind == NATIVE_KIND_WEAKMAP {
        coll = js_weakmap_create_with_proto(proto);
    } else {
        coll = js_weakset_create_with_proto(proto);
    }

    init: JSValue = js_undefined();
    if len(args) > 0 {
        init = args[0];
    }
    if jsv_is_null(init) or jsv_is_undefined(init) {
        return coll;
    }

    # Non-empty iterable with a possibly foreign newTarget: build via the default
    # native constructor (handles arrays / Map sources), then rebadge [[Prototype]].
    seeded: JSValue = _vm_call_native_proxy_aware(
        vm, vm.realm, kind, js_undefined(), args
    );
    if vm_has_native_exc() {
        return js_undefined();
    }
    if _vm_bridge_vm_exc(vm) {
        return js_undefined();
    }
    if jsv_is_any_object(proto) and jsv_is_any_object(seeded) {
        js_object_set_prototype(seeded, proto);
    }
    if jsv_is_any_object(seeded) {
        return seeded;
    }
    return coll;
}

"""True for Temporal builtin constructor native kinds."""
def _vm_is_temporal_ctor_kind(kind: int) -> bool {
    return kind == NATIVE_KIND_TEMPORAL_DURATION
        or kind == NATIVE_KIND_TEMPORAL_INSTANT
        or kind == NATIVE_KIND_TEMPORAL_PLAIN_DATE
        or kind == NATIVE_KIND_TEMPORAL_PLAIN_TIME
        or kind == NATIVE_KIND_TEMPORAL_PLAIN_DATETIME
        or kind == NATIVE_KIND_TEMPORAL_PLAIN_YEAR_MONTH
        or kind == NATIVE_KIND_TEMPORAL_PLAIN_MONTH_DAY
        or kind == NATIVE_KIND_TEMPORAL_ZONED_DATETIME;
}

"""Construct a Promise for Reflect.construct / Construct(%Promise%, …).

§27.2.3.1: the executor is validated first, then `newTarget.prototype` is read
via OrdinaryCreateFromConstructor — so a throwing `prototype` getter on the
newTarget propagates out. The dispatch-table entry for NATIVE_KIND_PROMISE is
the *no-new* form and always throws, so construction has to be handled here."""
def _vm_construct_promise_native(
    vm: VM, args: list[JSValue], new_target: JSValue
) -> JSValue {
    exec_p: JSValue = js_undefined();
    if len(args) > 0 {
        exec_p = args[0];
    }
    if not vm._value_is_callable(exec_p) {
        vm_throw_native(make_type_error("Promise resolver is not a function"));
        return js_undefined();
    }
    new_p: JSValue = js_promise_create();
    # Reading newTarget.prototype can throw (get-prototype-abrupt); when it
    # yields a usable object it becomes the new promise's [[Prototype]] so a
    # subclass newTarget produces an instance of that subclass.
    if not jsv_is_undefined(new_target) {
        proto_p: JSValue = _vm_get_prototype_from_constructor(vm, new_target, False);
        if vm_has_native_exc() {
            return js_undefined();
        }
        if jsv_is_object_cell(proto_p) and jsv_to_table_id(proto_p) > 0 {
            js_object_set_prototype(new_p, proto_p);
        }
    }
    res_p: JSValue = js_make_resolve_fn(new_p);
    rej_p: JSValue = js_make_reject_fn(new_p);
    _gtr_p: int = len(vm.realm.gc_temp_roots);
    vm.realm.gc_temp_roots.append(new_p);
    vm._invoke_callable_value(exec_p, js_undefined(), [res_p, rej_p]);
    _gtr_pn: int = len(vm.realm.gc_temp_roots);
    while _gtr_pn > _gtr_p {
        _gtr_pn = _gtr_pn - 1;
        del vm.realm.gc_temp_roots[_gtr_pn];
    }
    # A throw from the executor rejects the promise (§27.2.3.1 step 10).
    if vm.had_exception {
        exc_p: JSValue = vm.pending_exc;
        vm.had_exception = False;
        vm.pending_exc = js_undefined();
        vm._promise_settle_and_drain(new_p, PROMISE_REJECTED, exc_p);
    } elif vm_has_native_exc() {
        vm._promise_settle_and_drain(new_p, PROMISE_REJECTED, vm_take_native_exc());
    }
    return new_p;
}

"""Construct a native Temporal builtin with optional subclass newTarget."""
def _vm_construct_temporal_native(
    vm: VM, kind: int, ctor: JSValue, args: list[JSValue], new_target: JSValue
) -> JSValue {
    if not js_strict_equal(new_target, ctor) {
        proto_t: JSValue = _vm_get_prototype_from_constructor(vm, new_target, False);
        if vm_has_native_exc() {
            return js_undefined();
        }
        new_obj_t: JSValue = js_object_create(proto_t);
        res_t: JSValue = _vm_call_native_proxy_aware(
            vm, vm.realm, kind, new_obj_t, args
        );
        if vm_has_native_exc() {
            return js_undefined();
        }
        if jsv_is_any_object(res_t) {
            return res_t;
        }
        return new_obj_t;
    }
    res_n: JSValue = _vm_call_native_proxy_aware(
        vm, vm.realm, kind, js_undefined(), args
    );
    if vm_has_native_exc() {
        return js_undefined();
    }
    return res_n;
}

"""$262.createRealm() — test262 host hook (R13)."""
def _vm_262_create_realm(vm: VM, args: list[JSValue]) -> JSValue {
    return realm_bootstrap_secondary(vm.realm);
}

"""$262.evalScript(src) — ScriptEvaluation in the current realm (not eval).

Implements GlobalDeclarationInstantiation early errors for top-level
let/const/class colliding with a non-configurable (restricted) global property
or a prior script var binding — required by annexB script-decl-lex-* tests."""
def _vm_262_eval_script(vm: VM, args: list[JSValue]) -> JSValue {
    if len(args) < 1 {
        vm_throw_native(make_type_error("$262.evalScript requires a string"));
        return js_undefined();
    }
    src_v: JSValue = args[0];
    if not jsv_is_string_cell(src_v) {
        src_v = js_to_string_prim(src_v);  # jac:ignore[E1001] pointer reinterpret
    }
    src: str = "";
    if jsv_is_string_cell(src_v) {
        src = str_from_id(jsv_to_table_id(src_v));
    }
    return vm.eval_script_source(src);
}

"""Return a property of a native function value (name, length, call, apply, bind, toString).

Also handles String.fromCharCode/fromCodePoint/raw and Number static methods when the native is String/Number."""
def _native_prop(nat_v: JSValue, key: int) -> JSValue {
    k_proto: int = WK_PROTOTYPE;
    nk: int = get_native_kind(nat_v);

    # ── prototype property for built-in constructors ──────────────────────
    if key == k_proto {
        if nk == NATIVE_KIND_ERROR {
            return get_error_proto();
        }
        if nk == NATIVE_KIND_TYPE_ERROR {
            return get_type_error_proto();
        }
        if nk == NATIVE_KIND_REFERENCE_ERROR {
            return get_reference_error_proto();
        }
        if nk == NATIVE_KIND_SYNTAX_ERROR {
            return get_syntax_error_proto();
        }
        if nk == NATIVE_KIND_RANGE_ERROR {
            return get_range_error_proto();
        }
        if nk == NATIVE_KIND_URI_ERROR {
            return get_uri_error_proto();
        }
        if nk == NATIVE_KIND_EVAL_ERROR {
            return get_eval_error_proto();
        }
        if nk == NATIVE_KIND_ARRAY
            or nk == NATIVE_KIND_OBJECT
            or nk == NATIVE_KIND_MAP
            or nk == NATIVE_KIND_SET
            or nk == NATIVE_KIND_DATE
            or nk == NATIVE_KIND_PROMISE
            or nk == NATIVE_KIND_FUNCTION
            or nk == NATIVE_KIND_BOOLEAN
            or nk == NATIVE_KIND_NUMBER
            or nk == NATIVE_KIND_STRING
            or nk == NATIVE_KIND_WEAKMAP
            or nk == NATIVE_KIND_WEAKSET {
            return js_object_create_null();
        }
        # Native methods (join, map, …): no .prototype property.
        return js_undefined();
    }

    # String constructor static methods
    if get_native_kind(nat_v) == NATIVE_KIND_STRING {
        if key == WK_FROMCHARCODE {
            return js_native_create("fromCharCode", 1, NATIVE_KIND_STR_FROMCHARCODE);
        } elif key == WK_FROMCODEPOINT {
            return js_native_create("fromCodePoint", 1, NATIVE_KIND_STR_FROMCODEPOINT);
        } elif key == WK_RAW {
            return js_native_create("raw", 1, NATIVE_KIND_STR_RAW);
        }
    }
    # Number constructor static methods and properties
    if get_native_kind(nat_v) == NATIVE_KIND_NUMBER {
        if key == WK_ISNAN {
            return js_native_create("isNaN", 1, NATIVE_KIND_NUM_ISNAN);
        } elif key == WK_ISFINITE {
            return js_native_create("isFinite", 1, NATIVE_KIND_NUM_ISFINITE);
        } elif key == WK_ISINTEGER {
            return js_native_create("isInteger", 1, NATIVE_KIND_NUM_ISINTEGER);
        } elif key == WK_ISSAFEINTEGER {
            return js_native_create("isSafeInteger", 1, NATIVE_KIND_NUM_ISSAFEINTEGER);
        } elif key == WK_PARSEFLOAT {
            return js_native_create("parseFloat", 1, NATIVE_KIND_NUM_PARSEFLOAT);
        } elif key == WK_PARSEINT {
            return js_native_create("parseInt", 2, NATIVE_KIND_NUM_PARSEINT);
        } elif key == WK_MAX_VALUE {
            return js_number(1.7976931348623157e+308);
        } elif key == WK_MIN_VALUE {
            return js_number(5e-324);
        } elif key == WK_EPSILON {
            return js_number(2.220446049250313e-16);
        } elif key == WK_MAX_SAFE_INTEGER {
            return js_number(9007199254740991.0);
        } elif key == WK_MIN_SAFE_INTEGER {
            return js_number(-9007199254740991.0);
        } elif key == WK_POSITIVE_INFINITY {
            return js_infinity();
        } elif key == WK_NEGATIVE_INFINITY {
            return js_neg_infinity();
        } elif key == WK_NAN {
            return js_nan();
        }
    }
    k_name: int = WK_NAME;
    k_len: int = WK_LENGTH;
    k_call: int = WK_CALL;
    k_apply: int = WK_APPLY;
    k_bind: int = WK_BIND;
    k_tostr: int = WK_TOSTRING;
    # Own-property store override (restored name/length or user-defined keys).
    np_get: JSValue = native_props_get(nat_v);
    if jsv_is_object_cell(np_get) and js_object_has_own(np_get, key) {
        return js_object_get(np_get, key);
    }
    if key == k_name {
        if native_key_removed(nat_v, k_name) {
            return js_undefined();
        }
        nm2: str = get_native_name(nat_v);
        return jsv_from_string_id(str_intern(nm2));
    } elif key == k_len {
        if native_key_removed(nat_v, k_len) {
            return js_undefined();
        }
        return js_int(get_native_arity(nat_v));
    } elif key == k_call {
        return js_native_singleton("call", 1, NATIVE_KIND_FN_CALL);
    } elif key == k_apply {
        return js_native_singleton("apply", 2, NATIVE_KIND_FN_APPLY);
    } elif key == k_bind {
        return js_native_singleton("bind", 1, NATIVE_KIND_FN_BIND);
    } elif key == k_tostr {
        return js_native_singleton("toString", 0, NATIVE_KIND_FN_TOSTRING);
    }
    # require.resolve / require.cache / require.main / require.extensions
    if nk == NATIVE_KIND_REQUIRE or nk == NATIVE_KIND_BOUND_REQUIRE {
        if key == WK_RESOLVE {
            res_r: JSValue = js_undefined();
            if nk == NATIVE_KIND_BOUND_REQUIRE {
                res_r = js_native_create(
                    "resolve", 1, NATIVE_KIND_BOUND_REQUIRE_RESOLVE
                );
                # Propagate parent binding to the new native val.
                # Native vals use their registry index as the bind-id key, so
                # require_bind_set stores the parent under get_native_idx(res_r).
                bid_r: int = require_native_bind_id(nat_v);
                if bid_r >= 0 {
                    require_bind_set(res_r, require_bind_parent(bid_r));
                }
            } else {
                res_r = js_native_create("resolve", 1, NATIVE_KIND_REQUIRE_RESOLVE);
            }
            return res_r;
        }
        if key == WK_EXTENSIONS {
            return _REQUIRE_EXTENSIONS_OBJ;
        }
        if key == WK_CACHE {
            return _REQUIRE_CACHE_OBJ;
        }
        if key == WK_MAIN {
            return _REQUIRE_MAIN_MODULE;
        }
    }
    if nk == NATIVE_KIND_REQUIRE_RESOLVE {
        paths_k: int = str_intern("paths");
        if key == paths_k {
            return js_native_create("paths", 1, NATIVE_KIND_REQUIRE_RESOLVE_PATHS);
        }
    }
    if nk == NATIVE_KIND_BOUND_REQUIRE_RESOLVE {
        paths_k2: int = str_intern("paths");
        if key == paths_k2 {
            return js_native_create("paths", 1, NATIVE_KIND_REQUIRE_RESOLVE_PATHS);
        }
    }
    # process.hrtime.bigint
    if nk == NATIVE_KIND_PROCESS_HRTIME {
        nk_bigint_key: int = str_intern("bigint");
        if key == nk_bigint_key {
            return js_native_create("bigint", 0, NATIVE_KIND_PROCESS_HRTIME_BIGINT);
        }
    }
    # process.memoryUsage.rss
    if nk == NATIVE_KIND_PROCESS_MEMORY_USAGE {
        nk_rss_key: int = str_intern("rss");
        if key == nk_rss_key {
            return js_native_create("rss", 0, NATIVE_KIND_PROCESS_MEMORY_USAGE_RSS);
        }
    }
    fp_proto: JSValue = js_function_get_proto();
    if jsv_is_object_cell(fp_proto) and jsv_to_table_id(fp_proto) > 0 {
        inherited: JSValue = js_object_get(fp_proto, key);
        if not jsv_is_undefined(inherited) {
            return inherited;
        }
    }
    return js_undefined();
}

# ══════════════════════════════════════════════════════════════════════════════
# Dynamic Function constructor helper (ECMAScript §20.2.1.1 CreateDynamicFunction)
# ══════════════════════════════════════════════════════════════════════════════

"""
Implement `Function(params..., body)` / `new Function(params..., body)`.

The last arg is the body string; earlier args are parameter-name strings.
Resulting function has name "anonymous".  Avoids circular import with
builtins/function.na.jac by reimplementing inline here.
"""
def _impl_js_Function(args: list[JSValue]) -> JSValue {
    param_str: str = "";
    body_str: str = "";
    n: int = len(args);
    # CreateDynamicFunction (§20.2.1.1): EVERY argument is ToString-coerced.
    # An ARRAY of parameter names is legal — ToString runs Array.prototype
    # .toString → "a,b,c" (rollup's test harness does exactly
    # `new Function(contextKeys, code)`); _jsv_str returned "" for objects,
    # silently dropping the whole parameter list.
    if n == 0 {
        body_str = "";
    } elif n == 1 {
        body_str = _fn_ctor_to_string(args[0]);
    } else {
        body_str = _fn_ctor_to_string(args[n - 1]);
        pi: int = 0;
        while pi < n - 1 {
            if pi > 0 {
                param_str = param_str + ",";
            }
            param_str = param_str + _fn_ctor_to_string(args[pi]);
            pi = pi + 1;
        }
    }
    if "import.meta" in body_str {
        exc_im: JSValue = make_syntax_error(
            "Cannot use 'import.meta' outside a module"
        );
        vm_throw_native(exc_im);
        return js_undefined();
    }
    src: str = "function anonymous(" + param_str + ") {\n" + body_str + "\n}";
    # A Function-constructor body is never an ES module (import/export are errors
    # here, checked above) — skip the module-goal pre-scan.
    ast_fn = parse(src, False, False);
    if _PARSE_HAD_ERRORS {
        exc_pe: JSValue = make_syntax_error("Invalid or unexpected token");
        vm_throw_native(exc_pe);
        return js_undefined();
    }
    c: Compiler = make_compiler();
    c.source_text = src;  # source slice for Function.prototype.toString
    top_fn: CompiledFunction = c.compile_program(ast_fn);
    if c.had_error {
        ce_msg: str = c.last_error_msg;
        if ce_msg == "" {
            ce_msg = "Invalid or unexpected token";
        }
        if ce_msg.startswith("SyntaxError: ") {
            ce_msg = ce_msg[13:];
        }
        exc_ce: JSValue = make_syntax_error(ce_msg);
        vm_throw_native(exc_ce);
        return js_undefined();
    }
    # Find the "anonymous" function in all_fns.  Functions are added in
    # depth-first completion order, so inner functions come first and the
    # outermost "anonymous" wrapper is always the last occurrence.
    inner: CompiledFunction = top_fn;
    ai_if: int = len(c.all_fns) - 1;
    while ai_if >= 0 {
        if c.all_fns[ai_if].name == "anonymous" {
            inner = c.all_fns[ai_if];
            ai_if = -1;
        }
        ai_if = ai_if - 1;
    }
    proto_if: JSValue = js_object_create_null();
    cl_if: JSClosure = make_closure(inner, [], js_undefined(), proto_if);
    cl_if.module_fns = c.all_fns;  # so MAKE_FUNCTION inside anonymous finds inner functions
    return js_fn_val(vm_register_closure(_VM_REALM, cl_if));  # G0.5: reuse freed slot
}

"""Coerce a JSValue to a Jac string (helper for _impl_js_Function)."""
def _jsv_str(v: JSValue) -> str {
    if jsv_is_string_cell(v) {
        return str_from_id(jsv_to_table_id(v));
    }
    if jsv_is_undefined(v) {
        return "undefined";
    }
    if jsv_is_null(v) {
        return "null";
    }
    if jsv_is_bool(v) {
        if jsv_to_bool(v) {
            return "true";
        } else {
            return "false";
        }
    }
    if jsv_is_int32(v) {
        return str(jsv_to_int32(v));
    }
    if jsv_is_double(v) {
        return str(jsv_to_double(v));
    }
    return "";
}

"""Full ToString for Function-constructor arguments: primitives via the fast
path, objects (arrays of parameter names, objects with toString) via the
observable ToString so Array.prototype.toString / user toString run."""
def _fn_ctor_to_string(v: JSValue) -> str {
    if jsv_is_string_cell(v) {
        return str_from_id(jsv_to_table_id(v));
    }
    if not jsv_is_cell(v) {
        return _jsv_str(v);
    }
    # Arrays: Array.prototype.toString == join(",") with undefined/null as ""
    # (handled inline — the observable ToString needs an active obs context,
    # which the Function-constructor path does not have).
    if js_is_array(v) {
        fc_n: int = js_array_len(v);
        fc_out: str = "";
        fc_i: int = 0;
        while fc_i < fc_n {
            if fc_i > 0 {
                fc_out = fc_out + ",";
            }
            fc_el: JSValue = js_array_get(v, fc_i);
            if not jsv_is_undefined(fc_el) and not jsv_is_null(fc_el) {
                fc_out = fc_out + _fn_ctor_to_string(fc_el);
            }
            fc_i = fc_i + 1;
        }
        return fc_out;
    }
    # Primitive-wrapper objects ToString to their wrapped primitive, NOT
    # "[object Object]": String(new Object(1)) === "1". This path has no active
    # obs context, so js_to_string_observable falls back and returns "" for a
    # cell — leaving new Function(new Object(1)) to build a "[object Object]"
    # body and throw "object is not defined" at call time
    # (test262 Function/S15.3.2.1_A1_T7). Unwrap the common wrappers first.
    if is_number_object(v) {
        return _fn_ctor_to_string(number_value_of(v));
    }
    if is_string_object(v) {
        return _fn_ctor_to_string(string_value_of(v));
    }
    if is_boolean_object(v) {
        return _fn_ctor_to_string(boolean_value_of(v));
    }
    fc_obs: str = js_to_string_observable(v);
    if fc_obs != "" {
        return fc_obs;
    }
    return "[object Object]";
}

"""Return a brief description of v for 'X is not a function' error messages.
Mirrors the Bun/V8 style: show the literal value for primitives, type name
for objects, and native/function names for callables."""
def _not_fn_method_desc(this_v: JSValue, meth_v: JSValue, meth_name: str) -> str {
    # Build "thisDesc.methName is not a function" when we know the method name.
    # Falls back to plain _not_fn_desc(meth_v) for computed / unknown names.
    if meth_name != "" {
        this_desc: str = "";
        if jsv_is_string_cell(this_v) {
            this_desc = str_from_id(jsv_to_table_id(this_v));
            if len(this_desc) > 20 {
                this_desc = str_substr(this_desc, 0, 20) + "...";
            }
            this_desc = "\"" + this_desc + "\"";
        } elif jsv_is_null(this_v) {
            this_desc = "null";
        } elif jsv_is_undefined(this_v) {
            this_desc = "undefined";
        } elif jsv_is_bool(this_v) {
            if jsv_to_bool(this_v) {
                this_desc = "true";
            } else {
                this_desc = "false";
            }
        } elif jsv_is_int32(this_v) {
            this_desc = str(jsv_to_int32(this_v));
        } elif jsv_is_double(this_v) {
            this_desc = str(jsv_to_double(this_v));
        } elif jsv_is_object_cell(this_v) {
            # Try to get the constructor name via obj.constructor.__CLASS_NAME__
            ctor_v: JSValue = js_object_get(this_v, WK_CONSTRUCTOR);
            if jsv_is_object_cell(ctor_v) and jsv_to_table_id(ctor_v) >= 0 {
                cn_v: JSValue = js_object_get(ctor_v, WK_CLASS_NAME);
                if jsv_is_string_cell(cn_v) {
                    this_desc = str_from_id(jsv_to_table_id(cn_v));
                }
            }
            if this_desc == "" {
                this_desc = "(object)";
            }
        } else {
            this_desc = "(unknown)";
        }
        return this_desc + "." + meth_name;
    }
    return _not_fn_desc(meth_v);
}

def _not_fn_desc(v: JSValue) -> str {
    if jsv_is_undefined(v) {
        return "undefined";
    }
    if jsv_is_null(v) {
        return "null";
    }
    if jsv_is_bool(v) {
        if jsv_to_bool(v) {
            return "true";
        } else {
            return "false";
        }
    }
    if jsv_is_int32(v) {
        return str(jsv_to_int32(v));
    }
    if jsv_is_double(v) {
        return str(jsv_to_double(v));
    }
    if jsv_is_string_cell(v) {
        return "\"" + str_from_id(jsv_to_table_id(v)) + "\"";
    }
    if jsv_is_symbol(v) {
        return "Symbol";
    }
    if jsv_is_object_cell(v) {
        return "(an Object)";
    }
    return "(unknown)";
}

# ── Spread helpers ──────────────────────────────────────────────────────────

"""Collect all items from an iterable value into a plain JSArray."""
def _collect_iterable(src: JSValue) -> JSValue {
    if jsv_is_object_cell(src) {
        ci_i: JSValue = js_object_get(src, WK_I);
        if jsv_is_object_cell(ci_i) {
            return ci_i;
        }
        if js_is_array(src) {
            ci_copy: JSValue = js_array_create_with_length(js_array_len(src));
            ci_n: int = js_array_len(src);
            ci_k: int = 0;
            while ci_k < ci_n {
                ci_ks: int = str_intern_index(ci_k);
                if js_object_has_own(src, ci_ks) {
                    js_object_set(ci_copy, ci_ks, js_object_get(src, ci_ks));
                }
                ci_k = ci_k + 1;
            }
            return ci_copy;
        }
        if js_is_set(src) {
            return js_set_values_array(src);
        }
        # Map default @@iterator is entries (not values) — Array.from/for-of/spread parity.
        if js_is_map(src) {
            return js_map_entries_array(src);
        }
        # Live Map/Set iterators: drain via iterator next (spread of m.keys()/entries()).
        if js_is_map_iterator(src) {
            ci_mitems: list[JSValue] = [];
            while True {
                ci_mstep: JSValue = js_map_iterator_next(src);
                if jsv_to_bool(js_object_get(ci_mstep, WK_DONE)) {
                    break;
                }
                ci_mitems.append(js_object_get(ci_mstep, WK_VALUE));
            }
            return js_array_create(ci_mitems);
        }
        if js_is_set_iterator(src) {
            ci_sitems: list[JSValue] = [];
            while True {
                ci_sstep: JSValue = js_set_iterator_next(src);
                if jsv_to_bool(js_object_get(ci_sstep, WK_DONE)) {
                    break;
                }
                ci_sitems.append(js_object_get(ci_sstep, WK_VALUE));
            }
            return js_array_create(ci_sitems);
        }
        # `arguments` exotic object: iterate its indexed values (0..length-1), not its
        # property names — its @@iterator is %Array.prototype.values% (ES §10.4.4).
        if js_object_has_own(src, _KEY_IS_ARGUMENTS) {
            ci_al: JSValue = js_object_get(src, WK_LENGTH);
            ci_alen: int = 0;
            if jsv_is_int32(ci_al) {
                ci_alen = jsv_to_int32(ci_al);
            } elif jsv_is_double(ci_al) {
                ci_alen = int(jsv_to_double(ci_al));
            }
            ci_avals: list[JSValue] = [];
            ci_av: int = 0;
            while ci_av < ci_alen {
                ci_avals.append(js_object_get(src, str_intern_index(ci_av)));
                ci_av = ci_av + 1;
            }
            return js_array_create(ci_avals);
        }
    }
    if jsv_is_string_cell(src) {
        # Same code points as the string iterator (for-of / Array.from): `[..."é😀"]`
        # is ["é", "😀"]. The old byte loop sliced the UTF-8 storage one byte at a
        # time, so every non-ASCII character spread into invalid one-byte strings.
        return js_object_get(js_make_iterator(src), WK_I);
    }
    return js_array_create([]);
}

"""Expand spread-sentinel arrays in an args list."""
def _expand_spreads(args: list[JSValue]) -> list[JSValue] {
    has_spread: bool = False;
    for ea in args {
        if jsv_is_object_cell(ea)
            and jsv_to_table_id(ea) > 0
            and js_object_has_own(ea, _KEY_IS_SPREAD) {
            has_spread = True;
        }
    }
    if not has_spread {
        return args;
    }
    result: list[JSValue] = [];
    for eb in args {
        if jsv_is_object_cell(eb)
            and jsv_to_table_id(eb) > 0
            and js_object_has_own(eb, _KEY_IS_SPREAD) {
            es_n: int = js_array_len(eb);
            es_i: int = 0;
            while es_i < es_n {
                result.append(js_array_get(eb, es_i));
                es_i = es_i + 1;
            }
        } else {
            result.append(eb);
        }
    }
    return result;
}


