    _NATIVE_SPECIAL_KINDS[NATIVE_KIND_REFLECT_SET] = True;
    _NATIVE_SPECIAL_KINDS[NATIVE_KIND_REFLECT_SET_PROTOTYPE_OF] = True;
    _NSK_READY = True;
}

def _vm_call_native_proxy_aware(
    vm: VM,
    realm: Realm,
    kind: int,
    this_val: JSValue,
    args: list[JSValue],
    native_fn: JSValue = js_undefined()
) -> JSValue {
    if not _NSK_READY {
        _nsk_init();
    }
    if kind not in _NATIVE_SPECIAL_KINDS {
        _push_native_obs_vm(vm);
        fast_res: JSValue = call_native(realm, kind, this_val, args, native_fn);
        _pop_native_obs_vm();
        return fast_res;
    }
    if kind == NATIVE_KIND_FN_BIND {
        # Function.prototype.bind via .call/.apply/Reflect.apply — same helper
        # as the inline CALL_METHOD path / _invoke_callable_value.
        bt: JSValue = js_undefined();
        if len(args) > 0 {
            bt = args[0];
        }
        partials: list[JSValue] = [];
        pi: int = 1;
        while pi < len(args) {
            partials.append(args[pi]);
            pi = pi + 1;
        }
        return vm._make_bound_fn(this_val, bt, partials);
    }
    if kind == NATIVE_KIND_ITER_NEXT {
        # Array/string/Set/Map iterator .next() reached via .call/.apply/
        # Reflect.apply (the inline CALL_METHOD path handles the direct call).
        # Without an entry here those forms returned undefined silently, and a
        # bad receiver was not rejected — `setIterator.next.call(set)` must throw.
        return vm._vm_iter_next_result(this_val);
    }
    if kind == NATIVE_KIND_FN_HAS_INSTANCE {
        # Function.prototype[@@hasInstance](V) → OrdinaryHasInstance(this, V), §20.2.3.6.
        hi_v: JSValue = js_undefined();
        if len(args) > 0 {
            hi_v = args[0];
        }
        return vm._ordinary_has_instance(this_val, hi_v);
    }
    if kind == NATIVE_KIND_ARRAY_TOREVERSED {
        # Change-array-by-copy: ArrayCreate (not ArraySpeciesCreate). ToObject(this).
        _push_native_obs_vm(vm);
        tr_this: JSValue = _vm_array_to_object(this_val);
        if vm_has_native_exc() {
            _pop_native_obs_vm();
            return js_undefined();
        }
        tr_res: JSValue = js_Array_toReversed(tr_this);
        _pop_native_obs_vm();
        return tr_res;
    }
    if kind == NATIVE_KIND_ARRAY_TOSORTED {
        if len(args) > 0 and is_fn_val(args[0]) {
            _push_native_obs_vm(vm);
            ats_res: JSValue = _vm_array_tosorted_with_comparefn(vm, this_val, args[0]);
            _pop_native_obs_vm();
            return ats_res;
        }
        # Default / non-JS comparefn: native path (validates, dense default sort).
    }
    # R17: join / toString / toLocaleString — shared path for direct, .call/.apply.
    if kind == NATIVE_KIND_ARRAY_JOIN {
        a0_jn: JSValue = js_undefined();
        if len(args) > 0 {
            a0_jn = args[0];
        }
        _push_native_obs_vm(vm);
        jn_res: JSValue = _vm_array_join(vm, this_val, a0_jn);
        _pop_native_obs_vm();
        return jn_res;
    }
    if kind == NATIVE_KIND_ARRAY_TOSTRING {
        _push_native_obs_vm(vm);
        ats_str_res: JSValue = _vm_array_toString(vm, this_val);
        _pop_native_obs_vm();
        return ats_str_res;
    }
    if kind == NATIVE_KIND_ARRAY_TOLOCALESTRING {
        _push_native_obs_vm(vm);
        atls_res: JSValue = _vm_array_toLocaleString(vm, this_val);
        _pop_native_obs_vm();
        return atls_res;
    }
    if kind == NATIVE_KIND_OBJ_PROTO_TOLOCALESTRING {
        _push_native_obs_vm(vm);
        otls_res: JSValue = _vm_object_proto_tolocalestring(vm, this_val);
        _pop_native_obs_vm();
        return otls_res;
    }
    # R15: Array.prototype.keys / values / entries / %ArrayIteratorPrototype%.next
    if kind == NATIVE_KIND_ARRAY_KEYS {
        _push_native_obs_vm(vm);
        aik_res: JSValue = _vm_array_create_iterator(vm, this_val, ARRAY_ITER_KIND_KEY);
        _pop_native_obs_vm();
        return aik_res;
    }
    if kind == NATIVE_KIND_ARRAY_VALUES {
        _push_native_obs_vm(vm);
        aiv_res: JSValue = _vm_array_create_iterator(
            vm, this_val, ARRAY_ITER_KIND_VALUE
        );
        _pop_native_obs_vm();
        return aiv_res;
    }
    if kind == NATIVE_KIND_ARRAY_ENTRIES {
        _push_native_obs_vm(vm);
        aie_res: JSValue = _vm_array_create_iterator(
            vm, this_val, ARRAY_ITER_KIND_KEY_VALUE
        );
        _pop_native_obs_vm();
        return aie_res;
    }
    if kind == NATIVE_KIND_ARRAY_ITER_NEXT {
        _push_native_obs_vm(vm);
        ain_res: JSValue = _vm_array_iterator_next(vm, this_val);
        _pop_native_obs_vm();
        return ain_res;
    }
    if kind == NATIVE_KIND_MAP_SET_ITER_NEXT {
        if js_is_map_iterator(this_val) {
            return js_map_iterator_next(this_val);
        }
        if js_is_set_iterator(this_val) {
            return js_set_iterator_next(this_val);
        }
        vm_throw_native(
            make_type_error(
                "Map/Set Iterator.prototype.next called on incompatible receiver"
            )
        );
        return js_undefined();
    }
    if kind == NATIVE_KIND_ITERATOR_RETURN_THIS {
        return this_val;
    }
    # R10/R11: Array.from / Array.of — shared path for direct, .call/.apply, and detached calls.
    if kind == NATIVE_KIND_ARRAY_FROM {
        _push_native_obs_vm(vm);
        afrom_res: JSValue = _vm_array_from(vm, this_val, args);
        _pop_native_obs_vm();
        return afrom_res;
    }
    if kind == NATIVE_KIND_ARRAY_FROM_ASYNC {
        _push_native_obs_vm(vm);
        afa_res: JSValue = _vm_array_from_async(vm, this_val, args);
        _pop_native_obs_vm();
        return afa_res;
    }
    if kind == NATIVE_KIND_ARRAY_OF {
        _push_native_obs_vm(vm);
        aof_res: JSValue = _vm_array_of(vm, this_val, args);
        _pop_native_obs_vm();
        return aof_res;
    }
    if kind == NATIVE_KIND_ARRAY_CONCAT {
        _push_native_obs_vm(vm);
        cat_res: JSValue = _vm_array_concat(vm, this_val, args);
        _pop_native_obs_vm();
        return cat_res;
    }
    if kind == NATIVE_KIND_ARRAY_SLICE {
        a0_sl: JSValue = js_undefined();
        a1_sl: JSValue = js_undefined();
        if len(args) > 0 {
            a0_sl = args[0];
        }
        if len(args) > 1 {
            a1_sl = args[1];
        }
        _push_native_obs_vm(vm);
