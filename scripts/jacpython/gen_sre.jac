"""Generate the native _sre module's constants and per-width matchers.

Modules/_sre/sre_constants.h is Tools/build/generate_sre_constants.py's output
from Lib/re/_constants.py, and sre.c includes sre_lib.h three times, once
per character width. This script reads the constants from the pinned CPython
archive and writes them as Jac constants, and writes the matcher template
scripts/jacpython/sre_lib.jac.in once for each width:

    jac run scripts/jacpython/gen_sre.jac            # rewrite the modules
    jac run scripts/jacpython/gen_sre.jac --check    # fail on drift

- jaclang/runtime/python/modules/sre_constants.jac
- jaclang/runtime/python/modules/sre_ucs1.jac (Py_UCS1)
- jaclang/runtime/python/modules/sre_ucs2.jac (Py_UCS2)
- jaclang/runtime/python/modules/sre_ucs4.jac (Py_UCS4)

The template names the character type `SreChar`, its width in bytes
`SRE_CHAR_BYTES` and the largest code it holds `SRE_CHAR_MAX`. SRE(match)
is one loop over the C's labels; the template writes a `case` of it per
label as `case S_<LABEL>:` and an opcode's as `case SRE_OP_<NAME>:`, and
sre_lib.h's control macros as statements of their own, which this script
expands:

    DISPATCH;               continue at the next opcode
    GOTO(S_<LABEL>);        continue at a label
    RETURN_FAILURE;         exit the context with 0
    RETURN_SUCCESS;         exit the context with 1
    RETURN_ERROR(value);    return the error from the whole match
    EXIT_CONTEXT;           pop the context and resume its parent
    DO_JUMP(JUMP_<X>, pattern);   enter a context for the sub-pattern,
    DO_JUMP0(JUMP_<X>, pattern);  resuming at S_RESUME_<X> (DO_JUMP0 as not
                                  top level)

The opcode dispatch loop, between `# BEGIN DISPATCH LOOP` and
`# END DISPATCH LOOP`, continues from one opcode to the next as its own
loop; its macros leave it for any other label.
"""
import argparse;
import re;
import sys;
import from pathlib { Path }
import from common {
    REPO,
    RUNTIME,
    archive_texts,
    format_jac_many,
    pin,
    write_or_check
}

glob COMMAND: str = "scripts/jacpython/gen_sre.jac",
     HEADER: str = "Modules/_sre/sre_constants.h",
     TEMPLATE: Path = REPO / "scripts/jacpython/sre_lib.jac.in",
     # (module suffix, Jac character type, largest code)
     WIDTHS: list[tuple[int, str, str]] = [
         (1, "u8", "0xFF"),
         (2, "u16", "0xFFFF"),
         (4, "u32", "0xFFFFFFFF")
     ];

def constants_module(text: str, version: str) -> str {
    names = re.findall(r"^#define (SRE_\w+) (\d+)$", text, re.M);
    if not names {
        sys.exit(f"{COMMAND}: no constants in {HEADER}");
    }
    lines = [
        '"""The _sre engine\'s opcodes, positions, categories and flags.',
        "",
        f"Generated by {COMMAND} from CPython {version} {HEADER}",
        "(Tools/build/generate_sre_constants.py's output from Lib/re/_constants.py);",
        "do not edit. See ../LICENSE.cpython.",
        '"""',
        ""
    ];
    for (index, (name, value)) in enumerate(names) {
        head = "glob " if index == 0 else "     ";
        tail = ";" if index == len(names) - 1 else ",";
        lines.append(f"{head}{name}: Final[int] = {value}{tail}");
    }
    return "\n".join(lines) + "\n";
}

# The labels SRE(match)'s loop steps between: the opcode dispatch loop, the
# exit of a context, the heads of the loops a DO_JUMP interrupts, and after
# S_RESUME the label each sre_lib.h JUMP_* value resumes at (S_RESUME + value).
glob STEPS: list[str] = [
         "S_DISPATCH",
         "S_EXIT",
         "S_BRANCH_LOOP",
         "S_REPEAT_ONE_LITERAL",
         "S_REPEAT_ONE_GENERAL",
         "S_MIN_REPEAT_ONE_LOOP",
         "S_MAX_UNTIL_TAIL",
         "S_POSS_REPEAT_MIN",
         "S_POSS_REPEAT_MORE",
         "S_POSS_REPEAT_DONE"
     ],
     # sre_lib.h's JUMP_* values.
     JUMPS: list[str] = [
         "MAX_UNTIL_1",
         "MAX_UNTIL_2",
         "MAX_UNTIL_3",
         "MIN_UNTIL_1",
         "MIN_UNTIL_2",
         "MIN_UNTIL_3",
         "REPEAT",
         "REPEAT_ONE_1",
         "REPEAT_ONE_2",
         "MIN_REPEAT_ONE",
         "BRANCH",
         "ASSERT",
         "ASSERT_NOT",
         "POSS_REPEAT_1",
         "POSS_REPEAT_2",
         "ATOMIC_GROUP"
     ],
     DISPATCH_BEGIN: str = "# BEGIN DISPATCH LOOP",
     DISPATCH_END: str = "# END DISPATCH LOOP";

def step_numbers -> dict[str, int] {
    numbers = {name: index for (index, name) in enumerate(STEPS)};
    numbers["S_RESUME"] = len(STEPS) - 1;
    for (index, name) in enumerate(JUMPS) {
        numbers[f"S_RESUME_{name}"] = len(STEPS) + index;
    }
    return numbers;
}

# The statements a control macro line stands for, at its indentation. Inside
# the dispatch loop (`inner`) the next opcode is the loop's next iteration and
# any other label is left through the step; outside it, every label is.
def expand_macro(indent: str, name: str, argument: str, inner: bool) -> list[str] {
    leave = "break;" if inner else "continue;";
    dispatch = ["continue;"] if inner else ["step = S_DISPATCH;", "continue;"];
    lines: list[str] = [];
    if name == "DISPATCH" {
        lines = dispatch;
    } elif name == "GOTO" {
        lines = [f"step = {argument};", leave];
    } elif name == "RETURN_FAILURE" {
        lines = ["ret = 0;", "step = S_EXIT;", leave];
    } elif name == "RETURN_SUCCESS" {
        lines = ["ret = 1;", "step = S_EXIT;", leave];
    } elif name == "RETURN_ERROR" {
        lines = [f"return {argument};"];
    } elif name == "EXIT_CONTEXT" {
        # exit: pop the context; return from the outermost one, otherwise
        # resume its parent where its jump value says, with the pattern and
        # position it saved.
        lines = [
            "ctx_pos = ctx.view(1)[0].last_ctx_pos;",
            "jump = ctx.view(1)[0].jump;",
            "state.view(1)[0].data_stack_base = wrapping_sub(state.view(1)[0].data_stack_base, i64(SRE_CONTEXT_SIZE));",
            "if ctx_pos == -1 {",
            "    state.view(1)[0].sigcount = sigcount;",
            "    return ret;",
            "}",
            "ctx = context_at(state, ctx_pos);",
            "pattern = ctx.view(1)[0].pattern;",
            "position = ptr[SreChar](ctx.view(1)[0].position);",
            "step = S_RESUME + int(jump);",
            "continue;"
        ];
    } else {
        # DO_JUMP and DO_JUMP0: save the pattern and position in this
        # context, push one for the sub-pattern and enter it.
        (jump, target) = [part.strip() for part in argument.split(",", 1)];
        toplevel = "ctx.view(1)[0].toplevel" if name == "DO_JUMP" else "i32(0)";
        lines = [
            f"jump_target = {target};",
            f"jump_toplevel = {toplevel};",
            "ctx.view(1)[0].pattern = pattern;",
            "ctx.view(1)[0].position = ptr(position);",
            "ctx_pos = context_offset(state, ctx);",
            "alloc_pos = context_alloc(state);",
            "if alloc_pos < 0 {",
            "    return SRE_ERROR_MEMORY;",
            "}",
            "ctx = context_at(state, alloc_pos);",
            "ctx.view(1)[0].toplevel = jump_toplevel;",
            f"ctx.view(1)[0].jump = {jump};",
            "ctx.view(1)[0].last_ctx_pos = ctx_pos;",
            "pattern = jump_target;",
            "position = ptr[SreChar](state.view(1)[0].position);",
            "if arg(pattern, 0) == SRE_OP_INFO {",
            "    jump_min = arg(pattern, 3);",
            "    if jump_min != 0 and end - position >= 0 and end - position < i64(jump_min) {",
            "        ret = 0;",
            "        step = S_EXIT;",
            "        " + leave,
            "    }",
            "    pattern += int(arg(pattern, 1)) + 1;",
            "}"
        ]
            + dispatch;
    }
    return [indent + line for line in lines];
}

def width_module(
    template: str, width: int, char_type: str, limit: str, opcodes: dict[str, str]
) -> str {
    macro = re.compile(
        r"^(\s*)(DISPATCH|GOTO|RETURN_FAILURE|RETURN_SUCCESS|RETURN_ERROR|EXIT_CONTEXT|DO_JUMP0|DO_JUMP)(?:\((.*)\))?;\s*$"
    );
    lines: list[str] = [];
    inner = False;
    for line in template.splitlines() {
        if line.strip() == DISPATCH_BEGIN {
            inner = True;
            continue;
        }
        if line.strip() == DISPATCH_END {
            inner = False;
            continue;
        }
        found = macro.match(line);
        if found {
            lines.extend(
                expand_macro(
                    found.group(1), found.group(2), found.group(3) or "", inner
                )
            );
        } else {
            lines.append(line);
        }
    }
    text = "\n".join(lines) + "\n";
    for (name, number) in opcodes.items() {
        text = text.replace(f"case {name}:", f"case {number}:");
    }
    for (name, number) in step_numbers().items() {
        text = re.sub(rf"\b{name}\b", str(number), text);
    }
    text = text.replace("SRE_CHAR_BYTES", str(width));
    text = text.replace("SRE_CHAR_MAX", limit);
    return re.sub(r"\bSreChar\b", char_type, text);
}

with entry:__main__ {
    parser = argparse.ArgumentParser(
        description="Generate the native _sre constants and matchers"
    );
    parser.add_argument("--check", action="store_true");
    args = parser.parse_args();
    texts = archive_texts((HEADER, ));
    if HEADER not in texts {
        sys.exit(f"{COMMAND}: {HEADER} is not in the pinned archive");
    }
    version = pin()["version"];
    template = TEMPLATE.read_text();
    opcodes = dict(re.findall(r"^#define (SRE_OP_\w+) (\d+)$", texts[HEADER], re.M));
    rendered: list[tuple[str, Path]] = [
        (
            constants_module(texts[HEADER], version),
            RUNTIME / "modules/sre_constants.jac"
        )
    ];
    for (width, char_type, limit) in WIDTHS {
        rendered.append(
            (
                width_module(template, width, char_type, limit, opcodes),
                RUNTIME / f"modules/sre_ucs{width}.jac"
            )
        );
    }
    formatted = format_jac_many(rendered);
    current = True;
    for ((_, target), text) in zip(rendered, formatted) {
        current = write_or_check(target, text, args.check, COMMAND) and current;
    }
    if not current {
        sys.exit(1);
    }
}
