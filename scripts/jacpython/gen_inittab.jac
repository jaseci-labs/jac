"""Generate the interpreter's table of built-in modules as Jac C data.

CPython's makesetup writes `_PyImport_Inittab` into Modules/config.c. In
JacPython the table is Jac: every module listed in
jac/bootstrap/python/jacpython-modules.txt contributes the address of its
`PyInit_<module>`, which makes that definition a real use of the binding and
roots it in the native object. Built-in modules whose init function is still
C are listed below and move to the registry as they are ported.

    jac run scripts/jacpython/gen_inittab.jac            # rewrite the table
    jac run scripts/jacpython/gen_inittab.jac --check    # fail on drift

- jac/jaclang/runtime/python/inittab.jac
- the `bindings.<file> ++> inittab { PyInit_<module> }` wires of
  jac/jaclang/archwire.jac
"""
import argparse;
import re;
import shutil;
import subprocess;
import sys;
import from pathlib { Path }
import from common { BOOTSTRAP, JAC, REPO, RUNTIME, format_jac, write_or_check }

glob COMMAND: str = "scripts/jacpython/gen_inittab.jac",
     REGISTRY: Path = BOOTSTRAP / "jacpython-modules.txt",
     TARGET: Path = RUNTIME / "inittab.jac",
     ARCHWIRE: Path = JAC / "jaclang/archwire.jac",
     WIRE_BLOCK: str = "graph import runtime.python {",
     # Built-in modules whose init function is still CPython's C, in the
     # order makesetup and config.c.in list them: (module, C function). An
     # empty function is a name sys.builtin_module_names reports whose module
     # the interpreter creates itself.
     C_MODULES: list[tuple[str, str]] = [
         ("_io", "PyInit__io"),
         ("marshal", "PyMarshal_Init"),
         ("_imp", "PyInit__imp"),
         ("_ast", "PyInit__ast"),
         ("_tokenize", "PyInit__tokenize"),
         ("_symtable", "PyInit__symtable"),
         ("builtins", ""),
         ("sys", ""),
         ("gc", "PyInit_gc"),
         ("_warnings", "_PyWarnings_Init"),
         ("_string", "PyInit__string")
     ];

def registry_modules -> list[str] {
    modules: list[str] = [];
    for line in REGISTRY.read_text().splitlines() {
        fields = line.split("#", 1)[0].split();
        if fields {
            modules.append(fields[0]);
        }
    }
    return modules;
}

# The binding module, relative to runtime.python, that defines PyInit_<module>.
def binding_of(module: str) -> str {
    pattern = re.compile(rf"^def:pub PyInit_{re.escape(module)}\b", re.M);
    found = [
        path
        for path in sorted((RUNTIME / "bindings").rglob("*.jac"))
        if pattern.search(path.read_text())
    ];
    if len(found) != 1 {
        sys.exit(
            f"{COMMAND}: expected one `def:pub PyInit_{module}` under "
            f"{(RUNTIME / 'bindings').relative_to(REPO)}, found {len(found)}"
        );
    }
    return ".".join(found[0].relative_to(RUNTIME).with_suffix("").parts);
}

def table_row(name: str, function: str) -> str {
    initfunc = f"ptr({function})" if function else "ptr()";
    return f'_inittab(name=ptr[u8]("{name}"), initfunc={initfunc})';
}

def inittab_module(modules: list[str]) -> str {
    externs = [
        function
        for (_, function) in C_MODULES
        if function
    ];
    rows = [table_row(module, f"PyInit_{module}") for module in modules];
    rows += [table_row(name, function) for (name, function) in C_MODULES];
    rows.append("_inittab(name=ptr[u8](), initfunc=ptr())");
    lines = [
        '"""CPython\'s table of built-in modules, `_PyImport_Inittab`, as C data.',
        "",
        f"Generated by {COMMAND} from",
        "jac/bootstrap/python/jacpython-modules.txt; do not edit. Each native module",
        "contributes its binding's PyInit; the modules after them are still",
        "CPython's C. See LICENSE.cpython.",
        '"""',
        "",
        "import from c {",
        "    obj _inittab {",
        "        has name: ptr[u8],",
        "            initfunc: ptr;",
        "    }",
        ""
    ];
    lines += [f"    def {function} -> ptr[PyObject];" for function in externs];
    lines += ["", "    glob _PyImport_Inittab: list[_inittab] = ["];
    lines.append(",\n".join(f"        {row}" for row in rows));
    lines += ["    ];", "}"];
    return "\n".join(lines) + "\n";
}

def wires(modules: list[str]) -> list[str] {
    out = [
        f"    {binding_of(module)} ++> inittab {{ PyInit_{module} }}"
        for module in modules
    ];
    out.append("    cpython_api ++> inittab { PyObject }");
    return out;
}

# A wire is present when its name sits in a statement that wires into
# `inittab`; `jac fmt` may have grouped the statement in list form.
def wires_missing(modules: list[str]) -> list[str] {
    text = ARCHWIRE.read_text();
    return [
        module
        for module in modules
        if not re.search(
            r"inittab\s*\{[^}]*\bPyInit_" + re.escape(module) + r"\b", text
        )
    ];
}

def add_wires(modules: list[str]) {
    text = ARCHWIRE.read_text();
    if WIRE_BLOCK not in text {
        sys.exit(f"{COMMAND}: no `{WIRE_BLOCK}` block in {ARCHWIRE.relative_to(REPO)}");
    }
    added = "\n".join(wires(modules));
    ARCHWIRE.write_text(text.replace(WIRE_BLOCK, f"{WIRE_BLOCK}\n{added}", 1));
    jac = shutil.which("jac");
    if jac is None {
        sys.exit("jac is not on PATH; archwire.jac is rendered with `jac fmt`");
    }
    result = subprocess.run(
        [jac, "fmt", str(ARCHWIRE)], capture_output=True, text=True
    );
    if result.returncode != 0 {
        sys.exit(f"jac fmt failed on archwire.jac:\n{result.stdout}{result.stderr}");
    }
    print(f"wired {len(modules)} modules in {ARCHWIRE.relative_to(REPO)}");
}

with entry {
    parser = argparse.ArgumentParser(
        description="Generate the table of built-in modules as Jac C data."
    );
    parser.add_argument("--check", action="store_true");
    args = parser.parse_args();
    modules = registry_modules();
    ok = write_or_check(
        TARGET, format_jac(inittab_module(modules), TARGET), args.check, COMMAND
    );
    missing = wires_missing(modules);
    if missing and args.check {
        print(
            f"{ARCHWIRE.relative_to(REPO)} does not wire PyInit for "
            f"{', '.join(missing)}; rerun {COMMAND}",
            file=sys.stderr
        );
        ok = False;
    } elif missing {
        add_wires(missing);
    }
    if not ok {
        sys.exit(1);
    }
}
