# .jacignore -- modules excluded from the repo-wide `jac check` gate.
#
# Precommit uses this file, and CI feeds it to `jac check --ignore` (see
# .github/workflows/ci.yml, "Run jac check (using .jacignore)"). CI adds
# `tests checker_*.jac *_err.jac` of its own; those are not listed here.
#
# Matching (compiler/frontend/helpers.jac:path_matches_exclude): an entry containing
# `/` is fnmatched against the whole path; a bare entry is fnmatched against
# EVERY path component, so a bare `types.jac` silences every file of that
# basename repo-wide. Every entry below is path-qualified for that reason --
# one line per excluded module, so a fix deletes exactly one line.
#
# Production-source exclusions below are temporary typing debt. Diagnostic
# fixtures remain excluded because their tests assert the expected errors.

# Deliberately invalid inputs validated by diagnostic regression tests.
# These are test data, not standalone programs expected to pass checking.
jac/tests/compiler/passes/fixtures/checker/checker_never_returns.jac
jac/tests/compiler/passes/fixtures/static_analysis/redundant_typing_imports.jac

# llvmlite-bound native IR generation.
# These NaIRGenPass body files reach llvmlite handles (ir.Function.args,
# .linkage, IRBuilder.append_basic_block, Type.as_pointer) through the
# vendored py2jac translation under backends/native/llvm/, whose
# ctypes-derived values the checker sees as Unknown. Not annotatable
# without typing that vendored surface. The declaration
# (na_ir_gen_pass.jac) and the other 32 body files are checked.
jac/jaclang/compiler/backends/native/na_ir_gen_pass.impl/calls.impl.jac
jac/jaclang/compiler/backends/native/na_ir_gen_pass.impl/core.impl.jac
jac/jaclang/compiler/backends/native/na_ir_gen_pass.impl/debug.impl.jac
jac/jaclang/compiler/backends/native/na_ir_gen_pass.impl/enums.impl.jac
jac/jaclang/compiler/backends/native/na_ir_gen_pass.impl/expr.impl.jac
jac/jaclang/compiler/backends/native/na_ir_gen_pass.impl/func.impl.jac
jac/jaclang/compiler/backends/native/na_ir_gen_pass.impl/generics.impl.jac
jac/jaclang/compiler/backends/native/na_ir_gen_pass.impl/iterators.impl.jac
jac/jaclang/compiler/backends/native/na_ir_gen_pass.impl/objects.impl.jac
jac/jaclang/compiler/backends/native/na_ir_gen_pass.impl/refcount.impl.jac
jac/jaclang/compiler/backends/native/na_ir_gen_pass.impl/stmt.impl.jac
jac/jaclang/compiler/backends/native/na_ir_gen_pass.impl/types.impl.jac
jac/jaclang/compiler/backends/native/na_ir_gen_pass.impl/vtable.impl.jac

