{
  "test_roots": [
    "tests",
    "jaclang/compiler/tests",
    "jaclang/byllm/tests",
    "jaclang/scale/tests"
  ],
  "excluded": {
    "jaclang/byllm/tests/test_mtir_integration.jac": "needs the sealed kit; runs in ci-sealed.yml"
  },
  "deps": {
    "serve": ["python-dotenv>=1.2.1,<2.0.0", "requests>=2.32.0,<3.0.0"],
    "dotenv": ["python-dotenv>=1.2.1,<2.0.0"],
    "byllm": ["litellm>=1.102.1,<1.103.0", "pillow>=12.0.0,<14.0.0", "httpx>=0.27.0", "loguru>=0.7.2,<0.8.0"],
    "scale": [
      "python-dotenv>=1.2.1,<2.0.0", "prometheus-client>=0.21.0,<1.0.0",
      "opentelemetry-sdk>=1.27.0,<2.0.0", "opentelemetry-exporter-otlp-proto-http>=1.27.0,<2.0.0",
      "apscheduler>=3.11.2,<4.0.0", "kubernetes>=34.1.0,<35.0.0", "docker>=7.1.0,<8.0.0",
      "boto3>=1.40.0,<2.0.0", "requests", "moto[s3]>=5.0.0"
    ],
    "firebase": ["google-cloud-firestore>=2.21.0,<3.0.0", "google-cloud-storage>=2.19.0,<3.0.0", "firebase-admin>=6.0.0,<8.0.0"]
  },
  "lanes": [
    {"name": "compiler-passes", "paths": ["tests/compiler/passes", "tests/compiler/backends/es"], "jobs": "2", "node": true, "home": true},
    {"name": "compiler-toplevel-1", "paths": ["tests/compiler/test_[a-c]*.jac"], "jobs": "2", "node": true, "home": true},
    {"name": "compiler-toplevel-2", "paths": ["tests/compiler/test_[d-n]*.jac"], "jobs": "2", "node": true, "home": true},
    {"name": "compiler-toplevel-3", "paths": ["tests/compiler/test_[o-z0-9_]*.jac"], "jobs": "2", "node": true, "home": true},
    {"name": "native-1", "paths": ["tests/compiler/backends/native/test_[!n]*.jac", "tests/compiler/backends/native/test_n[!a]*.jac", "tests/compiler/backends/native/test_na_*.jac", "tests/compiler/tools"], "jobs": "4", "node": true, "zig": true, "home": true, "artifacts": true},
    {"name": "native-2", "paths": ["tests/compiler/backends/native/test_native_[abcghs]*.jac"], "jobs": "4", "node": true, "zig": true, "home": true, "artifacts": true},
    {"name": "native-3", "paths": ["tests/compiler/backends/native/test_native_[defi-rt-z]*.jac"], "jobs": "4", "node": true, "zig": true, "home": true, "artifacts": true},
    {"name": "equivalence", "paths": ["jaclang/compiler/tests"], "jobs": "3", "node": true, "home": true, "iface_verify": true},
    {"name": "runtime-runtimelib", "paths": ["tests/runtimelib", "tests/language", "tests/dist"], "node": true, "bun": true, "deps": ["serve"], "home": true, "xdg": true},
    {"name": "runtime-rest", "paths": ["tests"], "ignore": ["tests/compiler", "tests/client", "tests/runtimelib", "tests/language", "tests/dist"], "node": true, "bun": true, "deps": ["serve"], "home": true, "xdg": true},
    {"name": "client", "paths": ["tests/client"], "jobs": "2", "node": true, "bun": true, "deps": ["dotenv"], "submodules": true},
    {"name": "byllm", "paths": ["jaclang/byllm/tests"], "ignore": ["jaclang/byllm/tests/test_mtir_integration.jac"], "deps": ["byllm"], "submodules": true},
    {"name": "scale-server", "paths": ["jaclang/scale/tests/server"], "filter": "not hmr", "jobs": "1", "bun": true, "deps": ["scale", "firebase"], "submodules": true},
    {"name": "scale-data", "paths": ["jaclang/scale/tests/data"], "jobs": "1", "bun": true, "deps": ["scale", "firebase"], "submodules": true},
    {"name": "scale-microservices", "paths": ["jaclang/scale/tests/microservices"], "jobs": "1", "bun": true, "deps": ["scale"], "submodules": true},
    {"name": "scale-deploy", "paths": ["jaclang/scale/tests/deploy"], "jobs": "1", "bun": true, "deps": ["scale"], "submodules": true},
    {"name": "scale-misc", "paths": ["jaclang/scale/tests/misc", "jaclang/scale/tests/apps"], "jobs": "1", "bun": true, "deps": ["scale"], "submodules": true}
  ]
}
