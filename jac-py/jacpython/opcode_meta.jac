    if op == OP_TO_BOOL {
        return 3;
    }
    if op == OP_BINARY_OP {
        return 5;
    }
    if op == OP_CALL {
        return 3;
    }
    if op == OP_CALL_KW {
        return 3;
    }
    if op == OP_COMPARE_OP {
        return 1;
    }
    if op == OP_CONTAINS_OP {
        return 1;
    }
    if op == OP_FOR_ITER {
        return 1;
    }
    if op == OP_JUMP_BACKWARD {
        return 1;
    }
    if op == OP_LOAD_ATTR {
        return 9;
    }
    if op == OP_LOAD_GLOBAL {
        return 4;
    }
    if op == OP_LOAD_SUPER_ATTR {
        return 1;
    }
    if op == OP_POP_JUMP_IF_FALSE {
        return 1;
    }
    if op == OP_POP_JUMP_IF_NONE {
        return 1;
    }
    if op == OP_POP_JUMP_IF_NOT_NONE {
        return 1;
    }
    if op == OP_POP_JUMP_IF_TRUE {
        return 1;
    }
    if op == OP_SEND {
        return 1;
    }
    if op == OP_STORE_ATTR {
        return 4;
    }
    if op == OP_UNPACK_SEQUENCE {
        return 1;
    }
    return 0;
}

