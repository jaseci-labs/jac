"""jacpython token model.

GENERATED by jac-py/tools/tokens2jac.py from reference/cpython/Grammar/Tokens
(CPython pin: see CURRENT.md). Do not edit by hand - regenerate instead.

Coordinate convention (matches CPython 3.14 / compiler_ir.cloc):
  lineno / end_lineno: 1-based line numbers
  col_offset / end_col_offset: 0-based byte offsets into the source line

Keywords are NAME tokens at the scanner; keyword vs identifier
distinction is enforced by the PEG parser keyword tables (P0.6/P0.7).
SOFT_KEYWORD is a distinct terminal for soft-keyword spellings.
"""

# na-clean leaf: no imports, no host calls.

# ---------------- token type ids and tables (module-level glob) ----------------
glob ENDMARKER: int = 0,
     NAME: int = 1,
     NUMBER: int = 2,
     STRING: int = 3,
     NEWLINE: int = 4,
     INDENT: int = 5,
     DEDENT: int = 6,
     LPAR: int = 7,
     RPAR: int = 8,
     LSQB: int = 9,
     RSQB: int = 10,
     COLON: int = 11,
     COMMA: int = 12,
     SEMI: int = 13,
     PLUS: int = 14,
     MINUS: int = 15,
     STAR: int = 16,
     SLASH: int = 17,
     VBAR: int = 18,
     AMPER: int = 19,
     LESS: int = 20,
     GREATER: int = 21,
     EQUAL: int = 22,
     DOT: int = 23,
     PERCENT: int = 24,
     LBRACE: int = 25,
     RBRACE: int = 26,
     EQEQUAL: int = 27,
     NOTEQUAL: int = 28,
     LESSEQUAL: int = 29,
     GREATEREQUAL: int = 30,
     TILDE: int = 31,
     CIRCUMFLEX: int = 32,
     LEFTSHIFT: int = 33,
     RIGHTSHIFT: int = 34,
     DOUBLESTAR: int = 35,
     PLUSEQUAL: int = 36,
     MINEQUAL: int = 37,
     STAREQUAL: int = 38,
     SLASHEQUAL: int = 39,
     PERCENTEQUAL: int = 40,
     AMPEREQUAL: int = 41,
     VBAREQUAL: int = 42,
     CIRCUMFLEXEQUAL: int = 43,
     LEFTSHIFTEQUAL: int = 44,
     RIGHTSHIFTEQUAL: int = 45,
     DOUBLESTAREQUAL: int = 46,
     DOUBLESLASH: int = 47,
     DOUBLESLASHEQUAL: int = 48,
     AT: int = 49,
     ATEQUAL: int = 50,
     RARROW: int = 51,
     ELLIPSIS: int = 52,
     COLONEQUAL: int = 53,
     EXCLAMATION: int = 54,
     OP: int = 55,
     TYPE_IGNORE: int = 56,
     TYPE_COMMENT: int = 57,
     SOFT_KEYWORD: int = 58,
     FSTRING_START: int = 59,
     FSTRING_MIDDLE: int = 60,
     FSTRING_END: int = 61,
     TSTRING_START: int = 62,
     TSTRING_MIDDLE: int = 63,
     TSTRING_END: int = 64,
     COMMENT: int = 65,
     NL: int = 66,
     ERRORTOKEN: int = 67,
     ENCODING: int = 68,
     NT_OFFSET: int = 256,
     N_TOKENS: int = 69,
     TOK_NO_LINE: int = -1,
     TOK_NO_COLUMN: int = -1;

glob EXACT_TOKEN_TYPES: dict[str, int] = {
         "!": EXCLAMATION,
         "!=": NOTEQUAL,
         "%": PERCENT,
         "%=": PERCENTEQUAL,
         "&": AMPER,
         "&=": AMPEREQUAL,
         "(": LPAR,
         ")": RPAR,
         "*": STAR,
         "**": DOUBLESTAR,
         "**=": DOUBLESTAREQUAL,
         "*=": STAREQUAL,
         "+": PLUS,
         "+=": PLUSEQUAL,
         ",": COMMA,
         "-": MINUS,
         "-=": MINEQUAL,
         "->": RARROW,
         ".": DOT,
         "...": ELLIPSIS,
         "/": SLASH,
         "//": DOUBLESLASH,
         "//=": DOUBLESLASHEQUAL,
         "/=": SLASHEQUAL,
         ":": COLON,
         ":=": COLONEQUAL,
         ";": SEMI,
         "<": LESS,
         "<<": LEFTSHIFT,
         "<<=": LEFTSHIFTEQUAL,
         "<=": LESSEQUAL,
         "=": EQUAL,
         "==": EQEQUAL,
         ">": GREATER,
         ">=": GREATEREQUAL,
         ">>": RIGHTSHIFT,
         ">>=": RIGHTSHIFTEQUAL,
         "@": AT,
         "@=": ATEQUAL,
         "[": LSQB,
         "]": RSQB,
         "^": CIRCUMFLEX,
         "^=": CIRCUMFLEXEQUAL,
         "{": LBRACE,
         "|": VBAR,
         "|=": VBAREQUAL,
         "}": RBRACE,
         "~": TILDE,

     };

glob TOKEN_NAMES: list[str] = [
         "ENDMARKER",
         "NAME",
         "NUMBER",
         "STRING",
         "NEWLINE",
         "INDENT",
         "DEDENT",
         "LPAR",
         "RPAR",
         "LSQB",
         "RSQB",
         "COLON",
         "COMMA",
         "SEMI",
         "PLUS",
         "MINUS",
         "STAR",
         "SLASH",
         "VBAR",
         "AMPER",
         "LESS",
         "GREATER",
         "EQUAL",
         "DOT",
         "PERCENT",
         "LBRACE",
         "RBRACE",
         "EQEQUAL",
         "NOTEQUAL",
         "LESSEQUAL",
         "GREATEREQUAL",
         "TILDE",
         "CIRCUMFLEX",
         "LEFTSHIFT",
         "RIGHTSHIFT",
         "DOUBLESTAR",
         "PLUSEQUAL",
         "MINEQUAL",
         "STAREQUAL",
         "SLASHEQUAL",
         "PERCENTEQUAL",
         "AMPEREQUAL",
         "VBAREQUAL",
         "CIRCUMFLEXEQUAL",
         "LEFTSHIFTEQUAL",
         "RIGHTSHIFTEQUAL",
         "DOUBLESTAREQUAL",
         "DOUBLESLASH",
         "DOUBLESLASHEQUAL",
         "AT",
         "ATEQUAL",
         "RARROW",
         "ELLIPSIS",
         "COLONEQUAL",
         "EXCLAMATION",
         "OP",
         "TYPE_IGNORE",
         "TYPE_COMMENT",
         "SOFT_KEYWORD",
         "FSTRING_START",
         "FSTRING_MIDDLE",
         "FSTRING_END",
         "TSTRING_START",
         "TSTRING_MIDDLE",
         "TSTRING_END",
         "COMMENT",
         "NL",
         "<ERRORTOKEN>",
         "<ENCODING>",

     ];

# ---------------- predicates (Include/internal/pycore_token.h) ----------------
def is_terminal(t: int) -> bool {
    return t < NT_OFFSET;
}

def is_nonterminal(t: int) -> bool {
    return t >= NT_OFFSET;
}

def is_eof(t: int) -> bool {
    return t == ENDMARKER;
}

def is_whitespace_token(t: int) -> bool {
    return t == ENDMARKER or t == NEWLINE or t == INDENT or t == DEDENT;
}

def is_stringlit_token(t: int) -> bool {
    return t == STRING or t == FSTRING_MIDDLE or t == TSTRING_MIDDLE;
}

def exact_token_type(spelling: str) -> int {
    if spelling in EXACT_TOKEN_TYPES {
        return EXACT_TOKEN_TYPES[spelling];
    }
    return OP;
}

def token_name(t: int) -> str {
    if t < 0 or t >= len(TOKEN_NAMES) {
        return "<invalid>";
    }
    return TOKEN_NAMES[t];
}

# ---------------- source locations ----------------
obj tok_loc {
    has lineno: int,
        end_lineno: int,
        col_offset: int,
        end_col_offset: int;
}

def tok_no_loc -> tok_loc {
    return tok_loc(
        lineno=TOK_NO_LINE,
        end_lineno=TOK_NO_LINE,
        col_offset=TOK_NO_COLUMN,
        end_col_offset=TOK_NO_COLUMN
    );
}

def tok_loc_span(
    lineno: int, end_lineno: int, col_offset: int, end_col_offset: int
) -> tok_loc {
    return tok_loc(
        lineno=lineno,
        end_lineno=end_lineno,
        col_offset=col_offset,
        end_col_offset=end_col_offset
    );
}

def same_tok_loc(a: tok_loc, b: tok_loc) -> bool {
    if a.lineno != b.lineno {
        return False;
    }
    if a.end_lineno != b.end_lineno {
        return False;
    }
    if a.col_offset != b.col_offset {
        return False;
    }
    if a.end_col_offset != b.end_col_offset {
        return False;
    }
    return True;
}

# ---------------- token value ----------------
obj tok_token {
    has tok_type: int,
        spelling: str,
        lineno: int,
        col_offset: int,
        end_lineno: int,
        end_col_offset: int,
        level: int = 0,
        metadata: str | None = None;
}

def token_loc(tok: tok_token) -> tok_loc {
    return tok_loc_span(tok.lineno, tok.end_lineno, tok.col_offset, tok.end_col_offset);
}

# ---------------- diagnostics ----------------
obj tok_diag {
    has kind: str,
        message: str,
        loc: tok_loc,
        filename: str = "<unknown>";
}

def mk_diag(kind: str, message: str, loc: tok_loc, filename: str) -> tok_diag {
    return tok_diag(kind=kind, message=message, loc=loc, filename=filename);
}
