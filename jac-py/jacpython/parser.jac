def rule_dotted_name(p: peg_parser) -> expr | None {
    hit = peg_check_memo(p, RULE_dotted_name);
    if hit.hit {
        return hit.result as expr | None;
    }
    mark = peg_mark(p);
    res: expr | None = None;
    resmark = mark;
    while True {
        peg_update_memo(p, mark, RULE_dotted_name, res);
        peg_reset(p, mark);
        raw = rule_dotted_name_raw(p);
        if peg_has_error(p) {
            return None;
        }
        if raw is None or peg_mark(p) <= resmark {
            break;
        }
        resmark = peg_mark(p);
        res = raw;
    }
    return peg_left_rec_finish(p, resmark, res) as expr;
}

def rule_dotted_name_raw(p: peg_parser) -> expr | None {
    mark = peg_mark(p);
    a = rule_dotted_name(p);
    if a is not None {
        lit = peg_expect_token(p, 23);
        if lit is not None {
            b = pa_name_from_token(peg_expect_token(p, NAME));
            if b is not None {
                res = pa_join_names_with_dot(a, b);
                return res;
            }
        }
    }
    peg_reset(p, mark);
    name_var = pa_name_from_token(peg_expect_token(p, NAME));
    if name_var is not None {
        res = name_var;
        return res;
    }
    peg_reset(p, mark);
    return None;
}

