        res = MatMult();
        return res;
    }
    peg_reset(p, mark);
    lit = peg_expect_token(p, 39);
    if lit is not None {
        res = Div();
        return res;
    }
    peg_reset(p, mark);
    lit = peg_expect_token(p, 40);
    if lit is not None {
        res = Mod();
        return res;
    }
    peg_reset(p, mark);
    lit = peg_expect_token(p, 41);
    if lit is not None {
        res = BitAnd();
        return res;
    }
    peg_reset(p, mark);
    lit = peg_expect_token(p, 42);
    if lit is not None {
        res = BitOr();
        return res;
    }
    peg_reset(p, mark);
    lit = peg_expect_token(p, 43);
    if lit is not None {
        res = BitXor();
        return res;
    }
    peg_reset(p, mark);
    lit = peg_expect_token(p, 44);
    if lit is not None {
        res = LShift();
        return res;
    }
    peg_reset(p, mark);
    lit = peg_expect_token(p, 45);
    if lit is not None {
        res = RShift();
        return res;
    }
    peg_reset(p, mark);
    lit = peg_expect_token(p, 46);
    if lit is not None {
        res = Pow();
        return res;
    }
    peg_reset(p, mark);
    lit = peg_expect_token(p, 48);
    if lit is not None {
        res = FloorDiv();
        return res;
    }
    peg_reset(p, mark);
    return None;
}

