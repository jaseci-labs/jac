def rule_simple_stmt(p: peg_parser) -> stmt | None {
    hit = peg_check_memo(p, RULE_simple_stmt);
    if hit.hit {
        return hit.result as stmt;
    }
    mark = peg_mark(p);
    start_lineno = 1;
    start_col_offset = 0;
    end_lineno = 1;
    end_col_offset = 0;
    if peg_fill_token(p) {
        t0 = p.tokens[p.mark];
        start_lineno = t0.lineno;
        start_col_offset = t0.col_offset;
    }
    assignment = rule_assignment(p);
    if assignment is not None {
        res = assignment;
        peg_insert_memo(p, mark, RULE_simple_stmt, res);
        return res;
    }
    peg_reset(p, mark);
    if (peg_positive_lookahead_token(p, 678)) {
        return_stmt = rule_return_stmt(p);
        if return_stmt is not None {
            res = return_stmt;
            peg_insert_memo(p, mark, RULE_simple_stmt, res);
            return res;
        }
    }
    peg_reset(p, mark);
    if (peg_positive_lookahead_token(p, 679)) {
        pass_stmt = rule_pass_stmt(p);
        if pass_stmt is not None {
            res = pass_stmt;
            peg_insert_memo(p, mark, RULE_simple_stmt, res);
            return res;
        }
    }
    peg_reset(p, mark);
    if (peg_positive_lookahead_token(p, 680)) {
        del_stmt = rule_del_stmt(p);
        if del_stmt is not None {
            res = del_stmt;
            peg_insert_memo(p, mark, RULE_simple_stmt, res);
            return res;
        }
    }
    peg_reset(p, mark);
    if ((peg_expect_soft_keyword(p, "type") is not None)) {
        # `&"type" type_alias` MUST precede star_expressions (CPython order):
        # otherwise a bare `type` matches as an expression and memoizes, hiding
        # the type-alias statement. The soft-keyword check is a lookahead;
        # rule_type_alias re-consumes "type", so rewind before calling it.
        peg_reset(p, mark);
        type_alias = rule_type_alias(p);
        if type_alias is not None {
            res = type_alias;
            peg_insert_memo(p, mark, RULE_simple_stmt, res);
            return res;
        }
    }
    peg_reset(p, mark);
    e = rule_star_expressions(p);
    if e is not None {
        end_tok = p.tokens[p.mark - 1];
        end_lineno = end_tok.end_lineno;
        end_col_offset = end_tok.end_col_offset;
        res = pa_ast_expr_stmt(
            e, start_lineno, start_col_offset, end_lineno, end_col_offset
        );
        peg_insert_memo(p, mark, RULE_simple_stmt, res);
        return res;
    }
    peg_reset(p, mark);
    if (
        (peg_positive_lookahead_token(p, 681) or peg_positive_lookahead_token(p, 702))
    ) {
        import_stmt = rule_import_stmt(p);
        if import_stmt is not None {
            res = import_stmt;
            peg_insert_memo(p, mark, RULE_simple_stmt, res);
            return res;
        }
    }
    peg_reset(p, mark);
    if (peg_positive_lookahead_token(p, 683)) {
        raise_stmt = rule_raise_stmt(p);
        if raise_stmt is not None {
            res = raise_stmt;
            peg_insert_memo(p, mark, RULE_simple_stmt, res);
            return res;
        }
    }
    peg_reset(p, mark);
    if (peg_positive_lookahead_token(p, 703)) {
        yield_stmt = rule_yield_stmt(p);
        if yield_stmt is not None {
            res = yield_stmt;
            peg_insert_memo(p, mark, RULE_simple_stmt, res);
            return res;
        }
    }
    peg_reset(p, mark);
    if (peg_positive_lookahead_token(p, 685)) {
        assert_stmt = rule_assert_stmt(p);
        if assert_stmt is not None {
            res = assert_stmt;
            peg_insert_memo(p, mark, RULE_simple_stmt, res);
            return res;
        }
    }
    peg_reset(p, mark);
    if (peg_positive_lookahead_token(p, 686)) {
        break_stmt = rule_break_stmt(p);
        if break_stmt is not None {
            res = break_stmt;
            peg_insert_memo(p, mark, RULE_simple_stmt, res);
            return res;
        }
    }
    peg_reset(p, mark);
    if (peg_positive_lookahead_token(p, 687)) {
        continue_stmt = rule_continue_stmt(p);
        if continue_stmt is not None {
            res = continue_stmt;
            peg_insert_memo(p, mark, RULE_simple_stmt, res);
            return res;
        }
    }
    peg_reset(p, mark);
    if (peg_positive_lookahead_token(p, 688)) {
        global_stmt = rule_global_stmt(p);
        if global_stmt is not None {
            res = global_stmt;
            peg_insert_memo(p, mark, RULE_simple_stmt, res);
            return res;
        }
    }
    peg_reset(p, mark);
    if (peg_positive_lookahead_token(p, 689)) {
        nonlocal_stmt = rule_nonlocal_stmt(p);
        if nonlocal_stmt is not None {
            res = nonlocal_stmt;
            peg_insert_memo(p, mark, RULE_simple_stmt, res);
            return res;
        }
    }
    peg_reset(p, mark);
    peg_insert_memo(p, mark, RULE_simple_stmt, None);
    return None;
}

def rule_simple_stmts(p: peg_parser) -> list[stmt] | None {
    mark = peg_mark(p);
    a = rule_simple_stmt(p);
    if a is not None {
        if (peg_negative_lookahead_token(p, 13)) {
            _newline = peg_expect_token(p, NEWLINE);
            if _newline is not None {
                res = pa_singleton_seq(a);
                return res;
            }
        }
    }
    peg_reset(p, mark);
    a = rule__gather_115(p);
    if a is not None {
        lit = peg_expect_token(p, 13);
        _newline = peg_expect_token(p, NEWLINE);
        if _newline is not None {
            res = a;
            return res;
        }
    }
    peg_reset(p, mark);
    return None;
}

