    if literal_pattern is not None {
        res = literal_pattern;
        peg_insert_memo(p, mark, RULE_closed_pattern, res);
        return res;
    }
    peg_reset(p, mark);
    capture_pattern = rule_capture_pattern(p);
    if capture_pattern is not None {
        res = capture_pattern;
        peg_insert_memo(p, mark, RULE_closed_pattern, res);
        return res;
    }
    peg_reset(p, mark);
    wildcard_pattern = rule_wildcard_pattern(p);
    if wildcard_pattern is not None {
        res = wildcard_pattern;
        peg_insert_memo(p, mark, RULE_closed_pattern, res);
        return res;
