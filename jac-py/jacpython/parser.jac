def rule_type_param(p: peg_parser) -> type_param | None {
    hit = peg_check_memo(p, RULE_type_param);
    if hit.hit {
        return hit.result as type_param;
    }
    mark = peg_mark(p);
    start_lineno = 1;
    start_col_offset = 0;
    end_lineno = 1;
    end_col_offset = 0;
    if peg_fill_token(p) {
        t0 = p.tokens[p.mark];
        start_lineno = t0.lineno;
        start_col_offset = t0.col_offset;
    }
    a = pa_name_from_token(peg_expect_token(p, NAME));
    if a is not None {
        b = rule_type_param_bound(p);
        c = rule_type_param_default(p);
        end_tok = p.tokens[p.mark - 1];
        end_lineno = end_tok.end_lineno;
        end_col_offset = end_tok.end_col_offset;
        res = TypeVar(
            name=pa_name_id(a),
            bound=b,
            default_value=c,
            lineno=start_lineno,
            col_offset=start_col_offset,
            end_lineno=end_lineno,
            end_col_offset=end_col_offset
        );
        peg_insert_memo(p, mark, RULE_type_param, res);
        return res;
    }
    peg_reset(p, mark);
    invalid_type_param = rule_invalid_type_param(p);
    if invalid_type_param is not None {
        res = invalid_type_param;
        peg_insert_memo(p, mark, RULE_type_param, res);
        return res;
    }
    peg_reset(p, mark);
    lit = peg_expect_token(p, 16);
    if lit is not None {
        a = pa_name_from_token(peg_expect_token(p, NAME));
        if a is not None {
            b = rule_type_param_starred_default(p);
            end_tok = p.tokens[p.mark - 1];
            end_lineno = end_tok.end_lineno;
            end_col_offset = end_tok.end_col_offset;
            res = TypeVarTuple(
                name=pa_name_id(a),
                default_value=b,
                lineno=start_lineno,
                col_offset=start_col_offset,
                end_lineno=end_lineno,
                end_col_offset=end_col_offset
            );
            peg_insert_memo(p, mark, RULE_type_param, res);
            return res;
        }
    }
    peg_reset(p, mark);
    lit = peg_expect_token(p, 35);
    if lit is not None {
        a = pa_name_from_token(peg_expect_token(p, NAME));
        if a is not None {
            b = rule_type_param_default(p);
            end_tok = p.tokens[p.mark - 1];
            end_lineno = end_tok.end_lineno;
            end_col_offset = end_tok.end_col_offset;
            res = ParamSpec(
                name=pa_name_id(a),
                default_value=b,
                lineno=start_lineno,
                col_offset=start_col_offset,
                end_lineno=end_lineno,
                end_col_offset=end_col_offset
            );
            peg_insert_memo(p, mark, RULE_type_param, res);
            return res;
        }
    }
    peg_reset(p, mark);
    peg_insert_memo(p, mark, RULE_type_param, None);
    return None;
}

