def rule_kwarg_or_double_starred(p: peg_parser) -> pa_keyword_or_starred | None {
    mark = peg_mark(p);
    start_lineno = 1;
    start_col_offset = 0;
    end_lineno = 1;
    end_col_offset = 0;
    if peg_fill_token(p) {
        t0 = p.tokens[p.mark];
        start_lineno = t0.lineno;
        start_col_offset = t0.col_offset;
    }
    invalid_kwarg = rule_invalid_kwarg(p);
    if invalid_kwarg is not None {
        res = invalid_kwarg;
        return res;
    }
    peg_reset(p, mark);
    a = pa_name_from_token(peg_expect_token(p, NAME));
    if a is not None {
        lit = peg_expect_token(p, 22);
        if lit is not None {
            b = rule_expression(p);
            if b is not None {
                end_tok = p.tokens[p.mark - 1];
                end_lineno = end_tok.end_lineno;
                end_col_offset = end_tok.end_col_offset;
                res = pa_keyword_or_starred(
                    pa_check(
                        keyword(
                            arg=pa_name_id(a),
                            value=b,
                            lineno=start_lineno,
                            col_offset=start_col_offset,
                            end_lineno=end_lineno,
                            end_col_offset=end_col_offset
                        )
                    ),
                    1,
                    start_lineno,
                    start_col_offset,
                    end_lineno,
                    end_col_offset
                );
                return res;
            }
        }
    }
    peg_reset(p, mark);
    lit = peg_expect_token(p, 35);
    if lit is not None {
        a = rule_expression(p);
        if a is not None {
            end_tok = p.tokens[p.mark - 1];
            end_lineno = end_tok.end_lineno;
            end_col_offset = end_tok.end_col_offset;
            res = pa_keyword_or_starred(
                pa_check(
                    keyword(
                        arg=None,
                        value=a,
                        lineno=start_lineno,
                        col_offset=start_col_offset,
                        end_lineno=end_lineno,
                        end_col_offset=end_col_offset
                    )
                ),
                1,
                start_lineno,
                start_col_offset,
                end_lineno,
                end_col_offset
            );
            return res;
        }
    }
    peg_reset(p, mark);
    return None;
}

