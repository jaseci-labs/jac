                        p, False, "expected 'except' or 'finally' block"
                    );
                    return res;
                }
            }
        }
    }
    peg_reset(p, mark);
    kw = peg_expect_token(p, 692);
    if kw is not None {
        lit = peg_expect_token(p, 11);
        if lit is not None {
            seq = rule__loop0_86(p);
            if seq is not None {
                seq_1 = rule__loop1_87(p);
                if seq_1 is not None {
                    a = peg_expect_token(p, 642);
                    if a is not None {
                        b = peg_expect_token(p, 16);
                        if b is not None {
                            expression = rule_expression(p);
                            if expression is not None {
                                rhs = rule__tmp_18(p);
                                lit_1 = peg_expect_token(p, 11);
                                if lit_1 is not None {
                                    res = pa_raise_syntax_known_range(
                                        p,
                                        False,
                                        a,
                                        b,
                                        "cannot have both 'except' and 'except*' on the same 'try'"
                                    );
                                    return res;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    peg_reset(p, mark);
    kw = peg_expect_token(p, 692);
    if kw is not None {
        lit = peg_expect_token(p, 11);
        if lit is not None {
            seq = rule__loop0_86(p);
            if seq is not None {
                seq_1 = rule__loop1_88(p);
                if seq_1 is not None {
                    a = peg_expect_token(p, 642);
                    if a is not None {
                        rhs = rule__tmp_89(p);
                        lit_1 = peg_expect_token(p, 11);
                        if lit_1 is not None {
                            res = pa_raise_syntax_known_expr(
                                p,
                                False,
                                a,
                                "cannot have both 'except' and 'except*' on the same 'try'"
                            );
                            return res;
                        }
                    }
                }
            }
        }
    }
    peg_reset(p, mark);
    return None;
}

def rule_invalid_tstring_conversion_character(p: peg_parser) -> object | None {
    mark = peg_mark(p);
    lit = peg_expect_token(p, 54);
    if lit is not None {
        if (
            (peg_positive_lookahead_token(p, 11) or peg_positive_lookahead_token(p, 26))
        ) {
            res = pa_raise_syntax(p, True, "t-string: missing conversion character");
            return res;
        }
    }
    peg_reset(p, mark);
    lit = peg_expect_token(p, 54);
    if lit is not None {
        if (peg_negative_lookahead_token(p, NAME)) {
            res = pa_raise_syntax(p, True, "t-string: invalid conversion character");
            return res;
        }
    }
    peg_reset(p, mark);
    return None;
}

def rule_invalid_tstring_replacement_field(p: peg_parser) -> object | None {
    mark = peg_mark(p);
    lit = peg_expect_token(p, 25);
    if lit is not None {
        a = peg_expect_token(p, 22);
        if a is not None {
            res = pa_raise_syntax_known_expr(
                p, False, a, "t-string: valid expression required before '='"
            );
            return res;
        }
    }
    peg_reset(p, mark);
    lit = peg_expect_token(p, 25);
    if lit is not None {
        a = peg_expect_token(p, 54);
        if a is not None {
            res = pa_raise_syntax_known_expr(
                p, False, a, "t-string: valid expression required before '!'"
            );
            return res;
        }
    }
    peg_reset(p, mark);
    lit = peg_expect_token(p, 25);
    if lit is not None {
        a = peg_expect_token(p, 11);
        if a is not None {
            res = pa_raise_syntax_known_expr(
                p, False, a, "t-string: valid expression required before ':'"
            );
            return res;
        }
    }
    peg_reset(p, mark);
    lit = peg_expect_token(p, 25);
    if lit is not None {
        a = peg_expect_token(p, 26);
        if a is not None {
            res = pa_raise_syntax_known_expr(
                p, False, a, "t-string: valid expression required before '}'"
            );
            return res;
        }
    }
    peg_reset(p, mark);
    lit = peg_expect_token(p, 25);
    if lit is not None {
        if ((rule_annotated_rhs(p) is None)) {
            res = pa_raise_syntax(
                p, True, "t-string: expecting a valid expression after '{'"
            );
            return res;
        }
    }
    peg_reset(p, mark);
    lit = peg_expect_token(p, 25);
    if lit is not None {
        annotated_rhs = rule_annotated_rhs(p);
        if annotated_rhs is not None {
            if (
                (
                    peg_negative_lookahead_token(p, 22)
                    and peg_negative_lookahead_token(p, 54)
                    and peg_negative_lookahead_token(p, 11)
                    and peg_negative_lookahead_token(p, 26)
                )
            ) {
                res = (
                    None
                        if pa_err_occurred(p) is not None
                        else pa_raise_syntax(
                            p, True, "t-string: expecting '=', or '!', or ':', or '}'"
                        )
                );
                return res;
            }
        }
    }
    peg_reset(p, mark);
    lit = peg_expect_token(p, 25);
    if lit is not None {
        annotated_rhs = rule_annotated_rhs(p);
        if annotated_rhs is not None {
            lit_1 = peg_expect_token(p, 22);
            if lit_1 is not None {
                if (
                    (
                        peg_negative_lookahead_token(p, 54)
                        and peg_negative_lookahead_token(p, 11)
                        and peg_negative_lookahead_token(p, 26)
                    )
                ) {
                    res = (
                        None
                            if pa_err_occurred(p) is not None
                            else pa_raise_syntax(
                                p, True, "t-string: expecting '!', or ':', or '}'"
                            )
                    );
                    return res;
                }
            }
        }
    }
    peg_reset(p, mark);
    lit = peg_expect_token(p, 25);
    if lit is not None {
        annotated_rhs = rule_annotated_rhs(p);
        if annotated_rhs is not None {
            lit_1 = peg_expect_token(p, 22);
            invalid_tstring_conversion_character = rule_invalid_tstring_conversion_character(
                p
            );
            if invalid_tstring_conversion_character is not None {
                res = [lit, annotated_rhs, lit_1, invalid_tstring_conversion_character];
                return res;
            }
        }
    }
    peg_reset(p, mark);
    lit = peg_expect_token(p, 25);
    if lit is not None {
        annotated_rhs = rule_annotated_rhs(p);
        if annotated_rhs is not None {
            lit_1 = peg_expect_token(p, 22);
            rhs = rule__tmp_57(p);
            if (
                (
                    peg_negative_lookahead_token(p, 11)
                    and peg_negative_lookahead_token(p, 26)
                )
            ) {
                res = (
                    None
                        if pa_err_occurred(p) is not None
                        else pa_raise_syntax(p, True, "t-string: expecting ':' or '}'")
                );
                return res;
            }
        }
    }
    peg_reset(p, mark);
    lit = peg_expect_token(p, 25);
    if lit is not None {
        annotated_rhs = rule_annotated_rhs(p);
        if annotated_rhs is not None {
            lit_1 = peg_expect_token(p, 22);
            rhs = rule__tmp_57(p);
            lit_2 = peg_expect_token(p, 11);
            if lit_2 is not None {
                seq = rule__loop0_28(p);
                if seq is not None {
                    if (peg_negative_lookahead_token(p, 26)) {
                        res = (
                            None
                                if pa_err_occurred(p) is not None
                                else pa_raise_syntax(
                                    p, True, "t-string: expecting '}', or format specs"
                                )
                        );
                        return res;
                    }
                }
            }
        }
    }
    peg_reset(p, mark);
    lit = peg_expect_token(p, 25);
    if lit is not None {
        annotated_rhs = rule_annotated_rhs(p);
        if annotated_rhs is not None {
            lit_1 = peg_expect_token(p, 22);
            rhs = rule__tmp_57(p);
            if (peg_negative_lookahead_token(p, 26)) {
                res = (
                    None
                        if pa_err_occurred(p) is not None
                        else pa_raise_syntax(p, True, "t-string: expecting '}'")
                );
                return res;
            }
        }
    }
    peg_reset(p, mark);
    return None;
}

