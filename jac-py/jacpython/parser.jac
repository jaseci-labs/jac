        end_col_offset = end_tok.end_col_offset;
        res = pa_constant_none(
            start_lineno, start_col_offset, end_lineno, end_col_offset
        );
        return res;
    }
    peg_reset(p, mark);
    if (
        (
            peg_positive_lookahead_token(p, STRING)
            or peg_positive_lookahead_token(p, FSTRING_START)
