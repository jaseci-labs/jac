            return res;
        }
    }
    peg_reset(p, mark);
    invalid_arguments = rule_invalid_arguments(p);
    if invalid_arguments is not None {
        res = invalid_arguments;
        peg_insert_memo(p, mark, RULE_arguments, res);
        return res;
    }
    peg_reset(p, mark);
    peg_insert_memo(p, mark, RULE_arguments, None);
    return None;
}

