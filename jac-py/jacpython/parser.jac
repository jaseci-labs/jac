def rule_class_def_raw(p: peg_parser) -> stmt | None {
    mark = peg_mark(p);
    start_lineno = 1;
    start_col_offset = 0;
    end_lineno = 1;
    end_col_offset = 0;
    if peg_fill_token(p) {
        t0 = p.tokens[p.mark];
        start_lineno = t0.lineno;
        start_col_offset = t0.col_offset;
    }
    invalid_class_def_raw = rule_invalid_class_def_raw(p);
    if invalid_class_def_raw is not None {
        res = invalid_class_def_raw;
        return res;
    }
    peg_reset(p, mark);
    kw = peg_expect_token(p, 570);
    if kw is not None {
        a = pa_name_from_token(peg_expect_token(p, NAME));
        if a is not None {
            t = rule_type_params(p);
            b = rule__tmp_11(p);
            lit = peg_expect_token(p, 11);
            if lit is not None {
                c = rule_block(p);
                if c is not None {
                    end_tok = p.tokens[p.mark - 1];
                    end_lineno = end_tok.end_lineno;
                    end_col_offset = end_tok.end_col_offset;
                    res = ClassDef(
                        name=pa_name_id(a),
                        bases=(pa_call_args(b) if b is not None else None),
                        keywords=(pa_call_keywords(b) if b is not None else None),
                        body=c,
                        decorator_list=None,
                        type_params=t,
                        lineno=start_lineno,
                        col_offset=start_col_offset,
                        end_lineno=end_lineno,
                        end_col_offset=end_col_offset
                    );
                    return res;
                }
            }
        }
    }
    peg_reset(p, mark);
    return None;
}

def rule_class_pattern(p: peg_parser) -> pattern | None {
    mark = peg_mark(p);
    start_lineno = 1;
    start_col_offset = 0;
    end_lineno = 1;
    end_col_offset = 0;
    if peg_fill_token(p) {
        t0 = p.tokens[p.mark];
        start_lineno = t0.lineno;
        start_col_offset = t0.col_offset;
    }
    cls = rule_name_or_attr(p);
    if cls is not None {
        lit = peg_expect_token(p, 7);
        if lit is not None {
            lit_1 = peg_expect_token(p, 8);
            if lit_1 is not None {
                end_tok = p.tokens[p.mark - 1];
                end_lineno = end_tok.end_lineno;
                end_col_offset = end_tok.end_col_offset;
                res = MatchClass(
                    cls=cls,
                    patterns=None,
                    kwd_attrs=None,
                    kwd_patterns=None,
                    lineno=start_lineno,
                    col_offset=start_col_offset,
                    end_lineno=end_lineno,
                    end_col_offset=end_col_offset
                );
                return res;
            }
        }
    }
    peg_reset(p, mark);
    cls = rule_name_or_attr(p);
    if cls is not None {
        lit = peg_expect_token(p, 7);
        if lit is not None {
            patterns = rule_positional_patterns(p);
            if patterns is not None {
                lit_1 = peg_expect_token(p, 12);
                lit_2 = peg_expect_token(p, 8);
                if lit_2 is not None {
                    end_tok = p.tokens[p.mark - 1];
                    end_lineno = end_tok.end_lineno;
                    end_col_offset = end_tok.end_col_offset;
                    res = MatchClass(
                        cls=cls,
                        patterns=patterns,
                        kwd_attrs=None,
                        kwd_patterns=None,
                        lineno=start_lineno,
                        col_offset=start_col_offset,
                        end_lineno=end_lineno,
                        end_col_offset=end_col_offset
                    );
                    return res;
                }
            }
        }
    }
    peg_reset(p, mark);
    cls = rule_name_or_attr(p);
    if cls is not None {
        lit = peg_expect_token(p, 7);
        if lit is not None {
            keywords = rule_keyword_patterns(p);
            if keywords is not None {
                lit_1 = peg_expect_token(p, 12);
                lit_2 = peg_expect_token(p, 8);
                if lit_2 is not None {
                    end_tok = p.tokens[p.mark - 1];
                    end_lineno = end_tok.end_lineno;
                    end_col_offset = end_tok.end_col_offset;
                    res = MatchClass(
                        cls=cls,
                        patterns=None,
                        kwd_attrs=pa_check(
                            pa_map_names_to_ids(pa_check(pa_get_pattern_keys(keywords)))
                        ),
                        kwd_patterns=pa_check(pa_get_patterns(keywords)),
                        lineno=start_lineno,
                        col_offset=start_col_offset,
                        end_lineno=end_lineno,
                        end_col_offset=end_col_offset
                    );
                    return res;
                }
            }
        }
    }
    peg_reset(p, mark);
    cls = rule_name_or_attr(p);
    if cls is not None {
        lit = peg_expect_token(p, 7);
        if lit is not None {
            patterns = rule_positional_patterns(p);
            if patterns is not None {
                lit_1 = peg_expect_token(p, 12);
                if lit_1 is not None {
                    keywords = rule_keyword_patterns(p);
                    if keywords is not None {
                        lit_2 = peg_expect_token(p, 12);
                        lit_3 = peg_expect_token(p, 8);
                        if lit_3 is not None {
                            end_tok = p.tokens[p.mark - 1];
                            end_lineno = end_tok.end_lineno;
                            end_col_offset = end_tok.end_col_offset;
                            res = MatchClass(
                                cls=cls,
                                patterns=patterns,
                                kwd_attrs=pa_check(
                                    pa_map_names_to_ids(
                                        pa_check(pa_get_pattern_keys(keywords))
                                    )
                                ),
                                kwd_patterns=pa_check(pa_get_patterns(keywords)),
                                lineno=start_lineno,
                                col_offset=start_col_offset,
                                end_lineno=end_lineno,
                                end_col_offset=end_col_offset
                            );
                            return res;
                        }
                    }
                }
            }
        }
    }
    peg_reset(p, mark);
    invalid_class_pattern = rule_invalid_class_pattern(p);
    if invalid_class_pattern is not None {
        res = invalid_class_pattern;
        return res;
    }
    peg_reset(p, mark);
    return None;
}

def rule_closed_pattern(p: peg_parser) -> pattern | None {
    hit = peg_check_memo(p, RULE_closed_pattern);
    if hit.hit {
        return hit.result as pattern;
    }
    mark = peg_mark(p);
