    peg_reset(p, mark);
    a = rule_kwargs(p);
    if a is not None {
        end_tok = p.tokens[p.mark - 1];
        end_lineno = end_tok.end_lineno;
        end_col_offset = end_tok.end_col_offset;
        res = pa_ast_call(
            pa_dummy_name(start_lineno, start_col_offset, end_lineno, end_col_offset),
            pa_check(pa_seq_extract_starred_exprs(a)),
            pa_check(pa_seq_delete_starred_exprs(a)),
            start_lineno,
            start_col_offset,
            end_lineno,
            end_col_offset
        );
