def rule_invalid_assignment(p: peg_parser) -> object | None {
    mark = peg_mark(p);
    a = rule_invalid_ann_assign_target(p);
    if a is not None {
        lit = peg_expect_token(p, 11);
        if lit is not None {
            expression = rule_expression(p);
            if expression is not None {
                res = pa_raise_syntax_known_expr(
                    p, False, a, "only single target (not %s) can be annotated"
                );
                return res;
            }
        }
    }
    peg_reset(p, mark);
    a = rule_star_named_expression(p);
    if a is not None {
        lit = peg_expect_token(p, 12);
        if lit is not None {
            seq = rule__loop0_45(p);
            if seq is not None {
                lit_1 = peg_expect_token(p, 11);
                if lit_1 is not None {
                    expression = rule_expression(p);
                    if expression is not None {
                        res = pa_raise_syntax_known_expr(
                            p,
                            False,
                            a,
                            "only single target (not tuple) can be annotated"
                        );
                        return res;
                    }
                }
            }
        }
    }
    peg_reset(p, mark);
    a = rule_expression(p);
    if a is not None {
        lit = peg_expect_token(p, 11);
        if lit is not None {
            expression = rule_expression(p);
            if expression is not None {
                res = pa_raise_syntax_known_expr(
                    p, False, a, "illegal target for annotation"
                );
                return res;
            }
        }
    }
    peg_reset(p, mark);
    seq = rule__loop0_46(p);
    if seq is not None {
        a = rule_star_expressions(p);
        if a is not None {
            lit = peg_expect_token(p, 22);
            if lit is not None {
                res = pa_raise_invalid_target(p, STAR_TARGETS, a);
                return res;
            }
        }
    }
    peg_reset(p, mark);
    seq = rule__loop0_46(p);
    if seq is not None {
        a = rule_yield_expr(p);
        if a is not None {
            lit = peg_expect_token(p, 22);
            if lit is not None {
                res = pa_raise_syntax_known_expr(
                    p, False, a, "assignment to yield expression not possible"
                );
                return res;
            }
        }
    }
    peg_reset(p, mark);
    a = rule_star_expressions(p);
    if a is not None {
        augassign = rule_augassign(p);
        if augassign is not None {
            annotated_rhs = rule_annotated_rhs(p);
            if annotated_rhs is not None {
                res = pa_raise_syntax_known_expr(
                    p,
                    False,
                    a,
                    "'%s' is an illegal expression for augmented assignment"
                );
                return res;
            }
        }
    }
    peg_reset(p, mark);
    return None;
}

