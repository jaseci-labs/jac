    await_primary = rule_await_primary(p);
    if await_primary is not None {
        res = await_primary;
        return res;
    }
    peg_reset(p, mark);
    return None;
}

def rule_primary(p: peg_parser) -> expr | None {
    hit = peg_check_memo(p, RULE_primary);
    if hit.hit {
        return hit.result as expr | None;
    }
    mark = peg_mark(p);
    res: expr | None = None;
    resmark = mark;
    while True {
        peg_update_memo(p, mark, RULE_primary, res);
        peg_reset(p, mark);
        raw = rule_primary_raw(p);
        if peg_has_error(p) {
            return None;
        }
        if raw is None or peg_mark(p) <= resmark {
            break;
        }
        resmark = peg_mark(p);
        res = raw;
    }
    return peg_left_rec_finish(p, resmark, res) as expr;
}

def rule_primary_raw(p: peg_parser) -> expr | None {
    mark = peg_mark(p);
    start_lineno = 1;
    start_col_offset = 0;
    end_lineno = 1;
    end_col_offset = 0;
    a = rule_primary(p);
    if a is not None {
        lit = peg_expect_token(p, 23);
        if lit is not None {
            b = pa_name_from_token(peg_expect_token(p, NAME));
            if b is not None {
                end_tok = p.tokens[p.mark - 1];
                end_lineno = end_tok.end_lineno;
                end_col_offset = end_tok.end_col_offset;
                res = pa_ast_attribute(
                    a,
                    pa_name_id(b),
                    Load(),
                    start_lineno,
                    start_col_offset,
                    end_lineno,
                    end_col_offset
                );
                return res;
            }
        }
    }
    peg_reset(p, mark);
    a = rule_primary(p);
    if a is not None {
        b = rule_genexp(p);
        if b is not None {
            end_tok = p.tokens[p.mark - 1];
            end_lineno = end_tok.end_lineno;
            end_col_offset = end_tok.end_col_offset;
            res = pa_ast_call(
                a,
                pa_check(pa_singleton_seq(b)),
                None,
                start_lineno,
                start_col_offset,
                end_lineno,
                end_col_offset
            );
            return res;
        }
    }
    peg_reset(p, mark);
    a = rule_primary(p);
    if a is not None {
        lit = peg_expect_token(p, 7);
        if lit is not None {
            b = rule_arguments(p);
            lit_1 = peg_expect_token(p, 8);
            if lit_1 is not None {
                end_tok = p.tokens[p.mark - 1];
                end_lineno = end_tok.end_lineno;
                end_col_offset = end_tok.end_col_offset;
                res = pa_ast_call(
                    a,
                    (pa_call_args(b) if b is not None else None),
                    (pa_call_keywords(b) if b is not None else None),
                    start_lineno,
                    start_col_offset,
                    end_lineno,
                    end_col_offset
                );
                return res;
            }
        }
    }
    peg_reset(p, mark);
    a = rule_primary(p);
    if a is not None {
        lit = peg_expect_token(p, 9);
        if lit is not None {
            b = rule_slices(p);
            if b is not None {
                lit_1 = peg_expect_token(p, 10);
                if lit_1 is not None {
                    end_tok = p.tokens[p.mark - 1];
                    end_lineno = end_tok.end_lineno;
                    end_col_offset = end_tok.end_col_offset;
                    res = pa_ast_subscript(
                        a,
                        b,
                        Load(),
                        start_lineno,
                        start_col_offset,
                        end_lineno,
                        end_col_offset
                    );
                    return res;
                }
            }
        }
    }
    peg_reset(p, mark);
    atom = rule_atom(p);
    if atom is not None {
        res = atom;
        return res;
    }
    peg_reset(p, mark);
    return None;
}

def rule_raise_stmt(p: peg_parser) -> stmt | None {
    mark = peg_mark(p);
    start_lineno = 1;
    start_col_offset = 0;
