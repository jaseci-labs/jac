    return None;
}

def rule_bitwise_and(p: peg_parser) -> expr | None {
    hit = peg_check_memo(p, RULE_bitwise_and);
    if hit.hit {
        return hit.result as expr | None;
    }
    mark = peg_mark(p);
    res: expr | None = None;
    resmark = mark;
    while True {
        peg_update_memo(p, mark, RULE_bitwise_and, res);
        peg_reset(p, mark);
        raw = rule_bitwise_and_raw(p);
        if peg_has_error(p) {
            return None;
        }
        if raw is None or peg_mark(p) <= resmark {
            break;
        }
        resmark = peg_mark(p);
        res = raw;
    }
    return peg_left_rec_finish(p, resmark, res) as expr;
}

