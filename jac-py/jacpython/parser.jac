    peg_reset(p, mark);
    value_pattern = rule_value_pattern(p);
    if value_pattern is not None {
        res = value_pattern;
        peg_insert_memo(p, mark, RULE_closed_pattern, res);
        return res;
    }
    peg_reset(p, mark);
    group_pattern = rule_group_pattern(p);
    if group_pattern is not None {
        res = group_pattern;
        peg_insert_memo(p, mark, RULE_closed_pattern, res);
        return res;
    }
    peg_reset(p, mark);
    sequence_pattern = rule_sequence_pattern(p);
    if sequence_pattern is not None {
        res = sequence_pattern;
        peg_insert_memo(p, mark, RULE_closed_pattern, res);
        return res;
    }
    peg_reset(p, mark);
    mapping_pattern = rule_mapping_pattern(p);
    if mapping_pattern is not None {
        res = mapping_pattern;
        peg_insert_memo(p, mark, RULE_closed_pattern, res);
        return res;
    }
    peg_reset(p, mark);
    class_pattern = rule_class_pattern(p);
    if class_pattern is not None {
        res = class_pattern;
        peg_insert_memo(p, mark, RULE_closed_pattern, res);
        return res;
    }
    peg_reset(p, mark);
    peg_insert_memo(p, mark, RULE_closed_pattern, None);
    return None;
}

