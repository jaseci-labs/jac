def rule_assignment(p: peg_parser) -> stmt | None {
    mark = peg_mark(p);
    start_lineno = 1;
    start_col_offset = 0;
    end_lineno = 1;
    end_col_offset = 0;
    if peg_fill_token(p) {
        t0 = p.tokens[p.mark];
        start_lineno = t0.lineno;
        start_col_offset = t0.col_offset;
    }
    a = pa_name_from_token(peg_expect_token(p, NAME));
    if a is not None {
        lit = peg_expect_token(p, 11);
        if lit is not None {
            b = rule_expression(p);
            if b is not None {
                c = rule__tmp_5(p);
                end_tok = p.tokens[p.mark - 1];
                end_lineno = end_tok.end_lineno;
                end_col_offset = end_tok.end_col_offset;
                res = pa_ast_annassign(
                    pa_check(pa_set_context(a, Store())),
                    b,
                    c,
                    1,
                    start_lineno,
                    start_col_offset,
                    end_lineno,
                    end_col_offset
                );
                return res;
            }
        }
    }
    peg_reset(p, mark);
    a = rule__tmp_6(p);
    if a is not None {
        lit = peg_expect_token(p, 11);
        if lit is not None {
            b = rule_expression(p);
            if b is not None {
                c = rule__tmp_5(p);
                end_tok = p.tokens[p.mark - 1];
                end_lineno = end_tok.end_lineno;
                end_col_offset = end_tok.end_col_offset;
                res = pa_ast_annassign(
                    a,
                    b,
                    c,
                    0,
                    start_lineno,
                    start_col_offset,
                    end_lineno,
                    end_col_offset
                );
                return res;
            }
        }
    }
    peg_reset(p, mark);
    a = rule__loop1_7(p);
    if a is not None {
        b = rule_annotated_rhs(p);
        if b is not None {
            if (peg_negative_lookahead_token(p, 22)) {
                tc = peg_expect_token(p, TYPE_COMMENT);
                end_tok = p.tokens[p.mark - 1];
                end_lineno = end_tok.end_lineno;
                end_col_offset = end_tok.end_col_offset;
                res = pa_ast_assign(
                    a, b, start_lineno, start_col_offset, end_lineno, end_col_offset
                );
                return res;
            }
        }
    }
    peg_reset(p, mark);
    a = rule_single_target(p);
    if a is not None {
        b = rule_augassign(p);
        if b is not None {
            cut = True;
            c = rule_annotated_rhs(p);
            if c is not None {
                end_tok = p.tokens[p.mark - 1];
                end_lineno = end_tok.end_lineno;
                end_col_offset = end_tok.end_col_offset;
                res = pa_ast_augassign(
                    a,
                    pa_aug_op(b),
                    c,
                    start_lineno,
                    start_col_offset,
                    end_lineno,
                    end_col_offset
                );
                return res;
            }
        }
    }
    peg_reset(p, mark);
    invalid_assignment = rule_invalid_assignment(p);
    if invalid_assignment is not None {
        res = invalid_assignment;
        return res;
    }
    peg_reset(p, mark);
    return None;
}

