        start_lineno = t0.lineno;
        start_col_offset = t0.col_offset;
    }
    real = rule_signed_real_number(p);
    if real is not None {
        lit = peg_expect_token(p, 14);
        if lit is not None {
            imag = rule_imaginary_number(p);
            if imag is not None {
                end_tok = p.tokens[p.mark - 1];
                end_lineno = end_tok.end_lineno;
                end_col_offset = end_tok.end_col_offset;
                res = pa_ast_binop(
                    real,
                    Add(),
                    imag,
                    start_lineno,
                    start_col_offset,
                    end_lineno,
                    end_col_offset
                );
                return res;
            }
        }
    }
    peg_reset(p, mark);
    real = rule_signed_real_number(p);
    if real is not None {
        lit = peg_expect_token(p, 15);
        if lit is not None {
            imag = rule_imaginary_number(p);
            if imag is not None {
                end_tok = p.tokens[p.mark - 1];
                end_lineno = end_tok.end_lineno;
                end_col_offset = end_tok.end_col_offset;
                res = pa_ast_binop(
                    real,
                    Sub(),
                    imag,
                    start_lineno,
                    start_col_offset,
                    end_lineno,
                    end_col_offset
                );
                return res;
            }
        }
    }
    peg_reset(p, mark);
    return None;
}

def rule_compound_stmt(p: peg_parser) -> stmt | None {
    mark = peg_mark(p);
    if (
        (
            peg_positive_lookahead_token(p, 574)
            or peg_positive_lookahead_token(p, 49)
            or peg_positive_lookahead_token(p, 699)
        )
    ) {
        function_def = rule_function_def(p);
        if function_def is not None {
            res = function_def;
            return res;
        }
    }
    peg_reset(p, mark);
    if (peg_positive_lookahead_token(p, 623)) {
        if_stmt = rule_if_stmt(p);
        if if_stmt is not None {
            res = if_stmt;
            return res;
        }
    }
    peg_reset(p, mark);
    if (
