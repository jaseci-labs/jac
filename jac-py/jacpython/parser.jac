    end_lineno = 1;
    end_col_offset = 0;
    a = rule_shift_expr(p);
    if a is not None {
        lit = peg_expect_token(p, 33);
        if lit is not None {
            b = rule_sum(p);
            if b is not None {
                end_tok = p.tokens[p.mark - 1];
                end_lineno = end_tok.end_lineno;
