def rule_expression(p: peg_parser) -> expr | None {
    hit = peg_check_memo(p, RULE_expression);
    if hit.hit {
        return hit.result as expr;
    }
    mark = peg_mark(p);
    start_lineno = 1;
    start_col_offset = 0;
    end_lineno = 1;
    end_col_offset = 0;
    if peg_fill_token(p) {
        t0 = p.tokens[p.mark];
        start_lineno = t0.lineno;
        start_col_offset = t0.col_offset;
    }
    invalid_expression = rule_invalid_expression(p);
    if invalid_expression is not None {
        res = invalid_expression;
        peg_insert_memo(p, mark, RULE_expression, res);
        return res;
    }
    peg_reset(p, mark);
    invalid_legacy_expression = rule_invalid_legacy_expression(p);
    if invalid_legacy_expression is not None {
        res = invalid_legacy_expression;
        peg_insert_memo(p, mark, RULE_expression, res);
        return res;
    }
    peg_reset(p, mark);
    a = rule_disjunction(p);
    if a is not None {
        kw = peg_expect_token(p, 623);
        if kw is not None {
            b = rule_disjunction(p);
            if b is not None {
                kw_1 = peg_expect_token(p, 606);
                if kw_1 is not None {
                    c = rule_expression(p);
                    if c is not None {
                        end_tok = p.tokens[p.mark - 1];
                        end_lineno = end_tok.end_lineno;
                        end_col_offset = end_tok.end_col_offset;
                        res = pa_ast_ifexp(
                            b,
                            a,
                            c,
                            start_lineno,
                            start_col_offset,
                            end_lineno,
                            end_col_offset
                        );
                        peg_insert_memo(p, mark, RULE_expression, res);
                        return res;
                    }
                }
            }
        }
    }
    peg_reset(p, mark);
    disjunction = rule_disjunction(p);
    if disjunction is not None {
        res = disjunction;
        peg_insert_memo(p, mark, RULE_expression, res);
        return res;
    }
    peg_reset(p, mark);
    lambdef = rule_lambdef(p);
    if lambdef is not None {
        res = lambdef;
        peg_insert_memo(p, mark, RULE_expression, res);
        return res;
    }
    peg_reset(p, mark);
    peg_insert_memo(p, mark, RULE_expression, None);
    return None;
}

