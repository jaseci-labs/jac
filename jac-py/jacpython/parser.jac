def rule_attr(p: peg_parser) -> expr | None {
    hit = peg_check_memo(p, RULE_attr);
    if hit.hit {
        return hit.result as expr | None;
    }
    mark = peg_mark(p);
    res: expr | None = None;
    resmark = mark;
    while True {
        peg_update_memo(p, mark, RULE_attr, res);
        peg_reset(p, mark);
        raw = rule_attr_raw(p);
        if peg_has_error(p) {
            return None;
        }
        if raw is None or peg_mark(p) <= resmark {
            break;
        }
        resmark = peg_mark(p);
        res = raw;
    }
    return peg_left_rec_finish(p, resmark, res) as expr;
}

def rule_attr_raw(p: peg_parser) -> expr | None {
    mark = peg_mark(p);
    start_lineno = 1;
    start_col_offset = 0;
    end_lineno = 1;
    end_col_offset = 0;
    value = rule_name_or_attr(p);
    if value is not None {
        lit = peg_expect_token(p, 23);
        if lit is not None {
            attr = pa_name_from_token(peg_expect_token(p, NAME));
            if attr is not None {
                end_tok = p.tokens[p.mark - 1];
                end_lineno = end_tok.end_lineno;
                end_col_offset = end_tok.end_col_offset;
                res = pa_ast_attribute(
                    value,
                    pa_name_id(attr),
                    Load(),
                    start_lineno,
                    start_col_offset,
                    end_lineno,
                    end_col_offset
                );
                return res;
            }
        }
    }
    peg_reset(p, mark);
    return None;
}

def rule_augassign(p: peg_parser) -> operator | None {
    mark = peg_mark(p);
