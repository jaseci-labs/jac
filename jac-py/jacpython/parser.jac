        return res;
    }
    peg_reset(p, mark);
    tuple = rule_tuple(p);
    if tuple is not None {
        res = tuple;
        return res;
    }
    peg_reset(p, mark);
    lit = peg_expect_token(p, 7);
    if lit is not None {
        a = rule_invalid_ann_assign_target(p);
        if a is not None {
            lit_1 = peg_expect_token(p, 8);
            if lit_1 is not None {
                res = a;
                return res;
            }
        }
    }
    peg_reset(p, mark);
    return None;
}

def rule_invalid_arguments(p: peg_parser) -> object | None {
    mark = peg_mark(p);
    rhs = rule__tmp_39(p);
    if rhs is not None {
        a = peg_expect_token(p, 12);
        if a is not None {
            gather = rule__gather_41(p);
            if gather is not None {
                res = pa_raise_syntax_known_expr(
                    p,
                    False,
                    a,
                    "iterable argument unpacking follows keyword argument unpacking"
                );
                return res;
            }
        }
    }
    peg_reset(p, mark);
    a = rule_expression(p);
    if a is not None {
        b = rule_for_if_clauses(p);
        if b is not None {
            lit = peg_expect_token(p, 12);
            if lit is not None {
                rhs = rule__tmp_42(p);
                res = pa_raise_syntax_known_range(
                    p,
                    False,
                    a,
                    pa_get_last_comprehension_item(pa_seq_last(b)),
                    "Generator expression must be parenthesized"
                );
                return res;
            }
        }
    }
    peg_reset(p, mark);
    a = pa_name_from_token(peg_expect_token(p, NAME));
    if a is not None {
        b = peg_expect_token(p, 22);
        if b is not None {
            expression = rule_expression(p);
            if expression is not None {
                for_if_clauses = rule_for_if_clauses(p);
                if for_if_clauses is not None {
                    res = pa_raise_syntax_known_range(
                        p,
                        False,
                        a,
                        b,
                        "invalid syntax. Maybe you meant '==' or ':=' instead of '='?"
                    );
                    return res;
                }
            }
        }
    }
    peg_reset(p, mark);
    rhs = rule__tmp_43(p);
    a = pa_name_from_token(peg_expect_token(p, NAME));
    if a is not None {
        b = peg_expect_token(p, 22);
        if b is not None {
            if (
                (
                    peg_positive_lookahead_token(p, 12)
                    or peg_positive_lookahead_token(p, 8)
                )
            ) {
                res = pa_raise_syntax_known_range(
                    p, False, a, b, "expected argument value expression"
                );
                return res;
            }
        }
    }
    peg_reset(p, mark);
    a = rule_args(p);
    if a is not None {
        b = rule_for_if_clauses(p);
        if b is not None {
            res = pa_nonparen_genexp_in_call(a, b);
            return res;
        }
    }
    peg_reset(p, mark);
    args = rule_args(p);
    if args is not None {
        lit = peg_expect_token(p, 12);
        if lit is not None {
            a = rule_expression(p);
            if a is not None {
                b = rule_for_if_clauses(p);
                if b is not None {
                    res = pa_raise_syntax_known_range(
                        p,
                        False,
                        a,
                        pa_get_last_comprehension_item(pa_seq_last(b)),
                        "Generator expression must be parenthesized"
                    );
                    return res;
                }
            }
        }
    }
    peg_reset(p, mark);
    a = rule_args(p);
    if a is not None {
        lit = peg_expect_token(p, 12);
        if lit is not None {
            args = rule_args(p);
            if args is not None {
                res = pa_arguments_parsing_error(a);
                return res;
            }
        }
    }
    peg_reset(p, mark);
    return None;
}

def rule_invalid_arithmetic(p: peg_parser) -> object | None {
