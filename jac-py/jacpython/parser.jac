                    b,
                    start_lineno,
                    start_col_offset,
                    end_lineno,
                    end_col_offset
                );
                return res;
            }
        }
    }
    peg_reset(p, mark);
    invalid_arithmetic = rule_invalid_arithmetic(p);
    if invalid_arithmetic is not None {
        res = invalid_arithmetic;
        return res;
    }
    peg_reset(p, mark);
    sum = rule_sum(p);
    if sum is not None {
        res = sum;
        return res;
    }
    peg_reset(p, mark);
    return None;
}

