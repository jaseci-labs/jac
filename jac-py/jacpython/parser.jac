def rule_single_subscript_attribute_target(p: peg_parser) -> expr | None {
    mark = peg_mark(p);
    start_lineno = 1;
    start_col_offset = 0;
    end_lineno = 1;
    end_col_offset = 0;
    if peg_fill_token(p) {
        t0 = p.tokens[p.mark];
        start_lineno = t0.lineno;
        start_col_offset = t0.col_offset;
    }
    a = rule_t_primary(p);
    if a is not None {
        lit = peg_expect_token(p, 23);
        if lit is not None {
            b = pa_name_from_token(peg_expect_token(p, NAME));
            if b is not None {
                if ((rule_t_lookahead(p) is None)) {
                    end_tok = p.tokens[p.mark - 1];
                    end_lineno = end_tok.end_lineno;
                    end_col_offset = end_tok.end_col_offset;
                    res = pa_ast_attribute(
                        a,
                        pa_name_id(b),
                        Store(),
                        start_lineno,
                        start_col_offset,
                        end_lineno,
                        end_col_offset
                    );
                    return res;
                }
            }
        }
    }
    peg_reset(p, mark);
    a = rule_t_primary(p);
    if a is not None {
        lit = peg_expect_token(p, 9);
        if lit is not None {
            b = rule_slices(p);
            if b is not None {
                lit_1 = peg_expect_token(p, 10);
                if lit_1 is not None {
                    if ((rule_t_lookahead(p) is None)) {
                        end_tok = p.tokens[p.mark - 1];
                        end_lineno = end_tok.end_lineno;
                        end_col_offset = end_tok.end_col_offset;
                        res = pa_ast_subscript(
                            a,
                            b,
                            Store(),
                            start_lineno,
                            start_col_offset,
                            end_lineno,
                            end_col_offset
                        );
                        return res;
                    }
