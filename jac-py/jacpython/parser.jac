def rule_inversion(p: peg_parser) -> expr | None {
    hit = peg_check_memo(p, RULE_inversion);
    if hit.hit {
        return hit.result as expr;
    }
    mark = peg_mark(p);
    start_lineno = 1;
    start_col_offset = 0;
    end_lineno = 1;
    end_col_offset = 0;
    if peg_fill_token(p) {
        t0 = p.tokens[p.mark];
        start_lineno = t0.lineno;
        start_col_offset = t0.col_offset;
    }
    kw = peg_expect_token(p, 671);
    if kw is not None {
        a = rule_inversion(p);
        if a is not None {
            end_tok = p.tokens[p.mark - 1];
            end_lineno = end_tok.end_lineno;
            end_col_offset = end_tok.end_col_offset;
            res = pa_ast_unaryop(
                Not(), a, start_lineno, start_col_offset, end_lineno, end_col_offset
            );
            peg_insert_memo(p, mark, RULE_inversion, res);
            return res;
        }
    }
    peg_reset(p, mark);
    comparison = rule_comparison(p);
    if comparison is not None {
        res = comparison;
        peg_insert_memo(p, mark, RULE_inversion, res);
        return res;
    }
    peg_reset(p, mark);
    peg_insert_memo(p, mark, RULE_inversion, None);
    return None;
}

