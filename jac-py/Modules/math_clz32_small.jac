def math_clz32_small(n: int) -> int {
    x: int = 0;
    r: int = 0;
    x = n & 4294967295;
    if (x == 0) {
        return 32;
    }

    r = 0;
    if ((x & 4294901760) == 0) {
        r += 16;
        x <<= 16;
    }

    if ((x & 4278190080) == 0) {
        r += 8;
        x <<= 8;
    }

    if ((x & 4026531840) == 0) {
        r += 4;
        x <<= 4;
    }

    if ((x & 3221225472) == 0) {
        r += 2;
        x <<= 2;
    }

    if ((x & 2147483648) == 0) {
        r += 1;
    }

    return r;
}
